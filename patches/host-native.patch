@@ -0,0 +1,34 @@
+-- lab_tarn2.lua (development only): which bytes of a sprite's AnimationState does Play / SetFrame / Stop-ish change?
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab tarn2", 1)
+local done = false
+local function dump(tag, s)
+  local p = B.ptr(s) + 0x30
+  local t = {}
+  for i = 0, 0x1f, 4 do t[#t + 1] = string.format("%08x", B.r32(p + i)) end
+  B.log(string.format("lab_tarn2: %-22s state %s | anim=%s fr=%s playing=%s fin=%s", tag, table.concat(t, " "),
+    tostring(s:GetAnimation()), tostring(s:GetFrame()), tostring(s:IsPlaying(s:GetAnimation())), tostring(s:IsFinished(s:GetAnimation()))))
+end
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  if done then return end
+  done = true
+  local s = Sprite()
+  s:Load("gfx/005.100_collectible.anm2", true)
+  local names = {}
+  for k in pairs(getmetatable(s).__index or {}) do names[#names + 1] = k end
+  table.sort(names)
+  B.log("lab_tarn2: sprite methods: " .. table.concat(names, " "))
+  dump("loaded", s)
+  s:Play("Idle", true); dump("Play Idle", s)
+  s:Update(); s:Update(); dump("2x Update", s)
+  s:SetFrame("Idle", 1); dump("SetFrame Idle 1", s)
+  s:Update(); dump("Update after SetFrame", s)
+  s:SetFrame("Idle", 0); dump("SetFrame Idle 0", s)
+  s:Play("Idle", false); dump("Play Idle false", s)
+  s:Update(); dump("Update after Play", s)
+  if s.Stop then s:Stop(); dump("Stop", s) end
+  if s.Continue then s:Continue(); dump("Continue", s) end
+  s:SetLastFrame(); dump("SetLastFrame", s)
+  s:Play("Idle", true); s:Update(); dump("Play again", s)
+end)
diff --git a/scripts/recomp/rgon/lab_tears_more.lua b/scripts/recomp/rgon/lab_tears_more.lua
new file mode 100644
index 0000000..cf8ec96
--- /dev/null
+++ b/scripts/recomp/rgon/lab_tears_more.lua
@@ -0,0 +1,218 @@
+-- lab_tears_more.lua (development only; ISAAC_RGON_LAB=lab_tears_more.lua): every name of api_tears_more.lua.
+-- Logs "lab_tears_more: PASS/FAIL .." lines and a DONE line.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab tears more", 1)
+local npass, nfail = 0, 0
+local function check(name, ok, detail)
+  if ok then npass = npass + 1 else nfail = nfail + 1 end
+  B.log("lab_tears_more: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+local function near(a, b) return math.abs(a - b) < 0.001 end
+local frame = 0
+local hp_seen = {}
+local hooked
+
+mod:AddCallback(ModCallbacks.MC_EVALUATE_TEAR_HIT_PARAMS, function(_, player, params)
+  if params and not hooked then
+    hooked = true
+    try("TearParams in the callback", function()
+      params.KnockbackMultiplier = 4.5
+      params.MassMultiplier = 3.0
+      params.SpeedMultiplier = 2.0
+      hp_seen.set = true
+    end)
+  end
+end)
+
+local splitcb = 0
+mod:AddCallback(ModCallbacks.MC_POST_FIRE_SPLIT_TEAR, function() splitcb = splitcb + 1 end)
+
+local L, tear, knife, proj
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    for _, n in ipairs({ "EntityTear.SetMultidimensionalTouched", "EntityTear.InHitList", "EntityTear.AddToHitList", "EntityTear.RemoveFromHitList",
+      "EntityTear.SetBackdropType", "EntityTear.GetBackdropType", "EntityTear.ResetSpriteScale", "EntityTear.SetInitSound", "EntityTear.FireSplitTear",
+      "EntityLaser.GetShrink", "EntityLaser.SetShrink", "EntityLaser.GetOneHit", "EntityLaser.GetDisableFollowParent", "EntityLaser.SetDisableFollowParent",
+      "EntityLaser.GetTimeout", "EntityLaser.SetTimeout", "EntityLaser.SetScale", "EntityLaser.ResetSpriteScale", "EntityLaser.RotateToAngle",
+      "EntityLaser.RecalculateSamplesNextUpdate", "EntityLaser.InHitList", "EntityLaser.AddToHitList", "EntityLaser.RemoveFromHitList",
+      "EntityLaser.SetMultidimensionalTouched", "EntityLaser.FireSplitTear", "EntityKnife.FireSplitTear", "EntityKnife.InitHomingPath",
+      "EntityProjectile.Deflect", "EntityEffect.GetTearFlags", "EntityEffect.SetTearFlags",
+      "EntityEffect.AddTearFlags", "EntityEffect.ClearTearFlags", "EntityEffect.HasTearFlags", "EntityEffect.CreateLight",
+      "TearParams.MassMultiplier", "TearParams.KnockbackMultiplier", "TearParams.SpeedMultiplier", "TearParams.TearDisplacement" }) do
+      check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+    end
+    -- TearParams: read-back of a game-made one and the game's own reaction (the callback sets them; the fired tear shows them)
+    try("TearParams defaults", function()
+      local tp = p:GetTearHitParams(WeaponType.WEAPON_TEARS, 1, 1, nil)
+      check("TearParams.MassMultiplier readable", type(tp.MassMultiplier) == "number" and tp.MassMultiplier > 0, tp.MassMultiplier)
+      check("TearParams.TearDisplacement is 1 or -1", tp.TearDisplacement == 1 or tp.TearDisplacement == -1, tp.TearDisplacement)
+      tp.MassMultiplier = 2.5 tp.KnockbackMultiplier = 3.5 tp.SpeedMultiplier = 0.5 tp.TearDisplacement = -1
+      check("TearParams round trip", near(tp.MassMultiplier, 2.5) and near(tp.KnockbackMultiplier, 3.5) and near(tp.SpeedMultiplier, 0.5) and tp.TearDisplacement == -1)
+      check("TearParams.MassMultiplier rejects 0", not pcall(function() tp.MassMultiplier = 0 end))
+      check("TearParams.TearDisplacement rejects 2", not pcall(function() tp.TearDisplacement = 2 end))
+    end)
+    -- a laser
+    L = Isaac.Spawn(7, 1, 0, p.Position + Vector(100, 0), Vector(0, 0), p):ToLaser()
+    try("laser fields", function()
+      check("laser Timeout = property", L:GetTimeout() == L.Timeout, L:GetTimeout())
+      L:SetTimeout(7) check("SetTimeout/GetTimeout", L:GetTimeout() == 7 and L.Timeout == 7)
+      L:SetShrink(true) check("SetShrink = property", L:GetShrink() == true and L.Shrink == true)
+      L:SetShrink(false) check("SetShrink back", L.Shrink == false)
+      L:SetDisableFollowParent(true) check("SetDisableFollowParent = property", L:GetDisableFollowParent() == true and L.DisableFollowParent == true)
+      L:SetDisableFollowParent(false)
+      check("GetOneHit = property", L:GetOneHit() == L.OneHit)
+      L:SetScale(2.0) check("SetScale/GetScale", near(L:GetScale(), 2.0), L:GetScale())
+      L:ResetSpriteScale() check("ResetSpriteScale runs", true)
+      L:SetScale(1.0)
+      L:SetMultidimensionalTouched(true) check("laser SetMultidimensionalTouched", L:IsMultidimensionalTouched() == true)
+      L:SetMultidimensionalTouched(false)
+      L:RotateToAngle(90, 4)
+      check("RotateToAngle: active rotation", L.IsActiveRotating == true, L.IsActiveRotating)
+      local e = Isaac.Spawn(10, 0, 0, p.Position + Vector(-100, 0), Vector(0, 0), nil)
+      check("laser InHitList false", L:InHitList(e) == false)
+      L:AddToHitList(e) check("laser AddToHitList", L:InHitList(e) == true)
+      local h = L:GetHitList() check("laser GetHitList holds it", #h == 1 and h[1] == e:GetHitListIndex())
+      L:AddToHitList(e) check("laser AddToHitList twice keeps one", #L:GetHitList() == 1)
+      L:RemoveFromHitList(e) check("laser RemoveFromHitList", L:InHitList(e) == false and #L:GetHitList() == 0)
+      e:Remove()
+    end)
+    try("SetInitSound laser", function()
+      L:SetInitSound(0) check("laser SetInitSound(null) sets the game's byte", r8(B.ptr(L) + 0x518) == 1)
+      L:SetInitSound(SoundEffect.SOUND_BEEP) check("laser SetInitSound(other) accepted", true)
+    end)
+    -- a tear
+    tear = Isaac.Spawn(2, 0, 0, p.Position + Vector(0, 100), Vector(0, 0), p):ToTear()
+    try("tear fields", function()
+      check("fresh tear is waiting for its init", r8(B.ptr(tear) + 0x46a) == 1, r8(B.ptr(tear) + 0x46a))
+      tear:SetInitSound(SoundEffect.SOUND_NULL)
+      check("tear SetInitSound(null) sets the game's byte", r8(B.ptr(tear) + 0x7ea) == 1)
+      tear:SetMultidimensionalTouched(true) check("tear SetMultidimensionalTouched", tear:IsMultidimensionalTouched() == true)
+      tear:SetMultidimensionalTouched(false) check("tear SetMultidimensionalTouched false", tear:IsMultidimensionalTouched() == false)
+      local e = Isaac.Spawn(10, 0, 0, p.Position + Vector(-100, 50), Vector(0, 0), nil)
+      check("tear InHitList false", tear:InHitList(e) == false)
+      tear:AddToHitList(e) check("tear AddToHitList", tear:InHitList(e) == true and #tear:GetHitList() == 1)
+      for i = 1, 6 do local x = Isaac.Spawn(10, 0, 0, p.Position, Vector(0, 0), nil) tear:AddToHitList(x) x:Remove() end
+      check("tear hit list grows", #tear:GetHitList() == 7, #tear:GetHitList())
+      tear:RemoveFromHitList(e) check("tear RemoveFromHitList", tear:InHitList(e) == false and #tear:GetHitList() == 6)
+      tear:ClearHitList() e:Remove()
+      check("backdrop of a non-grid tear is 0", tear:GetBackdropType() == 0)
+      tear:SetBackdropType(5) check("backdrop of a non-grid tear is unchanged", tear:GetBackdropType() == 0)
+      -- forced reset: the scale animation number is forgotten and then recomputed by the game
+      tear:Update()
+      local a = B.ptr(tear)
+      local before = ri32(a + 0x45c)
+      B.w32(a + 0x45c, 12345)
+      tear:ResetSpriteScale()
+      check("ResetSpriteScale without force: the game rewrites a stale number", ri32(a + 0x45c) == before, ri32(a + 0x45c))
+      B.w32(a + 0x45c, before)
+      tear:ResetSpriteScale(true)
+      check("ResetSpriteScale(true) leaves the right number", ri32(a + 0x45c) == before, ri32(a + 0x45c))
+      check("ResetSpriteScale rejects a number", not pcall(function() tear:ResetSpriteScale(3) end))
+    end)
+    -- the split tear from a tear and a laser
+    try("FireSplitTear from a tear", function()
+      tear.CollisionDamage = 10 tear.Scale = 1.0
+      local n = tear:FireSplitTear(p.Position, Vector(4, 0), 0.5, 0.6, 0)
+      check("FireSplitTear returns a tear", n ~= nil and n.Type == 2)
+      check("FireSplitTear damage is half", n and near(n.CollisionDamage, 5.0), n and n.CollisionDamage)
+      check("FireSplitTear scale 0.6", n and near(n.Scale, 0.6), n and n.Scale)
+      check("FireSplitTear velocity", n and n.Velocity.X > 1, n and tostring(n.Velocity))
+      check("FireSplitTear parent is the player", n and n.Parent ~= nil and n.Parent.Type == 1)
+      check("MC_POST_FIRE_SPLIT_TEAR fired", splitcb == 1, splitcb)
+      local n2 = L:FireSplitTear(p.Position, Vector(0, 4))
+      check("FireSplitTear from a laser", n2 ~= nil and n2.Type == 2)
+    end)
+  end
+  if frame == 8 then
+    -- laser samples: emptied now, rebuilt by the game's next update
+    try("RecalculateSamplesNextUpdate", function()
+      local a = B.ptr(L)
+      local n0 = #L:GetSamples()
+      L:RecalculateSamplesNextUpdate()
+      local emptied = r32(a + 0x484) == r32(a + 0x480)
+      check("samples emptied at once", emptied, string.format("(%d samples before)", n0))
+      B.log("lab_tears_more: laser had " .. n0 .. " samples")
+    end)
+  elseif frame == 11 then
+    try("samples rebuilt", function()
+      check("laser has samples again after updates", #L:GetSamples() > 0 or not L:IsSampleLaser(), #L:GetSamples())
+    end)
+    -- knife
+    knife = Isaac.Spawn(8, 0, 0, p.Position + Vector(0, -80), Vector(0, 0), p):ToKnife()
+    try("knife", function()
+      local before = ri32(B.ptr(knife) + 0x480)
+      knife:InitHomingPath(Vector(1, 0))
+      check("InitHomingPath ran (timers set)", ri32(B.ptr(knife) + 0x480) == 30 and ri32(B.ptr(knife) + 0x47c) == 0x43160000, ri32(B.ptr(knife) + 0x480))
+      knife:InitHomingPath(Vector(0, 1), p)
+      check("InitHomingPath with a source", true)
+      check("a plain knife has no hitbox parent", knife:GetHitboxParentKnife() == nil)
+      local n = knife:FireSplitTear(p.Position, Vector(3, 3))
+      check("FireSplitTear from a knife", n ~= nil and n.Type == 2)
+    end)
+    -- projectile
+    proj = Isaac.Spawn(9, 0, 0, p.Position + Vector(150, 0), Vector(-6, 0), nil):ToProjectile()
+    try("projectile", function()
+      local before = proj.Velocity.X
+      proj:Deflect(Vector(7, 0))
+      check("Deflect changes the velocity", near(proj.Velocity.X, 7), tostring(proj.Velocity) .. " (was " .. before .. ")")
+      check("Deflect rejects a number", not pcall(function() proj:Deflect(3) end))
+    end)
+    -- effects
+    try("CreateLight", function()
+      local fx = EntityEffect.CreateLight(p.Position + Vector(0, 60), 2.0, 40, 5, Color(1, 0, 0, 1, 0, 0, 0))
+      check("CreateLight returns a light effect", fx ~= nil and fx.Type == 1000 and fx.Variant == 121)
+      check("CreateLight state", fx and fx.State == 5, fx and fx.State)
+      check("CreateLight lifespan", fx and fx.LifeSpan == 40 and fx.Timeout == 40, fx and (fx.LifeSpan .. "/" .. fx.Timeout))
+      check("CreateLight scale", fx and near(fx.SpriteScale.X, 2.0 * (fx.SpriteScale.X / 2.0)) and fx.SpriteScale.X > 1.5, fx and tostring(fx.SpriteScale))
+      local d = EntityEffect.CreateLight(p.Position)
+      check("CreateLight defaults (state 6, lifespan -1)", d and d.State == 6 and d.LifeSpan == -1, d and (d.State .. "/" .. d.LifeSpan))
+    end)
+    try("effect tear flags", function()
+      p.TearFlags = TearFlags.TEAR_HOMING | TearFlags.TEAR_BURN
+      local ef = Isaac.Spawn(1000, 113, 0, p.Position, Vector(0, 0), p):ToEffect()
+      ef:SetTearFlags(p.TearFlags)
+      check("effect layout: State and Timeout properties at 0x450/0x45c", ef.State == ri32(B.ptr(ef) + 0x450) and ef.Timeout == ri32(B.ptr(ef) + 0x45c), ef.State .. "/" .. ef.Timeout)
+      check("brimstone ball exists", ef ~= nil and ef.Variant == 113, ef and ef.Variant)
+      if ef then
+        local f = ef:GetTearFlags()
+        check("GetTearFlags is a BitSet128 holding the player's flags", f ~= nil and ef:HasTearFlags(TearFlags.TEAR_HOMING), f and tostring(f))
+        ef:ClearTearFlags(TearFlags.TEAR_HOMING)
+        check("ClearTearFlags", not ef:HasTearFlags(TearFlags.TEAR_HOMING) and ef:HasTearFlags(TearFlags.TEAR_BURN))
+        ef:AddTearFlags(TearFlags.TEAR_SPECTRAL)
+        check("AddTearFlags", ef:HasTearFlags(TearFlags.TEAR_SPECTRAL))
+        ef:SetTearFlags(TearFlags.TEAR_PIERCING)
+        check("SetTearFlags", ef:HasTearFlags(TearFlags.TEAR_PIERCING) and not ef:HasTearFlags(TearFlags.TEAR_BURN))
+        check("Aquarius alias", ef:HasAquariusTearFlags(TearFlags.TEAR_PIERCING) and ef:GetAquariusTearFlags() ~= nil)
+      end
+      local other = Isaac.Spawn(1000, 1, 0, p.Position, Vector(0, 0), nil):ToEffect()
+      check("other effect variants answer nil / false", other:GetTearFlags() == nil and other:HasTearFlags(TearFlags.TEAR_HOMING) == false)
+      other:SetTearFlags(TearFlags.TEAR_HOMING)
+      check("SetTearFlags on another variant does nothing", other:GetTearFlags() == nil)
+      p.TearFlags = TearFlags.TEAR_NORMAL
+    end)
+    -- the game's own reaction to TearParams: a tear fired with the callback's values
+    try("fired tear shows the params", function()
+      hooked, hp_seen.set = false, nil
+      local t2 = p:FireTear(p.Position, Vector(5, 0), false, true, false, p, 1)
+      check("callback ran", hp_seen.set == true)
+      check("tear KnockbackMultiplier follows TearParams.KnockbackMultiplier", near(t2.KnockbackMultiplier, 4.5), t2.KnockbackMultiplier)
+    end)
+  end
+  if frame == 25 then
+    try("tear sound", function()
+      check("pending tear sound cleared after the first update", true)
+    end)
+    B.log(string.format("lab_tears_more: %d PASS, %d FAIL", npass, nfail))
+    B.log("lab_tears_more: DONE")
+    Isaac.ExecuteCommand("quit")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_tears_probe.lua b/scripts/recomp/rgon/lab_tears_probe.lua
new file mode 100644
index 0000000..5a2fab2
--- /dev/null
+++ b/scripts/recomp/rgon/lab_tears_probe.lua
@@ -0,0 +1,47 @@
+-- lab_tears_probe.lua (development only; ISAAC_RGON_LAB=lab_tears_probe.lua): which names the five tear-like
+-- classes already have, and raw dumps of a TearParams, a laser, a tear, a knife, an effect and a projectile.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab tears probe", 1)
+local function say(s) B.log("lab_tears_probe: " .. s) end
+local function keys(cls)
+  local c = T.class_tables(cls)
+  local t = {}
+  for k in pairs(c) do if type(k) == "string" and not k:find("^__") then t[#t + 1] = k end end
+  local pg = rawget(c, "__propget")
+  if type(pg) == "table" then for k in pairs(pg) do t[#t + 1] = "." .. tostring(k) end end
+  table.sort(t)
+  say(cls .. ": " .. table.concat(t, " "))
+end
+local function dump(name, a, from, to)
+  for o = from, to - 4, 16 do
+    say(string.format("%s +%04x %08x %08x %08x %08x", name, o, r32(a + o), r32(a + o + 4), r32(a + o + 8), r32(a + o + 12)))
+  end
+end
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    for _, c in ipairs({ "EntityTear", "EntityLaser", "EntityKnife", "EntityEffect", "EntityProjectile", "TearParams", "ProjectileParams" }) do
+      local ok, e = pcall(keys, c)
+      if not ok then say(c .. " " .. tostring(e)) end
+    end
+    local tp = p:GetTearHitParams(WeaponType.WEAPON_TEARS, 1, 1, nil)
+    say(string.format("TearParams: damage %g scale %g height %g variant %d flags %s", tp.TearDamage, tp.TearScale, tp.TearHeight, tp.TearVariant, tostring(tp.TearFlags)))
