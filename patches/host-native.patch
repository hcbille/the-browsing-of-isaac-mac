+-- lab_el.lua (development only; ISAAC_RGON_LAB=lab_el.lua): the room-change hang. Epiphany's Essence of Samson registers
+-- MC_POST_PLAYER_TRIGGER_EFFECT_REMOVED with `ItemConfig:GetNullItem(Isaac.GetNullItemIdByName("essence of samson"))`
+-- as its parameter; with the Layer that id is -1 (the game gives a mod's <null> without id the id 0), the parameter is nil,
+-- the callback runs for EVERY removed effect and each run hurts the player and adds an effect again. This lab prints the
+-- ids, gives the player a plain effect, changes room (the room change clears the effects) and logs how many removals fired.
+-- Logs "lab_el: ..." lines; the run is meant to end at the alarm if the loop is there (ISAAC_LAB_EL_ROOM=0 to skip the change).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab el", 1)
+local function say(s) B.log("lab_el: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local cfg = Isaac.GetItemConfig()
+local removed = 0
+mod:AddCallback(ModCallbacks.MC_POST_PLAYER_TRIGGER_EFFECT_REMOVED, function(_, player, item, count)
+  removed = removed + 1
+  if removed <= 12 or removed % 500 == 0 then
+    say(string.format("effect removed #%d: item type=%s id=%s count=%s", removed, tostring(item.Type), tostring(item.ID), tostring(count)))
+  end
+end)
+local wait, reg = 0, false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if not Isaac.IsInGame() then return end
+  wait = wait + 1
+  local p = Isaac.GetPlayer(0)
+  local ef = p:GetEffects()
+  if not reg then
+    reg = true
+    local A = Isaac.GetNullItemIdByName("essence of samson")
+    local D = Isaac.GetNullItemIdByName("essence of samson damage")
+    say(string.format("null ids: samson=%s damage=%s (-1 = not found); GetNullItem(samson)=%s; null items Size=%s",
+      tostring(A), tostring(D), tostring(cfg:GetNullItem(A)), tostring(cfg:GetNullItems().Size)))
+    local z = cfg:GetNullItem(0)
+    say(string.format("null item 0: Name='%s' (the last id-less <null> of any mod lands here)", tostring(z and z.Name)))
+  end
+  if wait == 60 then
+    ef:AddCollectibleEffect(CollectibleType.COLLECTIBLE_SAD_ONION, false, 1)
+    say("added a Sad Onion effect; has=" .. tostring(ef:HasCollectibleEffect(CollectibleType.COLLECTIBLE_SAD_ONION)))
+  elseif wait == 90 and B.env("ISAAC_LAB_EL_ROOM") ~= "0" then
+    local lvl = Game():GetLevel()
+    say("room change from " .. lvl:GetCurrentRoomIndex())
+    Game():StartRoomTransition(lvl:GetCurrentRoomIndex(), Direction.NO_DIRECTION, RoomTransitionAnim.TELEPORT)
+  elseif wait == 91 then
+    say("StartRoomTransition returned")
+  elseif wait == 240 then
+    say(string.format("after the room change: %d effect removals fired", removed))
+  end
+end)
