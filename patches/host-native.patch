@@ -195,6 +195,45 @@ end
 ------------------------------------------------------------------------------
 -- Isaac.GetNullItemIdByName(name) -> the id of a null item (costumes and
 -- effects with no pedestal), or -1. The item configuration lists them.
+-- The game gives a mod's <null> that has no id="" the id 0 (each such entry overwrites the last, so only the
+-- last one of all mods is left, at 0): REPENTOGON numbers them, this build cannot. A mod (Epiphany: "essence of
+-- samson") asks for such a null's id and gets -1; `ItemConfig:GetNullItem(-1)` is nil, and a callback registered
+-- with that nil as its parameter (MC_POST_PLAYER_TRIGGER_EFFECT_REMOVED, ..._ADD_EFFECT) runs for EVERY effect:
+-- Epiphany's then hurt the player with Dull Razor, which adds an effect, which the room change removes again, over and
+-- over inside one frame (the hang of 2026-11-19, .scratch/hang-el). So such a name answers a reserved id instead: an
+-- unused blank slot at the top of the game's null list (no vanilla name, nothing the game ever adds), taken from the
+-- end downwards in load order. Callbacks given its config item then match nothing real. The null's stats, cooldown and
+-- persistence are not there (R.Unsupported), and `EntityPlayer:AddNullItemEffect` ignores a reserved id (api_gaps.lua).
+local reserved_by_name, reserved_ids
+local function reserve_nulls()
+  reserved_by_name, reserved_ids = {}, {}
+  local nodes_of = T.nodes_of
+  if not nodes_of then return end
+  local config = Isaac.GetItemConfig()
+  local top = config:GetNullItems().Size - 1
+  for _, node in ipairs(nodes_of("items.xml", { "null" })) do
+    local name = node.attr.name
+    if node.source and name and name ~= "" and mathtype(math.tointeger(tonumber(node.attr.id))) ~= "integer" and not reserved_by_name[name] then
+      while top > 0 do
+        local item = config:GetNullItem(top)
+        if item and item.Name == "" then break end
+        top = top - 1
+      end
+      if top <= 0 then break end
+      reserved_by_name[name] = top
+      reserved_ids[top] = name
+      top = top - 1
+    end
+  end
+  if next(reserved_by_name) then
+    R.Unsupported = R.Unsupported or {}
+    R.Unsupported["a mod's <null> without an id"] = "its stats, cooldown and persistence are not loaded; Isaac.GetNullItemIdByName gives a reserved blank id and AddNullItemEffect ignores it"
+  end
+end
+function T.reserved_null(id)
+  if not reserved_ids then reserve_nulls() end
+  return reserved_ids[id]
+end
 static(Isaac, "Isaac", "GetNullItemIdByName", function(name)
   if type(name) ~= "string" then error("bad argument #1 to 'GetNullItemIdByName' (string expected, got " .. type(name) .. ")", 2) end
   local config = Isaac.GetItemConfig()
@@ -202,7 +241,8 @@ static(Isaac, "Isaac", "GetNullItemIdByName", function(name)
     local item = config:GetNullItem(id)
     if item and item.Name == name then return item.ID end
   end
-  return -1
+  if not reserved_by_name then reserve_nulls() end
+  return reserved_by_name[name] or -1
 end)
 
