index 0000000..1bfe19c
--- /dev/null
+++ b/scripts/recomp/rgon/api_gaps.lua
@@ -0,0 +1,536 @@
+-- api_gaps.lua -- gaps the Mac Build's gate log named for the Target Mods (milestone M8),
+-- Epiphany first. Each piece says what in the log it answers.
+--
+--   Sprite.Color as a reference        epiphany_menu.lua:35 `sprite.Color.A = 0`: "no member named 'A'"
+--   BlendMode, LayerState:GetBlendMode  epiphany_menu.lua:40: a layer's blend mode is read and changed
+--
+-- (Sprite(path, load), the constructor, is in api_sprite.lua.)
+
+local T = ...
+local B, R, method, this, wrap = T.B, T.R, T.method, T.this, T.wrap
+local ptr, r32, w32, log, cfn = B.ptr, B.r32, B.w32, B.log, B.cfn
+local type, error, setmetatable, rawget, rawset, tostring = type, error, setmetatable, rawget, rawset, tostring
+local mathtype = math.type
+
+-- Sprite.Color: the game hands out a const Color (a copy-free view that cannot be written),
+-- REPENTOGON a reference. A sprite's colour is at +0xa8 (rgon.lua, GetLayer: checked against
+-- the game's own getter), so the getter is replaced by one that wraps that address in the
+-- ordinary Color class: `sprite.Color.A = 0` then changes the sprite, as it does there.
+do
+  local cls, const = T.class_tables("Sprite")
+  local done = false
+  for _, tbl in ipairs({ cls, const }) do
+    local pg = type(tbl) == "table" and rawget(tbl, "__propget")
+    if type(pg) == "table" and rawget(pg, "Color") ~= nil then
+      rawset(pg, "Color", cfn(function(self) return wrap("Color", this(self, "Sprite.Color") + 0xa8) end))
+      done = true
+    end
+  end
+  if done then R.Implemented["Sprite.Color"] = true
+  else log("api_gaps: Sprite.Color was not where it was expected; left as the game has it") end
+end
+
+-- BlendMode: five ints, equation +0, RGB source +4, RGB destination +8, alpha source +0xc,
+-- alpha destination +0x10, at +0x78 of a layer state (REPENTOGON's LayerState: the layer
+-- state's neighbours, 0x74 visible, 0x8c render flags, 0x90 crop, are where this build has
+-- them, rgon.lua GetLayer). A BlendMode read from a layer is that memory, so a change reaches
+-- the layer as the game's own code reads it; BlendMode.New makes a block of its own.
+do
+  local FIELD = { Equation = 0, RGBSourceFactor = 4, RGBDestinationFactor = 8, AlphaSourceFactor = 0xc, AlphaDestinationFactor = 0x10,
+    Flag1 = 4, Flag2 = 8, Flag3 = 0xc, Flag4 = 0x10 }   -- Flag1..4: REPENTOGON's deprecated names for the four factors
+  local NFACTORS, NEQUATIONS = 15, 5
+  local PRESETS = {                                  -- BlendType -> equation, rgb src, rgb dst, alpha src, alpha dst
+    [0] = { 0, 1, 0, 1, 0 },                         -- CONSTANT
+    { 0, 1, 7, 1, 7 },                               -- NORMAL (premultiplied alpha)
+    { 0, 1, 1, 1, 1 },                               -- ADDITIVE
+    { 0, 0, 2, 0, 2 },                               -- MULTIPLICATIVE
+    { 0, 4, 7, 4, 7 },                               -- OVERLAY
+  }
+  local owned = setmetatable({}, { __mode = "k" })   -- object -> its own block
+
+  local function addr(self)
+    local a = type(self) == "table" and rawget(self, "_a")
+    if not a then error("rgon: BlendMode used without its object", 3) end
+    return a
+  end
+  local function checked(v, limit, what, level)
+    if mathtype(v) ~= "integer" and type(v) ~= "number" then error("bad argument (number expected) for " .. what, level) end
+    v = math.floor(v)
+    if v < 0 or v >= limit then error("bad argument: invalid " .. what, level) end
+    return v
+  end
+  local function setall(a, e, rs, rd, as, ad)
+    w32(a, e) w32(a + 4, rs) w32(a + 8, rd) w32(a + 0xc, as) w32(a + 0x10, ad)
+  end
+
+  local METHODS = {}
+  function METHODS.SetMode(self, ...)
+    local a = addr(self)
+    local n = select("#", ...)
+    if n >= 2 then
+      local rs, rd, as, ad, e = ...
+      setall(a,
+        e == nil and r32(a) or checked(e, NEQUATIONS, "blend equation", 2),
+        rs == nil and r32(a + 4) or checked(rs, NFACTORS, "blend factor", 2),
+        rd == nil and r32(a + 8) or checked(rd, NFACTORS, "blend factor", 2),
+        as == nil and r32(a + 0xc) or checked(as, NFACTORS, "blend factor", 2),
+        ad == nil and r32(a + 0x10) or checked(ad, NFACTORS, "blend factor", 2))
+    else
+      local p = PRESETS[math.floor((...))]
+      if p then setall(a, p[1], p[2], p[3], p[4], p[5]) end   -- an unknown mode is ignored
+    end
+  end
+
+  local MT = {
+    __type = "BlendMode", __name = "BlendMode",
+    __index = function(self, k)
+      local f = FIELD[k]
+      if f then return r32(addr(self) + f) end
+      return METHODS[k]
+    end,
+    __newindex = function(self, k, v)
+      local f = FIELD[k]
+      if not f then error("no member named '" .. tostring(k) .. "'", 2) end
+      w32(addr(self) + f, checked(v, k == "Equation" and NEQUATIONS or NFACTORS, k == "Equation" and "blend equation" or "blend factor", 2))
+    end,
+    __eq = function(a, b) return rawget(a, "_a") == rawget(b, "_a") end,
+    __tostring = function(self) return "BlendMode(" .. r32(addr(self)) .. "," .. r32(addr(self) + 4) .. "," .. r32(addr(self) + 8)
+      .. "," .. r32(addr(self) + 0xc) .. "," .. r32(addr(self) + 0x10) .. ")" end,
+    __gc = function(self) local a = rawget(self, "_own") if a then B.free(a) end end,
+  }
+  local function at(a, own) return setmetatable({ _a = a, _own = own }, MT) end
+
+  -- what rgon.lua's LayerState:GetBlendMode calls
+  R.BlendModeAt = function(a) return at(a) end
+
+  local BM = {}
+  function BM.New(rs, rd, as, ad, e)
+    local a = B.alloc(0x14)
+    setall(a,
+      e == nil and 0 or checked(e, NEQUATIONS, "blend equation", 2),
+      rs == nil and 1 or checked(rs, NFACTORS, "blend factor", 2),
+      rd == nil and 0 or checked(rd, NFACTORS, "blend factor", 2),
+      as == nil and 1 or checked(as, NFACTORS, "blend factor", 2),
+      ad == nil and 0 or checked(ad, NFACTORS, "blend factor", 2))
+    return at(a, a)
+  end
+  function BM.NewFromType(t)
+    local p = PRESETS[math.floor(t or -1)]
+    if not p then error("bad argument #1 to 'NewFromType': Invalid blend type", 2) end
+    local a = B.alloc(0x14)
+    setall(a, p[1], p[2], p[3], p[4], p[5])
+    return at(a, a)
+  end
+  if rawget(_G, "BlendMode") == nil then rawset(_G, "BlendMode", BM) end
+  R.Implemented["BlendMode.New"] = true
+  R.Implemented["BlendMode.NewFromType"] = true
+  R.Implemented["BlendMode.SetMode"] = true
+  for k in pairs(FIELD) do R.Implemented["BlendMode." .. k] = true end
+end
+
+-- ColorModifier(R = 1, G = 1, B = 1, A = 0, Brightness = 0, Contrast = 1): a colour correction.
+-- A value of the Lua side: six numbers with + - (two of them) and * / (by a number, the
+-- ColorModifier on the left), as REPENTOGON's. epiphany_menu.lua:138.
+do
+  local FIELDS = { "R", "G", "B", "A", "Brightness", "Contrast" }
+  local MT = { __type = "ColorModifier", __name = "ColorModifier" }
+  local function new(r, g, b, a, br, c)
+    return setmetatable({ R = r, G = g, B = b, A = a, Brightness = br, Contrast = c }, MT)
+  end
+  local function num(v, what) if type(v) ~= "number" then error("bad argument (number expected) for ColorModifier " .. what, 3) end return v end
+  MT.__index = function(_, k) return nil end
+  MT.__newindex = function(t, k, v)
+    for _, f in ipairs(FIELDS) do if f == k then rawset(t, k, num(v, k)) return end end
+    error("no member named '" .. tostring(k) .. "'", 2)
+  end
+  local function isc(v) return type(v) == "table" and getmetatable(v) == MT end
+  local function both(a, b, f)
+    if not isc(a) or not isc(b) then error("bad argument: ColorModifier expected", 3) end
+    return new(f(a.R, b.R), f(a.G, b.G), f(a.B, b.B), f(a.A, b.A), f(a.Brightness, b.Brightness), f(a.Contrast, b.Contrast))
+  end
+  MT.__add = function(a, b) return both(a, b, function(x, y) return x + y end) end
+  MT.__sub = function(a, b) return both(a, b, function(x, y) return x - y end) end
+  MT.__mul = function(a, k)
+    if type(a) == "number" then error("Cannot left multiply a ColorModifier with a number", 2) end
+    if not isc(a) or type(k) ~= "number" then error("bad argument: ColorModifier * number expected", 2) end
+    return new(a.R * k, a.G * k, a.B * k, a.A * k, a.Brightness * k, a.Contrast * k)
+  end
+  MT.__div = function(a, k)
+    if type(a) == "number" then error("Cannot left divide a ColorModifier with a number", 2) end
+    if not isc(a) or type(k) ~= "number" then error("bad argument: ColorModifier / number expected", 2) end
+    if k == 0 then error("Divide by zero", 2) end
+    return new(a.R / k, a.G / k, a.B / k, a.A / k, a.Brightness / k, a.Contrast / k)
+  end
+  MT.__eq = function(a, b)
+    return a.R == b.R and a.G == b.G and a.B == b.B and a.A == b.A and a.Brightness == b.Brightness and a.Contrast == b.Contrast
+  end
+  MT.__tostring = function(s) return string.format("ColorModifier(%g,%g,%g,%g,%g,%g)", s.R, s.G, s.B, s.A, s.Brightness, s.Contrast) end
+  if rawget(_G, "ColorModifier") == nil then
+    rawset(_G, "ColorModifier", setmetatable({}, { __call = function(_, r, g, b, a, br, c)
+      return new(r == nil and 1 or num(r, "R"), g == nil and 1 or num(g, "G"), b == nil and 1 or num(b, "B"),
+                 a == nil and 0 or num(a, "A"), br == nil and 0 or num(br, "Brightness"), c == nil and 1 or num(c, "Contrast"))
+    end }))
+    R.Implemented["ColorModifier.ColorModifier"] = true
+  end
+  T.ColorModifier = { new = new, is = isc }
+end
+
+-- EntityConfigPlayer: the fields of a character's config that players.xml fills and the
+-- layer's own table (api_data.lua) leaves out: costume, name and portrait paths, starting
+-- items. Read from the config record in the game's memory (T.player_config: 0x148 bytes each,
+-- `ri32(at) == the player type`), at REPENTOGON's offsets for the record; the two this build
+-- is known to share (achievement +0xe8, hidden +0x128) and the name at +4 are the check:
+-- a record whose name is not the one players.xml gave is not read.
+do
+  local pc = T.player_config
+  local sample = EntityConfig and EntityConfig.GetPlayer and EntityConfig.GetPlayer(0)
+  local PC = sample and getmetatable(sample) and getmetatable(sample).__index
+  if type(PC) == "table" and pc then
+    local ri32, stdstr = B.ri32, B.stdstr
+    local checked = {}
+    local function rec(self, what)
+      local at = pc(self._id)
+      if not at then return nil end
+      if checked[self._id] == nil then
+        checked[self._id] = (stdstr(at + 4) == (self._x.name or "")) or false
+        if not checked[self._id] then log("api_gaps: the config record of player " .. self._id .. " does not hold its name; " .. what .. " answers its default") end
+      end
+      return checked[self._id] and at or nil
+    end
+    local function int(name, off, default)
+      PC[name] = function(self) local at = rec(self, name) return at and ri32(at + off) or default end
+      R.Implemented["EntityConfigPlayer." .. name] = true
+    end
+    local function str(name, off)
+      PC[name] = function(self) local at = rec(self, name) return at and stdstr(at + off) or "" end
+      R.Implemented["EntityConfigPlayer." .. name] = true
+    end
+    str("GetNameImagePath", 0x34)
+    str("GetPortraitPath", 0x4c)
+    str("GetExtraPortraitPath", 0x7c)
+    str("GetBirthrightDescription", 0xf4)
+    int("GetCostumeID", 0xac, -1)
+    int("GetSkinColor", 0xe4, 0)
+    int("GetTrinket", 0xe0, 0)
+    int("GetCard", 0xc8, 0)
+    int("GetPill", 0xcc, 0)
+    int("GetPocketActive", 0xf0, 0)
+    int("GetBrokenHearts", 0xec, 0)
+    PC.GetCollectibles = function(self)
+      local at = rec(self, "GetCollectibles")
+      local out = {}
+      if at then
+        local first, last = B.r32(at + 0xd4), B.r32(at + 0xd8)
+        for a = first, last - 4, 4 do out[#out + 1] = ri32(a) end
+      end
+      return out
+    end
+    R.Implemented["EntityConfigPlayer.GetCollectibles"] = true
+  else
+    log("api_gaps: EntityConfig.GetPlayer is not the layer's own; the config's extra fields are left out")
+  end
+end
+
+-- Console.RegisterMacro(name, commands): REPENTOGON's console lists it for `macro <name>`.
+-- Kept; the game's console here has no `macro` to run it.
+do
+  local C = rawget(_G, "Console")
+  if type(C) == "table" and rawget(C, "RegisterMacro") == nil then
+    local macros = {}
+    function C.RegisterMacro(name, commands)
+      if type(name) ~= "string" then error("bad argument #1 to 'RegisterMacro' (string expected, got " .. type(name) .. ")", 2) end
+      if type(commands) ~= "table" then error("bad argument #2 to 'RegisterMacro' (table expected, got " .. type(commands) .. ")", 2) end
+      macros[name] = commands
+      T.unsupported("Console.RegisterMacro", "the macro is kept; the console cannot run it")
+    end
+  end
+end
+
+-- Item pools from itempools.xml: Isaac.GetPoolIdByName(name), ItemPool:GetCollectiblesFromPool(pool),
+-- ItemPool:GetNumItemPools(). The game's own pools are ItemPoolType 0 and up in the file's order (checked
+-- against the enum's names); a pool a mod's itempools.xml names that the game has not is a custom pool and
+-- gets the numbers after them, in load order. The game itself has no such pool: an id of one is the layer's
+-- (accepted, not supported: nothing in the game draws from it). Weights are the file's own, as the pools start.
+do
+  local XML = rawget(_G, "XMLNode")
+  local function norm(s) return (tostring(s):gsub("^POOL_", ""):gsub("[_%s]", ""):lower()) end
+  local pools                       -- norm name -> { id, name, items = { {id, weight, decreaseby, removeon} } }
+  local order
+  local function build()
+    if pools then return pools end
+    pools, order = {}, {}
+    local enum = {}
+    for k, v in pairs(rawget(_G, "ItemPoolType") or {}) do if type(v) == "number" then enum[norm(k)] = v end end
+    local top = -1
+    for _, v in pairs(enum) do if v > top then top = v end end
+    local nodes = T.nodes_of and T.nodes_of("itempools.xml", { "Pool", "pool" }) or {}
+    local custom = top
+    for _, node in ipairs(nodes) do
+      local name = node.attr.name
+      if name then
+        local key = norm(name)
+        local p = pools[key]
+        if not p then
+          local id = enum[key]
+          if not id then custom = custom + 1 id = custom end
+          p = { id = id, name = name, items = {}, custom = enum[key] == nil }
+          pools[key] = p
+          order[#order + 1] = p
+        end
+        for _, it in ipairs(node) do
+          local a = it.attr
+          local id = math.tointeger(tonumber(a.id or a.collectible or ""))
+          if id then
+            p.items[#p.items + 1] = { id, tonumber(a.weight) or 1.0, tonumber(a.decreaseby) or 1.0, tonumber(a.removeon) or 0.1 }
+          end
+        end
+      end
+    end
+    return pools
+  end
+  T.static(Isaac, "Isaac", "GetPoolIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetPoolIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    local p = build()[norm(name)]
+    return p and p.id or -1
+  end)
+  T.method("ItemPool", "GetCollectiblesFromPool", function(self, pool)
+    if math.type(pool) ~= "integer" then error("bad argument #1 to 'GetCollectiblesFromPool' (integer expected, got " .. type(pool) .. ")", 2) end
+    build()
+    local out = {}
+    for _, p in ipairs(order) do
+      if p.id == pool then
+        for _, it in ipairs(p.items) do
+          out[#out + 1] = { itemID = it[1], initialWeight = it[2], weight = it[2], decreaseBy = it[3], removeOn = it[4], isUnlocked = true }
+        end
+      end
+    end
+    return out
+  end)
+  T.method("ItemPool", "GetNumItemPools", function() build() return #order end)
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["ItemPool custom pools"] = "a pool only a mod's itempools.xml names has an id here; the game does not draw from it"
+end
+
+-- Isaac.GetGiantBookIdByName(name): giantbook.xml's entries. The game's own carry their id; a mod's follow the
+-- highest, in load order. -1 when there is none. (ItemOverlay.Show, which draws the book, is in api_menus.lua.)
+do
+  local XN = rawget(_G, "XMLNode")
+  local ids
+  local function build()
+    if ids then return ids end
+    ids = {}
+    local set = XN and XN.GIANTBOOK and T.xml_entries and T.xml_entries(XN.GIANTBOOK)
+    if not set then return ids end
+    local top = 0
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if id and id > top then top = id end
+    end
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if not id and e.sourceid then top = top + 1 id = top end
+      if id and e.name and ids[e.name:lower()] == nil then ids[e.name:lower()] = id end
+    end
+    return ids
+  end
+  T.static(Isaac, "Isaac", "GetGiantBookIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetGiantBookIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    return build()[name:lower()] or -1
+  end)
+end
+
+-- EntityPlayer custom cache (REPENTOGON): :AddCustomCacheTag(tag | {tags}, evaluate = false),
+-- :HasCustomCacheTag(tag), :RemoveCustomCacheTag(tag), :GetCustomCacheTags(), :GetCustomCacheValue(tag).
+-- A tag is "evaluated" by firing MC_EVALUATE_CUSTOM_CACHE (player, tag, value), param = tag, the value starting at the
+-- tag's default (0.0, the built-in tags have their own) and each function's return replacing it; the result is what
+-- GetCustomCacheValue answers. As REPENTOGON does it: a tag waits in the player's pending set (AddCustomCacheTag puts
+-- it there) and Entity_Player::EvaluateItems (hook slot 74, api_gaps.lua's `before`) evaluates the pending ones, all
+-- the known ones (every items.xml customcache tag) when the player's cache flags are CACHE_ALL; adding or removing
+-- a collectible or a trinket that has custom cache tags evaluates those tags at once.
+-- The player's cache flags are the word at +0x1574 (EvaluateItems reads it; measured by lab_cb_f.lua).
+do
+  local M = ModCallbacks
+  local pending, values = {}, {}      -- player hash -> { tag = true } / { tag = number }
+  local added = {}                    -- player hash -> { tag = true }: the tags AddCustomCacheTag gave (HasCustomCacheTag)
+  local function hash(p) return GetPtrHash(p) end
+  local function tag_list(v, what)
+    local out = {}
+    if type(v) == "string" then out[1] = v:lower()
+    elseif type(v) == "table" then for _, t in ipairs(v) do if type(t) == "string" then out[#out + 1] = t:lower() end end
+    else error("bad argument #1 to '" .. what .. "' (string or table expected, got " .. type(v) .. ")", 3) end
+    return out
+  end
+  local function item_tags(kind, id)
+    local items = T.custom_cache_items and T.custom_cache_items() or {}
+    return items[kind .. ":" .. id]
+  end
+  local function tags_of(player)
+    local all = {}
+    for t in pairs(added[hash(player)] or {}) do all[t] = true end
+    local items = T.custom_cache_items and T.custom_cache_items() or {}
+    for k, set in pairs(items) do
+      local kind, id = k:sub(1, 1), math.tointeger(tonumber(k:sub(3)))
+      local held = false
+      if kind == "c" then held = player:HasCollectible(id, true)
+      elseif kind == "t" then held = player:HasTrinket(id, true)
+      elseif kind == "n" then held = player:GetEffects():HasNullEffect(id) end
+      if held then for t in pairs(set) do all[t] = true end end
+    end
+    return all
+  end
+  -- the value a tag has before any callback (REPENTOGON's GetDefaultCustomCacheValue)
+  local function default_of(player, tag)
+    if tag == "maxcoins" then return player:HasCollectible(CollectibleType.COLLECTIBLE_DEEP_POCKETS, true) and 999.0 or 99.0 end
+    if tag == "maxkeys" or tag == "maxbombs" then return 99.0 end
+    if tag == "tearscap" then return 5.0 end
+    if tag == "statmultiplier" then
+      local m = 1.0 + player:GetTrinketMultiplier(TrinketType.TRINKET_CRACKED_CROWN) * 0.2
+      if player:GetPlayerType() == PlayerType.PLAYER_BETHANY_B then m = m * 0.75 end
+      return m
+    end
+    return 0.0
+  end
+  -- RunEvaluateCustomCacheCallback
+  local function evaluate_tag(player, tag)
+    local h = hash(player)
+    local v = default_of(player, tag)
+    if M.MC_EVALUATE_CUSTOM_CACHE then
+      local r = T.run(M.MC_EVALUATE_CUSTOM_CACHE, tag, player, tag, v)
+      if type(r) == "number" then v = r + 0.0 end
+    end
+    values[h] = values[h] or {}
+    values[h][tag] = v
+  end
+  local function evaluate_pending(player)
+    local h = hash(player)
+    local set = pending[h]
+    if not set or next(set) == nil then return end
+    pending[h] = {}
+    local list = {}
+    for t in pairs(set) do list[#list + 1] = t end
+    table.sort(list)
+    for _, t in ipairs(list) do evaluate_tag(player, t) end
+  end
+  local function trigger_item(player, kind, id)
+    local set = item_tags(kind, id)
+    if not set then return end
+    local h = hash(player)
+    for t in pairs(set) do
+      if pending[h] then pending[h][t] = nil end
+      evaluate_tag(player, t)
+    end
+  end
+  T.custom_cache_evaluate_pending = evaluate_pending
+  T.custom_cache_add_all_known = function(player)
+    local h = hash(player)
+    pending[h] = pending[h] or {}
+    for _, set in pairs(T.custom_cache_items and T.custom_cache_items() or {}) do
+      for t in pairs(set) do pending[h][t] = true end
+    end
+  end
+  local P = "EntityPlayer"
+  T.method(P, "AddCustomCacheTag", function(self, tags, now)
+    local h = hash(self)
+    local a = added[h] or {}
+    added[h] = a
+    pending[h] = pending[h] or {}
+    for _, t in ipairs(tag_list(tags, "AddCustomCacheTag")) do a[t] = true pending[h][t] = true end
+    if now then self:EvaluateItems() end
+  end)
+  T.method(P, "RemoveCustomCacheTag", function(self, tags)
+    local a = added[hash(self)]
+    if a then for _, t in ipairs(tag_list(tags, "RemoveCustomCacheTag")) do a[t] = nil end end
+  end)
+  T.method(P, "HasCustomCacheTag", function(self, tag)
+    if type(tag) ~= "string" then error("bad argument #1 to 'HasCustomCacheTag' (string expected, got " .. type(tag) .. ")", 2) end
+    return tags_of(self)[tag:lower()] == true
+  end)
+  T.method(P, "GetCustomCacheTags", function(self)
+    local out = {}
+    for t in pairs(tags_of(self)) do out[#out + 1] = t end
+    table.sort(out)
+    return out
+  end)
+  T.method(P, "GetCustomCacheValue", function(self, tag)
+    if type(tag) ~= "string" then error("bad argument #1 to 'GetCustomCacheValue' (string expected, got " .. type(tag) .. ")", 2) end
+    tag = tag:lower()
+    local v = values[hash(self)]
+    if v and v[tag] ~= nil then return v[tag] end
+    return default_of(self, tag)
+  end)
+  if T.listen then
+    local function on(id, kind)
+      if id then T.listen(id, function(_, player, item) if player and math.type(item) == "integer" then trigger_item(player, kind, item) end end, -math.huge) end
+    end
+    on(M.MC_POST_TRIGGER_COLLECTIBLE_ADDED, "c")
+    on(M.MC_POST_TRIGGER_COLLECTIBLE_REMOVED, "c")
+    on(M.MC_POST_TRIGGER_TRINKET_ADDED, "t")
+    on(M.MC_POST_TRIGGER_TRINKET_REMOVED, "t")
+  end
+end
+
+-- Isaac.GetString(category, key): the game's string table (resources/stringtable.sta: a category holds keys,
+-- a key one <string> per language in the file's language order). English is always answered (the game's
+-- language option is not read); a key it has none of answers "StringTable::InvalidKey", as REPENTOGON's does.
+do
+  local text
+  local cats = {}
+  local function unesc(s)
+    return (s:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&apos;", "'"):gsub("&amp;", "&"))
+  end
+  T.static(Isaac, "Isaac", "GetString", function(category, key)
+    if type(category) ~= "string" then error("bad argument #1 to 'GetString' (string expected, got " .. type(category) .. ")", 2) end
+    if type(key) ~= "string" then error("bad argument #2 to 'GetString' (string expected, got " .. type(key) .. ")", 2) end
+    if text == nil then text = T.read_file and T.read_file("resources/stringtable.sta") or false end
+    if not text then return "StringTable::InvalidKey" end
+    local c = cats[category]
+    if c == nil then
+      local a, e = text:find('<category name="' .. category .. '">', 1, true)
+      if a then
+        local z = text:find("</category>", e, true)
+        c = { e, z or #text }
+      else
+        c = false
+      end
+      cats[category] = c
+    end
+    if not c then return "StringTable::InvalidKey" end
+    local a, e = text:find('<key name="' .. key .. '">', c[1], true)
+    if not a or a > c[2] then return "StringTable::InvalidKey" end
+    local s = text:match("<string>(.-)</string>", e)
+    if not s then return "StringTable::InvalidKey" end
+    return unesc(s)
+  end)
+end
+
+-- Level:HasMirrorDimension(): the floor has the mirror world (dimension 1 holding the mirrored floor): Downpour II
+-- and Dross II (Curse of the Labyrinth makes the first floor of each the one that has it), not in Greed Mode.
+-- The game's own rule as miniMAPI states it for itself (cache.lua); the game gives the layer no field for it.
+T.method("Level", "HasMirrorDimension", function(self)
+  if Game():IsGreedMode() then return false end
+  local alt = self:GetStageType()
+  if alt ~= StageType.STAGETYPE_REPENTANCE and alt ~= StageType.STAGETYPE_REPENTANCE_B then return false end
+  local stage = self:GetAbsoluteStage()
+  if stage == LevelStage.STAGE1_2 then return self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH == 0 end
+  return stage == LevelStage.STAGE1_1 and self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH ~= 0
+end)
+
+-- EntityPlayer:AddNullItemEffect(id, applyCostume = false, cooldown, additive = true) and the same for trinkets and
+-- collectibles (REPENTOGON's shortcuts of TemporaryEffects:Add*Effect with a cooldown). The effect is added through the
+-- game's own TemporaryEffects; the cooldown arguments are not applied (the game's own duration holds).
+do
+  local P = "EntityPlayer"
+  local function effect(name, fname)
+    T.method(P, name, function(self, id, costume)
+      if math.type(id) ~= "integer" then error("bad argument #1 to '" .. name .. "' (integer expected, got " .. type(id) .. ")", 2) end
+      -- a mod's <null> that has no id in its items.xml has only a reserved blank id here (api_lua.lua): no effect
+      if fname == "AddNullEffect" and (id < 0 or T.reserved_null(id)) then return end
+      self:GetEffects()[fname](self:GetEffects(), id, costume and true or false)
+    end)
+  end
+  effect("AddNullItemEffect", "AddNullEffect")
+  effect("AddTrinketEffect", "AddTrinketEffect")
+  effect("AddCollectibleEffect", "AddCollectibleEffect")
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["EntityPlayer:Add*Effect cooldown"] = "the cooldown and additive arguments are not applied"
+end
