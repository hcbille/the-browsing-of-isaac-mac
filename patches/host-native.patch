@@ -0,0 +1,39 @@
+-- lab_scan.lua (development only; ISAAC_RGON_LAB=lab_scan.lua, round 123): the sprites (ANM2 objects: self pointers at +0x30 and +0x50)
+-- inside the menu manager and inside the game's manager, with the file each was loaded from.
+local T = ...
+local B = T.B
+local r32 = B.r32
+local mod = RegisterMod("rgon lab scan", 1)
+local function scan(label, from, to)
+  local n = 0
+  local a = from
+  while a < to do
+    local ok, p30 = pcall(r32, a + 0x30)
+    if ok and p30 == a then
+      local ok2, p50 = pcall(r32, a + 0x50)
+      if ok2 and p50 == a then
+        local ok3, s = pcall(function() return B.stdstr(a + 0x10) end)
+        local ok4, name = pcall(function() return T.wrap("Sprite", a):GetFilename() end)
+        B.log(string.format("lab_scan: %s +0x%x %s", label, a - from, ok4 and name or "?"))
+        n = n + 1
+        a = a + 0x100
+      end
+    end
+    a = a + 4
+  end
+  B.log("lab_scan: " .. label .. " " .. n .. " sprites")
+end
+local done_menu, done_game = false, false
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  if done_menu then return end
+  local mm = r32(0x00c72a20)
+  if mm == 0 then return end
+  done_menu = true
+  scan("menu manager", mm, mm + 0xf900)
+end)
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if done_game then return end
+  done_game = true
+  local g = r32(0x00c7169c)
+  scan("manager", g, g + 0x24000)
+end)
