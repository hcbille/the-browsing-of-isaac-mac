@@ -0,0 +1,329 @@
+-- api_eid.lua -- what External Item Descriptions needs of REPENTOGON (M8, 2026-11-19): the Bag of Crafting's contents and
+-- output, TM Trainer's procedural items (ProceduralItemManager, ProceduralItem, ProceduralEffect), the player's form
+-- counters, PersistentGameData:IsItemInCollection and RoomDescriptor:GetEntitiesSaveState with the saved-entity classes.
+-- REPENTOGON's behaviour is in its LuaInterfaces (LuaEntityPlayer, LuaPersistentGameData, ProcedualItems/, LuaEntitySaveState,
+-- LuaRoomDescriptor); each structure below was measured in this build, never taken from there (lab_eid_probe.lua is the
+-- development probe; lab_eid_test.lua checks every name).
+--
+-- Where things are in v1.9.7.17 (REPENTOGON's offsets are for .12 and several differ):
+--   EntityPlayer +0x17dc  the player form counters, 16 ints. The game's HasPlayerForm (0x007aa7c0) tests
+--                         `2 < counter[form]` at +0x17dc + 4*form (REPENTOGON has them at 0x17cc: moved by 16)
+--   EntityPlayer +0x1f44  the Bag of Crafting's content, 8 bytes (BagOfCraftingPickup, 0 = empty), +0x1f4c its output
+--                         (collectible id) and +0x1f50 the item pool: Entity_Player::TryAddToBagOfCrafting (0x007d5170)
+--                         writes the pickups at +0x1f44 + n and the output of CalculateBagOfCraftingOutput (0x007d9d00)
+--                         to +0x1f4c / +0x1f50 (REPENTOGON 0x1f20 / 0x1f28: moved by 0x24)
+--   PersistentGameData +0xae8  the collection, one byte per collectible (PersistentGameData::AddToCollection,
+--                         0x0092a2d0, sets `[this + id + 0xae8]` for id < 0x2dd), as REPENTOGON has it
+--   Game +0x67758         the procedural item manager: a vector of ProceduralItem pointers, a glitched item -1 - n is
+--                         entry n (the game's own lookups: `*(game + 0x67758) + ~id * 4`, 0x009e01b0, 0x005c88a0).
+--                         REPENTOGON has it at 0x669bc: moved by 0xd9c
+--   ProceduralItem        item +0x0, id +0x4, target item +0x10, six floats +0x14 .. +0x28, effects vector +0x2c (0x38 bytes)
+--   ProceduralEffect      condition type +0x0, action type +0x4, condition data +0x8, action data +0x10,
+--                         trigger chance scale +0x30, score +0x60 (0x68 bytes)
+--   RoomDescriptor +0x74  SavedEntities, a vector of EntitySaveState records of 0x78 bytes (type +0, variant +4, subtype +8,
+--                         ints +0xc .. +0x1c, position +0x28, seeds +0x34, +0x38); the same offset as REPENTOGON's
+
+local T = ...
+local B, R, method, static, this = T.B, T.R, T.method, T.static, T.this
+local r8, r16, r32, ri32, rf32 = B.r8, B.r16, B.r32, B.ri32, B.rf32
+local log = B.log
+local type, error, setmetatable, getmetatable, rawget, rawset, pairs, ipairs = type, error, setmetatable, getmetatable, rawget, rawset, pairs, ipairs
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local GAME_PTR = 0x00c71678
+local function game_base(what)
+  local g = r32(GAME_PTR)
+  if g == 0 then error("rgon: " .. what .. " used with no game", 3) end
+  return g
+end
+
+------------------------------------------------------------------------------
+-- EntityPlayer: form counters and the Bag of Crafting
+------------------------------------------------------------------------------
+local FORMS, BOC_CONTENT, BOC_OUTPUT, BOC_POOL = 0x17dc, 0x1f44, 0x1f4c, 0x1f50
+
+method("EntityPlayer", "GetPlayerFormCounter", function(self, form)
+  local p = this(self, "GetPlayerFormCounter")
+  form = int_arg(form, 1, "GetPlayerFormCounter")
+  if form < 0 or form > 14 then error("Invalid PlayerForm " .. form, 2) end
+  return ri32(p + FORMS + 4 * form)
+end)
+
+-- a table of the eight slots, 1-based, each a BagOfCraftingPickup (0 where empty)
+method("EntityPlayer", "GetBagOfCraftingContent", function(self)
+  local p = this(self, "GetBagOfCraftingContent")
+  local t = {}
+  for i = 0, 7 do t[i + 1] = r8(p + BOC_CONTENT + i) end
+  return t
+end)
+method("EntityPlayer", "GetBagOfCraftingSlot", function(self, slot)
+  local p = this(self, "GetBagOfCraftingSlot")
+  slot = int_arg(slot, 1, "GetBagOfCraftingSlot")
+  if slot < 0 or slot > 7 then error("EntityPlayer:GetBagOfCraftingSlot: invalid slot id " .. slot, 2) end
+  return r8(p + BOC_CONTENT + slot)
+end)
+method("EntityPlayer", "GetBagOfCraftingOutput", function(self)
+  return ri32(this(self, "GetBagOfCraftingOutput") + BOC_OUTPUT)
+end)
+method("EntityPlayer", "GetBagOfCraftingOutputItemPool", function(self)
+  return ri32(this(self, "GetBagOfCraftingOutputItemPool") + BOC_POOL)
+end)
+
+------------------------------------------------------------------------------
+-- PersistentGameData:IsItemInCollection(collectible)
+------------------------------------------------------------------------------
+do
+  local COLLECTION, COUNT = 0xae8, 0x2dd
+  local P = getmetatable(Isaac.GetPersistentGameData())
+  if type(P) == "table" and type(rawget(P, "__index")) == "table" and rawget(P, "IsItemInCollection") == nil then
+    rawset(P, "IsItemInCollection", function(self, id)
+      id = int_arg(id, 2, "IsItemInCollection")
+      if id >= COUNT then error("bad argument #2 to 'IsItemInCollection' (CollectibleType cannot be higher than " .. (COUNT - 1) .. ")", 2) end
+      if id < 0 then return false end
+      return r8(r32(0x00c7169c) + 0x14 + COLLECTION + id) ~= 0
+    end)
+    R.Implemented["PersistentGameData.IsItemInCollection"] = true
+  else
+    log("api_eid: no PersistentGameData class from api_data.lua; IsItemInCollection is not provided")
+  end
+end
+
+------------------------------------------------------------------------------
+-- saved entities: RoomDescriptor:GetEntitiesSaveState(), the vector and its records
+------------------------------------------------------------------------------
+-- The vector object keeps the address of the std::vector header inside the descriptor, and a record the header and its
+-- index, so both read the game's memory each time (as REPENTOGON's pointers do) and a changed room shows.
+local ESS = 0x78
+local function vec_bounds(h)
+  local b, e = r32(h), r32(h + 4)
+  if e < b or (e - b) % ESS ~= 0 or e - b > 0x400000 then error("rgon: a saved-entity list is not laid out as expected", 3) end
+  return b, (e - b) // ESS
+end
+local State = {}
+State.__index = State
+State.__type = "EntitySaveState"
+State.__name = "EntitySaveState"
+State.__metatable = nil
+local Vec = {}
+Vec.__index = Vec
+Vec.__type = "EntitiesSaveStateVector"
+Vec.__name = "EntitiesSaveStateVector"
+local function rec(self, what)
+  if getmetatable(self) ~= State then error("bad argument #1 to '" .. what .. "' (EntitySaveState expected, got " .. type(self) .. ")", 3) end
+  local b, n = vec_bounds(self[1])
+  if self[2] >= n then error("rgon: the saved entity is no longer in its list", 3) end
+  return b + self[2] * ESS
+end
+local function reader(name, f) State[name] = function(self) return f(rec(self, name)) end end
+reader("GetType", ri32)
+reader("GetVariant", function(a) return ri32(a + 4) end)
+reader("GetSubType", function(a) return ri32(a + 8) end)
+-- REPENTOGON hands the first int out as a float for a few types (4 bomb, 33 fireplace, 292 ?), the rest as integers
+reader("GetI1", function(a)
+  local t = ri32(a)
+  if t == 4 or t == 33 or t == 292 then return rf32(a + 0xc) end
+  return r32(a + 0xc)
+end)
+reader("GetI2", function(a) return r32(a + 0x10) end)
+reader("GetI3", function(a) return r32(a + 0x14) end)
+reader("GetI4", function(a) return ri32(a + 0x18) end)
+reader("GetI5", function(a) return ri32(a + 0x1c) end)
+reader("GetGridSpawnIdx", function(a) local v = r16(a + 0x20) return v >= 0x8000 and v - 0x10000 or v end)
+reader("GetB1", function(a) return r8(a + 0x22) ~= 0 end)
+reader("GetB2", function(a) return r8(a + 0x23) ~= 0 end)
+reader("GetI6", function(a) return r32(a + 0x24) end)
+reader("GetPos", function(a) return Vector(rf32(a + 0x28), rf32(a + 0x2c)) end)
+reader("GetInitSeed", function(a) return r32(a + 0x34) end)
+reader("GetDropSeed", function(a) return r32(a + 0x38) end)
+reader("GetSpawnerType", function(a) return ri32(a + 0x3c) end)
+reader("GetSpawnerVariant", function(a) return ri32(a + 0x40) end)
+reader("GetF1", function(a) return rf32(a + 0x50) end)
+reader("GetF2", function(a) return rf32(a + 0x54) end)
+reader("GetI8", function(a) return r32(a + 0x5c) end)
+reader("GetU1", function(a)
+  local v = r8(a + 0x60)
+  if ri32(a) == 5 then return v ~= 0 end
+  return v >= 0x80 and v - 0x100 or v
+end)
+State.__eq = function(a, b) return getmetatable(b) == State and a[1] == b[1] and a[2] == b[2] end
+State.__tostring = function(self) return string.format("EntitySaveState(%d)", self[2]) end
+
+local function vec_of(self, what)
+  if getmetatable(self) ~= Vec then error("bad argument #1 to '" .. what .. "' (EntitiesSaveStateVector expected, got " .. type(self) .. ")", 3) end
+  return self[1]
+end
+function Vec:Get(index)
+  local h = vec_of(self, "Get")
+  index = int_arg(index, 2, "Get")
+  local _, n = vec_bounds(h)
+  if index < 0 or index >= n then error("Invalid index for Get(): " .. index, 2) end
+  return setmetatable({ h, index }, State)
+end
+function Vec:GetByType(type_, variant, subtype)
+  local h = vec_of(self, "GetByType")
+  type_ = int_arg(type_, 2, "GetByType")
+  variant = variant == nil and 0 or int_arg(variant, 3, "GetByType")
+  subtype = subtype == nil and 0 or int_arg(subtype, 4, "GetByType")
+  local b, n = vec_bounds(h)
+  local out, j = {}, 0
+  for i = 0, n - 1 do
+    local a = b + i * ESS
+    if ri32(a) == type_ and (variant == -1 or ri32(a + 4) == variant) and (subtype == -1 or ri32(a + 8) == subtype) then
+      j = j + 1
+      out[j] = setmetatable({ h, i }, State)
+    end
+  end
+  return out
+end
+Vec.__len = function(self) local _, n = vec_bounds(vec_of(self, "__len")) return n end
+Vec.__tostring = function(self) return "EntitiesSaveStateVector" end
+
+if T.descriptor_methods then
+  T.descriptor_methods.GetEntitiesSaveState = B.cfn(function(self)
+    local a = this(self, "GetEntitiesSaveState")
+    return setmetatable({ a + 0x74 }, Vec)
+  end)
+  -- the method is put on the descriptor's class when the first player exists (api_batch_three.lua); the gate reads
+  -- the names while the layer loads, and this one is certain to arrive there
+  R.Implemented["RoomDescriptor.GetEntitiesSaveState"] = true
+else
+  log("api_eid: api_batch_three.lua did not load; RoomDescriptor:GetEntitiesSaveState is not provided")
+end
+for _, n in ipairs({ "GetType", "GetVariant", "GetSubType", "GetI1", "GetI2", "GetI3", "GetI4", "GetI5", "GetPos", "GetInitSeed", "GetDropSeed" }) do
+  R.Implemented["EntitySaveState." .. n] = true
+end
+R.Implemented["EntitiesSaveStateVector.Get"] = true
+R.Implemented["EntitiesSaveStateVector.GetByType"] = true
+
+------------------------------------------------------------------------------
+-- TM Trainer's procedural items
+------------------------------------------------------------------------------
+local PROC = 0x67758
+local function proc_list()
+  local g = game_base("ProceduralItemManager")
+  local b, e = r32(g + PROC), r32(g + PROC + 4)
+  if e < b or (e - b) % 4 ~= 0 or e - b > 0x400000 then error("rgon: the procedural item list is not laid out as expected", 3) end
+  return b, (e - b) // 4
+end
+local function item_object(p)
+  if p == 0 then return nil end
+  local config = Isaac.GetItemConfig()
+  local sample = config and config:GetCollectible(1)
+  local mt = sample and getmetatable(sample)
+  if type(mt) ~= "table" then error("rgon: no item class to hand a procedural item's config with", 3) end
+  return B.obj(mt, p, T.vt_ptr())
+end
+
+local PE = {}
+PE.__index = PE
+PE.__type = "ProceduralEffect"
+PE.__name = "ProceduralEffect"
+PE.__metatable = nil
+local function eff(self, what)
+  if getmetatable(self) ~= PE then error("bad argument #1 to '" .. what .. "' (ProceduralEffect expected, got " .. type(self) .. ")", 3) end
+  return self[1]
+end
+function PE:GetConditionType() return ri32(eff(self, "GetConditionType")) end
+function PE:GetActionType() return ri32(eff(self, "GetActionType") + 4) end
+function PE:GetConditionProperty()
+  local a = eff(self, "GetConditionProperty")
+  local t = {}
+  if ri32(a) == 6 then   -- ENTITY_SPAWN: the condition data at +0x8 holds variant at +4 and type at +6
+    local v, ty = r16(a + 0xc), r16(a + 0xe)
+    t.type = ty >= 0x8000 and ty - 0x10000 or ty
+    t.variant = v >= 0x8000 and v - 0x10000 or v
+  end
+  return t
+end
+function PE:GetActionProperty()
+  local a = eff(self, "GetActionProperty")
+  local d = a + 0x10
+  local kind, t = ri32(a + 4), {}
+  local function s16(x) return x >= 0x8000 and x - 0x10000 or x end
+  if kind == 0 or kind == 1 then          -- USE_ACTIVE_ITEM, ADD_TEMPORARY_EFFECT
+    t.id = ri32(d)
+  elseif kind == 2 then                   -- CONVERT_ENTITIES
+    t.fromVariant, t.fromType, t.toVariant, t.toType = s16(r16(d)), s16(r16(d + 2)), s16(r16(d + 4)), s16(r16(d + 6))
+  elseif kind == 3 then                   -- AREA_DAMAGE
+    t.radius, t.damage = rf32(d + 8), rf32(d + 0xc)
+    t.flags1 = r32(d + 0x10) | (r32(d + 0x14) << 32)
+    t.flags2 = r32(d + 0x18) | (r32(d + 0x1c) << 32)
+  elseif kind == 4 then                   -- SPAWN_ENTITY
+    t.variant, t.type = s16(r16(d)), s16(r16(d + 2))
+  elseif kind == 5 then                   -- FART
+    t.scale, t.radius = rf32(d) * 6, rf32(d + 0xc) * 6 / 85
+  end
+  return t
+end
+function PE:GetTriggerChanceScale() return rf32(eff(self, "GetTriggerChanceScale") + 0x30) end
+function PE:GetTriggerChance()
+  local a = eff(self, "GetTriggerChance")
+  local chance, c = rf32(a + 0x30), ri32(a)
+  -- the game hard-codes the chance of these triggers (REPENTOGON's note); tear fire, enemy hit, entity spawn / enemy kill
+  if c == 1 or c == 2 or c == 6 then chance = chance * 0.05 elseif c == 3 then chance = chance * 0.2 end
+  return chance
+end
+function PE:GetScore() return rf32(eff(self, "GetScore") + 0x60) end
+for k in pairs(PE) do if k:sub(1, 2) ~= "__" then R.Implemented["ProceduralEffect." .. k] = true end end
+
+local PI = {}
+PI.__index = PI
+PI.__type = "ProceduralItem"
+PI.__name = "ProceduralItem"
+PI.__metatable = nil
+PI.__eq = function(a, b) return getmetatable(b) == PI and a[1] == b[1] end
+local function itm(self, what)
+  if getmetatable(self) ~= PI then error("bad argument #1 to '" .. what .. "' (ProceduralItem expected, got " .. type(self) .. ")", 3) end
+  return self[1]
+end
+function PI:GetItem() return item_object(r32(itm(self, "GetItem"))) end
+function PI:GetTargetItem() return item_object(r32(itm(self, "GetTargetItem") + 0x10)) end
+function PI:GetID() return ri32(itm(self, "GetID") + 4) end
+function PI:GetDamage() return rf32(itm(self, "GetDamage") + 0x14) end
+function PI:GetFireDelay() return rf32(itm(self, "GetFireDelay") + 0x18) end
+function PI:GetSpeed() return rf32(itm(self, "GetSpeed") + 0x1c) end
+function PI:GetRange() return rf32(itm(self, "GetRange") + 0x20) end
+function PI:GetShotSpeed() return rf32(itm(self, "GetShotSpeed") + 0x24) end
+function PI:GetLuck() return rf32(itm(self, "GetLuck") + 0x28) end
+local function effects(a)
+  local b, e = r32(a + 0x2c), r32(a + 0x30)
+  if e < b or (e - b) % 4 ~= 0 or e - b > 0x10000 then error("rgon: a procedural item's effect list is not laid out as expected", 3) end
+  return b, (e - b) // 4
+end
+function PI:GetEffectCount()
+  local _, n = effects(itm(self, "GetEffectCount"))
+  return n
+end
+function PI:GetEffect(index)
+  local a = itm(self, "GetEffect")
+  index = int_arg(index, 2, "GetEffect")
+  local b, n = effects(a)
+  if index < 0 or index >= n then return nil end
+  return setmetatable({ r32(b + 4 * index) }, PE)
+end
+for k in pairs(PI) do if k:sub(1, 2) ~= "__" then R.Implemented["ProceduralItem." .. k] = true end end
+
+if rawget(_G, "ProceduralItemManager") == nil then
+  local M = {}
+  -- GetProceduralItem(index): index 0 is the glitched item -1 (the game's id is ~index)
+  function M.GetProceduralItem(index)
+    index = int_arg(index, 1, "GetProceduralItem")
+    local b, n = proc_list()
+    if index < 0 or index >= n then return nil end
+    return setmetatable({ r32(b + 4 * index) }, PI)
+  end
+  function M.GetProceduralItemCount()
+    local _, n = proc_list()
+    return n
+  end
+  rawset(_G, "ProceduralItemManager", M)
+  R.Implemented["ProceduralItemManager.GetProceduralItem"] = true
+  R.Implemented["ProceduralItemManager.GetProceduralItemCount"] = true
+end
+-- not here: ProceduralItemManager.CreateProceduralItem (the game's function has no match in this exe yet), the Set*
+-- functions of the saved-entity records, the Bag of Crafting setters and CalculateBagOfCraftingOutput
