+-- lab_eid_shot.lua (development only; ISAAC_RGON_LAB=lab_eid_shot.lua): for a screenshot of External Item Descriptions with
+-- REPENTOGON: in the first room the player gets the Bag of Crafting, the game's own TryAddToBagOfCrafting fills it with
+-- eight pickups, and an item pedestal is put a few tiles away. Logs "lab_eid_shot: ..." lines with the frames to shoot at.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab eid shot", 1)
+local function say(s) B.log("lab_eid_shot: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local frame = 0
+local boc = { { 10, 1 }, { 20, 1 }, { 30, 1 }, { 40, 1 }, { 20, 2 }, { 10, 3 }, { 20, 3 }, { 30, 2 } }
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 10 then
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+    local item = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, p.Position + Vector(-90, 0), Vector(0, 0), nil)
+    local item2 = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, p.Position + Vector(90, 0), Vector(0, 0), nil)
+    say("gave the Bag of Crafting, spawned pedestals")
+  elseif frame >= 20 and frame < 20 + 6 * #boc and (frame - 20) % 6 == 0 then
+    local e = boc[(frame - 20) // 6 + 1]
+    local pk = Isaac.Spawn(5, e[1], e[2], p.Position + Vector(300, 0), Vector(0, 0), nil)
+    B.call(0x007d5170, B.ptr(p), B.ptr(pk))
+  elseif frame == 100 then
+    say("bag content " .. table.concat(p:GetBagOfCraftingContent(), ",") .. " output " .. p:GetBagOfCraftingOutput())
+  elseif frame == 130 then
+    say("shoot now")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_eid_test.lua b/scripts/recomp/rgon/lab_eid_test.lua
