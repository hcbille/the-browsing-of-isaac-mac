+at(90, function(p)
+  check(B.r32(B.ptr(p) + 0x1e54 + 0x10) == ctx.size0, "the game consumes the afterimage after its duration")
+end)
+
+-- poop spells: the six-slot queue
+at(94, function(p)
+  local q = B.ptr(p) + 0x1f58
+  for i = 0, 5 do B.w8(q + i, i + 1) end
+  local before = {}
+  for i = 0, 5 do before[i] = p:GetPoopSpell(i) end
+  p:RemovePoopSpell(1)
+  local ok = p:GetPoopSpell(0) == before[0] and p:GetPoopSpell(1) == before[2] and p:GetPoopSpell(2) == before[3] and p:GetPoopSpell(3) == before[4] and p:GetPoopSpell(4) == before[5]
+  say(string.format("poop queue before %d,%d,%d,%d,%d,%d after %d,%d,%d,%d,%d,%d", before[0], before[1], before[2], before[3], before[4], before[5],
+    p:GetPoopSpell(0), p:GetPoopSpell(1), p:GetPoopSpell(2), p:GetPoopSpell(3), p:GetPoopSpell(4), p:GetPoopSpell(5)))
+  check(ok, "RemovePoopSpell(1) moves the later spells forward")
+  check(fails(p.RemovePoopSpell, p, 6), "position 6 is an error")
+  for i = 0, 5 do B.w8(q + i, 0) end
+end)
+
+-- InitPostLevelInitStats: the game sets its finished flag when it ends
+at(98, function(p)
+  B.w8(B.ptr(p) + 0x1824, 0)
+  check(p:IsPostLevelInitFinished() == false, "the finished flag cleared")
+  p:InitPostLevelInitStats()
+  check(p:IsPostLevelInitFinished() == true, "InitPostLevelInitStats ends with the game setting the finished flag")
+end)
+
+-- Bag of Crafting
+at(100, function(p)
+  p:AddCollectible(C.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+  ctx.pickup = Isaac.Spawn(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_COIN, CoinSubType.COIN_PENNY, p.Position + Vector(40, 0), Vector(0, 0), nil):ToPickup()
+  local before = 0
+  for _, v in ipairs(p:GetBagOfCraftingContent()) do if v ~= 0 then before = before + 1 end end
+  ctx.bag0 = before
+  ctx.bagret = p:TryAddToBagOfCrafting(ctx.pickup)
+end)
+at(103, function(p)
+  local after = 0
+  for _, v in ipairs(p:GetBagOfCraftingContent()) do if v ~= 0 then after = after + 1 end end
+  check(ctx.bagret == true and after == ctx.bag0 + 1, "TryAddToBagOfCrafting takes the penny into the bag (" .. ctx.bag0 .. " -> " .. after .. ")")
+  check(ctx.pickup:IsDead() or not ctx.pickup:Exists() or ctx.pickup:GetSprite():IsPlaying("Collect"), "and the pickup is taken (collect animation or gone)")
+end)
+
+-- AddLocust
+at(106, function(p)
+  ctx.n0 = #Isaac.GetRoomEntities()
+  p:AddLocust(C.COLLECTIBLE_SAD_ONION, p.Position + Vector(30, 0))
+  ctx.n1 = #Isaac.GetRoomEntities()
+end)
+at(108, function(p)
+  local n = #Isaac.GetRoomEntities()
+  check(ctx.n1 > ctx.n0 or n > ctx.n0, "AddLocust makes the game spawn a locust (" .. ctx.n0 .. " -> " .. ctx.n1 .. " -> " .. n .. " entities)")
+end)
+
+-- Error trinket
+at(110, function(p)
+  local e = p:GetErrorTrinketEffect()
+  check(e >= 1 and e <= TrinketType.NUM_TRINKETS - 1, "GetErrorTrinketEffect is a trinket (" .. e .. ")")
+  p:AddTrinket(TrinketType.TRINKET_ERROR)
+  check(p:HasTrinket(e) == true, "the game's HasTrinket answers for the trinket Error mimics in this room (" .. e .. ")")
+  local other = e % (TrinketType.NUM_TRINKETS - 1) + 1
+  check(p:HasTrinket(other) == false, "and not for another one (" .. other .. ")")
+  p:TryRemoveTrinket(TrinketType.TRINKET_ERROR)
+end)
+
+-- PlayerManager
+at(114, function(p)
+  local t = p:GetPlayerType()
+  check(PlayerManager.AnyPlayerTypeHasCollectible(t, C.COLLECTIBLE_SAD_ONION) == true, "AnyPlayerTypeHasCollectible: this type holds the Sad Onion")
+  check(PlayerManager.AnyPlayerTypeHasCollectible(t + 1, C.COLLECTIBLE_SAD_ONION) == false, "AnyPlayerTypeHasCollectible: another type does not")
+  check(PlayerManager.AnyPlayerTypeHasTrinket(t, TrinketType.TRINKET_SWALLOWED_PENNY) == false, "AnyPlayerTypeHasTrinket: no penny")
+  p:AddTrinket(TrinketType.TRINKET_SWALLOWED_PENNY)
+  check(PlayerManager.AnyPlayerTypeHasTrinket(t, TrinketType.TRINKET_SWALLOWED_PENNY) == true, "AnyPlayerTypeHasTrinket: the penny")
+  check(PlayerManager.FirstBirthrightOwner(t) == nil, "FirstBirthrightOwner: nobody")
+  p:AddCollectible(C.COLLECTIBLE_BIRTHRIGHT, 0, false)
+  local o = PlayerManager.FirstBirthrightOwner(t)
+  check(o ~= nil and GetPtrHash(o) == GetPtrHash(p), "FirstBirthrightOwner: this player after Birthright")
+  local who, rng = PlayerManager.GetRandomCollectibleOwner(C.COLLECTIBLE_SAD_ONION, 12345)
+  check(who ~= nil and GetPtrHash(who) == GetPtrHash(p) and rng ~= nil, "GetRandomCollectibleOwner: the player and the collectible's RNG")
+  local none = PlayerManager.GetRandomCollectibleOwner(C.COLLECTIBLE_DEAD_CAT, 12345)
+  check(none == nil, "GetRandomCollectibleOwner: nil when nobody holds it")
+  local who2, rng2 = PlayerManager.GetRandomTrinketOwner(TrinketType.TRINKET_SWALLOWED_PENNY, 7)
+  check(who2 ~= nil and rng2 ~= nil, "GetRandomTrinketOwner: the player and the trinket's RNG")
+  check(PlayerManager.GetRandomTrinketOwner(TrinketType.TRINKET_PINKY_EYE, 7) == nil, "GetRandomTrinketOwner: nil when nobody holds it")
