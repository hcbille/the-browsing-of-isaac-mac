+-- lab_batch2_test.lua (development only; ISAAC_RGON_LAB=lab_batch2_test.lua, census batch 2): runs the names of
+-- api_batch_two.lua in the first room, a step per frame, and logs "lab_batch2_test: PASS/FAIL ..". Readers are
+-- checked against values the game itself holds; writers by reading back (and by the game's own reaction where
+-- there is one: a stat that moves, a head that turns).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab batch2 test", 1)
+local function check(name, ok, detail)
+  B.log("lab_batch2_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+local function near(a, b) return math.abs(a - b) < 0.01 end
+local held = {}
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+
+local frame, knife, dummies = 0, nil, {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 5 then
+    try("exists", function()
+      for _, n in ipairs({ "EntityPlayer.GetSpeedModifier", "EntityPlayer.SetLuckModifier", "EntityPlayer.GetWeapon", "EntityPlayer.SetLaserColor",
+        "EntityPlayer.GetMarkedTarget", "EntityPlayer.SetHeadDirection", "EntityPlayer.GetUrnSouls", "Weapon.GetWeaponType", "EntityKnife.AddToHitList" }) do
+        check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+      end
+    end)
+    try("stat modifiers", function()
+      local fields = { "Speed", "FireDelay", "Damage", "TearRange", "ShotSpeed", "Luck" }
+      local stat = { Speed = "MoveSpeed", FireDelay = "MaxFireDelay", Damage = "Damage", TearRange = "TearRange", ShotSpeed = "ShotSpeed", Luck = "Luck" }
+      local base = {}
+      for _, f in ipairs(fields) do base[f] = p[stat[f]] check("Get" .. f .. "Modifier starts 0", p["Get" .. f .. "Modifier"](p) == 0) end
+      for _, f in ipairs(fields) do
+        p["Set" .. f .. "Modifier"](p, 5)
+        check("Get" .. f .. "Modifier reads back", p["Get" .. f .. "Modifier"](p) == 5)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+        local v = p[stat[f]]
+        check("Set" .. f .. "Modifier moves " .. stat[f], v ~= base[f], base[f] .. " -> " .. v)
+        p["Set" .. f .. "Modifier"](p, 0)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+        check("Set" .. f .. "Modifier 0 restores " .. stat[f], near(p[stat[f]], base[f]), p[stat[f]])
+      end
+    end)
+    try("head and bomb delay", function()
+      p:SetBombPlaceDelay(7)
+      check("SetBombPlaceDelay", p:GetBombPlaceDelay() == 7, p:GetBombPlaceDelay())
+      p:SetBombPlaceDelay(0)
+      p:SetHeadDirectionLockTime(33)
+      check("SetHeadDirectionLockTime", p:GetHeadDirectionLockTime() == 33, p:GetHeadDirectionLockTime())
+      p:SetHeadDirection(1, 40, true)
+      check("SetHeadDirection(1) -> GetHeadDirection", p:GetHeadDirection() == 1, p:GetHeadDirection())
+      check("SetHeadDirection time", p:GetHeadDirectionLockTime() == 40, p:GetHeadDirectionLockTime())
+      local ok = pcall(p.SetHeadDirection, p, 9, 1)
+      check("SetHeadDirection(9) errors", not ok)
+    end)
+    try("tear displacement", function()
+      p:SetTearDisplacement(-1)
+      check("SetTearDisplacement(-1)", p:GetTearDisplacement() == -1, p:GetTearDisplacement())
+      p:SetTearDisplacement(1)
+      check("SetTearDisplacement(1)", p:GetTearDisplacement() == 1, p:GetTearDisplacement())
+      check("SetTearDisplacement(2) errors", not pcall(p.SetTearDisplacement, p, 2))
+    end)
+    try("urn", function()
+      local before = p:GetUrnSouls()
+      p:AddUrnSouls(3)
+      check("AddUrnSouls(3) -> GetUrnSouls", p:GetUrnSouls() == before + 3, before .. " -> " .. p:GetUrnSouls())
+    end)
+    try("laser colour", function()
+      p:SetLaserColor(Color(1, 0.25, 0.5, 1, 0, 0, 0))
+      local c = p.LaserColor
+      check("SetLaserColor reads back through LaserColor", near(c.R, 1) and near(c.G, 0.25) and near(c.B, 0.5), string.format("%g %g %g", c.R, c.G, c.B))
+    end)
+    try("weapon", function()
+      local w = p:GetWeapon(1)
+      check("GetWeapon(1) is a weapon", w ~= nil, tostring(w))
+      check("Weapon:GetOwner is the player", GetPtrHash(w:GetOwner()) == GetPtrHash(p))
+      check("Weapon:GetWeaponType == tears (1)", w:GetWeaponType() == WeaponType.WEAPON_TEARS, w:GetWeaponType())
+      check("Weapon:GetMaxFireDelay == player's", near(w:GetMaxFireDelay(), p.MaxFireDelay), w:GetMaxFireDelay() .. " vs " .. p.MaxFireDelay)
+      w:SetCharge(1.5)
+      check("Weapon:SetCharge reads back", near(w:GetCharge(), 1.5), w:GetCharge())
+      w:SetCharge(0)
+      w:SetFireDelay(3)
+      check("Weapon:SetFireDelay reads back", near(w:GetFireDelay(), 3), w:GetFireDelay())
+      local m0 = w:GetModifiers()
+      w:SetModifiers(0x4)
+      check("Weapon:SetModifiers ORs", w:GetModifiers() == (m0 | 0x4), w:GetModifiers())
+      w:SetModifiers(0)
+      check("Weapon:IsAxisAligned is a boolean", type(w:IsAxisAligned()) == "boolean", tostring(w:IsAxisAligned()))
+      check("GetWeapon(3) is nil", p:GetWeapon(3) == nil, tostring(p:GetWeapon(3)))
+      check("GetWeapon(5) errors", not pcall(p.GetWeapon, p, 5))
+    end)
+    try("costume visibility", function()
+      local cfg = Isaac.GetItemConfig()
+      local item = cfg:GetCollectible(CollectibleType.COLLECTIBLE_SAD_ONION)
+      p:AddCollectible(CollectibleType.COLLECTIBLE_SAD_ONION, 0, false)
+      local mine = p:IsItemCostumeVisible(item, 0)
+      check("IsItemCostumeVisible == IsCollectibleCostumeVisible", mine == p:IsCollectibleCostumeVisible(CollectibleType.COLLECTIBLE_SAD_ONION, 0), tostring(mine))
+      check("IsNullItemCostumeVisible is a boolean", type(p:IsNullItemCostumeVisible(NullItemID.ID_LOST_CURSE, 0)) == "boolean")
+    end)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_MARKED, 0, false)
+    check("GetMarkedTarget is nil before Marked fires", p:GetMarkedTarget() == nil, tostring(p:GetMarkedTarget()))
+  elseif frame == 12 then
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  elseif frame == 45 then
+    try("marked target", function()
+      local t = p:GetMarkedTarget()
+      check("GetMarkedTarget is the TARGET effect", t ~= nil and t.Type == 1000 and t.Variant == 30, t and (t.Type .. "." .. t.Variant) or "nil")
+    end)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+  elseif frame == 60 then
+    try("knife setup", function()
+      knife = p:FireKnife(p, 0, false, 0, 1)
+      check("FireKnife gave a knife", knife ~= nil, tostring(knife))
+      for i = 1, 12 do dummies[i] = Isaac.Spawn(10, 0, 0, p.Position + Vector(60 + 20 * i, 0), Vector(0, 0), nil) end
+    end)
+  elseif frame == 62 and knife then
+    try("knife", function()
+      local k = knife
+      k:SetIsSwinging(false) check("SetIsSwinging(false)", k:GetIsSwinging() == false)
+      k:SetIsSwinging(true) check("SetIsSwinging(true)", k:GetIsSwinging() == true)
+      k:SetIsSpinAttack(true) check("SetIsSpinAttack(true)", k:GetIsSpinAttack() == true)
+      k:SetIsSpinAttack(false) check("SetIsSpinAttack(false)", k:GetIsSpinAttack() == false)
+      k:SetPrismTouched(true) check("SetPrismTouched(true)", k:IsPrismTouched() == true)
+      k:SetPrismTouched(false) check("SetPrismTouched(false)", k:IsPrismTouched() == false)
+      k:SetMultidimensionalTouched(true) check("SetMultidimensionalTouched(true)", k:IsMultidimensionalTouched() == true)
+      k:SetMultidimensionalTouched(false) check("SetMultidimensionalTouched(false)", k:IsMultidimensionalTouched() == false)
+      k:SetKnifeDistance(77.5) check("SetKnifeDistance reads back through GetKnifeDistance", near(k:GetKnifeDistance(), 77.5), k:GetKnifeDistance())
+      k:SetKnifeVelocity(3.25) check("SetKnifeVelocity reads back through GetKnifeVelocity", near(k:GetKnifeVelocity(), 3.25), k:GetKnifeVelocity())
+      local n0 = #k:GetHitList()
+      check("GetHitList is a table", type(k:GetHitList()) == "table", n0)
+      k:AddToHitList(dummies[1])
+      check("AddToHitList -> InHitList", k:InHitList(dummies[1]) == true)
+      check("AddToHitList grows the list", #k:GetHitList() == n0 + 1, #k:GetHitList())
+      k:AddToHitList(dummies[1])
+      check("AddToHitList twice adds once", #k:GetHitList() == n0 + 1, #k:GetHitList())
+      for i = 2, 12 do k:AddToHitList(dummies[i]) end
+      local all = true
+      for i = 1, 12 do if not k:InHitList(dummies[i]) then all = false end end
+      check("12 entities in the hit list (past its first capacity)", all and #k:GetHitList() == n0 + 12, #k:GetHitList())
+      k:RemoveFromHitList(dummies[5])
+      check("RemoveFromHitList", not k:InHitList(dummies[5]) and k:InHitList(dummies[12]) and #k:GetHitList() == n0 + 11, #k:GetHitList())
+      check("GetHitList holds GetHitListIndex values", (function() for _, v in ipairs(k:GetHitList()) do if v == dummies[2]:GetHitListIndex() then return true end end end)() == true)
+      -- the block that was committed unrun: the hitbox parent knife is only what a mod set (not in Implemented)
+      check("GetHitboxParentKnife starts nil", k:GetHitboxParentKnife() == nil)
+      -- the first knife of this lab is already gone by now, and a gone parent answers nil: use a fresh one
+      local parent = p:FireKnife(p, 0, false, 0, 1)
+      k:SetHitboxParentKnife(parent)
+      check("SetHitboxParentKnife -> GetHitboxParentKnife", parent ~= nil and parent:Exists() and k:GetHitboxParentKnife() ~= nil
+        and GetPtrHash(k:GetHitboxParentKnife()) == GetPtrHash(parent), tostring(k:GetHitboxParentKnife()) .. " exists=" .. tostring(parent and parent:Exists()))
