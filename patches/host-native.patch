+    -- MC_PRE_GRID_ENTITY_<X>_UPDATE (1402 door, 1410 pit, 1412 poop, 1416 rock, 1426 trapdoor): (grid), param = the grid type ->
+    -- any boolean skips the game's update. MC_POST_GRID_ENTITY_<X>_UPDATE (+1): (grid), after it.
+    local function grid_update(fname, pre, post, to)
+      if not pre then return end
+      on(fname, { pre, post }, function(self)
+        local t = r32(self + 4)
+        if wants(pre, t) then
+          local res = run(pre, t, grid_obj(self, to))
+          if type(res) == "boolean" then return true, 0 end
+        end
+      end, function(self)
+        local t = r32(self + 4)
+        if wants(post, t) then run(post, t, grid_obj(self, to)) end
+      end)
+    end
+    grid_update("GridEntity_Door::Update", M.MC_PRE_GRID_ENTITY_DOOR_UPDATE, M.MC_POST_GRID_ENTITY_DOOR_UPDATE, "ToDoor")
+    grid_update("GridEntity_Pit::Update", M.MC_PRE_GRID_ENTITY_PIT_UPDATE, M.MC_POST_GRID_ENTITY_PIT_UPDATE, "ToPit")
+    grid_update("GridEntity_Poop::Update", M.MC_PRE_GRID_ENTITY_POOP_UPDATE, M.MC_POST_GRID_ENTITY_POOP_UPDATE, "ToPoop")
+    grid_update("GridEntity_Rock::Update", M.MC_PRE_GRID_ENTITY_ROCK_UPDATE, M.MC_POST_GRID_ENTITY_ROCK_UPDATE, "ToRock")
+    grid_update("GridEntity_TrapDoor::Update", M.MC_PRE_GRID_ENTITY_TRAPDOOR_UPDATE, M.MC_POST_GRID_ENTITY_TRAPDOOR_UPDATE, nil)
+
+    -- MC_PRE_GRID_ENTITY_<X>_RENDER (1446 door, 1438 trapdoor, 1462 wall): (grid, offset), param = the grid type -> any boolean: not
+    -- drawn; a Vector: drawn at that offset. MC_POST_GRID_ENTITY_<X>_RENDER (+1): (grid, offset).
+    local function grid_render(fname, pre, post, to, only_type)
+      if not pre then return end
+      on(fname, { pre, post }, function(self, esp)
+        local t = r32(self + 4)
+        if only_type and t ~= only_type then return end
+        if not (wants(pre, t) or wants(post, t)) then return end
+        local at = r32(esp + 4)
+        local offset = vec_at(at)
+        local g = grid_obj(self, to)
+        local keep
+        if wants(pre, t) then
+          local res = run(pre, t, g, offset)
+          if type(res) == "boolean" then return true, 0 end
+          if type(res) == "userdata" then
