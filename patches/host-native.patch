new file mode 100644
index 0000000..ad8570a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_census.lua
@@ -0,0 +1,100 @@
+-- lab_census.lua (development only; ISAAC_RGON_LAB=lab_census.lua)
+-- What the running Layer can reach, name by name: one log line "lab_census: E <Class>.<name>" for every
+-- function and property found on a class or namespace table, plus the same "lab_names: I/C" lines
+-- lab_names.lua writes (so one run feeds scripts/mac/rgon_census.py). "E" is "exists": a name can exist
+-- and still not be in REPENTOGON.Implemented (a stand-in that holds the call and does nothing, or a
+-- name the game had before REPENTOGON). The census script tells them apart.
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local type, pairs, rawget, getmetatable, tostring, pcall = type, pairs, rawget, getmetatable, tostring, pcall
+
+-- the same dump lab_names.lua makes
+do
+  local names, ids = {}, {}
+  for k in pairs(R.Implemented) do
+    if type(k) == "number" then ids[#ids + 1] = k else names[#names + 1] = tostring(k) end
+  end
+  table.sort(names)
+  table.sort(ids)
+  for _, n in ipairs(names) do B.log("lab_names: I " .. n) end
+  for _, id in ipairs(ids) do B.log("lab_names: C " .. id) end
+  B.log("lab_names: END " .. #names .. " names, " .. #ids .. " callbacks")
+end
+
+local seen, count = {}, 0
+local function emit(cls, name)
+  if type(name) ~= "string" or name:sub(1, 2) == "__" then return end
+  local key = cls .. "." .. name
+  if seen[key] then return end
+  seen[key] = true
+  count = count + 1
+  B.log("lab_census: E " .. key)
+end
+local function keys_of(t, cls)
+  if type(t) ~= "table" then return end
+  local ok = pcall(function() for k in pairs(t) do emit(cls, k) end end)
+  return ok
+end
+local function from_class_table(c, cls)
+  if type(c) ~= "table" then return end
+  keys_of(c, cls)
+  keys_of(rawget(c, "__propget"), cls)
+  keys_of(rawget(c, "__propset"), cls)
+end
+
+local skip = { _G = true, _VERSION = true, package = true, string = true, table = true, math = true, io = true, os = true, debug = true, coroutine = true, utf8 = true, jit = true }
+local classes = 0
+for cls, v in pairs(_G) do
+  if type(cls) == "string" and not skip[cls] and type(v) == "table" then
+    classes = classes + 1
+    keys_of(v, cls)
+    local mt = getmetatable(v)
+    if type(mt) == "table" then
+      from_class_table(rawget(mt, "__class"), cls)
+      from_class_table(rawget(mt, "__const"), cls)
+      keys_of(rawget(mt, "__propget"), cls)
+    end
+  end
+end
+
+-- a class the game gives no static table is reached through an object of it
+local samples = {
+  Game = function() return Game() end, Level = function() return Game():GetLevel() end,
+  Room = function() return Game():GetRoom() end, ItemPool = function() return Game():GetItemPool() end,
+  ItemConfig = function() return Isaac.GetItemConfig() end, SFXManager = function() return SFXManager() end,
+  MusicManager = function() return MusicManager() end, RNG = function() return RNG() end,
+  Sprite = function() return Sprite() end, Vector = function() return Vector(0, 0) end,
+  Color = function() return Color(1, 1, 1, 1, 0, 0, 0) end, Seeds = function() return Game():GetSeeds() end,
+  HUD = function() return Game():GetHUD() end, PlayerHUD = function() return Game():GetHUD():GetPlayerHUD(0) end,
+  EntityPlayer = function() return Isaac.GetPlayer(0) end, Camera = function() return Game():GetRoom():GetCamera() end,
+  Options = function() return Options end, ItemConfigItem = function() return Isaac.GetItemConfig():GetCollectible(1) end,
+  ItemConfig_Item = function() return Isaac.GetItemConfig():GetCollectible(1) end,
+  ItemConfig_Card = function() return Isaac.GetItemConfig():GetCard(1) end,
+  ItemConfig_PillEffect = function() return Isaac.GetItemConfig():GetPillEffect(1) end,
+  EntityDesc = function() return Game():GetRoom():GetRoomConfigRoom() end,
+  RoomDescriptor = function() return Game():GetLevel():GetCurrentRoomDesc() end,
+  RoomConfigRoom = function() return Game():GetLevel():GetCurrentRoomDesc().Data end,
+}
+-- objects of the Layer's own stand-in classes (not global tables: only a constructor or a factory makes them)
+local made = {
+  Beam = function() return Beam(Sprite(), 0, false, false) end,
+  Image = function() return Renderer.CreateImage(1, 1, "census") end,
+  Shader = function() return Renderer.LoadShader("census") end,
+}
+for cls, make in pairs(made) do samples[cls] = make end
+for cls, make in pairs(samples) do
+  local ok, o = pcall(make)
+  if ok and o ~= nil then
+    local mt = type(o) == "table" and getmetatable(o) or nil
+    if type(o) ~= "table" then
+      local ok2, m2 = pcall(getmetatable, o)
+      mt = ok2 and m2 or nil
+    end
+    if type(mt) == "table" then
+      from_class_table(rawget(mt, "__class") or mt, cls)
+      from_class_table(rawget(mt, "__const"), cls)
+    end
+  end
+end
+B.log("lab_census: END " .. count .. " names on " .. classes .. " global tables")
