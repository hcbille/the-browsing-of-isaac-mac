@@ -0,0 +1,88 @@
+-- lab_locate.lua (development only; LAB=lab_locate.lua): every name of api_locate.lua is called and read back.
+-- Lines: "lab_locate: PASS|FAIL <name> <detail>", and a last "lab_locate: DONE pass=N fail=M".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab locate", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_locate: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, "error: " .. tostring(err)) end
+end
+local function near(a, b, eps) return math.abs(a - b) <= (eps or 0.01) end
+
+local function run()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs({ "EntityPlayer.Teleport", "EntityPlayer.InitTwin", "PlayerManager.RemoveCoPlayer" }) do
+    check("Implemented " .. n, I[n] == true)
+  end
+  local p = Isaac.GetPlayer(0)
+  local g = Game()
+
+  try("Teleport without effects", function()
+    p.Velocity = Vector(3, 3)
+    p:Teleport(Vector(300, 200), false)
+    check("Teleport position", near(p.Position.X, 300) and near(p.Position.Y, 200), tostring(p.Position))
+    check("Teleport clears velocity", near(p.Velocity.X, 0) and near(p.Velocity.Y, 0), tostring(p.Velocity))
+  end)
+  try("Teleport with effects", function()
+    local before = #Isaac.FindByType(1000, 15)
+    p:Teleport(Vector(200, 200), true, false)
+    check("Teleport (effects) position", near(p.Position.X, 200) and near(p.Position.Y, 200), tostring(p.Position))
+    local anim = p:GetSprite():GetAnimation()
+    local after = #Isaac.FindByType(1000, 15)
+    B.log("lab_locate: info anim=" .. tostring(anim) .. " poofs " .. before .. " -> " .. after)
+    check("Teleport (effects) spawned a poof", after > before)
+    check("Teleport rejects a non-vector", not pcall(p.Teleport, p, 5))
+  end)
+
+  local twin
+  try("InitTwin", function()
+    check("one player before", g:GetNumPlayers() == 1, g:GetNumPlayers())
+    p.Position = Vector(300, 250)
+    twin = p:InitTwin(PlayerType.PLAYER_ESAU)
+    check("InitTwin answers a player", twin ~= nil)
+    check("player count", g:GetNumPlayers() == 2, g:GetNumPlayers())
+    check("twin type", twin:GetPlayerType() == PlayerType.PLAYER_ESAU, twin:GetPlayerType())
+    check("twin controller", twin.ControllerIndex == p.ControllerIndex, tostring(twin.ControllerIndex))
+    check("twin is player 1", GetPtrHash(g:GetPlayer(1)) == GetPtrHash(twin))
+    check("GetOtherTwin from the owner", p.GetOtherTwin and p:GetOtherTwin() and GetPtrHash(p:GetOtherTwin()) == GetPtrHash(twin))
+    check("GetOtherTwin from the twin", twin.GetOtherTwin and twin:GetOtherTwin() and GetPtrHash(twin:GetOtherTwin()) == GetPtrHash(p))
+    check("twin stands 40 units to the right", near(twin.Position.X - p.Position.X, 40, 1) and near(twin.Position.Y, p.Position.Y, 1),
+      tostring(p.Position) .. " " .. tostring(twin.Position))
+    check("InitTwin rejects a string", not pcall(p.InitTwin, p, "x"))
+  end)
+  try("Teleport twins", function()
+    if not twin then return end
+    p:Teleport(Vector(400, 300), false, true)
+    check("owner at target", near(p.Position.X, 400) and near(p.Position.Y, 300), tostring(p.Position))
+    check("twin followed", (twin.Position - Vector(400, 300)):Length() < 60, tostring(twin.Position))
+  end)
+  try("RemoveCoPlayer", function()
+    if not twin then return end
+    check("rejects the main player", not pcall(PlayerManager.RemoveCoPlayer, p))
+    check("rejects nil", not pcall(PlayerManager.RemoveCoPlayer, nil))
+    PlayerManager.RemoveCoPlayer(twin)
+    check("player count back to 1", g:GetNumPlayers() == 1, g:GetNumPlayers())
+    local ot = p:GetOtherTwin()
+    B.log("lab_locate: info twin link after removal: raw " .. string.format("%x", B.r32(B.ptr(p) + 0x1e68)) .. " GetOtherTwin " ..
+      tostring(ot and string.format("%x", B.ptr(ot))) .. " owner " .. string.format("%x", B.ptr(p)) .. " twin was " .. string.format("%x", B.ptr(twin)))
+    check("owner has no twin", B.r32(B.ptr(p) + 0x1e68) == 0)
+  end)
+end
+
+local frame, done = 0, false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame == 40 then
+    local ok, err = pcall(run)
+    if not ok then check("run", false, err) end
+  elseif frame == 80 and not done then
+    done = true
+    check("game still has one player after more frames", Game():GetNumPlayers() == 1, Game():GetNumPlayers())
+    B.log("lab_locate: DONE pass=" .. pass .. " fail=" .. fail)
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_logbench.lua b/scripts/recomp/rgon/lab_logbench.lua
new file mode 100644
index 0000000..38d08dd
--- /dev/null
+++ b/scripts/recomp/rgon/lab_logbench.lua
@@ -0,0 +1,84 @@
+-- lab_logbench.lua (development only; ISAAC_RGON_LAB=lab_logbench.lua, headless): what one log line costs on each path.
+-- Phase 1: Isaac.DebugString x N (the game's logger -> OutputDebugStringA -> the Host).
+-- Phase 2: a mod callback that raises an error K times per update (the game logs "failed:" + traceback).
+-- Phase 3: Sprite:Play of a name the anm2 does not have, K times per update (the game logs "[warn] no animation named").
+-- Phase 4: B.log (the Layer's own line) x N.
+-- Phase 5: control, the same loops with no logging (Lua only).
+-- Prints "logbench: <phase> N=.. total_ms=.. us_per_line=.." and a DONE line. Times with os.clock (CPU seconds).
+local T = ...
+local B = T.B
+local say = function(s) B.log("logbench: " .. s) end
+local mod = RegisterMod("rgon lab logbench", 1)
+local N = tonumber(os.getenv and os.getenv("LOGBENCH_N") or "") or 20000
+local K = tonumber(os.getenv and os.getenv("LOGBENCH_K") or "") or 100
+local clock = os.clock
+local frames = 0
+local phase = 0
+local started = false
+local spr
+local base_n, base_t0, base_ms
+local t_phase
+
+local function report(name, n, t)
+  say(string.format("%s N=%d total_ms=%.2f us_per_line=%.3f", name, n, t * 1000, t * 1e6 / n))
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frames = frames + 1
+  if frames < 20 then return end
+  if phase == 0 then
+    phase = 1
+    local t = clock()
+    for i = 1, N do Isaac.DebugString("logbench line " .. i) end
+    report("debugstring", N, clock() - t)
+    t = clock()
+    for i = 1, N do local _ = "logbench line " .. i end
+    report("control_lua_loop", N, clock() - t)
+    t = clock()
+    for i = 1, N do B.log("logbench layer line " .. i) end
+    report("layer_B.log", N, clock() - t)
+    spr = Sprite()
+    spr:Load("gfx/001.000_player.anm2", true)
+    t = clock()
+    for i = 1, N do spr:Play("NoSuchAnim", true) end
+    report("missing_anim_warn", N, clock() - t)
+    phase = 1.5
+    return
+  end
+  if phase == 1.5 then
+    -- baseline: 60 updates with nothing failing
+    base_n = (base_n or 0) + 1
+    if base_n == 1 then base_t0 = clock() end
+    if base_n == 61 then
+      base_ms = (clock() - base_t0) * 1000
+      say(string.format("baseline_update total_ms=%.2f ms_per_update=%.3f", base_ms, base_ms / 60))
+      phase = 2
+    end
+    return
+  end
+  if phase == 2 then
+    -- errors: K per update, for 50 updates
+    error("logbench deliberate error")
+  end
+end)
+-- a second callback so each update fires K failing callbacks (each its own pcall + log + traceback)
+for i = 1, 20 do
+  mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+    if phase == 2 then error("logbench deliberate error " .. i) end
+  end)
+end
+local upd0, t0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if phase == 2 then
+    upd0 = (upd0 or 0) + 1
+    if upd0 == 1 then t0 = clock() end
+    if upd0 == 61 then
+      local n = 60 * 21
+      local extra = (clock() - t0) * 1000 - base_ms
+      say(string.format("lua_error_callbacks N=%d extra_ms=%.2f us_per_failing_callback=%.1f", n, extra, extra * 1000 / n))
+      phase = 3
+      say("DONE")
+    end
+  end
+end)
+say("loaded N=" .. N)
diff --git a/scripts/recomp/rgon/lab_minimap_scan.lua b/scripts/recomp/rgon/lab_minimap_scan.lua
new file mode 100644
index 0000000..d9b783b
--- /dev/null
+++ b/scripts/recomp/rgon/lab_minimap_scan.lua
@@ -0,0 +1,29 @@
+-- lab_minimap_scan.lua (development only; ISAAC_RGON_LAB=lab_minimap_scan.lua, census batch 3): finds the game's Minimap
+-- by the sprites inside the game object (ANM2 objects point at themselves at +0x30 and +0x50), logging each one's
+-- offset and the file it was loaded from, and the words before the first minimap sprite (state, hold time).
+local T = ...
+local B = T.B
+local r32 = B.r32
+local mod = RegisterMod("rgon lab minimap scan", 1)
+local done = false
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if done then return end
+  done = true
+  local g = r32(0x00c71678)
+  B.log(string.format("lab_minimap_scan: game object at 0x%x", g))
+  local a, n = g, 0
+  while a < g + 0x30000 do
+    local ok, p30 = pcall(r32, a + 0x30)
+    if ok and p30 == a then
+      local ok2, p50 = pcall(r32, a + 0x50)
+      if ok2 and p50 == a then
+        local ok4, name = pcall(function() return T.wrap("Sprite", a):GetFilename() end)
+        B.log(string.format("lab_minimap_scan: sprite at game+0x%x %s", a - g, ok4 and name or "?"))
+        n = n + 1
+        a = a + 0x100
+      end
+    end
+    a = a + 4
+  end
+  B.log("lab_minimap_scan: " .. n .. " sprites")
+end)
diff --git a/scripts/recomp/rgon/lab_minimap_state.lua b/scripts/recomp/rgon/lab_minimap_state.lua
new file mode 100644
index 0000000..78b3043
--- /dev/null
+++ b/scripts/recomp/rgon/lab_minimap_state.lua
@@ -0,0 +1,21 @@
+-- lab_minimap_state.lua (development only; ISAAC_RGON_LAB=lab_minimap_state.lua, census batch 3): logs the first words of the
+-- game's Minimap (game object + 0x25ecc, found by lab_minimap_scan.lua) and the shake fields every 10 frames of a run, so a
+-- scripted Tab press (map expand) shows which word is the state and which the hold time.
+local T = ...
+local B = T.B
+local r32, ri32 = B.r32, B.ri32
+local mod = RegisterMod("rgon lab minimap state", 1)
+local frame, last = 0, nil
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  frame = frame + 1
+  if frame % 10 ~= 0 then return end
+  local g = r32(0x00c71678)
+  if g == 0 then return end
+  local m = g + 0x25ecc
+  local s = string.format("w0=%d w4=%d w8=%d wc=0x%08x shake=%d off=0x%08x,0x%08x", ri32(m), ri32(m + 4), ri32(m + 8), r32(m + 0xc),
+    ri32(m + 0x61c), r32(m + 0x620), r32(m + 0x624))
+  if s ~= last then
+    last = s
+    B.log("lab_minimap_state: f" .. frame .. " " .. s)
+  end
