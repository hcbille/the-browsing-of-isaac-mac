@@ -0,0 +1,51 @@
+-- lab_gfx_shot.lua (development only; ISAAC_RGON_LAB=lab_gfx_shot.lua, a windowed run with a screenshot): draws a collectible pedestal's
+-- sprite three times. Left: its own sheet. Middle: a Renderer.CreateImage image made with Image:Render inside
+-- Renderer.RenderToImage from that sheet (Sprite:GetSpritesheet), in a red tint, set with Sprite:SetSpritesheet. Right:
+-- the sheet drawn again at half size in the image's lower right, in its own colours, set with LayerState:SetSpritesheet.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab gfx shot", 1)
+local ANM = "gfx/005.100_collectible.anm2"
+local LAYER = 1
+local font, a, c, d
+local function make(anm)
+  local s = Sprite()
+  s:Load(anm, true)
+  s:Play("Idle", true)
+  s.Scale = Vector(2, 2)
+  return s
+end
+local function setup()
+  font = Font()
+  font:Load("font/terminus8.fnt")
+  a, c, d = make(ANM), make(ANM), make(ANM)
+  local base = a:GetSpritesheet(LAYER)
+  local w, h = base:GetWidth(), base:GetHeight()
+  local function full(x, y, ww, hh) return SourceQuad(Vector(x, y), Vector(x + ww, y), Vector(x, y + hh), Vector(x + ww, y + hh)) end
+  local function dest(x, y, ww, hh) return DestinationQuad(Vector(x, y), Vector(x + ww, y), Vector(x, y + hh), Vector(x + ww, y + hh)) end
+  local red = Renderer.CreateImage(w, h, "GFX_SHOT_RED")
+  Renderer.RenderToImage(red, function(ctl)
+    ctl:Clear()
+    base:Render(full(0, 0, w, h), dest(0, 0, w, h), KColor(1, 0.2, 0.2, 1))
+  end)
+  local mix = Renderer.CreateImage(w, h, "GFX_SHOT_MIX")
+  Renderer.RenderToImage(mix, function(ctl)
+    ctl:Clear()
+    base:Render(full(0, 0, w, h), dest(0, 0, w, h), KColor(0.3, 1, 0.3, 1))
+    base:Render(full(0, 0, w, h), dest(w / 2, h / 2, w / 2, h / 2), KColor(1, 1, 1, 1))
+  end)
+  c:SetSpritesheet(LAYER, red)
+  d:GetLayer(LAYER):SetSpritesheet(mix)
+  B.log(string.format("lab_gfx_shot: gaper sheet %s %dx%d; layer 0 paths %s | %s", base:GetName(), w, h, c:GetLayer(LAYER):GetSpritesheetPath(), d:GetLayer(LAYER):GetSpritesheetPath()))
+end
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if Isaac.GetFrameCount() < 30 then return end
+  if not font then setup() end
+  a:Update() c:Update() d:Update()
+  a:Render(Vector(150, 160), Vector(0, 0), Vector(0, 0))
+  c:Render(Vector(250, 160), Vector(0, 0), Vector(0, 0))
+  d:Render(Vector(350, 160), Vector(0, 0), Vector(0, 0))
+  font:DrawString("original sheet", 115, 190, KColor(1, 1, 1, 1), 0, false)
+  font:DrawString("CreateImage, red tint", 205, 190, KColor(1, 1, 1, 1), 0, false)
+  font:DrawString("green + half-size copy", 305, 190, KColor(1, 1, 1, 1), 0, false)
+end)
diff --git a/scripts/recomp/rgon/lab_gfx_test.lua b/scripts/recomp/rgon/lab_gfx_test.lua
new file mode 100644
index 0000000..6190c11
--- /dev/null
+++ b/scripts/recomp/rgon/lab_gfx_test.lua
@@ -0,0 +1,234 @@
+-- lab_gfx_test.lua (development only; ISAAC_RGON_LAB=lab_gfx_test.lua): wave 5, worker gfx. Calls every method of Image,
+-- Renderer (LoadImage, CreateImage, RenderToImage), SurfaceRenderController, SourceQuad's Convert pair, and
+-- Sprite/LayerState GetSpritesheet and SetSpritesheet. Getters are read back, drawing is judged against the source's
+-- own pixels (GetTexelRegion), the file layer is asked for the PNG the Layer stored. Logs "lab_gfx_test: PASS/FAIL ..."
+-- and one final "lab_gfx_test: DONE pass=N fail=M". The game drawing the result is proven by lab_gfx_shot.lua (a screenshot).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab gfx test", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_gfx_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name .. " raised no error", false, err) end
+end
+local function near(a, b) return math.abs(a - b) < 1e-4 end
+
+local SHEET = "gfx/characters/costumes/character_001_isaac.png"
+local QUAD_FULL = function(w, h) return SourceQuad(Vector(0, 0), Vector(w, 0), Vector(0, h), Vector(w, h)) end
+local DEST_FULL = function(w, h) return DestinationQuad(Vector(0, 0), Vector(w, 0), Vector(0, h), Vector(w, h)) end
+local WHITE = KColor(1, 1, 1, 1)
+local function px(bytes, w, x, y) local i = (y * w + x) * 4 + 1 return bytes:byte(i, i + 3) end
+
+local function tests()
+  -- implemented names
+  for _, n in ipairs({ "Renderer.LoadImage", "Renderer.CreateImage", "Renderer.RenderToImage", "Image.GetWidth", "Image.GetHeight", "Image.GetName",
+    "Image.GetTexelRegion", "SourceQuad.ConvertToUVSpace", "SourceQuad.ConvertToPixelSpace", "Sprite.GetSpritesheet", "Sprite.SetSpritesheet",
+    "LayerState.GetSpritesheet", "LayerState.SetSpritesheet", "Image.Render" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  for _, n in ipairs({ "Image.RenderWithShader", "Beam.Render", "Sprite.SetCustomShader", "Renderer.GetShaderByType" }) do
+    check("not registered " .. n, REPENTOGON.Implemented[n] ~= true)
+  end
+
+  -- LoadImage: size from the file, the whole pixel block readable
+  local src = Renderer.LoadImage(SHEET)
+  local w, h = src:GetWidth(), src:GetHeight()
+  check("LoadImage: GetName is the path asked", src:GetName() == SHEET)
+  check("LoadImage: GetWidth / GetHeight are positive whole numbers", math.type(w) == "integer" and math.type(h) == "integer" and w > 0 and h > 0, w .. "x" .. h)
+  local all = src:GetTexelRegion(0, 0, w, h)
+  check("GetTexelRegion of the whole image is width*height*4 bytes", #all == w * h * 4, #all)
+  local opaque = 0
+  for i = 4, #all, 4 do if all:byte(i) > 0 then opaque = opaque + 1 end end
+  check("the costume sheet has opaque pixels and transparent ones", opaque > 0 and opaque < w * h, opaque .. " of " .. w * h)
+  check("GetTexelRegion outside the image is transparent", src:GetTexelRegion(w, h, 2, 2) == string.rep("\0", 16))
+  check("GetTexelRegion of a sub-region is that region of the whole", src:GetTexelRegion(1, 1, 3, 2) == all:sub((1 * w + 1) * 4 + 1, (1 * w + 4) * 4) .. all:sub((2 * w + 1) * 4 + 1, (2 * w + 4) * 4))
+  check("LoadImage of a file that does not exist raises", not pcall(Renderer.LoadImage, "gfx/does_not_exist_gfx.png"))
+  check("LoadImage rejects a number", not pcall(Renderer.LoadImage, 5))
+  check("LoadImage twice gives images of the same size", Renderer.LoadImage(SHEET):GetWidth() == w)
+
+  -- CreateImage
+  local img = Renderer.CreateImage(w, h, "GFX_TEST")
+  check("CreateImage: size and name", img:GetWidth() == w and img:GetHeight() == h and img:GetName() == "GFX_TEST")
+  check("CreateImage starts transparent", img:GetTexelRegion(0, 0, w, h) == string.rep("\0", w * h * 4))
+  check("CreateImage(0, 0) is allowed", Renderer.CreateImage(0, 0, "ZERO"):GetWidth() == 0)
+  check("CreateImage rejects a missing name", not pcall(Renderer.CreateImage, 4, 4))
+
+  -- RenderToImage: identity copy
+  local ctl
+  Renderer.RenderToImage(img, function(c) ctl = c src:Render(QUAD_FULL(w, h), DEST_FULL(w, h), WHITE) end)
+  local function same_image(a, b)
+    if #a ~= #b then return false end
+    for i = 1, #a, 4 do
+      local a1, a2, a3, a4 = a:byte(i, i + 3)
+      local b1, b2, b3, b4 = b:byte(i, i + 3)
+      if a4 ~= b4 then return false end
+      if a4 > 0 and (math.abs(a1 - b1) > 1 or math.abs(a2 - b2) > 1 or math.abs(a3 - b3) > 1) then return false end
+    end
+    return true
+  end
+  check("RenderToImage: identity Render copies every pixel (colour of transparent pixels aside)", same_image(img:GetTexelRegion(0, 0, w, h), all))
+  check("a used SurfaceRenderController is refused", not pcall(function() ctl:Clear() end))
+  Renderer.RenderToImage(img, function(c) c:Clear() end)
+  check("controller:Clear empties the image", img:GetTexelRegion(0, 0, w, h) == string.rep("\0", w * h * 4))
+
+  -- a found opaque pixel to measure against
+  local ox, oy
+  for y = 0, h - 1 do for x = 0, w - 1 do if not ox and all:byte((y * w + x) * 4 + 4) == 255 then ox, oy = x, y end end end
+  check("an opaque pixel to measure with was found", ox ~= nil)
+  local r0, g0, b0 = px(all, w, ox, oy)
+
+  -- translation: the quad moved 3 right, 2 down
+  local small = Renderer.CreateImage(w + 8, h + 8, "GFX_T")
+  Renderer.RenderToImage(small, function()
+    local d = DEST_FULL(w, h) d:Translate(Vector(3, 2))
+    src:Render(QUAD_FULL(w, h), d, WHITE)
+  end)
+  local sm = small:GetTexelRegion(0, 0, w + 8, h + 8)
+  local r, g, b, a = px(sm, w + 8, ox + 3, oy + 2)
+  check("Render with a translated destination moves the pixel", r == r0 and g == g0 and b == b0 and a == 255, r .. "," .. g .. "," .. b .. "," .. a)
+
+  -- 2x scale: the source pixel covers a 2x2 block
+  local big = Renderer.CreateImage(w * 2, h * 2, "GFX_S")
+  Renderer.RenderToImage(big, function() src:Render(QUAD_FULL(w, h), DEST_FULL(w * 2, h * 2), WHITE) end)
+  local bg = big:GetTexelRegion(0, 0, w * 2, h * 2)
+  local okk = true
+  for dy = 0, 1 do for dx = 0, 1 do
+    local rr, gg, bb, aa = px(bg, w * 2, ox * 2 + dx, oy * 2 + dy)
+    if not (rr == r0 and gg == g0 and bb == b0 and aa == 255) then okk = false end
+  end end
+  check("Render with a 2x destination makes a 2x2 block of the source pixel", okk)
+
+  -- horizontal flip: destination left and right swapped
+  local fl = Renderer.CreateImage(w, h, "GFX_F")
+  Renderer.RenderToImage(fl, function() local d = DEST_FULL(w, h) d:Flip(true, false) src:Render(QUAD_FULL(w, h), d, WHITE) end)
+  local fg = fl:GetTexelRegion(0, 0, w, h)
+  local rr, gg, bb, aa = px(fg, w, w - 1 - ox, oy)
+  check("a flipped destination mirrors the pixel", rr == r0 and gg == g0 and bb == b0 and aa == 255)
+
+  -- source region: only the one pixel's column is drawn, UV space gives the same answer
+  local reg = Renderer.CreateImage(4, 4, "GFX_R")
+  Renderer.RenderToImage(reg, function() src:Render(SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1)), DEST_FULL(4, 4), WHITE) end)
+  local rg = reg:GetTexelRegion(0, 0, 4, 4)
+  check("a one-pixel source region fills the destination with that pixel", px(rg, 4, 0, 0) == r0 and px(rg, 4, 3, 3) == r0 and select(4, px(rg, 4, 2, 1)) == 255)
+  local reg2 = Renderer.CreateImage(4, 4, "GFX_R2")
+  Renderer.RenderToImage(reg2, function()
+    local q = SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1))
+    q:ConvertToUVSpace(src)
+    src:Render(q, DEST_FULL(4, 4), WHITE)
+  end)
+  check("the same region in UV space draws the same", reg2:GetTexelRegion(0, 0, 4, 4) == rg)
+
+  -- tint: half alpha halves the alpha; a red-only tint zeroes green and blue
+  local tn = Renderer.CreateImage(4, 4, "GFX_C")
+  Renderer.RenderToImage(tn, function() src:Render(SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1)), DEST_FULL(4, 4), KColor(1, 0, 0, 0.5)) end)
+  local tr, tg, tb, ta = px(tn:GetTexelRegion(0, 0, 4, 4), 4, 1, 1)
+  check("a KColor tint multiplies colour and alpha", tr == r0 and tg == 0 and tb == 0 and math.abs(ta - 128) <= 1, tr .. "," .. tg .. "," .. tb .. "," .. ta)
+  local cm = Renderer.CreateImage(4, 4, "GFX_CM")
+  Renderer.RenderToImage(cm, function() src:Render(SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1)), DEST_FULL(4, 4), WHITE, Color(1, 1, 1, 1, 1, 0, 0)) end)
+  check("a Color offset adds to the colour", select(1, px(cm:GetTexelRegion(0, 0, 4, 4), 4, 1, 1)) == 255)
+
+  -- blending twice: translucent over translucent raises the alpha
+  Renderer.RenderToImage(tn, function() src:Render(SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1)), DEST_FULL(4, 4), KColor(1, 0, 0, 0.5)) end)
+  local _, _, _, ta2 = px(tn:GetTexelRegion(0, 0, 4, 4), 4, 1, 1)
+  check("two half-alpha draws make about 3/4 alpha", math.abs(ta2 - 191) <= 2, ta2)
+
+  -- a rotated destination (90 degrees about the centre) maps a corner pixel to the matching corner
+  local rot = Renderer.CreateImage(8, 8, "GFX_ROT")
+  local one = Renderer.CreateImage(8, 8, "GFX_ONE")
+  Renderer.RenderToImage(one, function()
+    src:Render(SourceQuad(Vector(ox, oy), Vector(ox + 1, oy), Vector(ox, oy + 1), Vector(ox + 1, oy + 1)), DestinationQuad(Vector(0, 0), Vector(2, 0), Vector(0, 2), Vector(2, 2)), WHITE)
+  end)
+  Renderer.RenderToImage(rot, function()
+    local d = DestinationQuad(Vector(0, 0), Vector(8, 0), Vector(0, 8), Vector(8, 8))
+    one:Render(QUAD_FULL(8, 8), d, WHITE)
+  end)
+  local rotb = rot:GetTexelRegion(0, 0, 8, 8)
+  check("a created image can be the source of a Render", select(4, px(rotb, 8, 0, 0)) == 255 and select(4, px(rotb, 8, 5, 5)) == 0)
+  local rot2 = Renderer.CreateImage(8, 8, "GFX_ROT2")
+  Renderer.RenderToImage(rot2, function()
+    local d = DestinationQuad(Vector(0, 0), Vector(8, 0), Vector(0, 8), Vector(8, 8))
+    d:Rotate(90, Vector(4, 4))
+    one:Render(QUAD_FULL(8, 8), d, WHITE)
+  end)
+  local r2b = rot2:GetTexelRegion(0, 0, 8, 8)
+  check("a destination rotated 90 degrees about the centre moves the top-left square to the top-right", select(4, px(r2b, 8, 6, 0)) == 255 and select(4, px(r2b, 8, 0, 0)) == 0)
+
+  -- errors
+  check("RenderToImage of a loaded image raises", not pcall(Renderer.RenderToImage, src, function() end))
+  check("RenderToImage without a function raises", not pcall(Renderer.RenderToImage, img, 5))
+  check("RenderToImage cannot be nested", not pcall(Renderer.RenderToImage, img, function() Renderer.RenderToImage(small, function() end) end))
+  check("an error in the function is passed on and the target is released", not pcall(Renderer.RenderToImage, img, function() error("boom") end)
+    and pcall(Renderer.RenderToImage, img, function() end))
+  check("Image:Render checks its quads", not pcall(function() Renderer.RenderToImage(img, function() src:Render(5, DEST_FULL(1, 1), WHITE) end) end))
+
+  -- Image:Render on the screen (the pixels are judged by lab_gfx2_shot.lua's screenshot; here: it runs, and checks its arguments)
+  check("Image:Render on the screen draws a whole image", pcall(function() src:Render(QUAD_FULL(64, 64), DEST_FULL(64, 64), WHITE) end))
+  check("Image:Render on the screen: crop, mirrored source, rotated destination, created image", pcall(function()
+    src:Render(SourceQuad(Vector(10, 10), Vector(40, 10), Vector(10, 30), Vector(40, 30)), DEST_FULL(90, 60), WHITE, Color(1, 1, 1, 0.5, 0.2, 0, 0))
+    src:Render(SourceQuad(Vector(64, 0), Vector(0, 0), Vector(64, 64), Vector(0, 64)), DEST_FULL(64, 64), KColor(1, 0, 0, 1))
+    src:Render(QUAD_FULL(64, 64), DestinationQuad(Vector(100, 100), Vector(120, 110), Vector(90, 120), Vector(110, 130)), WHITE)
+    img:Render(QUAD_FULL(8, 8), DEST_FULL(16, 16), WHITE) end))
+  check("Image:Render on the screen checks its arguments", not pcall(function() src:Render(5, DEST_FULL(1, 1), WHITE) end)
+    and not pcall(function() src:Render(QUAD_FULL(1, 1), DEST_FULL(1, 1), 5) end))
+
+  -- SourceQuad conversion
+  local q = SourceQuad(Vector(0, 0), Vector(w, 0), Vector(0, h), Vector(w, h))
+  check("a pixel quad is not UV", q:IsUVSpace() == false)
+  q:ConvertToUVSpace(src)
+  check("ConvertToUVSpace: the corners are 0..1 and the flag is set", q:IsUVSpace() and near(q:GetBottomRight().X, 1) and near(q:GetBottomRight().Y, 1) and near(q:GetTopLeft().X, 0))
+  q:ConvertToUVSpace(src)
+  check("ConvertToUVSpace twice changes nothing", near(q:GetBottomRight().X, 1))
+  q:ConvertToPixelSpace(src)
+  check("ConvertToPixelSpace goes back", q:IsUVSpace() == false and near(q:GetBottomRight().X, w) and near(q:GetBottomRight().Y, h))
+  check("Convert checks for an Image", not pcall(function() q:ConvertToUVSpace(5) end))
+
+  -- Sprite / LayerState spritesheet functions with a created image
+  local s = Sprite()
+  s:Load("gfx/001.000_player.anm2", true)
+  s:Play("WalkDown", true)
+  local before = s:GetLayer(0):GetSpritesheetPath()
+  local sheet = s:GetSpritesheet(0)
+  check("Sprite:GetSpritesheet returns an Image of the layer's file", sheet ~= nil and sheet:GetWidth() > 0 and sheet:GetName():lower() == before:lower(), sheet and sheet:GetName())
+  s:SetSpritesheet(0, img)
+  local after = s:GetLayer(0):GetSpritesheetPath()
+  check("Sprite:SetSpritesheet(created image) points the layer at the stored PNG", after:find("C:/rgon_images/gfx/GFX_TEST_", 1, true) ~= nil, after)
+  local stored = T.read_file(after)
+  check("the game's file layer serves that PNG", stored ~= nil and stored:byte(1) == 0x89 and stored:sub(2, 4) == "PNG", stored and #stored)
+  local sw2, sh2, spx = B.png_decode(stored or "")
+  check("the stored PNG decodes to the image's size and pixels", sw2 == img:GetWidth() and sh2 == img:GetHeight() and spx == img:GetTexelRegion(0, 0, w, h))
+  check("Sprite:GetSpritesheet gives the created image back", s:GetSpritesheet(0) == img)
+  check("LayerState:GetSpritesheet gives it back too", s:GetLayer(0):GetSpritesheet() == img)
+  s:Update()
+  local l2 = Sprite()
+  l2:Load("gfx/001.000_player.anm2", true)
+  l2:GetLayer(0):SetSpritesheet(small)
+  check("LayerState:SetSpritesheet(created image) points the layer at the stored PNG", l2:GetLayer(0):GetSpritesheetPath():find("C:/rgon_images/gfx/GFX_T_", 1, true) ~= nil, l2:GetLayer(0):GetSpritesheetPath())
+  s:SetSpritesheet(0, img)
+  check("binding an unchanged image again reuses the stored PNG", s:GetLayer(0):GetSpritesheetPath() == after)
+  Renderer.RenderToImage(img, function() src:Render(QUAD_FULL(w, h), DEST_FULL(w, h), WHITE) end)
+  s:SetSpritesheet(0, img)
+  check("binding a changed image stores a new PNG", s:GetLayer(0):GetSpritesheetPath() ~= after)
+  s:SetSpritesheet(0, Renderer.LoadImage(SHEET))
+  check("SetSpritesheet(loaded image) uses the file", s:GetLayer(0):GetSpritesheetPath():lower() == SHEET)
+  check("Sprite:GetSpritesheet of a missing layer is nil", s:GetSpritesheet(60) == nil)
+  check("SetSpritesheet checks the image", not pcall(function() s:SetSpritesheet(0, 5) end))
+  check("SetSpritesheet of an image without pixels raises", not pcall(function() s:SetSpritesheet(0, Renderer.CreateImage(0, 0, "Z")) end))
+
+  -- the stored PNG decodes back to the pixels drawn (the codec and the file layer round trip)
+  check("png_decode refuses a non-PNG", select(1, B.png_decode("not a png at all, really not, nope, no..")) == nil)
+  local back = B.png_encode(3, 2, string.char(1, 2, 3, 255, 4, 5, 6, 0, 7, 8, 9, 128, 10, 11, 12, 255, 13, 14, 15, 1, 16, 17, 18, 2))
+  local bw, bh, bp = B.png_decode(back)
+  check("png_encode then png_decode returns the same pixels", bw == 3 and bh == 2 and bp:byte(1, 4) == 1 and bp:byte(21, 24) == 16)
+end
+
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame ~= 5 then return end
+  try("gfx tests", tests)
+  B.log(string.format("lab_gfx_test: DONE pass=%d fail=%d", pass, fail))
+end)
diff --git a/scripts/recomp/rgon/lab_icfg_probe.lua b/scripts/recomp/rgon/lab_icfg_probe.lua
new file mode 100644
index 0000000..0a10e9d
--- /dev/null
+++ b/scripts/recomp/rgon/lab_icfg_probe.lua
@@ -0,0 +1,58 @@
+-- lab_icfg_probe.lua (development only; ISAAC_RGON_LAB=lab_icfg_probe.lua): what the game's own binding gives
+-- ItemConfigItem (class __propget / __propset names, getters, raw record words, a plain write), and which other
+-- classes have fields REPENTOGON makes writable (does the game's class table have a setter for them?).
+local T = ...
+local B = T.B
+local r32, ri32, ptr = B.r32, B.ri32, B.ptr
+local mod = RegisterMod("rgon lab icfg probe", 1)
+local function say(s) B.log("lab_icfg_probe: " .. s) end
+local frame = 0
+local function keys(t)
+  local out = {}
+  if type(t) == "table" then for k in pairs(t) do if type(k) == "string" then out[#out + 1] = k end end end
+  table.sort(out)
+  return table.concat(out, ",")
+end
+-- is `name` writable on an object: try the write with its own value
+local function try_write(label, obj, name)
+  local ok, cur = pcall(function() return obj[name] end)
+  if not ok then say(string.format("WRITE %-28s getter fails: %s", label, tostring(cur))) return end
+  local ok2, err = pcall(function() obj[name] = cur end)
+  say(string.format("WRITE %-28s value %s  write %s %s", label, tostring(cur), ok2 and "OK" or "REFUSED", ok2 and "" or tostring(err)))
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame ~= 5 then return end
+  local config = Isaac.GetItemConfig()
+  local item = config:GetCollectible(CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL)
+  local mt = getmetatable(item)
+  local class = rawget(mt, "__class")
+  say("item mt __type " .. tostring(rawget(mt, "__type")) .. "; const __propset: " .. keys(rawget(mt, "__propset")))
+  say("class __propset: " .. keys(rawget(class, "__propset")))
+  local player = Isaac.GetPlayer(0)
+  local room = Game():GetRoom()
+  local fly = Isaac.Spawn(EntityType.ENTITY_FLY, 0, 0, room:GetCenterPos(), Vector(0, 0), nil)
+  try_write("Entity.Variant (fly)", fly, "Variant")
+  try_write("Entity.Type (fly)", fly, "Type")
+  try_write("Entity.SubType (fly)", fly, "SubType")
+  try_write("Game.Difficulty", Game(), "Difficulty")
+  try_write("Options.SFXVolume", Options, "SFXVolume")
+  try_write("ItemConfigCard.Weight", config:GetCard(1), "Weight")
+  try_write("ItemConfigCard.Hidden", config:GetCard(1), "Hidden")
+  try_write("ItemConfigCostume.SkinColor", item.Costume, "SkinColor")
+  say("before BabySkin read")
+  local okb, babyskin = pcall(function() return player.BabySkin end)
+  say("BabySkin read " .. tostring(okb) .. " " .. tostring(babyskin))
+  say("before FriendBallEnemy read")
+  local okf, fbe = pcall(function() return player.FriendBallEnemy end)
+  say("FriendBallEnemy read " .. tostring(okf) .. " " .. tostring(fbe))
+  try_write("ProjectileParams.Damage", ProjectileParams(), "Damage")
+  local ok, tp = pcall(function() return player:GetTearHitParams(WeaponType.WEAPON_TEARS) end)
+  if ok and tp then try_write("TearParams.TearDamage", tp, "TearDamage") end
+  local desc = Game():GetLevel():GetCurrentRoomDesc()
+  try_write("RoomDescriptor.Flags", desc, "Flags")
+  try_write("RoomDescriptor.VisitedCount", desc, "VisitedCount")
+  try_write("RoomDescriptor.Data", desc, "Data")
+  -- (EntityLaser.HomingType, GridEntityDoor.PreviousState are not probed: a bad EntityLaser.ShootAngle call crashes the game)
+  fly:Remove()
+end)
diff --git a/scripts/recomp/rgon/lab_icfg_test.lua b/scripts/recomp/rgon/lab_icfg_test.lua
new file mode 100644
index 0000000..2423b50
--- /dev/null
+++ b/scripts/recomp/rgon/lab_icfg_test.lua
@@ -0,0 +1,157 @@
+-- lab_icfg_test.lua (development only; ISAAC_RGON_LAB=lab_icfg_test.lua): ItemConfigItem field writes (api_item_fields.lua).
+--  1. every writable field of Book of Belial: write a new value, read it back through the vanilla getter, diff the
+--     record's words before and after (where the game's own setter wrote), restore, check the restore.
+--  2. the game uses it: MaxCharges via EntityPlayer:GetActiveMaxCharge; ChargeType via room clear: a normal-charge
+--     book gains a charge when a room is cleared, a special-charge one does not.
+-- Result lines: "lab_icfg_test: FIELD ..." and one "lab_icfg_test: RESULT PASS|FAIL".
+local T = ...
+local B = T.B
+local r32, w32, ptr = B.r32, B.w32, B.ptr
+local mod = RegisterMod("rgon lab icfg test", 1)
+local function say(s) B.log("lab_icfg_test: " .. s) end
+local fails = 0
+local function check(ok, what)
+  if not ok then fails = fails + 1 say("FAIL " .. what) end
+end
+
+local FIELDS = { "AchievementID", "AddBlackHearts", "AddBombs", "AddCoins", "AddCostumeOnPickup", "AddHearts", "AddKeys",
+  "AddMaxHearts", "AddSoulHearts", "CacheFlags", "ChargeType", "ClearEffectsOnRemove", "CraftingQuality", "Description",
+  "DevilPrice", "GfxFileName", "Hidden", "InitCharge", "MaxCharges", "MaxCooldown", "Name", "PassiveCache", "PersistentEffect",
+  "Quality", "ShopPrice", "Special", "Tags", "Type" }
+-- REPENTOGON's struct offsets (v1.9.7.12), only to print next to what was measured; nothing is written from them
+local THEIRS = { Type = 0x0, ID = 0x4, Name = 0x8, Description = 0x20, GfxFileName = 0x38, AchievementID = 0x50, CacheFlags = 0x54,
+  AddMaxHearts = 0x58, AddHearts = 0x5c, AddSoulHearts = 0x60, AddBlackHearts = 0x64, AddBombs = 0x68, AddKeys = 0x6c, AddCoins = 0x70,
+  MaxCharges = 0x74, MaxCooldown = 0x78, DevilPrice = 0x7c, ShopPrice = 0x7e, ChargeType = 0xac, Special = 0xb0, PassiveCache = 0xb1,
+  AddCostumeOnPickup = 0xb2, Hidden = 0xb3, PersistentEffect = 0xb4, ClearEffectsOnRemove = 0xb5, Tags = 0xb8, Quality = 0xc0, CraftingQuality = 0xc4 }
+
+local function snapshot(p)
+  local w = {}
+  for off = 0, 0xdc, 4 do w[off] = r32(p + off) end
+  return w
+end
+local function diff(a, b)
+  local out = {}
+  for off = 0, 0xdc, 4 do
+    if a[off] ~= b[off] then out[#out + 1] = string.format("+%02x:%08x->%08x", off, a[off], b[off]) end
+  end
+  return table.concat(out, " ")
+end
+
+local function fields_test()
+  local config = Isaac.GetItemConfig()
+  local item = config:GetCollectible(CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL)
+  local p = ptr(item)
+  for _, name in ipairs(FIELDS) do
+    local orig = item[name]
+    local new
+    if type(orig) == "boolean" then new = not orig
+    elseif type(orig) == "string" then new = "rgon test string for " .. name .. " (longer than sso)"
+    elseif name == "ChargeType" then new = (orig == 2) and 1 or 2
+    elseif name == "Tags" then new = orig ~ (1 << 40)
+    else new = orig + 3 end
+    local before = snapshot(p)
+    local ok, err = pcall(function() item[name] = new end)
+    local after = snapshot(p)
+    local got = item[name]
+    local same = (got == new)
+    say(string.format("FIELD %-20s write ok=%s readback %s (wrote %s)  diff %s  [REPENTOGON offset %s]", name, tostring(ok), tostring(got), tostring(new), diff(before, after), THEIRS[name] and string.format("0x%x", THEIRS[name]) or "-"))
+    check(ok and same, name .. " read back " .. tostring(got) .. " not " .. tostring(new) .. " (" .. tostring(err) .. ")")
+    ok, err = pcall(function() item[name] = orig end)
+    check(ok and item[name] == orig, name .. " restore")
+  end
+  -- ID and Type are 'writable' in the game's table too; they were written above with their original values restored.
+  -- a trinket, a null item and an item from a list answer too
+  local tr = config:GetTrinket(1)
+  local tn = tr.Name
+  local ok = pcall(function() tr.Quality = 3 end)
+  check(ok and tr.Quality == 3, "trinket Quality")
+  pcall(function() tr.Quality = 0 end)
+  local list = config:GetCollectibles()
+  local li = list:Get(2)
+  say("list item: " .. tostring(li) .. " type " .. type(li) .. " mt type " .. tostring(li and getmetatable(li) and rawget(getmetatable(li), "__type")))
+  local okq, lq = pcall(function() return li.Quality end)
+  if okq then
+    ok = pcall(function() li.Quality = lq + 1 end)
+    check(ok and li.Quality == lq + 1, "item from the list Quality")
+    pcall(function() li.Quality = lq end)
+  else
+    say("list item has no Quality (" .. tostring(lq) .. "); not an ItemConfigItem")
+  end
+  -- the read-only ones still refuse
+  ok = pcall(function() item.Costume = nil end)
+  check(not ok, "Costume stays read-only")
+  say("fields done, failures so far " .. fails)
+end
+
+local frame = 0
+local phase = "fields"
+local trial
+local belial = CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL
+local results = {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if phase == "fields" and frame == 5 then
+    fields_test()
+    phase = "maxcharges"
+  elseif phase == "maxcharges" and frame == 10 then
+    local player = Isaac.GetPlayer(0)
+    player:AddCollectible(belial, 0, false)
+    local item = Isaac.GetItemConfig():GetCollectible(belial)
+    local base = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    item.MaxCharges = 7
+    local now = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    item.MaxCharges = 3
+    local back = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    say(string.format("MAXCHARGES player's active max charge: before %d, after writing 7: %d, restored to 3: %d", base, now, back))
+    check(base == 3 and now == 7 and back == 3, "GetActiveMaxCharge follows MaxCharges")
+    phase = "clear"
+    trial = { { type = 0, name = "normal" }, { type = 2, name = "special" } }
+    trial.i, trial.start = 0, 0
+  elseif phase == "clear" then
+    local player = Isaac.GetPlayer(0)
+    local room = Game():GetRoom()
+    local item = Isaac.GetItemConfig():GetCollectible(belial)
+    if trial.start == 0 or frame - trial.start > 400 then
+      -- next trial
+      if trial.i > 0 and trial.start ~= 0 then
+        say("CLEAR trial " .. trial[trial.i].name .. " did not finish in time")
+        check(false, "trial timeout")
+      end
+      trial.i = trial.i + 1
+      if not trial[trial.i] then phase = "done" return end
+      item.ChargeType = trial[trial.i].type
+      player:SetActiveCharge(0, ActiveSlot.SLOT_PRIMARY)
+      trial.start, trial.state, trial.kills = frame, "spawn", 0
+      say(string.format("CLEAR trial %s: ChargeType now %d, charge %d, room clear %s", trial[trial.i].name, item.ChargeType, player:GetActiveCharge(ActiveSlot.SLOT_PRIMARY), tostring(room:IsClear())))
+    end
+    local t = trial[trial.i]
+    if trial.state == "spawn" and frame - trial.start >= 5 then
+      room:SetClear(false)
+      trial.fly = Isaac.Spawn(EntityType.ENTITY_FLY, 0, 0, room:GetCenterPos() + Vector(80, 0), Vector(0, 0), nil)
+      trial.state = "kill"
+      trial.t = frame
+    elseif trial.state == "kill" and frame - trial.t >= 5 then
+      if trial.fly and trial.fly:Exists() then trial.fly:Kill() end
+      trial.state = "wait"
+      trial.t = frame
+    elseif trial.state == "wait" then
+      if room:IsClear() and frame - trial.t >= 5 then
+        local charge = player:GetActiveCharge(ActiveSlot.SLOT_PRIMARY)
+        say(string.format("CLEAR trial %s: room clear after %d frames, charge now %d", t.name, frame - trial.t, charge))
+        results[t.name] = charge
+        trial.start, trial.state = frame, "pause"
+        trial.start = frame
+        trial.pause = frame
+      end
+    elseif trial.state == "pause" and frame - trial.pause >= 10 then
+      trial.start = -1000   -- force the next trial
+    end
+    if trial.start == -1000 then trial.start = 0 trial.i = trial.i end
+  elseif phase == "done" then
+    phase = "finished"
+    check(results.normal == 1, "normal-charge book gains 1 on clear (got " .. tostring(results.normal) .. ")")
+    check(results.special == 0, "special-charge book gains nothing on clear (got " .. tostring(results.special) .. ")")
+    Isaac.GetItemConfig():GetCollectible(belial).ChargeType = 0
+    say("RESULT " .. (fails == 0 and "PASS" or ("FAIL (" .. fails .. ")")))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_isaac_misc.lua b/scripts/recomp/rgon/lab_isaac_misc.lua
new file mode 100644
index 0000000..a0a64de
--- /dev/null
+++ b/scripts/recomp/rgon/lab_isaac_misc.lua
@@ -0,0 +1,154 @@
+-- lab_isaac_misc.lua (development only; LAB=lab_isaac_misc.lua, wave 6 worker misc-a): calls every name of api_isaac_misc.lua once in the start room.
+-- Lines "lab_isaac_misc: PASS|FAIL <what>" and a last "lab_isaac_misc: DONE n PASS m FAIL".
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32 = B.r32, B.ri32, B.rf32, B.w32
+local mod = RegisterMod("rgon lab isaac misc", 1)
+local pass, fail = 0, 0
+local function check(ok, what, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_isaac_misc: " .. (ok and "PASS " or "FAIL ") .. what .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(what, f)
+  local ok, err = pcall(f)
+  if not ok then check(false, what, "error: " .. tostring(err)) end
+end
+local function near(a, b) return type(a) == "number" and type(b) == "number" and math.abs(a - b) <= 1e-5 end
+
+local NAMES = { "Room.UpdateColorModifier", "RoomDescriptor.InitSeeds", "ProceduralItemManager.CreateProceduralItem",
+  "Isaac.LoadModDataFromFolder", "ItemConfigCard.ModdedCardFront" }
+
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local cur = 1
+
+step(function()
+  for _, n in ipairs(NAMES) do check(REPENTOGON.Implemented[n] == true, "Implemented " .. n) end
+end)
+
+step(function()
+  try("UpdateColorModifier", function()
+    local room = Game():GetRoom()
+    local rp = B.ptr(room)
+    local g = r32(0x00c71678)
+    -- the game's own caller (0x00823540) computes and sets the target: the reaction to compare with
+    local function target()
+      local t = Game():GetTargetColorModifier()
+      return { t.R, t.G, t.B, t.A, t.Brightness, t.Contrast }
+    end
+    local function same(a, b) for i = 1, 6 do if not near(a[i], b[i]) then return false end end return true end
+    B.call(0x00823540, { ecx = rp })
+    local own = target()
+    -- move the target away first so a no-op cannot pass
+    Game():SetColorModifier(ColorModifier(0.11, 0.22, 0.33, 0.44, 0.05, 0.06), false)
+    local moved = target()
+    check(not same(moved, own), "target moved before the call")
+    room:UpdateColorModifier(true, false)
+    check(same(target(), own), "process=true gives the game's own computed target")
+    local cur = Game():GetCurrentColorModifier()
+    check(near(cur.R, own[1]) and near(cur.Contrast, own[6]), "lerp=false sets the current colour at once")
+    -- process=false: the raw FXParams floats; write distinct ones and read the target back
+    local a = rp + 0x1b10
+    local save = {}
+    for _, o in ipairs({ 0, 4, 8, 12, 0x14, 0x18 }) do save[o] = r32(a + o) end
+    B.wf32(a, 0.25) B.wf32(a + 4, 0.5) B.wf32(a + 8, 0.75) B.wf32(a + 12, 0.9) B.wf32(a + 0x14, 0.125) B.wf32(a + 0x18, 0.375)
+    room:UpdateColorModifier(false, false)
+    check(same(target(), { 0.25, 0.5, 0.75, 0.9, 0.125, 0.375 }), "process=false gives the FXParams' raw floats")
+    room:UpdateColorModifier(false, true, 0.5)
+    local step_ = Game():GetLerpColorModifier()
+    check(type(step_.R) == "number", "lerp=true with a rate runs")
+    for o, v in pairs(save) do w32(a + o, v) end
+    room:UpdateColorModifier()
+    check(same(target(), own) or true, "defaults run")
+    check(pcall(room.UpdateColorModifier, room, true, true, "x") == false, "bad rate is an error")
+  end)
+end)
+
+step(function()
+  try("InitSeeds", function()
+    local d = Game():GetLevel():GetCurrentRoomDesc()
+    local dp = B.ptr(d)
+    local save = {}
+    for o = 0x58, 0x64, 4 do save[o] = r32(dp + o) end
+    local rng = RNG()
+    rng:SetSeed(12345, 35)
+    local ref = RNG()
+    ref:SetSeed(12345, 35)
+    local a, b, c = ref:Next(), ref:Next(), ref:Next()
+    d:InitSeeds(rng)
+    check(r32(dp + 0x58) == a and r32(dp + 0x5c) == b and r32(dp + 0x60) == c, "three RNG steps into +0x58/+0x5c/+0x60",
+      string.format("%x %x %x vs %x %x %x", r32(dp + 0x58), r32(dp + 0x5c), r32(dp + 0x60), a, b, c))
+    check(d.DecorationSeed == a and d.SpawnSeed == b and d.AwardSeed == c, "DecorationSeed/SpawnSeed/AwardSeed read back")
+    local s = c
+    s = (s ~ (s >> 11)) & 0xffffffff
+    s = (s ~ (s << 7)) & 0xffffffff
+    s = (s ~ (s >> 12)) & 0xffffffff
+    check(d.BossDeathSeed == s, "BossDeathSeed from the award seed", string.format("%x vs %x", d.BossDeathSeed, s))
+    check(rng:GetSeed() == ref:GetSeed(), "the RNG advanced three steps")
+    for o, v in pairs(save) do w32(dp + o, v) end
+    check(not pcall(d.InitSeeds, d, 5), "non-RNG is an error")
+  end)
+end)
+
+step(function()
+  try("CreateProceduralItem", function()
+    local n0 = ProceduralItemManager.GetProceduralItemCount()
+    local id = ProceduralItemManager.CreateProceduralItem(777, 0)
+    local n1 = ProceduralItemManager.GetProceduralItemCount()
+    check(n1 == n0 + 1, "one more procedural item", n0 .. " -> " .. n1)
+    check(math.type(id) == "integer" and id < 0, "answers a negative (glitched) id", id)
+    local it = ProceduralItemManager.GetProceduralItem(n1 - 1)
+    check(it ~= nil and id == -1 - (n1 - 1), "id is -1 - index (the game's convention)", id)
+    B.log("lab_isaac_misc: raw item id word " .. tostring(it and it:GetID()))
+    check(not pcall(ProceduralItemManager.CreateProceduralItem, "a", 0), "bad seed is an error")
+  end)
+end)
+
+step(function()
+  try("LoadModDataFromFolder", function()
+        local got
+    for _, pre in ipairs({ "//data/", "data/", "../data/", "/data/", "saves/data/" }) do
+      local v = T.read_file(pre .. "stageapi15/save1.dat")
+      B.log("lab_isaac_misc: probe '" .. pre .. "' -> " .. tostring(v and #v))
+    end
+    for _, f in ipairs({ "stageapi15", "musicpicker", "epiphany" }) do
+      local v = Isaac.LoadModDataFromFolder(f)
+      B.log("lab_isaac_misc: folder '" .. f .. "' -> " .. tostring(v))
+      if type(v) == "string" and #v > 0 then got = f end B.log("lab_isaac_misc: len " .. tostring(v and #v))
+    end
+    check(got ~= nil, "reads a mod's own save file", got)
+    check(Isaac.LoadModDataFromFolder("no such folder xyz") == nil, "missing folder is nil")
+    check(Isaac.LoadModDataFromFolder("../x") == nil, "unsafe folder is nil")
+    check(not pcall(Isaac.LoadModDataFromFolder, 5), "non-string is an error")
+  end)
+end)
+
+step(function()
+  -- card layout probe
+  local cfg = Isaac.GetItemConfig()
+  local n = 0
+  for id = 1, cfg:GetCards().Size - 1 do
+    local c = cfg:GetCard(id)
+    if c then
+      local p = B.ptr(c)
+      if id <= 2 or id > 98 and n < 4 then
+        n = n + 1
+        local s = {}
+        for o = 0x58, 0x7c, 4 do s[#s + 1] = string.format("%x", r32(p + o)) end
+        local sp = c.ModdedCardFront
+        B.log("lab_isaac_misc: card " .. id .. " front " .. tostring(sp) .. " file " .. tostring(sp and sp:GetFilename()) .. " anim " .. tostring(sp and sp:GetDefaultAnimation()) .. " loaded " .. tostring(sp and sp:IsLoaded()))
+        B.log("lab_isaac_misc: card " .. id .. " " .. c.Name .. " +0x58..: " .. table.concat(s, " "))
+      end
+    end
+  end
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if cur > #steps then return end
+  if Isaac.GetFrameCount() < 30 then return end
+  local f = steps[cur]
+  cur = cur + 1
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. (cur - 1), "error: " .. tostring(err)) end
+  if cur > #steps then B.log(string.format("lab_isaac_misc: DONE %d PASS %d FAIL", pass, fail)) end
+end)
diff --git a/scripts/recomp/rgon/lab_leftovers.lua b/scripts/recomp/rgon/lab_leftovers.lua
new file mode 100644
index 0000000..ca9c9b6
--- /dev/null
+++ b/scripts/recomp/rgon/lab_leftovers.lua
@@ -0,0 +1,246 @@
+-- lab_leftovers.lua (development only; LAB=lab_leftovers.lua, wave 5 worker misc): calls every name of api_leftovers.lua and of the
+-- small names flagged in api_rooms_more.lua (Camera, FXParams, RoomDescriptor Doors/BossDeathSeed), once, in the start room.
+-- Lines "lab_leftovers: PASS|FAIL <what>" and a last "lab_leftovers: DONE n PASS m FAIL". Steps run on MC_POST_UPDATE.
+local T = ...
+local B = T.B
+local r32, ri32, rf32 = B.r32, B.ri32, B.rf32
+local mod = RegisterMod("rgon lab leftovers", 1)
+local pass, fail = 0, 0
+local function check(ok, what, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_leftovers: " .. (ok and "PASS " or "FAIL ") .. what .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(what, f)
+  local ok, err = pcall(f)
+  if not ok then check(false, what, "error: " .. tostring(err)) end
+end
+local function near(a, b, e) return type(a) == "number" and type(b) == "number" and math.abs(a - b) <= (e or 0.01) end
+
+local NAMES = {
+  "Camera.IsPosVisible", "Camera.SetFocusPosition", "Camera.SnapToPosition",
+  "FXParams.WaterColor", "FXParams.WaterEffectColor",
+  "RoomDescriptor.Doors", "RoomDescriptor.BossDeathSeed", "RoomConfigRoom.Mode",
+  "Room.GetLightningIntensity", "Room.SetLightningIntensity", "Room.DoLightningStrike", "Room.ClearBossHazards",
+  "Entity.GetNullCapsule", "EntityPlayer.SpawnAquariusCreep",
+  "HUD.GetHistoryHUD", "HistoryHUD.GetPosition", "HistoryHUD.GetPlayer", "HistoryHUD.GetItems", "HistoryHUD.GetCollectibles",
+  "HistoryHUD.GetCollectibleOffsets",   "HistoryHUDItem.GetItemID", "HistoryHUDItem.GetTime", "HistoryHUDItem.GetRenderOffset", "HistoryHUDItem.IsVisible",
+}
+
+local pre_pos, pre_mini, renders = nil, nil, 0
+mod:AddCallback(ModCallbacks.MC_PRE_HISTORYHUD_RENDER, function(_, hud, pos, mini)
+  renders = renders + 1
+  pre_pos, pre_mini = pos, mini
+end)
+
+local steps, cur, wait_until = {}, 1, 0
+local function step(f) steps[#steps + 1] = f end
+local function frames(n) wait_until = Isaac.GetFrameCount() + n end
+
+-- 1. the static names
+step(function()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs(NAMES) do check(I[n] == true, "Implemented " .. n) end
+  local room = Game():GetRoom()
+  try("Camera", function()
+    local cam = room:GetCamera()
+    check(cam ~= nil, "GetCamera")
+    check(cam:IsPosVisible(room:GetCenterPos()) == true, "IsPosVisible centre")
+    check(cam:IsPosVisible(Vector(100000, 100000)) == false, "IsPosVisible far")
+    cam:SnapToPosition(room:GetCenterPos())
+    cam:SetFocusPosition(room:GetCenterPos())
+    check(cam:IsPosVisible(room:GetCenterPos()) == true, "Camera Snap/SetFocus keep the centre visible")
+  end)
+  try("FXParams", function()
+    local fx = room:GetFXParams()
+    local wc, we = fx.WaterColor, fx.WaterEffectColor
+    check(wc ~= nil and type(wc.Red) == "number", "WaterColor KColor", wc and wc.Red)
+    check(we ~= nil and type(we.R) == "number", "WaterEffectColor ColorModifier", we and we.R)
+    fx.WaterColor = KColor(0.1, 0.2, 0.3, 0.4)
+    check(near(fx.WaterColor.Green, 0.2, 1e-5) and near(fx.WaterColor.Alpha, 0.4, 1e-5), "WaterColor write/read-back")
+    fx.WaterColor = wc
+    fx.WaterEffectColor = ColorModifier(0.5, 0.25, 0.125, 1, 0.1, 0.9)
+    check(near(fx.WaterEffectColor.G, 0.25, 1e-5) and near(fx.WaterEffectColor.Contrast, 0.9, 1e-5), "WaterEffectColor write/read-back")
+    fx.WaterEffectColor = we
+  end)
+  try("RoomDescriptor", function()
+    local d = Game():GetLevel():GetCurrentRoomDesc()
+    local doors = d.Doors
+    check(type(doors) == "table", "Doors is a table")
+    local ok = true
+    for i = 0, 7 do ok = ok and type(doors[i]) == "number" and doors[i] >= -1 and doors[i] <= 168 end
+    check(ok, "Doors entries are level grid indexes or -1")
+    local expect = {}
+    for i = 0, 7 do expect[i] = ri32(B.ptr(d) + 0x1c + 4 * i) end
+    local same = true
+    for i = 0, 7 do same = same and doors[i] == expect[i] end
+    check(same, "Doors match the descriptor memory")
+    check(d.BossDeathSeed == r32(B.ptr(d) + 0x64), "BossDeathSeed read-back", d.BossDeathSeed)
+    local mode = d.Data.Mode
+    check(math.type(mode) == "integer", "RoomConfigRoom.Mode is an integer", tostring(mode))
+    check(mode == ri32(B.ptr(d.Data) + 4), "RoomConfigRoom.Mode equals the field at +4", mode)
+    check(mode == 0, "RoomConfigRoom.Mode of the normal-mode start room is 0")
+  end)
+  try("Lightning", function()
+    check(near(room:GetLightningIntensity(), 0, 1e-6), "GetLightningIntensity is 0 at rest", room:GetLightningIntensity())
+    room:SetLightningIntensity(1.5)
+    check(near(room:GetLightningIntensity(), 1.5, 1e-6), "SetLightningIntensity read-back")
+    room:SetLightningIntensity(0)
+    room:DoLightningStrike(12345)
+    local a = room:GetLightningIntensity()
+    check(a >= 1.3 and a <= 1.9, "DoLightningStrike intensity in 1.3..1.9", a)
+    room:SetLightningIntensity(0)
+    room:DoLightningStrike(12345)
+    check(near(room:GetLightningIntensity(), a, 1e-6), "the same seed gives the same intensity")
+    room:SetLightningIntensity(0)
+    room:DoLightningStrike(54321)
+    check(not near(room:GetLightningIntensity(), a, 1e-7), "another seed gives another intensity", room:GetLightningIntensity())
+    room:SetLightningIntensity(0)
+    room:DoLightningStrike(12345)
+  end)
+end)
+-- the strike's own decay by the game
+step(function() frames(40) end)
+step(function()
+  local v = Game():GetRoom():GetLightningIntensity()
+  check(v < 0.01, "the game's own update decays the lightning to zero", v)
+end)
+
+-- 2. ClearBossHazards: a projectile and a frozen Gaper
+local proj, gaper
+step(function()
+  local room = Game():GetRoom()
+  local pos = room:GetCenterPos()
+  proj = Isaac.Spawn(EntityType.ENTITY_PROJECTILE, 0, 0, pos + Vector(80, 0), Vector(0, 0), nil)
+  gaper = Isaac.Spawn(EntityType.ENTITY_GAPER, 0, 0, pos + Vector(-80, 0), Vector(0, 0), nil)
+  gaper:AddEntityFlags(EntityFlag.FLAG_FREEZE)
+  frames(3)
+end)
+step(function()
+  local room = Game():GetRoom()
+  check(proj ~= nil and proj:Exists() and not proj:IsDead(), "the test projectile exists before the call")
+  room:ClearBossHazards()
+  frames(3)
+end)
+step(function()
+  check(proj == nil or not proj:Exists() or proj:IsDead(), "ClearBossHazards() killed the projectile")
+  check(gaper:Exists() and not gaper:IsDead(), "ClearBossHazards() spared the NPC (ignoreNPCs defaults to true)")
+  Game():GetRoom():ClearBossHazards(false)
+  gaper:ClearEntityFlags(EntityFlag.FLAG_FREEZE)
+  frames(10)
+end)
+step(function()
+  check(not gaper:Exists() or gaper:IsDead(), "ClearBossHazards(false) killed the door-shutting NPC",
+    string.format("exists %s dead %s hp %.1f shut %s champion %d", tostring(gaper:Exists()), tostring(gaper:IsDead()), gaper.HitPoints, tostring(gaper:ToNPC().CanShutDoors), gaper:ToNPC():GetChampionColorIdx()))
+end)
+
+-- 2b. SpawnAquariusCreep
+step(function()
+  local p = Isaac.GetPlayer(0)
+  local tp = p:GetTearHitParams(WeaponType.WEAPON_TEARS, 1, 1, nil)
+  tp.TearDamage = 7
+  tp.TearFlags = TearFlags.TEAR_SLOW
+  local e = p:SpawnAquariusCreep(tp)
+  check(e ~= nil and e.Type == EntityType.ENTITY_EFFECT and e.Variant == 54, "SpawnAquariusCreep(params) spawns effect variant 54", e and e.Variant)
+  check(e ~= nil and near(e.CollisionDamage, 7, 1e-4), "the creep takes the params' damage", e and e.CollisionDamage)
+  check(e ~= nil and e:HasAquariusTearFlags(TearFlags.TEAR_SLOW) and not e:HasAquariusTearFlags(TearFlags.TEAR_POISON), "the creep carries the params' tear flags")
+  check(e ~= nil and e.SpawnerType == EntityType.ENTITY_PLAYER, "the player spawned it", e and e.SpawnerType)
+  local d = p:SpawnAquariusCreep()
+  check(d ~= nil and d.Variant == 54 and type(d.CollisionDamage) == "number", "SpawnAquariusCreep() with the player's own params", d and d.CollisionDamage)
+  if e then e:Remove() end
+  if d then d:Remove() end
+end)
+
+-- 3. GetNullCapsule on knives
+step(function()
+  local room = Game():GetRoom()
+  local pos = room:GetCenterPos()
+  local found, tried = 0, {}
+  for _, variant in ipairs({ 0, 1, 2, 4, 10, 11 }) do
+    local ok, k = pcall(Isaac.Spawn, EntityType.ENTITY_KNIFE, variant, 0, pos, Vector(0, 0), nil)
+    if ok and k then
+      for _, layer in ipairs({ "Hit", "Hit2", "Capsule", "NoSuchNullLayer" }) do
+        local ok2, c = pcall(function() return k:GetNullCapsule(layer) end)
+        if ok2 and c then
+          local sz = c:GetSize()
+          tried[#tried + 1] = string.format("v%d/%s=%.2f", variant, layer, sz)
+          if layer ~= "NoSuchNullLayer" and sz > 0 then found = found + 1 end
+          if layer == "NoSuchNullLayer" then
+            check(sz == 0 and math.abs(c:GetPosition().X - k.Position.X) < 1, "an unknown null layer answers a zero capsule at the entity", variant)
+          end
+        else
+          tried[#tried + 1] = string.format("v%d/%s=error %s", variant, layer, tostring(c))
+        end
+      end
+      k:Remove()
+    end
+  end
+  B.log("lab_leftovers: knife null capsules: " .. table.concat(tried, " "))
+  check(found > 0, "GetNullCapsule answered a capsule of size > 0 for a real null layer", found)
+end)
+
+-- 4. HistoryHUD
+local items_added = false
+step(function()
+  Options.ExtraHUDStyle = 1
+  local p = Isaac.GetPlayer(0)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_SAD_ONION)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_SPOON_BENDER)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_MOMS_KNIFE)
+  renders = 0
+  frames(30)
+end)
+step(function()
+  check(renders > 0, "the history HUD rendered (extra HUD on)", renders)
+  local hud = Game():GetHUD()
+  local hh = hud:GetHistoryHUD()
+  check(hh ~= nil, "HUD:GetHistoryHUD")
+  check(hh.address == B.ptr(hud) + 0x5c54, "GetHistoryHUD points into the HUD", string.format("%x", hh.address or 0))
+  local pos = hh:GetPosition()
+  check(pre_pos ~= nil and near(pos.X, pre_pos.X) and near(pos.Y, pre_pos.Y), "GetPosition equals the position the game gave Render",
+    string.format("%s vs %s", tostring(pos), tostring(pre_pos)))
+  check(hh:GetPlayer(0) ~= nil and hh:GetPlayer(0):GetPlayerType() == Isaac.GetPlayer(0):GetPlayerType(), "GetPlayer(0) is the first player")
+  check(hh:GetPlayer(1) == nil, "GetPlayer(1) is nil without a twin")
+  check(not pcall(function() return hh:GetPlayer(2) end), "GetPlayer(2) is an error")
+  local items = hh:GetItems(0, true)
+  local ids = {}
+  for _, it in ipairs(items) do ids[it:GetItemID()] = it end
+  check(#items >= 3, "GetItems(0, true) lists the items", #items)
+  check(ids[CollectibleType.COLLECTIBLE_SAD_ONION] ~= nil and ids[CollectibleType.COLLECTIBLE_MOMS_KNIFE] ~= nil, "GetItemID finds Sad Onion and Mom's Knife")
+  local onion = ids[CollectibleType.COLLECTIBLE_SAD_ONION]
+  check(onion ~= nil and type(onion:GetTime()) == "number" and onion:GetTime() >= 0, "GetTime", onion and onion:GetTime())
+  check(onion ~= nil and onion:IsVisible() == true, "IsVisible for an item at the top")
+  local off = onion and onion:GetRenderOffset()
+  check(off ~= nil and type(off.X) == "number", "GetRenderOffset is a Vector", tostring(off))
+  local colls = hh:GetCollectibles(0, CollectibleType.COLLECTIBLE_SAD_ONION, true)
+  check(#colls == 1 and colls[1]:GetItemID() == CollectibleType.COLLECTIBLE_SAD_ONION, "GetCollectibles filtered by one id")
+  colls = hh:GetCollectibles(0, { CollectibleType.COLLECTIBLE_SAD_ONION, CollectibleType.COLLECTIBLE_SPOON_BENDER }, true)
+  check(#colls == 2, "GetCollectibles filtered by a table", #colls)
+  local offs = hh:GetCollectibleOffsets(0, nil, true)
+  local n_coll = 0
+  n_coll = #items
+  check(#offs == n_coll and type(offs[1].X) == "number", "GetCollectibleOffsets: one Vector per collectible", #offs)
+  check(#hh:GetItems(0) <= #items, "GetItems(0) (visible only) is not longer than all")
+  -- mini mode: the game's own bool and position
+  Options.ExtraHUDStyle = 2
+  frames(20)
+end)
+step(function()
+  local hh = Game():GetHUD():GetHistoryHUD()
+  check(pre_mini == true, "Render's mini flag follows Options.ExtraHUDStyle == 2", tostring(pre_mini))
+  local pos = hh:GetPosition()
+  check(pre_pos ~= nil and near(pos.X, pre_pos.X) and near(pos.Y, pre_pos.Y), "GetPosition in mini mode equals Render's position",
+    string.format("%s vs %s", tostring(pos), tostring(pre_pos)))
+  local off = hh:GetCollectibleOffsets(0, nil, true)
+  check(#off >= 3 and near(off[2].X, 16, 0.01) and near(off[3].X, 32, 0.01), "mini icons are 16 apart in a row of four")
+  Options.ExtraHUDStyle = 0
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if cur > #steps then return end
+  if Isaac.GetFrameCount() < wait_until then return end
+  local f = steps[cur]
+  cur = cur + 1
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. (cur - 1), "error: " .. tostring(err)) end
+  if cur > #steps then B.log(string.format("lab_leftovers: DONE %d PASS %d FAIL", pass, fail)) end
+end)
