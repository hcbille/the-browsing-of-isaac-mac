+-- Item pools from itempools.xml: Isaac.GetPoolIdByName(name), ItemPool:GetCollectiblesFromPool(pool),
+-- ItemPool:GetNumItemPools(). The game's own pools are ItemPoolType 0 and up in the file's order (checked
+-- against the enum's names); a pool a mod's itempools.xml names that the game has not is a custom pool and
+-- gets the numbers after them, in load order. The game itself has no such pool: an id of one is the layer's
+-- (accepted, not supported: nothing in the game draws from it). Weights are the file's own, as the pools start.
+do
+  local XML = rawget(_G, "XMLNode")
+  local function norm(s) return (tostring(s):gsub("^POOL_", ""):gsub("[_%s]", ""):lower()) end
+  local pools                       -- norm name -> { id, name, items = { {id, weight, decreaseby, removeon} } }
+  local order
+  local function build()
+    if pools then return pools end
+    pools, order = {}, {}
+    local enum = {}
+    for k, v in pairs(rawget(_G, "ItemPoolType") or {}) do if type(v) == "number" then enum[norm(k)] = v end end
+    local top = -1
+    for _, v in pairs(enum) do if v > top then top = v end end
+    local nodes = T.nodes_of and T.nodes_of("itempools.xml", { "Pool", "pool" }) or {}
+    local custom = top
+    for _, node in ipairs(nodes) do
+      local name = node.attr.name
+      if name then
+        local key = norm(name)
+        local p = pools[key]
+        if not p then
+          local id = enum[key]
+          if not id then custom = custom + 1 id = custom end
+          p = { id = id, name = name, items = {}, custom = enum[key] == nil }
+          pools[key] = p
+          order[#order + 1] = p
+        end
+        for _, it in ipairs(node) do
+          local a = it.attr
+          local id = math.tointeger(tonumber(a.id or a.collectible or ""))
+          if id then
+            p.items[#p.items + 1] = { id, tonumber(a.weight) or 1.0, tonumber(a.decreaseby) or 1.0, tonumber(a.removeon) or 0.1 }
+          end
+        end
+      end
+    end
+    return pools
+  end
+  T.static(Isaac, "Isaac", "GetPoolIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetPoolIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    local p = build()[norm(name)]
+    return p and p.id or -1
+  end)
+  T.method("ItemPool", "GetCollectiblesFromPool", function(self, pool)
+    if math.type(pool) ~= "integer" then error("bad argument #1 to 'GetCollectiblesFromPool' (integer expected, got " .. type(pool) .. ")", 2) end
+    build()
+    local out = {}
+    for _, p in ipairs(order) do
+      if p.id == pool then
+        for _, it in ipairs(p.items) do
+          out[#out + 1] = { itemID = it[1], initialWeight = it[2], weight = it[2], decreaseBy = it[3], removeOn = it[4], isUnlocked = true }
+        end
+      end
+    end
+    return out
+  end)
+  T.method("ItemPool", "GetNumItemPools", function() build() return #order end)
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["ItemPool custom pools"] = "a pool only a mod's itempools.xml names has an id here; the game does not draw from it"
+end
+
+-- Isaac.GetGiantBookIdByName(name): giantbook.xml's entries. The game's own carry their id; a mod's follow the
+-- highest, in load order. -1 when there is none. (ItemOverlay.Show, which draws the book, is in api_menus.lua.)
+do
+  local XN = rawget(_G, "XMLNode")
+  local ids
+  local function build()
+    if ids then return ids end
+    ids = {}
+    local set = XN and XN.GIANTBOOK and T.xml_entries and T.xml_entries(XN.GIANTBOOK)
+    if not set then return ids end
+    local top = 0
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if id and id > top then top = id end
+    end
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if not id and e.sourceid then top = top + 1 id = top end
+      if id and e.name and ids[e.name:lower()] == nil then ids[e.name:lower()] = id end
+    end
+    return ids
+  end
+  T.static(Isaac, "Isaac", "GetGiantBookIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetGiantBookIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    return build()[name:lower()] or -1
+  end)
+end
