@@ -0,0 +1,117 @@
+-- lab_stageapi_probe.lua (development only; ISAAC_RGON_LAB=lab_stageapi_probe.lua, StageAPI batch)
+-- Measures where the Room and RoomDescriptor fields Custom Stage API needs are in THIS build: snapshots Room words
+-- in a plain room (Basement) and after the game changes stage (Flooded Caves has water, Mines has rails), then
+-- logs what differs. "lab_stageapi_probe: ..." lines.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab stageapi probe", 1)
+local function say(s) B.log("lab_stageapi_probe: " .. s) end
+local LO, HI = 0x7000, 0x7900
+local snaps = {}
+local step, wait = 0, 0
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local function room_ptr() return B.ptr(Game():GetRoom()) end
+local function desc_dump(tag)
+  local d = B.ptr(Game():GetLevel():GetCurrentRoomDesc())
+  say(string.format("%s: RoomDescriptor at %08x", tag, d))
+  for o = 0, 0xc0, 4 do
+    if o % 16 == 0 then
+      say(string.format("%s: desc +%02x: %08x %08x %08x %08x", tag, o, r32(d + o), r32(d + o + 4), r32(d + o + 8), r32(d + o + 12)))
+    end
+  end
+  -- the three vectors: begin, end, cap
+  for _, o in ipairs({ 0x68, 0x74, 0x88 }) do
+    say(string.format("%s: vector at desc+%02x: begin %08x end %08x cap %08x", tag, o, r32(d + o), r32(d + o + 4), r32(d + o + 8)))
+  end
+end
+local function room_dump(tag)
+  local a = room_ptr()
+  say(string.format("%s: room at %08x, type %d, backdrop (game) %d, grid %dx%d", tag, a, Game():GetRoom():GetType(), Game():GetRoom():GetBackdropType(), Game():GetRoom():GetGridWidth(), Game():GetRoom():GetGridHeight()))
+  -- words equal to the backdrop id near the Backdrop struct (REPENTOGON +0x1bc8)
+  local bd = Game():GetRoom():GetBackdropType()
+  for o = 0x1b00, 0x1d00, 4 do
+    if ri32(a + o) == bd then say(string.format("%s: backdrop id %d at room+%04x", tag, bd, o)) end
+  end
+  say(string.format("%s: room+1d18 = %d (backdrop %d)", tag, ri32(a + 0x1d18), bd))
+  say(string.format("%s: type of Room.GetRail: %s", tag, type(Room.GetRail)))
+  local hex = {}
+  for o = 0x7460, 0x74f8 do hex[#hex + 1] = string.format("%02x", r8(a + o)) end
+  say(tag .. ": room+7460.. " .. table.concat(hex, " "))
+  return a
+end
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  local lvl = Game():GetLevel()
+  say(string.format("new room idx %d stage %d type %d", lvl:GetCurrentRoomIndex(), lvl:GetStage(), lvl:GetStageType()))
+  if step == 0 then
+    step = 1
+    wait = 0
+    local a = room_dump("A")
+    snaps.A = snap(a)
+    desc_dump("A")
+  elseif step == 2 then
+    step = 3
+    wait = 0
+  elseif step == 4 then
+    step = 5
+    wait = 0
+  end
+end)
+local function diff(name, s1, s2, a)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    if s1[o] ~= s2[o] then
+      n = n + 1
+      if n <= 120 then say(string.format("%s +%04x %08x -> %08x (f %g -> %g)", name, o, s1[o], s2[o], B.i2f(s1[o]), B.i2f(s2[o]))) end
+    end
+  end
+  say(string.format("%s: %d word(s) differ", name, n))
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  wait = wait + 1
+  if step == 1 and wait == 30 then
+    say("going to Flooded Caves")
+    step, wait = 2, 0
+    Isaac.ExecuteCommand("stage 3b")
+  elseif step == 3 and wait == 30 then
+    local a = room_dump("B")
+    snaps.B = snap(a)
+    diff("A->B (basement -> flooded caves)", snaps.A, snaps.B, a)
+    desc_dump("B")
+    -- candidate water amount floats: 1.0 in B, 0 in A
+    for o = LO, HI - 4, 4 do
+      if snaps.A[o] == 0 and snaps.B[o] == 0x3f800000 then say(string.format("water amount candidate +%04x", o)) end
+    end
+    say("going to Mines")
+    step, wait = 4, 0
+    Isaac.ExecuteCommand("stage 3c")
+  elseif step == 5 and wait == 30 then
+    local a = room_dump("C")
+    snaps.C = snap(a)
+    -- rails: byte arrays of 0xff / small values; count bytes != 0 and != 0xff in the region
+    local n = 0
+    for o = LO, HI - 1 do
+      local v = r8(a + o)
+      if v ~= 0 and v ~= 0xff then n = n + 1 end
+    end
+    say("C: bytes neither 0 nor 0xff in the scanned part: " .. n)
+    -- look for a 0xff-filled run of 0x1c0 bytes (the rail grid)
+    local run, start = 0, nil
+    for o = 0x7100, 0x7900 do
+      if r8(a + o) == 0xff then
+        run = run + 1
+        if run == 1 then start = o end
+        if run == 100 then say(string.format("C: 0xff run from room+%04x", start)) end
+      else
+        if run >= 100 then say(string.format("C: 0xff run ended at room+%04x (%d bytes)", o, run)) end
+        run = 0
+      end
+    end
+    step = 6
+    say("done")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_shot.lua b/scripts/recomp/rgon/lab_stageapi_shot.lua
