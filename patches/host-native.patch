diff --git a/scripts/recomp/rgon/api_familiar.lua b/scripts/recomp/rgon/api_familiar.lua
new file mode 100644
index 0000000..893760b
--- /dev/null
+++ b/scripts/recomp/rgon/api_familiar.lua
@@ -0,0 +1,160 @@
+-- api_familiar.lua -- EntityFamiliar:GetWeapon() and Entity:CopyStatusEffects(), written against REPENTOGON's
+-- behaviour (LuaEntityFamiliar.cpp, LuaEntity.cpp); every offset measured in THIS executable (v1.9.7.17).
+--
+--   EntityFamiliar weapon   REPENTOGON 0xdb0   here 0xdc4 (+0x14): lab_familiar_probe scanned a familiar's words for
+--       a pointer whose target's +4 (the Weapon's owner) is the familiar itself. Only Incubus (variant 80), Twisted
+--       Pair (235) and one more (76) hold one (type 1, tears, max fire delay 10); Brother Bobby, Little Steven and
+--       the 25 others tried hold 0 there, which is also REPENTOGON's "nil for a familiar without a weapon".
+--   Entity:CopyStatusEffects  the game has its own copy (0x006a8a20, `ret`, no arguments) that copies one entity's
+--       status block to its child chain (+0x3c0). It copies exactly the fields below and masks the 64-bit flags
+--       word (+0x168/+0x16c) with 0x015d8000:21001fe0 (the status bits); its offsets all agree with the ones in
+--       api_objects.lua. The boss cooldown (+0x238) is copied only when both ends are a "boss" for the game's
+--       own test (vtable slot 0x4c, or a player when the game mode word at game+0x26614 is >= 2).
+--       The colour-params vector is at +0x1ac (begin, end, capacity), 0x3c-byte entries as in REPENTOGON:
+--       priority (255), 0x2c bytes of colour, durations at +0x30/+0x34, fadeout byte +0x38, shared byte +0x39
+--       (lab_familiar_probe: a fly with burn, poison, slow, fear, freeze and charm held 4 entries, each priority 255,
+--       durations 100, shared 1).
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call
+local type, error, select = type, error, select
+
+------------------------------------------------------------------------------
+-- EntityFamiliar:GetWeapon() -> Weapon or nil
+------------------------------------------------------------------------------
+method("EntityFamiliar", "GetWeapon", function(self)
+  local p = this(self, "GetWeapon")
+  return T.Weapon.new(r32(p + 0xdc4))
+end)
+
+------------------------------------------------------------------------------
+-- EntityFamiliar:TryAimAtMarkedTarget(aimDirection = Vector(0, 0), direction = -1, targetPos = Vector(0, 0))
+------------------------------------------------------------------------------
+-- The game's Entity_Familiar::TryAimAtMarkedTarget is 0x006146e0 (`ret 0xc`: aim Vector*, int*, target Vector*;
+-- returns a bool in al; the three outputs are written only on success, except that without a marked target it zeroes
+-- the target buffer). Epiphany asks with no arguments on every update of every familiar that has a weapon, which is
+-- how this name showed up once GetWeapon worked. Like REPENTOGON: with exactly two arguments given it
+-- answers the target position or nil; otherwise it answers success and { aimDirection, direction, targetPos }.
+do
+  local function vec_arg(v, n)
+    if type(v) == "userdata" then return v.X, v.Y end
+    return 0, 0
+  end
+  method("EntityFamiliar", "TryAimAtMarkedTarget", function(self, ...)
+    local p = this(self, "TryAimAtMarkedTarget")
+    local nargs = select("#", ...)
+    local aim, direction, target = ...
+    local ax, ay = vec_arg(aim, 1)
+    local tx, ty = vec_arg(target, 3)
+    if direction ~= nil and math.type(direction) ~= "integer" then
+      if type(direction) == "number" and direction == math.floor(direction) then direction = math.tointeger(direction)
+      else error("bad argument #2 to 'TryAimAtMarkedTarget' (number expected, got " .. type(direction) .. ")", 2) end
+    end
+    local buf = B.alloc(24)
+    wf32(buf, ax) wf32(buf + 4, ay)
+    w32(buf + 8, (direction or -1) & 0xffffffff)
+    wf32(buf + 12, tx) wf32(buf + 16, ty)
+    local ok = (call(0x006146e0, p, buf, buf + 8, buf + 12) & 0xff) ~= 0
+    local aimv, dir, tpos = Vector(rf32(buf), rf32(buf + 4)), ri32(buf + 8), Vector(rf32(buf + 12), rf32(buf + 16))
+    B.free(buf)
+    if nargs == 2 then          -- REPENTOGON: exactly two arguments given answers just the target position
+      if ok then return tpos end
+      return nil
+    end
+    if ok then return true, { aimv, dir, tpos } end
+    return false, { aimv, dir, tpos }
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Entity:CopyStatusEffects(target = nil, overwrite = false)
+------------------------------------------------------------------------------
+-- target given: copy this entity's status effects to it; nil: to every child (the chain at +0x3c0).
+-- overwrite false (REPENTOGON's default): a countdown is copied only when this entity's is not 0, status flags are
+-- added; overwrite true: the target's status flags are replaced and every countdown is copied as it is.
+do
+  local COUNTDOWNS = { 0x218, 0x21c, 0x220, 0x224, 0x228, 0x22c, 0x230, 0x234, 0x2e8, 0x23c, 0x320, 0x324,
+    0x2f0, 0x2f4, 0x2f8, 0x300, 0x2fc, 0x304, 0x3b4, 0x3b8 }
+  local MASK_LO, MASK_HI = 0x21001fe0, 0x015d8000
+  local COLOR_SIZE = 0x3c
+
+  -- the game's "counts as a boss" test for the cooldown
+  local function bossish(p)
+    local f = r32(r32(p) + 0x4c)
+    if (call(f, p) & 0xff) ~= 0 then return true end
+    local game = r32(0x00c71678)
+    return game ~= 0 and ri32(game + 0x26614) >= 2 and ri32(p + 0x28) == 1
+  end
+
+  local function shared(e) return r32(e) == 255 and r8(e + 0x38) == 0 and r8(e + 0x39) ~= 0 end
+
+  local function push_color(v, src)
+    local first, last, cap = r32(v), r32(v + 4), r32(v + 8)
+    if last + COLOR_SIZE > cap then
+      local n = (last - first) // COLOR_SIZE
+      local count = n * 2 + 2
+      local new = B.alloc(COLOR_SIZE * count)
+      if new == 0 then error("rgon: out of memory growing a colour list", 3) end
+      for o = 0, n * COLOR_SIZE - 4, 4 do w32(new + o, r32(first + o)) end
+      if first ~= 0 then B.free(first) end
+      first, last, cap = new, new + n * COLOR_SIZE, new + COLOR_SIZE * count
+      w32(v, first) w32(v + 8, cap)
+    end
+    for o = 0, COLOR_SIZE - 4, 4 do w32(last + o, r32(src + o)) end
+    w32(v + 4, last + COLOR_SIZE)
+  end
+
+  local function copy(s, d, overwrite)
+    if s == d then return end
+    local slo, shi = r32(s + 0x168), r32(s + 0x16c)
+    local dlo, dhi = r32(d + 0x168), r32(d + 0x16c)
+    if overwrite then
+      w32(d + 0x168, (dlo & ~MASK_LO & 0xffffffff) | (slo & MASK_LO))
+      w32(d + 0x16c, (dhi & ~MASK_HI & 0xffffffff) | (shi & MASK_HI))
+      for _, o in ipairs(COUNTDOWNS) do w32(d + o, r32(s + o)) end
+      w32(d + 0x308, r32(s + 0x308)) w32(d + 0x30c, r32(s + 0x30c))
+    else
+      w32(d + 0x168, dlo | (slo & MASK_LO))
+      w32(d + 0x16c, dhi | (shi & MASK_HI))
+      for _, o in ipairs(COUNTDOWNS) do
+        local v = r32(s + o)
+        if v ~= 0 then w32(d + o, v) end
+      end
+      if r32(s + 0x308) ~= 0 or r32(s + 0x30c) ~= 0 then w32(d + 0x308, r32(s + 0x308)) w32(d + 0x30c, r32(s + 0x30c)) end
+    end
+    if bossish(s) and bossish(d) then
+      local sc, dc = ri32(s + 0x238), ri32(d + 0x238)
+      local v = overwrite and sc or (sc > dc and sc or dc)
+      w32(d + 0x238, v & 0xffffffff)
+    end
+    if overwrite then          -- retire the target's shared colours (duration 2 := 1, as REPENTOGON does)
+      for e = r32(d + 0x1ac), r32(d + 0x1b0) - COLOR_SIZE, COLOR_SIZE do
+        if shared(e) then w32(e + 0x34, 1) end
+      end
+    end
+    -- snapshot the source's shared colours first: the source and target vectors are different, but pushing may move memory
+    local first, last = r32(s + 0x1ac), r32(s + 0x1b0)
+    for e = first, last - COLOR_SIZE, COLOR_SIZE do
+      if shared(e) then push_color(d + 0x1ac, e) end
+    end
+  end
+
+  method("Entity", "CopyStatusEffects", function(self, target, overwrite)
+    local s = this(self, "CopyStatusEffects")
+    if overwrite ~= nil and type(overwrite) ~= "boolean" then
+      error("bad argument #3 to 'CopyStatusEffects' (boolean expected, got " .. type(overwrite) .. ")", 2)
+    end
+    overwrite = overwrite == true
+    if target == nil then
+      local child = r32(s + 0x3c0)
+      while child ~= 0 do
+        copy(s, child, overwrite)
+        child = r32(child + 0x3c0)
+      end
+      return
+    end
+    local d = ptr(target)
+    if d == 0 then error("bad argument #2 to 'CopyStatusEffects' (Entity expected, got " .. type(target) .. ")", 2) end
+    copy(s, d, overwrite)
+  end)
+end
diff --git a/scripts/recomp/rgon/api_framectx.lua b/scripts/recomp/rgon/api_framectx.lua
new file mode 100644
index 0000000..0a20798
--- /dev/null
+++ b/scripts/recomp/rgon/api_framectx.lua
@@ -0,0 +1,41 @@
+-- api_framectx.lua -- where the player is, for reading the host's "[mac][frame]" timing lines (scripts/mac/framestats.py).
+-- Vanilla API only; nothing here is a REPENTOGON name, so nothing is registered as Implemented.
+--   "[isaac][rgon] level: stage S type T (name) frame F"            on every new level
+--   "[isaac][rgon] room: stage S type T (name) room I roomtype R entities N frame F"   on every new room
+--   "[isaac][rgon] ents N room I frame F"                            every ISAAC_MAC_STATS_EVERY (600) updates
+-- Cost: one Isaac.GetRoomEntities() per room entry and per 600 updates (a table of the room's entities), nothing per frame.
+local T = ...
+local B = T.B
+if B.env("ISAAC_FRAMECTX") == "0" then return end   -- A/B switch for measuring the overhead
+local game = Game
+local every = tonumber(B.env("ISAAC_MAC_STATS_EVERY")) or 600
+if every <= 0 then every = 600 end
+
+local function count()
+  local ok, list = pcall(Isaac.GetRoomEntities)
+  return ok and type(list) == "table" and #list or -1
+end
+
+local function place()
+  local g = game()
+  local level = g:GetLevel()
+  return level:GetStage(), level:GetStageType(), level:GetName(), level:GetCurrentRoomIndex(), g:GetRoom():GetType()
+end
+
+local mod = { Name = "REPENTOGON framectx" }
+local updates = 0
+Isaac.AddCallback(mod, ModCallbacks.MC_POST_NEW_LEVEL, function()
+  local s, t, name = place()
+  B.log(string.format("level: stage %d type %d (%s) frame %d", s, t, name, Isaac.GetFrameCount()))
+end)
+Isaac.AddCallback(mod, ModCallbacks.MC_POST_NEW_ROOM, function()
+  local s, t, name, idx, rt = place()
+  B.log(string.format("room: stage %d type %d (%s) room %d roomtype %d entities %d frame %d",
+    s, t, name, idx, rt, count(), Isaac.GetFrameCount()))
+end)
+Isaac.AddCallback(mod, ModCallbacks.MC_POST_UPDATE, function()
+  updates = updates + 1
+  if updates % every == 0 then
+    B.log(string.format("ents %d room %d frame %d", count(), game():GetLevel():GetCurrentRoomIndex(), Isaac.GetFrameCount()))
+  end
+end)
diff --git a/scripts/recomp/rgon/api_game_misc.lua b/scripts/recomp/rgon/api_game_misc.lua
new file mode 100644
index 0000000..a658de1
--- /dev/null
+++ b/scripts/recomp/rgon/api_game_misc.lua
@@ -0,0 +1,433 @@
+-- api_game_misc.lua -- chunk 7: Game, Isaac and miscellaneous globals (REPENTOGON names that Fiend Folio and Epiphany use).
+-- Written against REPENTOGON's behaviour (LuaGame.cpp, LuaRNG.cpp, LuaIsaac.cpp, LuaBossPool.cpp, LuaItemOverlay.cpp,
+-- LuaMusicManager.cpp); every address and offset below was found in THIS executable (v1.9.7.17) and read back by
+-- lab_game_misc.lua. REPENTOGON's own offsets are for v1.9.7.12 and several moved.
+--
+-- Game object (pointer in the word at 0x00c71678). Fields, REPENTOGON's offset -> here:
+--   debug flags        0x25abc -> 0x26544  (api_more.lua)       is rerun (byte)    0x25b00 -> 0x26588 (the reset clears the
+--   colour modifier    current 0x66920 -> 0x676b8, target 0x676d0, lerp step 0x676e8, "lerping" byte 0x676b4: all written
+--                      by Game::SetColorModifier below (a colour is six floats R G B A brightness contrast)
+--   dizzy              intensity 0x67738, target 0x6773c, speed 0x67740 (the reset stores 0.001 = 0x3a83126f in the last,
+--                      the screen-effect update moves the first towards the second by the third)
+--   erased enemies     vector of {type, variant, subtype} (12 bytes) at 0x6774c / 0x67750 (begin / end)
+-- Game functions:
+--   0x007067c0  Game::SetColorModifier(ColorModState*, bool lerp)  thiscall (ecx unused), rate in xmm3, `ret 8`
+--   0x00705480  Game::DevolveEnemy(Entity*, int* unused)           static, `ret 8`
+--   0x00707e10  Game::ChainLightning(Vector*, BitSet128 (16 bytes by value), Entity* spawner), damage in xmm2, `ret 0x18`,
+--               the effect (variant 167) in EAX; it walks the spawner to its parent player to add bonuses
+--   0x007076d0  Game::FixErasedEnemyID(int* type in ecx, int* variant in edx, int* subtype pushed), plain `ret`
+--   0x006fe3d0  Game::MoveToRandomRoom(bool errorRoom, int seed, Entity_Player*)  (the game's own Lua binding calls it;
+--               seed 0 crashes it, as REPENTOGON found, so the binding is wrapped)
+--   0x00706bc0+ RoomConfig::GetStageID(stage in ecx, type in edx, mode pushed), plain `ret`, at 0x0082d030
+--   0x0067f0d0  Isaac::RandomUnitVector(Vector* out in ecx, seed in edx), plain `ret`: one xorshift step on the seed,
+--               the angle is that number's fraction of a full turn
+-- ItemOverlay (game + 0x1c034, 0x11a4 + its mega-mush sprite): state +0, id +4, sprite (ANM2) +8, delay +0x119c, player +0x11a0,
+--   mega mush player sprite +0x11a4 (REPENTOGON's offsets from +0x1144 are all +0x58 here); Show is 0x009ad210 `ret 0xc`.
+-- Music (MusicManager's object): PlayJingle 0x007e2580 `ret 0xc`, which sets the countdown at +0x364 to 0x8c; the jingle's
+--   stream (volume +0x348, target +0x34c, playing byte +0x354) and jingle volume +0x360 are where REPENTOGON has them.
+-- BossPool (game + 0x1af70, as in REPENTOGON): 37 pools of 0x3c bytes (name std::string +0, entries vector +0x18, total weight
+--   +0x24, RNG +0x28, double trouble variant +0x38), entry 0x14 bytes (id, initial weight, weight, achievement, room variant start).
+--   _removedBosses vector<bool> at +0x8ac (begin, end, cap, bit count +0x8b8), _levelBlacklist at +0x8bc (api_hooks.lua).
+local T = ...
+local B, R, method, static, wrap, this = T.B, T.R, T.method, T.static, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, call, log = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call, B.log
+local type, error, setmetatable, getmetatable, rawget, rawset, tostring, ipairs, pairs, pcall = type, error, setmetatable, getmetatable, rawget, rawset, tostring, ipairs, pairs, pcall
+local mathtype = math.type
+
+local GAME_PTR = 0x00c71678
+
+local function argerr(n, fname, want, got)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. (got == nil and "no value" or type(got)) .. ")", 3)
+end
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  argerr(n, fname, "number", v)
+end
+local function num_arg(v, n, fname)
+  if type(v) ~= "number" then argerr(n, fname, "number", v) end
+  return v
+end
+local function signed(v) return v >= 0x80000000 and v - 0x100000000 or v end
+local function game() return r32(GAME_PTR) end
+local function opt(v) if v == nil then return nil end return v end
+
+------------------------------------------------------------------------------
+-- REPENTOGON.MeetsVersion, WeightedOutcomePicker's constructor
+------------------------------------------------------------------------------
+-- rgon.lua's R.MeetsVersion compares the numbers of "1.1.2" (REPENTOGON's also lets a letter suffix decide a tie)
+if type(R.MeetsVersion) == "function" then R.Implemented["REPENTOGON.MeetsVersion"] = true end
+if rawget(_G, "WeightedOutcomePicker") ~= nil and R.Implemented["WeightedOutcomePicker.AddOutcomeWeight"] then
+  R.Implemented["WeightedOutcomePicker.WeightedOutcomePicker"] = true
+end
+
+------------------------------------------------------------------------------
+-- RNG:RandomVector() and :PhantomVector()
+------------------------------------------------------------------------------
+-- A unit vector from the seed (Isaac::RandomUnitVector steps the seed once itself), then RandomVector moves the generator
+-- on once and PhantomVector leaves it alone.
+do
+  local function unit(rng, name)
+    local p = ptr(rng)
+    if p == 0 then error("rgon: " .. name .. " called without its object (use ':')", 3) end
+    local seed = r32(p)
+    if seed == 0 then error("rgon: " .. name .. ": the RNG's seed is zero", 3) end
+    local out = B.alloc(8)
+    call(0x0067f0d0, { ecx = out, edx = seed })
+    local x, y = rf32(out), rf32(out + 4)
+    B.free(out)
+    return Vector(x, y)
+  end
+  method("RNG", "RandomVector", function(self)
+    local v = unit(self, "RandomVector")
+    self:Next()
+    return v
+  end)
+  method("RNG", "PhantomVector", function(self) return unit(self, "PhantomVector") end)
+end
+
+------------------------------------------------------------------------------
+-- Game: fields
+------------------------------------------------------------------------------
+local DEBUG_FLAGS, IS_RERUN = 0x26544, 0x26588
+local DIZZY, DIZZY_TARGET = 0x67738, 0x6773c
+local COLOR_LERPING, COLOR_CUR, COLOR_TARGET, COLOR_STEP = 0x676b4, 0x676b8, 0x676d0, 0x676e8
+local ERASED_BEGIN, ERASED_END = 0x6774c, 0x67750
+
+method("Game", "AddDebugFlags", function(self, flags)
+  local g = this(self, "AddDebugFlags")
+  w32(g + DEBUG_FLAGS, r32(g + DEBUG_FLAGS) | (int_arg(flags, 1, "AddDebugFlags") & 0xffffffff))
+end)
+method("Game", "IsRerun", function(self) return r8(this(self, "IsRerun") + IS_RERUN) ~= 0 end)
+method("Game", "GetDizzyAmount", function(self) return rf32(this(self, "GetDizzyAmount") + DIZZY) end)
+method("Game", "SetDizzyAmount", function(self, target, current)
+  local g = this(self, "SetDizzyAmount")
+  num_arg(target, 1, "SetDizzyAmount")
+  if current == nil then current = rf32(g + DIZZY) else num_arg(current, 2, "SetDizzyAmount") end
+  wf32(g + DIZZY_TARGET, target)
+  wf32(g + DIZZY, current)
+end)
+
+-- Game:IsErased(entity) / IsErased(type, variant = -1, subtype = -1): the game's list of erased enemies (a mod's Erase effect),
+-- after the game's own id fix-up (a few entity types stand for another)
+method("Game", "IsErased", function(self, a, b, c)
+  local g = this(self, "IsErased")
+  local type_, variant, subtype
+  if type(a) == "userdata" then
+    type_, variant, subtype = a.Type, a.Variant, a.SubType
+  else
+    type_ = int_arg(a, 1, "IsErased")
+    variant = b == nil and -1 or int_arg(b, 2, "IsErased")
+    subtype = c == nil and -1 or int_arg(c, 3, "IsErased")
+  end
+  local buf = B.alloc(12)
+  w32(buf, type_ & 0xffffffff) w32(buf + 4, variant & 0xffffffff) w32(buf + 8, subtype & 0xffffffff)
+  call(0x007076d0, { ecx = buf, edx = buf + 4 }, buf + 8)
+  local t, v, s = ri32(buf), ri32(buf + 4), ri32(buf + 8)
+  B.free(buf)
+  local a0, e = r32(g + ERASED_BEGIN), r32(g + ERASED_END)
+  while a0 ~= 0 and a0 < e do
+    if ri32(a0) == t then
+      if v == -1 then return true end
+      if ri32(a0 + 4) == v then
+        if s == -1 then return true end
+        return ri32(a0 + 8) == s
+      end
+    end
+    a0 = a0 + 12
+  end
+  return false
+end)
+
+------------------------------------------------------------------------------
+-- Game: the colour correction (replaces api_menus.lua's old stand-ins, which kept the colour in Lua)
+------------------------------------------------------------------------------
+do
+  local function cm_read(a)
+    return T.ColorModifier.new(rf32(a), rf32(a + 4), rf32(a + 8), rf32(a + 12), rf32(a + 16), rf32(a + 20))
+  end
+  method("Game", "GetCurrentColorModifier", function(self) return cm_read(this(self, "GetCurrentColorModifier") + COLOR_CUR) end)
+  method("Game", "GetTargetColorModifier", function(self) return cm_read(this(self, "GetTargetColorModifier") + COLOR_TARGET) end)
+  method("Game", "GetLerpColorModifier", function(self) return cm_read(this(self, "GetLerpColorModifier") + COLOR_STEP) end)
+  method("Game", "SetColorModifier", function(self, c, lerp, rate)
+    this(self, "SetColorModifier")
+    if not T.ColorModifier.is(c) then argerr(1, "SetColorModifier", "ColorModifier", c) end
+    if lerp == nil then lerp = true end
+    if rate == nil then rate = 0.015 else num_arg(rate, 3, "SetColorModifier") end
+    local buf = B.alloc(24)
+    wf32(buf, c.R) wf32(buf + 4, c.G) wf32(buf + 8, c.B) wf32(buf + 12, c.A) wf32(buf + 16, c.Brightness) wf32(buf + 20, c.Contrast)
+    call(0x007067c0, { ecx = game(), xmm3 = rate }, buf, lerp and 1 or 0)
+    B.free(buf)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Game: the game's own functions
+------------------------------------------------------------------------------
+method("Game", "DevolveEnemy", function(self, ent)
+  this(self, "DevolveEnemy")
+  if type(ent) ~= "userdata" or ptr(ent) == 0 then argerr(1, "DevolveEnemy", "Entity", ent) end
+  call(0x00705480, nil, ptr(ent), 0)
+end)
+
+-- Game:ChainLightning(position, baseDamage = 3.5, tearFlags = BitSet128(0, 0), spawner = nil) -> EntityEffect
+method("Game", "ChainLightning", function(self, pos, damage, flags, spawner)
+  this(self, "ChainLightning")
+  if type(pos) ~= "userdata" or pos.X == nil then argerr(1, "ChainLightning", "Vector", pos) end
+  damage = damage == nil and 3.5 or num_arg(damage, 2, "ChainLightning")
+  local lo, hi = 0, 0
+  if flags ~= nil then
+    local ok, l, h = pcall(function() return flags.l, flags.h end)
+    if not ok or mathtype(l) ~= "integer" or mathtype(h) ~= "integer" then argerr(3, "ChainLightning", "BitSet128", flags) end
+    lo, hi = l, h
+  end
+  local sp = 0
+  if spawner ~= nil then
+    if type(spawner) ~= "userdata" then argerr(4, "ChainLightning", "Entity", spawner) end
+    sp = ptr(spawner)
+  end
+  local eax = call(0x00707e10, { xmm2 = damage }, ptr(pos), lo & 0xffffffff, (lo >> 32) & 0xffffffff, hi & 0xffffffff, (hi >> 32) & 0xffffffff, sp)
+  return wrap("EntityEffect", eax)
+end)
+
+-- the game's own binding (seed 0 is a fatal error inside it): REPENTOGON refuses a zero seed with an error
+do
+  local c = T.class_tables("Game")
+  local orig = rawget(c, "MoveToRandomRoom")
+  if orig ~= nil and not R.Implemented["Game.MoveToRandomRoom"] then
+    local wrapped = B.cfn(function(self, errorRoom, seed, player)
+      if mathtype(seed) == "float" and seed == seed // 1 then seed = math.tointeger(seed) end
+      if mathtype(seed) ~= "integer" then argerr(2, "MoveToRandomRoom", "number", seed) end
+      if seed == 0 then error("The given seed is not valid", 2) end
+      return orig(self, errorRoom, seed, player)
+    end)
+    rawset(c, "MoveToRandomRoom", wrapped)
+    local _, const = T.class_tables("Game")
+    if const and const ~= c and rawget(const, "MoveToRandomRoom") == orig then rawset(const, "MoveToRandomRoom", wrapped) end
+    R.Implemented["Game.MoveToRandomRoom"] = true
+  end
+end
+
+------------------------------------------------------------------------------
+-- Isaac
+------------------------------------------------------------------------------
+-- Isaac.GetCurrentStageConfigId() -> the stages.xml row of the floor the player is on
+static(Isaac, "Isaac", "GetCurrentStageConfigId", function()
+  local lvl = Game():GetLevel()
+  return signed(call(0x0082d030, { ecx = lvl:GetStage(), edx = lvl:GetStageType() }, 0xffffffff))
+end)
+
+-- Isaac.RenderToWorld(position): REPENTOGON's arithmetic, from the screen size, the screen shake and the room's scroll offset
+-- (the world viewport is 338 x 182 at (60, 140), drawn at 0.65)
+static(Isaac, "Isaac", "RenderToWorld", function(pos)
+  if type(pos) ~= "userdata" or pos.X == nil then argerr(1, "RenderToWorld", "Vector", pos) end
+  local room = Game():GetRoom()
+  local gp, rp = game(), ptr(room)
+  local scroll = Vector(rf32(rp + 0x1204), rf32(rp + 0x1208))
+  local off = Vector(rf32(gp + 0x26508), rf32(gp + 0x2650c)) + scroll
+  local screen = Vector(Isaac.GetScreenWidth(), Isaac.GetScreenHeight())
+  local top_left = (screen - Vector(338, 182)) * 0.5
+  local local_pos = (pos - off) - top_left
+  return local_pos / 0.65 + Vector(60, 140)
+end)
+
+-- Isaac.AllTaintedCompletion(playerType, group = 0) -> the lowest mark (0..2) over the six marks of the group (0 both, 1 duet,
+-- 2 quartet), from Isaac.GetCompletionMark (api_misc.lua: the game's own characters answer 0 there)
+do
+  local CT = rawget(_G, "CompletionType")
+  if type(CT) == "table" and type(Isaac.GetCompletionMark) == "function" then
+    local GROUPS = {
+      [0] = { CT.ISAAC, CT.SATAN, CT.LAMB, CT.BLUE_BABY, CT.HUSH, CT.BOSS_RUSH },
+      [1] = { CT.HUSH, CT.BOSS_RUSH, CT.BOSS_RUSH, CT.BOSS_RUSH, CT.BOSS_RUSH, CT.BOSS_RUSH },
+      [2] = { CT.ISAAC, CT.SATAN, CT.LAMB, CT.BLUE_BABY, CT.BLUE_BABY, CT.BLUE_BABY },
+    }
+    static(Isaac, "Isaac", "AllTaintedCompletion", function(playerType, group)
+      playerType = int_arg(playerType, 1, "AllTaintedCompletion")
+      group = int_arg(group == nil and 0 or group, 2, "AllTaintedCompletion")
+      local g = GROUPS[group] or GROUPS[0]
+      local low = 2
+      for i = 1, 6 do
+        local m = Isaac.GetCompletionMark(playerType, g[i])
+        if m < low then low = m end
+      end
+      return low
+    end)
+  end
+end
+
+-- Challenge completion. The game's own challenges (1 to 45) are the byte array at PersistentGameData + 0xe6f (g_Manager + 0x14),
+-- written by PersistentGameData::AddChallenge (0x0092a7b0, thiscall, `ret 4`, which also unlocks what the challenge awards).
+-- A mod's challenge has no byte there: its completion is a line in the layer's save file, section "challenges".
+do
+  local PGD, FIRST_MOD = function() return r32(0x00c7169c) + 0x14 end, 46
+  local function id_arg(v, what)
+    v = int_arg(v, 1, what)
+    if v < 1 then error("Invalid Challenge ID (expected > 0, got " .. v .. ")", 3) end
+    return v
+  end
+  local function mod_done()
+    local done = {}
+    local text = T.store and T.store.get("challenges")
+    if text then for id in text:gmatch("(%d+)") do done[tonumber(id)] = true end end
+    return done
+  end
+  local function save_mod(done)
+    local ids = {}
+    for id in pairs(done) do ids[#ids + 1] = id end
+    table.sort(ids)
+    local lines = {}
+    for i, id in ipairs(ids) do lines[i] = tostring(id) end
+    T.store.set("challenges", table.concat(lines, "\n"))
+  end
+  local function is_done(id)
+    if id < FIRST_MOD then return r8(PGD() + 0xe6f + id) ~= 0 end
+    return mod_done()[id] == true
+  end
+  local function set_done(id, value)
+    if id < FIRST_MOD then
+      if value then call(0x0092a7b0, PGD(), id) else w8(PGD() + 0xe6f + id, 0) end
+    else
+      local done = mod_done()
+      done[id] = value or nil
+      save_mod(done)
+    end
+  end
+  static(Isaac, "Isaac", "IsChallengeDone", function(id) return is_done(id_arg(id, "IsChallengeDone")) end)
+  static(Isaac, "Isaac", "ClearChallenge", function(id) set_done(id_arg(id, "ClearChallenge"), true) end)
+  static(Isaac, "Isaac", "UnClearChallenge", function(id) set_done(id_arg(id, "UnClearChallenge"), false) end)
+  static(Isaac, "Isaac", "SetChallengeCompletion", function(id, done)
+    id = id_arg(id, "SetChallengeCompletion")
+    if type(done) ~= "boolean" then argerr(2, "SetChallengeCompletion", "boolean", done) end
+    set_done(id, done)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- ItemOverlay (a table of functions, as REPENTOGON's; replaces api_menus.lua's old stand-in)
+------------------------------------------------------------------------------
+do
+  local IO_OFF, ID, SPRITE, DELAY, PLAYER, MEGA = 0x1c034, 4, 8, 0x119c, 0x11a0, 0x11a4
+  local function overlay(what)
+    local g = game()
+    if g == 0 then error("rgon: " .. what .. " used with no game", 3) end
+    return g + IO_OFF
+  end
+  local IO = {}
+  function IO.Show(id, delay, player)
+    local o = overlay("ItemOverlay.Show")
+    id = int_arg(id, 1, "Show")
+    delay = delay == nil and 0 or int_arg(delay, 2, "Show")
+    local pp = 0
+    if player ~= nil then
+      if type(player) ~= "userdata" or ptr(player) == 0 then argerr(3, "Show", "EntityPlayer", player) end
+      pp = ptr(player)
+    end
+    -- the game ignores ids past 0x2f (the giant book table's size)
+    call(0x009ad210, o, id & 0xffffffff, delay & 0xffffffff, pp)
+  end
+  function IO.GetOverlayID() return ri32(overlay("ItemOverlay.GetOverlayID") + ID) end
+  function IO.GetDelay() return ri32(overlay("ItemOverlay.GetDelay") + DELAY) end
+  function IO.GetSprite() return wrap("Sprite", overlay("ItemOverlay.GetSprite") + SPRITE) end
+  function IO.GetMegaMushPlayerSprite() return wrap("Sprite", overlay("ItemOverlay.GetMegaMushPlayerSprite") + MEGA) end
+  function IO.GetPlayer()
+    local p = r32(overlay("ItemOverlay.GetPlayer") + PLAYER)
+    if p == 0 then return nil end
+    return wrap("EntityPlayer", p)
+  end
+  if rawget(_G, "ItemOverlay") == nil then
+    rawset(_G, "ItemOverlay", IO)
+    for k in pairs(IO) do R.Implemented["ItemOverlay." .. k] = true end
+  else
+    log("api_game_misc: a global ItemOverlay exists already; the layer's is not installed")
+  end
+end
+
+------------------------------------------------------------------------------
+-- MusicManager:PlayJingle(id, duration = 140) / StopJingle()
+------------------------------------------------------------------------------
+do
+  local JINGLE_ID, STREAM_VOL, STREAM_TARGET, STREAM_PLAYING, JINGLE_VOL, COUNTDOWN = 0x32a, 0x348, 0x34c, 0x354, 0x360, 0x364
+  method("MusicManager", "PlayJingle", function(self, id, duration)
+    local m = this(self, "PlayJingle")
+    id = int_arg(id, 1, "PlayJingle")
+    duration = duration == nil and 140 or int_arg(duration, 2, "PlayJingle")
+    if duration <= 0 then error("bad argument #2 to 'PlayJingle' (Duration must be greater than zero!)", 2) end
+    call(0x007e2580, m, id & 0xffffffff, 140, 0)
+    w32(m + COUNTDOWN, duration)
+    B.w16(m + JINGLE_ID, id & 0xffff)
+  end)
+  method("MusicManager", "StopJingle", function(self)
+    local m = this(self, "StopJingle")
+    if ri32(m + COUNTDOWN) > 0 or r8(m + STREAM_PLAYING) ~= 0 then
+      w32(m + STREAM_VOL, 0) w32(m + STREAM_TARGET, 0) w8(m + STREAM_PLAYING, 0) wf32(m + JINGLE_VOL, 0) w32(m + COUNTDOWN, 0)
+    end
+  end)
+end
+
+------------------------------------------------------------------------------
+-- BossPoolManager / BossPool
+------------------------------------------------------------------------------
+-- The game's pools (game + 0x1af70). A pool is a Lua object (class "BossPool") that reads the game's memory on each call.
+do
+  local POOLS, POOL_SIZE, N_POOLS, ENTRY = 0x1af70, 0x3c, 37, 0x14
+  local REMOVED, BLACKLIST = 0x8ac, 0x8bc
+  local Pool = {}
+  Pool.__index = Pool
+  Pool.__type = "BossPool"
+  Pool.__name = "BossPool"
+  Pool.__eq = function(a, b) return type(b) == "table" and a[1] == b[1] end
+  local function std_string(a) return B.stdstr(a) end
+  local function pool_addr(self, what)
+    if getmetatable(self) ~= Pool then error("bad argument #1 to '" .. what .. "' (BossPool expected, got " .. type(self) .. ")", 3) end
+    return self[1]
+  end
+  function Pool.GetName(self) return std_string(pool_addr(self, "GetName")) end
+  function Pool.GetEntries(self)
+    local a = pool_addr(self, "GetEntries")
+    local b, e = r32(a + 0x18), r32(a + 0x1c)
+    local out = {}
+    if b ~= 0 and e >= b then
+      for i = 0, (e - b) // ENTRY - 1 do
+        local x = b + i * ENTRY
+        local w = rf32(x + 8)
+        out[i + 1] = { bossID = ri32(x), initialWeight = rf32(x + 4), weight = w, weightAlt = w, achievementID = ri32(x + 0xc) }
+      end
+    end
+    return out
+  end
+  function Pool.GetWeight(self) return rf32(pool_addr(self, "GetWeight") + 0x24) end
+  function Pool.GetRNG(self) return wrap("RNG", pool_addr(self, "GetRNG") + 0x28) end
+  function Pool.GetDoubleTroubleRoomVariantStart(self) return ri32(pool_addr(self, "GetDoubleTroubleRoomVariantStart") + 0x38) end
+  Pool.GetDoubleTroubleRoomID = Pool.GetDoubleTroubleRoomVariantStart
+  rawset(_G, "BossPool", rawget(_G, "BossPool") or setmetatable({}, { __index = Pool }))
+  for k in pairs(Pool) do if k:sub(1, 2) ~= "__" then R.Implemented["BossPool." .. k] = true end end
+
+  local BP = rawget(_G, "BossPoolManager")
+  if type(BP) ~= "table" then BP = {} rawset(_G, "BossPoolManager", BP) end
+  local function bools(off)
+    local g = game()
+    local pool = g + POOLS
+    local b, e, count = r32(pool + off), r32(pool + off + 4), r32(pool + off + 0xc)
+    local out = {}
+    -- vector<bool>: `count` bits from the first word, bit 0 first; REPENTOGON hands out indexes 1 and up
+    for i = 1, count - 1 do
+      local word = r32(b + (i >> 5) * 4)
+      out[i] = (word >> (i & 31)) & 1 == 1
+    end
+    return out
+  end
+  BP.GetPool = function(stb)
+    if game() == 0 then error("rgon: BossPoolManager.GetPool used with no game", 2) end
+    if mathtype(stb) ~= "integer" then
+      if type(stb) == "number" and stb == stb // 1 then stb = math.tointeger(stb) else argerr(1, "GetPool", "number", stb) end
+    end
+    if stb < 0 or stb >= N_POOLS then error("[BossPoolManager.GetPool] : Invalid STB type!", 2) end
+    return setmetatable({ game() + POOLS + stb * POOL_SIZE }, Pool)
+  end
+  BP.GetRemovedBosses = function() return bools(REMOVED) end
+  BP.GetLevelBlacklist = function() return bools(BLACKLIST) end
+  BP.GetRemovedSpecialBosses = BP.GetLevelBlacklist
+  for _, k in ipairs({ "GetPool", "GetRemovedBosses", "GetLevelBlacklist", "GetRemovedSpecialBosses" }) do
+    R.Implemented["BossPoolManager." .. k] = true
+  end
+end
diff --git a/scripts/recomp/rgon/api_gaps.lua b/scripts/recomp/rgon/api_gaps.lua
