@@ -0,0 +1,36 @@
+-- lab_stageapi_blend.lua (development only; LAB=lab_stageapi_blend.lua)
+-- BlendMode.Flag1..Flag4, REPENTOGON's deprecated names for the four factors (StageAPI's roomgfx.lua writes them on
+-- a shadow's layer). Prints "lab_stageapi_blend: PASS/FAIL ..." and a final DONE line.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi blend", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_stageapi_blend: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+local wait, done = 0, false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  wait = wait + 1
+  if done or wait ~= 20 then return end
+  done = true
+  local e = Isaac.Spawn(5, 20, 1, Game():GetRoom():GetCenterPos(), Vector(0, 0), nil)
+  local bm = e:GetSprite():GetLayer(0):GetBlendMode()
+  check("a layer's default blend mode is NORMAL (4 reads: 1,7,1,7)", bm.Flag1 == 1 and bm.Flag2 == 7 and bm.Flag3 == 1 and bm.Flag4 == 7,
+    bm.Flag1 .. "," .. bm.Flag2 .. "," .. bm.Flag3 .. "," .. bm.Flag4)
+  check("Flag1..4 read the same words as the named factors", bm.Flag1 == bm.RGBSourceFactor and bm.Flag2 == bm.RGBDestinationFactor
+    and bm.Flag3 == bm.AlphaSourceFactor and bm.Flag4 == bm.AlphaDestinationFactor)
+  bm.Flag1 = 4 bm.Flag2 = 7 bm.Flag3 = 4 bm.Flag4 = 7                  -- what StageAPI writes (overlay)
+  local again = e:GetSprite():GetLayer(0):GetBlendMode()
+  check("the write reaches the layer (a fresh read sees it)", again.RGBSourceFactor == 4 and again.RGBDestinationFactor == 7
+    and again.AlphaSourceFactor == 4 and again.AlphaDestinationFactor == 7, tostring(again))
+  check("the equation is untouched", again.Equation == 0)
+  local ok, err = pcall(function() bm.Flag1 = 99 end)
+  check("an invalid factor is an error", not ok, err)
+  ok, err = pcall(function() bm.Flag5 = 1 end)
+  check("Flag5 is still unknown", not ok and tostring(err):find("no member named 'Flag5'") ~= nil, err)
+  check("BlendMode.Flag1 is registered", REPENTOGON.Implemented["BlendMode.Flag1"] == true)
+  say("AutocompleteType is a " .. type(rawget(_G, "AutocompleteType")) .. ", Console.RegisterCommand is a " .. type(Console and Console.RegisterCommand))
+  say(string.format("DONE: %d PASS, %d FAIL", pass, fail))
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_boss.lua b/scripts/recomp/rgon/lab_stageapi_boss.lua
