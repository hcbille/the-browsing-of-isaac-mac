+/* ---- 2b. debug knobs for a Lua heap that something else writes on --------
+ *
+ * Lua's objects share the guest arena with the game's own allocations, so a
+ * stray guest write (an overflow out of a neighbouring block, a write through
+ * a stale pointer) lands on a native 64-bit Lua header (the 2026-11-18 SIGBUS
+ * in sweeplist, a `next` of 0x0000000f00000049). All off by default:
+ *   ISAAC_LUA_REDZONE=1        every Lua block gets 32 bytes in front (links, size, magic, pattern) and 16 behind;
+ *                              a freed block is filled with 0xDD and held back (ISAAC_LUA_QUARANTINE_MB, default 48)
+ *                              until the oldest is evicted, so a write after free is found too
+ *   ISAAC_LUA_HEAPCHECK=N      every N-th lua_gc call (the game makes one a frame): check every live block's redzones,
+ *                              a slice of the quarantine, and walk Lua's own object lists (host_lua_gcstate.c)
+ *   ISAAC_LUA_HEAPCHECK_ABORT  0 = log only; default 1 = abort() after the first fault (a core to read)
+ *   ISAAC_LUA_GC_FORCE=N       every N-th lua_gc call, a whole collection first (so frees happen at once)
+ */
+#define RZ_FRONT 32u
+#define RZ_BACK  16u
+#define RZ_LIVE  0x4c5a4c56u   /* 'LZLV' */
+#define RZ_DEAD  0x4c5a4452u
+struct rz_hdr { uint32_t prev, next, size, magic, seq, pad[3]; };   /* 32 bytes, then the payload */
+static int      g_rz_on = -1;
+static uint32_t g_rz_head, g_rz_seq, g_rz_live_n;
+static uint64_t g_rz_live_bytes;
+static uint32_t *g_rz_q; static uint32_t g_rz_qcap, g_rz_qhead, g_rz_qn; static uint64_t g_rz_qbytes, g_rz_qmax;
+static unsigned g_rz_scan;                 /* where the quarantine slice scan stands */
+static int g_rz_faults;
+extern int isaac_lua_heap_walk(lua_State *L, int (*okblock)(const void *p), char *msg, unsigned msgn, unsigned long *count);
+
+static void rz_init(void) {
+    const char *e = getenv("ISAAC_LUA_REDZONE");
+    g_rz_on = (e && *e && *e != '0') ? 1 : 0;
+    if (!g_rz_on) return;
+    e = getenv("ISAAC_LUA_QUARANTINE_MB");
+    g_rz_qmax = ((e && *e) ? (uint64_t)atoi(e) : 48u) << 20;
+    g_rz_qcap = 1u << 20;
+    g_rz_q = (uint32_t *)calloc(g_rz_qcap, 4);
+    isaac_log("[isaac][luagc] ISAAC_LUA_REDZONE: Lua blocks carry redzones; quarantine %llu MB", (unsigned long long)(g_rz_qmax >> 20));
+}
+static struct rz_hdr *rz_h(uint32_t hva) { return (struct rz_hdr *)isaac_g(hva); }
+/* "what is wrong with this block", or NULL; dead = it is a freed (quarantined) one */
+static const char *rz_verify(uint32_t hva, int dead, char *why, size_t n) {
+    const struct rz_hdr *h = rz_h(hva);
+    const uint8_t *p = (const uint8_t *)h;
+    if (h->magic != (dead ? RZ_DEAD : RZ_LIVE)) { snprintf(why, n, "header magic 0x%08x (wanted 0x%08x)", h->magic, dead ? RZ_DEAD : RZ_LIVE); return why; }
+    for (unsigned i = 16; i < RZ_FRONT; ++i)
+        if (p[i] != 0xFD) { snprintf(why, n, "front redzone byte +%u is 0x%02x (written %s)", i - RZ_FRONT, p[i], "before the block"); return why; }
+    const uint8_t *pay = p + RZ_FRONT;
+    for (unsigned i = 0; i < RZ_BACK; ++i)
+        if (pay[h->size + i] != 0xFB) { snprintf(why, n, "back redzone byte +%u past the end is 0x%02x", i, pay[h->size + i]); return why; }
+    if (dead)
+        for (uint32_t i = 0; i < h->size; ++i)
+            if (pay[i] != 0xDD) { snprintf(why, n, "freed block written at +%u (0x%02x), size %u", i, pay[i], h->size); return why; }
+    return NULL;
+}
+static void rz_fault(uint32_t hva, int dead, const char *why) {
