+  try("shop", function()
+    local s = spawn(100, CollectibleType.COLLECTIBLE_SAD_ONION, 120)
+    local before = s.Price
+    s:MakeShopItem(0)
+    check("MakeShopItem sets a price", s.Price ~= 0 or s.ShopItemId ~= before, "price " .. s.Price .. " shopitem " .. s.ShopItemId)
