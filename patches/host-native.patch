+  try("lootlist", function()
+    local chest = spawn(50, 0, -160)
+    local ll = chest:GetLootList()
+    local es = ll:GetEntries()
+    check("GetLootList entries", #es >= 1, #es)
+    local e = es[1]
+    check("LootListEntry getters", math.type(e:GetType()) == "integer" and e:GetType() == 5 and math.type(e:GetVariant()) == "integer"
