+  check(base.pick:CanReroll() == true, "a fresh pedestal can be rerolled: " .. tostring(base.pick:CanReroll()))
+  check(base.pick:GetCanRerollOverride() == nil, "no override at first: " .. tostring(base.pick:GetCanRerollOverride()))
+  base.pick:SetCanRerollOverride(false)
+  check(base.pick:GetCanRerollOverride() == false, "GetCanRerollOverride after Set(false): " .. tostring(base.pick:GetCanRerollOverride()))
+  check(base.pick:CanReroll() == false, "CanReroll answers false with the override: " .. tostring(base.pick:CanReroll()))
+  -- the game's own D6 respects it
