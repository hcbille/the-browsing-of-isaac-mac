+      if g and to and g[to] then return g[to](g) or g end
+      return g
+    end
+    local function typed_entity(a)
+      if a == 0 then return nil end
+      local t = r32(a + E_TYPE)
+      local cls = t == 1 and "EntityPlayer" or t == 2 and "EntityTear" or t == 3 and "EntityFamiliar" or t == 4 and "EntityBomb"
+        or t == 5 and "EntityPickup" or t == 9 and "EntityProjectile" or (t >= 10 and t < 1000) and "EntityNPC" or nil
+      if cls then return wrap(cls, a) end
+      return entity(a)
+    end
