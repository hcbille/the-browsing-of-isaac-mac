index 0000000..e2a9fb8
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b3probe.lua
@@ -0,0 +1,90 @@
+-- lab_b3probe.lua (development only; ISAAC_RGON_LAB=lab_b3probe.lua, census batch 3): measures the Weapon's
+-- virtual functions and its direction vector in this build. For the primary weapon of a player with tears, then
+-- Brimstone, Monstro's Lung and Chocolate Milk (a charge weapon each), logs the first bytes of the vtable
+-- functions 0..16, GetMaxCharge (slot 6, a float in st0) and GetMainEntity (slot 10), and the weapon's words
+-- 0x08..0x3c while the player shoots right and then up ("lab_b3probe: ..").
+local T = ...
+local B = T.B
+local r8, r32, ri32, rf32, call = B.r8, B.r32, B.ri32, B.rf32, B.call
+local mod = RegisterMod("rgon lab b3probe", 1)
+local function say(s) B.log("lab_b3probe: " .. s) end
+local function hex(a, n)
+  local t = {}
+  for i = 0, n - 1 do t[#t + 1] = string.format("%02x", r8(a + i)) end
+  return table.concat(t)
+end
+local dir = nil
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if dir and ent and ent.Type == 1 and action == dir then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local frame = 0
+local function weapon_of(p) return r32(p.Position and (B.ptr(p) + 0x13dc + 4)) end
+local function words(w, lo, hi)
+  local t = {}
+  for o = lo, hi, 4 do t[#t + 1] = string.format("%02x:%08x", o, r32(w + o)) end
+  return table.concat(t, " ")
+end
+local function describe(tag, p)
+  local w = weapon_of(p)
+  if w == 0 then say(tag .. ": no primary weapon") return end
+  local vt = r32(w)
+  say(string.format("%s: weapon %x type %d vtable %x", tag, w, ri32(w + 0x30), vt))
+  for i = 0, 16 do
+    local f = r32(vt + 4 * i)
+    say(string.format("  vt[%d] = %x  %s", i, f, hex(f, 12)))
+  end
+  local eax, st0 = call(r32(vt + 4 * 6), w)
+  say(string.format("  GetMaxCharge call: eax=%x st0=%g", eax, st0 or -1))
+  local m = call(r32(vt + 4 * 10), w)
+  say(string.format("  GetMainEntity call: %x (player %x)", m, B.ptr(p)))
+  say("  words " .. words(w, 0x08, 0x3c))
+end
+local steps = {}
+local function step(at, f) steps[at] = f end
+local function setup(tag, item, from)
+  step(from, function()
+    local p = Isaac.GetPlayer(0)
+    for _, c in ipairs({ CollectibleType.COLLECTIBLE_BRIMSTONE, CollectibleType.COLLECTIBLE_MONSTROS_LUNG, CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, CollectibleType.COLLECTIBLE_TECHNOLOGY, CollectibleType.COLLECTIBLE_MOMS_KNIFE }) do
+      if p:HasCollectible(c) then p:RemoveCollectible(c) end
+    end
+    if item then p:AddCollectible(item, 0, false) end
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    dir = nil
+  end)
+  step(from + 5, function() describe(tag .. " idle", Isaac.GetPlayer(0)) end)
+  step(from + 8, function() dir = ButtonAction.ACTION_SHOOTRIGHT end)
+  for i = 0, 12, 3 do
+    step(from + 10 + i, function()
+      local p = Isaac.GetPlayer(0)
+      local w = weapon_of(p)
+      if w ~= 0 then say(tag .. " shooting right +" .. i .. ": " .. words(w, 0x08, 0x3c)) end
+    end)
+  end
+  step(from + 30, function() dir = ButtonAction.ACTION_SHOOTUP end)
+  for i = 0, 12, 3 do
+    step(from + 32 + i, function()
+      local p = Isaac.GetPlayer(0)
+      local w = weapon_of(p)
+      if w ~= 0 then say(tag .. " shooting up +" .. i .. ": " .. words(w, 0x08, 0x3c)) end
+    end)
+  end
+  step(from + 50, function() dir = nil end)
+  step(from + 55, function() local p = Isaac.GetPlayer(0) local w = weapon_of(p) if w ~= 0 then say(tag .. " released: " .. words(w, 0x08, 0x3c)) end end)
+end
+setup("tears", nil, 5)
+setup("brimstone", CollectibleType.COLLECTIBLE_BRIMSTONE, 80)
+setup("monstros lung", CollectibleType.COLLECTIBLE_MONSTROS_LUNG, 155)
+setup("chocolate milk", CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, 230)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local f = steps[frame]
+  if f then
+    local ok, err = pcall(f)
+    if not ok then say("step " .. frame .. " failed: " .. tostring(err)) end
+  end
+  if frame == 320 then say("DONE") end
+end)
diff --git a/scripts/recomp/rgon/lab_b3probe2.lua b/scripts/recomp/rgon/lab_b3probe2.lua
new file mode 100644
index 0000000..f7219ba
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b3probe2.lua
@@ -0,0 +1,46 @@
+-- lab_b3probe2.lua (development only; ISAAC_RGON_LAB=lab_b3probe2.lua, census batch 3): the room descriptor's
+-- layout in this build. Compares the vanilla Lua fields with REPENTOGON's offsets, the stride of the level's
+-- descriptor list, and dumps the constructor (RoomDescriptor::constructor, 0x006ef590) so the store to the
+-- Group field (REPENTOGON: +0xb4) can be found ("lab_b3probe2: ..").
+local T = ...
+local B = T.B
+local r8, r32, ri32, ptr = B.r8, B.r32, B.ri32, B.ptr
+local mod = RegisterMod("rgon lab b3probe2", 1)
+local function say(s) B.log("lab_b3probe2: " .. s) end
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame ~= 3 then return end
+  local level = Game():GetLevel()
+  local d = level:GetCurrentRoomDesc()
+  local p = ptr(d)
+  say(string.format("current descriptor at %x", p))
+  local fields = { { "GridIndex", 0x0 }, { "SafeGridIndex", 0x4 }, { "ListIndex", 0x8 }, { "Data", 0x10 }, { "OverrideData", 0x14 },
+    { "AllowedDoors", 0x18 }, { "DisplayFlags", 0x3c }, { "VisitedCount", 0x40 }, { "Flags", 0x44 }, { "DecorationSeed", 0x58 },
+    { "SpawnSeed", 0x5c }, { "AwardSeed", 0x60 }, { "DeliriumDistance", 0xb0 } }
+  for _, f in ipairs(fields) do
+    local v = d[f[1]]
+    local raw = r32(p + f[2])
+    local shown = type(v) == "userdata" and ptr(v) or v
+    say(string.format("%-16s lua %s  raw@%02x %d (0x%x)  %s", f[1], tostring(shown), f[2], ri32(p + f[2]), raw, (shown == ri32(p + f[2]) or shown == raw) and "same" or "DIFFERENT"))
+  end
+  say(string.format("Dimension raw@0c %d; Group raw@b4 %d; words 0xa8..0xbc: %08x %08x %08x %08x %08x %08x", ri32(p + 0xc), ri32(p + 0xb4),
+    r32(p + 0xa8), r32(p + 0xac), r32(p + 0xb0), r32(p + 0xb4), r32(p + 0xb8), r32(p + 0xbc)))
+  -- the stride between descriptors of the level's list, and the Group word of each
+  local list = level:GetRooms()
+  local prev
+  local strides, groups, dims = {}, {}, {}
+  for i = 0, list.Size - 1 do
+    local q = ptr(list:Get(i))
+    if prev then strides[#strides + 1] = q - prev end
+    prev = q
+    groups[#groups + 1] = ri32(q + 0xb4)
+    dims[#dims + 1] = ri32(q + 0xc)
+  end
+  say("GetRooms strides " .. table.concat(strides, ","))
+  say("Group word of each " .. table.concat(groups, ","))
+  say("Dimension word of each " .. table.concat(dims, ","))
+  local code = {}
+  for i = 0, 0x1ff do code[#code + 1] = string.format("%02x", r8(0x006ef590 + i)) end
+  say("CTOR " .. table.concat(code))
+end)
