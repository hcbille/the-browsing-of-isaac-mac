@@ -547,3 +547,23 @@ method("Entity", "ToDelirium", function(self)
 end)
 R.Unsupported = R.Unsupported or {}
 R.Unsupported["Entity:ToDelirium"] = "answers with the NPC; Delirium's own functions are not there"
+
+------------------------------------------------------------------------------
+-- Sprite:Continue([continueOverlay = true]) (REPENTOGON): resume the current animation from the frame it
+-- is on, after SetFrame or Stop left it paused (Epiphany's Tarnished page: SetFrame("Appear", 1) then
+-- Continue(), epiphany_menu.lua:288; without it the page swap stops there). Done with the game's own
+-- functions only: Play(name, true) starts the animation at frame 0, Update() moves it one frame, so the
+-- frame it was on is reached again with the animation playing. An animation that is already playing is
+-- left alone. The overlay is restarted the same way when it was not playing (its frame is not kept: only
+-- the main animation's frame is walked back to).
+------------------------------------------------------------------------------
+method("Sprite", "Continue", function(self, continueOverlay)
+  local anim = self:GetAnimation()
+  if anim and anim ~= "" and not self:IsPlaying(anim) then
+    local f = self:GetFrame()
+    local ov = continueOverlay ~= false and self.GetOverlayAnimation and self:GetOverlayAnimation() or ""
+    self:Play(anim, true)
+    if ov ~= "" and not self:IsOverlayPlaying(ov) then self:PlayOverlay(ov, true) end
+    for _ = 1, math.max(0, math.min(f, 10000)) do self:Update() end
+  end
+end)
