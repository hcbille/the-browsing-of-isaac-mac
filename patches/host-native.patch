+-- api_gaps.lua -- gaps the Mac Build's gate log named for the Target Mods (milestone M8),
+-- Epiphany first. Each piece says what in the log it answers.
+--
+--   Sprite.Color as a reference        epiphany_menu.lua:35 `sprite.Color.A = 0`: "no member named 'A'"
+--   BlendMode, LayerState:GetBlendMode  epiphany_menu.lua:40: a layer's blend mode is read and changed
+--
+-- (Sprite(path, load), the constructor, is in api_sprite.lua.)
+
+local T = ...
+local B, R, method, this, wrap = T.B, T.R, T.method, T.this, T.wrap
+local ptr, r32, w32, log, cfn = B.ptr, B.r32, B.w32, B.log, B.cfn
+local type, error, setmetatable, rawget, rawset, tostring = type, error, setmetatable, rawget, rawset, tostring
+local mathtype = math.type
+
+-- Sprite.Color: the game hands out a const Color (a copy-free view that cannot be written),
+-- REPENTOGON a reference. A sprite's colour is at +0xa8 (rgon.lua, GetLayer: checked against
+-- the game's own getter), so the getter is replaced by one that wraps that address in the
+-- ordinary Color class: `sprite.Color.A = 0` then changes the sprite, as it does there.
+do
+  local cls, const = T.class_tables("Sprite")
+  local done = false
+  for _, tbl in ipairs({ cls, const }) do
+    local pg = type(tbl) == "table" and rawget(tbl, "__propget")
+    if type(pg) == "table" and rawget(pg, "Color") ~= nil then
+      rawset(pg, "Color", cfn(function(self) return wrap("Color", this(self, "Sprite.Color") + 0xa8) end))
+      done = true
+    end
+  end
+  if done then R.Implemented["Sprite.Color"] = true
+  else log("api_gaps: Sprite.Color was not where it was expected; left as the game has it") end
+end
+
+-- BlendMode: five ints, equation +0, RGB source +4, RGB destination +8, alpha source +0xc,
+-- alpha destination +0x10, at +0x78 of a layer state (REPENTOGON's LayerState: the layer
+-- state's neighbours, 0x74 visible, 0x8c render flags, 0x90 crop, are where this build has
+-- them, rgon.lua GetLayer). A BlendMode read from a layer is that memory, so a change reaches
+-- the layer as the game's own code reads it; BlendMode.New makes a block of its own.
+do
+  local FIELD = { Equation = 0, RGBSourceFactor = 4, RGBDestinationFactor = 8, AlphaSourceFactor = 0xc, AlphaDestinationFactor = 0x10 }
+  local NFACTORS, NEQUATIONS = 15, 5
+  local PRESETS = {                                  -- BlendType -> equation, rgb src, rgb dst, alpha src, alpha dst
+    [0] = { 0, 1, 0, 1, 0 },                         -- CONSTANT
+    { 0, 1, 7, 1, 7 },                               -- NORMAL (premultiplied alpha)
+    { 0, 1, 1, 1, 1 },                               -- ADDITIVE
+    { 0, 0, 2, 0, 2 },                               -- MULTIPLICATIVE
+    { 0, 4, 7, 4, 7 },                               -- OVERLAY
+  }
+  local owned = setmetatable({}, { __mode = "k" })   -- object -> its own block
+
+  local function addr(self)
+    local a = type(self) == "table" and rawget(self, "_a")
+    if not a then error("rgon: BlendMode used without its object", 3) end
+    return a
+  end
+  local function checked(v, limit, what, level)
+    if mathtype(v) ~= "integer" and type(v) ~= "number" then error("bad argument (number expected) for " .. what, level) end
+    v = math.floor(v)
+    if v < 0 or v >= limit then error("bad argument: invalid " .. what, level) end
+    return v
+  end
+  local function setall(a, e, rs, rd, as, ad)
+    w32(a, e) w32(a + 4, rs) w32(a + 8, rd) w32(a + 0xc, as) w32(a + 0x10, ad)
+  end
+
+  local METHODS = {}
+  function METHODS.SetMode(self, ...)
+    local a = addr(self)
+    local n = select("#", ...)
+    if n >= 2 then
+      local rs, rd, as, ad, e = ...
+      setall(a,
+        e == nil and r32(a) or checked(e, NEQUATIONS, "blend equation", 2),
+        rs == nil and r32(a + 4) or checked(rs, NFACTORS, "blend factor", 2),
+        rd == nil and r32(a + 8) or checked(rd, NFACTORS, "blend factor", 2),
+        as == nil and r32(a + 0xc) or checked(as, NFACTORS, "blend factor", 2),
+        ad == nil and r32(a + 0x10) or checked(ad, NFACTORS, "blend factor", 2))
+    else
+      local p = PRESETS[math.floor((...))]
+      if p then setall(a, p[1], p[2], p[3], p[4], p[5]) end   -- an unknown mode is ignored
+    end
+  end
+
+  local MT = {
+    __type = "BlendMode", __name = "BlendMode",
+    __index = function(self, k)
+      local f = FIELD[k]
+      if f then return r32(addr(self) + f) end
+      return METHODS[k]
+    end,
+    __newindex = function(self, k, v)
+      local f = FIELD[k]
+      if not f then error("no member named '" .. tostring(k) .. "'", 2) end
+      w32(addr(self) + f, checked(v, k == "Equation" and NEQUATIONS or NFACTORS, k == "Equation" and "blend equation" or "blend factor", 2))
+    end,
+    __eq = function(a, b) return rawget(a, "_a") == rawget(b, "_a") end,
+    __tostring = function(self) return "BlendMode(" .. r32(addr(self)) .. "," .. r32(addr(self) + 4) .. "," .. r32(addr(self) + 8)
+      .. "," .. r32(addr(self) + 0xc) .. "," .. r32(addr(self) + 0x10) .. ")" end,
+    __gc = function(self) local a = rawget(self, "_own") if a then B.free(a) end end,
+  }
+  local function at(a, own) return setmetatable({ _a = a, _own = own }, MT) end
+
+  -- what rgon.lua's LayerState:GetBlendMode calls
+  R.BlendModeAt = function(a) return at(a) end
+
+  local BM = {}
+  function BM.New(rs, rd, as, ad, e)
+    local a = B.alloc(0x14)
+    setall(a,
+      e == nil and 0 or checked(e, NEQUATIONS, "blend equation", 2),
+      rs == nil and 1 or checked(rs, NFACTORS, "blend factor", 2),
+      rd == nil and 0 or checked(rd, NFACTORS, "blend factor", 2),
+      as == nil and 1 or checked(as, NFACTORS, "blend factor", 2),
+      ad == nil and 0 or checked(ad, NFACTORS, "blend factor", 2))
+    return at(a, a)
+  end
+  function BM.NewFromType(t)
+    local p = PRESETS[math.floor(t or -1)]
+    if not p then error("bad argument #1 to 'NewFromType': Invalid blend type", 2) end
+    local a = B.alloc(0x14)
+    setall(a, p[1], p[2], p[3], p[4], p[5])
+    return at(a, a)
+  end
+  if rawget(_G, "BlendMode") == nil then rawset(_G, "BlendMode", BM) end
+  R.Implemented["BlendMode.New"] = true
+  R.Implemented["BlendMode.NewFromType"] = true
+  R.Implemented["BlendMode.SetMode"] = true
+  for k in pairs(FIELD) do R.Implemented["BlendMode." .. k] = true end
+end
+
+-- ColorModifier(R = 1, G = 1, B = 1, A = 0, Brightness = 0, Contrast = 1): a colour correction.
+-- A value of the Lua side: six numbers with + - (two of them) and * / (by a number, the
+-- ColorModifier on the left), as REPENTOGON's. epiphany_menu.lua:138.
+do
+  local FIELDS = { "R", "G", "B", "A", "Brightness", "Contrast" }
+  local MT = { __type = "ColorModifier", __name = "ColorModifier" }
+  local function new(r, g, b, a, br, c)
+    return setmetatable({ R = r, G = g, B = b, A = a, Brightness = br, Contrast = c }, MT)
+  end
+  local function num(v, what) if type(v) ~= "number" then error("bad argument (number expected) for ColorModifier " .. what, 3) end return v end
+  MT.__index = function(_, k) return nil end
+  MT.__newindex = function(t, k, v)
+    for _, f in ipairs(FIELDS) do if f == k then rawset(t, k, num(v, k)) return end end
+    error("no member named '" .. tostring(k) .. "'", 2)
+  end
+  local function isc(v) return type(v) == "table" and getmetatable(v) == MT end
+  local function both(a, b, f)
+    if not isc(a) or not isc(b) then error("bad argument: ColorModifier expected", 3) end
+    return new(f(a.R, b.R), f(a.G, b.G), f(a.B, b.B), f(a.A, b.A), f(a.Brightness, b.Brightness), f(a.Contrast, b.Contrast))
+  end
+  MT.__add = function(a, b) return both(a, b, function(x, y) return x + y end) end
+  MT.__sub = function(a, b) return both(a, b, function(x, y) return x - y end) end
+  MT.__mul = function(a, k)
+    if type(a) == "number" then error("Cannot left multiply a ColorModifier with a number", 2) end
+    if not isc(a) or type(k) ~= "number" then error("bad argument: ColorModifier * number expected", 2) end
+    return new(a.R * k, a.G * k, a.B * k, a.A * k, a.Brightness * k, a.Contrast * k)
+  end
+  MT.__div = function(a, k)
+    if type(a) == "number" then error("Cannot left divide a ColorModifier with a number", 2) end
+    if not isc(a) or type(k) ~= "number" then error("bad argument: ColorModifier / number expected", 2) end
+    if k == 0 then error("Divide by zero", 2) end
+    return new(a.R / k, a.G / k, a.B / k, a.A / k, a.Brightness / k, a.Contrast / k)
+  end
+  MT.__eq = function(a, b)
+    return a.R == b.R and a.G == b.G and a.B == b.B and a.A == b.A and a.Brightness == b.Brightness and a.Contrast == b.Contrast
+  end
+  MT.__tostring = function(s) return string.format("ColorModifier(%g,%g,%g,%g,%g,%g)", s.R, s.G, s.B, s.A, s.Brightness, s.Contrast) end
+  if rawget(_G, "ColorModifier") == nil then
+    rawset(_G, "ColorModifier", setmetatable({}, { __call = function(_, r, g, b, a, br, c)
+      return new(r == nil and 1 or num(r, "R"), g == nil and 1 or num(g, "G"), b == nil and 1 or num(b, "B"),
+                 a == nil and 0 or num(a, "A"), br == nil and 0 or num(br, "Brightness"), c == nil and 1 or num(c, "Contrast"))
+    end }))
+    R.Implemented["ColorModifier.ColorModifier"] = true
+  end
+  T.ColorModifier = { new = new, is = isc }
+end
