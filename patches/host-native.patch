+-- lab_cb.lua (development only; ISAAC_RGON_LAB=lab_cb.lua, round 123): the callbacks the engine hooks of round 123 fire,
+-- logged with their arguments (first few of each), over lab_trapdoor.lua's floor changes.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb", 1)
+local counts = {}
+local function seen(name, ...)
+  counts[name] = (counts[name] or 0) + 1
+  local c = counts[name]
+  if c <= 4 or c % 200 == 0 then
+    local a = {}
+    for i = 1, select("#", ...) do a[#a + 1] = tostring((select(i, ...))) end
+    B.log(string.format("lab_cb: %s #%d f%d (%s) ingame=%s", name, c, Isaac.GetFrameCount(), table.concat(a, ","), tostring(Isaac.IsInGame())))
+  end
+end
+for _, n in ipairs({ "MC_POST_NIGHTMARE_SCENE_RENDER", "MC_MENU_INPUT_ACTION", "MC_MAIN_MENU_RENDER", "MC_PRE_GLOWING_HOURGLASS_SAVE",
+                     "MC_POST_GLOWING_HOURGLASS_SAVE", "MC_PRE_GLOWING_HOURGLASS_LOAD", "MC_POST_GLOWING_HOURGLASS_LOAD" }) do
+  mod:AddCallback(M[n], function(_, ...) seen(n, ...) end)
+end
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, e, hook, action) seen("MC_INPUT_ACTION", hook, action) end)
+local chunk = B.load("lab_trapdoor.lua")
+if chunk then chunk(T) end
diff --git a/scripts/recomp/rgon/lab_cb_b.lua b/scripts/recomp/rgon/lab_cb_b.lua
