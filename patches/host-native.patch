+  check(r:GetItemPool(1234, true) == want, "raw gives the pool that was set: " .. tostring(r:GetItemPool(1234, true)))
+  check(r:GetItemPool(1234) == want, "Room:GetItemPool gives it too (the game's function is hooked): " .. tostring(r:GetItemPool(1234)))
+  r:SetItemPool(-1)
+  check(r:GetItemPool(1234) == base_pool, "SetItemPool(-1) hands the choice back to the game: " .. tostring(r:GetItemPool(1234)))
+  local ok = pcall(function() r:SetItemPool(-5) end)
+  check(not ok, "an invalid pool raises an error")
+  -- the game's own pedestal code draws from it: a pool with one overwhelmingly heavy item (id 2), no override first
+  clear_things()
+  Game():GetItemPool():AddCollectible(3, { itemID = 2, weight = 1.0e7, decreaseBy = 0.5, removeOn = 0.1 })
+  local seen = {}
+  for k = 1, 6 do
+    local e = Isaac.Spawn(5, 100, 0, pos(3 + k, 2), Vector(0, 0), nil)
+    seen[#seen + 1] = e.SubType
+  end
+  base.plain = table.concat(seen, ",")
+  clear_things()
+  r:SetItemPool(3)
+  seen = {}
+  for k = 1, 6 do
+    local e = Isaac.Spawn(5, 100, 0, pos(3 + k, 2), Vector(0, 0), nil)
+    seen[#seen + 1] = e.SubType
+  end
+  local with = table.concat(seen, ",")
+  say("random pedestals without the override: " .. base.plain .. "; with the devil pool set: " .. with)
+  -- the first draw takes the heavy item (the game then removes a drawn item from every pool, so only the first can be it)
+  check(seen[1] == 2 and base.plain:sub(1, 2) ~= "2,", "a random pedestal draws from the pool Room:SetItemPool named (first draw: " .. tostring(seen[1]) .. ")")
+  r:SetItemPool(-1)
+  clear_things()
+end)
+
+step(function()
+  room():SetItemPool(5)
+  check(room():GetItemPool(1, true) == 5, "set to 5 before a room change")
+  game:ChangeRoom(game:GetLevel():GetCurrentRoomIndex())
+  wait("render frames", 20, function() return false end)
+end)
+step(function()
+  say("pool after re-entering the room: " .. tostring(room():GetItemPool(1, true)))
+  check(room():GetItemPool(1, true) == -1, "the set pool is forgotten when the room is entered again: " .. tostring(room():GetItemPool(1, true)))
+end)
