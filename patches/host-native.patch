+------------------------------------------------------------------------------
+-- MC_POST_NIGHTMARE_SCENE_RENDER (1102): (), after NightmareScene::Render() 0x00920940 (slot 171, called once per
+--   drawn frame by Manager::Render while the stage change's scene is shown).
+if M.MC_POST_NIGHTMARE_SCENE_RENDER then
+  on("NightmareScene::Render", { M.MC_POST_NIGHTMARE_SCENE_RENDER }, nil, function()
+    if listening[M.MC_POST_NIGHTMARE_SCENE_RENDER] then run(M.MC_POST_NIGHTMARE_SCENE_RENDER, nil) end
+  end)
+end
+
+-- MC_MENU_INPUT_ACTION (1464): LuaCallbackCaller::CallInputAction 0x00874910 (slot 173) runs the callback id stored in
+--   the caller ([this+4], MC_INPUT_ACTION by default); outside a run it is changed to 1464, as REPENTOGON does, while
+--   something listens on 1464 (the engine's own state for MC_INPUT_ACTION is switched on with it, rgon.lua).
+if M.MC_MENU_INPUT_ACTION then
+  local MENU = M.MC_MENU_INPUT_ACTION
+  on("LuaCallbackCaller::CallInputAction", { MENU }, function(self)
+    if listening[MENU] and not Isaac.IsInGame() then w32(self + 4, MENU) end
+  end, nil)
+  -- Armed, but never seen to run in this build's menus (the menu does not ask this function, round 123), so it is
+  -- not counted as implemented: the gate must not treat it as covered.
+  R.NotSeenFiring = R.NotSeenFiring or {}
+  R.NotSeenFiring[MENU] = "the hook is armed; the menus of this build never call CallInputAction"
+end
+
+-- MC_PRE_GLOWING_HOURGLASS_SAVE (1302), MC_POST_GLOWING_HOURGLASS_SAVE (1300): (slot), around Game::SaveState(state)
+--   0x006f9000 (slot 172); MC_PRE_GLOWING_HOURGLASS_LOAD (1303), MC_POST_GLOWING_HOURGLASS_LOAD (1301): around
+--   Game::RestoreState(state, startGame) 0x006bb790 (slot 21). The slot is 0 or 1 when the state is one of the game's two
+--   glowing hourglass states, -1 when it is any other (REPENTOGON's: the pre-save callback is told -1 as well, the
+--   others only fire for a hourglass state). The two states are the game's own array at game+0x269ec, 0x20660 bytes
+--   each (Game::GetGlowingHourglassState 0x00706780 reads them there: `lea ecx, [eax+0x269ec]; add ecx, index*0x20660`).
+do
+  local GAME_PTR, FIRST, SIZE = 0x00c71678, 0x269ec, 0x20660
+  local function hourglass_slot(state)
+    local game = r32(GAME_PTR)
+    if game == 0 or state < game + FIRST then return -1 end
+    local k = (state - (game + FIRST)) // SIZE
+    if k < 2 then return k end
+    return -1
+  end
+  T.hourglass_slot = hourglass_slot
+  local PRE_S, POST_S, PRE_L, POST_L = M.MC_PRE_GLOWING_HOURGLASS_SAVE, M.MC_POST_GLOWING_HOURGLASS_SAVE,
+    M.MC_PRE_GLOWING_HOURGLASS_LOAD, M.MC_POST_GLOWING_HOURGLASS_LOAD
+  if PRE_S and POST_S then
+    on("Game::SaveState", { PRE_S, POST_S }, function(self, esp)
+      local slot = hourglass_slot(r32(esp + 4))
+      if listening[PRE_S] then run(PRE_S, nil, slot) end
+      return { slot }
+    end, function(self, esp, eax, k)
+      if k and k[1] ~= -1 and listening[POST_S] then run(POST_S, nil, k[1]) end
+    end)
+  end
+  if PRE_L and POST_L then
+    on("Game::RestoreState", { PRE_L, POST_L }, function(self, esp)
+      local slot = hourglass_slot(r32(esp + 4))
+      if slot == -1 then return nil end
+      if listening[PRE_L] then run(PRE_L, nil, slot) end
+      return { slot }
+    end, function(self, esp, eax, k)
+      if k and listening[POST_L] then run(POST_L, nil, k[1]) end
+    end)
+    -- Armed, but a Glowing Hourglass use was not seen to restore through this hook in a run (round 123: the run with
+    -- `giveitem c422` and the item used did not reach the restore before the guest heap filled), so the two load
+    -- callbacks are not counted as implemented. The save callbacks were seen firing (slots 0 and -1).
+    R.NotSeenFiring = R.NotSeenFiring or {}
+    R.NotSeenFiring[PRE_L], R.NotSeenFiring[POST_L] = "armed; a hourglass restore was not seen to run through it", "armed; a hourglass restore was not seen to run through it"
+  end
+end
+
 install()
+-- hooks that are armed but were not seen firing are not implemented names (define marked them)
+for id in pairs(R.NotSeenFiring or {}) do R.Implemented[id] = nil end
 T.rearm()
 
 ------------------------------------------------------------------------------
