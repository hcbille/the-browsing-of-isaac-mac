index 0000000..8542f8e
--- /dev/null
+++ b/scripts/recomp/rgon/lab_bossintro_test.lua
@@ -0,0 +1,86 @@
+-- lab_bossintro_test.lua (development only; chunk "rooms")
+-- Checks RoomTransition.StartBossIntro (api_extra.lua): the direct call (mode becomes 2, IsRenderingBossIntro, the
+-- MC_POST_BOSS_INTRO_SHOW callback gets the two ids, GetVersusScreenSprite is a sprite that plays), then the path
+-- StageAPI takes (StageAPI.PlayBossAnimation with UseRepentogonBossIntro; Fiend Folio sets that on its bosses).
+-- Phase marks are logged as "lab_bossintro_test: PHASE <name> at render frame N" so a screenshot run can be timed.
+-- Prints PASS/FAIL lines and DONE.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab bossintro test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_bossintro_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+
+local shown = {}
+mod:AddCallback(ModCallbacks.MC_POST_BOSS_INTRO_SHOW, function(_, a, b) shown[#shown + 1] = { a, b } end)
+
+local started = false
+mod:AddCallback(ModCallbacks.MC_POST_GAME_STARTED, function() started = true end)
+local frame, phase, pstart = 0, 0, 0
+local function enter(p, name) phase, pstart = p, frame say("PHASE " .. name .. " at render frame " .. frame) end
+
+local DIRECT_AT = 100
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if phase == 0 and frame == 40 then
+    check("RoomTransition.StartBossIntro is a function", type(RoomTransition.StartBossIntro) == "function")
+    check("REPENTOGON.Implemented lists it", REPENTOGON == nil or REPENTOGON.Implemented == nil or REPENTOGON.Implemented["RoomTransition.StartBossIntro"] == true)
+    check("a string argument is an error", not pcall(RoomTransition.StartBossIntro, "x"))
+    check("no argument is an error", not pcall(RoomTransition.StartBossIntro))
+    check("mode is 0 before", RoomTransition.GetTransitionMode() == 0, RoomTransition.GetTransitionMode())
+  end
+  if phase == 0 and frame == DIRECT_AT then
+    local ok, err = pcall(RoomTransition.StartBossIntro, BossType.MONSTRO)
+    check("StartBossIntro(MONSTRO) does not raise", ok, err)
+    check("transition mode is 2 after", RoomTransition.GetTransitionMode() == 2, RoomTransition.GetTransitionMode())
+    check("IsRenderingBossIntro is true", RoomTransition.IsRenderingBossIntro() == true)
+    check("MC_POST_BOSS_INTRO_SHOW fired with (MONSTRO, 0)", #shown == 1 and shown[1][1] == BossType.MONSTRO and (shown[1][2] or 0) == 0, #shown)
+    local sp = RoomTransition.GetVersusScreenSprite()
+    say("info: versus sprite animation " .. tostring(sp:GetAnimation()) .. " file " .. tostring(sp:GetFilename()))
+    enter(1, "direct_intro_playing")
+  elseif phase == 1 then
+    if not RoomTransition.IsRenderingBossIntro() then
+      check("the intro ends by itself", true, "after " .. (frame - pstart) .. " render frames")
+      enter(2, "direct_done")
+    elseif frame - pstart > 1500 then
+      check("the intro ends by itself", false, "still rendering after 1500 frames")
+      say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+      phase = 99
+    end
+  elseif phase == 2 and frame - pstart == 60 then
+    local SA = rawget(_G, "StageAPI")
+    check("StageAPI is loaded", SA ~= nil and type(SA.PlayBossAnimation) == "function")
+    if SA then
+      local boss = SA.GetBossData and (SA.GetBossData("Mo") or SA.GetBossData("Ma")) or nil
+      if not boss then
+        for id, data in pairs(SA.Bosses or {}) do boss = data break end
+      end
+      check("a StageAPI boss is registered", boss ~= nil, boss and boss.Name)
+      if boss then
+        boss.UseRepentogonBossIntro = true
+        local ok, err = pcall(SA.PlayBossAnimation, boss, false)
+        check("StageAPI.PlayBossAnimation (REPENTOGON path) does not raise", ok, err)
+        check("a boss intro is rendering", RoomTransition.IsRenderingBossIntro() == true)
+        check("MC_POST_BOSS_INTRO_SHOW fired a second time", #shown == 2, #shown)
+        local sp = RoomTransition.GetVersusScreenSprite()
+        check("StageAPI's callback chose Scene or DoubleTrouble", sp:GetAnimation() == "Scene" or sp:GetAnimation() == "DoubleTrouble", sp:GetAnimation())
+        enter(3, "stageapi_intro_playing")
+      end
+    end
+    if phase == 2 then say(string.format("DONE %d PASS, %d FAIL", pass, fail)) phase = 99 end
+  elseif phase == 3 then
+    if not RoomTransition.IsRenderingBossIntro() then
+      check("StageAPI's intro ends", true, "after " .. (frame - pstart) .. " render frames")
+      say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+      phase = 99
+    elseif frame - pstart > 1500 then
+      check("StageAPI's intro ends", false, "still rendering after 1500 frames")
+      say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+      phase = 99
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_cb.lua b/scripts/recomp/rgon/lab_cb.lua
