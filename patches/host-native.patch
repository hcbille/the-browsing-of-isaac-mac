+-- api_charsel.lua -- the character select's callbacks (worker charsel, wave 5; hook slots 252-259, hook_slots.lua).
+-- REPENTOGON patches five places in the menu's code; here each is an instruction hook (lift_patches.py RGON_INSN_HOOKS):
+--   1328 MC_CAN_SELECT_CHARACTER (pt; pt, true)   Menu_Character::Update 0x0094c580 at 0x0094c619, right after the test of
+--        [menu+5] (the character is unlocked), edi = the menu; false goes where a locked character goes, 0x0094c646 (the buzzer).
+--        REPENTOGON's second use (isBeingSelected = false, the random pick's list) is not hooked.
+--   1329/1330 MC_PRE/POST_RENDER_CHARACTER_SELECT_PAGE (pt; pt, pos, defaultSprite, moddedSprite, hasCustomBackground)
+--        the page's render 0x0094bbd0 (this = esi = the menu, [ebx+8] = the position, edi): the vanilla branch (id < 0x12) is
+--        0x0094bc2d..0x0094bc3f, the modded one the call of ModManager::RenderCustomCharacterMenu at 0x0094bc5f (stdcall(pt,
+--        pos, background), ret 0xc; the modded sprite is [config+0x134], "render custom background" [config+0x130]); both
+--        meet at 0x0094bc64 (the post). false from the pre skips the draw (and the Eden tokens text of entry 10, 0x0094bc7c).
+--   1331/1332 MC_PRE/POST_RENDER_CHARACTER_SELECT_PORTRAIT (pt; pt, sprite, pos, scale, color)
+--        the wheel's render 0x0094bee0 (this = edi = the menu): a vanilla entry's draws start at 0x0094c2f0 (entry offset in
+--        ebx, position at [esp+0x14] and [esp+0x18]), a modded one is the call of 0x008f8860 at 0x0094c445 (stdcall(pt, pos,
+--        color, scale), ret 0x10); both end at 0x0094c44a (the post). false skips the portrait, a Vector moves it.
+local T = ...
+local B, R, wrap = T.B, T.R, T.wrap
+local r8, r32, ri32, rf32, wf32, log = B.r8, B.r32, B.ri32, B.rf32, B.wf32, B.log
+local M = ModCallbacks
+local type, pcall, tostring = type, pcall, tostring
+
+local SLOTS
+do
+  local chunk = B.load("hook_slots.lua")
+  if not chunk then return end
+  SLOTS = chunk()
+end
+if not (B.INSN and B.reg) then return end
+local CM = T.CharacterMenu
+if not CM then log("api_charsel: api_menus.lua's CharacterMenu is missing") return end
+local reg = B.reg
+local function run(...) return T.run(...) end
+
+local told = {}
+local function wrong(what, a)
+  if told[what] then return end
+  told[what] = true
+  log(string.format("api_charsel: %s was handed 0x%08x, which is not what it should be; the call goes on unwatched", what, a))
+end
+local function first(what)
+  if not told[what] then told[what] = true log("api_charsel: " .. what .. " ran its first callback") end
+end
+
+local function at(name, ids, handler)
+  local s = SLOTS[name]
+  if type(s) ~= "table" or math.type(s[3]) ~= "integer" then log("api_charsel: no instruction hook " .. name) return end
+  local va = s[3]
+  T.define(s[1], ids, function(at_va, esp, ebp)
+    if at_va ~= va then wrong(name .. " (its address)", at_va) return end
+    return handler(esp, ebp)
+  end, nil)
+end
+
+-- a sprite that lives inside the menu (it points at itself at +0x30 and +0x50)
+local function sprite_in(a)
+  if r32(a + 0x30) ~= a or r32(a + 0x50) ~= a then return nil end
+  return wrap("Sprite", a)
+end
+local function vec_at(a) return Vector(rf32(a), rf32(a + 4)) end
+local function type_of(menu, id) return CM.GetPlayerTypeFromCharacterMenuID(id, ri32(menu + 0xdb4) ~= 0) end
+local function color_copy(c)
+  return Color(c.R, c.G, c.B, c.A, c.RO, c.GO, c.BO)
+end
+local function color_at(a)
+  return Color(rf32(a), rf32(a + 4), rf32(a + 8), rf32(a + 12), rf32(a + 0x20), rf32(a + 0x24), rf32(a + 0x28))
+end
+local function is_vector(v) return type(v) == "userdata" and v.X ~= nil and v.Y ~= nil end
+
+local CAN, PRE_PAGE, POST_PAGE = M.MC_CAN_SELECT_CHARACTER, M.MC_PRE_RENDER_CHARACTER_SELECT_PAGE, M.MC_POST_RENDER_CHARACTER_SELECT_PAGE
+local PRE_PORT, POST_PORT = M.MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT, M.MC_POST_RENDER_CHARACTER_SELECT_PORTRAIT
