+-- MC_MENU_INPUT_ACTION (1464): (entity, hook, action), param = hook (InputHook), the game's input queries outside a run.
+--   In a run the engine's own MC_INPUT_ACTION runs from the three input accessors (IsActionPressed 0x00956110 hook 0,
+--   IsActionTriggered 0x009561e0 hook 1, GetActionValue 0x009562d0 hook 2; slots 175-177; each calls the Lua caller
+--   only while the Manager's state, [0x00c7169c]+8, is 2). REPENTOGON's hook of CallInputAction (slot 173) swaps the
+--   callback id to 1464 when it is not in a run; in this build nothing calls CallInputAction outside a run, so the
+--   same answer is made at the accessors: the Manager is not in state 2 (the menu), the callback runs with the entity
+--   nil, and what it answers is the query's answer, as MC_INPUT_ACTION's: a boolean for hook 0 and 1 (a number counts
+--   as true when not 0), a boolean or a float for hook 2 (true is 1.0, false 0.0). Slot 173 is left unused.
+if M.MC_MENU_INPUT_ACTION then
+  local MENU = M.MC_MENU_INPUT_ACTION
+  local MANAGER_PTR = 0x00c7169c
+  local busy = false          -- a callback that reads the input itself (Input.*) must not run this callback again
+  local function menu_query(hook)
+    return function(self, esp)
+      if busy or not listening[MENU] then return nil end
+      local mgr = r32(MANAGER_PTR)
+      if mgr == 0 or r32(mgr + 8) == 2 then return nil end
+      busy = true
+      local ok, res = pcall(run, MENU, hook, nil, hook, r32(esp + 4))
+      busy = false
+      if not ok or res == nil then return nil end
+      if hook == 2 then
+        local v
+        if type(res) == "number" then v = res elseif res == true then v = 1.0 elseif res == false then v = 0.0 else return nil end
+        B.xmm(0, v)
+        return true, 0
+      end
+      local yes
+      if type(res) == "number" then yes = res ~= 0 elseif type(res) == "boolean" then yes = res else return nil end
+      return true, yes and 1 or 0
+    end
+  end
+  on("Input::IsActionPressed", { MENU }, menu_query(0), nil)
+  on("Input::IsActionTriggered", { MENU }, menu_query(1), nil)
+  on("Input::GetActionValue", { MENU }, menu_query(2), nil)
+end
