+#if defined(ISAAC_NATIVE) && ISAAC_NATIVE
+LUA_SHIM(lua_getstack) {
+    uint32_t va = isaac_arg(cpu, 2);
+    if (!isaac_is_guest_va(va) || !isaac_is_guest_va(va + GDBG_SIZE - 1)) { cpu->EAX = 0; return; }
+    lua_Debug ar;
+    dbg_from_guest(va, &ar);
+    cpu->EAX = (uint32_t)lua_getstack(L_ARG(0), I_ARG(1), &ar);
+    if (cpu->EAX) isaac_w32(va + GDBG_CI, isaac_va(ar.i_ci));  /* getstack sets only i_ci */
+}
+#else
 LUA_SHIM(lua_getstack) { cpu->EAX = (uint32_t)lua_getstack(L_ARG(0), I_ARG(1), (lua_Debug *)P_ARG(2)); }
+#endif
 
