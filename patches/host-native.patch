+    check("Isaac.FindByType", #Isaac.FindByType(10, 0, -1, false, false) >= 1)
+    note("FindInRadius found " .. #Isaac.FindInRadius(e.Position, 40) .. " (all partitions)")
+    check("Isaac.GetRoomEntities", #Isaac.GetRoomEntities() >= 2)
