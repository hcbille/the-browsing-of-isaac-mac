+-- lab_roomconfig_test.lua (development only; ISAAC_RGON_LAB=lab_roomconfig_test.lua, chunk A1)
+-- Checks RoomConfig.GetRoomByStageTypeAndVariant / RoomConfigHolder.GetRoomByStageTypeAndVariant of api_roomconfig.lua in
+-- a running game: for every room of the level, the lookup by the room's own StageID, Type and Variant gives the same
+-- config (same address) the game loaded for the descriptor, on four floors (`stage` console command: Basement I, Caves I,
+-- Depths I, Flooded Caves I); an unknown variant is nil; argument errors; the mode argument. Prints
+-- "lab_roomconfig_test: PASS/FAIL ..." and a final count.
+local T = ...
+local B = T.B
+local ptr, r16, r32, ri32 = B.ptr, B.r16, B.r32, B.ri32
+local mod = RegisterMod("rgon lab roomconfig test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_roomconfig_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+-- asked at load time, before any level exists (Custom Stage API asks then)
+local early_ok, early = pcall(function() return RoomConfig.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0) end)
+local function get(f, ...) local ok, v = pcall(f, ...) return ok, v end
+
+local function names_checks()
+  check("RoomConfig.GetRoomByStageTypeAndVariant is a function", type(RoomConfig) == "table" and type(RoomConfig.GetRoomByStageTypeAndVariant) == "function")
+  check("RoomConfigHolder.GetRoomByStageTypeAndVariant is a function", type(RoomConfigHolder) == "table" and type(RoomConfigHolder.GetRoomByStageTypeAndVariant) == "function")
+  check("REPENTOGON.Implemented lists RoomConfig.GetRoomByStageTypeAndVariant", REPENTOGON == nil or REPENTOGON.Implemented == nil or REPENTOGON.Implemented["RoomConfig.GetRoomByStageTypeAndVariant"] == true)
+end
+
+local function error_checks()
+  local f = RoomConfig.GetRoomByStageTypeAndVariant
+  check("asked at load time (no level yet): a room, the same one as now", early_ok and early ~= nil and ptr(early) == ptr(RoomConfig.GetRoomByStageTypeAndVariant(StbType.BASEMENT, 1, 1, 0)) and early.Variant == 1, tostring(early_ok) .. " " .. tostring(early))
+  check("two arguments is an error", not pcall(f, 0, 1))
+  check("stage 37 is an error", not pcall(f, 37, 1, 1, 0))
+  check("stage -1 is an error", not pcall(f, -1, 1, 1, 0))
+  check("type 0 is an error", not pcall(f, 0, 0, 1, 0))
+  check("type 30 is an error", not pcall(f, 0, 30, 1, 0))
+  check("a string stage is an error", not pcall(f, "x", 1, 1, 0))
+  check("a nil type is an error", not pcall(f, 0, nil, 1, 0))
+  check("an unknown variant is nil", f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 999999, 0) == nil)
+  check("a negative variant is nil", f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, -5, 0) == nil)
+  check("an unknown variant is nil also for RoomConfigHolder", RoomConfigHolder.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 999999) == nil)
+  -- the mode argument
+  local a = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1)
+  local b = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, -1)
+  local c = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0)
+  local d = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 7)
+  local e = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, -2)
+  check("Basement type 1 variant 1 exists", a ~= nil and ptr(a) ~= 0)
+  check("mode omitted, -1, 0 (a normal-mode game), 7 and -2 give the same room",
+    a and b and c and d and e and ptr(a) == ptr(b) and ptr(b) == ptr(c) and ptr(c) == ptr(d) and ptr(d) == ptr(e),
+    a and string.format("%x %x %x %x %x", ptr(a), ptr(b), ptr(c), ptr(d), ptr(e)))
+  if a then
+    check("the room says Type 1 Variant 1 StageID Basement Mode 0", a.Type == 1 and a.Variant == 1 and a.StageID == StbType.BASEMENT and ri32(ptr(a) + 4) == 0, a.Type .. " " .. a.Variant .. " " .. a.StageID)
+    check("the room has a name, a shape and a difficulty", type(a.Name) == "string" and a.Shape == 1 and type(a.Difficulty) == "number", tostring(a.Name) .. " " .. tostring(a.Shape) .. " " .. tostring(a.Difficulty))
+    check("Weight, Subtype, Doors, Width, Height read", type(a.Weight) == "number" and a.Subtype == 0 and type(a.Doors) == "number" and a.Width > 0 and a.Height > 0, string.format("%s %s %s %s %s", a.Weight, a.Subtype, a.Doors, a.Width, a.Height))
+    local okS, sp = get(function() return a.Spawns end)
+    check("Spawns reads", okS and sp ~= nil, tostring(sp))
+    check("two lookups give the same address", ptr(RoomConfig.GetRoomByStageTypeAndVariant(StbType.BASEMENT, 1, 1, 0)) == ptr(a))
+    check("RoomConfigHolder gives the same address as RoomConfig", ptr(RoomConfigHolder.GetRoomByStageTypeAndVariant(StbType.BASEMENT, 1, 1, 0)) == ptr(a))
+  end
+  -- greed set (mode 1): the room, when there is one, is one of the greed set
+  local g = f(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 1)
+  check("mode 1 gives nil or a room of mode 1", g == nil or ri32(ptr(g) + 4) == 1, g and ri32(ptr(g) + 4))
+  local gs = f(StbType.GREED_SHOP or 24, RoomType.ROOM_SHOP, 1, 1)
+  say("info: greed lookup (stage " .. tostring(StbType.GREED_SHOP or 24) .. " type shop variant 1 mode 1) -> " .. tostring(gs and string.format("%x mode %d", ptr(gs), ri32(ptr(gs) + 4)) or "nil"))
+  -- the special rooms set
+  local sr = f(StbType.SPECIAL_ROOMS, RoomType.ROOM_SHOP, 1, 0)
+  check("special rooms: a shop variant 1 is found", sr ~= nil and sr.Type == RoomType.ROOM_SHOP and sr.Variant == 1, sr and (sr.Type .. " " .. sr.Variant))
+end
+
+local seen_stage = {}
+local function floor_checks(tag)
+  local level = Game():GetLevel()
+  local n, same, fieldsame, holder_same, gotclass, classok = 0, 0, 0, 0, 0, 0
+  local bad = {}
+  local cls_ref
+  for i = 0, level:GetRoomCount() - 1 do
+    local d = level:GetRooms():Get(i)
+    local data = d and d.Data
+    if data then
+      n = n + 1
+      cls_ref = cls_ref or getmetatable(data)
+      local dp = ptr(data)
+      local mode = ri32(dp + 4)
+      local r = RoomConfig.GetRoomByStageTypeAndVariant(data.StageID, data.Type, data.Variant, mode)
+      local r2 = RoomConfigHolder.GetRoomByStageTypeAndVariant(data.StageID, data.Type, data.Variant)
+      if r and ptr(r) == dp then same = same + 1 else bad[#bad + 1] = string.format("idx %d stage %d type %d var %d mode %d: got %s want %x", d.GridIndex, data.StageID, data.Type, data.Variant, mode, r and string.format("%x", ptr(r)) or "nil", dp) end
+      if r and r.Type == data.Type and r.Variant == data.Variant and r.Subtype == data.Subtype and r.Shape == data.Shape and r.Name == data.Name
+        and r.Weight == data.Weight and r.Difficulty == data.Difficulty and r.StageID == data.StageID and r.Doors == data.Doors
+        and r16(ptr(r) + 0x44) == r16(dp + 0x44) then fieldsame = fieldsame + 1 end
+      if r2 and r and ptr(r2) == ptr(r) then holder_same = holder_same + 1 end
+      if r and getmetatable(r) == cls_ref then classok = classok + 1 end
+      seen_stage[data.StageID] = true
+    end
+  end
+  check(tag .. ": the level has rooms", n > 0, n .. " rooms; " .. level:GetName())
+  check(tag .. ": lookup by StageID/Type/Variant/Mode gives the game's own config for every room", n > 0 and same == n, same .. " of " .. n .. (#bad > 0 and ("; first miss: " .. bad[1]) or ""))
+  check(tag .. ": Type, Variant, Subtype, Shape, Name, Weight, Difficulty, Doors, spawn count equal for every room", n > 0 and fieldsame == n, fieldsame .. " of " .. n)
+  check(tag .. ": RoomConfigHolder gives the same room for every room", n > 0 and holder_same == n, holder_same .. " of " .. n)
+  check(tag .. ": every result has the class of RoomDescriptor.Data", n > 0 and classok == n, classok .. " of " .. n)
+  -- the current room, with the default mode
+  local cd = level:GetCurrentRoomDesc()
+  if cd and cd.Data then
+    local r = RoomConfig.GetRoomByStageTypeAndVariant(cd.Data.StageID, cd.Data.Type, cd.Data.Variant)
+    check(tag .. ": the current room, mode omitted", r ~= nil and ptr(r) == ptr(cd.Data), string.format("%x vs %x", r and ptr(r) or 0, ptr(cd.Data)))
+    -- the same room again with the current room's own variant but a wrong type is nil or another room
+    local wrong = RoomConfig.GetRoomByStageTypeAndVariant(cd.Data.StageID, RoomType.ROOM_DEFAULT, 888888, 0)
+    check(tag .. ": a wrong variant is nil", wrong == nil)
+  end
+  say(string.format("info: %s: stage %d type %d '%s', %d rooms, StageIDs seen so far:%s", tag, level:GetStage(), level:GetStageType(), level:GetName(), n,
+    (function() local s = "" for k in pairs(seen_stage) do s = s .. " " .. k end return s end)()))
+end
+
+-- phases: the first floor, then `stage` changes; each waits for the new level and 25 frames
+local floors = { "3", "5", "3b" }
+local step, wait, fi = 0, 0, 0
+local newlevel = false
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function() newlevel = true end)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  wait = wait + 1
+  if step == 0 and wait == 20 then
+    names_checks()
+    error_checks()
+    floor_checks("Basement I")
+    step, wait, fi = 1, 0, 1
+    newlevel = false
+    say("stage " .. floors[1])
+    Isaac.ExecuteCommand("stage " .. floors[1])
+  elseif step == 1 then
+    if newlevel and wait >= 40 then
+      floor_checks("stage " .. floors[fi])
+      if fi < #floors then
+        fi, wait, newlevel = fi + 1, 0, false
+        say("stage " .. floors[fi])
+        Isaac.ExecuteCommand("stage " .. floors[fi])
+      else
+        step = 2
+        local kinds = 0
+        for _ in pairs(seen_stage) do kinds = kinds + 1 end
+        check("rooms of at least three different StageIDs were looked up", kinds >= 3, kinds)
+        say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+      end
+    elseif wait > 600 then
+      check("floor " .. floors[fi] .. " arrived", false, "no new level in 600 frames")
+      step = 2
+      say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+    end
+  end
+end)
