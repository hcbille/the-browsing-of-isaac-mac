+-- lab_b2shot.lua (development only; ISAAC_RGON_LAB=lab_b2shot.lua, census batch 2): a laser and then a knife
+-- in a real run with the 95 mods (Epiphany among them), for a screenshot (ISAAC_MAC_SHOT=@N:png).
+-- Phase 1 (frames 5-70): Technology, the laser coloured through EntityPlayer:SetLaserColor, shooting right.
+-- Phase 2 (frames 80-150): Mom's Knife, and its Lua object read through the new EntityKnife names.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab b2shot", 1)
+local function say(s) B.log("lab_b2shot: " .. s) end
+local held = {}
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 5 then
+    p:AddCollectible(CollectibleType.COLLECTIBLE_TECHNOLOGY, 0, false)
+    p:SetLaserColor(Color(0, 1, 0.2, 1, 0, 0, 0))
+    say("SetLaserColor -> LaserColor " .. p.LaserColor.R .. " " .. p.LaserColor.G .. " " .. p.LaserColor.B)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  elseif frame == 45 then
+    local lasers = Isaac.FindByType(7)
+    say("lasers on screen " .. #lasers)
+    for _, l in ipairs(lasers) do say(string.format("  laser variant %d color %g %g %g", l.Variant, l:GetColor().R, l:GetColor().G, l:GetColor().B)) end
+    local w = p:GetWeapon(1)
+    say("weapon type " .. tostring(w and w:GetWeaponType()) .. " fired " .. tostring(w and w:GetNumFired()))
+  elseif frame == 75 then
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+    p:RemoveCollectible(CollectibleType.COLLECTIBLE_TECHNOLOGY)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_MOMS_KNIFE, 0, false)
+    for i = 1, 4 do Isaac.Spawn(10, 0, 0, p.Position + Vector(70 + 25 * i, (i % 2) * 20 - 10), Vector(0, 0), nil) end
