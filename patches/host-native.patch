+    check("BossPool:GetEntries", #entries >= 1 and entries[1].bossID >= 1 and entries[1].bossID < 200 and entries[1].weight >= 0, #entries)
+    local sum, ok = 0, true
+    for _, e in ipairs(entries) do sum = sum + e.weight if e.bossID < 1 or e.bossID >= 200 then ok = false end end
+    check("BossPool entries sane, weights sum to GetWeight", ok and near(sum, pool:GetWeight(), 0.01), sum .. " vs " .. tostring(pool:GetWeight()))
+    check("BossPool:GetRNG", pool:GetRNG():GetSeed() ~= 0)
+    check("BossPool invalid id errors", pcall(BossPoolManager.GetPool, 99) == false)
+    local rem = BossPoolManager.GetRemovedBosses()
+    check("GetRemovedBosses is a table", type(rem) == "table")
+    check("GetLevelBlacklist is a table", type(BossPoolManager.GetLevelBlacklist()) == "table")
+    check("BossPool:GetDoubleTroubleRoomVariantStart", math.type(pool:GetDoubleTroubleRoomVariantStart()) == "integer")
+  end)
