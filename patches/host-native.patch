+            wf32(at, res.X) wf32(at + 4, res.Y)
+            offset = res
+          end
+        end
+        return { g, offset, keep, t }
+      end, function(self, esp, eax, k)
+        if not k then return end
+        if k[3] then w32(k[3][1], k[3][2]) w32(k[3][1] + 4, k[3][3]) end
+        if wants(post, k[4]) then run(post, k[4], k[1], k[2]) end
+      end)
+    end
+    grid_render("GridEntity_Door::Render", M.MC_PRE_GRID_ENTITY_DOOR_RENDER, M.MC_POST_GRID_ENTITY_DOOR_RENDER, "ToDoor")
+    grid_render("GridEntity_Wall::Render", M.MC_PRE_GRID_ENTITY_WALL_RENDER, M.MC_POST_GRID_ENTITY_WALL_RENDER, nil)
+    -- one function draws the gravity, spikes, stairs, TNT, trapdoor and web grids (slot 212): only the trapdoor's callbacks are wired
+    grid_render("GridEntity_Shared::Render", M.MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER, M.MC_POST_GRID_ENTITY_TRAPDOOR_RENDER, nil, GT.GRID_TRAPDOOR)
+
+    -- MC_POST_GRID_ROCK_DESTROY (1011): (rock, type, immediate, source), param = the grid type, after GridEntityRock:Destroy
+    -- returned true. Destroy(bool immediate, EntityRef* source), ret 8; the source is nil when GridEntity:Destroy was used.
+    local ROCK_DESTROY = M.MC_POST_GRID_ROCK_DESTROY
+    if ROCK_DESTROY then
+      on("GridEntity_Rock::Destroy", { ROCK_DESTROY }, function(self, esp)
+        local t = r32(self + 4)
+        if not wants(ROCK_DESTROY, t) then return end
+        local src = r32(esp + 8)
+        return { t, bool_at(esp + 4), src ~= 0 and ref_copy(src) or nil }
+      end, function(self, esp, eax, k)
+        if not k or (eax & 0xff) == 0 then return end
