+-- lab_tarn.lua (development only; ISAAC_RGON_LAB=lab_tarn.lua): why does Epiphany's Tarnished character-menu page never show?
+-- Logs, on change only, the character menu's state and Epiphany's menu module state (Epiphany.MENU), and the
+-- arguments of MC_POST_SAVESLOT_LOAD.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab tarn", 1)
+local last = {}
+local function chg(key, val)
+  if last[key] ~= val then last[key] = val; B.log("lab_tarn: " .. key .. " = " .. tostring(val)); return true end
+end
+mod:AddCallback(ModCallbacks.MC_POST_SAVESLOT_LOAD, function(_, a, b, c)
+  B.log(string.format("lab_tarn: POST_SAVESLOT_LOAD args %s %s %s", tostring(a), tostring(b), tostring(c)))
+end)
+mod:AddCallback(ModCallbacks.MC_POST_ACHIEVEMENT_UNLOCK, function(_, a)
+  last.ach = (last.ach or 0) + 1
+  if last.ach <= 3 or last.ach % 100 == 0 then B.log("lab_tarn: POST_ACHIEVEMENT_UNLOCK #" .. last.ach .. " id " .. tostring(a)) end
+end)
+local f = 0
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  f = f + 1
+  local am = MenuManager.GetActiveMenu()
+  chg("activeMenu", am)
+  if am ~= MainMenuType.CHARACTER then return end
+  local bg = CharacterMenu.GetBGSprite()
+  local ok, anim = pcall(bg.GetAnimation, bg)
+  local fr = ok and bg:GetFrame() or "?"
+  chg("bg", tostring(anim) .. "@" .. tostring(fr))
+  chg("page", CharacterMenu.GetSelectedCharacterMenu())
+  local E = rawget(_G, "Epiphany")
+  local M = E and E.MENU
+  if M then
+    chg("M.lastSaveLoaded", M.lastSaveLoaded)
+    chg("M.current", M.currentMenu and M.currentMenu[M.lastSaveLoaded])
+    chg("M.next", M.nextMenu and M.nextMenu[M.lastSaveLoaded])
+    chg("M.swapping", M.swapping)
+    chg("M.taintedsUnlocked", M:AreTaintedsUnlocked())
+    chg("E.IsMenuUnlocked", E:IsMenuUnlocked())
+    chg("M.accessible", M:IsMenuAccessible())
+  else chg("Epiphany.MENU", "nil") end
+end)
