+  check(l and near(l[1] + 0.09, base.plan_lens, 0.003), "with the Lens: the lens callback sees the chance before its 0.09: " .. tostring(l and l[1]))
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = function(c) return c + 0.2 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, base.plan_lens + 0.2, 0.004), "with the Lens: answer +0.2 applies exactly once: " .. tostring(v) .. " vs " .. tostring(base.plan_lens))
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = nil
+  pl():TryRemoveTrinket(TrinketType.TRINKET_TELESCOPE_LENS)
+end)
+
+-- 3. shop purchase
+step(function()
+  clear_pickups()
+  for _, n in ipairs(NAMES) do reset(n) end
+  local p = pl()
+  p:AddCoins(20)
+  p:AddMaxHearts(2)
+  p:AddHearts(-2)
+  local e = Isaac.Spawn(5, 10, 1, p.Position, Vector(0, 0), nil)
