diff --git a/scripts/recomp/rgon/api_console.lua b/scripts/recomp/rgon/api_console.lua
new file mode 100644
index 0000000..74f1da2
--- /dev/null
+++ b/scripts/recomp/rgon/api_console.lua
@@ -0,0 +1,240 @@
+-- api_console.lua -- MC_CONSOLE_AUTOCOMPLETE (1120) in the game's own debug console.
+--
+-- REPENTOGON fires it from its ImGui console. This game's console has no completion, so the layer reads the console's
+-- input line while it is open, fires the callback itself, and draws a suggestion box above the console's text. Tab
+-- puts the first suggestion in the input line; Tab again goes to the next one.
+--
+-- Measured in this build (docs/mac/layer-gaps.md section 9, worker console, wave 7). The console is a part of the
+-- game object (word at 0x00c71678): +0x68d78 its state (0 closed, 1 opening, 2 open, 4 closing), +0x68d94 the input
+-- line (an MSVC std::string, the console's +0x1c), +0x68e80 the cursor (a pointer into the line's text), +0x68e84 a
+-- counter the char callback zeroes. The game's char callback (0x00686730, cdecl (window, codepoint), codepoints
+-- 0x20..0x7f only) inserts a character at the cursor; Tab is not used by the console.
+--
+-- What it does:
+--   * the first word of the line is a command a mod registered with Console.RegisterCommand: its name (and its
+--     description) is suggested while the word is typed;
+--   * the line is "<command> <params>" and the command's autocomplete type is AutocompleteType.CUSTOM: 1120 runs, with
+--     the command as its parameter and as its first argument, the text after the command as its second; every time the
+--     line changes. A returned table holds strings, or { text, description } tables. Tables returned by several mods
+--     are joined. An entry is shown when "<command> <text>" starts with the line, or its description contains the
+--     text after the command (REPENTOGON's rule). Tab inserts "<command> <text>".
+local T = ...
+local B, R = T.B, T.R
+local r32, log = B.r32, B.log
+local type, pairs, ipairs, tostring, pcall, rawget, rawset = type, pairs, ipairs, tostring, pcall, rawget, rawset
+local lower, sub, find = string.lower, string.sub, string.find
+
+local GAME_PTR = 0x00c71678
+local CSTATE, CLINE, CCURSOR, CCOUNT = 0x68d78, 0x68d94, 0x68e80, 0x68e84
+local OPEN = 2
+local CHAR_CALLBACK = 0x00686730
+local CUSTOM = (rawget(_G, "AutocompleteType") or {}).CUSTOM or 18
+local SHOWN = 8                                   -- how many suggestions the box holds
+
+local id = ModCallbacks and ModCallbacks.MC_CONSOLE_AUTOCOMPLETE
+if not id then log("api_console: no ModCallbacks.MC_CONSOLE_AUTOCOMPLETE") return end
+local commands = T.console_commands
+if type(commands) ~= "table" then log("api_console: Console.RegisterCommand keeps no list") return end
+
+-- the callback's answers are joined (REPENTOGON's console takes one table; two mods that both filter on the same
+-- command would otherwise lose one of them)
+T.RULE[id] = function(_, it, ...)
+  local out
+  for cb in it do
+    local ok, ret = pcall(cb.Function, cb.Mod, ...)
+    if not ok then
+      local who = type(cb.Mod) == "table" and tostring(cb.Mod.Name) or "?"
+      local msg = '"MC_CONSOLE_AUTOCOMPLETE" from "' .. who .. '" failed: ' .. tostring(ret)
+      Isaac.DebugString(msg)
+      pcall(Isaac.ConsoleOutput, msg .. "\n")
+    elseif type(ret) == "table" then
+      out = out or {}
+      for _, v in ipairs(ret) do out[#out + 1] = v end
+    end
+  end
+  return out
+end
+
+------------------------------------------------------------------------------
+-- the console's line
+------------------------------------------------------------------------------
+local function console()
+  local g = r32(GAME_PTR)
+  if g == 0 or r32(g + CSTATE) ~= OPEN then return nil end
+  return g + CSTATE
+end
+local function line_of(c)
+  local ok, s = pcall(B.stdstr, c + (CLINE - CSTATE))
+  return ok and s or nil
+end
+
+-- Replace the line with `text`: what fits the string's capacity is written in place, the rest goes in through the
+-- game's own character callback (it grows the string with the game's allocator).
+local function set_line(c, text)
+  local s = c + (CLINE - CSTATE)
+  local cap = r32(s + 20)
+  local buf = cap >= 16 and r32(s) or s
+  local n = math.min(#text, cap)
+  for i = 1, n do B.w8(buf + i - 1, text:byte(i)) end
+  B.w8(buf + n, 0)
+  B.w32(s + 16, n)
+  B.w32(c + (CCURSOR - CSTATE), buf + n)
+  B.w32(c + (CCOUNT - CSTATE), 0)
+  for i = n + 1, #text do B.call(CHAR_CALLBACK, nil, 0, text:byte(i)) end
+end
+
+------------------------------------------------------------------------------
+-- suggestions
+------------------------------------------------------------------------------
+local function str(v)             -- Lua's lua_tostring: a string or a number, nothing else
+  local t = type(v)
+  if t == "string" then return v end
+  if t == "number" then return tostring(v) end
+end
+local function entry_of(v, cmd)
+  local text, desc = str(v), nil
+  if type(v) == "table" then text, desc = str(v[1]), str(v[2]) end
+  if not text then return nil end
+  return { text = cmd .. " " .. text, desc = desc or "" }
+end
+
+local function suggestions(line)
+  local text = line:gsub("^%s+", "")
+  local out = {}
+  if text == "" then return out end
+  local cmd, rest = text:match("^(%S+)%s(.*)$")
+  if not cmd then
+    -- still typing the command: the registered ones that start with it
+    local want = lower(text)
+    local names = {}
+    for name in pairs(commands) do names[#names + 1] = name end
+    table.sort(names)
+    for _, name in ipairs(names) do
+      local c = commands[name]
+      if c.ShowOnMenu ~= false and sub(lower(name), 1, #want) == want then
+        out[#out + 1] = { text = name, desc = type(c.Description) == "string" and c.Description or "" }
+        if #out >= SHOWN then break end
+      end
+    end
+    return out
+  end
+  local c = commands[cmd] or commands[lower(cmd)]
+  if not c or c.AutocompleteType ~= CUSTOM then return out end
+  local ok, answer = pcall(Isaac.RunCallbackWithParam, id, cmd, cmd, rest)
+  if not ok then log("api_console: the callback failed: " .. tostring(answer)) return out end
+  if type(answer) ~= "table" then return out end
+  local want, want_rest, seen = lower(text), lower(rest), {}
+  for _, v in ipairs(answer) do
+    local e = entry_of(v, cmd)
+    if e and not seen[e.text] then
+      seen[e.text] = true
+      if sub(lower(e.text), 1, #want) == want or (e.desc ~= "" and find(lower(e.desc), want_rest, 1, true)) then
+        out[#out + 1] = e
+        if #out >= SHOWN then break end
+      end
+    end
+  end
+  return out
+end
+
+------------------------------------------------------------------------------
+-- the box (drawn after the console itself: api_hooks.lua calls T.console_draw from the hook after Console::Render)
+------------------------------------------------------------------------------
+local font, px
+local PX_ANM = 'C:/rgon_images/console/px.anm2'
+local PX_PNG = 'C:/rgon_images/console/px.png'
+local ANM = '<AnimatedActor><Info CreatedBy="rgon" CreatedOn="" Fps="30" Version="1"/><Content><Spritesheets><Spritesheet Id="0" Path="px.png"/></Spritesheets><Layers><Layer Id="0" Name="Px" SpritesheetId="0"/></Layers><Nulls/><Events/></Content><Animations DefaultAnimation="Idle"><Animation Name="Idle" FrameNum="1" Loop="true"><RootAnimation><Frame XPosition="0" YPosition="0" Delay="1" Visible="true" XScale="100" YScale="100" RedTint="255" GreenTint="255" BlueTint="255" AlphaTint="255" RedOffset="0" GreenOffset="0" BlueOffset="0" Rotation="0" Interpolated="false"/></RootAnimation><LayerAnimations><LayerAnimation LayerId="0" Visible="true"><Frame XPosition="0" YPosition="0" XPivot="0" YPivot="0" XCrop="0" YCrop="0" Width="1" Height="1" XScale="100" YScale="100" Delay="1" Visible="true" RedTint="255" GreenTint="255" BlueTint="255" AlphaTint="255" RedOffset="0" GreenOffset="0" BlueOffset="0" Rotation="0" Interpolated="false"/></LayerAnimation></LayerAnimations><NullAnimations/><Triggers/></Animation></Animations></AnimatedActor>'
+
+local function setup()
+  font = Font()
+  font:Load("font/terminus8.fnt")
+  if B.fs_seed and B.png_encode and B.fs_seed(PX_PNG, B.png_encode(1, 1, "\255\255\255\255")) and B.fs_seed(PX_ANM, ANM) then
+    px = Sprite()
+    px:Load(PX_ANM, true)
+    px:Play("Idle", true)
+    px:ReplaceSpritesheet(0, PX_PNG)
+    px:LoadGraphics()
+  end
+end
+local function rect(x, y, w, h, r, g, b, a)
+  if not px then return end
+  px.Scale = Vector(w, h)
+  px.Color = Color(r, g, b, a, 0, 0, 0)
+  px:Render(Vector(x, y), Vector(0, 0), Vector(0, 0))
+end
+
+-- where the box sits: its left edge and its bottom. Console::Render's drawing space is 480 x 270 (the window's 1920 x 1080 is four
+-- times it, measured with a rect and a text drawn from the hook); the input line is at y 169, so the box ends just above it
+local BOX_X, BOX_BOTTOM = 8, 160
+local LINE_H = 10
+local WHITE, GREY, GOLD = KColor(1, 1, 1, 1), KColor(0.62, 0.62, 0.62, 1), KColor(1, 0.85, 0.3, 1)
+
+local current = {}                                -- what the box shows
+local sel = 0                                     -- the Tab position (0: none yet)
+local shown_line, inserted
+
+local function draw()
+  if #current == 0 then return end
+  if not font then setup() end
+  local w = 0
+  for _, e in ipairs(current) do
+    local n = #e.text + (e.desc ~= "" and #e.desc + 3 or 0)
+    if n > w then w = n end
+  end
+  w = math.min(w * 6 + 8, 456)
+  local h = #current * LINE_H + 4
+  local top = BOX_BOTTOM - h
+  rect(BOX_X - 3, top - 2, w + 4, h + 4, 0.55, 0.55, 0.55, 0.9)
+  rect(BOX_X - 2, top - 1, w + 2, h + 2, 0.05, 0.05, 0.08, 0.92)
+  for i, e in ipairs(current) do
+    local y = top + 2 + (i - 1) * LINE_H
+    if i == sel then rect(BOX_X - 1, y, w, LINE_H, 0.25, 0.22, 0.05, 1) end
+    font:DrawString(e.text, BOX_X + 2, y, i == sel and GOLD or WHITE, 0, false)
+    if e.desc ~= "" then
+      local room = math.floor((w - 4) / 6) - #e.text - 3
+      local d = #e.desc > room and (room > 3 and sub(e.desc, 1, room - 3) .. "..." or "") or e.desc
+      if d ~= "" then font:DrawString("- " .. d, BOX_X + 2 + (#e.text + 1) * 6, y, GREY, 0, false) end
+    end
+  end
+end
+
+local TAB_OFF = B.env("ISAAC_CONSOLE_TAB") == "0"      -- a switch for finding what else reacts to the Tab key
+local function tab_pressed()
+  return not TAB_OFF and Input and Input.IsButtonTriggered and Input.IsButtonTriggered(Keyboard.KEY_TAB, 0)
+end
+
+local function on_render()
+  local c = console()
+  if not c then
+    if shown_line then current, shown_line, inserted, sel = {}, nil, nil, 0 end
+    return
+  end
+  local line = line_of(c)
+  if not line then return end
+  if line ~= shown_line then
+    shown_line = line
+    if line == inserted then
+      -- Tab put this line in: the list stays, the cursor is on it
+    else
+      inserted, sel = nil, 0
+      current = suggestions(line)
+    end
+  end
+  if tab_pressed() and #current > 0 then
+    sel = sel % #current + 1
+    inserted = current[sel].text
+    set_line(c, inserted)
+    shown_line = line_of(c) or inserted
+  end
+end
+
+local said = 0
+T.console_draw = function()
+  if shown_line and #current > 0 and said < 3 then said = said + 1 log("api_console: draw hook, line " .. tostring(shown_line) .. ", " .. #current .. " suggestions, px " .. tostring(px ~= nil)) end
+  if shown_line then local ok, err = pcall(draw) if not ok and said < 8 then said = said + 1 log("api_console: draw failed: " .. tostring(err)) end end
+end   -- from the hook after Console::Render (api_hooks.lua)
+T.listen(ModCallbacks.MC_POST_RENDER, on_render)
+
+R.Implemented[id] = true
+R.Implemented["Console.RegisterCommand"] = true
+T.console_suggestions = suggestions               -- for the lab
