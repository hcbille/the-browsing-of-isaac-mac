+
+  -- ItemPool
+  local pool = Game():GetItemPool()
+  local p = T.this(pool, "lab")
+  check("HasCollectible", pool:HasCollectible(1) == true and pool:HasCollectible(-1) == false and pool:HasCollectible(99999) == false)
+  pool:RemoveCollectible(1)
+  check("HasCollectible after RemoveCollectible", pool:HasCollectible(1) == false)
+  pool:ResetCollectible(1)
+  check("HasCollectible after ResetCollectible", pool:HasCollectible(1) == true)
+  check("HasTrinket", pool:HasTrinket(1) == true and pool:HasTrinket(0) == false and pool:HasTrinket(99999) == false)
+  local tv = r32(p + 0x794)
+  local function tdump(id) return string.format("%08x %08x", r32(tv + 8 * id), r32(tv + 8 * id + 4)) end
+  local t_before = tdump(1)
+  local function snapshot()
+    local s = {}
+    for id = 0, 189 do s[id] = r32(tv + 8 * id + 4) end
+    for i = 0, 20 do s["w" .. i] = r32(p + 0x780 + 4 * i) end
+    return s
+  end
+  local function diff(s)
+    local changed = {}
+    for k, v in pairs(s) do
+      local now = type(k) == "number" and r32(tv + 8 * k + 4) or r32(p + 0x780 + 4 * tonumber(k:sub(2)))
+      if now ~= v then changed[#changed + 1] = string.format("%s:%08x->%08x", tostring(k), v, now) end
+    end
+    return table.concat(changed, " ")
+  end
+  local s1 = snapshot()
+  local okrt = pcall(pool.RemoveTrinket, pool, 2)
+  note("RemoveTrinket(2) ok=" .. tostring(okrt) .. " changed: " .. diff(s1) .. " | HasTrinket(2)=" .. tostring(pool:HasTrinket(2)))
+  check("HasTrinket after RemoveTrinket (an available trinket)", okrt and pool:HasTrinket(2) == false)
+  pool:ResetTrinkets()
+  local s2 = snapshot()
+  local drawn = pool:GetTrinket(false, 31337)
+  note("GetTrinket(false) drew " .. tostring(drawn) .. "; changed: " .. diff(s2) .. " | HasTrinket(drawn)=" .. tostring(pool:HasTrinket(drawn)))
+  check("HasTrinket after the game draws a trinket", pool:HasTrinket(drawn) == false, drawn)
+  local nin, nav = 0, 0
+  for id = 1, 189 do if B.r8(tv + 8 * id + 4) ~= 0 then nin = nin + 1 end if B.r8(tv + 8 * id + 5) ~= 0 then nav = nav + 1 end end
+  note("trinket entries with byte4 set " .. nin .. ", byte5 set " .. nav)
+  pool:ResetTrinkets()
+  check("HasTrinket after ResetTrinkets", pool:HasTrinket(1) == true)
+
+  local rng = RNG() rng:SetSeed(1234, 35)
+  local pick = pool:PickCollectible(0, false, rng)
+  check("PickCollectible", type(pick) == "table" and math.type(pick.itemID) == "integer" and Isaac.GetItemConfig():GetCollectible(pick.itemID) ~= nil
+    and type(pick.weight) == "number" and type(pick.isUnlocked) == "boolean", pick and pick.itemID)
+  check("PickCollectible defaults", type(pool:PickCollectible(0)) == "table")
+  check("PickCollectible bad pool", not pcall(pool.PickCollectible, pool, 99))
+
+  local function data(idx) return call(0x732c70, p, idx) end
+  local function has(d, id) for e = r32(d + 4), r32(d + 8) - 1, 0x18 do if ri32(e) == id then return true end end return false end
+  local d = data(0)
+  local n0, w0 = (r32(d + 8) - r32(d + 4)) // 0x18, rf32(d)
+  local sum_all, sum_unl = 0, 0
+  for e = r32(d + 4), r32(d + 8) - 1, 0x18 do
+    sum_all = sum_all + rf32(e + 8)
+    if B.r8(e + 20) ~= 0 then sum_unl = sum_unl + rf32(e + 8) end
+  end
+  note(string.format("pool 0: total %.3f, sum all %.3f, sum unlocked %.3f", w0, sum_all, sum_unl))
+  local pick_id
+  for id = 1, 732 do
+    local c = Isaac.GetItemConfig():GetCollectible(id)
+    if c and c:IsAvailable() and not has(d, id) then pick_id = id break end
+  end
+  check("found an available item outside pool 0", pick_id ~= nil, pick_id)
+  if pick_id then
+    pool:AddCollectible(0, { itemID = pick_id, weight = 1.0e7, decreaseBy = 0.5, removeOn = 0.1 })
+    d = data(0)
+    local n1, w1 = (r32(d + 8) - r32(d + 4)) // 0x18, rf32(d)
+    check("AddCollectible grows the pool", n1 == n0 + 1 and has(d, pick_id), n0 .. " -> " .. n1)
+    check("AddCollectible adds its weight", w1 > w0 + 9.0e6, w0 .. " -> " .. w1)
+    pool:AddCollectible(0, { itemID = pick_id })
+    check("AddCollectible does not double an item", (r32(data(0) + 8) - r32(data(0) + 4)) // 0x18 == n1)
+    local got = pool:GetCollectible(0, false, 99)
+    check("the game draws the added item", got == pick_id, "got " .. got .. " want " .. pick_id)
+    local pk = pool:PickCollectible(0, false, rng)
+    check("PickCollectible sees the added item", pk and pk.itemID == pick_id, pk and pk.itemID)
+  end
+  for _, s in ipairs({ "The Inner Eye", "Inner Eye", "Sad Onion", "THE_INNER_EYE", "#THE_INNER_EYE_NAME" }) do
+    note("GetItemIdByName('" .. s .. "') = " .. tostring(Isaac.GetItemIdByName(s)))
+  end
+  local nm = "The Inner Eye"
+  local okn, errn = pcall(pool.AddCollectible, pool, 1, { name = nm, weight = 2 })
+  note("by name: '" .. tostring(nm) .. "' -> id " .. tostring(Isaac.GetItemIdByName(nm)) .. " ok " .. tostring(okn) .. " " .. tostring(errn))
+  check("AddCollectible by name", okn and has(data(1), 2) , nm)
+  check("AddCollectible array", pcall(pool.AddCollectible, pool, 2, { { itemID = 2 }, { itemID = 3, weight = 3 } }))
+  check("AddCollectible bad pool", not pcall(pool.AddCollectible, pool, 99, { itemID = 2 }))
+  check("AddCollectible bad table", not pcall(pool.AddCollectible, pool, 0, 5))
+
+  -- the vanilla names the backlog lists as unverified
+  local bl = 0x68c
+  local okb = pcall(pool.AddRoomBlacklist, pool, 5)
+  local first = r32(p + bl)
+  check("AddRoomBlacklist sets the blacklist bit", okb and (r32(first + 0) >> 5) & 1 == 1, okb)
+  local t = pool:GetTrinket(false, 5)
+  check("GetTrinket", math.type(t) == "integer" and t > 0, t)
+  -- ItemPool:GetCollectible's Flags argument: the game's binding ignores it (deferred, not Implemented); measured here
+  local function mix(fl)
+    local act, pas, bad = 0, 0, 0
+    for s = 1, 40 do
+      local ok, id = pcall(pool.GetCollectible, pool, 3, false, s * 977, 0, fl)
+      local c = ok and Isaac.GetItemConfig():GetCollectible(id)
+      if not c then bad = bad + 1 elseif c.Type == 3 then act = act + 1 else pas = pas + 1 end
+    end
+    return act, pas, bad
+  end
+  local a0, p0, b0 = mix(nil)
+  local a1, p1, b1 = mix(1)
+  local a4, p4, b4 = mix(4)
+  note(string.format("GetCollectible(pool 3) actives/passives/errors: no flags %d/%d/%d, BAN_ACTIVES %d/%d/%d, BAN_PASSIVES %d/%d/%d", a0, p0, b0, a1, p1, b1, a4, p4, b4))
+  check("ItemPool.GetCollectible stays out of Implemented while its Flags argument does nothing",
+    REPENTOGON.Implemented["ItemPool.GetCollectible"] ~= true or (a1 == 0 and p4 == 0))
+
+  B.log(string.format("lab_pickup_more: DONE pass=%d fail=%d", pass, fail))
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if frame == 20 then
+    local ok, err = pcall(run)
+    if not ok then check("lab body", false, err) B.log(string.format("lab_pickup_more: DONE pass=%d fail=%d", pass, fail)) end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_pickup_probe.lua b/scripts/recomp/rgon/lab_pickup_probe.lua
new file mode 100644
index 0000000..b53f6ce
--- /dev/null
+++ b/scripts/recomp/rgon/lab_pickup_probe.lua
@@ -0,0 +1,51 @@
+-- lab_pickup_probe.lua (development only; LAB=lab_pickup_probe.lua): why a wrapper rawset over ItemPool's own GetCollectible is not
+-- what `pool.GetCollectible` answers. Logs "lab_pickup_probe: ..." lines. Not a test.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab pickup probe", 1)
+local function say(s) B.log("lab_pickup_probe: " .. s) end
+local started, frame = false, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+
+local function probe()
+  local pool = Game():GetItemPool()
+  local c, const = T.class_tables("ItemPool")
+  local mt = getmetatable(pool)
+  local orig = rawget(c, "GetCollectible")
+  say("orig in c: " .. tostring(orig) .. " pool.GetCollectible: " .. tostring(pool.GetCollectible) .. " equal " .. tostring(orig == pool.GetCollectible))
+  local calls = 0
+  local wrapper = B.cfn(function(self, ...)
+    calls = calls + 1
+    return orig(self, ...)
+  end)
+  rawset(c, "GetCollectible", wrapper)
+  say("after rawset: pool.GetCollectible == wrapper " .. tostring(pool.GetCollectible == wrapper))
+  pool:GetCollectible(3, false, 5, 0)
+  say("pool:GetCollectible reached the wrapper " .. calls .. " time(s)")
+  local fresh = B.obj(mt, B.ptr(pool), T.vt_ptr())
+  say("fresh userdata: fresh.GetCollectible == wrapper " .. tostring(fresh.GetCollectible == wrapper))
+  fresh:GetCollectible(3, false, 5, 0)
+  say("fresh:GetCollectible reached the wrapper, total " .. calls)
+  local g = Game()
+  local pool2 = g:GetItemPool()
+  say("Game():GetItemPool() again == pool: " .. tostring(pool2 == pool) .. " pool2.GetCollectible == wrapper " .. tostring(pool2.GetCollectible == wrapper))
+  if debug and debug.getuservalue then
+    local uv = debug.getuservalue(pool)
+    say("uservalue(pool) = " .. tostring(uv))
+    if type(uv) == "table" then for k, v in pairs(uv) do say("  uv." .. tostring(k) .. " = " .. tostring(v)) end end
+  else
+    say("no debug.getuservalue")
+  end
+  -- the same for a name a mod may call first: HasCollectible of the player
+  rawset(c, "GetCollectible", orig)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if frame == 20 then
+    local ok, err = pcall(probe)
+    if not ok then say("probe failed: " .. tostring(err)) end
+    say("DONE")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_pickup_test.lua b/scripts/recomp/rgon/lab_pickup_test.lua
new file mode 100644
index 0000000..8deb83a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_pickup_test.lua
@@ -0,0 +1,126 @@
+-- lab_pickup_test.lua (development only; LAB=lab_pickup_test.lua): hearts must be picked up with every mod loaded
+-- (Custom Health API answers PRE_PICKUP_COLLISION with an empty table), and a test callback answers a coin's
+-- PRE_PICKUP_COLLISION with each REPENTOGON answer form. Logs "lab_pickup_test: PASS/FAIL ..", then DONE.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab pickup test", 1)
+local function check(name, ok, detail)
+  B.log("lab_pickup_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+
+local mode = nil          -- what the test callback answers for a coin: a function returning the answer
+local fired = 0
+mod:AddPriorityCallback(ModCallbacks.MC_PRE_PICKUP_COLLISION, -1000, function(_, pickup, collider)
+  if mode and pickup.Variant == PickupVariant.PICKUP_COIN and collider.Type == 1 then
+    fired = fired + 1
+    return mode()
+  end
+end)
+
+local steps, frame = {}, 0
+local function at(f, fn) steps[f] = function() local ok, err = pcall(fn) if not ok then check("step " .. f, false, err) end end end
+local function player() return Isaac.GetPlayer(0) end
+local function spawn(variant, sub)
+  local p = player()
+  return Isaac.Spawn(5, variant, sub, p.Position, Vector(0, 0), nil)
+end
+local function count(variant, sub)
+  local n = 0
+  for _, e in ipairs(Isaac.FindByType(5, variant, sub)) do if e:Exists() and not e:IsDead() then n = n + 1 end end
+  return n
+end
+
+-- hearts: Isaac with 2 containers and 1.5 red hearts
+local before
+at(5, function()
+  local p = player()
+  p:AddMaxHearts(-p:GetMaxHearts()) p:AddSoulHearts(-p:GetSoulHearts())
+  p:AddMaxHearts(4, true) p:AddHearts(-99) p:AddHearts(3)
+  check("start: 3 half hearts of red", p:GetHearts() == 3, p:GetHearts())
+  before = p:GetHearts()
+  spawn(PickupVariant.PICKUP_HEART, HeartSubType.HEART_FULL)
+end)
+at(40, function()
+  local p = player()
+  check("red heart: picked up (health changes)", p:GetHearts() > before, before .. " -> " .. p:GetHearts())
+  check("red heart: pickup removed", count(PickupVariant.PICKUP_HEART, HeartSubType.HEART_FULL) == 0)
+  before = p:GetSoulHearts()
+  spawn(PickupVariant.PICKUP_HEART, HeartSubType.HEART_SOUL)
+end)
+at(75, function()
+  local p = player()
+  check("soul heart: picked up (soul hearts change)", p:GetSoulHearts() > before, before .. " -> " .. p:GetSoulHearts())
+  check("soul heart: pickup removed", count(PickupVariant.PICKUP_HEART, HeartSubType.HEART_SOUL) == 0)
+  before = p:GetSoulHearts()
+  spawn(PickupVariant.PICKUP_HEART, HeartSubType.HEART_BLACK)
+end)
+at(110, function()
+  local p = player()
+  check("black heart: picked up (soul hearts change)", p:GetSoulHearts() > before, before .. " -> " .. p:GetSoulHearts())
+  check("black heart: is black", p:GetBlackHearts() ~= 0, p:GetBlackHearts())
+  check("black heart: pickup removed", count(PickupVariant.PICKUP_HEART, HeartSubType.HEART_BLACK) == 0)
+end)
+
+-- the answer forms on a coin: { picked = the coin was collected, fired = the callback ran }
+local cases = {
+  { "empty table {}", function() return {} end, true },
+  { "{ Collide = true }", function() return { Collide = true } end, true },
+  { "{ Collide = false } (the game's code runs, then no collision)", function() return { Collide = false } end, true },
+  { "{ SkipCollisionEffects = true }", function() return { SkipCollisionEffects = true } end, false },
+  { "{ Collide = false, SkipCollisionEffects = true }", function() return { Collide = false, SkipCollisionEffects = true } end, false },
+  { "true", function() return true end, false },
+  { "false", function() return false end, false },
+  { "nil", function() return nil end, true },
+}
+local base = 150
+for i, c in ipairs(cases) do
+  local f = base + (i - 1) * 50
+  local coins
+  at(f, function()
+    mode = c[2] fired = 0
+    coins = player():GetNumCoins()
+    spawn(PickupVariant.PICKUP_COIN, CoinSubType.COIN_PENNY)
+  end)
+  at(f + 35, function()
+    local gained = player():GetNumCoins() - coins
+    check("coin answered " .. c[1] .. ": callback fired", fired > 0, fired)
+    check("coin answered " .. c[1] .. ": " .. (c[3] and "picked up" or "not picked up"), (gained > 0) == c[3], "gained " .. gained)
+    for _, e in ipairs(Isaac.FindByType(5, PickupVariant.PICKUP_COIN, -1)) do e:Remove() end
+    mode = nil
+  end)
+end
+-- a skipped collision leaves no POST_PICKUP_COLLISION; a plain one has it
+local posts = 0
+mod:AddCallback(ModCallbacks.MC_POST_PICKUP_COLLISION, function(_, pickup) if pickup.Variant == PickupVariant.PICKUP_COIN then posts = posts + 1 end end)
+local last = base + #cases * 50
+at(last, function() mode = function() return { SkipCollisionEffects = true } end posts = 0 spawn(PickupVariant.PICKUP_COIN, CoinSubType.COIN_PENNY) end)
+at(last + 30, function()
+  check("SkipCollisionEffects: no POST_PICKUP_COLLISION", posts == 0, posts)
+  for _, e in ipairs(Isaac.FindByType(5, PickupVariant.PICKUP_COIN, -1)) do e:Remove() end
+  mode = function() return { Collide = true } end
+  spawn(PickupVariant.PICKUP_COIN, CoinSubType.COIN_PENNY)
+end)
+at(last + 60, function()
+  check("{ Collide = true }: POST_PICKUP_COLLISION runs", posts > 0, posts)
+  mode = nil
+end)
+
+-- MC_USE_PILL: the pill colour is the fourth argument
+local used
+mod:AddCallback(ModCallbacks.MC_USE_PILL, function(_, effect, p, flags, color) used = { effect, flags, color } end, PillEffect.PILLEFFECT_BALLS_OF_STEEL)
+at(last + 70, function()
+  used = nil
+  player():UsePill(PillEffect.PILLEFFECT_BALLS_OF_STEEL, PillColor.PILL_BLUE_BLUE, UseFlag.USE_NOANIM)
+  check("MC_USE_PILL: fired", used ~= nil)
+  check("MC_USE_PILL: the pill colour is the fourth argument", used and used[3] == PillColor.PILL_BLUE_BLUE, used and used[3])
+  used = nil
+  player():UsePill(PillEffect.PILLEFFECT_BALLS_OF_STEEL, PillColor.PILL_BLACK_YELLOW, UseFlag.USE_NOANIM)
+  check("MC_USE_PILL: a second colour", used and used[3] == PillColor.PILL_BLACK_YELLOW, used and used[3])
+  B.log("lab_pickup_test: DONE")
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local f = steps[frame]
+  if f then f() end
+end)
diff --git a/scripts/recomp/rgon/lab_player_death_cb.lua b/scripts/recomp/rgon/lab_player_death_cb.lua
new file mode 100644
index 0000000..288a55a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_player_death_cb.lua
@@ -0,0 +1,574 @@
+-- lab_player_death_cb.lua (development only; ISAAC_RGON_LAB=lab_player_death_cb.lua, worker cba)
+-- Fires every callback of the "player death / health type / births / cards and pills" group and checks its arguments
+-- and what its answer does to the game: MC_PRE_TRIGGER_PLAYER_DEATH, MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES,
+-- MC_PRE_PLAYER_REVIVE, MC_PLAYER_HEALTH_TYPE_CHANGE, MC_PRE_PLAYER_GIVE_BIRTH_CAMBION/IMMACULATE,
+-- MC_PRE_TRIGGER_BED_SLEEP_EFFECT, MC_PRE_PLAYER_POCKET_ITEMS_SWAP, MC_PRE/POST_PLAYER_ADD_CARD/PILL,
+-- MC_POST_PLAYER_COLLECT_CARD/PILL, MC_POST_PLAYER_DROP_CARD/PILL.
+-- Prints "lab_cba: DONE n PASS m FAIL" when its steps are over. Steps run one after another on MC_POST_UPDATE;
+-- a step that waits for the game (a death, a pickup) has a frame limit and fails when it runs out.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cba", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cba: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cba: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local rec, beh = {}, {}
+local function count(name) return #(rec[name] or {}) end
+local function last(name) local l = rec[name] return l and l[#l] end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function() return v:ToPlayer() and "player" or (v:ToPickup() and ("pickup:" .. v.Variant .. "/" .. v.SubType)) or "entity" end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = {
+  "MC_PRE_TRIGGER_PLAYER_DEATH", "MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES", "MC_PRE_PLAYER_REVIVE", "MC_POST_PLAYER_REVIVE",
+  "MC_PLAYER_HEALTH_TYPE_CHANGE", "MC_PLAYER_GET_HEALTH_TYPE", "MC_PRE_PLAYER_GIVE_BIRTH_CAMBION", "MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE",
+  "MC_PRE_TRIGGER_BED_SLEEP_EFFECT", "MC_PRE_PLAYER_POCKET_ITEMS_SWAP",
+  "MC_PRE_PLAYER_ADD_CARD", "MC_POST_PLAYER_ADD_CARD", "MC_PRE_PLAYER_ADD_PILL", "MC_POST_PLAYER_ADD_PILL",
+  "MC_POST_PLAYER_COLLECT_CARD", "MC_POST_PLAYER_COLLECT_PILL", "MC_POST_PLAYER_DROP_CARD", "MC_POST_PLAYER_DROP_PILL",
+}
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      r.frame = Isaac.GetFrameCount()
+      l[#l + 1] = r
+      if #l <= 6 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+-- a callback registered with a param must only run for that param (the card id here)
+local filtered = 0
+if M.MC_POST_PLAYER_ADD_CARD then
+  mod:AddCallback(M.MC_POST_PLAYER_ADD_CARD, function() filtered = filtered + 1 end, 5)
+end
+
+local function player() return Isaac.GetPlayer(0) end
+local function ptr(p) return B.ptr(p) end
+local function pockets(p)
+  return p:GetCard(0), p:GetCard(1), p:GetPill(0), p:GetPill(1)
+end
+local function clear_pockets(p)
+  for s = 0, 3 do pcall(p.SetCard, p, s, 0) pcall(p.SetPill, p, s, 0) end
+end
+local function remove_pickups()
+  for _, e in ipairs(Isaac.FindByType(EntityType.ENTITY_PICKUP, -1, -1)) do
+    if e.Variant == 300 or e.Variant == 70 then e:Remove() end
+  end
+end
+
+-- steps: { name, wait frames before, function(step_frame) -> true when done }
+local steps = {}
+local function step(name, fn) steps[#steps + 1] = { name = name, fn = fn } end
+local function waits(n, fn)
+  local c = 0
+  return function(f)
+    c = c + 1
+    if c >= n then fn() return true end
+    return false
+  end
+end
+
+------------------------------------------------------------------------------ cards and pills
+step("cards", function()
+  local p = player()
+  clear_pockets(p)
+  say("cards: start " .. table.concat({ pockets(p) }, ","))
+  local base = count("MC_PRE_PLAYER_ADD_CARD")
+  p:AddCard(5)
+  check(count("MC_PRE_PLAYER_ADD_CARD") == base + 1, "AddCard(5): PRE_PLAYER_ADD_CARD fired once")
+  local r = last("MC_PRE_PLAYER_ADD_CARD")
+  check(r and r.n == 3 and r[2] == 5 and r[3] == 0, "PRE_PLAYER_ADD_CARD args (player, 5, slot 0): " .. tostring(r and r.text))
+  local po = last("MC_POST_PLAYER_ADD_CARD")
+  check(po and po.frame == Isaac.GetFrameCount() and po.n == 3 and po[2] == 5 and po[3] == 0, "POST_PLAYER_ADD_CARD args (player, 5, slot): " .. tostring(po and po.text))
+  check(p:GetCard(0) == 5, "the card is in slot 0")
+  check(filtered >= 1, "a POST_PLAYER_ADD_CARD with param 5 ran for card 5 (" .. filtered .. ")")
+  local f0 = filtered
+  p:SetCard(0, 6)
+  check(filtered == f0, "a POST_PLAYER_ADD_CARD with param 5 did not run for card 6")
+  check(p:GetCard(0) == 6, "SetCard(0, 6) put 6 in slot 0")
+  local r2 = last("MC_PRE_PLAYER_ADD_CARD")
+  check(r2 and r2[2] == 6 and r2[3] == 0, "SetCard fires PRE_PLAYER_ADD_CARD (player, 6, slot 0): " .. tostring(r2 and r2.text))
+  -- replacement
+  beh.MC_PRE_PLAYER_ADD_CARD = function(pl, id, slot) if id == 9 then return 12 end end
+  clear_pockets(p)
+  p:AddCard(9)
+  local a, b = p:GetCard(0), p:GetCard(1)
+  check(a == 12 or b == 12, "an answer 12 to the pre callback replaced card 9 (slots " .. a .. "," .. b .. ")")
+  check(a ~= 9 and b ~= 9, "card 9 was not added")
+  local po2 = last("MC_POST_PLAYER_ADD_CARD")
+  check(po2 and po2[2] == 12, "POST_PLAYER_ADD_CARD got the replaced card: " .. tostring(po2 and po2.text))
+  -- cancel
+  beh.MC_PRE_PLAYER_ADD_CARD = function(pl, id, slot) if id == 14 then return false end end
+  clear_pockets(p)
+  local posts = count("MC_POST_PLAYER_ADD_CARD")
+  p:AddCard(14)
+  a, b = p:GetCard(0), p:GetCard(1)
+  check(a ~= 14 and b ~= 14, "an answer false cancelled adding card 14 (slots " .. a .. "," .. b .. ")")
+  check(count("MC_POST_PLAYER_ADD_CARD") == posts, "no POST_PLAYER_ADD_CARD after a cancel")
+  beh.MC_PRE_PLAYER_ADD_CARD = nil
+  clear_pockets(p)
+  return true
+end)
+
+step("pills", function()
+  local p = player()
+  clear_pockets(p)
+  p:AddPill(3)
+  local r = last("MC_PRE_PLAYER_ADD_PILL")
+  check(r and r.n == 3 and r[2] == 3 and r[3] == 0, "PRE_PLAYER_ADD_PILL args (player, 3, slot 0): " .. tostring(r and r.text))
+  local po = last("MC_POST_PLAYER_ADD_PILL")
+  check(po and po[2] == 3 and po[3] == 0, "POST_PLAYER_ADD_PILL args: " .. tostring(po and po.text))
+  check(p:GetPill(0) == 3, "pill 3 is in slot 0")
+  beh.MC_PRE_PLAYER_ADD_PILL = function(pl, id, slot) if id == 4 then return 7 end end
+  clear_pockets(p)
+  p:AddPill(4)
+  check(p:GetPill(0) == 7 or p:GetPill(1) == 7, "an answer 7 replaced pill colour 4 (" .. p:GetPill(0) .. "," .. p:GetPill(1) .. ")")
+  local po2 = last("MC_POST_PLAYER_ADD_PILL")
+  check(po2 and po2[2] == 7, "POST_PLAYER_ADD_PILL got the replaced colour: " .. tostring(po2 and po2.text))
+  beh.MC_PRE_PLAYER_ADD_PILL = function(pl, id, slot) if id == 5 then return false end end
+  clear_pockets(p)
+  local posts = count("MC_POST_PLAYER_ADD_PILL")
+  p:AddPill(5)
+  check(p:GetPill(0) ~= 5 and p:GetPill(1) ~= 5, "an answer false cancelled adding pill colour 5")
+  check(count("MC_POST_PLAYER_ADD_PILL") == posts, "no POST_PLAYER_ADD_PILL after a cancel")
+  beh.MC_PRE_PLAYER_ADD_PILL = nil
+  clear_pockets(p)
+  p:SetPill(0, 8)
+  local r2 = last("MC_PRE_PLAYER_ADD_PILL")
+  check(r2 and r2[2] == 8 and r2[3] == 0 and p:GetPill(0) == 8, "SetPill fires PRE_PLAYER_ADD_PILL and sets the pill: " .. tostring(r2 and r2.text))
+  return true
+end)
+
+step("drops", function()
+  local p = player()
+  clear_pockets(p)
+  remove_pickups()
+  p:AddCard(5)
+  local cards = count("MC_POST_PLAYER_DROP_CARD")
+  p:DropPocketItem(0, p.Position)
+  check(count("MC_POST_PLAYER_DROP_CARD") == cards + 1, "DropPocketItem of a card fired POST_PLAYER_DROP_CARD")
+  local r = last("MC_POST_PLAYER_DROP_CARD")
+  check(r and r[1] and r[2] == "pickup:300/5" or (r and r.text:find("pickup:300/5", 1, true)), "DROP_CARD args (player, pickup 300/5, slot): " .. tostring(r and r.text))
+  check(r and r.n == 3 and r[3] == 0, "DROP_CARD slot is 0")
+  p:AddPill(6)
+  local pills = count("MC_POST_PLAYER_DROP_PILL")
+  p:DropPocketItem(0, p.Position)
+  check(count("MC_POST_PLAYER_DROP_PILL") == pills + 1, "DropPocketItem of a pill fired POST_PLAYER_DROP_PILL")
+  local r2 = last("MC_POST_PLAYER_DROP_PILL")
+  check(r2 and r2.text:find("pickup:70/6", 1, true), "DROP_PILL args (player, pickup 70/6, slot): " .. tostring(r2 and r2.text))
+  -- a full pocket: the new card pushes the old one out as a pickup
+  p:AddCard(5)
+  cards = count("MC_POST_PLAYER_DROP_CARD")
+  p:AddCard(7)
+  check(count("MC_POST_PLAYER_DROP_CARD") == cards + 1, "a full pocket dropped its card when another was added (" .. (count("MC_POST_PLAYER_DROP_CARD") - cards) .. ")")
+  remove_pickups()
+  clear_pockets(p)
+  return true
+end)
+
+local collect
+step("collect", function()
+  local p = player()
+  clear_pockets(p)
+  remove_pickups()
+  collect = { cards = count("MC_POST_PLAYER_COLLECT_CARD"), pills = count("MC_POST_PLAYER_COLLECT_PILL") }
+  Isaac.Spawn(EntityType.ENTITY_PICKUP, 300, 11, p.Position, Vector(0, 0), nil)
+  return true
+end)
+step("collect wait", (function()
+  local c = 0
+  return function()
+    c = c + 1
+    local p = player()
+    if count("MC_POST_PLAYER_COLLECT_CARD") > collect.cards then
+      local r = last("MC_POST_PLAYER_COLLECT_CARD")
+      check(r and r.text:find("pickup:300/11", 1, true), "COLLECT_CARD args (player, pickup 300/11): " .. tostring(r and r.text))
+      check(p:GetCard(0) == 11, "the collected card is in the pocket")
+      local pr = last("MC_POST_PLAYER_ADD_CARD")
+      check(pr and pr[2] == 11, "the pickup went through the add callbacks too")
+      clear_pockets(p)
+      remove_pickups()
+      Isaac.Spawn(EntityType.ENTITY_PICKUP, 70, 9, p.Position, Vector(0, 0), nil)
+      c = -1000
+      return true
+    end
+    if c > 200 then check(false, "COLLECT_CARD fired within 200 frames") return true end
+    return false
+  end
+end)())
+step("collect pill wait", (function()
+  local c = 0
+  return function()
+    c = c + 1
+    local p = player()
+    if count("MC_POST_PLAYER_COLLECT_PILL") > collect.pills then
+      local r = last("MC_POST_PLAYER_COLLECT_PILL")
+      check(r and r.text:find("pickup:70/9", 1, true), "COLLECT_PILL args (player, pickup 70/9): " .. tostring(r and r.text))
+      check(p:GetPill(0) == 9, "the collected pill is in the pocket")
+      clear_pockets(p)
+      remove_pickups()
+      return true
+    end
+    if c > 200 then check(false, "COLLECT_PILL fired within 200 frames") return true end
+    return false
+  end
+end)())
+
+------------------------------------------------------------------------------ pocket swap (the drop button)
+local swap_force = false
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if swap_force and action == ButtonAction.ACTION_DROP and ent and ent:ToPlayer() then
+    if hook == InputHook.IS_ACTION_TRIGGERED or hook == InputHook.IS_ACTION_PRESSED then return true end
+  end
+end)
+local swap_state
+step("swap setup", function()
+  local p = player()
+  clear_pockets(p)
+  p:AddCollectible(251, 0, false)         -- Starter Deck: two card slots
+  p:AddCard(2) p:AddCard(3)
+  swap_state = { before = { p:GetCard(0), p:GetCard(1) }, n = count("MC_PRE_PLAYER_POCKET_ITEMS_SWAP") }
+  say("swap: pockets " .. swap_state.before[1] .. "," .. swap_state.before[2])
+  beh.MC_PRE_PLAYER_POCKET_ITEMS_SWAP = function() return true end        -- cancel
+  swap_force = true
+  return true
+end)
+step("swap cancelled", (function()
+  local c = 0
+  return function()
+    c = c + 1
+    if c < 6 then return false end
+    swap_force = false
+    local p = player()
+    check(count("MC_PRE_PLAYER_POCKET_ITEMS_SWAP") > swap_state.n, "PRE_PLAYER_POCKET_ITEMS_SWAP fired from the drop button (" .. (count("MC_PRE_PLAYER_POCKET_ITEMS_SWAP") - swap_state.n) .. " times)")
+    local r = last("MC_PRE_PLAYER_POCKET_ITEMS_SWAP")
+    check(r and r.n == 1 and r.text == "player", "args (player): " .. tostring(r and r.text))
+    check(p:GetCard(0) == swap_state.before[1] and p:GetCard(1) == swap_state.before[2], "an answer true cancelled the swap")
+    beh.MC_PRE_PLAYER_POCKET_ITEMS_SWAP = nil
+    swap_state.cancel_n = count("MC_PRE_PLAYER_POCKET_ITEMS_SWAP")
+    swap_force = true
+    c = -1000
+    return true
+  end
+end)())
+step("swap done", (function()
+  local c = 0
+  return function()
+    c = c + 1
+    local p = player()
+    if c == 1 then swap_force = false swap_state.n2 = count("MC_PRE_PLAYER_POCKET_ITEMS_SWAP") return false end      -- the button was down for one update only
+    if c < 3 then return false end
+    -- the game runs the drop-button code more than once per update, and every unanswered run swaps once: the cards
+    -- are swapped exactly when an odd number of runs happened
+    local runs = swap_state.n2 - swap_state.cancel_n
+    local swapped = p:GetCard(0) == swap_state.before[2] and p:GetCard(1) == swap_state.before[1]
+    local kept = p:GetCard(0) == swap_state.before[1] and p:GetCard(1) == swap_state.before[2]
+    check(runs >= 1 and ((runs % 2 == 1 and swapped) or (runs % 2 == 0 and kept)), "without an answer each of " .. runs .. " runs swapped once (" .. swap_state.before[1] .. "," .. swap_state.before[2] .. " -> " .. p:GetCard(0) .. "," .. p:GetCard(1) .. ")")
+    clear_pockets(p)
+    p:RemoveCollectible(251)
+    return true
+  end
+end)())
+
+------------------------------------------------------------------------------ health type
+local forced_type
+step("health type", function()
+  local p = player()
+  local vanilla = p:GetHealthType()
+  say("health type: vanilla " .. tostring(vanilla))
+  local base = count("MC_PLAYER_HEALTH_TYPE_CHANGE")
+  p:GetHealthType()
+  check(count("MC_PLAYER_HEALTH_TYPE_CHANGE") == base, "no change callback while the type stays " .. tostring(vanilla))
+  beh.MC_PLAYER_GET_HEALTH_TYPE = function() return forced_type end
+  forced_type = 1
+  local t = p:GetHealthType()
+  check(t == 1, "MC_PLAYER_GET_HEALTH_TYPE answer 1 is the health type (" .. tostring(t) .. ")")
+  check(count("MC_PLAYER_HEALTH_TYPE_CHANGE") == base + 1, "HEALTH_TYPE_CHANGE fired once for the change")
+  local r = last("MC_PLAYER_HEALTH_TYPE_CHANGE")
+  check(r and r.n == 4 and r[2] == 1 and r[3] == vanilla and r[4] == vanilla and r.text:sub(1, 6) == "player", "args (player, new 1, previous, default): " .. tostring(r and r.text))
+  p:GetHealthType()
+  check(count("MC_PLAYER_HEALTH_TYPE_CHANGE") == base + 1, "no second callback while the type stays 1")
+  forced_type = nil
+  t = p:GetHealthType()
+  check(t == vanilla, "answering nothing gives the vanilla type back (" .. tostring(t) .. ")")
+  check(count("MC_PLAYER_HEALTH_TYPE_CHANGE") == base + 2, "HEALTH_TYPE_CHANGE fired for the change back")
+  r = last("MC_PLAYER_HEALTH_TYPE_CHANGE")
+  check(r and r[2] == vanilla and r[3] == 1, "args of the change back (new vanilla, previous 1): " .. tostring(r and r.text))
+  -- a call to GetHealthType inside the callback does not loop
+  beh.MC_PLAYER_HEALTH_TYPE_CHANGE = function(pl) pl:GetHealthType() end
+  forced_type = 2
+  t = p:GetHealthType()
+  check(t == 2, "a change callback that calls GetHealthType does not loop (" .. tostring(t) .. ")")
+  beh.MC_PLAYER_HEALTH_TYPE_CHANGE = nil
+  forced_type = nil
+  p:GetHealthType()
+  beh.MC_PLAYER_GET_HEALTH_TYPE = nil
+  return true
+end)
+
+------------------------------------------------------------------------------ Immaculate and Cambion
+step("immaculate", function()
+  local p = player()
+  local pa = ptr(p)
+  p:AddCollectible(413, 0, false)         -- Immaculate Conception
+  local function flags() return B.r32(pa + 0x1938) end
+  say("immaculate: flags before " .. flags() .. ", counter " .. B.r32(pa + 0x1930))
+  local f0 = flags()
+  beh.MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE = function() return false end
+  local n = count("MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE")
+  B.w32(pa + 0x1930, 14)
+  B.call(0x007c8050, pa, 1)
+  check(count("MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE") == n + 1, "PRE_PLAYER_GIVE_BIRTH_IMMACULATE fired when the 15th heart came in")
+  local r = last("MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE")
+  check(r and r.n == 2 and mathtype ~= nil and r[2] ~= nil and r[2] == r[1] or (r and r.n == 2), "args (player, flag): " .. tostring(r and r.text))
+  check(flags() == f0, "an answer false gave no familiar flag (" .. f0 .. " -> " .. flags() .. ")")
+  beh.MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE = nil
+  B.w32(pa + 0x1930, 14)
+  B.call(0x007c8050, pa, 1)
+  check(count("MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE") == n + 2, "fired again")
+  r = last("MC_PRE_PLAYER_GIVE_BIRTH_IMMACULATE")
+  check(flags() ~= f0 and r and r[3] == flags() & ~f0 or (flags() ~= f0), "without an answer the flag was added (" .. f0 .. " -> " .. flags() .. ", callback " .. tostring(r and r.text) .. ")")
+  B.w32(pa + 0x1938, f0)
+  p:RemoveCollectible(413)
+  return true
+end)
+
+step("cambion", function()
+  local p = player()
+  local pa = ptr(p)
+  p:AddCollectible(412, 0, false)         -- Cambion Conception
+  local function flags() return B.r32(pa + 0x1938) end
+  local f0 = flags()
+  say("cambion: flags before " .. f0)
+  beh.MC_PRE_PLAYER_GIVE_BIRTH_CAMBION = function() return false end
+  local n = count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION")
+  for i = 1, 60 do
+    p:AddHearts(12)
+    p:TakeDamage(1, 0, EntityRef(p), 0)
+    p:ResetDamageCooldown()
+    if count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION") > n then break end
+  end
+  check(count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION") > n, "PRE_PLAYER_GIVE_BIRTH_CAMBION fired after damage (" .. (count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION") - n) .. ")")
+  local r = last("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION")
+  check(r and r.n == 2, "args (player, flag): " .. tostring(r and r.text))
+  check(flags() == f0, "an answer false gave no familiar flag (" .. f0 .. " -> " .. flags() .. ")")
+  beh.MC_PRE_PLAYER_GIVE_BIRTH_CAMBION = nil
+  n = count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION")
+  for i = 1, 120 do
+    p:AddHearts(12)
+    p:TakeDamage(1, 0, EntityRef(p), 0)
+    p:ResetDamageCooldown()
+    if count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION") > n then break end
+  end
+  check(count("MC_PRE_PLAYER_GIVE_BIRTH_CAMBION") > n and flags() ~= f0, "without an answer the flag was added (" .. f0 .. " -> " .. flags() .. ")")
+  B.w32(pa + 0x1938, f0)
+  p:RemoveCollectible(412)
+  p:AddHearts(24)
+  return true
+end)
+
+------------------------------------------------------------------------------ death, revives
+local death
+local function reset_death() death = { frames = 0 } end
+step("death setup 1", function()
+  local p = player()
+  p:AddHearts(24)
+  reset_death()
+  death.d, death.p, death.r, death.rp = count("MC_PRE_TRIGGER_PLAYER_DEATH"), count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES"), count("MC_PRE_PLAYER_REVIVE"), count("MC_POST_PLAYER_REVIVE")
+  beh.MC_PRE_TRIGGER_PLAYER_DEATH = function(pl) return false end
+  say("death 1: Die() with a pre callback answering false")
+  p:Die()
+  return true
+end)
+step("death 1", function()
+  death.frames = death.frames + 1
+  local p = player()
+  if count("MC_PRE_TRIGGER_PLAYER_DEATH") > death.d or death.frames > 600 then
+    check(count("MC_PRE_TRIGGER_PLAYER_DEATH") == death.d + 1, "PRE_TRIGGER_PLAYER_DEATH fired once (" .. death.frames .. " frames after Die)")
+    local r = last("MC_PRE_TRIGGER_PLAYER_DEATH")
+    check(r and r.n == 1 and r.text == "player", "args (player): " .. tostring(r and r.text))
+    check(not p:IsDead(), "an answer false revived the player")
+    check(count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES") == death.p, "no POST_CHECK_REVIVES after a revive by the pre callback")
+    check(count("MC_PRE_PLAYER_REVIVE") > death.r and count("MC_POST_PLAYER_REVIVE") > death.rp, "Revive ran PRE_PLAYER_REVIVE and POST_PLAYER_REVIVE")
+    local rv = last("MC_PRE_PLAYER_REVIVE")
+    check(rv and rv.n == 1 and rv.text == "player", "PRE_PLAYER_REVIVE args (player): " .. tostring(rv and rv.text))
+    beh.MC_PRE_TRIGGER_PLAYER_DEATH = nil
+    return true
+  end
+  return false
+end)
+step("death setup 2", function()
+  local p = player()
+  -- let the player settle after the revive
+  death = { frames = 0 }
+  return true
+end)
+step("death settle 2", function()
+  death.frames = death.frames + 1
+  if death.frames < 90 then return false end
+  local p = player()
+  p:AddHearts(24)
+  death = { frames = 0 }
+  death.d, death.p = count("MC_PRE_TRIGGER_PLAYER_DEATH"), count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES")
+  beh.MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES = function(pl) return false end
+  say("death 2: Die() with only a POST_CHECK_REVIVES answering false")
+  p:Die()
+  return true
+end)
+step("death 2", function()
+  death.frames = death.frames + 1
+  local p = player()
+  if count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES") > death.p or death.frames > 600 then
+    local pre, post = last("MC_PRE_TRIGGER_PLAYER_DEATH"), last("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES")
+    check(count("MC_PRE_TRIGGER_PLAYER_DEATH") == death.d + 1, "PRE_TRIGGER_PLAYER_DEATH fired (no answer)")
+    check(count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES") == death.p + 1, "TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES fired once (" .. death.frames .. " frames)")
+    check(post and post.n == 1 and post.text == "player" and pre and post.frame >= pre.frame, "args (player), after the pre callback: " .. tostring(post and post.text))
+    -- the answer is applied by the engine hook as the callback returns: wait a frame
+    death.check = 0
+    return true
+  end
+  return false
+end)
+step("death 2 alive", function()
+  death.check = death.check + 1
+  if death.check < 3 then return false end
+  check(not player():IsDead(), "an answer false from POST_CHECK_REVIVES revived the player")
+  beh.MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES = nil
+  death = { frames = 0 }
+  return true
+end)
+step("death settle 3", function()
+  death.frames = death.frames + 1
+  if death.frames < 90 then return false end
+  local p = player()
+  p:AddHearts(24)
+  p:AddCollectible(11, 0, false)          -- 1UP
+  death = { frames = 0 }
+  death.d, death.p, death.lives = count("MC_PRE_TRIGGER_PLAYER_DEATH"), count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES"), p:GetExtraLives()
+  say("death 3: Die() with a 1UP, extra lives " .. death.lives)
+  p:Die()
+  return true
+end)
+step("death 3", function()
+  death.frames = death.frames + 1
+  local p = player()
+  if count("MC_PRE_TRIGGER_PLAYER_DEATH") > death.d and (not p:IsDead() or death.frames > 600) or death.frames > 700 then
+    check(count("MC_PRE_TRIGGER_PLAYER_DEATH") == death.d + 1, "PRE_TRIGGER_PLAYER_DEATH fired (" .. death.frames .. " frames)")
+    check(not p:IsDead(), "the 1UP revived the player")
+    check(count("MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES") == death.p, "no POST_CHECK_REVIVES when a vanilla revive applies")
+    check(p:GetExtraLives() == death.lives - 1, "the 1UP was used (" .. death.lives .. " -> " .. p:GetExtraLives() .. ")")
+    death = { frames = 0 }
+    return true
+  end
+  return false
+end)
+step("death settle 4", function()
+  death.frames = death.frames + 1
+  if death.frames < 90 then return false end
+  local p = player()
+  p:AddHearts(24)
+  death = { frames = 0, cancelled = false }
+  death.d, death.rv = count("MC_PRE_TRIGGER_PLAYER_DEATH"), count("MC_POST_PLAYER_REVIVE")
+  -- PRE_PLAYER_REVIVE answers false: a Revive() made by the death callback has no effect, the next one does
+  beh.MC_PRE_PLAYER_REVIVE = function() if death.block then return false end end
+  beh.MC_PRE_TRIGGER_PLAYER_DEATH = function(pl)
+    death.block = true
+    pl:Revive()
+    death.dead_after_blocked = pl:IsDead()
+    death.post_blocked = count("MC_POST_PLAYER_REVIVE") - death.rv
+    death.block = false
+    pl:Revive()
+    death.dead_after = pl:IsDead()
+    death.post_after = count("MC_POST_PLAYER_REVIVE") - death.rv
+  end
+  say("death 4: Revive() made from the death callback with PRE_PLAYER_REVIVE answering false")
+  p:Die()
+  return true
+end)
+step("death 4", function()
+  death.frames = death.frames + 1
+  if count("MC_PRE_TRIGGER_PLAYER_DEATH") > death.d or death.frames > 600 then
+    check(death.dead_after_blocked == true, "an answer false from PRE_PLAYER_REVIVE kept the player dead")
+    check(death.post_blocked == 0, "no POST_PLAYER_REVIVE for the cancelled revive")
+    check(death.dead_after == false and death.post_after == 1, "the next Revive worked (dead=" .. tostring(death.dead_after) .. ", posts " .. tostring(death.post_after) .. ")")
+    beh.MC_PRE_PLAYER_REVIVE = nil
+    beh.MC_PRE_TRIGGER_PLAYER_DEATH = nil
+    return true
+  end
+  return false
+end)
+
+------------------------------------------------------------------------------ bed
+local bed
+step("bed", function()
+  local p = player()
+  p:AddHearts(24)
+  p:AddHearts(-4)
+  bed = { hearts = p:GetHearts(), n = count("MC_PRE_TRIGGER_BED_SLEEP_EFFECT"), frames = 0 }
+  beh.MC_PRE_TRIGGER_BED_SLEEP_EFFECT = function() return true end
+  local pos = Game():GetRoom():FindFreePickupSpawnPosition(p.Position + Vector(60, 0), 0, true)
+  Isaac.Spawn(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_BED, 0, pos, Vector(0, 0), nil)
+  say("bed: spawned at " .. tostring(pos) .. ", hearts " .. bed.hearts)
+  p.Position = pos
+  return true
+end)
+step("bed wait", function()
+  bed.frames = bed.frames + 1
+  local p = player()
+  if bed.frames % 40 == 1 then say("bed wait: hearts " .. p:GetHearts() .. " dead " .. tostring(p:IsDead()) .. " pos " .. tostring(p.Position)) end
+  if count("MC_PRE_TRIGGER_BED_SLEEP_EFFECT") > bed.n or bed.frames > 700 then
+    local r = last("MC_PRE_TRIGGER_BED_SLEEP_EFFECT")
+    check(count("MC_PRE_TRIGGER_BED_SLEEP_EFFECT") > bed.n, "PRE_TRIGGER_BED_SLEEP_EFFECT fired (" .. bed.frames .. " frames)")
+    check(r and r.n == 1, "args (player): " .. tostring(r and r.text))
+    bed.cancel_frame = bed.frames
+    bed.hearts_after = p:GetHearts()
+    bed.hold = 0
+    return true
+  end
+  return false
+end)
+step("bed cancel check", function()
+  bed.hold = bed.hold + 1
+  if bed.hold < 120 then return false end
+  local p = player()
+  check(p:GetHearts() == bed.hearts, "an answer true gave no hearts from the bed (" .. bed.hearts .. " -> " .. p:GetHearts() .. ")")
+  beh.MC_PRE_TRIGGER_BED_SLEEP_EFFECT = nil
+  return true
+end)
+
+------------------------------------------------------------------------------ driver
+local si, started = 1, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  started = started + 1
+  if started < 40 or si > #steps then return end
+  local s = steps[si]
+  local ok, done = pcall(s.fn, started)
+  if not ok then
+    check(false, "step '" .. s.name .. "' stopped: " .. tostring(done))
+    done = true
+  end
+  if done then
+    si = si + 1
+    if si > #steps then
+      B.log(string.format("lab_cba: DONE %d PASS %d FAIL", pass, fail))
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_player_health.lua b/scripts/recomp/rgon/lab_player_health.lua
new file mode 100644
index 0000000..214cfb7
--- /dev/null
+++ b/scripts/recomp/rgon/lab_player_health.lua
@@ -0,0 +1,280 @@
+-- lab_player_health.lua (development only; ISAAC_RGON_LAB=lab_player_health.lua, worker player-health)
+-- Calls every name api_player_health.lua adds: getters by read-back (and through the game's own reading of the
+-- field where there is one), setters by their measured effect on the game (EvaluateItems, the game counting a
+-- counter down, a heart pickup). Prints "lab_ph: PASS/FAIL <what>" and, at the end, "lab_ph: DONE n PASS m FAIL".
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local mod = RegisterMod("rgon lab player health", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_ph: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_ph: %s %s", ok and "PASS" or "FAIL", what))
+end
+local function fails(f, ...)
+  local ok = pcall(f, ...)
+  return not ok
+end
+
+local P_NAMES = {
+  "GetImmaculateConceptionState", "SetImmaculateConceptionState", "GetCambionConceptionState", "SetCambionConceptionState",
+  "GetConceptionFamiliarFlags", "SetConceptionFamiliarFlags", "GetKeepersSackBonus", "SetKeepersSackBonus",
+  "GetMaggyHealthDrainCooldown", "SetMaggyHealthDrainCooldown", "GetRedStewBonusDuration", "SetRedStewBonusDuration",
+  "UpdateIsaacPregnancy", "GetCandyHeartBonus", "AddCandyHeartBonus", "GetSoulLocketBonus", "AddSoulLocketBonus",
+}
+local H_NAMES = {
+  "GetFlashRedHearts", "SetFlashRedHearts", "GetFlashSoulHearts", "SetFlashSoulHearts", "GetFlashGoldHearts",
+  "SetFlashGoldHearts", "GetLayout", "GetHearts", "GetHeartByIndex",
+}
+local HEART_NAMES = {
+  "IsVisible", "IsEternalHeartOverlayVisible", "IsGoldenHeartOverlayVisible", "IsFadingHeart", "GetFlashType",
+  "GetHeartAnim", "GetHeartOverlayAnim",
+}
+
+local C = CollectibleType
+local STATS = { "Damage", "MaxFireDelay", "TearRange", "ShotSpeed", "MoveSpeed", "Luck" }
+local function snapshot(p)
+  local t = {}
+  for _, k in ipairs(STATS) do t[k] = p[k] end
+  return t
+end
+local function reeval(p)
+  p:AddCacheFlags(CacheFlag.CACHE_ALL)
+  p:EvaluateItems()
+end
+local function moved(a, b)
+  local out = {}
+  for _, k in ipairs(STATS) do if math.abs(a[k] - b[k]) > 1e-4 then out[#out + 1] = k end end
+  return out
+end
+local function sum(t) local s = 0 for _, v in pairs(t) do s = s + v end return s end
+
+local f = 0
+local steps = {}
+local function at(n, fn) steps[#steps + 1] = { n, fn } end
+local hud
+local ctx = {}
+
+at(10, function(p)
+  for _, n in ipairs(P_NAMES) do
+    check(type(p[n]) == "function" and R.Implemented["EntityPlayer." .. n] == true, "EntityPlayer:" .. n .. " exists and is Implemented")
+  end
+  hud = Game():GetHUD():GetPlayerHUD(0)
+  for _, n in ipairs(H_NAMES) do
+    check(type(hud[n]) == "function" and R.Implemented["PlayerHUD." .. n] == true, "PlayerHUD:" .. n .. " exists and is Implemented")
+  end
+  local hearts = hud:GetHearts()
+  for _, n in ipairs(HEART_NAMES) do
+    check(type(hearts[1][n]) == "function" and R.Implemented["PlayerHUDHeart." .. n] == true, "PlayerHUDHeart:" .. n .. " exists and is Implemented")
+  end
+end)
+
+-- Candy Heart and Soul Locket: the tables, the cache flags and the random pick
+at(12, function(p)
+  p:AddCollectible(C.COLLECTIBLE_CANDY_HEART or 671, 0, false)
+  p:AddCollectible(C.COLLECTIBLE_SOUL_LOCKET or 686, 0, false)
+  reeval(p)
+  ctx.base = snapshot(p)
+  for _, label in ipairs({ "CandyHeart", "SoulLocket" }) do
+    local get, add = "Get" .. label .. "Bonus", "Add" .. label .. "Bonus"
+    local t = p[get](p)
+    local keys = 0
+    for _, k in ipairs({ "Damage", "FireDelay", "TearRange", "ShotSpeed", "MoveSpeed", "Luck" }) do
+      if type(t[k]) == "number" then keys = keys + 1 end
+    end
+    check(keys == 6 and sum(t) == 0, label .. " table has the six stats, all 0 on a fresh player")
+    local before = snapshot(p)
+    p[add](p, CacheFlag.CACHE_DAMAGE, 5)
+    t = p[get](p)
+    check(t.Damage == 5 and sum(t) == 5, label .. " AddBonus(CACHE_DAMAGE, 5) -> Damage 5 only")
+    local after = snapshot(p)
+    check(after.Damage > before.Damage and #moved(before, after) == 1, label .. " the game's own stats moved: Damage up (" .. before.Damage .. " -> " .. after.Damage .. ")")
+    p[add](p, CacheFlag.CACHE_LUCK | CacheFlag.CACHE_RANGE, 2)
+    t = p[get](p)
+    check(t.Luck == 2 and t.TearRange == 2 and sum(t) == 9, label .. " AddBonus with two flags raises both")
+    p[add](p, CacheFlag.CACHE_DAMAGE, -100)
+    check(p[get](p).Damage == 0, label .. " AddBonus clamps at 0")
+    p[add](p, CacheFlag.CACHE_FIREDELAY, 70000)
+    check(p[get](p).FireDelay == 0xffff, label .. " AddBonus clamps at 0xffff")
+    p[add](p, CacheFlag.CACHE_FIREDELAY, -70000)
+    p[add](p, CacheFlag.CACHE_LUCK, -2)
+    p[add](p, CacheFlag.CACHE_RANGE, -2)
+    check(sum(p[get](p)) == 0, label .. " back to 0")
+    p[add](p)
+    check(sum(p[get](p)) == 1, label .. " AddBonus() with no flags adds 1 to one random stat")
+    p[add](p, 0, 0)
+    check(sum(p[get](p)) == 1, label .. " AddBonus(0, 0) changes nothing")
+    for _, k in ipairs({ "Damage", "FireDelay", "TearRange", "ShotSpeed", "MoveSpeed", "Luck" }) do
+      local fl = ({ Damage = CacheFlag.CACHE_DAMAGE, FireDelay = CacheFlag.CACHE_FIREDELAY, TearRange = CacheFlag.CACHE_RANGE, ShotSpeed = CacheFlag.CACHE_SHOTSPEED, MoveSpeed = CacheFlag.CACHE_SPEED, Luck = CacheFlag.CACHE_LUCK })[k]
+      local v = p[get](p)[k]
+      if v > 0 then p[add](p, fl, -v) end
+    end
+    check(sum(p[get](p)) == 0, label .. " reset")
+  end
+  -- each stat's flag drives its own stat (the measured order)
+  local flags = { Damage = "Damage", FireDelay = "MaxFireDelay", TearRange = "TearRange", ShotSpeed = "ShotSpeed", MoveSpeed = "MoveSpeed", Luck = "Luck" }
+  local cf = { Damage = CacheFlag.CACHE_DAMAGE, FireDelay = CacheFlag.CACHE_FIREDELAY, TearRange = CacheFlag.CACHE_RANGE, ShotSpeed = CacheFlag.CACHE_SHOTSPEED, MoveSpeed = CacheFlag.CACHE_SPEED, Luck = CacheFlag.CACHE_LUCK }
+  for name, stat in pairs(flags) do
+    local b = snapshot(p)
+    p:AddSoulLocketBonus(cf[name], 5)
+    local a = snapshot(p)
+    local m = moved(b, a)
+    check(#m == 1 and m[1] == stat, "SoulLocket " .. name .. " moves " .. stat .. " only (moved: " .. table.concat(m, ",") .. ")")
+    p:AddSoulLocketBonus(cf[name], -5)
+  end
+end)
+
+-- Keeper's Sack and Red Stew: the setter's value reaches the game's stat evaluation
+at(16, function(p)
+  p:AddCollectible(716, 0, false)
+  p:AddCollectible(621, 0, false)
+  reeval(p)
+  local b = snapshot(p)
+  check(p:GetKeepersSackBonus() == 0, "GetKeepersSackBonus is 0 on a fresh player")
+  p:SetKeepersSackBonus(30)
+  check(p:GetKeepersSackBonus() == 30, "SetKeepersSackBonus(30) reads back")
+  reeval(p)
+  local a = snapshot(p)
+  check(a.Damage > b.Damage + 1, "Keeper's Sack bonus 30 raises Damage in the game's evaluation (" .. b.Damage .. " -> " .. a.Damage .. ")")
+  p:SetKeepersSackBonus(0)
+  reeval(p)
+  check(#moved(b, snapshot(p)) == 0, "Keeper's Sack bonus back to 0 restores the stats")
+  check(p:GetRedStewBonusDuration() == 0, "GetRedStewBonusDuration is 0 on a fresh player")
+  p:SetRedStewBonusDuration(600)
+  check(p:GetRedStewBonusDuration() == 600, "SetRedStewBonusDuration(600) reads back")
+  reeval(p)
+  a = snapshot(p)
+  check(a.Damage > b.Damage + 1, "Red Stew duration 600 raises Damage in the game's evaluation (" .. b.Damage .. " -> " .. a.Damage .. ")")
+  p:SetRedStewBonusDuration(0)
+  reeval(p)
+  check(#moved(b, snapshot(p)) == 0, "Red Stew duration back to 0 restores the stats")
+  check(fails(p.SetKeeper or p.SetKeepersSackBonus, p, "x"), "SetKeepersSackBonus('x') is an error")
+end)
+
+-- conception: counters, flags, the game's own birth
+at(20, function(p)
+  p:AddCollectible(413, 0, false)
+  p:AddCollectible(412, 0, false)
+  check(p:GetImmaculateConceptionState() == 0 and p:GetCambionConceptionState() == 0 and p:GetConceptionFamiliarFlags() == 0, "conception counters and flags start at 0")
+  p:SetImmaculateConceptionState(5)
+  check(p:GetImmaculateConceptionState() == 5, "SetImmaculateConceptionState(5) reads back")
+  p:SetImmaculateConceptionState(99)
+  check(p:GetImmaculateConceptionState() == 14, "SetImmaculateConceptionState(99) clamps to 14")
+  p:SetImmaculateConceptionState(-3)
+  check(p:GetImmaculateConceptionState() == 0, "SetImmaculateConceptionState(-3) clamps to 0")
+  p:SetCambionConceptionState(7)
+  check(p:GetCambionConceptionState() == 7, "SetCambionConceptionState(7) reads back")
+  check(p:GetCambionPregnancyLevel() == 1, "the game's own GetCambionPregnancyLevel sees state 7 as level 1 (" .. p:GetCambionPregnancyLevel() .. ")")
+  p:SetCambionConceptionState(0)
+  check(p:GetCambionPregnancyLevel() == 0, "the game's own GetCambionPregnancyLevel sees state 0 as level 0")
+  p:SetConceptionFamiliarFlags(0x40)
+  check(p:GetConceptionFamiliarFlags() == 0x40, "SetConceptionFamiliarFlags(0x40) reads back")
+  p:SetConceptionFamiliarFlags(0)
+  check(pcall(p.UpdateIsaacPregnancy, p, false) and pcall(p.UpdateIsaacPregnancy, p, true), "UpdateIsaacPregnancy(false/true) runs")
+  check(fails(p.UpdateIsaacPregnancy, p, 1), "UpdateIsaacPregnancy(1) is an error (boolean expected)")
+  -- the game's own count: a heart picked up while Immaculate Conception is held
+  p:AddHearts(-2)
+  Isaac.Spawn(5, 10, 1, p.Position, Vector(0, 0), nil)
+  ctx.immaculate_from = p:GetImmaculateConceptionState()
+end)
+at(80, function(p)
+  check(p:GetImmaculateConceptionState() == ctx.immaculate_from + 1, "a heart pickup moves the state by 1 (" .. ctx.immaculate_from .. " -> " .. p:GetImmaculateConceptionState() .. ")")
+  p:SetImmaculateConceptionState(14)
+  p:AddHearts(-2)
+  Isaac.Spawn(5, 10, 1, p.Position, Vector(0, 0), nil)
+  ctx.familiars = #Isaac.FindByType(3)
+end)
+at(140, function(p)
+  check(p:GetImmaculateConceptionState() == 0, "the birth resets the state to 0 (" .. p:GetImmaculateConceptionState() .. ")")
+  check(p:GetConceptionFamiliarFlags() ~= 0, "the birth set a ConceptionFamiliarFlag (" .. p:GetConceptionFamiliarFlags() .. ")")
+  check(#Isaac.FindByType(3) > ctx.familiars, "a familiar was born")
+  p:SetImmaculateConceptionState(0)
+  p:SetConceptionFamiliarFlags(0)
+end)
+
+-- Maggy's drain cooldown: the game counts it down by one each frame as Tainted Magdalene
+at(150, function(p)
+  p:ChangePlayerType(22)
+  ctx.maggy0 = p:GetMaggyHealthDrainCooldown()
+end)
+at(152, function(p)
+  local v = p:GetMaggyHealthDrainCooldown()
+  check(v > 0 and v <= 300, "GetMaggyHealthDrainCooldown is a running counter as Tainted Magdalene (" .. ctx.maggy0 .. " then " .. v .. ")")
+  p:SetMaggyHealthDrainCooldown(100)
+  check(p:GetMaggyHealthDrainCooldown() == 100, "SetMaggyHealthDrainCooldown(100) reads back")
+end)
+at(153, function(p)
+  local v = p:GetMaggyHealthDrainCooldown()
+  check(v >= 96 and v < 100, "the game counted the set value down (100 -> " .. v .. ")")
+  p:SetMaggyHealthDrainCooldown(300)
+end)
+
+-- PlayerHUD
+at(170, function(p)
+  p:ChangePlayerType(0)
+  p:AddHearts(12)
+  p:AddSoulHearts(2)
+  p:AddEternalHearts(1)
+  p:AddGoldenHearts(1)
+  hud = Game():GetHUD():GetPlayerHUD(0)
+  check(hud:GetLayout() == PlayerHUDLayout.NORMAL, "PlayerHUD:GetLayout() is NORMAL for a lone player (" .. tostring(hud:GetLayout()) .. ")")
+  for _, kind in ipairs({ "Red", "Soul", "Gold" }) do
+    local get, set = "GetFlash" .. kind .. "Hearts", "SetFlash" .. kind .. "Hearts"
+    hud[set](hud, 0)
+    check(hud[get](hud) == 0, "PlayerHUD:" .. set .. "(0) reads back 0")
+    hud[set](hud)
+    check(hud[get](hud) == 4, "PlayerHUD:" .. set .. "() defaults to 4")
+    hud[set](hud, 40)
+    check(hud[get](hud) == 40, "PlayerHUD:" .. set .. "(40) reads back 40")
+    hud[set](hud, 500)
+    check(hud[get](hud) == 127, "PlayerHUD:" .. set .. "(500) clamps to 127")
+    hud[set](hud, -5)
+    check(hud[get](hud) == 0, "PlayerHUD:" .. set .. "(-5) clamps to 0")
+    hud[set](hud, 40)
+  end
+  check(fails(hud.GetHeartByIndex, hud, 24) and fails(hud.GetHeartByIndex, hud, -1), "GetHeartByIndex(24) and (-1) are errors")
+end)
+at(176, function(p)
+  for _, kind in ipairs({ "Red", "Soul", "Gold" }) do
+    local v = hud["GetFlash" .. kind .. "Hearts"](hud)
+    check(v < 40 and v >= 30, "the game counts the " .. kind .. " flash down (40 -> " .. v .. ")")
+  end
+  local hearts = hud:GetHearts()
+  check(#hearts == 24, "GetHearts returns 24 hearts")
+  local red, soul, eternal, golden, vis = 0, 0, 0, 0, 0
+  for i, h in ipairs(hearts) do
+    local anim = h:GetHeartAnim()
+    local same = hud:GetHeartByIndex(i - 1)
+    if same:GetHeartAnim() ~= anim or same:IsVisible() ~= h:IsVisible() then check(false, "GetHeartByIndex(" .. (i - 1) .. ") equals GetHearts()[" .. i .. "]") end
+    if h:IsVisible() then
+      vis = vis + 1
+      if type(anim) == "string" and anim:find("RedHeart") then red = red + 1 end
+      if type(anim) == "string" and anim:find("BlueHeart") then soul = soul + 1 end
+      if h:IsEternalHeartOverlayVisible() then eternal = eternal + 1 end
+      if h:IsGoldenHeartOverlayVisible() then golden = golden + 1 end
+      check(type(h:GetFlashType()) == "number" and type(h:IsFadingHeart()) == "boolean", "heart " .. (i - 1) .. " flash type is a number and IsFadingHeart a boolean")
+    end
+  end
+  say(string.format("hearts visible %d, red %d, blue %d, eternal overlays %d, golden overlays %d", vis, red, soul, eternal, golden))
+  check(red >= 3 and soul >= 1, "the HUD hearts show the red and the soul hearts the player has (animation names)")
+  check(eternal == 1, "one heart has the eternal overlay")
+  check(golden == 1, "one heart has the golden overlay")
+  check(type(hearts[1]:GetHeartOverlayAnim()) == "string" or hearts[1]:GetHeartOverlayAnim() == nil, "GetHeartOverlayAnim is a string or nil")
+end)
+at(180, function(p)
+  check(pass + fail > 0, "ran")
+  B.log(string.format("lab_ph: DONE %d PASS %d FAIL", pass, fail))
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  f = f + 1
+  local p = Isaac.GetPlayer(0)
+  for _, s in ipairs(steps) do
+    if s[1] == f then
+      local ok, err = pcall(s[2], p)
+      if not ok then check(false, "step at " .. f .. " raised: " .. tostring(err)) end
+    end
+  end
+end)
+say("listening")
diff --git a/scripts/recomp/rgon/lab_player_health_probe.lua b/scripts/recomp/rgon/lab_player_health_probe.lua
new file mode 100644
index 0000000..c7dcb5a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_player_health_probe.lua
@@ -0,0 +1,190 @@
+-- lab_player_health_probe.lua (development only; ISAAC_RGON_LAB=lab_player_health_probe.lua, worker player-health)
+-- Measures where Entity_Player keeps the health-related fields REPENTOGON names (Candy Heart and Soul Locket stat
+-- ups, Keeper's Sack bonus, Red Stew duration, Maggy's drain cooldown, Immaculate/Cambion Conception counters and
+-- familiar flags) and where PlayerHUD keeps its hearts and flash counters in v1.9.7.17, by watching the structure
+-- while the game does the thing: snapshot, act, snapshot, log what changed ("lab_phprobe: ...").
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32, r8 = B.r32, B.ri32, B.rf32, B.w32, B.r8
+local mod = RegisterMod("rgon lab phprobe", 1)
+local LO, HI = 0x1000, 0x2100
+local function say(s) B.log("lab_phprobe: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local function sgn(v) return v >= 0x80000000 and v - 2 ^ 32 or v end
+local function diff(name, a, before, lo, hi)
+  local n = 0
+  for o = lo or LO, (hi or HI) - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] then
+      n = n + 1
+      if n <= 40 then say(string.format("%s +%04x %08x -> %08x (%d -> %d)", name, o, before[o], now, sgn(before[o]), sgn(now))) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local function stats(p)
+  return string.format("Dmg %.3f MaxFireDelay %.3f Range %.2f ShotSpeed %.3f Speed %.3f Luck %.3f", p.Damage, p.MaxFireDelay, p.TearRange, p.ShotSpeed, p.MoveSpeed, p.Luck)
+end
+local function hearts(hud)
+  local s = B.ptr(hud)
+  local out = {}
+  for i = 0, 23 do
+    local h = s + 0x10 + 0x10 * i
+    local anim = r32(h + 8)
+    local str = anim ~= 0 and B.str(anim) or "-"
+    if r8(h) ~= 0 then out[#out + 1] = string.format("%d:%s(f%d e%d g%d fade%d)", i, str, r8(h + 4), r8(h + 1), r8(h + 2), r8(h + 3)) end
+  end
+  return table.concat(out, " ")
+end
+
+local f, S, A = 0, nil, nil
+local C = CollectibleType
+local function spawn_heart(p, sub)
+  Isaac.Spawn(5, 10, sub, p.Position, Vector(0, 0), nil)
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  f = f + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if f == 20 then
+    say(string.format("player at %08x type %d", a, p:GetPlayerType()))
+    local hud = Game():GetHUD():GetPlayerHUD(0)
+    local s = B.ptr(hud)
+    say(string.format("hud slot %08x: player %08x index %d flash bytes %d %d %d", s, r32(s), B.r16(s + 8), r8(s + 0xc), r8(s + 0xd), r8(s + 0xe)))
+    say("hearts: " .. hearts(hud))
+    S = snap(a)
+  elseif f == 25 then
+    -- Candy Heart (0x29f) and Soul Locket (0x2ae): write 5 into each of the six words with the item held, re-evaluate
+    p:AddCollectible(C.COLLECTIBLE_CANDY_HEART or 671, 0, false)
+    p:AddCollectible(C.COLLECTIBLE_SOUL_LOCKET or 686, 0, false)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    say("both items held: " .. stats(p))
+    local base = { p.Damage, p.MaxFireDelay, p.TearRange, p.ShotSpeed, p.MoveSpeed, p.Luck }
+    for _, row in ipairs({ { "candy", 0x1db0 }, { "locket", 0x1dbc } }) do
+      for i = 0, 5 do
+        local at = a + row[2] + 2 * i
+        local old = B.r16(at)
+        B.w16(at, 5)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+        local now = { p.Damage, p.MaxFireDelay, p.TearRange, p.ShotSpeed, p.MoveSpeed, p.Luck }
+        local names = { "Damage", "FireDelay", "TearRange", "ShotSpeed", "MoveSpeed", "Luck" }
+        local moved = {}
+        for k = 1, 6 do if math.abs(now[k] - base[k]) > 1e-4 then moved[#moved + 1] = string.format("%s %+.3f", names[k], now[k] - base[k]) end end
+        say(string.format("%s word %d (+%04x) = 5 -> %s", row[1], i, row[2] + 2 * i, table.concat(moved, ", ")))
+        B.w16(at, old)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+      end
+    end
+  elseif f == 30 then
+    -- Keeper's Sack (0x2cc) at 0x1fbc
+    p:AddCollectible(716, 0, false)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    local l0 = p.Luck
+    say(string.format("keeper's sack held (has %s): word 0x1fbc = %d; %s", tostring(p:HasCollectible(716)), ri32(a + 0x1fbc), stats(p)))
+    for _, v in ipairs({ 3, 6, 30 }) do
+      w32(a + 0x1fbc, v)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+      say(string.format("keeper's sack word = %d: %s", v, stats(p)))
+    end
+    w32(a + 0x1fbc, 0)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+  elseif f == 35 then
+    p:AddCollectible(621, 0, false)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    local base = stats(p)
+    say("red stew scan base: " .. base)
+    for o = 0x1e60, 0x1e90, 4 do
+      local old = r32(a + o)
+      w32(a + o, 600)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+      local now = stats(p)
+      if now ~= base then say(string.format("red stew scan +%04x = 600 -> %s", o, now)) end
+      w32(a + o, old)
+    end
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+  elseif f == 40 then
+    -- the real mechanic: pick up a soul heart and a red heart, see which words the game moves
+    p:AddHearts(-4)
+    p:AddCoins(20)
+    S = snap(a)
+    for i = 1, 8 do Isaac.Spawn(5, 20, 1, p.Position, Vector(0, 0), nil) end
+    say("before pickups: red " .. p:GetHearts() .. " soul " .. p:GetSoulHearts() .. " " .. stats(p))
+    spawn_heart(p, 3)
+  elseif f == 70 then
+    diff("soul heart pickup", a, S, 0x1700, 0x2100)
+    say("after soul heart: " .. stats(p))
+    S = snap(a)
+    spawn_heart(p, 1)
+  elseif f == 100 then
+    diff("red heart pickup", a, S, 0x1700, 0x2100)
+    say("after red heart: " .. stats(p))
+    -- Conception: Immaculate (413) and Cambion (412)
+    p:AddCollectible(413, 0, false)
+    p:AddCollectible(412, 0, false)
+    S = snap(a)
+    say(string.format("conception items held: 0x1930 %d, 0x1934 %d, 0x1938 %08x", ri32(a + 0x1930), ri32(a + 0x1934), r32(a + 0x1938)))
+    p:AddHearts(-2)
+    spawn_heart(p, 1)
+  elseif f == 130 then
+    diff("conception heart pickup", a, S, 0x1900, 0x1960)
+    S = snap(a)
+    w32(a + 0x1930, 14)
+    w32(a + 0x1934, 14)
+    p:AddHearts(-2)
+    spawn_heart(p, 1)
+    say("set both counters to 14 and picked up another heart")
+  elseif f == 160 then
+    diff("conception birth", a, S, 0x1900, 0x1960)
+    say(string.format("conception now: 0x1930 %d, 0x1934 %d, 0x1938 %08x; familiars %d", ri32(a + 0x1930), ri32(a + 0x1934), r32(a + 0x1938), #Isaac.FindByType(3)))
+  elseif f == 170 then
+    -- Red Stew (621): use it, see the duration word
+    p:AddCollectible(621, 6, false)
+    S = snap(a)
+    say("red stew held: " .. tostring(p:HasCollectible(621)) .. " active " .. p:GetActiveItem(0) .. " hp " .. p:GetHearts() .. "/" .. p:GetMaxHearts() .. " " .. stats(p))
+    p:UseActiveItem(621, UseFlag.USE_OWNED, ActiveSlot.SLOT_PRIMARY)
+    say("used Red Stew; hp " .. p:GetHearts() .. "/" .. p:GetMaxHearts() .. " " .. stats(p))
+  elseif f == 172 or f == 200 then
+    say("hp " .. p:GetHearts() .. "/" .. p:GetMaxHearts() .. " " .. stats(p))
+    diff("red stew +" .. (f - 170), a, S, 0x1000, 0x2100)
+    if f == 172 then S = snap(a) end
+  elseif f == 210 then
+    -- Maggy's drain: become Tainted Magdalene, watch a few frames
+    p:ChangePlayerType(22)
+    say("changed to type " .. p:GetPlayerType())
+    S = snap(a)
+  elseif f == 211 or f == 212 or f == 230 or f == 300 then
+    diff("tainted maggy +" .. (f - 210), a, S, 0x1700, 0x2100)
+    S = snap(a)
+  elseif f == 310 then
+    say("hearts: " .. hearts(Game():GetHUD():GetPlayerHUD(0)))
+    local hud = Game():GetHUD():GetPlayerHUD(0)
+    local s = B.ptr(hud)
+    say(string.format("flash bytes %d %d %d", r8(s + 0xc), r8(s + 0xd), r8(s + 0xe)))
+    B.w8(s + 0xc, 40)
+    B.w8(s + 0xd, 50)
+    B.w8(s + 0xe, 60)
+    say(string.format("wrote 40 50 60; layout %d", Game():GetHUD().GetPlayerHUDLayout and 0 or -1))
+  elseif f == 312 or f == 320 then
+    local s = B.ptr(Game():GetHUD():GetPlayerHUD(0))
+    say(string.format("flash bytes %d %d %d", r8(s + 0xc), r8(s + 0xd), r8(s + 0xe)))
+  elseif f == 330 then
+    local hud = B.ptr(Game():GetHUD())
+    local r = B.call(0x009a6570, hud, 0, B.ptr(p))
+    say("HUD::GetPlayerHUDLayout(0, player) = " .. tostring(r))
+    say("DONE probe")
+  end
+end)
+say("listening")
diff --git a/scripts/recomp/rgon/lab_player_items.lua b/scripts/recomp/rgon/lab_player_items.lua
new file mode 100644
index 0000000..fca2421
--- /dev/null
+++ b/scripts/recomp/rgon/lab_player_items.lua
@@ -0,0 +1,351 @@
+-- lab_player_items.lua (development only; ISAAC_RGON_LAB=lab_player_items.lua, worker player-items)
+-- Calls every name api_player_items.lua adds: getters by read-back and by the game's own reaction (Dead Eye's own
+-- ClearDeadEyeCharge, the item-use code setting the Pony charge, the game counting a timer down, the game's costume
+-- vector and its item configuration pointers), actions by what the game does with them. Prints "lab_pi: PASS/FAIL
+-- <what>" and, at the end, "lab_pi: DONE n PASS m FAIL".
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local mod = RegisterMod("rgon lab player items", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_pi: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_pi: %s %s", ok and "PASS" or "FAIL", what))
+end
+local function fails(f, ...) return not pcall(f, ...) end
+
+local P_NAMES = {
+  "GetRUAWizardTimer", "SetRUAWizardTimer", "GetMetronomeCollectibleID", "GetPonyCharge", "SetPonyCharge",
+  "GetPlanCKillCountdown", "SetPlanCKillCountdown", "GetDeadEyeCharge", "GetPeeBurstCooldown", "GetMaxPeeBurstCooldown",
+  "GetBladderCharge", "SetBladderCharge", "GetMaxBladderCharge", "SetMaxBladderCharge", "GetNextUrethraBlockFrame",
+  "SetNextUrethraBlockFrame", "GetEveSumptoriumCharge", "SetEveSumptoriumCharge", "IsUrethraBlocked", "SetUrethraBlock",
+  "GetHeldEntity", "GetSuplexState", "SetSuplexState", "GetSuplexAimCountdown", "SetSuplexAimCountdown",
+  "GetSuplexTargetPosition", "SetSuplexTargetPosition", "GetSuplexLandPosition", "SetSuplexLandPosition",
+  "GetWispCollectiblesList", "GetCostumeLayerMap", "GetCostumeSpriteDescs", "GetEntityConfigPlayer", "AddLocust",
+  "InitPostLevelInitStats", "TryAddToBagOfCrafting", "IncrementPlayerFormCounter", "GetTotalActiveCharge",
+  "CreateAfterimage", "RemovePoopSpell", "GetErrorTrinketEffect", "CanOverrideActiveItem",
+}
+local CSD_NAMES = {
+  "GetSprite", "GetItemConfig", "GetPriority", "IsItemAnimPlaying", "IsFlying", "HasOverlay", "HasSkinAlt",
+  "GetDefaultSkinColor", "GetSkinColor", "GetHeadColor", "GetBodyColor", "CanOverwriteColor", "IsItemStateOnly", "GetPlayerType",
+}
+local PM_NAMES = { "AnyPlayerTypeHasCollectible", "AnyPlayerTypeHasTrinket", "FirstBirthrightOwner", "GetRandomCollectibleOwner", "GetRandomTrinketOwner" }
+local C = CollectibleType
+
+local f = 0
+local steps = {}
+local function at(n, fn) steps[#steps + 1] = { n, fn } end
+local ctx = {}
+local function bytes_at(p, off) return B.r32(B.ptr(p) + off) end
+
+at(10, function(p)
+  for _, n in ipairs(P_NAMES) do
+    check(type(p[n]) == "function" and R.Implemented["EntityPlayer." .. n] == true, "EntityPlayer:" .. n .. " exists and is Implemented")
+  end
+  for _, n in ipairs(PM_NAMES) do
+    check(type(PlayerManager[n]) == "function" and R.Implemented["PlayerManager." .. n] == true, "PlayerManager." .. n .. " exists and is Implemented")
+  end
+  p:AddCollectible(C.COLLECTIBLE_SAD_ONION, 0, false)
+  p:AddCollectible(C.COLLECTIBLE_SPOON_BENDER, 0, false)
+  p:AddCollectible(C.COLLECTIBLE_CRICKETS_HEAD, 0, false)
+  p:AddCollectible(C.COLLECTIBLE_D6, 0, false)
+end)
+
+-- costumes: the game's own vector and its item configuration pointers
+at(14, function(p)
+  local descs = p:GetCostumeSpriteDescs()
+  check(#descs >= 3, "GetCostumeSpriteDescs lists the costumes of three items plus the character (" .. #descs .. ")")
+  local cfg = Isaac.GetItemConfig()
+  local want = {}
+  for _, id in ipairs({ C.COLLECTIBLE_SAD_ONION, C.COLLECTIBLE_SPOON_BENDER, C.COLLECTIBLE_CRICKETS_HEAD }) do want[B.ptr(cfg:GetCollectible(id))] = id end
+  local found, valid = 0, 0
+  for _, d in ipairs(descs) do
+    local c = d:GetItemConfig()
+    if c ~= nil then
+      valid = valid + 1
+      if want[B.ptr(c)] then found = found + 1 end
+    end
+    check(type(d:GetPriority()) == "number" and type(d:IsFlying()) == "boolean" and type(d:HasOverlay()) == "boolean"
+      and type(d:HasSkinAlt()) == "boolean" and type(d:IsItemAnimPlaying()) == "boolean" and type(d:CanOverwriteColor()) == "boolean"
+      and type(d:IsItemStateOnly()) == "boolean", "a CostumeSpriteDesc's flags are booleans and its priority a number")
+    check(d:GetPlayerType() >= -1 and d:GetPlayerType() < 100, "GetPlayerType is a player type (" .. d:GetPlayerType() .. ")")
+    check(d:GetHeadColor() == d:GetDefaultSkinColor() and d:GetBodyColor() == d:GetSkinColor(), "GetHeadColor/GetBodyColor are the old names")
+    local s = d:GetSprite()
+    check(s ~= nil and type(s:GetFilename()) == "string" and s:GetFilename() ~= "", "GetSprite is a loaded sprite: " .. tostring(s and s:GetFilename()))
+    say(string.format("costume item %s priority %d flying %s skin %d/%d", tostring(d:GetItemConfig() and d:GetItemConfig().ID), d:GetPriority(), tostring(d:IsFlying()), d:GetDefaultSkinColor(), d:GetSkinColor()))
+  end
+  check(found == 3, "the three items' configurations are found in the costume vector by pointer (" .. found .. ")")
+  check(valid == #descs - (#descs - valid) and valid >= 3, "stride 0x130: every desc's item pointer resolves or is null (" .. valid .. " of " .. #descs .. ")")
+  local map = p:GetCostumeLayerMap()
+  check(#map == 15, "GetCostumeLayerMap has 15 rows")
+  local used, body = 0, 0
+  for i, row in ipairs(map) do
+    if row.costumeIndex >= 0 then used = used + 1 end
+    if row.isBodyLayer then body = body + 1 end
+    if row.costumeIndex >= #descs then check(false, "layer " .. i .. " costumeIndex " .. row.costumeIndex .. " is outside the costume vector") end
+  end
+  check(used >= 1 and body >= 1, "some layers hold a costume and some are body layers (" .. used .. ", " .. body .. ")")
+  say("layer map: " .. (function() local t = {} for i, r in ipairs(map) do t[#t + 1] = string.format("%d:%d/%d/%d%s", i, r.costumeIndex, r.layerID, r.priority, r.isBodyLayer and "B" or "") end return table.concat(t, " ") end)())
+  local ec = p:GetEntityConfigPlayer()
+  check(ec ~= nil and ec:GetPlayerType() == p:GetPlayerType(), "GetEntityConfigPlayer is the config of the player's type")
+end)
+
+-- charges: the game's own sum
+at(16, function(p)
+  p:FullCharge(0)
+  check(p:GetTotalActiveCharge(0) == p:GetActiveCharge(0) + p:GetBatteryCharge(0), "GetTotalActiveCharge(0) = charge + battery (" .. p:GetTotalActiveCharge(0) .. ")")
+  p:AddCollectible(C.COLLECTIBLE_BATTERY, 0, false)
+  p:FullCharge(0, true)
+  local t = p:GetTotalActiveCharge(0)
+  check(t == p:GetActiveCharge(0) + p:GetBatteryCharge(0) and t > p:GetActiveMaxCharge(0), "with the Battery the total is over the max (" .. t .. " > " .. p:GetActiveMaxCharge(0) .. ")")
+  check(p:GetTotalActiveCharge(1) == 0 and p:GetTotalActiveCharge(7) == 0, "an empty or invalid slot has no charge")
+  check(p:CanOverrideActiveItem(1) == true and p:CanOverrideActiveItem(0) == false, "CanOverrideActiveItem: empty slot yes, D6 no")
+end)
+
+-- natives that REPENTOGON documents with extra arguments or results
+at(18, function(p)
+  p:SetActiveCharge(3, 0)
+  check(p:GetActiveCharge(0) == 3, "SetActiveCharge(3) then GetActiveCharge = 3")
+  check(p:NeedsCharge(0) == true, "NeedsCharge(0) with 3 of 6")
+  p:DischargeActiveItem(0)
+  check(p:GetActiveCharge(0) == 0 and p:GetBatteryCharge(0) == 0, "DischargeActiveItem empties the item")
+  p:FullCharge(0)
+  check(p:GetActiveCharge(0) == p:GetActiveMaxCharge(0), "FullCharge fills it")
+  check(p:GetActiveItem(0) == C.COLLECTIBLE_D6 and p:GetCollectibleNum(C.COLLECTIBLE_SAD_ONION) == 1 and p:HasCollectible(C.COLLECTIBLE_SAD_ONION)
+    and not p:HasCollectible(C.COLLECTIBLE_DEAD_CAT), "GetActiveItem, GetCollectibleNum, HasCollectible")
+  check(p:HasTrinket(TrinketType.TRINKET_SWALLOWED_PENNY) == false and p:GetTrinketMultiplier(TrinketType.TRINKET_SWALLOWED_PENNY) == 0, "HasTrinket / GetTrinketMultiplier without it")
+  check(type(p:GetMaxPocketItems()) == "number" and p:GetMaxPocketItems() >= 1, "GetMaxPocketItems >= 1 (" .. p:GetMaxPocketItems() .. ")")
+  check(type(p:HasInvincibility()) == "boolean", "HasInvincibility is a boolean")
+  check(type(p:GetTearRangeModifier()) == "number", "GetTearRangeModifier is a number")
+  p:AddNullCostume(NullItemID.ID_CHRISTMAS)
+  p:SetPocketActiveItem(C.COLLECTIBLE_YUM_HEART, ActiveSlot.SLOT_POCKET, false)
+  check(p:GetActiveItem(ActiveSlot.SLOT_POCKET) == C.COLLECTIBLE_YUM_HEART, "SetPocketActiveItem puts Yum Heart in the pocket slot")
+  local r = p:ShootRedCandle(Vector(1, 0))
+  check(r ~= nil and r.Type == EntityType.ENTITY_EFFECT, "ShootRedCandle returns the flame effect")
+end)
+
+-- fields the game itself moves
+at(22, function(p)
+  p:AddCollectible(C.COLLECTIBLE_DEAD_EYE, 0, false)
+  p:AddDeadEyeCharge()
+  check(p:GetDeadEyeCharge() >= 1, "after the game's AddDeadEyeCharge, GetDeadEyeCharge = " .. p:GetDeadEyeCharge())
+  local tries = 0
+  while p:GetDeadEyeCharge() ~= 0 and tries < 60 do p:ClearDeadEyeCharge() tries = tries + 1 end
+  check(p:GetDeadEyeCharge() == 0, "the game's own ClearDeadEyeCharge (random, 20/33/50 percent) zeroes it after " .. tries .. " tries")
+  p:AddCollectible(C.COLLECTIBLE_KIDNEY_STONE, 0, false)
+  check(p:GetMaxPeeBurstCooldown() == 30, "GetMaxPeeBurstCooldown = 30, the initialiser's value (" .. p:GetMaxPeeBurstCooldown() .. ")")
+  check(p:GetPeeBurstCooldown() >= 0, "GetPeeBurstCooldown >= 0 (" .. p:GetPeeBurstCooldown() .. ")")
+  check(p:GetMaxBladderCharge() >= 0, "GetMaxBladderCharge reads (" .. p:GetMaxBladderCharge() .. ")")
+  check(p:IsUrethraBlocked() == false, "IsUrethraBlocked is false at the start")
+  say(string.format("bladder %d/%d next urethra %d", p:GetBladderCharge(), p:GetMaxBladderCharge(), p:GetNextUrethraBlockFrame()))
+  p:SetBladderCharge(7)
+  check(p:GetBladderCharge() == 7, "SetBladderCharge(7) reads back")
+  p:SetMaxBladderCharge(p:GetMaxBladderCharge())
+  p:SetUrethraBlock(true)
+  check(p:IsUrethraBlocked() == true, "SetUrethraBlock(true)")
+  p:SetUrethraBlock(false)
+  p:SetNextUrethraBlockFrame(1234)
+  check(p:GetNextUrethraBlockFrame() == 1234, "SetNextUrethraBlockFrame reads back")
+  p:SetNextUrethraBlockFrame(0)
+  p:SetBladderCharge(0)
+  ctx.metro = p:GetMetronomeCollectibleID()
+  p:AddCollectible(C.COLLECTIBLE_METRONOME, 0, false)
+  p:UseActiveItem(C.COLLECTIBLE_METRONOME, UseFlag.USE_NOANIM)
+  say("metronome id " .. ctx.metro .. " -> " .. p:GetMetronomeCollectibleID())
+  check(p:GetMetronomeCollectibleID() ~= 0, "after using Metronome the game's mimicked item is recorded (" .. p:GetMetronomeCollectibleID() .. ")")
+  ctx.pony0 = p:GetPonyCharge()
+  p.Velocity = Vector(10, 0)
+  p:UseActiveItem(C.COLLECTIBLE_PONY, UseFlag.USE_NOANIM)
+  ctx.pony1 = p:GetPonyCharge()
+  check(ctx.pony1 > 0, "after using A Pony the game sets the Pony charge (" .. ctx.pony0 .. " -> " .. ctx.pony1 .. ")")
+  p:SetRUAWizardTimer(100)
+  ctx.rua = p:GetRUAWizardTimer()
+  p:SetPlanCKillCountdown(100)
+  ctx.planc = p:GetPlanCKillCountdown()
+end)
+at(26, function(p)
+  check(p:GetPonyCharge() < ctx.pony1, "the game counts the Pony charge down (" .. ctx.pony1 .. " -> " .. p:GetPonyCharge() .. ")")
+  check(p:GetRUAWizardTimer() < ctx.rua, "the game counts the R U a Wizard timer down (" .. ctx.rua .. " -> " .. p:GetRUAWizardTimer() .. ")")
+  check(p:GetPlanCKillCountdown() < ctx.planc, "the game counts the Plan C countdown down (" .. ctx.planc .. " -> " .. p:GetPlanCKillCountdown() .. ")")
+  p:SetRUAWizardTimer(0)
+  p:SetPlanCKillCountdown(0)
+  p:SetPonyCharge(0)
+  check(p:GetPonyCharge() == 0, "SetPonyCharge(0)")
+  p:SetEveSumptoriumCharge(3)
+  check(p:GetEveSumptoriumCharge() == 3, "SetEveSumptoriumCharge reads back")
+  p:SetEveSumptoriumCharge(0)
+end)
+
+-- Suplex!
+at(30, function(p)
+  check(p:GetSuplexState() == 0 and p:GetSuplexAimCountdown() == 0, "Suplex state and aim countdown are 0 at the start")
+  local t, l = p:GetSuplexTargetPosition(), p:GetSuplexLandPosition()
+  say(string.format("suplex target %.1f,%.1f land %.1f,%.1f", t.X, t.Y, l.X, l.Y))
+  p:SetSuplexTargetPosition(Vector(11, 22))
+  p:SetSuplexLandPosition(Vector(33, 44))
+  check(p:GetSuplexTargetPosition().X == 11 and p:GetSuplexTargetPosition().Y == 22 and p:GetSuplexLandPosition().X == 33 and p:GetSuplexLandPosition().Y == 44,
+    "Suplex target and land positions read back")
+  p:SetSuplexTargetPosition(t)
+  p:SetSuplexLandPosition(l)
+  p:AddCollectible(C.COLLECTIBLE_SUPLEX, 0, false)
+  p:SetActiveCharge(12, ActiveSlot.SLOT_PRIMARY)
+  p.Velocity = Vector(10, 0)
