+-- api_hooks_hud.lua -- callbacks of the HUD, completion marks and item text (worker cb-d, hook slots 224-232).
+-- Same contract as api_hooks.lua: a handler before or after a game function (hook_slots.lua names them), reading
+-- the call's arguments off the guest stack ([esp] the return address, [esp+4] the first argument, `self` = ECX).
+-- What each callback passes and accepts follows REPENTOGON's documentation of it; the code is this layer's.
+--
+--   224 PlayerHUD::RenderHearts       MC_PRE_PLAYERHUD_RENDER_HEARTS (1118), MC_POST_PLAYERHUD_RENDER_HEARTS (1091)
+--   225 CompletionWidget::Render      MC_PRE_COMPLETION_MARKS_RENDER (1216), MC_POST_COMPLETION_MARKS_RENDER (1217)
+--   226 HUD::ShowFortuneText          MC_PRE_FORTUNE_DISPLAY (1483)
+--   227 HistoryHUD::Render            MC_PRE_HISTORYHUD_RENDER (1027), MC_POST_HISTORYHUD_RENDER (1028)
+--   228 HistoryHUD::Recompute         MC_POST_HISTORYHUD_RECOMPUTE (1029)
+--   229 Manager::RecordPlayerCompletion   MC_PRE_COMPLETION_EVENT (1049), MC_POST_COMPLETION_EVENT (1052), and for a mod's
+--                                     characters MC_COMPLETION_MARK_GET (1047), MC_POST_COMPLETION_MARK_GET (1048)
+--   230 PersistentGameData::IncreaseEventCounter   1047 / 1048 for the game's own characters (their marks are event counters)
+--   231 HUD_Message::Show, 232 HUD::ShowStackedItemTextCustomUTF16   MC_PRE_ITEM_TEXT_DISPLAY (1484)
+
+local T = ...
+local B, R, wrap, listening = T.B, T.R, T.wrap, T.listening
+local r8, r16, r32, ri32, rf32, w32, ptr, log = B.r8, B.r16, B.r32, B.ri32, B.rf32, B.w32, B.ptr, B.log
+local type, pairs, ipairs, rawget, rawset, tostring, setmetatable = type, pairs, ipairs, rawget, rawset, tostring, setmetatable
+local mathtype = math.type
+local M = ModCallbacks
+
+local SLOTS
+do
+  local chunk, why = B.load("hook_slots.lua")
+  if not chunk then log("api_hooks_hud: no hook_slots.lua (" .. tostring(why) .. ")") return end
+  SLOTS = chunk()
+end
+if B.HOOKS < 233 then log("api_hooks_hud: this engine has " .. B.HOOKS .. " hook slots; the callbacks here need 233") return end
+
+local function slot_of(name)
+  local s = SLOTS[name]
+  if not s then log("api_hooks_hud: no hook slot for " .. name) return nil end
+  return s[1], s[2]
+end
+local function run(...) return T.run(...) end
+local function bool_at(a) return r8(a) ~= 0 end
+local function vec_at(a) return Vector(rf32(a), rf32(a + 4)) end
+local told = {}
+local function said(key, what)
+  if told[key] then return end
+  told[key] = true
+  log(what)
+end
+local function wrong(what, a)
+  said(what, string.format("api_hooks_hud: %s was handed 0x%08x, which is not what it should be; the call goes on unwatched", what, a))
+end
+
+-- a C string, or nil for a null pointer
+local function cstr_at(a)
+  if a == 0 then return nil end
+  local ok, s = pcall(B.str, a)
+  return ok and s or nil
+end
+-- a UTF-16 string (the game's wchar_t), as UTF-8; nil for a null pointer
+local function wstr_at(a)
+  if a == 0 then return nil end
+  local out, n = {}, 0
+  local ok = pcall(function()
+    while n < 1024 do
+      local c = r16(a + 2 * n)
+      if c == 0 then break end
+      n = n + 1
+      if c >= 0xd800 and c < 0xdc00 then
+        local d = r16(a + 2 * n)
+        if d >= 0xdc00 and d < 0xe000 then
+          n = n + 1
+          c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00)
+        end
+      end
+      out[#out + 1] = utf8.char(c)
+    end
+  end)
+  if not ok then return nil end
+  return table.concat(out)
+end
+
+------------------------------------------------------------------------------
+-- PlayerHUD::RenderHearts(Vector* offset, ANM2* sprite, int layout, float scale, Vector pos), ret 0x18 (slot 224)
+------------------------------------------------------------------------------
+-- `this` is one of the HUD's eight 0x6dc-byte player slots (api_hooks.lua checks the same grid for RenderActiveItem): it must lie on that
+-- grid and hold the HUD (+4), its own index (+8) and a player (+0). The callbacks get (offset, hearts sprite, position, scale, player); the
+-- position handed over is moved down 34 for the compact Esau layout (index above 3 with layout 3), as REPENTOGON's is.
+-- PRE -> true: the hearts are not drawn.
+do
+  local PRE, POST = M.MC_PRE_PLAYERHUD_RENDER_HEARTS, M.MC_POST_PLAYERHUD_RENDER_HEARTS
+  local slot = slot_of("PlayerHUD::RenderHearts")
+  if slot and PRE and POST then
+    local SLOT_SIZE = 0x6dc
+    T.define(slot, { PRE, POST }, function(self, esp)
+      local hud = ptr(Game():GetHUD())
+      local off = self - hud
+      local index = off // SLOT_SIZE
+      if hud == 0 or off < 0 or off % SLOT_SIZE ~= 0 or index > 7 or r32(self + 4) ~= hud or r16(self + 8) ~= index then
+        wrong("PlayerHUD::RenderHearts", self)
+        return
+      end
+      local player = wrap("EntityPlayer", r32(self))
+      if not player then return end
+      local okg, ghost = pcall(player.IsCoopGhost, player)
+      if okg and ghost then return end
+      local offset_ptr, sprite_ptr, layout, scale = r32(esp + 4), r32(esp + 8), ri32(esp + 12), rf32(esp + 16)
+      local pos = Vector(rf32(esp + 20), rf32(esp + 24))
+      if index > 3 and layout == 3 then pos.Y = pos.Y + 34 end
+      local offset = offset_ptr ~= 0 and vec_at(offset_ptr) or Vector(0, 0)
+      local sprite = wrap("Sprite", sprite_ptr)
+      if listening[PRE] then
+        local res = run(PRE, nil, offset, sprite, Vector(pos.X, pos.Y), scale, player)
+        if res == true then return true, 0, 0x18 end
+      end
+      return { offset, sprite, pos, scale, player }
+    end, function(self, esp, eax, k)
+      if k and listening[POST] then run(POST, nil, k[1], k[2], k[3], k[4], k[5]) end
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- CompletionWidget::Render(Vector* pos, Vector* scale), ret 8 (slot 225)
+------------------------------------------------------------------------------
+-- The widget is { int characterId @ +0, ANM2 @ +4 } (read back by lab_cb_d.lua). Called by the character menu and the pause screen.
+-- PRE (sprite, position, scale, character id) -> true: not drawn.
+do
+  local PRE, POST = M.MC_PRE_COMPLETION_MARKS_RENDER, M.MC_POST_COMPLETION_MARKS_RENDER
+  local slot = slot_of("CompletionWidget::Render")
+  if slot and PRE and POST then
+    T.define(slot, { PRE, POST }, function(self, esp)
+      local pos_ptr, scale_ptr = r32(esp + 4), r32(esp + 8)
+      if pos_ptr == 0 or scale_ptr == 0 then return end
+      local sprite, pos, scale, id = wrap("Sprite", self + 4), vec_at(pos_ptr), vec_at(scale_ptr), ri32(self)
+      if listening[PRE] then
+        local res = run(PRE, nil, sprite, pos, scale, id)
+        if res == true then return true, 0, 8 end
+      end
+      return { sprite, pos, scale, id }
+    end, function(self, esp, eax, k)
+      if k and listening[POST] then run(POST, nil, k[1], k[2], k[3], k[4]) end
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- HUD::ShowFortuneText(list), ret 4 (slot 226): MC_PRE_FORTUNE_DISPLAY () -> false: the fortune is not shown
+------------------------------------------------------------------------------
+do
+  local PRE = M.MC_PRE_FORTUNE_DISPLAY
+  local slot = slot_of("HUD::ShowFortuneText")
+  if slot and PRE then
+    T.define(slot, { PRE }, function()
+      if run(PRE, nil) == false then return true, 0, 4 end
+    end, nil)
+  end
+end
+
+------------------------------------------------------------------------------
+-- HistoryHUD (the item history down the left side): Render(Vector* pos, bool mini) ret 8 (slot 227),
+-- Recompute(int player, bool immediate) ret 8 (slot 228). The object the callbacks get is the game's, by address; it has no methods yet
+-- (GetCollectibles and the others are not implemented), so it is only to tell which one it is.
+------------------------------------------------------------------------------
+local HistoryHUD = rawget(_G, "HistoryHUD")
+if HistoryHUD == nil then
+  HistoryHUD = { __type = "HistoryHUD", __name = "HistoryHUD" }
+  HistoryHUD.__index = HistoryHUD
+  rawset(_G, "HistoryHUD", HistoryHUD)
+end
+local huds = setmetatable({}, { __mode = "v" })
+local function history_at(a)
+  local h = huds[a]
+  if not h then
+    h = setmetatable({ address = a }, HistoryHUD)
+    huds[a] = h
+  end
+  return h
+end
+T.history_hud = history_at
+do
+  local PRE, POST = M.MC_PRE_HISTORYHUD_RENDER, M.MC_POST_HISTORYHUD_RENDER
+  local slot = slot_of("HistoryHUD::Render")
+  if slot and PRE and POST then
+    T.define(slot, { PRE, POST }, function(self, esp)
+      local pos_ptr = r32(esp + 4)
+      if pos_ptr == 0 then return end
+      local hud, pos, mini = history_at(self), vec_at(pos_ptr), bool_at(esp + 8)
+      if listening[PRE] then
+        local res = run(PRE, nil, hud, Vector(pos.X, pos.Y), mini)
+        if res == false then return true, 0, 8 end
+        if type(res) == "table" then
+          said("hist_table", "accepted, not supported in the browser: a table returned from MC_PRE_HISTORYHUD_RENDER (HideCollectibles/HideTrinkets; every item is drawn)")
+        end
+      end
+      return { hud, pos, mini }
+    end, function(self, esp, eax, k)
+      if k and listening[POST] then run(POST, nil, k[1], k[2], k[3]) end
+    end)
+  end
+end
+do
+  local POST = M.MC_POST_HISTORYHUD_RECOMPUTE
+  local slot = slot_of("HistoryHUD::Recompute")
+  if slot and POST then
+    T.define(slot, { POST }, function(self, esp)
+      local idx = ri32(esp + 4)
+      -- the game does not expect -1 here (Strawman with Esau Jr.); REPENTOGON leaves the call out
+      if idx < 0 or idx > 1 then return true, 0, 8 end
+      return { idx, bool_at(esp + 8) }
+    end, function(self, esp, eax, k)
+      if k and k[2] and listening[POST] then run(POST, k[1], history_at(self), k[1]) end
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- completion events and marks
+------------------------------------------------------------------------------
+-- Manager::RecordPlayerCompletion(int event), static stdcall, ret 4 (slot 229): MC_PRE_COMPLETION_EVENT (event), param = event
+--   -> false: nothing is recorded; an integer 0..17: that event instead; any other integer: nothing is recorded.
+--   MC_POST_COMPLETION_EVENT (event) after the game's own recording.
+-- For each player of a mod's character (type above 40) whose mark for the event is lower than the run's (1 normal, 2 hard), the game
+-- has no place for it: MC_COMPLETION_MARK_GET (character, mark, character) may answer false, then Isaac.SetCompletionMark records it
+-- and MC_POST_COMPLETION_MARK_GET (character, mark, character) follows. The game's own characters' marks go through the event
+-- counters (slot 230).
+-- PersistentGameData::IncreaseEventCounter(event, amount), ret 8 (slot 230): the game's characters' marks are the counters
+-- PROGRESSION_KILL_<boss>_WITH_<character>, PROGRESSION_GREED_MODE_CLEARED_WITH_<character> and PROGRESSION_BOSSRUSH_CLEARED_WITH_<character>
+-- (EventCounter, enums). A positive amount on one of them runs MC_COMPLETION_MARK_GET (character, mark, character) before (false: the
+-- counter is not raised) and MC_POST_COMPLETION_MARK_GET after. Hard mode raises it twice (the game's own doing); the second call
+-- of a pair gets the first one's answer without asking again.
+local PRE_EVENT, POST_EVENT = M.MC_PRE_COMPLETION_EVENT, M.MC_POST_COMPLETION_EVENT
+local MARK_GET, MARK_POST = M.MC_COMPLETION_MARK_GET, M.MC_POST_COMPLETION_MARK_GET
+local CT = rawget(_G, "CompletionType")
+
+local function is_hard()
+  local g = Game()
+  local ok, hard = pcall(function() return g:IsHardMode() end)
+  if ok and type(hard) == "boolean" then return hard end
+  local okd, d = pcall(function() return g.Difficulty end)
+  return okd and mathtype(d) == "integer" and (d == 1 or d == 3) or false
+end
+
+do
+  local slot = slot_of("Manager::RecordPlayerCompletion")
+  if slot and PRE_EVENT and POST_EVENT then
+    local ids = { PRE_EVENT, POST_EVENT }
+    if MARK_GET and MARK_POST and type(Isaac.SetCompletionMark) == "function" then ids[3], ids[4] = MARK_GET, MARK_POST end
+    T.define(slot, ids, function(self, esp)
+      local event = ri32(esp + 4)
+      if listening[PRE_EVENT] then
+        local res = run(PRE_EVENT, event, event)
+        if res == false then return true, 0, 4 end
+        if mathtype(res) == "integer" then
+          if res >= 0 and res <= 17 then
+            event = res
+            w32(esp + 4, res)
+          else
+            return true, 0, 4
+          end
+        end
+      end
+      -- a mod's characters
+      if ids[3] and (listening[MARK_GET] or listening[MARK_POST]) and Game() and not Game():AchievementUnlocksDisallowed() then
+        local level = is_hard() and 2 or 1
+        for i = 0, Game():GetNumPlayers() - 1 do
+          local ok, pt = pcall(function() return Isaac.GetPlayer(i):GetPlayerType() end)
+          if ok and pt > 40 then
+            local okm, cur = pcall(Isaac.GetCompletionMark, pt, event)
+            if okm and cur < level then
+              if not listening[MARK_GET] or run(MARK_GET, pt, event, pt) ~= false then
+                Isaac.SetCompletionMark(pt, event, level)
+                if listening[MARK_POST] then run(MARK_POST, pt, event, pt) end
+              end
+            end
+          end
+        end
+      end
+      return { event }
+    end, function(self, esp, eax, k)
+      if k and listening[POST_EVENT] then run(POST_EVENT, k[1], k[1]) end
+    end)
+  end
+end
+
+do
+  local slot = slot_of("PersistentGameData::IncreaseEventCounter")
+  if slot and MARK_GET and MARK_POST and CT and rawget(_G, "EventCounter") then
+    -- character name in the counters' names -> player type (the base type of each character; marks of Lazarus II, Black Judas, Esau
+    -- and the other forms are their base character's)
+    local CHAR = { ISAAC = 0, MAGDALENE = 1, CAIN = 2, JUDAS = 3, BLUE_BABY = 4, EVE = 5, SAMSON = 6, AZAZEL = 7, LAZARUS = 8, EDEN = 9,
+                   THE_LOST = 10, LILITH = 13, KEEPER = 14, APOLLYON = 15, THE_FORGOTTEN = 16, BETHANY = 18, JACOB_AND_ESAU = 19 }
+    local base = { ISAAC = 21, MAGDALENE = 22, CAIN = 23, JUDAS = 24, BLUE_BABY = 25, EVE = 26, SAMSON = 27, AZAZEL = 28, LAZARUS = 29,
+                   EDEN = 30, THE_LOST = 31, LILITH = 32, KEEPER = 33, APOLLYON = 34, THE_FORGOTTEN = 35, BETHANY = 36, JACOB_AND_ESAU = 37 }
+    for name, v in pairs(base) do CHAR["T_" .. name] = v end
+    local BOSS = { MOMS_HEART = CT.MOMS_HEART, ISAAC = CT.ISAAC, SATAN = CT.SATAN, BLUE_BABY = CT.BLUE_BABY, LAMB = CT.LAMB,
+                   MEGA_SATAN = CT.MEGA_SATAN, HUSH = CT.HUSH, MOTHER = CT.MOTHER, DELIRIUM = CT.DELIRIUM, BEAST = CT.BEAST }
+    local map = {}                   -- event counter id -> { player type, completion type }
+    local function build()
+      for name, id in pairs(EventCounter) do
+        if mathtype(id) == "integer" then
+          local who = name:match("^PROGRESSION_GREED_MODE_CLEARED_WITH_(.+)$")
+          local kind = who and "greed"
+          if not who then who = name:match("^PROGRESSION_BOSSRUSH_CLEARED_WITH_(.+)$") kind = who and CT.BOSS_RUSH end
+          if not who then
+            local boss
+            boss, who = name:match("^PROGRESSION_KILL_(.-)_WITH_(.+)$")
+            kind = boss and BOSS[boss]
+          end
+          if who and CHAR[who] and kind then map[id] = { CHAR[who], kind } end
+        end
+      end
+    end
+    build()
+    local last, returned_false = -1, false
+    T.define(slot, { MARK_GET, MARK_POST }, function(self, esp)
+      local event, amount = ri32(esp + 4), ri32(esp + 8)
+      local m = amount > 0 and map[event]
+      if not m then return end
+      local hard = is_hard()
+      if hard and last == event and amount == 1 then
+        if returned_false then
+          returned_false = false
+          return true, 0, 8
+        end
+        return
+      end
+      local kind = m[2]
+      if kind == "greed" then kind = (Game().Difficulty == 3) and CT.ULTRA_GREEDIER or CT.ULTRA_GREED end
+      if listening[MARK_GET] and run(MARK_GET, m[1], kind, m[1]) == false then
+        if hard and amount == 1 then last, returned_false = event, true end
+        return true, 0, 8
+      end
+      return { m[1], kind, hard and amount == 1, event }
+    end, function(self, esp, eax, k)
+      if not k then return end
+      if listening[MARK_POST] then run(MARK_POST, k[1], k[2], k[1]) end
+      if k[3] then last = k[4] end
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- MC_PRE_ITEM_TEXT_DISPLAY (1484): (title, subtitle, sticky, curse) -> false: the text is not shown
+------------------------------------------------------------------------------
+-- HUD_Message::Show(const char* title, const char* subtitle, bool autoHide, bool isCurse), ret 0x10 (slot 231): the stage name popup, custom
+-- text (HUD:ShowItemText with strings), co-op pickups. sticky is `not autoHide`.
+-- HUD::ShowStackedItemTextCustomUTF16(wchar_t* title, wchar_t* subtitle, bool, bool), ret 0x10 (slot 232): HUD::ShowItemText's item names.
+do
+  local PRE = M.MC_PRE_ITEM_TEXT_DISPLAY
+  local slot1 = slot_of("HUD_Message::Show")
+  if slot1 and PRE then
+    T.define(slot1, { PRE }, function(self, esp)
+      local title, subtitle = cstr_at(r32(esp + 4)), cstr_at(r32(esp + 8))
+      if run(PRE, nil, title, subtitle, not bool_at(esp + 12), bool_at(esp + 16)) == false then return true, 0, 0x10 end
+    end, nil)
+  end
+  local slot2 = slot_of("HUD::ShowStackedItemTextCustomUTF16")
+  if slot2 and PRE then
+    T.define(slot2, { PRE }, function(self, esp)
+      local title, subtitle = wstr_at(r32(esp + 4)), wstr_at(r32(esp + 8))
+      if run(PRE, nil, title, subtitle, false, false) == false then return true, 0, 0x10 end
+    end, nil)
+  end
+end
