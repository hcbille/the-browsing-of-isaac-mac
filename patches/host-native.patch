+#if defined(ISAAC_NATIVE) && ISAAC_NATIVE
+/* Mac Build: the Guest's lua_Debug is the 32-bit layout (100 bytes); native
+ * Lua's has 8-byte pointers. Copy across in both directions. Offsets:
+ * event 0, name 4, namewhat 8, what 12, source 16, currentline 20,
+ * linedefined 24, lastlinedefined 28, nups 32, nparams 33, isvararg 34,
+ * istailcall 35, short_src 36 (LUA_IDSIZE 60), i_ci 96. */
+enum { GDBG_SIZE = 100, GDBG_SRC = 36, GDBG_CI = 96 };
+
+/* A string Lua returns may be a C literal in the Host image ("=[C]", "main",
+ * ""), outside the Guest region. Give each such literal one Guest copy. */
+static uint32_t guest_str(const char *s) {
+    if (!s) return 0;
+    uintptr_t d = (uintptr_t)s - (uintptr_t)recomp_mem_base;
+    if (!(d >> 32)) return (uint32_t)d;
+    static struct { const char *host; uint32_t va; } cache[64];
+    static unsigned n;
+    for (unsigned i = 0; i < n; ++i) if (cache[i].host == s) return cache[i].va;
+    uint32_t len = (uint32_t)strlen(s) + 1;
+    uint32_t va = isaac_guest_alloc(len);
+    if (!va) return 0;
+    memcpy(isaac_g(va), s, len);
+    if (n < 64) { cache[n].host = s; cache[n].va = va; ++n; }
+    return va;
+}
+static void dbg_from_guest(uint32_t va, lua_Debug *ar) {
+    memset(ar, 0, sizeof *ar);
