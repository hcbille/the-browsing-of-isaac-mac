+  check(#pickups(100) == 1, "answer false: the pedestal was not consumed (left " .. #pickups(100) .. ")")
+  beh.MC_PRE_PICKUP_VOIDED = nil
+  reset("MC_PRE_PICKUP_VOIDED")
+  local p = pl()
+  p:SetActiveCharge(12, ActiveSlot.SLOT_PRIMARY)
+  p:UseActiveItem(CollectibleType.COLLECTIBLE_VOID, USE, ActiveSlot.SLOT_PRIMARY)
+  wait("void consumes", 120, function() return #pickups(100) == 0 end)
+end)
+step(function()
+  check(#pickups(100) == 0, "no answer: Void consumed the pedestal (callback count " .. count("MC_PRE_PICKUP_VOIDED") .. ")")
+end)
+
+-- 6. Compost
+step(function()
+  clear_pickups()
+  for _, n in ipairs(NAMES) do reset(n) end
+  local p = pl()
+  Isaac.Spawn(5, 20, 1, Vector(p.Position.X + 50, p.Position.Y), Vector(0, 0), nil)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_COMPOST, 12, false)
+  beh.MC_PRE_PICKUP_COMPOSTED = function(pk) return false end
+  p:UseActiveItem(CollectibleType.COLLECTIBLE_COMPOST, USE, ActiveSlot.SLOT_PRIMARY)
+  wait("compost callback", 90, function() return count("MC_PRE_PICKUP_COMPOSTED") >= 1 end)
+end)
+step(function()
+  local r = last("MC_PRE_PICKUP_COMPOSTED")
+  check(r ~= nil, "MC_PRE_PICKUP_COMPOSTED fired")
+  if r then check(r.text == "pickup:20/1", "args (coin): " .. r.text) end
+  check(#pickups(20) == 1, "answer false: the coin was not consumed (left " .. #pickups(20) .. ")")
+  beh.MC_PRE_PICKUP_COMPOSTED = nil
+  local p = pl()
+  p:SetActiveCharge(12, ActiveSlot.SLOT_PRIMARY)
+  p:UseActiveItem(CollectibleType.COLLECTIBLE_COMPOST, USE, ActiveSlot.SLOT_PRIMARY)
+  wait("compost consumes", 120, function() return #pickups(20) == 0 end)
+end)
+step(function()
