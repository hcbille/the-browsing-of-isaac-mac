+    -- MC_PRE_<X>_GRID_COLLISION (1171 player, 1173 tear, 1175 familiar, 1177 bomb, 1179 pickup, 1181 projectile, 1183 npc):
+    -- (entity, gridIndex, gridEntity), param = the entity's variant (the NPC's type) -> true: the entity does not collide with
+    -- that cell. MC_<X>_GRID_COLLISION (+1): the same, when it does (not run when the pre answered true). The game's movement code
+    -- of every entity (Entity::move_with_grid 0x006a9c90) asks Room::GetGridCollision(index) per collision-box point and class;
+    -- the hooks sit on each class's test (tools/hook_table.py slots 215-219) and an ignored collision gets the answer "none".
+    -- An entity checks one cell many times a frame: the answer is kept per (entity, cell) until the next frame, as REPENTOGON does.
+    local COLL = {
+      -- familiars (type 3: 1175/1176) are not wired: a Brother Bobby pushed into a rock at 8 px/frame passed it with no call (the
+      -- familiar's grid collision class is none), so no collision exists to report and the names stay out of Implemented
+      [1] = { 1171, 1172, "EntityPlayer" }, [2] = { 1173, 1174, "EntityTear" },
+      [4] = { 1177, 1178, "EntityBomb" }, [5] = { 1179, 1180, "EntityPickup" }, [9] = { 1181, 1182, "EntityProjectile" },
+    }
+    local NPC_COLL = { 1183, 1184, "EntityNPC" }
+    local coll_cache, coll_frame = {}, -1
+    local function grid_collision(ent, idx)
+      if idx < 0 or idx >= 448 then return false end
+      if vt_of(ent) == nil or not ANY_ENTITY[vt_of(ent)] then wrong("Entity::GridCollision (the entity)", ent) return false end
+      local t = r32(ent + E_TYPE)
+      local c = COLL[t] or (t >= 10 and t < 1000 and NPC_COLL) or nil
+      if not c then return false end
+      local pre, post = c[1], c[2]
+      local param = COLL[t] and r32(ent + E_VARIANT) or t
+      if not (wants(pre, param) or wants(post, param)) then return false end
+      local frame = Game():GetFrameCount()
+      if frame ~= coll_frame then coll_cache, coll_frame = {}, frame end
+      local key = ent * 1024 + idx
+      local had = coll_cache[key]
+      if had ~= nil then return had end
+      local e = wrap(c[3], ent)
+      local g = Game():GetRoom():GetGridEntity(idx)
+      local ignored = false
+      if wants(pre, param) and run(pre, param, e, idx, g) == true then ignored = true end
+      if not ignored and wants(post, param) then run(post, param, e, idx, g) end
+      coll_cache[key] = ignored
+      return ignored
+    end
+    local COLL_IDS = {}
+    for _, c in pairs(COLL) do COLL_IDS[#COLL_IDS + 1] = c[1] COLL_IDS[#COLL_IDS + 1] = c[2] end
+    COLL_IDS[#COLL_IDS + 1] = NPC_COLL[1] COLL_IDS[#COLL_IDS + 1] = NPC_COLL[2]
+    if M.MC_PRE_TEAR_GRID_COLLISION then
+      local ENT = 0x1c                    -- [esp+0x1c] holds the entity all through move_with_grid
+      -- BULLET (4): at the `mov byte [edi+0x190], 1` that marks a hit; eax = the GridEntity there, edi the entity
+      at("Entity::GridCollision@Bullet", COLL_IDS, function(esp)
+        local g = wrap("GridEntity", reg("eax"))
+        if g and grid_collision(reg("edi"), g:GetGridIndex()) then return 0x006ab22e end
+      end)
+      -- GROUND (5), PITSONLY (7), WALLS (3): right after Room::GetGridCollision(index) (eax = its answer; the index was its
+      -- stack argument, [esp-4] still): an ignored collision is answered as "none" (GROUND, WALLS: 0; PITSONLY: 1, a pit)
+      local function after_call(name, ignore_if, answer)
+        at(name, COLL_IDS, function(esp)
+          local col = reg("eax")
+          if not ignore_if(col) then return end
+          local idx = ri32(esp - 4)
+          if grid_collision(r32(esp + ENT), idx) then reg("eax", answer) end
+        end)
+      end
+      after_call("Entity::GridCollision@Ground", function(c) return c ~= 0 end, 0)
+      after_call("Entity::GridCollision@PitsOnly", function(c) return c ~= 1 end, 1)
+      after_call("Entity::GridCollision@Walls", function(c) return (c == 4 or c == 5) and Game():GetRoom():GetType() ~= 16 end, 0)
+      -- NOPITS (6): where the game moves the entity back out of a non-empty cell; [esp+0x24] the column, ecx the row
+      at("Entity::GridCollision@NoPits", COLL_IDS, function(esp)
+        local width = r32(reg("esi") + 0xc)
+        local idx = signed(reg("ecx")) * width + ri32(esp + 0x24)
+        if grid_collision(r32(esp + ENT), idx) then return 0x006aa4a8 end
+      end)
+      -- the player has its own function (Entity_Player::CollideWithGrid, 0x006ab440): after the collision test of each box point,
+      -- eax = the collision value (0: none), [ebp-0x20] the cell, edi the player; ignoring skips to the point's iteration end
+      at("Entity_Player::CollideWithGrid@Cell", COLL_IDS, function(esp, ebp)
+        if reg("eax") == 0 then return end
+        if grid_collision(reg("edi"), ri32(ebp - 0x20)) then return 0x006ab9de end
+      end)
+    end
+
+    -- EntityKnife:Get/SetHitboxParentKnife: the game's melee hitbox knife is linked to the weapon knife where update_bone_swing
+    -- spawns it (slot 223: esi the weapon knife, edi the hitbox); api_batch_two.lua keeps the link.
+    at("Entity_Knife::update_bone_swing@HitboxInit", { T.ALWAYS }, function()
+      local hit, main = reg("edi"), reg("esi")
+      if hit ~= 0 and main ~= 0 and hit ~= main and T.set_knife_parent then T.set_knife_parent(hit, main) end
+    end)
+    if T.set_knife_parent then
