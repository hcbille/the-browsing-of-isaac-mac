+-- lab_census_test.lua (development only; ISAAC_RGON_LAB=lab_census_test.lua, round 124)
+-- Runs the read-only names api_census.lua added, once in the first room, and logs "lab_census_test: PASS/FAIL ..".
+-- Names that change the game (SpawnClot, DropCollectible, TrySpawnLadder ...) are only checked for existing.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab census test", 1)
+local done = false
+local function check(name, ok, detail)
+  B.log("lab_census_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if done then return end
+  done = true
+  local p = Isaac.GetPlayer(0)
+  try("RNG", function()
+    local r = RNG()
+    r:SetSeed(123456, 35)
+    check("RNG.GetShiftIdx", r:GetShiftIdx() == 35, r:GetShiftIdx())
+    local s0 = r:GetSeed()
+    local pn = r:PhantomNext()
+    check("RNG.PhantomNext keeps seed", r:GetSeed() == s0)
+    check("RNG.PhantomNext == Next", r:Next() == pn, tostring(pn))
+    local after = r:GetSeed()
+    check("RNG.PhantomPrevious", r:PhantomPrevious() == s0, r:PhantomPrevious())
+    r:Previous()
+    check("RNG.Previous", r:GetSeed() == s0 and after ~= s0, r:GetSeed())
+    local i = r:PhantomInt(10)
+    check("RNG.PhantomInt(max)", i >= 0 and i < 10 and r:GetSeed() == s0, i)
+    local j = r:PhantomInt(5, 7)
+    check("RNG.PhantomInt(min,max)", j >= 5 and j <= 7, j)
+    local f = r:PhantomFloat()
+    check("RNG.PhantomFloat", f >= 0 and f < 1, f)
+  end)
+  try("EntityConfigPlayer", function()
+    local c = EntityConfig.GetPlayer(0)
+    check("EntityConfigPlayer Isaac", c:GetRedHearts() == 6 and c:GetSoulHearts() == 0 and c:GetBlackHearts() == 0 and c:GetCoins() == 0 and c:GetBombs() == 1 and c:GetKeys() == 0 and c:CanShoot() == true,
+      string.format("red %d soul %d black %d coins %d bombs %d keys %d", c:GetRedHearts(), c:GetSoulHearts(), c:GetBlackHearts(), c:GetCoins(), c:GetBombs(), c:GetKeys()))
+    local m = EntityConfig.GetPlayer(1)
+    check("EntityConfigPlayer Magdalene", m:GetRedHearts() == 8, m:GetRedHearts())
+    local b = EntityConfig.GetPlayer(14)
+    check("EntityConfigPlayer Lost", b:CanShoot() ~= nil, tostring(b:CanShoot()))
+  end)
+  try("ItemConfig.GetTaggedItems", function()
+    local list = Isaac.GetItemConfig():GetTaggedItems(ItemConfig.TAG_OFFENSIVE)
+    local ok = #list > 10
+    for _, it in ipairs(list) do if not it:HasTags(ItemConfig.TAG_OFFENSIVE) then ok = false end end
+    check("ItemConfig:GetTaggedItems", ok, #list)
+  end)
+  try("Isaac", function()
+    local id = Isaac.GetCutsceneIdByName("Intro")
+    check("Isaac.GetCutsceneIdByName", math.type(id) == "integer" and id ~= -1, id)
+    check("Isaac.GetCutsceneIdByName none", Isaac.GetCutsceneIdByName("no such cutscene") == -1)
+  end)
+  try("Game/Level/Room", function()
+    check("Game:IsHardMode", Game():IsHardMode() == false)
+    check("Level:HasPhotoDoor", Game():GetLevel():HasPhotoDoor() == false)
+    local room = Game():GetRoom()
+    check("Room:CanPickupGridEntity", type(room:CanPickupGridEntity(0)) == "boolean")
+    check("Room:CanSpawnObstacleAtPosition", type(room:CanSpawnObstacleAtPosition(room:GetGridIndex(p.Position))) == "boolean")
+    check("Room:GetBossVictoryJingle", math.type(room:GetBossVictoryJingle()) == "integer", room:GetBossVictoryJingle())
+  end)
+  try("EntityPlayer", function()
+    check("EntityPlayer:HasPoisonImmunity", p:HasPoisonImmunity() == false)
+    check("EntityPlayer:IsHeadless", p:IsHeadless() == false)
+    check("EntityPlayer:IsInvisible", p:IsInvisible() == false)
+    check("EntityPlayer:CanUsePill", type(p:CanUsePill(0)) == "boolean")
+    check("EntityPlayer:CanAddCollectibleToInventory", p:CanAddCollectibleToInventory(1) == true)
+    check("EntityPlayer:VoidHasCollectible", p:VoidHasCollectible(1) == false)
+    check("EntityPlayer:GetCambionPregnancyLevel", p:GetCambionPregnancyLevel() == 0)
+    check("EntityPlayer:GetBodyMoveDirection", getmetatable(p:GetBodyMoveDirection()) == getmetatable(Vector(0, 0)))
+    check("EntityPlayer:GetEnterPosition", getmetatable(p:GetEnterPosition()) == getmetatable(Vector(0, 0)))
+    check("EntityPlayer:GetFocusEntity", true, tostring(p:GetFocusEntity()))
+    check("EntityPlayer:IsEntityValidTarget", type(p:IsEntityValidTarget(p)) == "boolean")
+  end)
+  for _, n in ipairs({ "EntityPlayer.AddLeprosy", "EntityPlayer.SpawnClot", "EntityPlayer.DropCollectible", "EntityPlayer.SetActiveVarData", "EntityPlayer.AddBoneOrbital",
+    "EntityPlayer.MorphToCoopGhost", "EntityPlayer.TryPreventDeath", "EntityPickup.SetAlternatePedestal", "EntityFamiliar.CanBlockProjectiles", "GridEntityRock.TrySpawnLadder", "Entity.GiveMinecart" }) do
+    check("exists " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  B.log("lab_census_test: DONE")
+end)
diff --git a/scripts/recomp/rgon/lab_eid_probe.lua b/scripts/recomp/rgon/lab_eid_probe.lua
new file mode 100644
index 0000000..564b903
--- /dev/null
+++ b/scripts/recomp/rgon/lab_eid_probe.lua
@@ -0,0 +1,207 @@
+-- lab_eid_probe.lua (development only; ISAAC_RGON_LAB=lab_eid_probe.lua, External Item Descriptions batch): finds in this
+-- build the structures EID needs, by diffs and scans, and logs "lab_eid_probe: ..." lines. Reads only, apart from the game's own
+-- Lua calls that give items and spawn pickups. Steps run one after another, a few frames apart. ISAAC_LAB_PHASES (a
+-- substring list of "form", "bag", "tm", "room"; default all) picks the phases.
+--   form: guppy items one by one: the words of the player that change (player form counters)
+--   bag:  Bag of Crafting and pickups spawned on the player: the words that change (content and output)
+--   tm:   TM Trainer: the glitched items, and the ProceduralItemManager vector in the game object
+--   room: a room's saved entities after leaving it (RoomDescriptor +0x74)
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab eid probe", 1)
+local function say(s) B.log("lab_eid_probe: " .. s) end
+local function snap(a, lo, hi)
+  local t = {}
+  for o = lo, hi - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local SKIP = { [0x1b38] = true, [0x1dec] = true, [0x1df0] = true, [0x1df4] = true, [0x1ea0] = true, [0x1f98] = true }
+local function diff(name, a, before, lo, hi, limit)
+  local n = 0
+  for o = lo, hi - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not SKIP[o] then
+      n = n + 1
+      if n <= (limit or 40) then say(string.format("%s +%04x %08x -> %08x (%d -> %d)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now)) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local LO, HI = 0x1000, 0x2200
+local steps, cur, wait = {}, 1, 0
+local PH = B.env("ISAAC_LAB_PHASES") or "all"
+local function want(ph) return PH == "all" or PH:find(ph, 1, true) ~= nil end
+local function step(delay, f) steps[#steps + 1] = { delay, f } end
+local before, A
+local function player() return Isaac.GetPlayer(0) end
+local G
+local function pvec(tag)
+  G = r32(0x00c71678)
+  say(string.format("%s: procedural vector begin %08x end %08x cap %08x (%d)", tag, r32(G + 0x67758), r32(G + 0x6775c), r32(G + 0x67760), (r32(G + 0x6775c) - r32(G + 0x67758)) // 4))
+end
+
+-- 1. form counters
+if want("form") then
+  local CT = CollectibleType
+  for _, id in ipairs({ CT.COLLECTIBLE_DEAD_CAT, CT.COLLECTIBLE_GUPPYS_PAW, CT.COLLECTIBLE_GUPPYS_TAIL, CT.COLLECTIBLE_GUPPYS_HEAD, CT.COLLECTIBLE_GUPPYS_HAIRBALL, CT.COLLECTIBLE_GUPPYS_COLLAR }) do
+    step(10, function()
+      local p = player()
+      A = B.ptr(p)
+      before = snap(A, LO, HI)
+      p:AddCollectible(id, 0, false)
+      say(string.format("gave collectible %d (player %08x, game %08x, manager %08x)", id, A, r32(0x00c71678), r32(0x00c7169c)))
+    end)
+    step(8, function()
+      diff("guppy item " .. id, A, before, LO, HI)
+      local p = player()
+      say(string.format("HasCollectible %s, GetCollectibleNum %d, HasPlayerForm GUPPY %s", tostring(p:HasCollectible(id)), p:GetCollectibleNum(id), tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY))))
+      local w = {}
+      for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+      say("forms at +17dc: " .. table.concat(w, ","))
+    end)
+  end
+end
+
+if want("form") then
+  step(5, function()
+    local p = player()
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    local w = {}
+    for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+    say("after EvaluateItems, forms at +17dc: " .. table.concat(w, ",") .. " HasPlayerForm GUPPY " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)))
+    Isaac.ExecuteCommand("giveitem c81")
+    Isaac.ExecuteCommand("giveitem c133")
+    Isaac.ExecuteCommand("giveitem c134")
+  end)
+  step(20, function()
+    local p = player()
+    local w = {}
+    for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+    say("after console giveitem x3 (81,133,134), forms: " .. table.concat(w, ",") .. " HasPlayerForm GUPPY " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)) .. " num81 " .. p:GetCollectibleNum(81))
+  end)
+end
+
+-- 2. bag of crafting
+if want("bag") then
+  step(10, function()
+    local p = player()
+    A = B.ptr(p)
+    before = snap(A, LO, HI)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+    say("gave Bag of Crafting")
+  end)
+  step(10, function() diff("bag of crafting given", A, before, LO, HI) end)
+  local boc_pickups = { { 10, 1 }, { 20, 1 }, { 30, 1 }, { 40, 1 }, { 20, 2 }, { 10, 3 }, { 20, 3 }, { 30, 2 } }
+  for i, pk in ipairs(boc_pickups) do
+    step(14, function()
+      local p = player()
+      before = snap(A, LO, HI)
+      local e = Isaac.Spawn(5, pk[1], pk[2], p.Position + Vector(200, 0), Vector(0, 0), nil)
+      local r = B.call(0x007d5170, A, B.ptr(e))
+      say(string.format("spawned pickup 5.%d.%d and called TryAddToBagOfCrafting(0x7d5170): %d", pk[1], pk[2], r & 0xff))
+    end)
+    step(12, function()
+      diff("bag after pickup " .. i, A, before, LO, HI, 12)
+      local w = {}
+      for k = 0, 7 do w[#w + 1] = r8(A + 0x1f44 + k) end
+      say(string.format("content %s output %d pool %d", table.concat(w, ","), ri32(A + 0x1f4c), ri32(A + 0x1f50)))
+    end)
+  end
+end
+
+-- 3. TM Trainer
+if want("tm") then
+  step(10, function()
+    pvec("before")
+    Isaac.ExecuteCommand("giveitem c721")
+    say("console giveitem c721; HasCollectible TMTRAINER " .. tostring(player():HasCollectible(CollectibleType.COLLECTIBLE_TMTRAINER)))
+  end)
+  step(40, function() pvec("after giveitem") end)
+  step(5, function()
+    local p = player()
+    Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_TMTRAINER, p.Position, Vector(0, 0), nil)
+    say("spawned a TM Trainer pedestal on the player")
+  end)
+  step(90, function() pvec("after pedestal") end)
+  step(5, function()
+    local ic = Isaac.GetItemConfig()
+    for id = -1, -4, -1 do
+      local it = ic:GetCollectible(id)
+      say(string.format("itemconfig %d -> %s", id, it and string.format("%08x ID=%d name=%s", B.ptr(it), it.ID, tostring(it.Name)) or "nil"))
+    end
+    local item = ic:GetCollectible(-1)
+    if not item then say("no glitched item -1") return end
+    local ITEM = B.ptr(item)
+    G = r32(0x00c71678)
+    local b = r32(G + 0x67758)
+    local q = r32(b)
+    say(string.format("first record %08x holds item %08x (itemconfig -1 is %08x)", q, r32(q), ITEM))
+    for k = 0, 0x38 - 4, 4 do say(string.format("    record+%02x %08x  %g", k, r32(q + k), B.i2f(r32(q + k)))) end
+    local target = r32(q + 0x10)
+    if target ~= 0 then say(string.format("target %08x: +0 %d +4 %d", target, ri32(target), ri32(target + 4))) end
+    local ev, ee = r32(q + 0x2c), r32(q + 0x30)
+    say(string.format("effects begin %08x end %08x (%d)", ev, ee, (ee - ev) // 4))
+    for i = 0, (ee - ev) // 4 - 1 do
+      local e = r32(ev + 4 * i)
+      local line = {}
+      for k = 0, 0x68 - 4, 4 do line[#line + 1] = string.format("%02x:%08x", k, r32(e + k)) end
+      say(string.format("  effect %d at %08x: %s", i, e, table.concat(line, " ")))
+    end
+  end)
+end
+
+-- 4. a room's saved entities
+if want("room") then
+  local desc_idx
+  step(10, function()
+    local level, room = Game():GetLevel(), Game():GetRoom()
+    local p = player()
+    desc_idx = level:GetCurrentRoomIndex()
+    for i = 1, 3 do
+      Isaac.Spawn(5, 10, 1, room:FindFreePickupSpawnPosition(p.Position + Vector(60 * i, 0), 0, true), Vector(0, 0), nil)
+    end
+    Isaac.Spawn(5, 20, 1, room:FindFreePickupSpawnPosition(p.Position + Vector(0, 60), 0, true), Vector(0, 0), nil)
+    say("spawned 3 hearts and a coin in room " .. desc_idx)
+  end)
+  step(10, function()
+    local level = Game():GetLevel()
+    local target
+    for i = 0, 168 do
+      local d = level:GetRoomByIdx(i)
+      if d and d.GridIndex >= 0 and d.GridIndex ~= desc_idx and d.Data ~= nil and d.ListIndex >= 0 then
+        if (math.abs(d.GridIndex - desc_idx) == 1 or math.abs(d.GridIndex - desc_idx) == 13) then target = d.GridIndex break end
+      end
+    end
+    say("changing to room " .. tostring(target))
+    if target then Game():ChangeRoom(target) end
+  end)
+  step(30, function()
+    local level = Game():GetLevel()
+    local d = level:GetRoomByIdx(desc_idx)
+    local a = B.ptr(d)
+    local b, e = r32(a + 0x74), r32(a + 0x78)
+    local n = (e - b)
+    say(string.format("old room desc %08x: SavedEntities %d bytes = %g elements of 0x78", a, n, n / 0x78))
+    for i = 0, n // 0x78 - 1 do
+      local s = b + i * 0x78
+      if ri32(s) == 5 then
+        say(string.format("  #%d type %d variant %d sub %d i1 %08x i2 %08x i3 %08x", i, ri32(s), ri32(s + 4), ri32(s + 8), r32(s + 0xc), r32(s + 0x10), r32(s + 0x14)))
+      end
+    end
+  end)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  local s = steps[cur]
+  if not s then return end
+  wait = wait + 1
+  if wait >= s[1] then
+    wait = 0
+    cur = cur + 1
+    local ok, err = pcall(s[2])
+    if not ok then say("step " .. (cur - 1) .. " failed: " .. tostring(err)) end
+    if cur > #steps then say("done") end
+  end
+end)
