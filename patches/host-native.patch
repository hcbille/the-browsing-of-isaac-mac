+-- lab_cb_d.lua (development only; ISAAC_RGON_LAB=lab_cb_d.lua, worker cb-d)
+-- Fires the HUD / completion / text callbacks (hook slots 224-232) and checks their arguments and what an answer does.
+-- Prints "lab_cb_d: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-d", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_d: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_d: %s %s", ok and "PASS" or "FAIL", what))
+end
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function reset(n) rec[n] = {} end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.X ~= nil then return string.format("vec:%.0f,%.0f", v.X, v.Y) end
+      if v.GetFilename then return "sprite:" .. v:GetFilename() end
+      if v.GetPlayerType then return "player:" .. v:GetPlayerType() end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  if type(v) == "table" then return "table:" .. tostring(v.__type or v.__name) end
+  return tostring(v)
+end
+local NAMES = {
+  "MC_PRE_PLAYERHUD_RENDER_HEARTS", "MC_POST_PLAYERHUD_RENDER_HEARTS", "MC_PRE_COMPLETION_MARKS_RENDER", "MC_POST_COMPLETION_MARKS_RENDER",
+  "MC_PRE_FORTUNE_DISPLAY", "MC_PRE_HISTORYHUD_RENDER", "MC_POST_HISTORYHUD_RENDER", "MC_POST_HISTORYHUD_RECOMPUTE",
+  "MC_PRE_COMPLETION_EVENT", "MC_POST_COMPLETION_EVENT", "MC_COMPLETION_MARK_GET", "MC_POST_COMPLETION_MARK_GET", "MC_PRE_ITEM_TEXT_DISPLAY",
+}
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 3 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+
+local game = Game()
+local function pl() return Isaac.GetPlayer(0) end
+local base = {}
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond) waiting, wait_left, wait_what, wait_cond = true, frames, what, cond end
+
+-- 1. the hearts, every frame
+step(function()
+  wait("hearts callbacks", 60, function() return count("MC_PRE_PLAYERHUD_RENDER_HEARTS") > 0 and count("MC_POST_PLAYERHUD_RENDER_HEARTS") > 0 end)
+end)
+step(function()
+  local r = last("MC_PRE_PLAYERHUD_RENDER_HEARTS")
+  check(r ~= nil and r.n == 5, "PRE hearts: five arguments")
+  if r then
+    check(type(r[1]) == "userdata" and r[1].X ~= nil, "PRE hearts: offset is a Vector (" .. r.text .. ")")
+    check(type(r[2]) == "userdata" and tostring(r.text):find("sprite:", 1, true) ~= nil, "PRE hearts: a Sprite")
+    check(type(r[3]) == "userdata" and r[3].X > 0 and r[3].Y > 0, "PRE hearts: position is on screen")
+    check(type(r[4]) == "number" and r[4] > 0, "PRE hearts: scale is " .. tostring(r[4]))
+    check(type(r[5]) == "userdata" and r[5]:GetPlayerType() == pl():GetPlayerType(), "PRE hearts: the player")
+  end
+  local pr = last("MC_POST_PLAYERHUD_RENDER_HEARTS")
+  check(pr ~= nil and pr.n == 5, "POST hearts: five arguments")
+  base.pre, base.post = count("MC_PRE_PLAYERHUD_RENDER_HEARTS"), count("MC_POST_PLAYERHUD_RENDER_HEARTS")
+  beh.MC_PRE_PLAYERHUD_RENDER_HEARTS = function() return true end
+  wait("render frames", 20, function() return false end)
+end)
+step(function()
+  local pre, post = count("MC_PRE_PLAYERHUD_RENDER_HEARTS"), count("MC_POST_PLAYERHUD_RENDER_HEARTS")
+  check(pre > base.pre, "PRE hearts keeps firing while it cancels")
+  check(post == base.post, "POST hearts does not fire while PRE cancels (" .. base.post .. " -> " .. post .. ")")
+  beh.MC_PRE_PLAYERHUD_RENDER_HEARTS = nil
+end)
+
+-- 2. the history HUD (drawn only with the extra HUD on: Options.ExtraHUDStyle above 0)
+step(function()
+  base.extra = Options.ExtraHUDStyle
+  Options.ExtraHUDStyle = 1
+  wait("history render", 60, function() return count("MC_PRE_HISTORYHUD_RENDER") > 0 and count("MC_POST_HISTORYHUD_RENDER") > 0 end)
+end)
+step(function()
+  local r = last("MC_PRE_HISTORYHUD_RENDER")
+  check(r ~= nil and r.n == 3 and type(r[1]) == "table" and r[2].X ~= nil and type(r[3]) == "boolean", "PRE history render: (HistoryHUD, Vector, bool) (" .. (r and r.text or "none") .. ")")
+  base.hpre, base.hpost = count("MC_PRE_HISTORYHUD_RENDER"), count("MC_POST_HISTORYHUD_RENDER")
+  beh.MC_PRE_HISTORYHUD_RENDER = function() return false end
+  wait("render frames", 20, function() return false end)
+end)
+step(function()
+  check(count("MC_PRE_HISTORYHUD_RENDER") > base.hpre, "PRE history keeps firing while it cancels")
+  check(count("MC_POST_HISTORYHUD_RENDER") == base.hpost, "POST history does not fire while PRE cancels")
+  beh.MC_PRE_HISTORYHUD_RENDER = nil
+  reset("MC_POST_HISTORYHUD_RECOMPUTE")
+  -- the game's own call (immediate) on the history HUD of the HUD object, for the first player
+  local hud = B.ptr(game:GetHUD())
+  B.call(0x0083b280, hud + 0x5c54, 0, 1)
+  local r = last("MC_POST_HISTORYHUD_RECOMPUTE")
+  check(r ~= nil and r.n == 2 and type(r[1]) == "table" and r[2] == 0, "POST history recompute: (HistoryHUD, index 0) (" .. (r and r.text or "none") .. ")")
+  local n = count("MC_POST_HISTORYHUD_RECOMPUTE")
+  B.call(0x0083b280, B.ptr(game:GetHUD()) + 0x5c54, 0, 0)
+  check(count("MC_POST_HISTORYHUD_RECOMPUTE") == n, "recompute that is not immediate: no callback")
+  Options.ExtraHUDStyle = base.extra
+end)
+
+-- 3. fortune text and item text, through the game's own Lua functions
+step(function()
+  local hud = game:GetHUD()
+  reset("MC_PRE_FORTUNE_DISPLAY")
+  local ok, err = pcall(function() hud:ShowFortuneText("lab fortune", "second line") end)
+  check(ok, "HUD:ShowFortuneText runs (" .. tostring(err) .. ")")
+  check(count("MC_PRE_FORTUNE_DISPLAY") == 1, "MC_PRE_FORTUNE_DISPLAY fired once by it (" .. count("MC_PRE_FORTUNE_DISPLAY") .. ")")
+  beh.MC_PRE_FORTUNE_DISPLAY = function() return false end
+  pcall(function() hud:ShowFortuneText("cancelled", "line") end)
+  check(count("MC_PRE_FORTUNE_DISPLAY") == 2, "MC_PRE_FORTUNE_DISPLAY fired for a second one that it cancels")
+  beh.MC_PRE_FORTUNE_DISPLAY = nil
+  reset("MC_PRE_ITEM_TEXT_DISPLAY")
+  local ok2, err2 = pcall(function() hud:ShowItemText("Lab Title", "Lab Subtitle") end)
+  check(ok2, "HUD:ShowItemText(title, subtitle) runs (" .. tostring(err2) .. ")")
+  local r = last("MC_PRE_ITEM_TEXT_DISPLAY")
+  check(r ~= nil and r[1] == "Lab Title" and r[2] == "Lab Subtitle", "MC_PRE_ITEM_TEXT_DISPLAY title and subtitle read back (" .. (r and r.text or "none") .. ")")
+  check(r ~= nil and type(r[3]) == "boolean" and type(r[4]) == "boolean", "MC_PRE_ITEM_TEXT_DISPLAY sticky and curse are booleans")
+end)
+step(function()
+  -- a collectible's name goes through the UTF-16 path
+  reset("MC_PRE_ITEM_TEXT_DISPLAY")
+  local cfg = Isaac.GetItemConfig():GetCollectible(CollectibleType.COLLECTIBLE_SAD_ONION)
+  local ok, err = pcall(function() game:GetHUD():ShowItemText(pl(), cfg) end)
+  check(ok, "HUD:ShowItemText(player, item) runs (" .. tostring(err) .. ")")
+  local r = last("MC_PRE_ITEM_TEXT_DISPLAY")
+  check(r ~= nil and r[1] == "The Sad Onion", "MC_PRE_ITEM_TEXT_DISPLAY item name is The Sad Onion (" .. (r and r.text or "none") .. ")")
+end)
+
+-- 4. completion events and marks
+step(function()
+  local pgd = Isaac.GetPersistentGameData()
+  local c = EventCounter.PROGRESSION_KILL_ISAAC_WITH_ISAAC
+  local before = pgd:GetEventCounter(c)
+  reset("MC_COMPLETION_MARK_GET") reset("MC_POST_COMPLETION_MARK_GET")
+  pgd:IncreaseEventCounter(c, 1)
+  local r = last("MC_COMPLETION_MARK_GET")
+  check(r ~= nil and r[1] == CompletionType.ISAAC and r[2] == 0, "MC_COMPLETION_MARK_GET (ISAAC mark, Isaac) (" .. (r and r.text or "none") .. ")")
+  check(count("MC_POST_COMPLETION_MARK_GET") == 1 and pgd:GetEventCounter(c) == before + 1, "POST mark get fired and the counter rose")
+  beh.MC_COMPLETION_MARK_GET = function() return false end
+  local mid = pgd:GetEventCounter(c)
+  pgd:IncreaseEventCounter(c, 1)
+  check(pgd:GetEventCounter(c) == mid, "MC_COMPLETION_MARK_GET false: the counter did not rise")
+  beh.MC_COMPLETION_MARK_GET = nil
+  -- a counter that is no mark does not fire it
+  reset("MC_COMPLETION_MARK_GET")
+  pgd:IncreaseEventCounter(EventCounter.MOM_KILLS, 1)
+  check(count("MC_COMPLETION_MARK_GET") == 0, "a counter that is no completion mark does not fire MC_COMPLETION_MARK_GET")
+end)
+step(function()
+  reset("MC_PRE_COMPLETION_EVENT") reset("MC_POST_COMPLETION_EVENT")
+  B.call(0x0095a7b0, 0, 1)
+  local r = last("MC_PRE_COMPLETION_EVENT")
+  check(r ~= nil and r[1] == 1, "MC_PRE_COMPLETION_EVENT (event 1) (" .. (r and r.text or "none") .. ")")
+  check(count("MC_POST_COMPLETION_EVENT") == 1, "MC_POST_COMPLETION_EVENT fired after it")
+  beh.MC_PRE_COMPLETION_EVENT = function() return false end
+  B.call(0x0095a7b0, 0, 2)
+  check(count("MC_PRE_COMPLETION_EVENT") == 2 and count("MC_POST_COMPLETION_EVENT") == 1, "MC_PRE_COMPLETION_EVENT false: no POST")
+  beh.MC_PRE_COMPLETION_EVENT = nil
+end)
+
+-- 5. the completion widget, on the pause screen (Escape is injected). The game does not update while paused, so the render callback
+-- reads the result and prints the DONE line itself (the pause screen then stays up until the run ends).
+step(function()
+  base.pause = true
+  base.pause_render = true
+  reset("MC_PRE_COMPLETION_MARKS_RENDER") reset("MC_POST_COMPLETION_MARKS_RENDER")
+  wait("completion widget render", 600, function() return false end)
+end)
+mod:AddCallback(M.MC_POST_RENDER, function()
+  if not base.pause_render or count("MC_PRE_COMPLETION_MARKS_RENDER") == 0 or count("MC_POST_COMPLETION_MARKS_RENDER") == 0 then return end
+  base.pause_render, base.pause = false, false
+  local r = last("MC_PRE_COMPLETION_MARKS_RENDER")
+  check(r.n == 4, "PRE completion marks render: four arguments (" .. r.text .. ")")
+  check(type(r[1]) == "userdata" and r.text:find("completion_widget", 1, true) ~= nil, "PRE completion marks: the widget's Sprite is completion_widget.anm2 (offset +4)")
+  check(r[4] == pl():GetPlayerType(), "PRE completion marks: the character id is the player's (" .. tostring(r[4]) .. ")")
+  check(r[2].X < 0, "PRE completion marks: the pause screen's position (" .. tostring(r[2].X) .. ")")
+  check(count("MC_POST_COMPLETION_MARKS_RENDER") > 0, "POST completion marks render fired")
+  B.log(string.format("lab_cb_d: DONE %d PASS %d FAIL", pass, fail))
+end)
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if not base.pause or action ~= ButtonAction.ACTION_PAUSE then return end
+  if hook == InputHook.IS_ACTION_TRIGGERED or hook == InputHook.IS_ACTION_PRESSED then return true end
+end)
+
+local frame, i = 0, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "render frames" then check(false, "timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
diff --git a/scripts/recomp/rgon/lab_cb_e.lua b/scripts/recomp/rgon/lab_cb_e.lua
