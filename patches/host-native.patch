+  say("room item pool without an override: " .. tostring(base_pool) .. ", raw " .. tostring(r:GetItemPool(1234, true)))
+  check(type(base_pool) == "number", "Room:GetItemPool runs the game's function: " .. tostring(base_pool))
+  check(r:GetItemPool(1234, true) == -1, "raw: -1 (POOL_NULL) while none is set: " .. tostring(r:GetItemPool(1234, true)))
+  local want = (base_pool == 3) and 4 or 3
