+-- MC_PRE_BOSS_SELECT (1280): (bossId, pool, levelType, levelVariant), param = the boss id the game picked -> an
+--   integer boss id to use instead (a negative one, the double-trouble marker, is ignored as in REPENTOGON).
+--   BossPool::GetBossId 0x00422830 (slot 174), ecx = the boss pool, (levelType, levelVariant, rng*), ret 0xc,
+--   the id in EAX. The game stages what it picked in the pool's vector<bool> _levelBlacklist (+0x8bc: begin, end,
+--   cap, bit count). A replaced pick undoes that: the blacklist words are put back as they were before the call
+--   and the new boss's bit is set (what REPENTOGON's hook does through its own bookkeeping). The `pool` argument
+--   is nil here (the layer has no BossPool_Pool class); StageAPI and the other users ignore it.
+if M.MC_PRE_BOSS_SELECT then
+  local id = M.MC_PRE_BOSS_SELECT
+  on("BossPool::GetBossId", { id }, function(self, esp)
+    local b, e = r32(self + 0x8bc), r32(self + 0x8c0)
+    local words = {}
+    for a = b, e - 4, 4 do words[#words + 1] = r32(a) end
+    return { ri32(esp + 4), ri32(esp + 8), b, words, r32(self + 0x8c8) }
+  end, function(self, esp, eax, k)
+    if not k then return end
+    local boss = signed(eax)
+    local res = run(id, boss, boss, nil, k[1], k[2])
+    if mathtype(res) ~= "integer" or res < 0 or res >= k[5] then return end
+    local b = r32(self + 0x8bc)
+    if b ~= k[3] then return end
+    for i, w in ipairs(k[4]) do w32(b + (i - 1) * 4, w) end
+    local a = b + (res >> 5) * 4
+    w32(a, r32(a) | (1 << (res & 31)))
+    return res & 0xffffffff
+  end)
+end
