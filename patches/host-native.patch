index 0000000..b393f5f
--- /dev/null
+++ b/scripts/recomp/rgon/lab_cb_b.lua
@@ -0,0 +1,350 @@
+-- lab_cb_b.lua (development only; ISAAC_RGON_LAB=lab_cb_b.lua, worker cb-b)
+-- Fires the callbacks of the "shop / pickups / pools" group and checks their arguments and what an answer does:
+-- MC_POST_PICKUP_SHOP_PURCHASE, MC_PRE_PICKUP_VOIDED (Void and Black Rune), MC_PRE_PICKUP_COMPOSTED,
+-- MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS, MC_PRE_DEVIL_APPLY_ITEMS / _SPECIAL_ITEMS, MC_POST_DEVIL_CALCULATE,
+-- MC_PRE_PLANETARIUM_APPLY_ITEMS / _TELESCOPE_LENS, MC_POST_PLANETARIUM_CALCULATE.
+-- Prints "lab_cb_b: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE; a step that waits has a frame limit.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-b", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_b: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_b: %s %s", ok and "PASS" or "FAIL", what))
+end
+local function near(a, b, eps) return type(a) == "number" and type(b) == "number" and math.abs(a - b) <= (eps or 0.002) end
+
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function reset(n) rec[n] = {} end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function() return v:ToPlayer() and "player" or (v:ToPickup() and ("pickup:" .. v.Variant .. "/" .. v.SubType)) or "entity" end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = {
+  "MC_POST_PICKUP_SHOP_PURCHASE", "MC_PRE_PICKUP_VOIDED", "MC_PRE_PICKUP_COMPOSTED", "MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS",
+  "MC_PRE_DEVIL_APPLY_ITEMS", "MC_PRE_DEVIL_APPLY_SPECIAL_ITEMS", "MC_POST_DEVIL_CALCULATE",
+  "MC_PRE_PLANETARIUM_APPLY_ITEMS", "MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS", "MC_POST_PLANETARIUM_CALCULATE",
+}
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 4 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+
+local game = Game()
+local GAME_PTR = 0x00c71678
+local function devil() local _, st0 = B.call(0x007f92b0, B.ptr(game:GetRoom())) return st0 end
+local function planet() local _, st0 = B.call(0x0074dbd0, B.r32(GAME_PTR)) return st0 end
+local function pl() return Isaac.GetPlayer(0) end
+local function pickups(variant)
+  local out = {}
+  for _, e in ipairs(Isaac.FindByType(5, variant or -1, -1)) do out[#out + 1] = e end
+  return out
+end
+local function clear_pickups()
+  for _, e in ipairs(Isaac.FindByType(5, -1, -1)) do e:Remove() end
+end
+
+local base = {}
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond)
+  waiting, wait_left, wait_what, wait_cond = true, frames, what, cond
+end
+local USE = UseFlag.USE_NOANIM | UseFlag.USE_NOANNOUNCER | UseFlag.USE_OWNED
+
+-- 1. devil chance
+step(function()
+  for _, n in ipairs(NAMES) do reset(n) end
+  base.devil = devil()
+  say("devil chance without answers: " .. tostring(base.devil) .. " game+9 (deal disabled) = " .. B.r8(B.r32(GAME_PTR) + 9))
+  check(type(base.devil) == "number", "GetDevilRoomChance answers a number")
+  check(count("MC_PRE_DEVIL_APPLY_ITEMS") >= 1 and count("MC_PRE_DEVIL_APPLY_SPECIAL_ITEMS") >= 1 and count("MC_POST_DEVIL_CALCULATE") >= 1,
+        "the three devil callbacks fired for a call")
+  local a, s, p = last("MC_PRE_DEVIL_APPLY_ITEMS"), last("MC_PRE_DEVIL_APPLY_SPECIAL_ITEMS"), last("MC_POST_DEVIL_CALCULATE")
+  check(a and near(a[1], 0.01, 0.0005), "MC_PRE_DEVIL_APPLY_ITEMS gets the starting 0.01 chance: " .. tostring(a and a[1]))
+  check(s and p and near(s[1], p[1], 0.0005) and near(p[1], base.devil, 0.0005),
+        "special items and post calculate get the chance (no Goat Head/Eucharist here); post = the answer: " .. tostring(s and s[1]) .. " " .. tostring(p and p[1]) .. " " .. tostring(base.devil))
+  beh.MC_PRE_DEVIL_APPLY_ITEMS = function(c) return c + 0.1 end
+end)
+step(function()
+  local v = devil()
+  check(near(v, base.devil + 0.1, 0.003), "PRE_DEVIL_APPLY_ITEMS +0.1 raised the chance: " .. tostring(v) .. " vs " .. tostring(base.devil + 0.1))
+  beh.MC_PRE_DEVIL_APPLY_ITEMS = nil
+  beh.MC_PRE_DEVIL_APPLY_SPECIAL_ITEMS = function(c) return c + 0.2 end
+end)
+step(function()
+  local v = devil()
+  check(near(v, base.devil + 0.2, 0.003), "PRE_DEVIL_APPLY_SPECIAL_ITEMS +0.2 raised the chance: " .. tostring(v))
+  beh.MC_PRE_DEVIL_APPLY_SPECIAL_ITEMS = nil
+  beh.MC_POST_DEVIL_CALCULATE = function(c) return 0.5 end
+end)
+step(function()
+  local v = devil()
+  check(near(v, 0.5, 0.002), "POST_DEVIL_CALCULATE 0.5 became the chance: " .. tostring(v))
+  beh.MC_POST_DEVIL_CALCULATE = function(c) return 0 end
+end)
+step(function()
+  local v = devil()
+  check(near(v, 0, 0.0005), "POST_DEVIL_CALCULATE 0 is not raised again: " .. tostring(v))
+  beh.MC_POST_DEVIL_CALCULATE = nil
+end)
+
+-- 2. planetarium chance
+step(function()
+  for _, n in ipairs(NAMES) do reset(n) end
+  base.plan = planet()
+  say("planetarium chance without answers: " .. tostring(base.plan))
+  check(count("MC_PRE_PLANETARIUM_APPLY_ITEMS") >= 1 and count("MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS") >= 1 and count("MC_POST_PLANETARIUM_CALCULATE") >= 1,
+        "the three planetarium callbacks fired")
+  local p = last("MC_POST_PLANETARIUM_CALCULATE")
+  check(p and near(p[1], base.plan, 0.0005), "POST_PLANETARIUM_CALCULATE gets the final chance: " .. tostring(p and p[1]) .. " " .. tostring(base.plan))
+  beh.MC_PRE_PLANETARIUM_APPLY_ITEMS = function(c) return c + 0.3 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, base.plan + 0.3, 0.003), "PRE_PLANETARIUM_APPLY_ITEMS +0.3: " .. tostring(v))
+  beh.MC_PRE_PLANETARIUM_APPLY_ITEMS = nil
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = function(c) return c + 0.2 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, base.plan + 0.2, 0.003), "PRE_PLANETARIUM_APPLY_TELESCOPE_LENS +0.2: " .. tostring(v))
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = nil
+  beh.MC_POST_PLANETARIUM_CALCULATE = function(c) return 0.6 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, 0.6, 0.002), "POST_PLANETARIUM_CALCULATE 0.6: " .. tostring(v))
+  beh.MC_POST_PLANETARIUM_CALCULATE = function(c) return 0 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, 0, 0.0005), "POST_PLANETARIUM_CALCULATE 0 is kept (REPENTOGON has no lower clamp): " .. tostring(v))
+  beh.MC_POST_PLANETARIUM_CALCULATE = nil
+  -- the already-visited path (game+0x2655c, planetariums visited), restored after
+  base.visited = B.r32(B.r32(GAME_PTR) + 0x2655c)
+  B.w32(B.r32(GAME_PTR) + 0x2655c, 1)
+  reset("MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS")
+  reset("MC_PRE_PLANETARIUM_APPLY_ITEMS")
+  base.plan_visited = planet()
+  check(count("MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS") >= 1, "visited path: the lens callback still fires")
+  check(count("MC_PRE_PLANETARIUM_APPLY_ITEMS") == 0, "visited path: the apply-items callback does not (inside the not-visited branch)")
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = function(c) return c + 0.25 end
+end)
+step(function()
+  local v = planet()
+  check(near(v, base.plan_visited + 0.25, 0.003), "visited path: lens answer +0.25 applies: " .. tostring(v) .. " vs " .. tostring(base.plan_visited))
+  beh.MC_PRE_PLANETARIUM_APPLY_TELESCOPE_LENS = nil
+  B.w32(B.r32(GAME_PTR) + 0x2655c, base.visited)
+  pl():AddTrinket(TrinketType.TRINKET_TELESCOPE_LENS)
