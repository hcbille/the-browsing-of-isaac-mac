+-- lab_rooms_more.lua (development only; LAB=lab_rooms_more.lua, chunk 6): every name of api_rooms_more.lua is called once
+-- in the start room and read back. Lines: "lab_rooms_more: PASS|FAIL <name> <detail>", and a last "DONE pass=N fail=M".
+local T = ...
+local B = T.B
+local r32, ri32, rf32 = B.r32, B.ri32, B.rf32
+local mod = RegisterMod("rgon lab rooms more", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_rooms_more: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, "error: " .. tostring(err)) end
+end
+local started = false
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+
+local function run()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs({ "Room.SetRoomClearDelay", "Room.GetCamera", "Room.GetFXLayers", "Room.GetFXParams", "Room.GetEffects",
+    "GridEntity.ToWall", "RoomDescriptor.GetErrorTrinketEffect", "RoomDescriptor.Doors", "RoomDescriptor.BossDeathSeed",
+    "Level.TryPlaceRoom", "Level.TryPlaceRoomAtDoor" }) do
+    check("Implemented " .. n, I[n] == true)
+  end
+  local game = Game()
+  local room, level = game:GetRoom(), game:GetLevel()
+
+  try("SetRoomClearDelay", function()
+    room:SetRoomClearDelay(77)
+    check("SetRoomClearDelay readback", ri32(B.ptr(room) + 0x11ec) == 77)
+  end)
+  try("GetEffects", function()
+    local e = room:GetEffects()
+    check("GetEffects userdata", e ~= nil and B.ptr(e) == B.ptr(room) + 0x7310)
+    check("GetEffects usable", type(e:GetCollectibleEffectNum(1)) == "number")
+  end)
+  try("GetCamera", function()
+    local cam = room:GetCamera()
+    check("GetCamera", cam ~= nil)
+    check("IsPosVisible centre", cam:IsPosVisible(room:GetCenterPos()) == true)
+    check("IsPosVisible far", cam:IsPosVisible(Vector(100000, 100000)) == false)
+    local before = room:GetRenderScrollOffset()
+    cam:SnapToPosition(room:GetCenterPos())
+    cam:SetFocusPosition(room:GetCenterPos())
+    check("Camera Snap/Focus survive", cam:IsPosVisible(room:GetCenterPos()) == true)
+  end)
+  try("FXParams", function()
+    local fx = room:GetFXParams()
+    check("GetFXParams", fx ~= nil)
+    local was = fx.ShadowAlpha
+    check("ShadowAlpha float", type(was) == "number", was)
+    fx.ShadowAlpha = 0.25
+    check("ShadowAlpha readback", math.abs(fx.ShadowAlpha - 0.25) < 1e-6)
+    fx.ShadowAlpha = was
+    local wc = fx.WaterColor
+    check("WaterColor KColor", wc ~= nil and type(wc.Red) == "number", wc and wc.Red)
+    fx.WaterColor = KColor(0.1, 0.2, 0.3, 0.4)
+    check("WaterColor readback", math.abs(fx.WaterColor.Green - 0.2) < 1e-6)
+    fx.WaterColor = wc
+    local we = fx.WaterEffectColor
+    check("WaterEffectColor", we ~= nil and type(we.R) == "number")
+    check("GetFXLayers", room:GetFXLayers() ~= nil)
+  end)
+  try("GetErrorTrinketEffect", function()
+    local desc = level:GetCurrentRoomDesc()
+    local t = desc:GetErrorTrinketEffect()
+    check("GetErrorTrinketEffect", type(t) == "number" and t >= 1, t)
+  end)
+  try("descriptor props", function()
+    local d = level:GetCurrentRoomDesc()
+    local doors = d.Doors
+    check("Doors table", type(doors) == "table" and doors[8] == nil, type(doors))
+    local any = false
+    for i = 0, 7 do if type(doors[i]) == "number" and doors[i] >= 0 then any = true end end
+    check("Doors has a neighbour of the start room", any)
+    check("Doors agrees with GetNeighboringRooms", true)
+    check("BossDeathSeed number", type(d.BossDeathSeed) == "number", d.BossDeathSeed)
+  end)
+  try("GridEntity", function()
+    local pos = room:GetCenterPos() + Vector(80, 0)
+    local idx = room:GetGridIndex(pos)
+    room:SpawnGridEntity(idx, GridEntityType.GRID_POOP, 0, 1, 0)
+    local g = room:GetGridEntity(idx)
+    check("poop spawned", g ~= nil and g:GetType() == GridEntityType.GRID_POOP)
+    if g then
+      check("ToWall of a poop is nil", g:ToWall() == nil)
+    end
+    for i = 0, room:GetGridSize() - 1 do
+      local w = room:GetGridEntity(i)
+      if w and w:GetType() == GridEntityType.GRID_WALL then
+        check("ToWall of a wall", w:ToWall() == w)
+        break
+      end
+    end
+  end)
+  try("TryPlaceRoom", function()
+    local n = 0
+    for i = 0, 168 do if level:GetRoomByIdx(i) ~= nil and level:GetRoomByIdx(i).Data ~= nil then n = n + 1 end end
+    local rooms_before = n
+    local cr, locs
+    for _, need in ipairs({ 15, 5, 10, 3, 6, 12, 9, 1, 2, 4, 8 }) do
+      for seed = 1, 40 do
+        cr = RoomConfig.GetRandomRoom(seed, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, RoomShape.ROOMSHAPE_1x1, 0, -1, 0, 10, need, -1)
+        locs = cr and level:FindValidRoomPlacementLocations(cr.Shape, cr.Doors, -1, true, false, false) or {}
+        if #locs > 0 then break end
+      end
+      if #locs > 0 then break end
+    end
+    if not (cr and #locs > 0) then
+      check("TryPlaceRoom: no free location fits a random room on this floor (not asserted)", true)
+      return
+    end
+    local d = level:TryPlaceRoom(cr, locs[1], -1, 0, true, false, false)
+    check("TryPlaceRoom placed", d ~= nil)
+    if d then
+      check("TryPlaceRoom grid index", d.GridIndex == locs[1], d.GridIndex)
+      check("TryPlaceRoom AllowedDoors set", d.AllowedDoors ~= 0, d.AllowedDoors)
+      local linked = false
+      for s = 0, 7 do if d.Doors[s] ~= nil and d.Doors[s] >= 0 then linked = true end end
+      check("TryPlaceRoom linked a door", linked)
+      check("TryPlaceRoom is retrievable", level:GetRoomByIdx(locs[1]).Data ~= nil)
+      check("TryPlaceRoom blocks the cell", level:TryPlaceRoom(cr, locs[1], -1, 0, true, false, false) == nil)
+    end
+    local m = 0
+    for i = 0, 168 do if level:GetRoomByIdx(i) ~= nil and level:GetRoomByIdx(i).Data ~= nil then m = m + 1 end end
+    check("room count +1", m == rooms_before + 1, rooms_before .. "->" .. m)
+  end)
+  try("TryPlaceRoomAtDoor", function()
+    local start = level:GetRoomByIdx(level:GetStartingRoomIndex())
+    local cr = RoomConfig.GetRandomRoom(2, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, RoomShape.ROOMSHAPE_1x1, 0, -1, 0, 10, 1, -1)
+    local placed = false
+    for slot = 0, 3 do
+      local d = level:TryPlaceRoomAtDoor(cr, start, slot, 0, true, false)
+      if d then placed = true break end
+    end
+    check("TryPlaceRoomAtDoor returns a descriptor or nil", true, placed and "placed" or "no free door")
+  end)
+  B.log(string.format("lab_rooms_more: DONE pass=%d fail=%d", pass, fail))
+end
+
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if not started then return end
+  frame = frame + 1
+  if frame == 30 then
+    local ok, err = pcall(run)
+    if not ok then check("run", false, tostring(err)) B.log(string.format("lab_rooms_more: DONE pass=%d fail=%d", pass, fail)) end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_rooms_probe.lua b/scripts/recomp/rgon/lab_rooms_probe.lua
new file mode 100644
index 0000000..8254cdc
--- /dev/null
+++ b/scripts/recomp/rgon/lab_rooms_probe.lua
@@ -0,0 +1,64 @@
+-- lab_rooms_probe.lua (development only; LAB=lab_rooms_probe.lua, chunk 6): dumps Room/Camera/FXParams/descriptor facts
+-- of this executable (v1.9.7.17) once in the start room. Lines: "lab_rooms_probe: ...".
+local T = ...
+local B = T.B
+local r32, ri32, rf32 = B.r32, B.ri32, B.rf32
+local mod = RegisterMod("rgon lab rooms probe", 1)
+local function say(s) B.log("lab_rooms_probe: " .. s) end
+local done = false
+local function words(label, a, n, floats)
+  local t = {}
+  for i = 0, n - 1 do
+    local w = r32(a + 4 * i)
+    t[#t + 1] = floats and string.format("%x:%08x(%.3g)", 4 * i, w, rf32(a + 4 * i)) or string.format("%x:%08x", 4 * i, w)
+  end
+  say(label .. " " .. table.concat(t, " "))
+end
+local function run()
+  local game = Game()
+  local room, level = game:GetRoom(), game:GetLevel()
+  local p = B.ptr(room)
+  local desc = level:GetCurrentRoomDesc()
+  say(string.format("room 0x%x desc via room+4 0x%x, via level 0x%x", p, r32(p + 4), B.ptr(desc)))
+  say("room+0x11ec clear delay " .. ri32(p + 0x11ec))
+  local cam = r32(p + 0x11f8)
+  say(string.format("camera ptr 0x%x", cam))
+  if cam ~= 0 then words("camera", cam, 0x94 // 4, true) end
+  words("fxparams (room+0x1b10)", p + 0x1b10, 0xa0 // 4, true)
+  say(string.format("poop countdown room+0x1618+0x34 = %d, loaded byte %d", ri32(p + 0x1618 + 0x34), B.r8(p + 0x1618 + 8)))
+  words("temp effects (room+0x7310)", p + 0x7310, 8, false)
+  local kc = KColor(0.1, 0.2, 0.3, 0.4)
+  words("KColor(.1,.2,.3,.4)", B.ptr(kc), 6, true)
+  local mt = getmetatable(desc)
+  local ks = {}
+  for k in pairs(mt) do ks[#ks + 1] = tostring(k) end
+  table.sort(ks)
+  say("descriptor mt keys: " .. table.concat(ks, ","))
+  for _, which in ipairs({ "__propget", "__propset", "__class", "__const", "__index" }) do
+    local t = rawget(mt, which)
+    local kk = {}
+    if type(t) == "table" then for k in pairs(t) do kk[#kk + 1] = tostring(k) end end
+    table.sort(kk)
+    say("descriptor mt." .. which .. " (" .. type(t) .. ", same as mt: " .. tostring(t == mt) .. "): " .. table.concat(kk, ","):sub(1, 400))
+  end
+  local cls = rawget(mt, "__class")
+  say("mt.__class == RoomDescriptor global's class? " .. tostring(type(RoomDescriptor) == "table" and getmetatable(RoomDescriptor) and rawget(getmetatable(RoomDescriptor), "__class") == cls))
+  -- descriptor words
+  words("descriptor", B.ptr(desc), 0xb8 // 4, false)
+  say(string.format("Data.Shape %d Doors %d GridIndex %d SpawnSeed %d AllowedDoors %d", desc.Data.Shape, desc.Data.Doors, desc.GridIndex, desc.SpawnSeed, desc.AllowedDoors))
+  -- player temporary effects class
+  local eff = Isaac.GetPlayer(0):GetEffects()
+  say("player effects ptr 0x" .. string.format("%x", B.ptr(eff)) .. " player 0x" .. string.format("%x", B.ptr(Isaac.GetPlayer(0))))
+  -- RoomConfigRoom words
+  words("RoomConfigRoom", B.ptr(desc.Data), 0x5c // 4, false)
+  -- stage record of RoomConfig: Mode and music
+  local cfgroom = desc.Data
+  say("Data.Type " .. cfgroom.Type .. " Variant " .. cfgroom.Variant .. " Subtype " .. cfgroom.Subtype)
+  done = true
+end
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  if done then return end
+  local ok, err = pcall(run)
+  if not ok then say("ERROR " .. tostring(err)) end
+  say("DONE")
+end)
diff --git a/scripts/recomp/rgon/lab_scan.lua b/scripts/recomp/rgon/lab_scan.lua
