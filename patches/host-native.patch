+-- api_engine_names.lua -- wave 7, worker engine-names: GridEntity:Get/Set/ResetWaterClipFlags and Camera:IsClampEnabled /
+-- SetClampEnabled. Written against REPENTOGON's behaviour (GridEntityPlus.cpp, LuaGridEntity.cpp, ASMCamera.cpp, LuaCamera.cpp);
+-- every address measured in THIS executable (v1.9.7.17) and checked by lab_engine_names.lua. Needs an engine with hook slots 300-308
+-- (B.ENGNAMES); an older binary leaves the names unregistered.
+--
+--   GridEntity water clip flags   every grid class overrides the virtual GetWaterClipInfo (vtable slot 6: Free, PostInit, Update,
+--       Render, Hurt, Destroy, GetWaterClipInfo). The 18 grid vtables hold seven distinct functions (hook_table.py, slots 300-306): the
+--       base's, Pit's (also Web, Stairs, TrapDoor, Teleporter, Decoration), Door's, Poop's, PressurePlate's, Rock's and Lock's. Each is
+--       thiscall(WaterClipInfo* out) `ret 4` and stores { flags, 0.0f }. SetWaterClipFlags keeps an override per grid entity here and
+--       the slot's after-handler rewrites out.flags, so the room's render pass (0x00810ace: flag 2 skips drawing above water;
+--       0x008212d0: flag 8 skips drawing below water) sees it. An override belongs to one grid entity object: it is dropped when
+--       the entity at that address has another grid index or spawn frame. GetWaterClipFlags answers what the game answers.
+--   Camera clamp   Camera::ClampedToRoom 0x00943490 (thiscall(out, x, y), `ret 0xc`) tests `al & 1` (a room flag meaning "no clamp") at
+--       0x0094355b; hook 307 sets that bit while clamping is off, and hook 308 (0x0094433b, after the smooth camera's clamp
+--       0x00943610) points eax at the camera's own position so the clamped answer is not copied over the raw one. One flag for the
+--       one room camera, as REPENTOGON keeps; it returns to true in a new room (the room's frame counter restarts).
+local T = ...
+local B, R, method, this = T.B, T.R, T.method, T.this
+if not B.ENGNAMES then return end
+local ptr, r32, w32, call, log, reg = B.ptr, B.r32, B.w32, B.call, B.log, B.reg
+local type, error, ipairs = type, error, ipairs
+local mathtype = math.type
+
+local function argerr(n, fname, want, got)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. type(got) .. ")", 3)
+end
+
+------------------------------------------------------------------------------
+-- GridEntity:GetWaterClipFlags() / SetWaterClipFlags(flags) / ResetWaterClipFlags()
+------------------------------------------------------------------------------
+local G_INDEX, G_SPAWN = 0x24, 0x28          -- grid index and spawn frame (REPENTOGON's struct; read back by the lab)
+local FIRST_SLOT, LAST_SLOT = 300, 306
+local over, count, armed = {}, 0, false      -- grid entity address -> { flags, index, spawn frame }
+local function arm(on)
+  if on == armed then return end
+  armed = on
+  for slot = FIRST_SLOT, LAST_SLOT do
+    if on then
+      B.hook(slot, function(self, esp) return r32(esp + 4) end, function(self, esp, eax, out)
+        local o = over[self]
+        if not o or not out then return end
+        if r32(self + G_INDEX) == o[2] and r32(self + G_SPAWN) == o[3] then w32(out, o[1])
+        else over[self] = nil count = count - 1 end
+      end)
+    else
+      B.hook(slot)
+    end
+  end
+end
+
+method("GridEntity", "GetWaterClipFlags", function(self)
+  local p = this(self, "GetWaterClipFlags")
+  local out = B.alloc(8)
+  call(r32(r32(p) + 6 * 4), { ecx = p }, out)
+  local v = r32(out)
+  B.free(out)
+  return v
+end)
+method("GridEntity", "SetWaterClipFlags", function(self, flags)
+  local p = this(self, "SetWaterClipFlags")
+  if mathtype(flags) ~= "integer" then
+    if type(flags) == "number" and flags == math.floor(flags) then flags = math.tointeger(flags) else argerr(2, "SetWaterClipFlags", "number", flags) end
+  end
+  if not over[p] then count = count + 1 end
+  over[p] = { flags & 0xffffffff, r32(p + G_INDEX), r32(p + G_SPAWN) }
+  arm(true)
+end)
+method("GridEntity", "ResetWaterClipFlags", function(self)
+  local p = this(self, "ResetWaterClipFlags")
+  if over[p] then over[p] = nil count = count - 1 end
+  if count <= 0 then count = 0 arm(false) end
+end)
+
+------------------------------------------------------------------------------
+-- Camera:IsClampEnabled() / SetClampEnabled(bool)
+------------------------------------------------------------------------------
+local CLAMP_FLAG, SLOW_STOP = 307, 308
+local clamped, set_frame = true, 0
+local function room_frame()
+  local ok, f = pcall(function() return Game():GetRoom():GetFrameCount() end)
+  return ok and f or 0
+end
+local function still_off()
+  if room_frame() < set_frame then clamped = true return false end   -- a new room: the frame counter restarted
+  return true
+end
+local function clamp_arm(on)
+  if on then
+    B.hook(CLAMP_FLAG, function(va, esp, ebp)
+      if va == 0x0094355b and not clamped and still_off() then reg("eax", reg("eax") | 1) end
+    end)
+    B.hook(SLOW_STOP, function(va, esp, ebp)
+      if va == 0x0094433b and not clamped and still_off() then reg("eax", reg("esi") + 0x6c) end
+    end)
+  else
+    B.hook(CLAMP_FLAG)
+    B.hook(SLOW_STOP)
+  end
+end
+local CAM = T.camera_methods
+if CAM then
+  CAM.IsClampEnabled = function(self)
+    if type(self) ~= "userdata" then error("rgon: Camera:IsClampEnabled called without its object (use ':')", 2) end
+    if not clamped then still_off() end
+    return clamped
+  end
+  CAM.SetClampEnabled = function(self, on)
+    if type(self) ~= "userdata" then error("rgon: Camera:SetClampEnabled called without its object (use ':')", 2) end
+    if type(on) ~= "boolean" then argerr(2, "SetClampEnabled", "boolean", on) end
+    clamped = on
+    set_frame = room_frame()
+    clamp_arm(not on)
+  end
+  R.Implemented["Camera.IsClampEnabled"] = true
+  R.Implemented["Camera.SetClampEnabled"] = true
+end
diff --git a/scripts/recomp/rgon/api_entity_more.lua b/scripts/recomp/rgon/api_entity_more.lua
new file mode 100644
index 0000000..6ad7a0f
--- /dev/null
+++ b/scripts/recomp/rgon/api_entity_more.lua
@@ -0,0 +1,239 @@
+-- api_entity_more.lua -- EntityFamiliar:GetMultiplier, the pathfinder getters, Entity:Get/SetColorParams (class ColorParams)
+-- and Entity:Get/Set/ResetWaterClipFlags, written against REPENTOGON's behaviour (LuaEntityFamiliar.cpp, LuaEntityNPC.cpp,
+-- LuaEntity.cpp, LuaColorParams.cpp); every offset measured in THIS executable (v1.9.7.17) by lab_entity_probe.lua and
+-- checked by lab_entity_more_test.lua.
+--
+--   EntityFamiliar:GetMultiplier   the game's own Entity_Familiar::GetMultiplier, 0x0060dc40 (thiscall, plain `ret`, the
+--       float comes back in XMM0, which call() answers as its fourth value since round 124). It reads the familiar's owner
+--       (+0x410) and its item config (+0x330): BFFS! (247) doubles it. Without an owner it answers 1, as REPENTOGON does
+--       when it has nothing cached.
+--   Entity:Get/Set/ResetWaterClipFlags   the game's Entity::GetWaterClipInfo is 0x006b6ed0 (thiscall(out), `ret 4`,
+--       out = { uint32 flags, float }; not virtual, four direct callers: the room's entity render pass and 0x006b0aaa).
+--       SetWaterClipFlags keeps an override per entity here and hook slot 179 (host_rgon.c WATERCLIP) rewrites out.flags
+--       after the game's own answer, so the render pass sees it, as REPENTOGON's hook does. Get answers what the game
+--       answers (the override included).
+--   Entity:Get/SetColorParams   the colour-params vector at +0x1ac (see api_familiar.lua): 0x3c-byte entries, priority,
+--       colour (tint, colorize, offset as Color stores them), duration (+0x30), lifespan (+0x34), fadeout (+0x38), shared (+0x39).
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, call, log = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call, B.log
+local type, error, select, setmetatable, getmetatable, rawget, rawset, tostring, ipairs = type, error, select, setmetatable, getmetatable, rawget, rawset, tostring, ipairs
+local mathtype = math.type
+
+local function argerr(n, fname, want, got)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. type(got) .. ")", 3)
+end
+
+------------------------------------------------------------------------------
+-- EntityFamiliar:GetMultiplier() -> number
+------------------------------------------------------------------------------
+if B.XMM0RET then
+  method("EntityFamiliar", "GetMultiplier", function(self)
+    local p = this(self, "GetMultiplier")
+    if r32(p + 0x410) == 0 or r32(p + 0x330) == 0 then return 1.0 end
+    local _, _, _, x = call(0x0060dc40, p)
+    return x
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityNPC:GetPathfinder(), EntityFamiliar:GetPathfinder() / GetPathFinder() -> PathFinder
+------------------------------------------------------------------------------
+-- The pathfinder is embedded in the entity: NPC +0x414, familiar +0x5fc (lab_entity_probe: the one word-aligned slot whose
+-- first word is the entity itself, for a gaper, a fly, a spider, Brother Bobby and Little Steven; REPENTOGON's offsets
+-- for v1.9.7.12 hold unchanged). The class is the game's own PathFinder, taken off the userdata the game hands out for
+-- `npc.Pathfinder`; the object is the embedded struct's address, as REPENTOGON pushes it.
+do
+  local PF_MT
+  local function pf_class()
+    if PF_MT then return PF_MT end
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      local n = e:ToNPC()
+      if n then
+        local ok, pf = pcall(function() return n.Pathfinder end)
+        if ok and pf ~= nil then PF_MT = getmetatable(pf) return PF_MT end
+      end
+    end
+  end
+  local function get(off, name)
+    return function(self)
+      local p = this(self, name)
+      local mt = pf_class()
+      if not mt then
+        -- no NPC in the room to take the class from: one is made for a moment, then removed
+        local pl = Isaac.GetPlayer(0)
+        local tmp = Isaac.Spawn(18, 0, 0, pl.Position, Vector(0, 0), nil)
+        local n = tmp:ToNPC()
+        local ok, pf = pcall(function() return n.Pathfinder end)
+        if ok and pf ~= nil then PF_MT = getmetatable(pf) end
+        tmp:Remove()
+        mt = PF_MT
+        if not mt then error("rgon: the game's PathFinder class is not reachable", 2) end
+      end
+      return B.obj(mt, p + off, T.vt_ptr())
+    end
+  end
+  method("EntityNPC", "GetPathfinder", get(0x414, "GetPathfinder"))
+  method("EntityFamiliar", "GetPathfinder", get(0x5fc, "GetPathfinder"))
+  method("EntityFamiliar", "GetPathFinder", get(0x5fc, "GetPathFinder"))
+end
+
+------------------------------------------------------------------------------
+-- Entity:GetWaterClipFlags() / SetWaterClipFlags(flags) / ResetWaterClipFlags()
+------------------------------------------------------------------------------
+if B.WATERCLIP then
+  local SLOT = 179
+  local E_INDEX, E_SEED = 0x20, 0x3ec
+  local over, count, armed = {}, 0, false      -- entity address -> { flags, index, init seed }
+  local function arm(on)
+    if on == armed then return end
+    armed = on
+    if on then
+      B.hook(SLOT, function(self, esp) return r32(esp + 4) end, function(self, esp, eax, out)
+        local o = over[self]
+        if not o or not out then return end
+        if r32(self + E_INDEX) == o[2] and r32(self + E_SEED) == o[3] then w32(out, o[1])
+        else over[self] = nil count = count - 1 end
+      end)
+    else
+      B.hook(SLOT)
+    end
+  end
+  method("Entity", "GetWaterClipFlags", function(self)
+    local p = this(self, "GetWaterClipFlags")
+    local out = B.alloc(8)
+    call(0x006b6ed0, p, out)
+    local v = r32(out)
+    B.free(out)
+    return v
+  end)
+  method("Entity", "SetWaterClipFlags", function(self, flags)
+    local p = this(self, "SetWaterClipFlags")
+    if mathtype(flags) ~= "integer" then
+      if type(flags) == "number" and flags == math.floor(flags) then flags = math.tointeger(flags) else argerr(2, "SetWaterClipFlags", "number", flags) end
+    end
+    if not over[p] then count = count + 1 end
+    over[p] = { flags & 0xffffffff, r32(p + E_INDEX), r32(p + E_SEED) }
+    arm(true)
+  end)
+  method("Entity", "ResetWaterClipFlags", function(self)
+    local p = this(self, "ResetWaterClipFlags")
+    if over[p] then over[p] = nil count = count - 1 end
+    if count <= 0 then count = 0 arm(false) end
+  end)
+end
+
+------------------------------------------------------------------------------
+-- ColorParams, Entity:GetColorParams() -> { ColorParams }, Entity:SetColorParams({ ColorParams })
+------------------------------------------------------------------------------
+-- The objects are copies, as REPENTOGON's are: changing one does nothing until SetColorParams writes the list back.
+-- Eleven floats in memory order (tint R G B A, colorize R G B A, offset R G B).
+do
+  local SZ = 0x3c
+  local CP = {}
+  CP.__index = CP
+  CP.__type = "ColorParams"
+  CP.__name = "ColorParams"
+  CP.__tostring = function(c) return string.format("ColorParams[priority %d, duration %d, lifespan %d]", c._priority, c._d1, c._d2) end
+
+  local function color_floats(c, n, fname)
+    local a = type(c) == "userdata" and ptr(c) or 0
+    if a == 0 then argerr(n, fname, "Color", c) end
+    local f = {}
+    for i = 1, 11 do f[i] = rf32(a + (i - 1) * 4) end
+    return f
+  end
+  local function make_color(f)
+    local c = Color(f[1], f[2], f[3], f[4], f[9], f[10], f[11])
+    c:SetColorize(f[5], f[6], f[7], f[8])
+    return c
+  end
+  local function int(v, n, fname)
+    if mathtype(v) == "integer" then return v end
+    if type(v) == "number" and v == math.floor(v) then return math.tointeger(v) end
+    argerr(n, fname, "number", v)
+  end
+  local function bool(v, n, fname)
+    if type(v) ~= "boolean" then argerr(n, fname, "boolean", v) end
+    return v
+  end
+  local function new(f, priority, d1, d2, fadeout, shared)
+    return setmetatable({ _f = f, _priority = priority, _d1 = d1, _d2 = d2, _fadeout = fadeout, _shared = shared }, CP)
+  end
+  local function check(self, fname)
+    if getmetatable(self) ~= CP then argerr(1, fname, "ColorParams", self) end
+    return self
+  end
+
+  function CP:GetColor() return make_color(check(self, "GetColor")._f) end
+  function CP:SetColor(c) check(self, "SetColor")._f = color_floats(c, 2, "SetColor") end
+  function CP:GetPriority() return check(self, "GetPriority")._priority end
+  function CP:SetPriority(v) check(self, "SetPriority")._priority = int(v, 2, "SetPriority") end
+  function CP:GetDuration() return check(self, "GetDuration")._d1 end
+  function CP:SetDuration(v) check(self, "SetDuration")._d1 = int(v, 2, "SetDuration") end
+  function CP:GetLifespan() return check(self, "GetLifespan")._d2 end
+  function CP:SetLifespan(v) check(self, "SetLifespan")._d2 = int(v, 2, "SetLifespan") end
+  function CP:GetFadeout() return check(self, "GetFadeout")._fadeout end
+  function CP:SetFadeout(v) check(self, "SetFadeout")._fadeout = bool(v, 2, "SetFadeout") end
+  function CP:GetShared() return check(self, "GetShared")._shared end
+  function CP:SetShared(v) check(self, "SetShared")._shared = bool(v, 2, "SetShared") end
+
+  -- ColorParams(color, priority, duration, fadeout, shared): REPENTOGON's code (its docs name a sixth argument): the
+  -- duration is also the lifespan. A sixth argument, as the docs have it, is (color, priority, duration, lifespan, fadeout, shared).
+  if rawget(_G, "ColorParams") == nil then
+    rawset(_G, "ColorParams", setmetatable({}, { __call = function(_, color, priority, duration, a4, a5, a6)
+      local f = color_floats(color, 1, "ColorParams")
+      priority, duration = int(priority, 2, "ColorParams"), int(duration, 3, "ColorParams")
+      if a6 ~= nil then
+        return new(f, priority, duration, int(a4, 4, "ColorParams"), bool(a5, 5, "ColorParams"), bool(a6, 6, "ColorParams"))
+      end
+      return new(f, priority, duration, duration, bool(a4, 4, "ColorParams"), bool(a5, 5, "ColorParams"))
+    end }))
+    R.Implemented["ColorParams"] = true
+    R.Implemented["ColorParams.ColorParams"] = true
+    for _, m in ipairs({ "GetColor", "SetColor", "GetPriority", "SetPriority", "GetDuration", "SetDuration", "GetLifespan",
+      "SetLifespan", "GetFadeout", "SetFadeout", "GetShared", "SetShared" }) do
+      R.Implemented["ColorParams." .. m] = true
+    end
+  end
+
+  method("Entity", "GetColorParams", function(self)
+    local p = this(self, "GetColorParams")
+    local out = {}
+    local first, last = r32(p + 0x1ac), r32(p + 0x1b0)
+    for e = first, last - SZ, SZ do
+      local f = {}
+      for i = 1, 11 do f[i] = rf32(e + 4 + (i - 1) * 4) end
+      out[#out + 1] = new(f, ri32(e), ri32(e + 0x30), ri32(e + 0x34), r8(e + 0x38) ~= 0, r8(e + 0x39) ~= 0)
+    end
+    return out
+  end)
+
+  method("Entity", "SetColorParams", function(self, list)
+    local p = this(self, "SetColorParams")
+    if type(list) ~= "table" then error("bad argument #2 to 'SetColorParams' (Expected a table as second argument)", 2) end
+    local n = #list
+    for i = 1, n do
+      if getmetatable(list[i]) ~= CP then argerr(2, "SetColorParams", "table of ColorParams", list[i]) end
+    end
+    local v = p + 0x1ac
+    local first, cap = r32(v), r32(v + 8)
+    if n * SZ > cap - first then
+      local new_first = B.alloc(n * SZ)
+      if new_first == 0 then error("rgon: out of memory growing a colour list", 2) end
+      if first ~= 0 then B.free(first) end
+      first = new_first
+      w32(v, first)
+      w32(v + 8, first + n * SZ)
+    end
+    for i = 1, n do
+      local c, e = list[i], first + (i - 1) * SZ
+      w32(e, c._priority & 0xffffffff)
+      for k = 1, 11 do wf32(e + 4 + (k - 1) * 4, c._f[k]) end
+      w32(e + 0x30, c._d1 & 0xffffffff)
+      w32(e + 0x34, c._d2 & 0xffffffff)
+      w32(e + 0x38, (c._fadeout and 1 or 0) | ((c._shared and 1 or 0) << 8))
+    end
+    w32(v + 4, first + n * SZ)
+  end)
+end
