@@ -0,0 +1,57 @@
+-- api_minimap.lua -- census batch 3 (M8): the global `Minimap` (REPENTOGON's LuaMinimap.cpp): GetState, SetState,
+-- GetHoldTime, SetHoldTime, GetIconsSprite, GetItemIconsSprite. REPENTOGON makes it a plain table of functions that
+-- all work on the game's one Minimap (`g_Game->GetMinimap()`) and ignore any `self`.
+--
+-- Where the Minimap is, measured in this build (lab_minimap_scan.lua, lab_minimap_state.lua):
+--   the game object (pointer at 0x00c71678, as RoomTransition uses it) + 0x25ecc. REPENTOGON's struct has it at
+--   +0x25444 in v1.9.7.12; here the sprites inside the game object say where it is: the big sprite list of the
+--   game object holds gfx/ui/minimap1.anm2 at +0x25ee4, minimap2.anm2 at +0x26044, mapitemicons.anm2 at +0x261a4,
+--   hudpickups.anm2 at +0x262b8 and gfx/ui/minimap_icons.anm2 at +0x263cc. REPENTOGON's Minimap layout puts exactly
+--   these four at +0x18 / +0x178 (config[0], config[1], each 0x160 bytes), +0x2d8, +0x3ec and +0x500, so the Minimap
+--   starts at 0x25ee4 - 0x18 = 0x25ecc and all four agree.
+--   +0x0 state:     0 NORMAL, 1 EXPANDED (while Tab is held), 2 EXPANDED_OPAQUE (after a tap of Tab); seen in a run.
+--   +0x8 hold time: counts up one per frame while Tab is held (5, 10, ... 30) and is 0 otherwise; seen in a run.
+--   +0x2d8 mapitemicons.anm2 (GetItemIconsSprite), +0x500 minimap_icons.anm2 (GetIconsSprite).
+-- Not here: GetDisplayedSize and Refresh (game functions not found), the shake fields (+0x61c, +0x620: never seen
+-- change), and GetMinimapConfig-style accessors REPENTOGON does not have either.
+
+local T = ...
+local B, R, wrap = T.B, T.R, T.wrap
+local r32, ri32, w32 = B.r32, B.ri32, B.w32
+local type, error, ipairs, rawget, rawset = type, error, ipairs, rawget, rawset
+local mathtype = math.type
+
+if rawget(_G, "Minimap") == nil then
+  local M = {}
+  local GAME_PTR, MINIMAP = 0x00c71678, 0x25ecc
+  local function base(what)
+    local g = r32(GAME_PTR)
+    if g == 0 then error("rgon: " .. what .. " used with no game", 3) end
+    return g + MINIMAP
+  end
+  -- the first argument of a setter. REPENTOGON reads argument 1, so `Minimap.SetState(1)` is the call; a mod that
+  -- writes `Minimap:SetState(1)` would hand REPENTOGON the table (an error there). The layer reads the next argument then.
+  local function int_arg(a, b, what)
+    local v = a
+    if v == M then v = b end
+    if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+    if mathtype(v) ~= "integer" then error("bad argument #1 to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+    return v & 0xffffffff
+  end
+  local function sprite_at(a, what)
+    -- a sprite points at itself at +0x30 and +0x50 (api_game.lua's inner_sprite check)
+    if r32(a + 0x30) ~= a or r32(a + 0x50) ~= a then error("rgon: no sprite where " .. what .. " expects one", 3) end
+    return wrap("Sprite", a)
+  end
+
+  function M.GetState() return ri32(base("Minimap.GetState")) end
+  function M.SetState(a, b) w32(base("Minimap.SetState"), int_arg(a, b, "SetState")) end
+  function M.GetHoldTime() return ri32(base("Minimap.GetHoldTime") + 8) end
+  function M.SetHoldTime(a, b) w32(base("Minimap.SetHoldTime") + 8, int_arg(a, b, "SetHoldTime")) end
+  function M.GetIconsSprite() return sprite_at(base("Minimap.GetIconsSprite") + 0x500, "Minimap.GetIconsSprite") end
+  function M.GetItemIconsSprite() return sprite_at(base("Minimap.GetItemIconsSprite") + 0x2d8, "Minimap.GetItemIconsSprite") end
+  rawset(_G, "Minimap", M)
+  for _, n in ipairs({ "GetState", "SetState", "GetHoldTime", "SetHoldTime", "GetIconsSprite", "GetItemIconsSprite" }) do
+    R.Implemented["Minimap." .. n] = true
+  end
+end
