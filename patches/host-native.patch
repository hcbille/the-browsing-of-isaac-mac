@@ -0,0 +1,30 @@
+-- lab_stageapi_boss.lua (development only; ISAAC_RGON_LAB=lab_stageapi_boss.lua, StageAPI batch)
+-- MC_PRE_BOSS_SELECT: the game picks a boss for each floor's boss room at level generation through
+-- BossPool::GetBossId. This lab registers the callback, logs every call, and (ISAAC_LAB_BOSS=<id>) answers with
+-- that boss id for the first call of the run. When the floor exists it logs the boss room's room-config subtype
+-- (the boss id) so the answer can be matched against it.
+-- Log lines: "lab_stageapi_boss: CALL n: bossId=.. pool=.. levelType=.. levelVariant=.. -> answer ..." and
+-- "lab_stageapi_boss: boss room of this floor: subtype ..".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi boss", 1)
+local want = tonumber(B.env("ISAAC_LAB_BOSS") or "")
+local calls = 0
+local function say(s) B.log("lab_stageapi_boss: " .. s) end
+mod:AddCallback(ModCallbacks.MC_PRE_BOSS_SELECT, function(_, bossId, pool, levelType, levelVariant)
+  calls = calls + 1
+  local ans = nil
+  if want and calls == 1 then ans = want end
+  say(string.format("CALL %d: bossId=%s pool=%s levelType=%s levelVariant=%s -> answer %s", calls, tostring(bossId), tostring(pool),
+    tostring(levelType), tostring(levelVariant), tostring(ans)))
+  return ans
+end)
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function()
+  local level = Game():GetLevel()
+  for i = 0, level:GetRoomCount() - 1 do
+    local d = level:GetRooms():Get(i)
+    if d.Data and d.Data.Type == RoomType.ROOM_BOSS then
+      say(string.format("boss room of this floor: stage %d, grid %d, variant %d, subtype %d", level:GetStage(), d.GridIndex, d.Data.Variant, d.Data.Subtype))
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_floors.lua b/scripts/recomp/rgon/lab_stageapi_floors.lua
new file mode 100644
index 0000000..c7564d2
--- /dev/null
+++ b/scripts/recomp/rgon/lab_stageapi_floors.lua
@@ -0,0 +1,134 @@
+-- lab_stageapi_floors.lua (development only; ISAAC_RGON_LAB=lab_stageapi_floors.lua, StageAPI chunk A3b)
+-- Enters Custom Stage API's custom floors one after the other with StageAPI's own API
+-- (StageAPI.GotoCustomStage(StageAPI.CustomStages[name]), what its `cstage <name>` console command does) and logs
+-- StageAPI's own view of each floor plus the room's backdrop state. Needs the mods Custom Stage API (and, for "Lab",
+-- "Stony Level", Fiend Folio) loaded; a name that is not registered is skipped with a log line.
+-- ISAAC_LAB_STAGES = comma list (default "Catacombs,Lab,Stony Level"). ISAAC_LAB_HOLD = updates to stay on each floor
+-- (default 240), so ISAAC_MAC_SHOT frames can be matched to the "lab_stageapi_floors: HOLD" lines.
+-- After each arrival it also runs the exercise() hook below on the new floor (water/rail/save-state calls StageAPI
+-- itself makes), logging PASS/FAIL lines, and ends with a DONE line.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi floors", 1)
+local list = {}
+for name in string.gmatch(B.env("ISAAC_LAB_STAGES") or "Catacombs,Lab,Stony Level", "[^,]+") do list[#list + 1] = name end
+local hold = tonumber(B.env("ISAAC_LAB_HOLD") or "") or 240
+local idx, state, wait, upd = 0, "boot", 0, 0
+local pass, fail = 0, 0
+local function say(s) B.log("lab_stageapi_floors: u" .. upd .. " f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  say((ok and "PASS " or "FAIL ") .. name .. (detail and (" " .. tostring(detail)) or ""))
+end
+
+local function view(tag)
+  local level, room = Game():GetLevel(), Game():GetRoom()
+  local cs = StageAPI and StageAPI.CurrentStage
+  say(string.format("%s: level stage %d type %d name '%s' | StageAPI.CurrentStage=%s InNewStage=%s display='%s' | room type %d backdrop %d water %.2f clear=%s idx %d",
+    tag, level:GetStage(), level:GetStageType(), level:GetName(),
+    tostring(cs and cs.Name), tostring(StageAPI and StageAPI.InNewStage and StageAPI.InNewStage() and true or false),
+    tostring(StageAPI and StageAPI.GetCurrentStageDisplayName and StageAPI.GetCurrentStageDisplayName()),
+    room:GetType(), room:GetBackdropType(), room:GetWaterAmount(), tostring(room:IsClear()), level:GetCurrentRoomIndex()))
+  if StageAPI and StageAPI.GetCurrentRoom then
+    local cr = StageAPI.GetCurrentRoom()
+    say(string.format("%s: StageAPI.GetCurrentRoom()=%s RoomGfx=%s", tag, tostring(cr and (cr.Layout and cr.Layout.Name or "no layout") or nil),
+      tostring(cr and cr.RoomGfx ~= nil)))
+  end
+end
+
+local function exercise(name)
+  local room = Game():GetRoom()
+  -- Room-level names StageAPI calls under `if REPENTOGON` (roomHandler.lua water currents/amount, rails)
+  local ok, err = pcall(function() room:SetWaterCurrent(Vector(-1, 0)) end)
+  check(name .. " Room:SetWaterCurrent", ok, err)
+  if ok then
+    local v = room:GetWaterCurrent()
+    check(name .. " GetWaterCurrent == (-1,0)", math.abs(v.X + 1) < 0.01 and math.abs(v.Y) < 0.01, tostring(v))
+  end
+  ok, err = pcall(function() room:SetWaterAmount(0) end)
+  check(name .. " Room:SetWaterAmount(0)", ok, err)
+  -- RoomDescriptor save-state clearing (extrarooms.lua:628)
+  local desc = Game():GetLevel():GetCurrentRoomDesc()
+  ok, err = pcall(function()
+    desc:GetEntitiesSaveState():Clear()
+    desc:GetGridEntitiesSaveState():Clear()
+    desc:GetDecoSaveState():Clear()
+  end)
+  check(name .. " RoomDescriptor save-state Clear x3", ok, err)
+end
+
+-- music: logged at every room/floor change and every 60 updates (MusicManager answers, Options.MusicVolume, the floor)
+local function music(tag)
+  local mm = MusicManager()
+  local function try(f) local ok, v = pcall(f) return ok and tostring(v) or ("ERR " .. tostring(v)) end
+  say(string.format("MUSIC %s: current=%s queue=%s enabled=%s volume=%s Options.MusicVolume=%s paused=%s | floor '%s' cstage=%s allow=%s",
+    tag, try(function() return mm:GetCurrentMusicID() end), try(function() return mm:GetQueuedMusicID() end),
+    try(function() return mm:IsEnabled() end), try(function() return mm:GetVolume() end),
+    try(function() return Options.MusicVolume end), try(function() return mm:IsPaused() end),
+    Game():GetLevel():GetName(), Game():GetLevel():GetStageType(), tostring(StageAPI and StageAPI.CurrentStage and StageAPI.CurrentStage.Name),
+    try(function() return StageAPI.CurrentStage and StageAPI.CurrentStage:GetPlayingMusic() end),
+    try(function() return mm:IsLayerEnabled() end),
+    tostring(B.env("ISAAC_RGON_ALLOW") ~= nil and B.env("ISAAC_RGON_ALLOW") ~= "")))
+end
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function()
+  if StageAPI then view("NEW LEVEL") end
+  music("NEW LEVEL")
+end)
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  if StageAPI then view("NEW ROOM") end
+  music("NEW ROOM")
+end)
+mod:AddCallback(ModCallbacks.MC_PRE_MUSIC_PLAY, function(_, id, vol)
+  say("MUSIC PRE_MUSIC_PLAY id=" .. tostring(id) .. " vol=" .. tostring(vol))
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  upd = upd + 1
+  if upd % 60 == 0 and upd <= (tonumber(B.env("ISAAC_LAB_MUSIC_UPD") or "") or 700) then music("tick") end
+  local level = Game():GetLevel()
+  if state == "boot" then
+    if StageAPI and StageAPI.CustomStages and level:GetCurrentRoomIndex() == level:GetStartingRoomIndex() then
+      wait = wait + 1
+      if wait == 1 then
+        local names = {}
+        for k in pairs(StageAPI.CustomStages) do names[#names + 1] = k end
+        table.sort(names)
+        say("registered custom stages (" .. #names .. "): " .. table.concat(names, " | "))
+        say("REPENTOGON global is " .. tostring(REPENTOGON ~= nil))
+        view("START")
+      end
+      if wait >= 60 then state, wait = "next", 0 end
+    end
+  elseif state == "next" then
+    idx = idx + 1
+    if idx > #list then
+      say(string.format("DONE %d PASS %d FAIL", pass, fail))
+      state = "end"
+      return
+    end
+    local name = list[idx]
+    local stage = StageAPI.CustomStages[name]
+    if not stage then
+      say("SKIP '" .. name .. "': not registered")
+      return
+    end
+    say("GotoCustomStage('" .. name .. "')")
+    local ok, err = pcall(StageAPI.GotoCustomStage, stage)
+    check("GotoCustomStage " .. name, ok, err)
+    state, wait = "arriving", 0
+  elseif state == "arriving" then
+    wait = wait + 1
+    if StageAPI.CurrentStage and StageAPI.CurrentStage.Name == list[idx] and level:GetCurrentRoomIndex() == level:GetStartingRoomIndex() and wait > 20 then
+      check("arrived on " .. list[idx], true)
+      state, wait = "hold", 0
+    elseif wait > 600 then
+      check("arrived on " .. list[idx], false, "StageAPI.CurrentStage=" .. tostring(StageAPI.CurrentStage and StageAPI.CurrentStage.Name))
+      state, wait = "next", 0
+    end
+  elseif state == "hold" then
+    wait = wait + 1
+    if wait == 30 then view("HOLD") exercise(list[idx]) end
+    if wait == 100 or wait == 200 then say("HOLD " .. wait) end
+    if wait >= hold then state, wait = "next", 0 end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_probe.lua b/scripts/recomp/rgon/lab_stageapi_probe.lua
new file mode 100644
index 0000000..73b6858
--- /dev/null
+++ b/scripts/recomp/rgon/lab_stageapi_probe.lua
@@ -0,0 +1,117 @@
+-- lab_stageapi_probe.lua (development only; ISAAC_RGON_LAB=lab_stageapi_probe.lua, StageAPI batch)
+-- Measures where the Room and RoomDescriptor fields Custom Stage API needs are in THIS build: snapshots Room words
+-- in a plain room (Basement) and after the game changes stage (Flooded Caves has water, Mines has rails), then
+-- logs what differs. "lab_stageapi_probe: ..." lines.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab stageapi probe", 1)
+local function say(s) B.log("lab_stageapi_probe: " .. s) end
+local LO, HI = 0x7000, 0x7900
+local snaps = {}
+local step, wait = 0, 0
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local function room_ptr() return B.ptr(Game():GetRoom()) end
+local function desc_dump(tag)
+  local d = B.ptr(Game():GetLevel():GetCurrentRoomDesc())
+  say(string.format("%s: RoomDescriptor at %08x", tag, d))
+  for o = 0, 0xc0, 4 do
+    if o % 16 == 0 then
+      say(string.format("%s: desc +%02x: %08x %08x %08x %08x", tag, o, r32(d + o), r32(d + o + 4), r32(d + o + 8), r32(d + o + 12)))
+    end
+  end
+  -- the three vectors: begin, end, cap
+  for _, o in ipairs({ 0x68, 0x74, 0x88 }) do
+    say(string.format("%s: vector at desc+%02x: begin %08x end %08x cap %08x", tag, o, r32(d + o), r32(d + o + 4), r32(d + o + 8)))
+  end
+end
+local function room_dump(tag)
+  local a = room_ptr()
+  say(string.format("%s: room at %08x, type %d, backdrop (game) %d, grid %dx%d", tag, a, Game():GetRoom():GetType(), Game():GetRoom():GetBackdropType(), Game():GetRoom():GetGridWidth(), Game():GetRoom():GetGridHeight()))
+  -- words equal to the backdrop id near the Backdrop struct (REPENTOGON +0x1bc8)
+  local bd = Game():GetRoom():GetBackdropType()
+  for o = 0x1b00, 0x1d00, 4 do
+    if ri32(a + o) == bd then say(string.format("%s: backdrop id %d at room+%04x", tag, bd, o)) end
+  end
+  say(string.format("%s: room+1d18 = %d (backdrop %d)", tag, ri32(a + 0x1d18), bd))
+  say(string.format("%s: type of Room.GetRail: %s", tag, type(Room.GetRail)))
+  local hex = {}
+  for o = 0x7460, 0x74f8 do hex[#hex + 1] = string.format("%02x", r8(a + o)) end
+  say(tag .. ": room+7460.. " .. table.concat(hex, " "))
+  return a
+end
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  local lvl = Game():GetLevel()
+  say(string.format("new room idx %d stage %d type %d", lvl:GetCurrentRoomIndex(), lvl:GetStage(), lvl:GetStageType()))
+  if step == 0 then
+    step = 1
+    wait = 0
+    local a = room_dump("A")
+    snaps.A = snap(a)
+    desc_dump("A")
+  elseif step == 2 then
+    step = 3
+    wait = 0
+  elseif step == 4 then
+    step = 5
+    wait = 0
+  end
+end)
+local function diff(name, s1, s2, a)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    if s1[o] ~= s2[o] then
+      n = n + 1
+      if n <= 120 then say(string.format("%s +%04x %08x -> %08x (f %g -> %g)", name, o, s1[o], s2[o], B.i2f(s1[o]), B.i2f(s2[o]))) end
+    end
+  end
+  say(string.format("%s: %d word(s) differ", name, n))
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  wait = wait + 1
+  if step == 1 and wait == 30 then
+    say("going to Flooded Caves")
+    step, wait = 2, 0
+    Isaac.ExecuteCommand("stage 3b")
+  elseif step == 3 and wait == 30 then
+    local a = room_dump("B")
+    snaps.B = snap(a)
+    diff("A->B (basement -> flooded caves)", snaps.A, snaps.B, a)
+    desc_dump("B")
+    -- candidate water amount floats: 1.0 in B, 0 in A
+    for o = LO, HI - 4, 4 do
+      if snaps.A[o] == 0 and snaps.B[o] == 0x3f800000 then say(string.format("water amount candidate +%04x", o)) end
+    end
+    say("going to Mines")
+    step, wait = 4, 0
+    Isaac.ExecuteCommand("stage 3c")
+  elseif step == 5 and wait == 30 then
+    local a = room_dump("C")
+    snaps.C = snap(a)
+    -- rails: byte arrays of 0xff / small values; count bytes != 0 and != 0xff in the region
+    local n = 0
+    for o = LO, HI - 1 do
+      local v = r8(a + o)
+      if v ~= 0 and v ~= 0xff then n = n + 1 end
+    end
+    say("C: bytes neither 0 nor 0xff in the scanned part: " .. n)
+    -- look for a 0xff-filled run of 0x1c0 bytes (the rail grid)
+    local run, start = 0, nil
+    for o = 0x7100, 0x7900 do
+      if r8(a + o) == 0xff then
+        run = run + 1
+        if run == 1 then start = o end
+        if run == 100 then say(string.format("C: 0xff run from room+%04x", start)) end
+      else
+        if run >= 100 then say(string.format("C: 0xff run ended at room+%04x (%d bytes)", o, run)) end
+        run = 0
+      end
+    end
+    step = 6
+    say("done")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_shot.lua b/scripts/recomp/rgon/lab_stageapi_shot.lua
new file mode 100644
index 0000000..c1e5dbf
--- /dev/null
+++ b/scripts/recomp/rgon/lab_stageapi_shot.lua
@@ -0,0 +1,37 @@
+-- lab_stageapi_shot.lua (development only; ISAAC_RGON_LAB=lab_stageapi_shot.lua, StageAPI batch)
+-- Visual proof for Room:SetBackdropType and Room:SetWaterAmount / SetWaterCurrent in a window. In the start room it
+-- changes one thing every 60 updates and logs the update count, so ISAAC_MAC_SHOT=@F:<png> frames (relative to
+-- the script anchor) can be matched to a state:
+--   update  30: baseline            (logs the backdrop id and water amount)
+--   update  90: SetBackdropType(ISAAC_LAB_BACKDROP, 1)   (default 12)
+--   update 150: SetBackdropType(original, 1) and SetWaterAmount(1)
+--   update 210: SetWaterAmount(0) again
+-- Each line reads "lab_stageapi_shot: update N: <state>".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi shot", 1)
+local n = 0
+local orig
+local function say(s) B.log("lab_stageapi_shot: update " .. n .. ": " .. s) end
+local function state(room) return string.format("backdrop %d water %.2f", room:GetBackdropType(), room:GetWaterAmount()) end
+local target = tonumber(B.env("ISAAC_LAB_BACKDROP") or "") or 12
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  n = n + 1
+  local room = Game():GetRoom()
+  if n == 30 then
+    orig = room:GetBackdropType()
+    say("baseline, " .. state(room))
+  elseif n == 90 then
+    room:SetBackdropType(target, 1)
+    say("SetBackdropType(" .. target .. ", 1), " .. state(room))
+  elseif n == 150 then
+    room:SetBackdropType(orig, 1)
+    room:SetWaterAmount(1)
+    say("backdrop restored and SetWaterAmount(1), " .. state(room))
+  elseif n == 210 then
+    room:SetWaterAmount(0)
+    say("SetWaterAmount(0), " .. state(room))
+  elseif n == 60 or n == 120 or n == 180 or n == 240 then
+    say(state(room))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_test.lua b/scripts/recomp/rgon/lab_stageapi_test.lua
new file mode 100644
index 0000000..5ca375e
--- /dev/null
+++ b/scripts/recomp/rgon/lab_stageapi_test.lua
@@ -0,0 +1,212 @@
+-- lab_stageapi_test.lua (development only; ISAAC_RGON_LAB=lab_stageapi_test.lua, StageAPI batch)
+-- Checks the names of api_stageapi.lua in a running game: Room water amount and current, backdrop, rails;
+-- RoomDescriptor Tainted Keeper coin spawns and the three save-state vectors. Prints "lab_stageapi_test: PASS/FAIL ...".
+-- Env: ISAAC_LAB_SHOTS=1 holds each visual state for 90 frames so ISAAC_MAC_SHOT can capture it (water, backdrop).
+local T = ...
+local B = T.B
+local r8, ri32, rf32 = B.r8, B.ri32, B.rf32
+local mod = RegisterMod("rgon lab stageapi test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_stageapi_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+local function near(a, b) return math.abs(a - b) < 1e-4 end
+local shots = B.env("ISAAC_LAB_SHOTS") == "1"
+local step, wait, startIdx = 0, 0, nil
+local frame = 0
+
+local function room_checks()
+  local room = Game():GetRoom()
+  local rp = B.ptr(room)
+  -- implemented names
+  for _, n in ipairs({ "SetBackdropType", "GetWaterAmount", "SetWaterAmount", "GetWaterCurrent", "SetWaterCurrent", "SetRail", "GetRail" }) do
+    check("Room." .. n .. " exists", type(room[n]) == "function")
+  end
+  -- water amount
+  check("water amount starts at 0 in the Basement", near(room:GetWaterAmount(), 0), room:GetWaterAmount())
+  room:SetWaterAmount(0.75)
+  check("SetWaterAmount(0.75) reads back", near(room:GetWaterAmount(), 0.75), room:GetWaterAmount())
+  check("water amount word is the float at room+0x7240", near(rf32(rp + 0x7240), 0.75))
+  room:SetWaterAmount(1)
+  check("SetWaterAmount(1) reads back", near(room:GetWaterAmount(), 1), room:GetWaterAmount())
+  local ok = pcall(room.SetWaterAmount, room, "x")
+  check("SetWaterAmount('x') is an error", not ok)
+  -- water current
+  room:SetWaterCurrent(Vector(-1, 0.5))
+  local c = room:GetWaterCurrent()
+  check("SetWaterCurrent(Vector(-1, 0.5)) reads back", near(c.X, -1) and near(c.Y, 0.5), tostring(c))
+  ok = pcall(room.SetWaterCurrent, room, 5)
+  check("SetWaterCurrent(5) is an error", not ok)
+  -- backdrop
+  local before = room:GetBackdropType()
+  room:SetBackdropType(7, 1)
+  check("SetBackdropType(7, 1) changes GetBackdropType", room:GetBackdropType() == 7, before .. " -> " .. room:GetBackdropType())
+  room:SetBackdropType(before, true)
+  check("SetBackdropType back to the original (boolean flag)", room:GetBackdropType() == before, room:GetBackdropType())
+  ok = pcall(room.SetBackdropType, room, -1, 1)
+  check("SetBackdropType(-1) is an error", not ok)
+  -- rails
+  local w, h = room:GetGridWidth(), room:GetGridHeight()
+  local idx = 4 * w + 6
+  check("GetRail is nil where no rail is", room:GetRail(idx) == nil, tostring(room:GetRail(idx)))
+  room:SetRail(idx, 0)
+  check("SetRail(idx, RAIL_HORIZONTAL) reads back", room:GetRail(idx) == 0, tostring(room:GetRail(idx)))
+  check("the rail byte is at room+0x746c+idx", r8(rp + 0x746c + idx) == 0)
+  room:SetRail(idx + 1, 17)
+  check("SetRail(idx, 17) reads back", room:GetRail(idx + 1) == 17, tostring(room:GetRail(idx + 1)))
+  ok = pcall(room.SetRail, room, idx, 12)
+  check("SetRail with an invalid type is an error", not ok)
+  ok = pcall(room.SetRail, room, w * h, 0)
+  check("SetRail past the grid is an error", not ok)
+  -- undo the rails (the test's own cleanup writes the raw byte; the API cannot set RAIL_NONE)
+  B.w8(rp + 0x746c + idx, 255)
+  B.w8(rp + 0x746c + idx + 1, 255)
+  room:SetWaterAmount(0)
+  room:SetWaterCurrent(Vector(0, 0))
+end
+
+local function desc_checks()
+  local level = Game():GetLevel()
+  local d = level:GetCurrentRoomDesc()
+  for _, n in ipairs({ "GetTaintedKeeperCoinSpawns", "SetTaintedKeeperCoinSpawns", "GetEntitiesSaveState", "GetDecoSaveState", "GetGridEntitiesSaveState" }) do
+    check("RoomDescriptor." .. n .. " exists", type(d[n]) == "function")
+  end
+  local n0 = d:GetTaintedKeeperCoinSpawns()
+  check("coin spawns starts as a small number", n0 >= 0 and n0 <= 10, n0)
+  d:SetTaintedKeeperCoinSpawns(7)
+  check("SetTaintedKeeperCoinSpawns(7) reads back", d:GetTaintedKeeperCoinSpawns() == 7)
+  d:SetTaintedKeeperCoinSpawns(-1)
+  check("SetTaintedKeeperCoinSpawns(-1) reads back -1", d:GetTaintedKeeperCoinSpawns() == -1)
+  d:SetTaintedKeeperCoinSpawns(n0)
+  -- grid vector
+  local g = d:GetGridEntitiesSaveState()
+  check("grid save state has one entry per grid slot", #g == 512 or #g > 100, #g)
+  local e = g:Get(10)
+  local t0 = e.Type
+  e.Type = 1000
+  check("GridEntityDesc.Type round trips through Get(10)", g:Get(10).Type == 1000, tostring(g:Get(10).Type))
+  e.Type = t0
+  -- the fields StageAPI's extra-room code zeroes (extrarooms.lua): Initialized, SpawnCount, State, Variant, VarData
+  local e2 = g:Get(11)
+  local saved = { e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData }
+  e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData = true, 3, 5, 2, 9
+  local r = g:Get(11)
+  check("GridEntityDesc Initialized/SpawnCount/State/Variant/VarData round trip", r.Initialized == true and r.SpawnCount == 3 and r.State == 5 and r.Variant == 2 and r.VarData == 9,
+    tostring(r.Initialized) .. " " .. r.SpawnCount .. " " .. r.State .. " " .. r.Variant .. " " .. r.VarData)
+  e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData = saved[1], saved[2], saved[3], saved[4], saved[5]
+  local found = g:GetByType(t0)
+  check("GetByType finds the entry again", #found >= 1)
+  local okErr = pcall(g.Get, g, #g)
+  check("Get(#g) is an error", not okErr)
+  -- entity vectors
+  local ev = d:GetEntitiesSaveState()
+  local dv = d:GetDecoSaveState()
+  check("entity vectors are readable", #ev >= 0 and #dv >= 0, #ev .. " / " .. #dv)
+  say("entities saved in the start room now: " .. #ev .. ", deco: " .. #dv)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  local level = Game():GetLevel()
+  if step == 2 then
+    step, wait = 3, 0
+  elseif step == 4 then
+    step, wait = 5, 0
+  end
+end)
+
+local pickups = {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  wait = wait + 1
+  local game, level, room = Game(), Game():GetLevel(), Game():GetRoom()
+  if step == 0 and wait == 20 then
+    startIdx = level:GetCurrentRoomIndex()
+    room_checks()
+    desc_checks()
+    -- put two coins and a key on the floor so the descriptor has something to save
+    local c = room:GetCenterPos()
+    pickups = {
+      Isaac.Spawn(5, 20, 1, c + Vector(-60, 0), Vector(0, 0), nil),
+      Isaac.Spawn(5, 20, 2, c + Vector(60, 0), Vector(0, 0), nil),
+      Isaac.Spawn(5, 30, 1, c + Vector(0, 60), Vector(0, 0), nil),
+    }
+    say(string.format("spawned pickups: seeds %d %d %d", pickups[1].InitSeed, pickups[2].InitSeed, pickups[3].InitSeed))
+    step, wait = 1, 0
+  elseif step == 1 and wait == 10 then
+    -- leave to another room so the game saves the start room's entities into its descriptor
+    local target
+    for i = 0, level:GetRoomCount() - 1 do
+      local d = level:GetRooms():Get(i)
+      if d.GridIndex ~= startIdx and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then target = d.GridIndex break end
+    end
+    say("going to room " .. tostring(target) .. " from " .. startIdx)
+    step, wait = 2, 0
+    game:ChangeRoom(target)
+  elseif step == 3 and wait == 15 then
+    local d = level:GetRoomByIdx(startIdx)
+    local ev = d:GetEntitiesSaveState()
+    say("start room's saved entities: " .. #ev)
+    local seen = { coin1 = false, coin2 = false, key = false }
+    for i = 0, #ev - 1 do
+      local s = ev:Get(i)
+      say(string.format("  [%d] type %d variant %d subtype %d initseed %d dropseed %d spawner %d.%d", i, s:GetType(), s:GetVariant(), s:GetSubType(), s:GetInitSeed(), s:GetDropSeed(), s:GetSpawnerType(), s:GetSpawnerVariant()))
+      if s:GetType() == 5 and s:GetVariant() == 20 and s:GetSubType() == 1 and s:GetInitSeed() == pickups[1].InitSeed then seen.coin1 = true end
+      if s:GetType() == 5 and s:GetVariant() == 20 and s:GetSubType() == 2 and s:GetInitSeed() == pickups[2].InitSeed then seen.coin2 = true end
+      if s:GetType() == 5 and s:GetVariant() == 30 and s:GetSubType() == 1 and s:GetInitSeed() == pickups[3].InitSeed then seen.key = true end
+    end
+    check("saved entity matches the spawned penny (type, variant, subtype, init seed)", seen.coin1)
+    check("saved entity matches the spawned nickel", seen.coin2)
+    check("saved entity matches the spawned key", seen.key)
+    check("GetByType(5, 20, 1) finds the penny", #ev:GetByType(5, 20, 1) >= 1)
+    check("GetByType(5, -1, -1) finds the pickups", #ev:GetByType(5, -1, -1) >= 3)
+    ev:Clear()
+    check("Clear empties the entity vector", #ev == 0, #ev)
+    local dv = d:GetDecoSaveState()
+    dv:Clear()
+    check("Clear empties the deco vector", #dv == 0, #dv)
+    local gv = d:GetGridEntitiesSaveState()
+    gv:Clear()
+    local nonzero = 0
+    for i = 0, #gv - 1 do if gv:Get(i).Type ~= 0 then nonzero = nonzero + 1 end end
+    check("Clear zeroes every grid entry's Type", nonzero == 0, nonzero)
+    step, wait = 4, 0
+    game:ChangeRoom(startIdx)
+  elseif step == 5 and wait == 30 then
+    -- the start room loads with its entity list cleared: none of our three pickups come back
+    local n = 0
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      if e.Type == 5 and (e.Variant == 20 or e.Variant == 30) and e.FrameCount > 5 then n = n + 1 end
+    end
+    check("the cleared room comes back without its saved pickups", n == 0, n)
+    -- InitFlipState: a pedestal gets a flip record, and the game's own TryFlip then morphs into it
+    local ped = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, Game():GetRoom():GetCenterPos() + Vector(0, -40), Vector(0, 0), nil):ToPickup()
+    check("EntityPickup.InitFlipState exists", type(ped.InitFlipState) == "function")
+    local pp = B.ptr(ped)
+    check("a fresh pedestal has no flip record", B.r32(pp + 0x5c8) == 0, string.format("%08x", B.r32(pp + 0x5c8)))
+    ped:InitFlipState()
+    local rec = B.r32(pp + 0x5c8)
+    check("InitFlipState puts a record at pickup+0x5c8", rec ~= 0, string.format("%08x", rec))
+    if rec ~= 0 then
+      local other = B.ri32(rec + 8)
+      check("the record holds type 5 variant 100 and another collectible", B.ri32(rec) == 5 and B.ri32(rec + 4) == 100 and other > 0 and other ~= ped.SubType, string.format("subtype %d (pedestal %d)", other, ped.SubType))
+      local before = ped.SubType
+      -- the game's own Entity_Pickup::TryFlip, 0x006e1640 (no argument is read; the zhl declaration's two are unused)
+      local function try_flip() return B.call(0x006e1640, pp, 0, 0) end
+      local ok, flipped = pcall(try_flip)
+      check("TryFlip does not error", ok, tostring(flipped))
+      check("TryFlip morphs the pedestal into the record's collectible", ped.SubType == other, string.format("%d -> %d (record %d)", before, ped.SubType, other))
+      ok, flipped = pcall(try_flip)
+      check("a second TryFlip flips back", ok and ped.SubType == before, string.format("-> %d", ped.SubType))
+    end
+    local ped2 = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, Game():GetRoom():GetCenterPos() + Vector(60, -40), Vector(0, 0), nil):ToPickup()
+    ped2:InitFlipState(CollectibleType.COLLECTIBLE_BREAKFAST)
+    check("InitFlipState(id) uses the given collectible", B.ri32(B.r32(B.ptr(ped2) + 0x5c8) + 8) == CollectibleType.COLLECTIBLE_BREAKFAST)
+    local coin = Isaac.Spawn(5, 20, 1, Game():GetRoom():GetCenterPos() + Vector(0, 80), Vector(0, 0), nil):ToPickup()
+    coin:InitFlipState()
+    check("InitFlipState leaves a coin alone", B.r32(B.ptr(coin) + 0x5c8) == 0)
+    say(string.format("done: %d PASS, %d FAIL", pass, fail))
+    step = 6
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_state_probe.lua b/scripts/recomp/rgon/lab_state_probe.lua
new file mode 100644
index 0000000..3ddf7a9
--- /dev/null
+++ b/scripts/recomp/rgon/lab_state_probe.lua
@@ -0,0 +1,136 @@
+-- lab_state_probe.lua (development only; ISAAC_RGON_LAB=lab_state_probe.lua, census batch B3): finds, by diffs and by the
+-- game's own reaction, where this build keeps the state the batch's getters read. Logs "lab_state_probe: ..".
+--   ISAAC_LAB_MODE=menu : at the main menu, selects the daily run menu and logs what changes in its structure.
+--   (default)           : in a run (script: Escape at +100 and +220 frames after the first room): the pause screen's state,
+--                         the sprites inside the game object (GenericPrompt's first member is one), then Delirium.
+local T = ...
+local B = T.B
+local r32, ri32, r8, log = B.r32, B.ri32, B.r8, B.log
+local mod = RegisterMod("rgon lab state probe", 1)
+local function say(s) log("lab_state_probe: " .. s) end
+local mode = B.env("ISAAC_LAB_MODE") or "run"
+local GAME_PTR, MM_PTR = 0x00c71678, 0x00c72a20
+
+local function snap(a, lo, hi)
+  local t = {}
+  for o = lo, hi - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+
+if mode == "menu" then
+  local f, started, base_off = 0, nil, 0xdd0
+  local lo, hi = 0xd00, 0x1540
+  local prev
+  mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+    f = f + 1
+    local mm = r32(MM_PTR)
+    if mm == 0 then return end
+    if f == 5 then
+      -- every sprite (a self pointer at +0x30 and +0x50) inside the manager between the Menu_Game and the Menu_Character
+      local out = {}
+      for o = 0xb90, 0x1800, 4 do
+        if r32(mm + o + 0x30) == mm + o and r32(mm + o + 0x50) == mm + o then out[#out + 1] = string.format("%x", o) end
+      end
+      say("sprites at manager offsets: " .. table.concat(out, " "))
+      say("selected menu " .. ri32(mm + 0x40))
+      local row = {}
+      for o = 0xdc8, 0xe00, 4 do row[#row + 1] = string.format("%x:%x", o, r32(mm + o)) end
+      say("words 0xdc8..0xe00: " .. table.concat(row, " "))
+      prev = snap(mm, lo, hi)
+    end
+    if f == 20 then
+      say("SetActiveMenu(DAILYRUN)")
+      MenuManager.SetActiveMenu(MainMenuType.DAILYRUN)
+    end
+    if f >= 20 and f % 10 == 0 and f <= 200 then
+      local n = 0
+      for o = lo, hi - 4, 4 do
+        local v = r32(mm + o)
+        if v ~= prev[o] then
+          n = n + 1
+          if n <= 24 then say(string.format("frame %d manager+%x %08x -> %08x (%d -> %d)", f, o, prev[o], v, prev[o] >= 0x80000000 and prev[o] - 2^32 or prev[o], v >= 0x80000000 and v - 2^32 or v)) end
+          prev[o] = v
+        end
+      end
+      say(string.format("frame %d: %d words changed since the last look; selected menu %d; state words +dd0 %d +dd4 %d +dd8 %d", f, n, ri32(mm + 0x40), ri32(mm + 0xdd0), ri32(mm + 0xdd4), ri32(mm + 0xdd8)))
+    end
+  end)
+  return
+end
+
+------------------------------------------------------------------------------ run mode
+local LO, HI = 0x22000, 0x27800
+local fin, paused_for, unpaused_for = 0, 0, 0
+local S0, S1, S2, S3, S4
+local was_paused = false
+local g
+local function hex(v) return string.format("%x", v) end
+local function report()
+  say("candidates (stable idle, changed while paused and stable there, back after unpausing), game+offset: idle -> paused")
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    if S0[o] == S1[o] and S2[o] == S3[o] and S2[o] ~= S0[o] and S4[o] == S0[o] then
+      n = n + 1
+      if n <= 60 then say(string.format("  game+%x %d -> %d", o, S0[o], S2[o])) end
+    end
+  end
+  say("candidates: " .. n)
+  for _, name in ipairs({ "S0", "S1", "S2", "S3", "S4" }) do
+    local S = ({ S0 = S0, S1 = S1, S2 = S2, S3 = S3, S4 = S4 })[name]
+    local row = {}
+    for o = 0x23660, 0x23690, 4 do row[#row + 1] = string.format("%x:%x", o, S[o]) end
+    say(name .. " words 0x23660..0x23690: " .. table.concat(row, " "))
+  end
+  local n2 = 0
+  for o = 0x23600, 0x23700, 4 do
+    if S0[o] ~= S2[o] then say(string.format("  changed idle->paused game+%x %x -> %x", o, S0[o], S2[o])) end
+  end
+  -- sprites in the game object (self pointer at +0x30 and +0x50)
+  local out = {}
+  for o = 0x23000, 0x28000, 4 do
+    if r32(g + o + 0x30) == g + o and r32(g + o + 0x50) == g + o then out[#out + 1] = hex(o) end
+  end
+  for i = 1, #out, 16 do say("sprites at game offsets: " .. table.concat(out, " ", i, math.min(i + 15, #out))) end
+end
+
+local delirium, dframe = nil, 0
+local spawned = false
+local function dump_npc(e, tag)
+  local a = B.ptr(e)
+  local row = {}
+  for o = 0xbc8, 0xbe4, 4 do row[#row + 1] = string.format("%x:%x", o, r32(a + o)) end
+  say(string.format("%s type %d var %d sub %d state %d statef %d: %s", tag, e.Type, e.Variant, e.SubType, e:ToNPC().State, e:ToNPC().StateFrame, table.concat(row, " ")))
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not Isaac.IsInGame() then return end
+  g = r32(GAME_PTR)
+  fin = fin + 1
+  local p = Game():IsPaused()
+  if fin == 1 then say(string.format("game at %x", g)) end
+  if fin == 30 then S0 = snap(g, LO, HI) end
+  if fin == 40 then S1 = snap(g, LO, HI) end
+  if p then paused_for = paused_for + 1 else paused_for = 0 end
+  if p == false and was_paused then unpaused_for = 0 end
+  if not p then unpaused_for = unpaused_for + 1 end
+  if p and paused_for == 1 then say("paused at in-game frame " .. fin) end
+  if p and paused_for == 15 then S2 = snap(g, LO, HI) end
+  if p and paused_for == 25 then S3 = snap(g, LO, HI) say("paused snapshot done") end
+  if S3 and not p and unpaused_for == 15 and not S4 then
+    S4 = snap(g, LO, HI)
+    report()
+  end
+  was_paused = p
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if not S4 then return end
+  if not spawned then
+    spawned = true
+    local d = Isaac.Spawn(412, 0, 0, Vector(320, 260), Vector(0, 0), nil)
+    delirium = d
+    say("spawned Delirium " .. tostring(d))
+  end
+  dframe = dframe + 1
+  if delirium and delirium:Exists() and (dframe <= 2 or dframe % 20 == 0) and dframe <= 700 then dump_npc(delirium, "delirium f" .. dframe) end
+end)
diff --git a/scripts/recomp/rgon/lab_state_test.lua b/scripts/recomp/rgon/lab_state_test.lua
new file mode 100644
index 0000000..71b1a57
--- /dev/null
+++ b/scripts/recomp/rgon/lab_state_test.lua
@@ -0,0 +1,202 @@
+-- lab_state_test.lua (development only; ISAAC_RGON_LAB=lab_state_test.lua, census batch B3): the small state getters of
+-- api_state_getters.lua against known game states. Logs "lab_state_test: PASS/FAIL ..", INFO lines for what is only looked
+-- at, and a final "lab_state_test: DONE n PASS m FAIL". Run (headless, scripted: Escape twice in the first room):
+--   HEADLESS=1 FRESH=1 FRAMES=2600 LAB=lab_state_test.lua SCRIPT='until=Room 1.2(Start Room):enter,@100:esc:hold=4,@220:esc:hold=4'
+-- ISAAC_LAB_MODE=shot is for a windowed run with ISAAC_MAC_SHOT: in a run it sets the pause screen's state by hand
+-- (1, 2 = the options page, 0) and logs "SHOT <name>" lines; shots at @40, @90, @150, @210 after the first room.
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local r32, w32, w8, ri32, log = B.r32, B.w32, B.w8, B.ri32, B.log
+local mod = RegisterMod("rgon lab state test", 1)
+local pass, fail = 0, 0
+local function say(s) log("lab_state_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  say((ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function info(s) say("INFO " .. s) end
+local mode = B.env("ISAAC_LAB_MODE") or "test"
+local MM_PTR = 0x00c72a20
+
+------------------------------------------------------------------------------ the names
+for _, n in ipairs({ "RoomDescriptor.GetDimension", "Game.IsPauseMenuOpen", "Game.GetPauseMenuState", "Game.GetGenericPrompt", "GenericPrompt.IsActive",
+  "PauseMenu.GetState", "PauseMenu.SetState", "DailyChallengeMenu.GetState", "DailyChallengeMenu.SetState",
+  "EntityDelirium.BossType", "EntityDelirium.BossVariant", "EntityDelirium.Cycle", "EntityDelirium.TransformationTimer" }) do
+  check("Implemented " .. n, R.Implemented[n] == true)
+end
+check("no stray Implemented EntityNPC.BossType", R.Implemented["EntityNPC.BossType"] == nil)
+
+------------------------------------------------------------------------------ main menu: DailyChallengeMenu
+local menu_done, menu_frames = false, 0
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  if menu_done then return end
+  menu_frames = menu_frames + 1
+  local mm = r32(MM_PTR)
+  if mm == 0 then return end
+  if mode == "shot" then menu_done = true return end        -- (the daily run menu cannot be reached by script: the Steam popup comes back on every menu)
+  if menu_frames < 30 then return end
+  menu_done = true
+  local s0 = DailyChallengeMenu.GetState()
+  check("DailyChallengeMenu.GetState idle is 0", s0 == 0, s0)
+  check("the daily run sprite is where the game's render has it (self pointers at manager+0xde8)", r32(mm + 0xde8 + 0x30) == mm + 0xde8 and r32(mm + 0xde8 + 0x50) == mm + 0xde8)
+  DailyChallengeMenu.SetState(3)
+  check("DailyChallengeMenu.SetState(3) reads back", DailyChallengeMenu.GetState() == 3, DailyChallengeMenu.GetState())
+  check("the state is the word at manager+0xdd4", ri32(mm + 0xdd4) == 3)
+  DailyChallengeMenu.SetState(0)
+  check("DailyChallengeMenu.SetState(0) puts it back", DailyChallengeMenu.GetState() == 0)
+  local ok = pcall(DailyChallengeMenu.SetState, "x")
+  check("DailyChallengeMenu.SetState(\"x\") is an argument error", not ok)
+end)
+
+if mode == "shot" then
+  -- in a run: the pause menu, driven by SetState with the game not paused
+  local f = 0
+  mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+    if not Isaac.IsInGame() then return end
+    f = f + 1
+    if f == 60 then PauseMenu.SetState(1) say("SHOT pause SetState(1) at run frame 60 (paused before: " .. tostring(Game():IsPaused()) .. ")") end
+    if f == 120 then PauseMenu.SetState(2) say("SHOT pause SetState(2) at run frame 120") end
+    if f == 180 then PauseMenu.SetState(0) say("SHOT pause SetState(0) at run frame 180") end
+    if f > 50 and f <= 240 and f % 10 == 0 then say(string.format("INFO run frame %d: PauseMenu.GetState %d IsPaused %s IsPauseMenuOpen %s", f, PauseMenu.GetState(), tostring(Game():IsPaused()), tostring(Game():IsPauseMenuOpen()))) end
+  end)
+  return
+end
+
+------------------------------------------------------------------------------ in a run
+local fin = 0
+local mismatch, compared, opened = 0, 0, 0
+local last_open, closes = false, 0
+local did_room, did_prompt, did_delirium = false, false, false
+local seen_state = {}
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not Isaac.IsInGame() then return end
+  fin = fin + 1
+  local open = Game():IsPauseMenuOpen()
+  local paused = Game():IsPaused()
+  local st = PauseMenu.GetState()
+  seen_state[st] = (seen_state[st] or 0) + 1
+  if fin > 20 then              -- (the game reports itself paused for its first few frames, with the pause screen closed)
+    compared = compared + 1
+    if open ~= paused or open ~= (st > 0) or Game():GetPauseMenuState() ~= st then
+      mismatch = mismatch + 1
+      if mismatch <= 5 then info(string.format("pause mismatch at frame %d: IsPauseMenuOpen %s IsPaused %s state %d", fin, tostring(open), tostring(paused), st)) end
+    end
+  end
+  if open and not last_open then opened = opened + 1 info("pause menu opened at run frame " .. fin .. ", state " .. st) end
+  if (not open) and last_open then closes = closes + 1 info("pause menu closed at run frame " .. fin .. ", state " .. st) end
+  last_open = open
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  local g = Game()
+  if not did_room then
+    did_room = true
+    local level, room = g:GetLevel(), g:GetRoom()
+    local idx = level:GetCurrentRoomIndex()
+    local here = level:GetCurrentRoomDesc()
+    check("GetDimension of the start room is 0", here:GetDimension() == 0, here:GetDimension())
+    check("GetDimension agrees with Level:GetDimension", here:GetDimension() == level:GetDimension())
+    local h0 = GetPtrHash(level:GetRoomByIdx(idx, 0))
+    for dim = 1, 2 do
+      local d = level:GetRoomByIdx(idx, dim)
+      info(string.format("GetRoomByIdx(%d, %d): %s, same object as dimension 0's: %s, GetDimension %s", idx, dim, tostring(d), tostring(d ~= nil and GetPtrHash(d) == h0), tostring(d and d:GetDimension())))
+    end
+    -- the game's generic prompt
+    local gp = g:GetGenericPrompt()
+    check("Game:GetGenericPrompt gives a GenericPrompt", gp ~= nil and getmetatable(gp) == GenericPrompt)
+    check("the same object on every call", g:GetGenericPrompt() == gp)
+    local a = gp.address
+    check("its ANM2 is where the game keeps the prompt (self pointers at +0x30 and +0x50)", r32(a + 0x30) == a and r32(a + 0x50) == a, string.format("%x", a))
+    check("GenericPrompt.IsActive is false in a normal run", gp:IsActive() == false)
+    check("GenericPrompt.IsActive(gp), static form", GenericPrompt.IsActive(gp) == false)
+    -- the game's own function reads +0x34 (non zero) and the byte +0x44; a block of our own shows the call is the game's test
+    local blk = B.alloc(0x134)
+    for o = 0, 0x130, 4 do w32(blk + o, 0) end
+    local fake = T.generic_prompt(blk)
+    check("a prompt block with nothing set is not active", fake:IsActive() == false)
+    w32(blk + 0x34, 0x1000)
+    check("+0x34 set alone is not active", fake:IsActive() == false)
+    w8(blk + 0x44, 1)
+    check("+0x34 and +0x44 set is active", fake:IsActive() == true)
+    w32(blk + 0x34, 0)
+    check("+0x34 cleared is not active", fake:IsActive() == false)
+    B.free(blk)
+    check("GenericPrompt.IsActive with a non prompt is an error", not pcall(GenericPrompt.IsActive, 5))
+    check("PauseMenu.GetState is 0 outside the pause menu", PauseMenu.GetState() == 0 and g:IsPauseMenuOpen() == false)
+  end
+end)
+
+------------------------------------------------------------------------------ Delirium and the end
+local D, dframe = nil, 0
+local t_prev, steps, exact = nil, 0, 0
+local fly
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if fin < 260 or opened < 1 or closes < 1 then return end       -- after the pause menu has been opened and closed
+  if not D then
+    check("pause menu opened once and closed once", opened == 1 and closes == 1, opened .. "/" .. closes)
+    check("IsPauseMenuOpen, GetPauseMenuState, PauseMenu.GetState and IsPaused agreed on every frame", mismatch == 0, mismatch .. " of " .. compared)
+    check("the pause state was seen as 0 and 1", (seen_state[0] or 0) > 100 and (seen_state[1] or 0) > 20, (seen_state[0] or 0) .. "/" .. (seen_state[1] or 0))
+    fly = Isaac.Spawn(EntityType.ENTITY_FLY, 0, 0, Vector(200, 200), Vector(0, 0), nil)
+    check("ToDelirium of a fly is nil", fly:ToDelirium() == nil)
+    check("BossType of a fly is nil", fly:ToNPC().BossType == nil and fly:ToNPC().TransformationTimer == nil)
+    check("setting TransformationTimer on a fly is an error", not pcall(function() fly:ToNPC().TransformationTimer = 5 end))
+    fly:Remove()
+    D = Isaac.Spawn(412, 0, 0, Vector(320, 260), Vector(0, 0), nil)
+    check("ToDelirium of a Delirium is an NPC", D:ToDelirium() ~= nil and D:ToDelirium():ToNPC() ~= nil)
+    check("ToDelirium of the player is nil", Isaac.GetPlayer(0):ToDelirium() == nil)
+    return
+  end
+  dframe = dframe + 1
+  local n = D:ToDelirium()
+  if dframe == 1 then
+    local t0 = n.TransformationTimer
+    check("TransformationTimer is a number", type(t0) == "number" and t0 >= 0 and t0 <= 0xffff, t0)
+  elseif dframe == 50 then
+    -- (the first frames are Delirium's appearing state: its boss fields are still empty there)
+    check("BossType is 412 on a spawned Delirium", n.BossType == 412, n.BossType)
+    check("BossVariant is 0 on a spawned Delirium", n.BossVariant == 0, n.BossVariant)
+  elseif dframe >= 55 and dframe <= 65 then
+    local t = n.TransformationTimer
+    if t_prev then
+      steps = steps + 1
+      if t == t_prev - 1 then exact = exact + 1 end
+    end
+    t_prev = t
+  elseif dframe == 66 then
+    check("TransformationTimer counts down one a frame (the game's own update)", steps == 10 and exact >= 8, exact .. " of " .. steps .. " steps were -1")
+    local c1 = n.Cycle
+    check("Cycle is a number", type(c1) == "number", c1)
+    n.Cycle = c1
+    check("Cycle reads back what was written", n.Cycle == c1)
+    n.TransformationTimer = 500
+    check("TransformationTimer reads back what was set", n.TransformationTimer == 500, n.TransformationTimer)
+  elseif dframe == 67 then
+    local t = n.TransformationTimer
+    check("the game went on counting from the written timer (499 or 500)", t == 499 or t == 500, t)
+    n.TransformationTimer = 3
+  elseif dframe == 80 then
+    local t = n.TransformationTimer
+    info("TransformationTimer 13 frames after it was set to 3: " .. t .. ", type " .. D.Type .. ", variant " .. D.Variant .. ", BossType " .. tostring(n.BossType) .. ", Cycle " .. n.Cycle)
+    check("the game acted on a timer set to 3 (it ran out and was reloaded)", t > 100, t)
+  elseif dframe == 81 then
+    D:Remove()
+    for _, e in ipairs(Isaac.GetRoomEntities()) do if e.Type == 412 then e:Remove() end end
+    -- the Death Certificate sends the player to dimension 2 (a room of its own): the descriptor of that room must say 2
+    local p = Isaac.GetPlayer(0)
+    p:UseActiveItem(CollectibleType.COLLECTIBLE_DEATH_CERTIFICATE, UseFlag.USE_NOANIM)
+    info("Death Certificate used; dimension of the room now " .. Game():GetLevel():GetCurrentRoomDesc():GetDimension())
+  elseif dframe > 81 and dframe <= 200 then
+    local level = Game():GetLevel()
+    local here = level:GetCurrentRoomDesc()
+    if dframe % 20 == 0 then info(string.format("dframe %d: room %d, GetDimension %d, Level:GetDimension %d", dframe, level:GetCurrentRoomIndex(), here:GetDimension(), level:GetDimension())) end
+    if dframe == 140 then
+      check("GetDimension of the Death Certificate room is 2", here:GetDimension() == 2, here:GetDimension())
+      check("the same room asked through GetRoomByIdx(index, 2) is the same descriptor", GetPtrHash(level:GetRoomByIdx(level:GetCurrentRoomIndex(), 2)) == GetPtrHash(here))
+      local d0 = level:GetRoomByIdx(level:GetCurrentRoomIndex(), 0)
+      check("and the dimension 0 descriptor at that index (if any) says 0", d0 == nil or GetPtrHash(d0) == GetPtrHash(here) or d0:GetDimension() == 0, d0 and d0:GetDimension())
+    end
+    if dframe == 141 then say(string.format("DONE %d PASS %d FAIL", pass, fail)) end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_store.lua b/scripts/recomp/rgon/lab_store.lua
new file mode 100644
index 0000000..4c6aa35
--- /dev/null
+++ b/scripts/recomp/rgon/lab_store.lua
@@ -0,0 +1,12 @@
+-- lab_store.lua (development only; ISAAC_RGON_LAB=lab_store.lua, round 123)
+-- The layer's own save file with no mod of its own: once a run has started (a save slot is chosen),
+-- say what the store holds, write a section and read it back; run twice to see it come back.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab store", 1)
+mod:AddCallback(M.MC_POST_GAME_STARTED, function()
+  local before = T.store.get("labtest")
+  local ok = T.store.set("labtest", "written at frame " .. Isaac.GetFrameCount() .. " by run " .. tostring(B.env("ISAAC_LAB_TAG")))
+  B.log("lab_store: SAVEFILE=" .. tostring(B.SAVEFILE) .. " before=" .. tostring(before) .. " set=" .. tostring(ok) .. " after=" .. tostring(T.store.get("labtest")))
+end)
