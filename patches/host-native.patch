index 0000000..745ae73
--- /dev/null
+++ b/scripts/recomp/rgon/api_batch_two.lua
@@ -0,0 +1,299 @@
+-- api_batch_two.lua -- census batch 2 (M8): the weapon and laser fields of EntityPlayer, the Weapon class and
+-- EntityKnife, written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp). Every offset below was
+-- measured in THIS executable (v1.9.7.17) in a running game (lab_b2probe*.lua: the structure snapshotted
+-- before and after the game itself changed the value, or the value read where the game's own getter or an
+-- initialiser puts it); REPENTOGON's number and the measured one are in the comment of each block.
+--
+--   EntityPlayer  REPENTOGON  here    how it was measured
+--   stat modifiers  0x1518..0x152c  0x1520..0x1534 (+8)  Entity_Player::EvaluateItems (0x00763570) reads the six
+--                                   ints and Init (0x00755ad7) clears them as a block; writing 5 into each and
+--                                   re-evaluating moved exactly one stat each (lab_b2probe)
+--   tear displacement 0x156c        0x1578 (+12)         int8, 1 / -1: flips with every tear fired (lab_b2probe)
+--   bomb place delay  0x1604        0x1610 (+12)         0 -> 28 when the game places a bomb (lab_b2probe2)
+--   head lock time    0x133c        0x1338 (-4)          the vanilla HeadFrameDelay: -1 idle, 10 after a shot,
+--                                   counts down, and the head direction (0x1628) returns when it reaches -1
+--   head direction    0x161c        0x1628 (+12)         read back through GetHeadDirection (lab_b2probe2)
+--   head animation    0x1320        0x1320 (+0)          the std::string "HeadDown" (SSO: size 0x1330, capacity 0x1334)
+--   urn souls         0x1dbc        0x1dd0 (+20)         0 -> 3 across the game's own AddUrnSouls(3) (lab_b2probe)
+--   weapons           0x13d8        0x13dc (+4)          slot 1 (the primary weapon) holds the Weapon whose +4 is the player
+--   marked target     0x1408        0x140c (+4)          the pointer to the TARGET effect (1000, 30) Marked spawns
+--   Weapon (0x40 bytes)             as REPENTOGON        +4 owner, +c fire delay, +10 max fire delay, +14 charge,
+--                                   +30 type, +34 modifiers, +38 shots fired: type 1 (tears), max fire delay
+--                                   equal to the player's MaxFireDelay, owner = the player (lab_b2probe)
+--   EntityKnife                     as REPENTOGON        Entity_Knife's initialiser (0x00960c10) clears 0x444, 0x448,
+--                                   0x465, 0x4e5/6 and 0x4ea together; the flag byte 0x465 reads 1 while a bone
+--                                   club swings and 0 after (lab_b2probe3); the hit list is the vector the game's
+--                                   own GetHitEntities (0x009612e0: `lea eax, [ecx+0x4d8]`) hands out
+--
+-- Left out because no value could be made to move (see layer-gaps.md): Suplex state (the fields REPENTOGON
+-- names at 0x1f08.. hold a -100000 sentinel and floats here), Keeper's Sack bonus, Pony charge, Immaculate and
+-- Cambion Conception states, the Eve's Sumptorium charge, Red Stew's duration, PlayerForm counters.
+
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.log, B.call
+local type, tostring, tonumber, pairs, ipairs, setmetatable, getmetatable, rawget = type, tostring, tonumber, pairs, ipairs, setmetatable, getmetatable, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function num_arg(v, n, what)
+  if type(v) ~= "number" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+local P = "EntityPlayer"
+
+------------------------------------------------------------------------------
+-- EntityPlayer: the six stat modifiers (ints the game's own EvaluateItems adds)
+------------------------------------------------------------------------------
+-- Speed +0.2, FireDelay (about +0.5 tears a second), Damage +1, TearRange +100 (2.5 tiles of range), ShotSpeed
+-- +0.2, Luck +1 per point, measured by writing 5 and re-evaluating. Like REPENTOGON's, a setter does not ask for
+-- a re-evaluation: the game does at the next cache flag.
+do
+  for name, off in pairs({ Speed = 0x1520, FireDelay = 0x1524, Damage = 0x1528, TearRange = 0x152c, ShotSpeed = 0x1530, Luck = 0x1534 }) do
+    method(P, "Get" .. name .. "Modifier", function(self) return ri32(this(self, "Get" .. name .. "Modifier") + off) end)
+    method(P, "Set" .. name .. "Modifier", function(self, v)
+      local p = this(self, "Set" .. name .. "Modifier")
+      w32(p + off, int_arg(v, 1, "Set" .. name .. "Modifier") & 0xffffffff)
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- EntityPlayer: tear displacement, bomb place delay, head, urn, marked target, laser colour
+------------------------------------------------------------------------------
+do
+  -- GetTearDisplacement() -> 1 or -1 (the side the next tear leaves from); SetTearDisplacement(-1..1)
+  method(P, "GetTearDisplacement", function(self)
+    local v = r8(this(self, "GetTearDisplacement") + 0x1578)
+    return v >= 0x80 and v - 0x100 or v
+  end)
+  method(P, "SetTearDisplacement", function(self, v)
+    v = int_arg(v, 1, "SetTearDisplacement")
+    if v < -1 or v > 1 then error("bad argument #1 to 'SetTearDisplacement' (TearDisplacement may only be set to -1 or 1)", 2) end
+    w8(this(self, "SetTearDisplacement") + 0x1578, v & 0xff)
+  end)
+  method(P, "GetBombPlaceDelay", function(self) return ri32(this(self, "GetBombPlaceDelay") + 0x1610) end)
+  method(P, "SetBombPlaceDelay", function(self, v) w32(this(self, "SetBombPlaceDelay") + 0x1610, int_arg(v, 1, "SetBombPlaceDelay") & 0xffffffff) end)
+  method(P, "GetHeadDirectionLockTime", function(self) return ri32(this(self, "GetHeadDirectionLockTime") + 0x1338) end)
+  method(P, "SetHeadDirectionLockTime", function(self, v) w32(this(self, "SetHeadDirectionLockTime") + 0x1338, int_arg(v, 1, "SetHeadDirectionLockTime") & 0xffffffff) end)
+
+  -- SetHeadDirection(direction, time, force = false): only while no direction is locked (the lock time below
+  -- zero) unless forced; a changed direction also changes the head animation's name, as REPENTOGON does
+  -- (the game only reads the name, it never derives it from the direction again until the next shot)
+  local HEAD_ANIM = { [0] = "HeadLeft", "HeadUp", "HeadRight", "HeadDown" }
+  local function set_string(at, s)
+    -- MSVC std::string: 16 bytes of inline text, or a pointer in the first word once the capacity is above 15
+    local cap = r32(at + 0x14)
+    local buf = at
+    if cap > 15 then buf = r32(at) end
+    if cap < #s or buf == 0 then return false end
+    for i = 1, #s do w8(buf + i - 1, s:byte(i)) end
+    w8(buf + #s, 0)
+    w32(at + 0x10, #s)
+    return true
+  end
+  method(P, "SetHeadDirection", function(self, direction, time, force)
+    local p = this(self, "SetHeadDirection")
+    direction = int_arg(direction, 1, "SetHeadDirection")
+    time = int_arg(time, 2, "SetHeadDirection")
+    if direction < 0 or direction > 3 then error("bad argument #1 to 'SetHeadDirection' (Invalid Direction)", 2) end
+    if force == true or ri32(p + 0x1338) < 0 then
+      if ri32(p + 0x1628) ~= direction then
+        w32(p + 0x1628, direction)
+        set_string(p + 0x1320, HEAD_ANIM[direction])
+      end
+      w32(p + 0x1338, time & 0xffffffff)
+    end
+  end)
+
+  -- GetUrnSouls() -> the souls Urn of Souls holds; AddUrnSouls(count) is the game's own (0x007d3480, ret 4)
+  method(P, "GetUrnSouls", function(self) return ri32(this(self, "GetUrnSouls") + 0x1dd0) end)
+
+  -- GetMarkedTarget() -> the TARGET effect Marked (and Telekinesis-like items) put on the floor, or nil
+  method(P, "GetMarkedTarget", function(self)
+    local e = wrap("Entity", r32(this(self, "GetMarkedTarget") + 0x140c))
+    return e and e:ToEffect()
+  end)
+
+  -- SetLaserColor(color): the colour of the player's lasers, which the game itself has as the LaserColor property
+  method(P, "SetLaserColor", function(self, color)
+    if type(color) ~= "userdata" then error("bad argument #1 to 'SetLaserColor' (Color expected, got " .. type(color) .. ")", 2) end
+    this(self, "SetLaserColor")
+    self.LaserColor = color
+  end)
+
+  -- IsItemCostumeVisible(item, layer) / IsNullItemCostumeVisible(nullItem, layer): the game's own checks (0x0075d900
+  -- and 0x0075d980, both `ret 8`; the second looks the null item up in the item config and jumps into the first)
+  local function layer_id(self, layer, what)
+    local sprite = self:GetSprite()
+    if type(layer) == "string" then
+      local l = sprite:GetLayer(layer)
+      if l == nil then error("Invalid layer name " .. layer, 3) end
+      return l:GetLayerID()
+    end
+    local id = int_arg(layer, 2, what)
+    if id < 0 or id >= sprite:GetLayerCount() then error("Invalid layer ID " .. id, 3) end
+    return id
+  end
+  method(P, "IsItemCostumeVisible", function(self, item, layer)
+    local p = this(self, "IsItemCostumeVisible")
+    local ip = type(item) == "userdata" and ptr(item) or 0
+    if ip == 0 then error("bad argument #1 to 'IsItemCostumeVisible' (ItemConfigItem expected, got " .. type(item) .. ")", 2) end
+    return (call(0x0075d900, p, ip, layer_id(self, layer, "IsItemCostumeVisible")) & 0xff) ~= 0
+  end)
+  method(P, "IsNullItemCostumeVisible", function(self, null_item, layer)
+    local p = this(self, "IsNullItemCostumeVisible")
+    null_item = int_arg(null_item, 1, "IsNullItemCostumeVisible")
+    return (call(0x0075d980, p, null_item & 0xffffffff, layer_id(self, layer, "IsNullItemCostumeVisible")) & 0xff) ~= 0
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Weapon
+------------------------------------------------------------------------------
+-- EntityPlayer:GetWeapon(slot 0..4) -> Weapon or nil. 0 backup weapon (Notched Axe, Urn of Souls), 1 primary, 2 and
+-- up for mods. A Weapon here is a Lua object holding the game's Weapon address; like REPENTOGON's it is only
+-- good while the game keeps the weapon (a weapon that is destroyed leaves a stale handle).
+do
+  local W = {}
+  local MT = { __index = W, __type = "Weapon", __name = "Weapon", __metatable = nil }
+  MT.__tostring = function(self) return string.format("Weapon(0x%x)", self[1]) end
+  MT.__eq = function(a, b) return getmetatable(b) == MT and a[1] == b[1] end
+  local function at(self, what)
+    if getmetatable(self) ~= MT then error("bad argument #1 to '" .. what .. "' (Weapon expected, got " .. type(self) .. ")", 3) end
+    return self[1]
+  end
+  function W:GetOwner()
+    return wrap("Entity", r32(at(self, "GetOwner") + 4))
+  end
+  function W:GetFireDelay() return rf32(at(self, "GetFireDelay") + 0xc) end
+  function W:SetFireDelay(v) wf32(at(self, "SetFireDelay") + 0xc, num_arg(v, 1, "SetFireDelay")) end
+  function W:GetMaxFireDelay() return rf32(at(self, "GetMaxFireDelay") + 0x10) end
+  function W:GetCharge() return rf32(at(self, "GetCharge") + 0x14) end
+  function W:SetCharge(v) wf32(at(self, "SetCharge") + 0x14, num_arg(v, 1, "SetCharge")) end
+  function W:GetWeaponType() return ri32(at(self, "GetWeaponType") + 0x30) end
+  function W:GetModifiers() return r32(at(self, "GetModifiers") + 0x34) end
+  -- like REPENTOGON's, SetModifiers adds bits (it never clears any)
+  function W:SetModifiers(v)
+    local p = at(self, "SetModifiers")
+    w32(p + 0x34, r32(p + 0x34) | (int_arg(v, 1, "SetModifiers") & 0xffffffff))
+  end
+  function W:GetNumFired() return ri32(at(self, "GetNumFired") + 0x38) end
+  -- IsAxisAligned(): 0x009f3360 (REPENTOGON's one signature match; no arguments)
+  function W:IsAxisAligned() return (call(0x009f3360, at(self, "IsAxisAligned")) & 0xff) ~= 0 end
+
+  for k in pairs(W) do R.Implemented["Weapon." .. k] = true end
+  T.Weapon = { new = function(address) if address == 0 then return nil end return setmetatable({ address }, MT) end, MT = MT }
+
+  method(P, "GetWeapon", function(self, slot)
+    local p = this(self, "GetWeapon")
+    slot = int_arg(slot, 1, "GetWeapon")
+    if slot < 0 or slot > 4 then error("bad argument #1 to 'GetWeapon' (Index must be between 0 and 4)", 2) end
+    local w = r32(p + 0x13dc + 4 * slot)
+    return T.Weapon.new(w)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityKnife
+------------------------------------------------------------------------------
+do
+  local K = "EntityKnife"
+  local function flag(get, set, off)
+    if get then method(K, get, function(self) return r8(this(self, get) + off) ~= 0 end) end
+    if set then
+      method(K, set, function(self, v)
+        local p = this(self, set)
+        if type(v) ~= "boolean" then error("bad argument #1 to '" .. set .. "' (boolean expected, got " .. type(v) .. ")", 2) end
+        w8(p + off, v and 1 or 0)
+      end)
+    end
+  end
+  flag("GetIsSwinging", "SetIsSwinging", 0x465)
+  flag("GetIsSpinAttack", "SetIsSpinAttack", 0x4ea)
+  flag("IsPrismTouched", "SetPrismTouched", 0x4e5)
+  flag("IsMultidimensionalTouched", "SetMultidimensionalTouched", 0x4e6)
+  method(K, "SetKnifeVelocity", function(self, v) wf32(this(self, "SetKnifeVelocity") + 0x448, num_arg(v, 1, "SetKnifeVelocity")) end)
+  method(K, "SetKnifeDistance", function(self, v) wf32(this(self, "SetKnifeDistance") + 0x444, num_arg(v, 1, "SetKnifeDistance")) end)
+
+  -- the entities the knife has hit: the game's std::vector<unsigned> of hit list indices; GetHitEntities (0x009612e0)
+  -- answers the vector of the knife itself, or of its parent knife while this one is a hitbox of another
+  local function hits(self, what)
+    local v = call(0x009612e0, this(self, what))
+    local first, last, cap = r32(v), r32(v + 4), r32(v + 8)
+    if v == 0 or last < first or last - first > 0x10000 or (last - first) % 4 ~= 0 then error("rgon: this knife's hit list is not laid out as expected", 3) end
+    return v, first, last, cap
+  end
+  local function index_of(entity, n, what)
+    if type(entity) ~= "userdata" or ptr(entity) == 0 then error("bad argument #" .. n .. " to '" .. what .. "' (Entity expected, got " .. type(entity) .. ")", 3) end
+    return entity:GetHitListIndex()
+  end
+  method(K, "GetHitList", function(self)
+    local _, first, last = hits(self, "GetHitList")
+    local out = {}
+    for a = first, last - 4, 4 do out[#out + 1] = r32(a) end
+    return out
+  end)
+  method(K, "InHitList", function(self, entity)
+    local idx = index_of(entity, 1, "InHitList")
+    local _, first, last = hits(self, "InHitList")
+    for a = first, last - 4, 4 do if r32(a) == idx then return true end end
+    return false
+  end)
+  method(K, "AddToHitList", function(self, entity)
+    local idx = index_of(entity, 1, "AddToHitList")
+    local v, first, last, cap = hits(self, "AddToHitList")
+    for a = first, last - 4, 4 do if r32(a) == idx then return end end
+    if last >= cap then
+      -- grow like the game's vector does: a new buffer from the game's allocator (B.alloc is the same one), the old one freed
+      local n = (last - first) // 4
+      local new = B.alloc(4 * (n * 2 + 4))
+      if new == 0 then error("rgon: out of memory growing a knife's hit list", 2) end
+      for i = 0, n - 1 do w32(new + 4 * i, r32(first + 4 * i)) end
+      if first ~= 0 then B.free(first) end
+      w32(v, new)
+      first, last, cap = new, new + 4 * n, new + 4 * (n * 2 + 4)
+      w32(v + 8, cap)
+    end
+    w32(last, idx)
+    w32(v + 4, last + 4)
+  end)
+  method(K, "RemoveFromHitList", function(self, entity)
+    local idx = index_of(entity, 1, "RemoveFromHitList")
+    local v, first, last = hits(self, "RemoveFromHitList")
+    for a = first, last - 4, 4 do
+      if r32(a) == idx then
+        w32(a, r32(last - 4))                 -- swap with the last entry and drop it, as REPENTOGON does
+        w32(v + 4, last - 4)
+        return
+      end
+    end
+  end)
+
+  -- Get/SetHitboxParentKnife: REPENTOGON keeps the "main" knife of a melee weapon's hitbox knife in a side field
+  -- its own hook fills when the game creates the bone club's or Spirit Sword's hitbox. Here only what a mod set
+  -- is answered, per hitbox knife (a Lua table, forgotten on a new room); the game's own hitboxes are not linked
+  -- to their knife (that needs a hook at the hitbox's creation), so a mod that asks gets nil, as REPENTOGON
+  -- answers for a hitbox spawned any other way. Not counted in REPENTOGON.Implemented. Fiend Folio asks on every
+  -- damage callback (critical_hit.lua:248, statuses/berserk.lua:570, martyr.lua:383) and errored without the name.
+  local parent_of = {}
+  method(K, "GetHitboxParentKnife", function(self)
+    local p = this(self, "GetHitboxParentKnife")
+    local parent = parent_of[p]
+    if parent and parent:Exists() then return parent end
+    return nil
+  end)
+  method(K, "SetHitboxParentKnife", function(self, knife)
+    local p = this(self, "SetHitboxParentKnife")
+    if knife ~= nil and (type(knife) ~= "userdata" or knife:ToKnife() == nil) then error("bad argument #1 to 'SetHitboxParentKnife' (EntityKnife expected, got " .. type(knife) .. ")", 2) end
+    parent_of[p] = knife
+  end)
+  R.Implemented["EntityKnife.GetHitboxParentKnife"] = nil
+  R.Implemented["EntityKnife.SetHitboxParentKnife"] = nil
+  if T.listen and ModCallbacks.MC_POST_NEW_ROOM then T.listen(ModCallbacks.MC_POST_NEW_ROOM, function() parent_of = {} end) end
+end
diff --git a/scripts/recomp/rgon/api_census.lua b/scripts/recomp/rgon/api_census.lua
new file mode 100644
index 0000000..943e131
--- /dev/null
+++ b/scripts/recomp/rgon/api_census.lua
@@ -0,0 +1,299 @@
+-- api_census.lua -- round 124 (M8 census, batch 1): names the census (scripts/mac/rgon_census.py) found
+-- missing and cheap, written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp says what each does).
+--
+--   RNG                the shift index, the "phantom" reads (a copy: the RNG does not move), Previous
+--   EntityConfigPlayer starting hearts, coins, bombs, keys and CanShoot, from the config record
+--   ItemConfig         GetTaggedItems (the game's own tag lookup), GetItemsWithCustomTag (api_data.lua)
+--   Isaac              GetCutsceneIdByName
+--   calls into the game  methods that pass straight to one game function: each address is a REPENTOGON
+--                      signature that matches this executable exactly once (tools/zhl-resolve.mjs), and the
+--                      function's own `ret` pops what the signature's arguments take (read with a disassembler)
+--
+-- Nothing here is listed as implemented unless the behaviour is REPENTOGON's. Where it is close but not the
+-- same, the comment says so and R.Unsupported carries a line.
+
+local T = ...
+local B, R, method, wrap, this, static = T.B, T.R, T.method, T.wrap, T.this, T.static
+local ptr, r8, r32, ri32, rf32, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w32, B.wf32, B.log, B.call
+local type, tostring, tonumber, select, pairs, ipairs, rawget = type, tostring, tonumber, select, pairs, ipairs, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+------------------------------------------------------------------------------
+-- RNG
+------------------------------------------------------------------------------
+-- An RNG is { seed +0, shift1 +4, shift2 +8, shift3 +12 } (api_lua.lua checks this against the game's own Next).
+-- A phantom read runs the game's own RandomInt/RandomFloat/Next on a copy of those four words.
+do
+  local ok = false
+  do
+    local a = RNG()
+    a:SetSeed(0x1234567, 35)
+    local p = ptr(a)
+    ok = p ~= 0 and r32(p) == 0x1234567
+  end
+  if not ok then
+    log("api_census: an RNG is not laid out as expected; the RNG additions are left out")
+  else
+    local function at(self, what)
+      local p = ptr(self)
+      if p == 0 then error("rgon: " .. what .. " called without its object (use ':')", 3) end
+      return p
+    end
+    local function copy_of(self, what)
+      local p = at(self, what)
+      local c = RNG()
+      local q = ptr(c)
+      for i = 0, 12, 4 do w32(q + i, r32(p + i)) end
+      return c
+    end
+    -- the game's 81 shift triples, read back from its own SetSeed(seed, index) the first time they are asked
+    local SHIFTS
+    local function shifts()
+      if SHIFTS then return SHIFTS end
+      SHIFTS = {}
+      local scratch = RNG()
+      local q = ptr(scratch)
+      for idx = 0, 80 do
+        scratch:SetSeed(1, idx)
+        SHIFTS[idx] = { r32(q + 4), r32(q + 8), r32(q + 12) }
+      end
+      return SHIFTS
+    end
+    method("RNG", "GetShiftIdx", function(self)
+      local p = at(self, "GetShiftIdx")
+      local a, b, c = r32(p + 4), r32(p + 8), r32(p + 12)
+      for idx, s in ipairs(shifts()) do end
+      local t = shifts()
+      for idx = 0, 80 do
+        local s = t[idx]
+        if s[1] == a and s[2] == b and s[3] == c then return idx end
+      end
+      return nil
+    end)
+    method("RNG", "PhantomNext", function(self) return copy_of(self, "PhantomNext"):Next() end)
+    method("RNG", "PhantomFloat", function(self) return copy_of(self, "PhantomFloat"):RandomFloat() end)
+    -- PhantomInt(max) -> 0 .. max-1 (as RandomInt); PhantomInt(min, max) -> min .. max, both included
+    method("RNG", "PhantomInt", function(self, a, b)
+      local c = copy_of(self, "PhantomInt")
+      a = int_arg(a, 1, "PhantomInt")
+      if b == nil then return c:RandomInt(a) end
+      b = int_arg(b, 2, "PhantomInt")
+      if a > b then error("bad argument #1 to 'PhantomInt' (interval is empty)", 2) end
+      return c:RandomInt(b - a + 1) + a
+    end)
+    -- the xorshift step undone: the seed that Next() would have come from
+    local function rev_shr(result, s)
+      local x = 0
+      for _ = 1, (32 + s - 1) // s do x = ((x >> s) ~ result) & 0xffffffff end
+      return x
+    end
+    local function rev_shl(result, s)
+      local x = 0
+      for _ = 1, (32 + s - 1) // s do x = (((x << s) & 0xffffffff) ~ result) & 0xffffffff end
+      return x
+    end
+    local function previous(p)
+      local s1, s2, s3 = r32(p + 4), r32(p + 8), r32(p + 12)
+      if s1 == 0 or s2 == 0 or s3 == 0 then return r32(p) end
+      local t = rev_shr(r32(p), s3)
+      t = rev_shl(t, s2)
+      return rev_shr(t, s1)
+    end
+    method("RNG", "Previous", function(self)
+      local p = at(self, "Previous")
+      w32(p, previous(p))
+      return r32(p)
+    end)
+    method("RNG", "PhantomPrevious", function(self) return previous(at(self, "PhantomPrevious")) end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- EntityConfigPlayer: the starting values the config record holds
+------------------------------------------------------------------------------
+-- The record is the one api_gaps.lua reads (T.player_config, 0x148 bytes each, the name at +4 checked); these
+-- fields follow REPENTOGON's layout between the two this build is known to share (+0xac .. +0xf4):
+-- +0xb0 hearts, +0xb4 soul hearts (armor), +0xb8 black hearts, +0xbc coins, +0xc0 bombs, +0xc4 keys, +0xd0 CanShoot.
+do
+  local pc = T.player_config
+  local sample = EntityConfig and EntityConfig.GetPlayer and EntityConfig.GetPlayer(0)
+  local PC = sample and getmetatable(sample) and getmetatable(sample).__index
+  if type(PC) == "table" and pc then
+    local stdstr = B.stdstr
+    local checked = {}
+    local function rec(self, what)
+      local at = pc(self._id)
+      if not at then return nil end
+      if checked[self._id] == nil then
+        checked[self._id] = (stdstr(at + 4) == (self._x.name or "")) or false
+        if not checked[self._id] then log("api_census: the config record of player " .. self._id .. " does not hold its name; " .. what .. " answers its default") end
+      end
+      return checked[self._id] and at or nil
+    end
+    local function int(name, off)
+      PC[name] = function(self) local at = rec(self, name) return at and ri32(at + off) or 0 end
+      R.Implemented["EntityConfigPlayer." .. name] = true
+    end
+    int("GetRedHearts", 0xb0)
+    int("GetSoulHearts", 0xb4)
+    int("GetBlackHearts", 0xb8)
+    int("GetCoins", 0xbc)
+    int("GetBombs", 0xc0)
+    int("GetKeys", 0xc4)
+    PC.CanShoot = function(self) local at = rec(self, "CanShoot") return at == nil or r8(at + 0xd0) ~= 0 end
+    R.Implemented["EntityConfigPlayer.CanShoot"] = true
+  else
+    log("api_census: EntityConfig.GetPlayer is not the layer's own; the config's starting values are left out")
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemConfig:GetTaggedItems(tags)
+------------------------------------------------------------------------------
+-- ItemConfig::GetTaggedItems(unsigned long long tags) (0x00730b80, ret 8) answers a reference to the game's
+-- own list of ItemConfig_Item pointers for those tag bits; REPENTOGON converts it to a table. The pointers are
+-- turned back into the item objects Lua already knows (matched by address over collectibles, trinkets and null
+-- items, built the first time).
+do
+  local config = Isaac.GetItemConfig()
+  local by_address
+  local function index()
+    if by_address then return by_address end
+    by_address = {}
+    for _, get in ipairs({ { "GetCollectibles", "GetCollectible" }, { "GetTrinkets", "GetTrinket" }, { "GetNullItems", "GetNullItem" } }) do
+      local list = config[get[1]](config)
+      for id = 1, list.Size - 1 do
+        local item = config[get[2]](config, id)
+        if item then by_address[ptr(item)] = item end
+      end
+    end
+    return by_address
+  end
+  method("ItemConfig", "GetTaggedItems", function(self, tags)
+    tags = int_arg(tags, 1, "GetTaggedItems") & 0xffffffff
+    local v = call(0x00730b80, this(self, "GetTaggedItems"), tags, 0)
+    local first, last = r32(v), r32(v + 4)
+    if last < first or last - first > 0x40000 then error("rgon: the game's tagged-item list is not laid out as expected", 2) end
+    local out, map = {}, index()
+    for a = first, last - 4, 4 do
+      local item = map[r32(a)]
+      if item then out[#out + 1] = item end
+    end
+    return out
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Isaac
+------------------------------------------------------------------------------
+do
+  local XN = rawget(_G, "XMLNode")
+  -- Isaac.GetCutsceneIdByName(name) -> the id cutscenes.xml gives it, or -1. (A mod's cutscene has the id its own
+  -- node states, as REPENTOGON's lookup reads the node; the game gives a mod's no number of its own here.)
+  if XN and XN.CUTSCENE and T.xml_entries then
+    static(Isaac, "Isaac", "GetCutsceneIdByName", function(name)
+      if type(name) ~= "string" then error("bad argument #1 to 'GetCutsceneIdByName' (string expected, got " .. type(name) .. ")", 2) end
+      local set = T.xml_entries(XN.CUTSCENE)
+      local e = set and set.by_name[name]
+      local id = e and tonumber(e.id)
+      return id and math.tointeger(id) or -1
+    end)
+  end
+  -- Isaac.GetLoadedModules is not here: mods get no `package` table (measured), so REPENTOGON's registry _LOADED is out of reach.
+end
+
