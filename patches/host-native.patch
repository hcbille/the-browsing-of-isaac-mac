diff --git a/scripts/recomp/rgon/lab_trapdoor.lua b/scripts/recomp/rgon/lab_trapdoor.lua
new file mode 100644
index 0000000..599f207
--- /dev/null
+++ b/scripts/recomp/rgon/lab_trapdoor.lua
@@ -0,0 +1,56 @@
+-- lab_trapdoor.lua (development only; ISAAC_RGON_LAB=lab_trapdoor.lua, round 123)
+-- A real floor change with the game's own trapdoor logic: in each floor's start room, a trapdoor is spawned
+-- (Isaac.GridSpawn) on a free tile two tiles right of the player, left to open, and the player is put on it.
+-- No `stage` command, no StartStageTransition. Logs "lab_trapdoor: ..." lines; ISAAC_LAB_FLOORS = how many floors
+-- to descend (default 3).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab trapdoor", 1)
+local floors = tonumber(B.env("ISAAC_LAB_FLOORS")) or 3
+local descended, state, wait, trap, last_stage = 0, "idle", 0, nil, nil
+local function say(s) B.log("lab_trapdoor: f" .. Isaac.GetFrameCount() .. " " .. s) end
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  local level, room = Game():GetLevel(), Game():GetRoom()
+  say(string.format("new room idx %d (start %d) type %d", level:GetCurrentRoomIndex(), level:GetStartingRoomIndex(), room:GetType()))
+  if level:GetCurrentRoomIndex() == level:GetStartingRoomIndex() and descended < floors then
+    state, wait, trap = "armed", 0, nil
+  else
+    state = "idle"
+  end
+end)
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function()
+  local level = Game():GetLevel()
+  if last_stage ~= nil and level:GetStage() ~= last_stage then descended = descended + 1 end
+  last_stage = level:GetStage()
+  say(string.format("NEW LEVEL %d: stage %d type %d name '%s' (floor change %d of %d)", descended, level:GetStage(), level:GetStageType(), level:GetName(), descended, floors))
+end)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  local game, room = Game(), Game():GetRoom()
+  local p = Isaac.GetPlayer(0)
+  if state == "armed" then
+    wait = wait + 1
+    if wait == 40 then
+      local want = room:FindFreePickupSpawnPosition(p.Position + Vector(80, 0), 0, true)
+      trap = Isaac.GridSpawn(GridEntityType.GRID_TRAPDOOR, 0, want, true)
+      local idx = room:GetGridIndex(want)
+      local ge = room:GetGridEntity(idx)
+      say(string.format("spawned trapdoor at %s grid index %d, entity %s", tostring(want), idx, tostring(ge)))
+      if ge then say(string.format("trapdoor state %d type %d", ge.State, ge:GetType())) end
+      state, wait = "opening", 0
+    end
+  elseif state == "opening" then
+    wait = wait + 1
+    local idx = room:GetGridIndex(trap and trap.Position or p.Position)
+    local ge = room:GetGridEntity(idx)
+    if wait % 20 == 0 then say(string.format("waiting: room clear=%s trapdoor state %s", tostring(room:IsClear()), tostring(ge and ge.State))) end
+    if wait >= 90 and ge then
+      p.Position = ge.Position
+      p.Velocity = Vector(0, 0)
+      say(string.format("player put on the trapdoor at %s (state %d)", tostring(ge.Position), ge.State))
+      state, wait = "falling", 0
+    end
+  elseif state == "falling" then
+    wait = wait + 1
+    if wait % 30 == 0 then say(string.format("still here after %d frames, player at %s", wait, tostring(p.Position))) end
+  end
+end)
