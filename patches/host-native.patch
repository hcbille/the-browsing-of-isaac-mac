new file mode 100644
index 0000000..28c6cd2
--- /dev/null
+++ b/scripts/recomp/rgon/api_player_health.lua
@@ -0,0 +1,220 @@
+-- api_player_health.lua -- the health-related names the Custom Health API (Fiend Folio, Epiphany) uses: the Candy
+-- Heart / Soul Locket / Keeper's Sack bonuses, the Immaculate and Cambion Conception states and familiar flags,
+-- Maggy's health drain cooldown, Red Stew's duration, UpdateIsaacPregnancy, and PlayerHUD's flash counters,
+-- layout and hearts (PlayerHUDHeart). Written against REPENTOGON's behaviour; every offset below was measured in
+-- THIS executable (v1.9.7.17) by lab_player_health_probe.lua (a diff of the player while the game did the thing,
+-- or a value written and the game's own EvaluateItems watched), and is checked again by lab_player_health.lua.
+--
+--   EntityPlayer       REPENTOGON  here    how it was measured
+--   Candy Heart ups    0x1d9c      0x1db0  six uint16 (Damage, FireDelay, TearRange, ShotSpeed, MoveSpeed, Luck): 5 written
+--                                          into each word moved exactly that stat (EvaluateItems 0x00763570 reads them
+--                                          behind HasCollectible 0x29f); a red heart pickup moved two words by 1
+--   Soul Locket ups    0x1da8      0x1dbc  the same six, behind HasCollectible 0x2ae; a soul heart pickup moved one by 1
+--   Keeper's Sack      0x1f98      0x1fbc  int; 3, 6 and 30 written with the item held raised Damage, TearRange and
+--                                          MoveSpeed (EvaluateItems)
+--   Immaculate state   0x191c      0x1930  int, +1 for every heart picked up with Immaculate Conception; birth at 15
+--   Cambion state      0x1920      0x1934  int (GetCambionPregnancyLevel 0x007c90b0 reads it)
+--   familiar flags     0x1924      0x1938  the birth functions OR the ConceptionFamiliarFlag in (0x200 after a birth)
+--   Red Stew duration  0x1e58      0x1e74  int; 600 written with Red Stew held raised Damage by 3.4 (EvaluateItems adds
+--                                          the value / 10 times a factor, only while a single player)
+--   Maggy drain        0x1ed0      0x1ef4  Tainted Magdalene: 300 on the first frame, then one fewer each frame
+--   PlayerHUD          as REPENTOGON for the first 0x10 bytes of a slot: flash counters (red, soul, gold) are the bytes
+--                      at +0xc, +0xd, +0xe (the game counts them down), then 24 hearts of 0x10 bytes from +0x10:
+--                      +0 visible, +1 eternal overlay, +2 golden overlay, +3 fading, +4 flash type, +8 and +0xc the
+--                      animation and overlay animation names (C strings)
+--   HUD::GetPlayerHUDLayout(index, player)  0x009a6570, thiscall on the HUD, ret 8 (0 for a lone player)
+--   Entity_Player::UpdateIsaacPregnancy(bool cambion)  0x007c7d70, thiscall, ret 4
+
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r16, r32, ri32, w8, w16, w32, log, call = B.ptr, B.r8, B.r16, B.r32, B.ri32, B.w8, B.w16, B.w32, B.log, B.call
+local type, tostring, pairs, ipairs, setmetatable, error, rawget = type, tostring, pairs, ipairs, setmetatable, error, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function opt_int(v, n, what, default)
+  if v == nil then return default end
+  return int_arg(v, n, what)
+end
+local function bool_arg(v, n, what)
+  if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. what .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+local P = "EntityPlayer"
+
+------------------------------------------------------------------------------
+-- plain int fields
+------------------------------------------------------------------------------
+local IMMACULATE, CAMBION, FLAMILIAR_FLAGS = 0x1930, 0x1934, 0x1938
+local KEEPERS_SACK, MAGGY_DRAIN, RED_STEW = 0x1fbc, 0x1ef4, 0x1e74
+
+method(P, "GetImmaculateConceptionState", function(self) return ri32(this(self, "GetImmaculateConceptionState") + IMMACULATE) end)
+-- clamped to 0..14 as REPENTOGON does: the game crashes on the pregnancy update with a bigger one, and 14 is the
+-- last value that still gives birth at the next heart
+method(P, "SetImmaculateConceptionState", function(self, v)
+  local p = this(self, "SetImmaculateConceptionState")
+  v = int_arg(v, 1, "SetImmaculateConceptionState")
+  if v < 0 then v = 0 elseif v > 14 then v = 14 end
+  w32(p + IMMACULATE, v)
+end)
+method(P, "GetCambionConceptionState", function(self) return ri32(this(self, "GetCambionConceptionState") + CAMBION) end)
+method(P, "SetCambionConceptionState", function(self, v)
+  w32(this(self, "SetCambionConceptionState") + CAMBION, int_arg(v, 1, "SetCambionConceptionState") & 0xffffffff)
+end)
+method(P, "GetConceptionFamiliarFlags", function(self) return ri32(this(self, "GetConceptionFamiliarFlags") + FLAMILIAR_FLAGS) end)
+method(P, "SetConceptionFamiliarFlags", function(self, v)
+  w32(this(self, "SetConceptionFamiliarFlags") + FLAMILIAR_FLAGS, int_arg(v, 1, "SetConceptionFamiliarFlags") & 0xffffffff)
+end)
+method(P, "GetKeepersSackBonus", function(self) return ri32(this(self, "GetKeepersSackBonus") + KEEPERS_SACK) end)
+method(P, "SetKeepersSackBonus", function(self, v)
+  w32(this(self, "SetKeepersSackBonus") + KEEPERS_SACK, int_arg(v, 1, "SetKeepersSackBonus") & 0xffffffff)
+end)
+method(P, "GetMaggyHealthDrainCooldown", function(self) return r32(this(self, "GetMaggyHealthDrainCooldown") + MAGGY_DRAIN) end)
+method(P, "SetMaggyHealthDrainCooldown", function(self, v)
+  w32(this(self, "SetMaggyHealthDrainCooldown") + MAGGY_DRAIN, int_arg(v, 1, "SetMaggyHealthDrainCooldown") & 0xffffffff)
+end)
+
+method(P, "GetRedStewBonusDuration", function(self) return ri32(this(self, "GetRedStewBonusDuration") + RED_STEW) end)
+method(P, "SetRedStewBonusDuration", function(self, v)
+  w32(this(self, "SetRedStewBonusDuration") + RED_STEW, int_arg(v, 1, "SetRedStewBonusDuration") & 0xffffffff)
+end)
+
+-- EntityPlayer:UpdateIsaacPregnancy(cambion): the game's own, 0x007c7d70 (true: the Cambion Conception costume,
+-- false: Immaculate Conception's)
+method(P, "UpdateIsaacPregnancy", function(self, cambion)
+  local p = this(self, "UpdateIsaacPregnancy")
+  call(0x007c7d70, p, bool_arg(cambion, 1, "UpdateIsaacPregnancy") and 1 or 0)
+end)
+
+------------------------------------------------------------------------------
+-- Candy Heart and Soul Locket stat bonuses
+------------------------------------------------------------------------------
+-- Six uint16 each, in this order; AddCandyHeartBonus(cacheFlags = 0, amount = 1) adds to every stat in cacheFlags
+-- (a random one of the six, drawn from the item's own RNG, when none is given), clamps to 0..0xffff, and has the
+-- player re-evaluate.
+do
+  local NAMES = { "Damage", "FireDelay", "TearRange", "ShotSpeed", "MoveSpeed", "Luck" }
+  local CF = rawget(_G, "CacheFlag")
+  if type(CF) ~= "table" then log("api_player_health: no CacheFlag table; the Candy Heart and Soul Locket bonuses are left out") CF = nil end
+  local FLAGS = CF and { CF.CACHE_DAMAGE, CF.CACHE_FIREDELAY, CF.CACHE_RANGE, CF.CACHE_SHOTSPEED, CF.CACHE_SPEED, CF.CACHE_LUCK }
+  local ALL = 0xffff                            -- CACHE_ALL
+  local function pair(label, base, item)
+    method(P, "Get" .. label .. "Bonus", function(self)
+      local p = this(self, "Get" .. label .. "Bonus")
+      local out = {}
+      for i = 1, 6 do out[NAMES[i]] = r16(p + base + 2 * (i - 1)) end
+      return out
+    end)
+    method(P, "Add" .. label .. "Bonus", function(self, flags, amount)
+      local p = this(self, "Add" .. label .. "Bonus")
+      flags = opt_int(flags, 1, "Add" .. label .. "Bonus", 0) & ALL
+      amount = opt_int(amount, 2, "Add" .. label .. "Bonus", 1)
+      if amount == 0 then return end
+      if flags == 0 then
+        flags = FLAGS[self:GetCollectibleRNG(item):RandomInt(6) + 1]
+      end
+      local touched = false
+      for i = 1, 6 do
+        if flags & FLAGS[i] ~= 0 then
+          local at = p + base + 2 * (i - 1)
+          local v = r16(at) + amount
+          if v < 0 then v = 0 elseif v > 0xffff then v = 0xffff end
+          w16(at, v)
+          touched = true
+        end
+      end
+      if touched then
+        self:AddCacheFlags(flags)
+        self:EvaluateItems()
+      end
+    end)
+  end
+  if FLAGS then
+    pair("CandyHeart", 0x1db0, 671)
+    pair("SoulLocket", 0x1dbc, 686)
+  end
+end
+
+------------------------------------------------------------------------------
+-- PlayerHUD: flash counters, layout, hearts; PlayerHUDHeart
+------------------------------------------------------------------------------
+local H = T.playerhud_methods
+if type(H) ~= "table" then
+  log("api_player_health: api_more.lua did not hand out PlayerHUD's methods; the PlayerHUD names are left out")
+else
+  local function at(self, what)
+    local p = ptr(self)
+    if p == 0 then error("rgon: PlayerHUD:" .. what .. " called without its object (use ':')", 3) end
+    return p
+  end
+  local FLASH = { Red = 0xc, Soul = 0xd, Gold = 0xe }
+  for kind, off in pairs(FLASH) do
+    H["GetFlash" .. kind .. "Hearts"] = function(self)
+      local v = r8(at(self, "GetFlash" .. kind .. "Hearts") + off)
+      return v >= 0x80 and v - 0x100 or v
+    end
+    H["SetFlash" .. kind .. "Hearts"] = function(self, frames)
+      local p = at(self, "SetFlash" .. kind .. "Hearts")
+      frames = opt_int(frames, 1, "SetFlash" .. kind .. "Hearts", 4)
+      if frames < 0 then frames = 0 elseif frames > 127 then frames = 127 end
+      w8(p + off, frames)
+    end
+    R.Implemented["PlayerHUD.GetFlash" .. kind .. "Hearts"] = true
+    R.Implemented["PlayerHUD.SetFlash" .. kind .. "Hearts"] = true
+  end
+
+  -- PlayerHUD:GetLayout() -> PlayerHUDLayout (0 normal, 1 Jacob and Esau, 2 compact, 3 J&E compact)
+  H.GetLayout = function(self)
+    local p = at(self, "GetLayout")
+    local hud = ptr(Game():GetHUD())
+    local player = r32(p)
+    return call(0x009a6570, hud, B.r16(p + 8), player) & 0xffffffff
+  end
+  R.Implemented["PlayerHUD.GetLayout"] = true
+
+  -- PlayerHUDHeart: a copy of the heart's 0x10 bytes (as REPENTOGON hands out copies), animation names read
+  -- when it is made
+  local HEART = {}
+  local function bit(self, i) return self[i] ~= 0 end
+  function HEART:IsVisible() return bit(self, 1) end
+  function HEART:IsEternalHeartOverlayVisible() return bit(self, 2) end
+  function HEART:IsGoldenHeartOverlayVisible() return bit(self, 3) end
+  function HEART:IsFadingHeart() return bit(self, 4) end
+  function HEART:GetFlashType()
+    local v = self[5]
+    return v >= 0x80 and v - 0x100 or v
+  end
+  function HEART:GetHeartAnim() return self[6] end
+  function HEART:GetHeartOverlayAnim() return self[7] end
+  local HEART_MT = { __index = HEART, __name = "PlayerHUDHeart", __type = "PlayerHUDHeart",
+    __tostring = function(self) return "PlayerHUDHeart(" .. tostring(self[6]) .. ")" end }
+  for k in pairs(HEART) do R.Implemented["PlayerHUDHeart." .. k] = true end
+
+  local function str_at(a)
+    if a == 0 then return nil end
+    return B.str(a)
+  end
+  local function heart(p, i)
+    local h = p + 0x10 + 0x10 * i
+    return setmetatable({ r8(h), r8(h + 1), r8(h + 2), r8(h + 3), r8(h + 4), str_at(r32(h + 8)), str_at(r32(h + 0xc)) }, HEART_MT)
+  end
+  H.GetHeartByIndex = function(self, index)
+    local p = at(self, "GetHeartByIndex")
+    index = int_arg(index, 1, "GetHeartByIndex")
+    if index < 0 or index > 23 then error("Invalid index: " .. index, 2) end
+    return heart(p, index)
+  end
+  H.GetHearts = function(self)
+    local p = at(self, "GetHearts")
+    local out = {}
+    for i = 0, 23 do out[i + 1] = heart(p, i) end
+    return out
+  end
+  R.Implemented["PlayerHUD.GetHeartByIndex"] = true
+  R.Implemented["PlayerHUD.GetHearts"] = true
+end
diff --git a/scripts/recomp/rgon/api_player_items.lua b/scripts/recomp/rgon/api_player_items.lua
new file mode 100644
index 0000000..3932fd4
--- /dev/null
+++ b/scripts/recomp/rgon/api_player_items.lua
@@ -0,0 +1,382 @@
+-- api_player_items.lua -- the rest of EntityPlayer that Fiend Folio and Epiphany reach (charges, the bladder and
+-- urethra, Suplex!, costumes, item wisps, twins' helpers), CostumeSpriteDesc, and the PlayerManager queries.
+-- Written against REPENTOGON's behaviour (its LuaEntityPlayer.cpp, LuaCostumeSpriteDesc.cpp, LuaPlayerManager.cpp);
+-- every offset and address below was measured in THIS executable (v1.9.7.17) -- REPENTOGON's are for v1.9.7.12 and the
+-- player grew by 4, 8, 12, 20, 28 and 36 bytes along the way (api_player.lua). The player's data after 0x1811 and
+-- before the Immaculate counter moved by +20 (both ends measured: CanShoot, Immaculate 0x1930); after Red Stew by +36
+-- (Maggy's drain, Keeper's Sack, the wisp map).
+--
+--   EntityPlayer            REPENTOGON  here    how it was measured
+--   Metronome item          0x1388      0x1388  Entity_Player::HasCollectible (0x007706e0) compares the asked item with it at
+--                                               0x00770c21; GetCollectibleNum (0x00770ca0) reads it at 0x007710a3
+--   held entity             0x140c      0x1410  TryForgottenThrow (0x007dac80) compares it at 0x007daca5; read-back after the
+--                                               game's own TryHoldEntity (lab_player_items.lua)
+--   R U a Wizard timer      0x1458      0x145c  the update (0x00794e50) counts it down at 0x0079e561..0x0079e56e
+--   Pony charge             0x1874      0x1888  the item-use switch (0x005b39d0) sets it to 60 at 0x005b5609
+--   Plan C kill countdown   0x1878      0x188c  the item-use switch sets it to 300 at 0x005bdf92, the update counts it down
+--   Dead Eye charge         0x189c      0x18b0  ClearDeadEyeCharge (0x007c78e0) tests and zeroes it at 0x007c78e5..0x007c7943
+--   pee burst cooldown      0x18e4      0x18f8  the initialiser (0x00755f0a) writes it, EvaluateItems (0x00763570) reads it at
+--   max pee burst           0x18e8      0x18fc    0x00765418 and 0x00765422 (the pair: max starts at 30 = 0x1e)
+--   bladder charge          0x18ec      0x1900  all four are set by the initialiser at 0x00755f1a..0x00755f2c and used by the
+--   max bladder charge      0x18f0      0x1904    Kidney Stone code in 0x0077b020 (0x0077c133..0x0077c1e5: 180 is written into
+--   urethra blocked         0x18f4      0x1908    the pee fields when it fires)
+--   next urethra block      0x18f8      0x190c
+--   suplex state            0x1f08      0x1f2c  the initialiser (0x0075748d..0x00757509): int 0, int 0, two Vectors from the
+--   suplex aim countdown    0x1f0c      0x1f30    constants 0xc7b640/44 (0,0 and -1,-1?), then the 8 bag-of-crafting bytes
+--   suplex target position  0x1f10      0x1f34    (0x1f44), the bag output (0x1f4c) and the poop mana (0x1f54): the same
+--   suplex land position    0x1f18      0x1f3c    order as REPENTOGON's, +36
+--   poop spell queue        0x1f34      0x1f58  six bytes; the game's own shuffle on use (0x00780f40) moves them down and
+--                                               calls 0x007d6670, which fills the empty last slot
+--   Eve's Sumptorium        0x1f58      0x1f7c  zeroed by the initialiser at 0x0075755b
+--   item wisp map           0x1f5c      0x1f80  std::map<int,int>, the one HasCollectible reads (api_innate.lua)
+--   costume vector          0x1220      0x1220  AddCostume (0x0075d1d0) and RemoveCostume (0x0075d850) walk it, stride 0x130
+--   costume layer map       0x122c      0x122c  15 x { index, layerID, priority, byte isBodyLayer }, 0x10 each: the reset
+--                                               at 0x0075dfe0 fills them with -1, -1, 0, and 1 for layers 0..3 and 11
+--   afterimage deque        0x1e38      0x1e54  std::deque of { int duration, Vector pos } (12 bytes); the update pushes into
+--                                               it with 0x007dc740 (thiscall, ecx = the deque, one stack word = the element)
+--   game functions called
+--   Isaac::SpawnLocust(player ecx, collectible edx, Vector* pos)            0x005b35c0
+--   Entity_Player::InitPostLevelInitStats()                                  0x007bc740   (api_hooks.lua hooks it)
+--   Entity_Player::TryAddToBagOfCrafting(EntityPickup*) -> bool             0x007d5170   (lab_eid_probe.lua)
+--   Entity_Player::IncrementPlayerFormCounter(form, count)                   0x0075e320   thiscall, two stack words
+--   Entity_Player::GetTotalActiveCharge(slot) -> int                         0x007910f0   thiscall, one stack word
+--   Entity_Player::CheckPoopSpellQueue()                                     0x007d6670   thiscall
+--   deque<AfterImageFrame>::push_back(const T&)                              0x007dc740   thiscall, one stack word
+
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.log, B.call
+local type, tostring, pairs, ipairs, setmetatable, getmetatable, error, rawget = type, tostring, pairs, ipairs, setmetatable, getmetatable, error, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function opt_int(v, n, what, default)
+  if v == nil then return default end
+  return int_arg(v, n, what)
+end
+local function bool_arg(v, n, what)
+  if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. what .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function signed(v) if v >= 0x80000000 then return v - 0x100000000 end return v end
+
+local P = "EntityPlayer"
+
+------------------------------------------------------------------------------
+-- plain int fields
+------------------------------------------------------------------------------
+local function int_pair(getname, setname, off)
+  if getname then
+    method(P, getname, function(self) return ri32(this(self, getname) + off) end)
+  end
+  if setname then
+    method(P, setname, function(self, v)
+      w32(this(self, setname) + off, int_arg(v, 1, setname) & 0xffffffff)
+    end)
+  end
+end
+
+int_pair("GetRUAWizardTimer", "SetRUAWizardTimer", 0x145c)
+int_pair("GetMetronomeCollectibleID", nil, 0x1388)
+int_pair("GetPonyCharge", "SetPonyCharge", 0x1888)
+int_pair("GetPlanCKillCountdown", "SetPlanCKillCountdown", 0x188c)
+int_pair("GetDeadEyeCharge", nil, 0x18b0)
+int_pair("GetPeeBurstCooldown", nil, 0x18f8)
+int_pair("GetMaxPeeBurstCooldown", nil, 0x18fc)
+int_pair("GetBladderCharge", "SetBladderCharge", 0x1900)
+int_pair("GetMaxBladderCharge", "SetMaxBladderCharge", 0x1904)
+int_pair("GetNextUrethraBlockFrame", "SetNextUrethraBlockFrame", 0x190c)
+int_pair("GetEveSumptoriumCharge", "SetEveSumptoriumCharge", 0x1f7c)
+
+method(P, "IsUrethraBlocked", function(self) return r8(this(self, "IsUrethraBlocked") + 0x1908) ~= 0 end)
+method(P, "SetUrethraBlock", function(self, v)
+  w8(this(self, "SetUrethraBlock") + 0x1908, bool_arg(v, 1, "SetUrethraBlock") and 1 or 0)
+end)
+
+-- the entity the player holds over their head (a lifted bomb, Suplex!'s victim); nil when none
+method(P, "GetHeldEntity", function(self)
+  local e = r32(this(self, "GetHeldEntity") + 0x1410)
+  if e == 0 then return nil end
+  return wrap("Entity", e)
+end)
+
+------------------------------------------------------------------------------
+-- Suplex!
+------------------------------------------------------------------------------
+do
+  local STATE, AIM, TARGET, LAND = 0x1f2c, 0x1f30, 0x1f34, 0x1f3c
+  int_pair("GetSuplexState", "SetSuplexState", STATE)
+  int_pair("GetSuplexAimCountdown", "SetSuplexAimCountdown", AIM)
+  local function vec_pair(getname, setname, off)
+    method(P, getname, function(self)
+      local p = this(self, getname)
+      return Vector(rf32(p + off), rf32(p + off + 4))
+    end)
+    method(P, setname, function(self, v)
+      local p = this(self, setname)
+      if type(v) ~= "userdata" and type(v) ~= "table" or v.X == nil then
+        error("bad argument #1 to '" .. setname .. "' (Vector expected, got " .. type(v) .. ")", 2)
+      end
+      wf32(p + off, v.X)
+      wf32(p + off + 4, v.Y)
+    end)
+  end
+  vec_pair("GetSuplexTargetPosition", "SetSuplexTargetPosition", TARGET)
+  vec_pair("GetSuplexLandPosition", "SetSuplexLandPosition", LAND)
+end
+
+------------------------------------------------------------------------------
+-- item wisps: { [collectible] = number of wisps }, from the player's own std::map<int,int>
+------------------------------------------------------------------------------
+-- MSVC's map: the object holds the head node (+0) and the size (+4); a node is left (+0), parent (+4), right (+8),
+-- colour byte (+0xc), isnil byte (+0xd), then the key (+0x10) and the value (+0x14). The head's parent is the root.
+method(P, "GetWispCollectiblesList", function(self)
+  local map = this(self, "GetWispCollectiblesList") + 0x1f80
+  local head = r32(map)
+  local out, n = {}, 0
+  if head == 0 then return out end
+  local function walk(node, depth)
+    if node == 0 or r8(node + 0xd) ~= 0 or depth > 64 then return end
+    walk(r32(node), depth + 1)
+    n = n + 1
+    if n > 4096 then error("rgon: the item wisp map is not laid out as expected", 3) end
+    out[ri32(node + 0x10)] = ri32(node + 0x14)
+    walk(r32(node + 8), depth + 1)
+  end
+  walk(r32(head + 4), 0)
+  return out
+end)
+
+------------------------------------------------------------------------------
+-- costumes
+------------------------------------------------------------------------------
+local COSTUMES, COSTUME_MAP, CSD_SIZE = 0x1220, 0x122c, 0x130
+
+-- GetCostumeLayerMap() -> 15 rows { costumeIndex, layerID, priority, isBodyLayer }
+method(P, "GetCostumeLayerMap", function(self)
+  local m = this(self, "GetCostumeLayerMap") + COSTUME_MAP
+  local out = {}
+  for i = 0, 14 do
+    local a = m + 0x10 * i
+    out[i + 1] = { costumeIndex = ri32(a), layerID = ri32(a + 4), priority = ri32(a + 8), isBodyLayer = r8(a + 0xc) ~= 0 }
+  end
+  return out
+end)
+
+-- CostumeSpriteDesc: the costume the player wears for an item, in the vector at +0x1220 (0x130 bytes each)
+do
+  local CSD = {}
+  CSD.__index = CSD
+  CSD.__type = "CostumeSpriteDesc"
+  local function at(self) return rawget(self, "_a") end
+  function CSD:GetSprite()
+    return B.obj(getmetatable(Sprite()), at(self), T.vt_ptr())
+  end
+  function CSD:GetItemConfig()
+    local item = r32(at(self) + 0x114)
+    if item == 0 then return nil end
+    local kind, id = ri32(item), ri32(item + 4)
+    local cfg = Isaac.GetItemConfig()
+    if kind == ItemType.ITEM_TRINKET then return cfg:GetTrinket(id) end
+    if kind == ItemType.ITEM_NULL then return cfg:GetNullItem(id) end
+    return cfg:GetCollectible(id)
+  end
+  function CSD:GetPriority() return ri32(at(self) + 0x118) end
+  function CSD:IsItemAnimPlaying() return r8(at(self) + 0x11c) ~= 0 end
+  function CSD:IsFlying() return r8(at(self) + 0x11d) ~= 0 end
+  function CSD:HasOverlay() return r8(at(self) + 0x11e) ~= 0 end
+  function CSD:HasSkinAlt() return r8(at(self) + 0x11f) ~= 0 end
+  function CSD:GetDefaultSkinColor() return ri32(at(self) + 0x120) end
+  function CSD:GetSkinColor() return ri32(at(self) + 0x124) end
+  CSD.GetHeadColor = CSD.GetDefaultSkinColor   -- REPENTOGON's old names for the two colours
+  CSD.GetBodyColor = CSD.GetSkinColor
+  function CSD:CanOverwriteColor() return r8(at(self) + 0x128) ~= 0 end
+  function CSD:IsItemStateOnly() return r8(at(self) + 0x129) ~= 0 end
+  function CSD:GetPlayerType() return ri32(at(self) + 0x12c) end
+  for name in pairs(CSD) do
+    if name:sub(1, 2) ~= "__" then R.Implemented["CostumeSpriteDesc." .. name] = true end
+  end
+  T.CostumeSpriteDesc = CSD
+
+  method(P, "GetCostumeSpriteDescs", function(self)
+    local p = this(self, "GetCostumeSpriteDescs")
+    local first, last = r32(p + COSTUMES), r32(p + COSTUMES + 4)
+    local bytes = last - first
+    if first == 0 or bytes < 0 or bytes % CSD_SIZE ~= 0 or bytes // CSD_SIZE > 256 then
+      error("rgon: the player's costume vector is not laid out as expected", 2)
+    end
+    local out = {}
+    for i = 0, bytes // CSD_SIZE - 1 do out[i + 1] = setmetatable({ _a = first + CSD_SIZE * i }, CSD) end
+    return out
+  end)
+end
+
+-- the player's own configuration (EntityConfig.GetPlayer of the player's type)
+method(P, "GetEntityConfigPlayer", function(self)
+  this(self, "GetEntityConfigPlayer")
+  return EntityConfig.GetPlayer(self:GetPlayerType())
+end)
+
+------------------------------------------------------------------------------
+-- the game's own functions
+------------------------------------------------------------------------------
+-- AddLocust(collectible, position): the locust (a Locust of Conquest and its kin) for that item at the position
+method(P, "AddLocust", function(self, collectible, pos)
+  local p = this(self, "AddLocust")
+  collectible = int_arg(collectible, 1, "AddLocust")
+  if (type(pos) ~= "userdata" and type(pos) ~= "table") or pos.X == nil then
+    error("bad argument #2 to 'AddLocust' (Vector expected, got " .. type(pos) .. ")", 2)
+  end
+  local buf = B.alloc(8)
+  wf32(buf, pos.X)
+  wf32(buf + 4, pos.Y)
+  call(0x005b35c0, { ecx = p, edx = collectible }, buf)
+  B.free(buf)
+end)
+
+-- InitPostLevelInitStats(): the character's starting cards, pills and tear flags that a floor's first update gives
+method(P, "InitPostLevelInitStats", function(self) call(0x007bc740, this(self, "InitPostLevelInitStats")) end)
+
+-- TryAddToBagOfCrafting(pickup) -> bool
+method(P, "TryAddToBagOfCrafting", function(self, pickup)
+  local p = this(self, "TryAddToBagOfCrafting")
+  local a = ptr(pickup)
+  if a == 0 then error("bad argument #1 to 'TryAddToBagOfCrafting' (EntityPickup expected)", 2) end
+  return (call(0x007d5170, p, a) & 0xff) ~= 0
+end)
+
+-- IncrementPlayerFormCounter(form, count): count may be negative; the game's own clamps at 0 and starts or ends the
+-- transformation when the counter crosses 3
+method(P, "IncrementPlayerFormCounter", function(self, form, count)
+  local p = this(self, "IncrementPlayerFormCounter")
+  form = int_arg(form, 1, "IncrementPlayerFormCounter")
+  count = int_arg(count, 2, "IncrementPlayerFormCounter")
+  if form < 0 or form > 14 then error("Invalid PlayerForm " .. form, 2) end
+  call(0x0075e320, p, form, count & 0xffffffff)
+end)
+
+-- GetTotalActiveCharge(slot): charge + battery charge (+ the soul or blood charge of Bethany and Tainted Bethany)
+method(P, "GetTotalActiveCharge", function(self, slot)
+  local p = this(self, "GetTotalActiveCharge")
+  slot = int_arg(slot, 1, "GetTotalActiveCharge")
+  if slot < 0 or slot > 3 then return 0 end
+  return signed(call(0x007910f0, p, slot))
+end)
+
+-- CreateAfterimage(duration, position): an afterimage of the player that fades over `duration` frames (A Pony, Mars)
+method(P, "CreateAfterimage", function(self, duration, pos)
+  local p = this(self, "CreateAfterimage")
+  duration = int_arg(duration, 1, "CreateAfterimage")
+  if (type(pos) ~= "userdata" and type(pos) ~= "table") or pos.X == nil then
+    error("bad argument #2 to 'CreateAfterimage' (Vector expected, got " .. type(pos) .. ")", 2)
+  end
+  local el = B.alloc(12)
+  w32(el, duration & 0xffffffff)
+  wf32(el + 4, pos.X)
+  wf32(el + 8, pos.Y)
+  call(0x007dc740, { ecx = p + 0x1e54 }, el)
+  B.free(el)
+end)
+
+-- RemovePoopSpell(position = 0): the spell leaves the queue (six slots), the rest move forward, and the game fills the
+-- last slot with a new one
+method(P, "RemovePoopSpell", function(self, pos)
+  local p = this(self, "RemovePoopSpell")
+  pos = opt_int(pos, 1, "RemovePoopSpell", 0)
+  if pos < 0 or pos > 5 then error("bad argument #1 to 'RemovePoopSpell' (Invalid Poop Spell queue position)", 2) end
+  local q = p + 0x1f58
+  for i = pos, 4 do w8(q + i, r8(q + i + 1)) end
+  w8(q + 5, 0)
+  call(0x007d6670, p)
+end)
+
+-- GetErrorTrinketEffect(): the trinket the Error trinket mimics in this room (from the room's SpawnSeed; the room is
+-- the one the player is in). TRINKET_ERROR when the room has no seed.
+method(P, "GetErrorTrinketEffect", function(self)
+  this(self, "GetErrorTrinketEffect")
+  local seed = Game():GetLevel():GetCurrentRoomDesc().SpawnSeed
+  if seed == 0 then return TrinketType.TRINKET_ERROR end
+  seed = seed & 0xffffffff
+  seed = (seed >> 2) ~ seed
+  seed = ((seed << 7) & 0xffffffff) ~ seed
+  seed = (seed >> 25) ~ seed
+  return seed % (TrinketType.NUM_TRINKETS - 1) + 1
+end)
+
+-- CanOverrideActiveItem(slot): the slot is empty, or holds only Book of Virtues or Judas' Birthright's Book of Belial
+method(P, "CanOverrideActiveItem", function(self, slot)
+  this(self, "CanOverrideActiveItem")
+  slot = int_arg(slot, 1, "CanOverrideActiveItem")
+  if slot < 0 or slot > 3 then return false end
+  local item = self:GetActiveItem(slot)
+  if item == 0 or item == CollectibleType.COLLECTIBLE_BOOK_OF_VIRTUES then return true end
+  return item == CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL and self:GetPlayerType() == PlayerType.PLAYER_JUDAS
+    and self:HasCollectible(CollectibleType.COLLECTIBLE_BIRTHRIGHT, true)
+end)
+
+------------------------------------------------------------------------------
+-- PlayerManager: queries over the players of the run
+------------------------------------------------------------------------------
+do
+  local PM = rawget(_G, "PlayerManager")
+  if type(PM) ~= "table" then
+    log("api_player_items: no PlayerManager table; the owner queries are left out")
+  else
+    local function players()
+      local out, g = {}, Game()
+      for i = 0, g:GetNumPlayers() - 1 do out[#out + 1] = g:GetPlayer(i) end
+      return out
+    end
+    local function add(name, f)
+      if rawget(PM, name) ~= nil then log("PlayerManager." .. name .. " already exists; left alone") return end
+      rawset(PM, name, f)
+      R.Implemented["PlayerManager." .. name] = true
+    end
+    local function pick(list, seed, rng_of)
+      if #list == 0 then return nil end
+      local rng = RNG()
+      rng:SetSeed(seed ~= 0 and seed or 1, 35)
+      local who = list[rng:RandomInt(#list) + 1]
+      return who, rng_of(who)
+    end
+    add("AnyPlayerTypeHasCollectible", function(playerType, id, ignoreModifiers)
+      playerType, id = int_arg(playerType, 1, "AnyPlayerTypeHasCollectible"), int_arg(id, 2, "AnyPlayerTypeHasCollectible")
+      for _, p in ipairs(players()) do
+        if p:GetPlayerType() == playerType and p:HasCollectible(id, ignoreModifiers == true) then return true end
+      end
+      return false
+    end)
+    add("AnyPlayerTypeHasTrinket", function(playerType, id, ignoreModifiers)
+      playerType, id = int_arg(playerType, 1, "AnyPlayerTypeHasTrinket"), int_arg(id, 2, "AnyPlayerTypeHasTrinket")
+      for _, p in ipairs(players()) do
+        if p:GetPlayerType() == playerType and p:HasTrinket(id, ignoreModifiers == true) then return true end
+      end
+      return false
+    end)
+    -- the first player of that type who holds Birthright for real
+    add("FirstBirthrightOwner", function(playerType)
+      playerType = int_arg(playerType, 1, "FirstBirthrightOwner")
+      for _, p in ipairs(players()) do
+        if p:GetPlayerType() == playerType and p:HasCollectible(CollectibleType.COLLECTIBLE_BIRTHRIGHT, true) then return p end
+      end
+      return nil
+    end)
+    -- a player who holds it, drawn with the seed, and that player's RNG for it; both nil when nobody holds it
+    add("GetRandomCollectibleOwner", function(id, seed)
+      id, seed = int_arg(id, 1, "GetRandomCollectibleOwner"), int_arg(seed, 2, "GetRandomCollectibleOwner")
+      local owners = {}
+      for _, p in ipairs(players()) do if p:HasCollectible(id) then owners[#owners + 1] = p end end
+      return pick(owners, seed, function(p) return p:GetCollectibleRNG(id) end)
+    end)
+    add("GetRandomTrinketOwner", function(id, seed)
+      id, seed = int_arg(id, 1, "GetRandomTrinketOwner"), int_arg(seed, 2, "GetRandomTrinketOwner")
+      local owners = {}
+      for _, p in ipairs(players()) do if p:HasTrinket(id) then owners[#owners + 1] = p end end
+      return pick(owners, seed, function(p) return p:GetTrinketRNG(id) end)
+    end)
+  end
+end
diff --git a/scripts/recomp/rgon/api_pocket_item.lua b/scripts/recomp/rgon/api_pocket_item.lua
new file mode 100644
index 0000000..a7e598c
--- /dev/null
+++ b/scripts/recomp/rgon/api_pocket_item.lua
@@ -0,0 +1,55 @@
+-- api_pocket_item.lua -- census batch 3 (M8): EntityPlayer:GetPocketItem(slot) and the PocketItem class
+-- (GetSlot, GetType), with REPENTOGON's semantics (LuaPocketItem.cpp): the object is a view of the game's own
+-- PocketItem record, two words {id, type}, handed out by Entity_Player::GetPocketItem (0x00753900, the one
+-- match of REPENTOGON's signature in this exe; thiscall, `ret 4`, it clamps the slot to 0..3). GetSlot answers
+-- the id word and GetType the type word, read live each time, so a handle shows later changes like the pointer
+-- REPENTOGON hands out.
+--
+-- Measured in this build (lab_pocket_probe.lua, then lab_pocket_test.lua):
+--   empty slot      {0, 1}   (a fresh slot) or {0, 0} (a slot a pill or card left) : GetType is unreliable then
+--   card            {card id, 1}      pill  {pill colour, 0}
+--   pocket active   {ActiveSlot + 1, 2}: SLOT_POCKET gives 3, SLOT_POCKET2 gives 4 (the first pocket slot holds
+--                   the pocket active, a card goes to the next slot)
+--   a removed pocket active leaves its {3, 2} behind until the slot is reused (the game does not clear it)
+-- These are the documented values (PocketItem.md: ActiveSlot+1 for pocket actives, 0 when empty).
+-- Epiphany's throwable_item_lib.lua:727 depends on it: `player:GetPocketItem(PillCardSlot.PRIMARY):GetSlot() - 1`.
+
+local T = ...
+local B, R, this = T.B, T.R, T.this
+local ri32, call = B.ri32, B.call
+local type, setmetatable, getmetatable = type, setmetatable, getmetatable
+local mathtype = math.type
+
+do
+  local PI = {}
+  local MT = { __index = PI, __type = "PocketItem", __name = "PocketItem", __metatable = nil }
+  MT.__tostring = function(self) return string.format("PocketItem(0x%x)", self[1]) end
+  MT.__eq = function(a, b) return getmetatable(b) == MT and a[1] == b[1] end
+  local function at(self, what)
+    if getmetatable(self) ~= MT then error("bad argument #1 to '" .. what .. "' (PocketItem expected, got " .. type(self) .. ")", 3) end
+    return self[1]
+  end
+  function PI:GetSlot() return ri32(at(self, "GetSlot")) end
+  function PI:GetType() return ri32(at(self, "GetType") + 4) end
+  for k in pairs(PI) do R.Implemented["PocketItem." .. k] = true end
+  T.PocketItem = { MT = MT }
+
+  -- The game already has an EntityPlayer:GetPocketItem; it answers a bare userdata with no methods (indexing it
+  -- is the error "attempt to index a userdata value"). REPENTOGON lists it as a "modified function", so the
+  -- layer's one takes its place (`method` would leave the game's alone).
+  local function get_pocket_item(self, slot)
+    local p = this(self, "GetPocketItem")
+    if mathtype(slot) == "float" and slot == math.floor(slot) then slot = math.tointeger(slot) end
+    if mathtype(slot) ~= "integer" then error("bad argument #1 to 'GetPocketItem' (number expected, got " .. type(slot) .. ")", 2) end
+    return setmetatable({ call(0x00753900, p, slot & 0xffffffff) }, MT)
+  end
+  local c, const = T.class_tables("EntityPlayer")
+  if c then
+    local wrapped = B.cfn(get_pocket_item)
+    rawset(c, "GetPocketItem", wrapped)
+    if const and const ~= c and rawget(const, "GetPocketItem") ~= nil then rawset(const, "GetPocketItem", wrapped) end
+    R.Implemented["EntityPlayer.GetPocketItem"] = true
+  else
+    B.log("api_pocket_item: no EntityPlayer class; GetPocketItem is left as the game has it")
+  end
+end
