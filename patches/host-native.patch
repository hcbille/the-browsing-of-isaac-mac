+    end
+
+    -- MC_GRID_HURT_DAMAGE (1012): (grid, entity, playerDamage, damageFlags, enemyDamage, ignoreGridCollisionClass), param = the grid
+    -- type; REPENTOGON skips the grid's damage on any boolean answer (its documentation says false). MC_POST_GRID_HURT_DAMAGE (1013):
+    -- the same arguments, after it. GridEntity::hurt_func(ent, playerDamage, u64 flags, ignore) 0x00709fb0, ret 0x14, the enemy
+    -- damage in xmm2.
+    local HURT, HURT_POST = M.MC_GRID_HURT_DAMAGE, M.MC_POST_GRID_HURT_DAMAGE
+    if HURT and HURT_POST then
+      on("GridEntity::hurt_func", { HURT, HURT_POST }, function(self, esp)
