+-- api_pickup_more.lua -- chunk 4: the rest of EntityPickup, Room:GetShopItemPrice, LootList / LootListEntry, and the
+-- ItemPool names (HasCollectible, HasTrinket, PickCollectible, AddCollectible, ...). Written against REPENTOGON's
+-- behaviour (LuaEntityPickup.cpp, LuaLootList.cpp, LuaItemPool.cpp); every address and offset below was found in THIS
+-- executable (v1.9.7.17) and read back by lab_pickup_probe.lua / lab_pickup_more.lua.
+--
+-- EntityPickup, the game's own functions (all thiscall, ecx = the pickup):
+--   0x006e1910 TryInitOptionCycle(num) `ret 4`, bool in AL     0x006eed30 SetNewOptionsPickupIndex, the index in EAX
+--   0x006ee750 TriggerTheresOptionsPickup                       0x006eea30 MakeShopItem(shopId) `ret 4`
+--   0x006ed580 TryRemoveCollectible, bool in AL                 0x006e17c0 UpdatePickupGhosts
+--   0x006e21f0 ReloadGraphics(ignoreBlind) `ret 4`              0x006ee3f0 CanJeraDuplicate, bool in AL
+--   0x006e1e90 SetupCollectibleGraphics: static, ecx = the ANM2, edx = layer, stack (id, seed, blind byte)
+--   0x005b19b0 GetRandomPickupVelocity: ecx = out Vector*, edx = position Vector*, stack (rng*, velType)
+--   0x006dae40 Pickup::GetLootList: ecx = the pickup, stack (return deque*, shouldAdvance, player*)
+-- Fields (offsets from the pickup): 0x410 price sprite, 0x554 drop delay, 0x590 pickup ghost (an Entity_Effect*),
+-- 0x594/0x598 mega chest collectibles, 0x59c var data, 0x5a0 cycle list (8 words), 0x5c0 its count, 0x5c8 flip record.
+local T = ...
+local B, R, method, static, wrap, this = T.B, T.R, T.method, T.static, T.wrap, T.this
+local r8, r32, ri32, rf32, w8, w32, wf32, call, log = B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call, B.log
+local type, error, setmetatable, getmetatable, rawget, rawset, tostring, ipairs, pairs, pcall = type, error, setmetatable, getmetatable, rawget, rawset, tostring, ipairs, pairs, pcall
+local mathtype = math.type
+
+local function argerr(n, fname, want, got)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. type(got) .. ")", 3)
+end
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  argerr(n, fname, "integer", v)
+end
+local function signed(v) return v >= 0x80000000 and v - 0x100000000 or v end
+
+local P_PRICE_ANM, P_DROP_DELAY, P_GHOST, P_MEGA_L, P_MEGA_R, P_VARDATA = 0x410, 0x554, 0x590, 0x594, 0x598, 0x59c
+local P_CYCLE, P_CYCLE_COUNT, P_FLIP = 0x5a0, 0x5c0, 0x5c8
+
+------------------------------------------------------------------------------
+-- EntityPickup: fields
+------------------------------------------------------------------------------
+method("EntityPickup", "GetVarData", function(self) return ri32(this(self, "GetVarData") + P_VARDATA) end)
+method("EntityPickup", "SetVarData", function(self, v)
+  w32(this(self, "SetVarData") + P_VARDATA, int_arg(v, 1, "SetVarData") & 0xffffffff)
+end)
+method("EntityPickup", "GetDropDelay", function(self) return ri32(this(self, "GetDropDelay") + P_DROP_DELAY) end)
+method("EntityPickup", "SetDropDelay", function(self, v)
+  w32(this(self, "SetDropDelay") + P_DROP_DELAY, int_arg(v, 1, "SetDropDelay") & 0xffffffff)
+end)
+
+method("EntityPickup", "AddCollectibleCycle", function(self, id)
+  local p = this(self, "AddCollectibleCycle")
+  id = int_arg(id, 1, "AddCollectibleCycle")
+  if r32(p + 0x2c) ~= 100 then return false end
+  local n = r32(p + P_CYCLE_COUNT)
+  if n >= 8 or Isaac.GetItemConfig():GetCollectible(id) == nil then return false end
+  w32(p + P_CYCLE + 4 * n, id & 0xffffffff)
+  w32(p + P_CYCLE_COUNT, n + 1)
+  return true
+end)
+method("EntityPickup", "RemoveCollectibleCycle", function(self)
+  local p = this(self, "RemoveCollectibleCycle")
+  for i = 0, 7 do w32(p + P_CYCLE + 4 * i, 0) end
+  w32(p + P_CYCLE_COUNT, 0)
+end)
+
+method("EntityPickup", "HasFlipData", function(self)
+  local p = this(self, "HasFlipData")
+  return r32(p + 0x2c) == 100 and r32(p + P_FLIP) ~= 0
+end)
+
+method("EntityPickup", "GetPickupGhost", function(self)
+  local g = r32(this(self, "GetPickupGhost") + P_GHOST)
+  if g == 0 then return nil end
+  return wrap("EntityEffect", g)
+end)
+
+method("EntityPickup", "GetPriceSprite", function(self)
+  local p = this(self, "GetPriceSprite")
+  return B.obj(getmetatable(self:GetSprite()), p + P_PRICE_ANM, T.vt_ptr())
+end)
+
+------------------------------------------------------------------------------
+-- EntityPickup: the game's own functions
+------------------------------------------------------------------------------
+method("EntityPickup", "TryInitOptionCycle", function(self, n)
+  local p = this(self, "TryInitOptionCycle")
+  n = int_arg(n, 1, "TryInitOptionCycle")
+  return (call(0x006e1910, p, n) & 0xff) ~= 0
+end)
+method("EntityPickup", "SetNewOptionsPickupIndex", function(self)
+  return signed(call(0x006eed30, this(self, "SetNewOptionsPickupIndex")))
+end)
+method("EntityPickup", "TriggerTheresOptionsPickup", function(self)
+  call(0x006ee750, this(self, "TriggerTheresOptionsPickup"))
+end)
+method("EntityPickup", "MakeShopItem", function(self, id)
+  call(0x006eea30, this(self, "MakeShopItem"), int_arg(id, 1, "MakeShopItem"))
+end)
+method("EntityPickup", "TryRemoveCollectible", function(self)
+  return (call(0x006ed580, this(self, "TryRemoveCollectible")) & 0xff) ~= 0
+end)
+method("EntityPickup", "UpdatePickupGhosts", function(self)
+  call(0x006e17c0, this(self, "UpdatePickupGhosts"))
+end)
+method("EntityPickup", "ReloadGraphics", function(self, ignoreBlind)
+  call(0x006e21f0, this(self, "ReloadGraphics"), ignoreBlind and 1 or 0)
+end)
+method("EntityPickup", "CanJeraDuplicate", function(self)
+  return (call(0x006ee3f0, this(self, "CanJeraDuplicate")) & 0xff) ~= 0
+end)
+
+------------------------------------------------------------------------------
+-- Room:GetShopItemPrice(variant, subtype, shopItemId) -> integer
+------------------------------------------------------------------------------
+method("Room", "GetShopItemPrice", function(self, variant, subtype, shopId)
+  local rp = this(self, "GetShopItemPrice")
+  return signed(call(0x008151e0, rp, int_arg(variant, 1, "GetShopItemPrice"), int_arg(subtype, 2, "GetShopItemPrice"),
+    int_arg(shopId, 3, "GetShopItemPrice"), 0))
+end)
+
+------------------------------------------------------------------------------
+-- EntityPickup:GetLootList(shouldAdvance = false, player = nil) -> LootList; LootList(); LootListEntry
+------------------------------------------------------------------------------
+-- The game's list is a std::deque (MSVC: +0 proxy, +4 map, +8 map size, +0xc first index, +0x10 count) of 0x14-byte
+-- entries (type, variant, subtype, seed, RNG*), one entry to a block, so entry i is the block pointer at
+-- map[(first + i) % mapsize]. The deque is made by the game into a buffer the caller gives (the first stack word),
+-- read out here into Lua tables (each RNG is COPIED, the game's own die with the deque) and destroyed with the game's
+-- deque destructor 0x006da850 (ecx, plain `ret`) plus the proxy block, which is an 8-byte allocation.
+local LL, LLE = {}, {}
+LL.__index = LL
+LLE.__index = LLE
+LL.__type, LLE.__type = "LootList", "LootListEntry"
+
+local function entry_of(ty, variant, subtype, seed, rng)
+  return setmetatable({ _t = ty, _v = variant, _s = subtype, _seed = seed, _rng = rng }, LLE)
+end
+function LLE:GetType() return self._t end
+function LLE:GetVariant() return self._v end
+function LLE:GetSubType() return self._s end
+function LLE:GetSeed() return self._seed end
+function LLE:GetRNG() return self._rng end
+
+local function copy_rng(rp)
+  local rng = RNG()
+  local d = B.ptr(rng)
+  for i = 0, 3 do w32(d + 4 * i, r32(rp + 4 * i)) end
+  return rng
+end
+
+function LL:GetEntries() local out = {} for i, e in ipairs(self._e) do out[i] = e end return out end
+function LL:PushEntry(ty, variant, subtype, seed, rng)
+  ty, variant, subtype = int_arg(ty, 1, "PushEntry"), int_arg(variant, 2, "PushEntry"), int_arg(subtype, 3, "PushEntry")
+  if seed == nil then seed = Random() end
+  seed = int_arg(seed, 4, "PushEntry")
+  if seed == 0 then seed = 1 end
+  if rng ~= nil and (type(rng) ~= "userdata" or rng.GetSeed == nil) then argerr(5, "PushEntry", "RNG", rng) end
+  self._e[#self._e + 1] = entry_of(ty, variant, subtype, seed & 0xffffffff, rng)
+end
+
+if rawget(_G, "LootList") == nil then
+  rawset(_G, "LootList", setmetatable({}, { __call = function() return setmetatable({ _e = {} }, LL) end }))
+  R.Implemented["LootList"] = true
+  R.Implemented["LootList.LootList"] = true
+  for _, m in ipairs({ "GetEntries", "PushEntry" }) do R.Implemented["LootList." .. m] = true end
+  for _, m in ipairs({ "GetType", "GetVariant", "GetSubType", "GetSeed", "GetRNG" }) do R.Implemented["LootListEntry." .. m] = true end
+end
+
+method("EntityPickup", "GetLootList", function(self, advance, player)
+  local p = this(self, "GetLootList")
+  local pl = 0
+  if player ~= nil then pl = this(player, "GetLootList") end
+  local buf = B.alloc(0x20)
+  call(0x006dae40, p, buf, advance and 1 or 0, pl)
+  local out = setmetatable({ _e = {} }, LL)
+  local map, mapsize, first, count = r32(buf + 4), r32(buf + 8), r32(buf + 0xc), r32(buf + 0x10)
+  for i = 0, count - 1 do
+    local e = r32(map + 4 * ((first + i) % mapsize))
+    local rp = r32(e + 0x10)
+    out._e[#out._e + 1] = entry_of(ri32(e), ri32(e + 4), ri32(e + 8), r32(e + 0xc), rp ~= 0 and copy_rng(rp) or nil)
+  end
+  call(0x006da850, buf)
+  B.free(r32(buf))
+  B.free(buf)
+  return out
+end)
+
+------------------------------------------------------------------------------
+-- EntityPickup.SetupCollectibleGraphics(sprite, layer, collectible, blind = false, seed = Random(), loadGraphics = false)
+-- EntityPickup.GetRandomPickupVelocity(position, rng = nil, velocityType = 0) -> Vector
+------------------------------------------------------------------------------
+do
+  local EP = rawget(_G, "EntityPickup")
+  if type(EP) == "table" then
+    static(EP, "EntityPickup", "SetupCollectibleGraphics", function(sprite, layer, id, blind, seed, load)
+      if type(sprite) ~= "userdata" or sprite.GetLayerCount == nil then argerr(1, "SetupCollectibleGraphics", "Sprite", sprite) end
+      layer, id = int_arg(layer, 2, "SetupCollectibleGraphics"), int_arg(id, 3, "SetupCollectibleGraphics")
+      if layer < 0 or layer >= sprite:GetLayerCount() then argerr(2, "SetupCollectibleGraphics", "a layer of the sprite", layer) end
+      if Isaac.GetItemConfig():GetCollectible(id) == nil then argerr(3, "SetupCollectibleGraphics", "a valid collectible", id) end
+      seed = seed == nil and Random() or int_arg(seed, 5, "SetupCollectibleGraphics")
+      if seed == 0 then seed = 1 end
+      call(0x006e1e90, { ecx = this(sprite, "SetupCollectibleGraphics"), edx = layer }, id & 0xffffffff, seed & 0xffffffff, blind and 1 or 0)
+      if load then sprite:LoadGraphics() end
+    end)
+    static(EP, "EntityPickup", "GetRandomPickupVelocity", function(pos, rng, vtype)
+      if type(pos) ~= "userdata" or pos.X == nil then argerr(1, "GetRandomPickupVelocity", "Vector", pos) end
+      vtype = vtype == nil and 0 or int_arg(vtype, 3, "GetRandomPickupVelocity")
+      if rng == nil then rng = RNG() rng:SetSeed(Random() | 1, 35) end
+      if type(rng) ~= "userdata" or rng.GetSeed == nil then argerr(2, "GetRandomPickupVelocity", "RNG", rng) end
+      local buf = B.alloc(0x10)
+      wf32(buf + 8, pos.X) wf32(buf + 12, pos.Y)
+      call(0x005b19b0, { ecx = buf, edx = buf + 8 }, B.ptr(rng), vtype)
+      local v = Vector(rf32(buf), rf32(buf + 4))
+      B.free(buf)
+      return v
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemPool: HasCollectible, HasTrinket, PickCollectible, AddCollectible
+------------------------------------------------------------------------------
+-- Layout measured by lab_pickup_probe.lua (the probe's log lines are in notes/pickup.md):
+--   ItemPool::GetPool(index) 0x00732c70 (ecx, `ret 4`) answers pool + 4 + index * 0x34, 31 pools; each is
+--   { float totalWeight, vector<PoolItem> (begin +4, end +8, capacity +0xc), RNGs, ... } and a PoolItem is 0x18 bytes
+--   { id, initialWeight, weight, decreaseBy, removeOn, byte isUnlocked, byte isSpecial, 2 pad }.
+--   The removed-collectibles bitset (a vector<bool>: begin, end, capacity, bit count) is at pool + 0x67c, the
+--   room blacklist at + 0x68c; the trinket pool is a vector of 8-byte entries { id, byte inPool, byte isAvailable }
+--   at pool + 0x794 (begin, end, capacity).
+--   ItemPool::pick_collectible 0x00732fa0: ecx = the ItemPool, XMM1 = the weight to land on, stack (the pool data
+--   pointer, flags); answers the PoolItem* in EAX or 0. The flags word is (GetCollectibleFlags << 1) | (not decrease).
+local PICK, POOL_AT, POOL_STRIDE, NUM_POOLS = 0x00732fa0, 0x00732c70, 0x34, 31
+local REMOVED, TRINKETS = 0x67c, 0x794
+
+local function pool_data(pool, idx, fname)
+  idx = int_arg(idx, 1, fname)
+  if idx < 0 or idx >= NUM_POOLS then argerr(1, fname, "a valid ItemPoolType", idx) end
+  return call(POOL_AT, pool, idx)
+end
+local function bit_set(vec, id)
+  local first = r32(vec)
+  if first == 0 or id >= r32(vec + 0xc) then return false end
+  return (r32(first + 4 * (id >> 5)) >> (id & 31)) & 1 == 1
+end
+local function ncollectibles() return Isaac.GetItemConfig():GetCollectibles().Size end
+
+method("ItemPool", "HasCollectible", function(self, id)
+  local pool = this(self, "HasCollectible")
+  id = int_arg(id, 1, "HasCollectible")
+  if id < 0 or id >= ncollectibles() then return false end
+  return not bit_set(pool + REMOVED, id)
+end)
+
+method("ItemPool", "HasTrinket", function(self, id)
+  local pool = this(self, "HasTrinket")
+  id = int_arg(id, 1, "HasTrinket")
+  local first, last = r32(pool + TRINKETS), r32(pool + TRINKETS + 4)
+  if id < 1 or id >= (last - first) // 8 then return false end
+  return r8(first + 8 * id + 4) ~= 0
+end)
+
+method("ItemPool", "PickCollectible", function(self, poolType, decrease, rng, flags)
+  local pool = this(self, "PickCollectible")
+  local data = pool_data(pool, poolType, "PickCollectible")
+  if rng == nil then rng = RNG() rng:SetSeed(Random() | 1, 4)
+  elseif type(rng) ~= "userdata" or rng.RandomFloat == nil then argerr(3, "PickCollectible", "RNG", rng) end
+  flags = flags == nil and 0 or int_arg(flags, 4, "PickCollectible")
+  local weight = rng:RandomFloat() * rf32(data)
+  local item = call(PICK, { ecx = pool, xmm1 = weight }, data, ((flags << 1) | (decrease and 0 or 1)) & 0xffffffff)
+  if item == 0 then return nil end
+  return { itemID = ri32(item), initialWeight = rf32(item + 4), weight = rf32(item + 8), decreaseBy = rf32(item + 12),
+    removeOn = rf32(item + 16), isUnlocked = r8(item + 20) ~= 0 }
+end)
+
+-- AddCollectible(pool, items): the pool's own vector grows (a new buffer, the old one freed through the game's own
+-- allocator) and the pool's total weight with it. The pools are rebuilt at every run start, so what was added is kept
+-- in Lua and put back at MC_POST_GAME_STARTED (an entry already in the pool is not doubled).
+do
+  local ADDED = {}
+  local function in_pool(data, id)
+    for e = r32(data + 4), r32(data + 8) - 1, 0x18 do if ri32(e) == id then return true end end
+    return false
+  end
+  local function push(pool, idx, it)
+    local data = call(POOL_AT, pool, idx)
+    if in_pool(data, it.id) then return end
+    local first, last, cap = r32(data + 4), r32(data + 8), r32(data + 0xc)
+    local n = (last - first) // 0x18
+    if last + 0x18 > cap then
+      local ncap = (n + 1) * 0x18 + 0x18 * 8
+      local buf = B.alloc(ncap)
+      for i = 0, n * 6 - 1 do w32(buf + 4 * i, r32(first + 4 * i)) end
+      if first ~= 0 then B.free(first) end
+      first = buf
+      w32(data + 4, buf) w32(data + 0xc, buf + ncap)
+    end
+    local e = first + n * 0x18
+    w32(e, it.id & 0xffffffff) wf32(e + 4, it.weight) wf32(e + 8, it.weight) wf32(e + 12, it.dec) wf32(e + 16, it.rem)
+    w32(e + 20, it.unlocked and 1 or 0)
+    w32(data + 8, e + 0x18)
+    wf32(data, rf32(data) + it.weight)
+  end
+  local function field(t, name)
+    for k, v in pairs(t) do if type(k) == "string" and k:lower() == name then return v end end
+  end
+  local function parse(t)
+    local id = field(t, "itemid")
+    if id == nil then
+      local name = field(t, "name")
+      if type(name) == "string" then id = Isaac.GetItemIdByName(name) end
+    end
+    if mathtype(id) ~= "integer" or id <= 0 or Isaac.GetItemConfig():GetCollectible(id) == nil then
+      log("ItemPool.AddCollectible: skipped an entry with no valid collectible (" .. tostring(id) .. ")")
+      return nil
+    end
+    local function num(name, d) local v = field(t, name) return type(v) == "number" and v or d end
+    local cfg = Isaac.GetItemConfig():GetCollectible(id)
+    local ok, avail = pcall(cfg.IsAvailable, cfg)
+    return { id = id, weight = num("weight", 1.0), dec = num("decreaseby", 0.5), rem = num("removeon", 0.1), unlocked = not ok or avail ~= false }
+  end
+  method("ItemPool", "AddCollectible", function(self, poolType, items)
+    local pool = this(self, "AddCollectible")
+    pool_data(pool, poolType, "AddCollectible")
+    if type(items) ~= "table" then argerr(2, "AddCollectible", "table", items) end
+    local list = items[1] ~= nil and items or { items }
+    for _, t in ipairs(list) do
+      local it = type(t) == "table" and parse(t)
+      if it then
+        ADDED[#ADDED + 1] = { poolType, it }
+        push(pool, poolType, it)
+      end
+    end
+  end)
+  T.listen(ModCallbacks.MC_POST_GAME_STARTED, function()
+    local pool = this(Game():GetItemPool(), "AddCollectible")
+    for _, a in ipairs(ADDED) do push(pool, a[1], a[2]) end
+  end, -math.huge)
+end
+
+-- ItemPool:GetCollectible(pool, decrease = false, seed = Random(), default = 0, flags = 0): the game's own binding takes
+-- no fifth argument (measured by lab_pickup_more: BAN_ACTIVES and BAN_PASSIVES changed nothing), but the game's function
+-- 0x00733610 does: ecx = the pool, stack (poolType, seed, flags word, defaultItem), `ret 0x10`, the flags word being
+-- (GetCollectibleFlags << 1) | (not decrease), as pick_collectible takes it. Called with a fifth argument the wrapper
+-- calls that function; without, the game's own binding runs untouched.
+-- NOT DONE (deferred): the wrapper that would call the game function directly could not be made to take effect. A
+-- rawset on the class table was not what `pool.GetCollectible` then answered (the game's own closure came back), so the
+-- name is left out of Implemented. Flags for GetCollectible belong with an engine hook (cb-b).
