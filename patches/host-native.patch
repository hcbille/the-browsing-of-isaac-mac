+  at("Menu_Character::RenderPage@PreModded", ids, function(esp)
+    local menu = reg("esi")
+    local pt, posp = ri32(esp), r32(esp + 4)
+    local vanilla = sprite_in(menu + 0x40)
+    if not vanilla then wrong("RenderPage (the page sprite)", menu) return end
+    local cfg = T.player_config and T.player_config(pt)
+    local csp = cfg and r32(cfg + 0x134) or 0
+    local custom = csp ~= 0 and sprite_in(csp) or nil
+    local bg = custom ~= nil and r8(cfg + 0x130) ~= 0
+    return pre(pt, vec_at(posp), vanilla, custom, bg, function() reg("esp", esp + 0xc) return 0x0094bc64 end)
+  end)
+  at("Menu_Character::RenderPage@Post", { POST_PAGE }, function()
+    local p = pending
+    if not p then return end
+    pending = nil
+    first("MC_POST_RENDER_CHARACTER_SELECT_PAGE")
+    run(POST_PAGE, p[1], p[1], p[2], p[3], p[4], p[5])
+  end)
+  at("Menu_Character::RenderPage@EdenTokens", { PRE_PAGE }, function()
+    if skip_eden then return 0x0094bd97 end
+  end)
+end
+
+-- 1331 / 1332
+if PRE_PORT and POST_PORT then
+  local ids = { PRE_PORT, POST_PORT }
+  local pending = nil
+  local function pre(pt, sprite, pos, scale, color, write_pos, cancel)
+    pending = nil
+    if wants(PRE_PORT, pt) then
+      first("MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT")
+      local res = run(PRE_PORT, pt, pt, sprite, pos, scale, color)
+      if res == false then return cancel() end
+      if is_vector(res) and (res.X ~= pos.X or res.Y ~= pos.Y) then write_pos(res) pos = Vector(res.X, res.Y) end
+    end
+    if wants(POST_PORT, pt) then pending = { pt, sprite, pos, scale, color } end
+  end
+  at("Menu_Character::RenderWheel@PreVanilla", ids, function(esp)
+    local menu, ebx = reg("edi"), reg("ebx")
+    local pt = type_of(menu, ri32(r32(0x00c94178) + ebx))
+    if not (wants(PRE_PORT, pt) or wants(POST_PORT, pt)) then pending = nil return end
+    local sprite = sprite_in(menu + 0xb20)
+    if not sprite then wrong("RenderWheel (the portrait sprite)", menu) pending = nil return end
+    local ok, scale, color = pcall(function() return Vector(sprite.Scale.X, sprite.Scale.Y), color_copy(sprite.Color) end)
+    if not ok then pending = nil return end
+    local pos = vec_at(esp + 0x14)
+    return pre(pt, sprite, pos, scale, color, function(v) wf32(esp + 0x14, v.X) wf32(esp + 0x18, v.Y) end,
