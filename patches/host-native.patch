+-- EntityNPC:GetShieldStrength / SetShieldStrength / GetDarkRedChampionRegenTimer / ApplyTearflagEffects / TrySplit /
+--   UpdatePickupGhosts / ReplaceSpritesheet,
+-- EntityBomb:UpdateDirtColor / GetHeight / SetHeight, EntityConfigEntity:GetShadowSize / GetEntityTags / HasEntityTags.
+-- Every address and offset was read in THIS executable (v1.9.7.17) by lab_entity2_probe.lua and is exercised, method by
+-- method, by lab_entity_classes.lua.
+--
+--   Entity::GetCollisionCapsule  0x006a9ba0  thiscall, stack: Capsule* out (0x28 bytes), Vector* offset; `ret 8`.
+--   Entity::GetNullCapsule       0x006b6c20  thiscall, stack: Capsule* out, const char* null layer; `ret 8`. An unknown
+--       layer, or an entity without a sprite, answers a degenerate capsule at the entity's position (size 0).
+--   Entity::AddMagnetized        0x006b7280  thiscall, stack: EntityRef*, int duration, bool; `ret 0xc`; the countdown
+--       at +0x2f0 is clamped to 300 (10 seconds).
+--   Entity::TryThrow             virtual slot 21 (vtable +0x54): bool (EntityRef*, Vector* velocity, float height);
+--       `ret 0xc`, the float is a stack word. Each class has its own body (player, NPC, pickup, familiar, base).
+--   EntityFamiliar item config   pointer at +0xee8 (ItemConfigItem*, 0 for a familiar no item spawned); Brother Bobby
+--       and Dead Bird both read back their item.
+--   EntityFamiliar::GetRandomWisp 0x0043eb10  static fastcall, ecx = RNG*, plain `ret`, answers a collectible id.
+--   EntityFamiliar dirt colour   0x0064ca30  thiscall, one stack word the body ignores, `ret 4`; writes the 3 floats at +0xef4.
+--   EntityNPC shield strength    float at +0xc40 (the XML shieldstrength for Satan, Isaac, Blue Baby; 0 for a gaper).
+--   EntityNPC dark red regen     16-bit counter at +0xc74 (the game's own `inc word`, regenerates at 90).
+--   Entity_Tear::ApplyTearFlagEffects 0x0067af60 static: ecx = entity, edx = &position, stack: 16 bytes of flags,
+--       Entity* source, float damage; the caller cleans (api_hooks.lua owns the pre/post callbacks around it).
+--   Entity_NPC::TrySplit 0x006d97e0 thiscall, ecx = npc, xmm1 = damage, stack: EntityRef*, bool; `ret 8`.
+--   EntityNPC::UpdatePickupGhosts 0x006da530 thiscall, plain `ret`.
+--   Room floor colour 0x00823590 thiscall (ecx = room, stack: float[3]* out, Vector* position, xmm3 = size, `ret 8`):
+--       the bomb's dirt colour is that colour doubled, put on every sprite layer named "Hole".
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call
+local type, error, pcall, getmetatable, setmetatable, rawget, tostring, ipairs = type, error, pcall, getmetatable, setmetatable, rawget, tostring, ipairs
+local mathtype = math.type
+
+local function argerr(n, fname, want, got)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. type(got) .. ")", 3)
+end
+local function vec_arg(v, n, fname)
+  if type(v) ~= "userdata" or v.X == nil then argerr(n, fname, "Vector", v) end
+  return v
+end
+local function num_arg(v, n, fname)
+  if type(v) ~= "number" then argerr(n, fname, "number", v) end
+  return v
+end
+local function ptr_of_entity(e, n, fname)
+  if e == nil then return 0 end
+  if type(e) ~= "userdata" then argerr(n, fname, "Entity", e) end
+  return ptr(e)
+end
+
+------------------------------------------------------------------------------
+-- Entity
+------------------------------------------------------------------------------
+-- GetCollisionCapsule(offset = Vector(0, 0)) -> Capsule
+method("Entity", "GetCollisionCapsule", function(self, offset)
+  local p = this(self, "GetCollisionCapsule")
+  if offset ~= nil then vec_arg(offset, 1, "GetCollisionCapsule") end
+  local buf, off = B.alloc(0x28), B.alloc(8)
+  wf32(off, offset and offset.X or 0) wf32(off + 4, offset and offset.Y or 0)
+  call(0x006a9ba0, p, buf, off)
+  local c = T.capsule_from_struct(buf)
+  B.free(buf) B.free(off)
+  return c
+end)
+
+-- Entity:GetNullCapsule is in api_leftovers.lua (a knife variant 10/11 "Hit" layer answered a capsule of size 6.15 in lab_leftovers).
+
+-- AddMagnetized(source, duration)
+method("Entity", "AddMagnetized", function(self, source, duration)
+  local p = this(self, "AddMagnetized")
+  if type(source) ~= "userdata" then argerr(1, "AddMagnetized", "EntityRef", source) end
+  if mathtype(duration) ~= "integer" then
+    if type(duration) == "number" and duration == math.floor(duration) then duration = math.tointeger(duration)
+    else argerr(2, "AddMagnetized", "number", duration) end
+  end
+  call(0x006b7280, p, ptr(source), duration & 0xffffffff, 0)
+end)
+
+-- TryThrow(source, velocity, height) -> boolean
+method("Entity", "TryThrow", function(self, source, velocity, height)
+  local p = this(self, "TryThrow")
+  if type(source) ~= "userdata" then argerr(1, "TryThrow", "EntityRef", source) end
+  vec_arg(velocity, 2, "TryThrow")
+  num_arg(height, 3, "TryThrow")
+  local v = B.alloc(8)
+  wf32(v, velocity.X) wf32(v + 4, velocity.Y)
+  local ok = (call(r32(r32(p) + 0x54), p, ptr(source), v, B.f2i(height)) & 0xff) ~= 0
+  B.free(v)
+  return ok
+end)
+
+-- GetEntityConfigEntity() -> EntityConfigEntity or nil
+method("Entity", "GetEntityConfigEntity", function(self)
+  this(self, "GetEntityConfigEntity")
+  return EntityConfig.GetEntity(self.Type, self.Variant, self.SubType)
+end)
+
+------------------------------------------------------------------------------
+-- EntityFamiliar
+------------------------------------------------------------------------------
+-- IsCharmed(): the Siren charms a familiar by making it follow her, which the game records as the familiar's
+-- player being the Siren boss entity (type 904).
+method("EntityFamiliar", "IsCharmed", function(self)
+  this(self, "IsCharmed")
+  local pl = self.Player
+  return pl ~= nil and pl.SpawnerType == 904 and pl.SpawnerVariant == 0
+end)
+
+-- GetItemConfig() -> ItemConfigItem or nil
+do
+  local sample = Isaac.GetItemConfig():GetCollectible(1)
+  local mt = sample and getmetatable(sample)
+  if mt then
+    method("EntityFamiliar", "GetItemConfig", function(self)
+      local p = this(self, "GetItemConfig")
+      local cfg = r32(p + 0xee8)
+      if cfg == 0 then return nil end
+      return B.obj(mt, cfg, T.vt_ptr())
+    end)
+  end
+end
+
+-- GetRandomWisp(rng) -> collectible id (static)
+T.static(rawget(_G, "EntityFamiliar"), "EntityFamiliar", "GetRandomWisp", function(rng)
+  if type(rng) ~= "userdata" then argerr(1, "GetRandomWisp", "RNG", rng) end
+  -- eax IS the collectible id (call's first result); ri32 would read memory at that address
+  local id = call(0x0043eb10, { ecx = ptr(rng) })
+  if id >= 0x80000000 then id = id - 0x100000000 end
+  return id
+end)
+
+-- UpdateDirtColor()
+method("EntityFamiliar", "UpdateDirtColor", function(self)
+  local p = this(self, "UpdateDirtColor")
+  call(0x0064ca30, p, 1)
+end)
+
+------------------------------------------------------------------------------
+-- EntityNPC
+------------------------------------------------------------------------------
+method("EntityNPC", "GetShieldStrength", function(self)
+  return rf32(this(self, "GetShieldStrength") + 0xc40)
+end)
+method("EntityNPC", "SetShieldStrength", function(self, strength)
+  local p = this(self, "SetShieldStrength")
+  num_arg(strength, 1, "SetShieldStrength")
+  wf32(p + 0xc40, strength)
+end)
+method("EntityNPC", "GetDarkRedChampionRegenTimer", function(self)
+  return r32(this(self, "GetDarkRedChampionRegenTimer") + 0xc74) & 0xffff
+end)
+
+-- ApplyTearflagEffects(position, tearFlags, source = nil, damage = 3.5)
+method("EntityNPC", "ApplyTearflagEffects", function(self, position, flags, source, damage)
+  local p = this(self, "ApplyTearflagEffects")
+  vec_arg(position, 1, "ApplyTearflagEffects")
+  if type(flags) ~= "userdata" or not pcall(function() return flags.l | flags.h end) then argerr(2, "ApplyTearflagEffects", "BitSet128", flags) end
+  local src = ptr_of_entity(source, 3, "ApplyTearflagEffects")
+  if damage ~= nil then num_arg(damage, 4, "ApplyTearflagEffects") end
+  damage = damage or 3.5
+  if damage < 0 then damage = 0.0 end
+  local pos = B.alloc(8)
+  wf32(pos, position.X) wf32(pos + 4, position.Y)
+  local l, h = flags.l, flags.h
+  call(0x0067af60, { ecx = p, edx = pos }, l & 0xffffffff, (l >> 32) & 0xffffffff, h & 0xffffffff, (h >> 32) & 0xffffffff,
+    src, B.f2i(damage))
+  B.free(pos)
+end)
+
+-- TrySplit(defaultDamage, source, doScreenEffects = true) -> boolean
+-- Entity_NPC::TrySplit 0x006d97e0: thiscall, ecx = npc, xmm1 = the damage, stack: EntityRef*, bool; `ret 8`; answers
+-- a bool in al (read in the game's own caller at 0x005df8f8, which pushes the bool first, then the reference).
+method("EntityNPC", "TrySplit", function(self, damage, source, effects)
+  local p = this(self, "TrySplit")
+  num_arg(damage, 1, "TrySplit")
+  if type(source) ~= "userdata" then argerr(2, "TrySplit", "EntityRef", source) end
+  if effects == nil then effects = true end
+  return (call(0x006d97e0, { ecx = p, xmm1 = damage }, ptr(source), effects and 1 or 0) & 0xff) ~= 0
+end)
+
+-- UpdatePickupGhosts()
+method("EntityNPC", "UpdatePickupGhosts", function(self)
+  call(0x006da530, this(self, "UpdatePickupGhosts"))
+end)
+
+-- ReplaceSpritesheet(layerId, pngFilename, loadGraphics = false) -> boolean
+-- The sprite's own ReplaceSpritesheet, then LoadGraphics when asked. REPENTOGON first runs the path through the game's
+-- champion/stage suffix translation (Entity_NPC::translate_gfx_path); that step is not located in this build, so the
+-- filename is used exactly as given.
+method("EntityNPC", "ReplaceSpritesheet", function(self, layer, filename, load)
+  this(self, "ReplaceSpritesheet")
+  if mathtype(layer) ~= "integer" then argerr(1, "ReplaceSpritesheet", "number", layer) end
+  if type(filename) ~= "string" then argerr(2, "ReplaceSpritesheet", "string", filename) end
+  local spr = self:GetSprite()
+  spr:ReplaceSpritesheet(layer, filename)
+  if load then spr:LoadGraphics() end
+  return true
+end)
+
+------------------------------------------------------------------------------
+-- EntityBomb
+------------------------------------------------------------------------------
+-- GetHeight / SetHeight: REPENTOGON's deprecated names for the fall speed (the field api_game.lua serves).
+method("EntityBomb", "GetHeight", function(self) return self:GetFallSpeed() end)
+method("EntityBomb", "SetHeight", function(self, v) return self:SetFallSpeed(v) end)
+
+-- UpdateDirtColor(): the floor colour under the bomb, doubled, tints its "Hole" layers.
+method("EntityBomb", "UpdateDirtColor", function(self)
+  local p = this(self, "UpdateDirtColor")
+  local room = ptr(Game():GetRoom())
+  local out, pos = B.alloc(12), B.alloc(8)
+  wf32(out, 0) wf32(out + 4, 0) wf32(out + 8, 0)
+  wf32(pos, self.Position.X) wf32(pos + 4, self.Position.Y)
+  call(0x00823590, { ecx = room, xmm3 = self.Size }, out, pos)
+  local r, g, b = rf32(out), rf32(out + 4), rf32(out + 8)
+  B.free(out) B.free(pos)
+  local spr = self:GetSprite()
+  for i = 0, spr:GetLayerCount() - 1 do
+    local layer = spr:GetLayer(i)
+    if layer and layer:GetName() == "Hole" then
+      layer:SetColor(Color(r * 2, g * 2, b * 2, 1, 0, 0, 0))
+    end
+  end
+end)
+
+------------------------------------------------------------------------------
+-- EntityConfigEntity (the XML-backed stand-in of api_data.lua)
+------------------------------------------------------------------------------
+do
+  local sample = EntityConfig.GetEntity(10, 0, 0)
+  local EE = sample and getmetatable(sample)
+  if type(EE) == "table" then
+    EE = rawget(EE, "__index") or EE
+    local TAGS = { fly = 1, spider = 2, ghost = 8, noreroll = 16, cansacrifice = 32, explosive_soul = 64,
+      homing_soul = 128, brimstone_soul = 256, nodelirium = 512 }
+    local function add(name, f)
+      if rawget(EE, name) == nil then EE[name] = f R.Implemented["EntityConfigEntity." .. name] = true end
+    end
+    -- GetShadowSize(): the XML's shadowsize / 100 (0 when the entry has none)
+    add("GetShadowSize", function(self) return (tonumber(self._x.shadowsize) or 0) / 100 + 0.0 end)
+    -- GetEntityTags() -> the EntityTag bits named in the XML's tags="..."
+    add("GetEntityTags", function(self)
+      local bits = 0
+      for t in (self._x.tags or ""):gmatch("%S+") do bits = bits | (TAGS[t:lower()] or 0) end
+      return bits
+    end)
+    -- HasEntityTags(tags): every given bit is set; a zero or negative mask is false
+    add("HasEntityTags", function(self, tags)
+      if mathtype(tags) ~= "integer" then argerr(1, "HasEntityTags", "number", tags) end
+      if tags <= 0 then return false end
+      return (self:GetEntityTags() & tags) == tags
+    end)
+  else
+    B.log("api_npc: no EntityConfigEntity class; GetShadowSize / HasEntityTags left out")
+  end
+end
+
+------------------------------------------------------------------------------
+-- the game's own members the backlog listed as "unverified" (present on the class, not in Implemented): lab_entity_classes.lua
+-- reads each back (Entity.Variant, EntityNPC.V1 / V2, GetBossColorIdx, PlaySound), so each is a real one; a name is
+-- registered only when this build's class really has it.
+------------------------------------------------------------------------------
+for _, n in ipairs({ { "Entity", "Variant" }, { "EntityNPC", "V1" }, { "EntityNPC", "V2" }, { "EntityNPC", "GetBossColorIdx" },
+  { "EntityNPC", "PlaySound" } }) do
+  local c = T.class_tables(n[1])
+  local pg = c and rawget(c, "__propget")
+  if c and (rawget(c, n[2]) ~= nil or (type(pg) == "table" and rawget(pg, n[2]) ~= nil)) then
+    R.Implemented[n[1] .. "." .. n[2]] = true
+  else
+    B.log("api_npc: this build's " .. n[1] .. " has no " .. n[2] .. "; left unregistered")
+  end
+end
