@@ -0,0 +1,57 @@
+-- lab_gate_class_test.lua (development only; ISAAC_RGON_LAB=lab_gate_class_test.lua, round 149)
+-- The gate matches a name with the class it is used on (rgon.lua gate_weigh). Feeds it scan tokens (`Name` or
+-- `Name.hint` / `Name!callee`, see mods.mjs receiverHint) and logs "lab_gate_class_test: PASS/FAIL ..".
+-- Needs the scan (modscan.lua beside the layer) so the gate has loaded its tables.
+-- Expectations hold while the layer has LayerState.GetSpritesheetPath, Entity.AddWeakness and
+-- EntityFamiliar.GetWeapon, and lacks EntityConfigBaby.GetSpritesheetPath and EntityFamiliar.GetActiveWeaponEntity.
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local mod = RegisterMod("rgon lab gate class test", 1)
+local done = false
+-- the gate is built after the labs are loaded: run in the first room
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+if done then return end
+done = true
+local Gate = R.Extras and R.Extras.Gate
+local function check(name, ok, detail)
+  B.log("lab_gate_class_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail and (" " .. tostring(detail)) or ""))
+end
+if not (Gate and Gate.data) then
+  check("gate tables loaded (needs modscan.lua)", false)
+  B.log("lab_gate_class_test: DONE")
+  return
+end
+local function weigh(names)
+  local used, missing = Gate.weigh(names, Gate.data)
+  return used, table.concat(missing, ",")
+end
+local I = R.Implemented
+check("premise: LayerState.GetSpritesheetPath implemented", I["LayerState.GetSpritesheetPath"] == true)
+check("premise: EntityConfigBaby.GetSpritesheetPath absent", I["EntityConfigBaby.GetSpritesheetPath"] == nil)
+check("premise: EntityFamiliar.GetActiveWeaponEntity absent", I["EntityFamiliar.GetActiveWeaponEntity"] == nil)
+
+local u, m = weigh("GetSpritesheetPath")
+check("unknown receiver: superset, any class lacking = missing", u == 1 and m == "GetSpritesheetPath", u .. " " .. m)
+u, m = weigh("GetSpritesheetPath!GetLayer")
+check("Sprite:GetLayer():X narrows to LayerState", u == 1 and m == "", u .. " " .. m)
+u, m = weigh("GetSpritesheetPath.bossPortraitLayer")
+check("variable named for its class (...Layer) narrows to LayerState", u == 1 and m == "", u .. " " .. m)
+u, m = weigh("GetSpritesheetPath.self")
+check("the mod's own table is not a use", u == 0 and m == "", u .. " " .. m)
+u, m = weigh("AddWeakness.player")
+check("EntityPlayer inherits Entity.AddWeakness", u == 1 and m == "", u .. " " .. m)
+u, m = weigh("GetWeapon.familiar")
+check("EntityFamiliar.GetWeapon counted (game also has GetWeapon) and present", u == 1 and m == "", u .. " " .. m)
+u, m = weigh("GetWeapon")
+check("GetWeapon with an unknown receiver is not counted (the game has it)", u == 0 and m == "", u .. " " .. m)
+u, m = weigh("GetWeapon.player")
+check("GetWeapon on a player is the game's own", u == 0 and m == "", u .. " " .. m)
+u, m = weigh("GetActiveWeaponEntity.familiar")
+check("EntityFamiliar.GetActiveWeaponEntity missing", u == 1 and m == "GetActiveWeaponEntity", u .. " " .. m)
+u, m = weigh("GetActiveWeaponEntity.player")
+check("GetActiveWeaponEntity on a player is the game's own", u == 0 and m == "", u .. " " .. m)
+u, m = weigh("AddWeakness.GetRoom AddWeakness!Foo")
+check("an unknown call result stays a superset", u == 1 and m == "", u .. " " .. m)
+B.log("lab_gate_class_test: DONE")
+end)
diff --git a/scripts/recomp/rgon/lab_gfx2_shot.lua b/scripts/recomp/rgon/lab_gfx2_shot.lua
new file mode 100644
index 0000000..92fa07b
--- /dev/null
+++ b/scripts/recomp/rgon/lab_gfx2_shot.lua
@@ -0,0 +1,41 @@
+-- lab_gfx2_shot.lua (development only; ISAAC_RGON_LAB=lab_gfx2_shot.lua, windowed, SHOT=@300:<png>): Image:Render on the screen.
+-- Row 1 (a loaded sheet): whole, a 32x32 crop at 3x, rotated 30 degrees, mirrored (DestinationQuad:Flip), red tint at half alpha.
+-- Row 2: a created image drawn into with RenderToImage (green) shown on the screen, then drawn into again (it must show the new pixels).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab gfx2 shot", 1)
+local SHEET = "gfx/characters/costumes/character_001_isaac.png"
+local src, mk, font
+local function q(x, y, w, h) return SourceQuad(Vector(x, y), Vector(x + w, y), Vector(x, y + h), Vector(x + w, y + h)) end
+local function dq(x, y, w, h) return DestinationQuad(Vector(x, y), Vector(x + w, y), Vector(x, y + h), Vector(x + w, y + h)) end
+local WHITE = KColor(1, 1, 1, 1)
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  local f = Isaac.GetFrameCount()
+  if f < 30 then return end
+  if not src then
+    font = Font() font:Load("font/terminus8.fnt")
+    src = Renderer.LoadImage(SHEET)
+    mk = Renderer.CreateImage(src:GetWidth(), src:GetHeight(), "GFX2_SHOT")
+    Renderer.RenderToImage(mk, function(c) c:Clear() src:Render(q(0, 0, src:GetWidth(), src:GetHeight()), dq(0, 0, src:GetWidth(), src:GetHeight()), KColor(0.3, 1, 0.3, 1)) end)
+    B.log("lab_gfx2_shot: sheet " .. src:GetWidth() .. "x" .. src:GetHeight())
+  end
+  local w, h = 64, 64
+  src:Render(q(0, 0, w, h), dq(40, 40, w, h), WHITE)
+  src:Render(q(16, 16, 32, 32), dq(130, 40, 96, 96), WHITE)
+  -- rotated 30 degrees around its top-left corner: edges (cos, sin) and (-sin, cos) times 64
+  local c, s = math.cos(math.rad(30)) * 64, math.sin(math.rad(30)) * 64
+  src:Render(q(0, 0, w, h), DestinationQuad(Vector(300, 40), Vector(300 + c, 40 + s), Vector(300 - s, 40 + c), Vector(300 + c - s, 40 + s + c)), WHITE)
+  local m = dq(380, 40, w, h) m:Flip(true, false)
+  src:Render(q(0, 0, w, h), m, WHITE)
+  src:Render(q(0, 0, w, h), dq(130, 160, w, h), KColor(1, 0.2, 0.2, 0.5))
+  src:Render(SourceQuad(Vector(64, 0), Vector(0, 0), Vector(64, 64), Vector(0, 64)), dq(40, 160, w, h), WHITE)
+  mk:Render(q(0, 0, w, h), dq(220, 160, w, h), WHITE)
+  if Game():GetFrameCount() > 160 and not mk._second then
+    B.log("lab_gfx2_shot: redraw at game frame " .. Game():GetFrameCount() .. " isaac frame " .. f)
+    mk._second = true
+    Renderer.RenderToImage(mk, function(cc) cc:Clear() src:Render(q(0, 0, w, h), dq(0, 0, w, h), KColor(1, 0.2, 0.2, 1)) end)
+  end
+  mk:Render(q(0, 0, w, h), dq(310, 160, w, h), WHITE)
+  font:DrawString("whole / crop 3x / rotated / mirrored / red half alpha", 40, 130, KColor(1, 1, 1, 1), 0, false)
+  font:DrawString("flipped source / red half alpha / created image / the same image after a redraw", 40, 235, KColor(1, 1, 1, 1), 0, false)
+end)
diff --git a/scripts/recomp/rgon/lab_gfx_shot.lua b/scripts/recomp/rgon/lab_gfx_shot.lua
