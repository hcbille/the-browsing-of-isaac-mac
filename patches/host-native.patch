+-- api_gfx.lua -- Image, Renderer.CreateImage / LoadImage / RenderToImage, SourceQuad conversions and the
+-- spritesheet functions of Sprite and LayerState (wave 5, worker gfx).
+--
+-- How it works (software, no render target in the engine): an Image is a size and, once something reads or draws
+-- it, an RGBA string held here. Renderer.LoadImage reads the PNG through the game's file layer (the mods' resource
+-- folders first, then the game's). Renderer.CreateImage starts transparent. Image:Render inside
+-- Renderer.RenderToImage blits the source quad onto the target's pixels (host bridge img_blit: two triangles,
+-- nearest sample, tint, source-over). Sprite:SetSpritesheet / LayerState:SetSpritesheet with a created image
+-- writes it as a PNG into the game's file layer in memory (bridge fs_seed, under C:/rgon_images/gfx/: the game's
+-- file lookup opens a path with a drive letter as it stands, and finds files the host holds) and calls the
+-- game's own ReplaceSpritesheet + LoadGraphics, so the game's renderer draws it.
+--
+-- Image:Render outside a RenderToImage draws on the screen through a temporary Sprite (see screen_render below).
+-- What this does NOT do (stays out of REPENTOGON.Implemented or unregistered): Sprite:Render into an image,
+-- RenderWithShader and custom shaders, Beam:Render, the clip pane getters. An
+-- image drawn into after SetSpritesheet shows on the layer at its next SetSpritesheet (REPENTOGON shares the texture;
+-- here the PNG is a snapshot).
+
+local T = ...
+local B, R, this = T.B, T.R, T.this
+local log = B.log
+local type, pairs, ipairs, tostring, rawget, rawset, setmetatable, pcall, error = type, pairs, ipairs, tostring, rawget, rawset, setmetatable, pcall, error
+local mathtype = math.type
+local unsupported = T.unsupported or function() end
+
+if not (B.png_decode and B.png_encode and B.img_blit and B.fs_seed and B.png_size) then
+  log("api_gfx: the engine bridge has no pixel functions; Image stays a stand-in")
+  return
+end
+
+local function argerr(n, fname, want, v)
+  error("bad argument #" .. n .. " to '" .. fname .. "' (" .. want .. " expected, got " .. type(v) .. ")", 3)
+end
+local function define(cls, name, f)
+  local c, const = T.class_tables(cls)
+  if not c then log("api_gfx: no class " .. cls .. " for " .. name) return end
+  local wrapped = B.cfn(f)
+  rawset(c, name, wrapped)
+  if const and const ~= c then rawset(const, name, wrapped) end
+  R.Implemented[cls .. "." .. name] = true
+end
+
+------------------------------------------------------------------------------
+-- finding a PNG: the game's own file lookup first, then the mods' resources (last loaded first), then the game's
+------------------------------------------------------------------------------
+local function candidates(path)
+  local out, seen = {}, {}
+  local function add(p) if not seen[p] then seen[p] = true out[#out + 1] = p end end
+  local rel = path:gsub("\\", "/")
+  local at = rel:find("gfx/", 1, true)
+  local tail = at and rel:sub(at) or rel
+  add(rel)            -- the game's own lookup resolves mods and resources itself
+  local ms = T.mods and T.mods() or {}
+  for i = #ms, 1, -1 do
+    if ms[i].enabled then add("mods/" .. ms[i].dir .. "/resources/" .. tail) end
+  end
+  add("resources/" .. tail)
+  add("resources-dlc3/" .. tail)
+  add(rel)
+  return out
+end
+local function find_png(path)
+  for _, p in ipairs(candidates(path)) do
+    local bytes = T.read_file(p)
+    if bytes and #bytes > 24 and bytes:byte(1) == 0x89 then return bytes, p end
+  end
+end
+
+------------------------------------------------------------------------------
+-- Image
+------------------------------------------------------------------------------
+local Image = {}
+Image.__index = Image
+Image.__type = "Image"
+Image.__name = "Image"
+local MAX_SIDE = 4096
+local created_by_path = {}      -- the in-memory path of a published image -> the image (GetSpritesheet answers it back)
+local serial = 0
+
+local function new_image(w, h, name, extra)
+  local img = setmetatable({ _w = w, _h = h, _name = name }, Image)
+  for k, v in pairs(extra or {}) do img[k] = v end
+  return img
+end
+local function is_image(v) return type(v) == "table" and getmetatable(v) == Image end
+local function image_arg(n, fname, v) if not is_image(v) then argerr(n, fname, "Image", v) end return v end
+local function int_arg(n, fname, v) if mathtype(v) ~= "integer" then
+  if type(v) == "number" and v == math.floor(v) then return math.tointeger(v) end
+  argerr(n, fname, "number", v) end return v end
+
+-- the RGBA string of an image, decoded the first time it is needed
+local function pixels(img)
+  if not img._pix then
+    if img._bytes then
+      local w, h, px = B.png_decode(img._bytes)
+      if not w then error("Unable to read image '" .. img._name .. "': " .. tostring(h), 3) end
+      img._pix = px
+    else
+      img._pix = string.rep("\0", img._w * img._h * 4)
+    end
+  end
+  return img._pix
+end
+
+function Image:GetWidth() return image_arg(0, "GetWidth", self)._w end
+function Image:GetHeight() return image_arg(0, "GetHeight", self)._h end
+function Image:GetName() return image_arg(0, "GetName", self)._name end
+function Image:GetPaddedWidth() return self._w end
+function Image:GetPaddedHeight() return self._h end
+
+-- RGBA bytes, row by row, of the region (x, y, width, height); pixels outside the image read as transparent
+function Image:GetTexelRegion(x, y, w, h)
+  image_arg(0, "GetTexelRegion", self)
+  x, y, w, h = int_arg(1, "GetTexelRegion", x), int_arg(2, "GetTexelRegion", y), int_arg(3, "GetTexelRegion", w), int_arg(4, "GetTexelRegion", h)
+  if w < 0 or h < 0 or w * h > MAX_SIDE * MAX_SIDE then error("GetTexelRegion: bad region", 2) end
+  if w == 0 or h == 0 or self._w == 0 or self._h == 0 then return "" end
+  local px = pixels(self)
+  local rows = {}
+  local blank = string.rep("\0", 4 * w)
+  for row = 0, h - 1 do
+    local sy = y + row
+    if sy < 0 or sy >= self._h then
+      rows[#rows + 1] = blank
+    else
+      local x0, x1 = math.max(x, 0), math.min(x + w, self._w)
+      if x1 <= x0 then rows[#rows + 1] = blank
+      else
+        rows[#rows + 1] = string.rep("\0", 4 * (x0 - x)) .. px:sub((sy * self._w + x0) * 4 + 1, (sy * self._w + x1) * 4) .. string.rep("\0", 4 * (x + w - x1))
+      end
+    end
+  end
+  return table.concat(rows)
+end
+
+------------------------------------------------------------------------------
+-- Image:Render(source, destination, kcolor, color) inside Renderer.RenderToImage
+------------------------------------------------------------------------------
+local target = nil          -- the image being drawn into by RenderToImage
+local publish              -- defined with the spritesheet functions below
+
+local function quad_points(q, scale_x, scale_y)
+  local function p(v) return v.X * scale_x, v.Y * scale_y end
+  local a, b = p(q._tl) local c, d = p(q._tr) local e, f = p(q._bl) local g, h = p(q._br)
+  return { a, b, c, d, e, f, g, h }
+end
+local function prop(o, ...)
+  for _, k in ipairs({ ... }) do
+    local ok, v = pcall(function() return o[k] end)
+    if ok and type(v) == "number" then return v end
+  end
+end
+local function quad_arg(n, fname, v, want)
+  if type(v) ~= "table" or v._tl == nil or getmetatable(v).__type ~= want then argerr(n, fname, want, v) end
+  return v
+end
+
+-- Image:Render on the screen: a temporary Sprite per (picture, source size). Its anm2 is made here (one layer, one frame of the
+-- source size, pivot 0) and seeded into the game's file layer under a drive-letter path (see "How it works" above); the layer's
+-- crop offset picks the source rectangle, the sprite's scale and rotation place the destination, its Color tints. Sprite
+-- scale and rotation cannot shear, so a destination quad must be a rectangle (rotated, scaled or mirrored); a sheared one is
+-- drawn as the rectangle of its top-left corner and two edges, and said once. Source quads must be axis-aligned rectangles.
+local ANM_HEAD = '<AnimatedActor><Info CreatedBy="rgon" CreatedOn="" Fps="30" Version="1"/><Content><Spritesheets><Spritesheet Id="0" Path="blit.png"/></Spritesheets><Layers><Layer Id="0" Name="Blit" SpritesheetId="0"/></Layers><Nulls/><Events/></Content><Animations DefaultAnimation="Idle"><Animation Name="Idle" FrameNum="1" Loop="true"><RootAnimation><Frame XPosition="0" YPosition="0" Delay="1" Visible="true" XScale="100" YScale="100" RedTint="255" GreenTint="255" BlueTint="255" AlphaTint="255" RedOffset="0" GreenOffset="0" BlueOffset="0" Rotation="0" Interpolated="false"/></RootAnimation><LayerAnimations><LayerAnimation LayerId="0" Visible="true"><Frame XPosition="0" YPosition="0" XPivot="0" YPivot="0" XCrop="0" YCrop="0" '
+local ANM_TAIL = ' XScale="100" YScale="100" Delay="1" Visible="true" RedTint="255" GreenTint="255" BlueTint="255" AlphaTint="255" RedOffset="0" GreenOffset="0" BlueOffset="0" Rotation="0" Interpolated="false"/></LayerAnimation></LayerAnimations><NullAnimations/><Triggers/></Animation></Animations></AnimatedActor>'
+local blit_ready = false
+local blit_anm = {}          -- "WxH" -> the anm2's path
+local blit_pool, blit_count = {}, 0
+local MAX_POOL = 48
+
+local function blit_sprite(path, sw, sh)
+  local key = path .. "|" .. sw .. "x" .. sh
+  local sp = blit_pool[key]
+  if sp then return sp end
+  if not blit_ready then
+    if not B.fs_seed("C:/rgon_images/anm/blit.png", B.png_encode(1, 1, "\255\255\255\255")) then return nil end
+    blit_ready = true
+  end
+  local size = sw .. "x" .. sh
+  local anm = blit_anm[size]
+  if not anm then
+    anm = "C:/rgon_images/anm/blit_" .. size .. ".anm2"
+    if not B.fs_seed(anm, ANM_HEAD .. 'Width="' .. sw .. '" Height="' .. sh .. '"' .. ANM_TAIL) then return nil end
+    blit_anm[size] = anm
+  end
+  if blit_count >= MAX_POOL then blit_pool, blit_count = {}, 0 end
+  sp = Sprite()
+  sp:Load(anm, true)
+  sp:Play("Idle", true)
+  sp:ReplaceSpritesheet(0, path)
+  sp:LoadGraphics()
+  blit_pool[key] = sp
+  blit_count = blit_count + 1
+  return sp
+end
+
+local function screen_render(self, src, dst, r, g, b, a, ro, go, bo)
+  local sq = quad_points(src, src._uv and self._w or 1, src._uv and self._h or 1)
+  local x0, y0, x1, y1 = sq[1], sq[2], sq[3], sq[4]           -- tl, tr
+  local x2, y2, x3, y3 = sq[5], sq[6], sq[7], sq[8]           -- bl, br
+  local eps = 1e-3
+  if math.abs(y0 - y1) > eps or math.abs(x0 - x2) > eps or math.abs(x3 - x1) > eps or math.abs(y3 - y2) > eps then
+    unsupported("Image:Render", "a source quad that is not an axis-aligned rectangle is not drawn on the screen")
+    return
+  end
+  local sw, sh = math.floor(math.abs(x1 - x0) + 0.5), math.floor(math.abs(y2 - y0) + 0.5)
+  if sw < 1 or sh < 1 or sw > MAX_SIDE or sh > MAX_SIDE then return end
+  local flipx, flipy = x1 < x0, y2 < y0
+  local cx, cy = math.floor(math.min(x0, x1) + 0.5), math.floor(math.min(y0, y2) + 0.5)
+  local path
+  if self._created then path = publish(self) else path = self._name end
+  local sp = blit_sprite(path, sw, sh)
+  if not sp then return end
+  local d = quad_points(dst, 1, 1)
+  local ex, ey = d[3] - d[1], d[4] - d[2]                      -- top-left to top-right
+  local fx, fy = d[5] - d[1], d[6] - d[2]                      -- top-left to bottom-left
+  local ox, oy = d[1], d[2]
+  if flipx then ox, oy, ex, ey = ox + ex, oy + ey, -ex, -ey end
+  if flipy then ox, oy, fx, fy = ox + fx, oy + fy, -fx, -fy end
+  local lx, ly = math.sqrt(ex * ex + ey * ey), math.sqrt(fx * fx + fy * fy)
+  if lx < 1e-6 or ly < 1e-6 then return end
+  if math.abs(ex * fx + ey * fy) > 1e-3 * lx * ly or math.abs((d[7] - d[3]) - fx) > 1e-3 * (lx + ly) then
+    unsupported("Image:Render", "a sheared destination quad is drawn as a rectangle of its top-left corner and two edges")
+  end
+  local sgn = (ex * fy - ey * fx) < 0 and -1 or 1
+  local layer = sp:GetLayer(0)
+  layer:SetCropOffset(Vector(cx, cy))
+  sp.Scale = Vector(lx / sw, sgn * ly / sh)
+  sp.Rotation = math.deg(math.atan(ey, ex))
+  sp.Color = Color(r, g, b, a, ro, go, bo)
+  sp:Render(Vector(ox, oy), Vector(0, 0), Vector(0, 0))
+end
+
+function Image:Render(src, dst, kcolor, mod)
+  image_arg(0, "Render", self)
+  quad_arg(1, "Render", src, "SourceQuad") quad_arg(2, "Render", dst, "DestinationQuad")
+  if type(kcolor) ~= "userdata" or prop(kcolor, "Red") == nil then argerr(3, "Render", "KColor", kcolor) end
+  if self._w == 0 or self._h == 0 then return end
+  local r, g, b, a = prop(kcolor, "Red") or 1, prop(kcolor, "Green") or 1, prop(kcolor, "Blue") or 1, prop(kcolor, "Alpha") or 1
+  local ro, go, bo = 0, 0, 0
+  if mod ~= nil then
+    r, g, b, a = r * (prop(mod, "R") or 1), g * (prop(mod, "G") or 1), b * (prop(mod, "B") or 1), a * (prop(mod, "A") or 1)
+    ro, go, bo = prop(mod, "RO") or 0, prop(mod, "GO") or 0, prop(mod, "BO") or 0
+  end
+  if target == nil then return screen_render(self, src, dst, r, g, b, a, ro, go, bo) end
+  if target._w == 0 or target._h == 0 then return end
+  local sq = quad_points(src, src._uv and self._w or 1, src._uv and self._h or 1)
+  local dq = quad_points(dst, 1, 1)
+  target._pix = B.img_blit(pixels(target), target._w, target._h, pixels(self), self._w, self._h, sq, dq, r, g, b, a, ro, go, bo)
+  target._dirty = true
+end
+
+-- a stand-in (not registered): shader programs need the engine's renderer
+function Image:RenderWithShader()
+  unsupported("Image:RenderWithShader", "a shader program of a mod's own is not run")
+end
+
+------------------------------------------------------------------------------
+-- Renderer.LoadImage / CreateImage / RenderToImage
+------------------------------------------------------------------------------
+local Rn = rawget(_G, "Renderer")
+if type(Rn) ~= "table" then log("api_gfx: no Renderer table") return end
+local loaded = {}           -- path asked -> {bytes, w, h, found} (the file is read once)
+
+function Rn.LoadImage(path)
+  if type(path) ~= "string" then argerr(1, "LoadImage", "string", path) end
+  local e = loaded[path]
+  if e == nil then
+    local bytes, found = find_png(path)
+    local w, h = nil, nil
+    if bytes then w, h = B.png_size(bytes) end
+    e = { bytes = bytes, w = w, h = h, found = found }
+    if not w then e = false end
+    loaded[path] = e
+  end
+  if not e then error("Unable to load image '" .. path .. "'", 2) end
+  return new_image(e.w, e.h, path, { _bytes = e.bytes, _file = e.found })
+end
+
+function Rn.CreateImage(w, h, name)
+  w, h = int_arg(1, "CreateImage", w), int_arg(2, "CreateImage", h)
+  if type(name) ~= "string" then argerr(3, "CreateImage", "string", name) end
+  if w < 0 or h < 0 or w > MAX_SIDE or h > MAX_SIDE then error("Unable to create Image", 2) end
+  return new_image(w, h, name, { _created = true })
+end
+
+local controller_mt = { __index = {}, __type = "SurfaceRenderController", __name = "SurfaceRenderController" }
+function controller_mt.__index.Clear(self)
+  if self._img == nil then error("This surface render controller has already been applied and cannot be used again", 2) end
+  local img = self._img
+  img._pix = string.rep("\0", img._w * img._h * 4)
+  img._dirty = true
+end
+
+-- Sprite drawing into an image needs the engine's render target: while the function runs, the sprite render calls
+-- do nothing (they would draw on the screen), and say so once.
+local SPRITE_DRAWS = { "Render", "RenderLayer" }
+function Rn.RenderToImage(image, f)
+  image_arg(1, "RenderToImage", image)
+  if type(f) ~= "function" then argerr(2, "RenderToImage", "function", f) end
+  if not image._created then error("Cannot use a non procedural image as the render target", 2) end
+  if target ~= nil then error("RenderToImage cannot be nested", 2) end
+  local sc = T.class_tables("Sprite")
+  local saved = {}
+  for _, n in ipairs(SPRITE_DRAWS) do
+    saved[n] = rawget(sc, n)
+    if saved[n] then
+      rawset(sc, n, B.cfn(function() unsupported("Sprite:" .. n .. " into an Image", "a sprite drawn into an Image (needs the engine's render target)") end))
+    end
+  end
+  target = image
+  local ctl = setmetatable({ _img = image }, controller_mt)
+  local ok, err = pcall(f, ctl)
+  target = nil
+  ctl._img = nil
+  for n, v in pairs(saved) do rawset(sc, n, v) end
+  if not ok then error(err, 0) end
+end
+
+R.Implemented["Renderer.CreateImage"] = true
+R.Implemented["Renderer.RenderToImage"] = true
+R.Implemented["Renderer.LoadImage"] = true
+for _, n in ipairs({ "GetWidth", "GetHeight", "GetName", "GetTexelRegion", "Render" }) do R.Implemented["Image." .. n] = true end
+
+------------------------------------------------------------------------------
+-- SourceQuad:ConvertToUVSpace(image) / ConvertToPixelSpace(image)
+------------------------------------------------------------------------------
+do
+  local ok, q = pcall(function() return SourceQuad(Vector(0, 0), Vector(1, 0), Vector(0, 1), Vector(1, 1)) end)
+  local mt = ok and getmetatable(q)
+  local Q = type(mt) == "table" and mt.__index
+  if type(Q) == "table" then
+    local function convert(fname, to_uv)
+      return function(self, image)
+        image_arg(1, fname, image)
+        if (self._uv == true) == to_uv then return end
+        local fx, fy
+        if to_uv then fx, fy = 1 / image._w, 1 / image._h else fx, fy = image._w, image._h end
+        for _, k in ipairs({ "_tl", "_tr", "_bl", "_br" }) do self[k] = Vector(self[k].X * fx, self[k].Y * fy) end
+        self._uv = to_uv or nil
+      end
+    end
+    Q.ConvertToUVSpace = convert("ConvertToUVSpace", true)
+    Q.ConvertToPixelSpace = convert("ConvertToPixelSpace", false)
+    R.Implemented["SourceQuad.ConvertToUVSpace"] = true
+    R.Implemented["SourceQuad.ConvertToPixelSpace"] = true
+  end
+end
+
+------------------------------------------------------------------------------
+-- Sprite / LayerState GetSpritesheet, SetSpritesheet
+------------------------------------------------------------------------------
+-- A created image is published when it is bound: its PNG goes into the game's file layer under a name of its own
+-- (a new name for each version, since the game keeps an image of a name while anything uses it) and the game's
+-- ReplaceSpritesheet + LoadGraphics read it from there.
+publish = function(img)
+  if img._w == 0 or img._h == 0 then error("SetSpritesheet: the image has no pixels", 3) end
+  if img._vpath and not img._dirty then return img._vpath end
+  serial = serial + 1
+  local safe = img._name:gsub("[^%w_%-]", "_"):sub(1, 40)
+  local vpath = "C:/rgon_images/gfx/" .. safe .. "_" .. serial .. ".png"
+  local png = B.png_encode(img._w, img._h, pixels(img))
+  if not B.fs_seed(vpath, png) then error("SetSpritesheet: the image could not be stored", 3) end
+  created_by_path[vpath] = img
+  img._vpath, img._dirty = vpath, false
+  return vpath
+end
+local function bind(sprite, layer_id, image)
+  image_arg(2, "SetSpritesheet", image)
+  local path
+  if image._created then path = publish(image) else path = image._name end
+  sprite:ReplaceSpritesheet(layer_id, path)
+  sprite:LoadGraphics()
+end
+local function sheet_of(layer)
+  local path = layer:GetSpritesheetPath()
+  if created_by_path[path] then return created_by_path[path] end
+  local ok, img = pcall(Rn.LoadImage, path)
+  return ok and img or nil
+end
+
+define("Sprite", "GetSpritesheet", function(self, layer_id)
+  this(self, "GetSpritesheet")
+  if mathtype(layer_id) ~= "integer" then argerr(1, "GetSpritesheet", "integer", layer_id) end
+  local l = self:GetLayer(layer_id)
+  return l and sheet_of(l) or nil
+end)
+define("Sprite", "SetSpritesheet", function(self, layer_id, image)
+  this(self, "SetSpritesheet")
+  if mathtype(layer_id) ~= "integer" then argerr(1, "SetSpritesheet", "integer", layer_id) end
+  if self:GetLayer(layer_id) == nil then error("SetSpritesheet: no layer " .. layer_id, 2) end
+  bind(self, layer_id, image)
+end)
+
+do
+  local layer_methods
+  local ok, l = pcall(function() local s = Sprite() s:Load("gfx/001.000_player.anm2", true) return s:GetLayer(0) end)
+  local mt = ok and l ~= nil and getmetatable(l)
+  layer_methods = type(mt) == "table" and type(rawget(mt, "__index")) == "table" and rawget(mt, "__index") or nil
+  if layer_methods then
+    local function ldef(name, f) rawset(layer_methods, name, f) R.Implemented["LayerState." .. name] = true end
+    ldef("GetSpritesheet", function(self) return sheet_of(self) end)
+    -- a layer state points back at its sprite (+4, as rgon.lua's GetLayer checks)
+    ldef("SetSpritesheet", function(self, image)
+      local la = this(self, "SetSpritesheet")
+      bind(T.wrap("Sprite", B.r32(la + 4)), self:GetLayerID(), image)
+    end)
+  else
+    log("api_gfx: the LayerState class was not found")
+  end
+end
