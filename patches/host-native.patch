diff --git a/scripts/recomp/rgon/lab_music_probe.lua b/scripts/recomp/rgon/lab_music_probe.lua
new file mode 100644
index 0000000..d2d2461
--- /dev/null
+++ b/scripts/recomp/rgon/lab_music_probe.lua
@@ -0,0 +1,84 @@
+-- lab_music_probe.lua (development only; ISAAC_RGON_LAB=lab_music_probe.lua): dumps the game's music table
+-- (MusicManager object +0x31c begin / +0x320 end, 0x60-byte entries: id +0, name +4, intro path +0x1c, track path +0x34,
+-- size of the track path +0x44) at mod load, at the title, in the first rooms. The game warns "no music for ID n" when an
+-- entry's track path (+0x34) is empty.
+local T = ...
+local B = T.B
+local r32, ptr, stdstr = B.r32, B.ptr, B.stdstr
+local mod = RegisterMod("rgon lab music probe", 1)
+local function say(s) B.log("lab_music_probe: " .. s) end
+local function dump(tag)
+  local ok, err = pcall(function()
+    local mm = ptr(MusicManager())
+    local b, e = r32(mm + 0x31c), r32(mm + 0x320)
+    say(string.format("%s: mm=0x%x table 0x%x..0x%x entries=%d cur=%s", tag, mm, b, e, (e - b) // 0x60, tostring(MusicManager():GetCurrentMusicID())))
+    for i = 1, 5 do
+      local a = b + i * 0x60
+      say(string.format("%s: [%d] id=%d name='%s' intro='%s' track='%s' tracklen=%d", tag, i, r32(a), stdstr(a + 4), stdstr(a + 0x1c), stdstr(a + 0x34), r32(a + 0x44)))
+    end
+    local blank = 0
+    for i = 1, 119 do if r32(b + i * 0x60 + 0x44) == 0 then blank = blank + 1 end end
+    say(string.format("%s: blank track entries among 1..119: %d", tag, blank))
+  end)
+  if not ok then say(tag .. ": ERR " .. tostring(err)) end
+end
+dump("modload")
+local menu, rooms = false, 0
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  if menu then return end
+  menu = true
+  dump("title")
+end)
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  rooms = rooms + 1
+  if rooms <= 2 then dump("room" .. rooms) end
+end)
+mod:AddCallback(ModCallbacks.MC_PRE_MUSIC_PLAY, function(_, id, vol)
+  say("PRE_MUSIC_PLAY id=" .. tostring(id) .. " vol=" .. tostring(vol))
+end)
+
+-- room hopping (ISAAC_LAB_HOPS = how many, default 0): after the start room, every 240 updates go to the next room of the
+-- floor (Game():ChangeRoom) and log what the game and the music mod do: the order of PRE_MUSIC_PLAY (the game's own
+-- Play/Crossfade calls and the mod's) against POST_NEW_ROOM, the current/queued music id every 60 updates.
+local hops = tonumber(B.env("ISAAC_LAB_HOPS") or "") or 0
+local upd, hopped, idx_list = 0, 0, nil
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  say(string.format("NEW_ROOM upd=%d idx=%d cur=%s queued=%s", upd, Game():GetLevel():GetCurrentRoomIndex(),
+    tostring(MusicManager():GetCurrentMusicID()), tostring(MusicManager():GetQueuedMusicID())))
+end)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  upd = upd + 1
+  if upd > 0 and upd % 60 == 0 then
+    say(string.format("tick upd=%d cur=%s queued=%s", upd, tostring(MusicManager():GetCurrentMusicID()), tostring(MusicManager():GetQueuedMusicID())))
+  end
+  if hops > 0 and hopped < hops and upd >= 700 and upd % 240 == 0 then
+    local level = Game():GetLevel()
+    if not idx_list then
+      idx_list = {}
+      local rooms = level:GetRooms()
+      for i = 0, rooms.Size - 1 do
+        local d = rooms:Get(i)
+        if d and d.Data and d.SafeGridIndex ~= level:GetStartingRoomIndex() and d.Data.Type == RoomType.ROOM_DEFAULT then
+          idx_list[#idx_list + 1] = d.SafeGridIndex
+        end
+      end
+    end
+    hopped = hopped + 1
+    local to = idx_list[hopped] or level:GetStartingRoomIndex()
+    say(string.format("HOP %d to room %d (upd %d)", hopped, to, upd))
+    Game():ChangeRoom(to)
+  end
+end)
+
+-- ISAAC_LAB_KILL=N: at update N call MusicManager():Crossfade(<vanilla id>, 0.02) like the game's own room-music code does
+-- (the id is the stage's vanilla track, whose entry the music mod's resources/music.xml removed): shows whether the
+-- music mod's track survives the game's own call (compare the "[mac][audio]" voices/rms lines before and after).
+local kill = tonumber(B.env("ISAAC_LAB_KILL") or "") or 0
+local kid = tonumber(B.env("ISAAC_LAB_KILL_ID") or "") or 14
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if kill > 0 and upd == kill then
+    say(string.format("KILL: Crossfade(%d) upd=%d cur=%s", kid, upd, tostring(MusicManager():GetCurrentMusicID())))
+    MusicManager():Crossfade(kid, 0.02)
+    say(string.format("KILL: after cur=%s queued=%s", tostring(MusicManager():GetCurrentMusicID()), tostring(MusicManager():GetQueuedMusicID())))
+  end
+end)
