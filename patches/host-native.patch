+-- lab_cb_e.lua (development only; ISAAC_RGON_LAB=lab_cb_e.lua, worker cb-e)
+-- Fires the weapon / laser / knife callbacks with real items and checks the counts and arguments the game itself produces:
+-- 1105 and 1098 (tears), 1257 (Mom's Knife), 1258 (Spirit Sword), 1254 (bone club), 1248/1249 (laser collision; a true answer
+-- on 1248 stops 1249), 1036/1037 (Hemoptysis sneeze), 1261/1262 (familiar brimstone / tech laser).
+-- Prints "lab_cb_e: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE; a step that waits has a frame limit.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-e", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_e: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_e: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function reset(n) rec[n] = {} end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.Type ~= nil and v.Variant ~= nil and v.GetData then return "ent:" .. v.Type .. "." .. v.Variant end
+      if v.X ~= nil then return string.format("vec:%.2f,%.2f", v.X, v.Y) end
+      if v.GetWeaponType then return "weapon:" .. v:GetWeaponType() end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = { "MC_POST_TRIGGER_WEAPON_FIRED", "MC_POST_WEAPON_FIRE", "MC_PRE_LASER_COLLISION", "MC_POST_LASER_COLLISION",
+  "MC_POST_FIRE_BONE_CLUB", "MC_POST_FIRE_KNIFE", "MC_POST_FIRE_SWORD", "MC_POST_FAMILIAR_FIRE_BRIMSTONE",
+  "MC_POST_FAMILIAR_FIRE_TECH_LASER", "MC_PRE_BRIMSTONE_SNEEZE", "MC_POST_BRIMSTONE_SNEEZE" }
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 3 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+
+local game = Game()
+local function pl() return Isaac.GetPlayer(0) end
+local base = {}
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond) waiting, wait_left, wait_what, wait_cond = true, frames, what, cond end
+local function clear_all() for _, n in ipairs(NAMES) do reset(n) beh[n] = nil end end
+local function item(name) return CollectibleType[name] end
+local function give(name)
+  local id = item(name)
+  if not id then check(false, "CollectibleType." .. name .. " exists") return false end
+  pl():AddCollectible(id, 0, false)
+  return true
+end
+local function take(name)
+  local id = item(name)
+  if id and pl():HasCollectible(id) then pl():RemoveCollectible(id) end
+  pl():AddCacheFlags(CacheFlag.CACHE_ALL) pl():EvaluateItems()
+end
+local function shoot(on) base.shoot = on end
+local function enemy()
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e:IsActiveEnemy(false) then e:Remove() end
+  end
+  local e = Isaac.Spawn(EntityType.ENTITY_MONSTRO, 0, 0, pl().Position + Vector(160, 0), Vector(0, 0), nil)
+  e:AddEntityFlags(EntityFlag.FLAG_FREEZE)
+end
+
+-- 0. tears: POST_WEAPON_FIRE and POST_TRIGGER_WEAPON_FIRED
+step(function()
+  clear_all()
+  Isaac.ExecuteCommand("debug 3")
+  shoot(true)
+  wait("tears fired", 120, function() return count("MC_POST_TRIGGER_WEAPON_FIRED") > 0 and count("MC_POST_WEAPON_FIRE") > 0 end)
+end)
+step(function()
+  shoot(false)
+  local f, t = last("MC_POST_WEAPON_FIRE"), last("MC_POST_TRIGGER_WEAPON_FIRED")
+  check(f ~= nil and f.n == 4 and f[2].X ~= nil, "MC_POST_WEAPON_FIRE (weapon, dir, shooting, interpolated): " .. tostring(f and f.text))
+  check(f ~= nil and type(f[3]) == "boolean" and type(f[4]) == "boolean", "its last two arguments are booleans")
+  check(f ~= nil and f[1]:GetWeaponType() == WeaponType.WEAPON_TEARS, "the Weapon handed over is a tears weapon")
+  check(f ~= nil and f[1]:GetOwner().Type == 1, "the Weapon's owner is the player")
+  check(t ~= nil and t.n == 4 and t[2] == 1 and t[3].Type == 1, "MC_POST_TRIGGER_WEAPON_FIRED (dir, amount 1, player, weapon): " .. tostring(t and t.text))
+  check(t ~= nil and t[1].X ~= nil and (t[1].X ~= 0 or t[1].Y ~= 0), "its direction is a non-zero Vector (the aim)")
+  -- a filter on the weapon type
+  local hit_other = 0
+  local m2 = RegisterMod("rgon lab cb-e param", 1)
+  m2:AddCallback(M.MC_POST_WEAPON_FIRE, function() hit_other = hit_other + 1 end, WeaponType.WEAPON_LASER)
+  reset("MC_POST_WEAPON_FIRE")
+  shoot(true)
+  wait("frames", 25, function() return false end)
+  base.m2 = m2 base.hit_other = function() return hit_other end
+end)
+step(function()
+  shoot(false)
+  check(count("MC_POST_WEAPON_FIRE") > 0 and base.hit_other() == 0, "a WEAPON_LASER filter does not hear tears: " .. count("MC_POST_WEAPON_FIRE") .. " tears fires, " .. base.hit_other() .. " laser hears")
+end)
+
+-- 1. Mom's Knife -> POST_FIRE_KNIFE
+step(function()
+  clear_all()
+  if give("COLLECTIBLE_MOMS_KNIFE") then
+    shoot(true)
+    wait("knife fired", 150, function() return count("MC_POST_FIRE_KNIFE") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local k = last("MC_POST_FIRE_KNIFE")
+  check(k ~= nil and k.n == 1 and k[1].Type == 8, "MC_POST_FIRE_KNIFE gets an EntityKnife: " .. tostring(k and k.text))
+  take("COLLECTIBLE_MOMS_KNIFE")
+end)
+
+-- 2. Spirit Sword -> POST_FIRE_SWORD
+step(function()
+  clear_all()
+  if give("COLLECTIBLE_SPIRIT_SWORD") then
+    shoot(true)
+    wait("sword swung", 150, function() return count("MC_POST_FIRE_SWORD") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local k = last("MC_POST_FIRE_SWORD")
+  check(k ~= nil and k.n == 1 and k[1].Type == 8, "MC_POST_FIRE_SWORD gets an EntityKnife: " .. tostring(k and k.text))
+  take("COLLECTIBLE_SPIRIT_SWORD")
+end)
+
+-- 3. a straight laser (Technology) hits an enemy: PRE and POST_LASER_COLLISION, and a true answer stops both
+step(function()
+  clear_all()
+  enemy()
+  if give("COLLECTIBLE_TECHNOLOGY") then
+    shoot(true)
+    wait("tech laser hits", 200, function() return count("MC_POST_LASER_COLLISION") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local a, b = last("MC_PRE_LASER_COLLISION"), last("MC_POST_LASER_COLLISION")
+  check(count("MC_PRE_LASER_COLLISION") > 0, "MC_PRE_LASER_COLLISION fired (straight laser): " .. count("MC_PRE_LASER_COLLISION"))
+  check(a ~= nil and a.n == 2 and a[1].Type == 7 and a[2].Type ~= nil, "PRE gets (laser, collider): " .. tostring(a and a.text))
+  check(b ~= nil and b.n == 2 and b[1].Type == 7, "POST gets (laser, collider): " .. tostring(b and b.text))
+  check(count("MC_PRE_LASER_COLLISION") >= count("MC_POST_LASER_COLLISION"), "PRE runs at least as often as POST: " .. count("MC_PRE_LASER_COLLISION") .. " / " .. count("MC_POST_LASER_COLLISION"))
+  -- the answer true ignores the collision: POST stays quiet
+  beh.MC_PRE_LASER_COLLISION = function() return true end
+  reset("MC_POST_LASER_COLLISION") reset("MC_PRE_LASER_COLLISION")
+  shoot(true)
+  wait("frames", 60, function() return false end)
+end)
+step(function()
+  shoot(false)
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") == 0,
+    "answering true on PRE: " .. count("MC_PRE_LASER_COLLISION") .. " PRE, " .. count("MC_POST_LASER_COLLISION") .. " POST (none)")
+  beh.MC_PRE_LASER_COLLISION = nil
+  take("COLLECTIBLE_TECHNOLOGY")
+end)
+
+-- 3b. a straight-only laser (Technology 2)
+step(function()
+  clear_all()
+  enemy()
+  if give("COLLECTIBLE_TECHNOLOGY_2") then
+    shoot(true)
+    wait("tech 2 hits", 300, function() return count("MC_POST_LASER_COLLISION") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local a = last("MC_PRE_LASER_COLLISION")
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") > 0, "tech 2: PRE " .. count("MC_PRE_LASER_COLLISION") .. ", POST " .. count("MC_POST_LASER_COLLISION"))
+  beh.MC_PRE_LASER_COLLISION = function() return true end
+  reset("MC_POST_LASER_COLLISION") reset("MC_PRE_LASER_COLLISION")
+  shoot(true)
+  wait("frames", 60, function() return false end)
+end)
+step(function()
+  shoot(false)
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") == 0,
+    "tech 2, answer true on PRE: " .. count("MC_PRE_LASER_COLLISION") .. " PRE, " .. count("MC_POST_LASER_COLLISION") .. " POST (none)")
+  beh.MC_PRE_LASER_COLLISION = nil
+  take("COLLECTIBLE_TECHNOLOGY_2")
+end)
+
+-- 3c. every laser variant shot at the enemy with EntityLaser.ShootAngle: which collision path each takes is in the log
+-- ("api_weapons: ... ran its first callback, laser variant N")
+step(function()
+  clear_all()
+  enemy()
+  base.shot = 0
+  for v = 1, 14 do
+    local ok, l = pcall(EntityLaser.ShootAngle, v, pl().Position, 0, 20, Vector(0, 0), pl())
+    if ok and l then base.shot = base.shot + 1 end
+  end
+  wait("frames", 40, function() return false end)
+end)
+step(function()
+  say("lasers shot: " .. tostring(base.shot) .. ", PRE " .. count("MC_PRE_LASER_COLLISION") .. " POST " .. count("MC_POST_LASER_COLLISION"))
+  check(base.shot > 0 and count("MC_PRE_LASER_COLLISION") > 0, "ShootAngle lasers of every variant: PRE " .. count("MC_PRE_LASER_COLLISION"))
+end)
+
+-- 4. Brimstone (a laser with a sample curve in vanilla) hits the enemy
+step(function()
+  clear_all()
+  enemy()
+  if give("COLLECTIBLE_BRIMSTONE") then
+    shoot(true)
+    wait("brimstone hits", 200, function() return count("MC_POST_LASER_COLLISION") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local a, b = last("MC_PRE_LASER_COLLISION"), last("MC_POST_LASER_COLLISION")
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") > 0, "brimstone: PRE " .. count("MC_PRE_LASER_COLLISION") .. ", POST " .. count("MC_POST_LASER_COLLISION"))
+  check(a ~= nil and a[1].Type == 7, "brimstone PRE gets a laser: " .. tostring(a and a.text))
+  beh.MC_PRE_LASER_COLLISION = function() return true end
+  reset("MC_POST_LASER_COLLISION") reset("MC_PRE_LASER_COLLISION")
+  shoot(true)
+  wait("frames", 60, function() return false end)
+end)
+step(function()
+  shoot(false)
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") == 0,
+    "brimstone, answer true on PRE: " .. count("MC_PRE_LASER_COLLISION") .. " PRE, " .. count("MC_POST_LASER_COLLISION") .. " POST (none)")
+  beh.MC_PRE_LASER_COLLISION = nil
+  take("COLLECTIBLE_BRIMSTONE")
+end)
+
+-- 6. familiars: Incubus with Brimstone, Lil Brimstone, Incubus with Technology
+step(function()
+  clear_all()
+  local ok = give("COLLECTIBLE_LIL_BRIMSTONE")
+  if ok then
+    pl():AddCacheFlags(CacheFlag.CACHE_FAMILIARS) pl():EvaluateItems()
+    shoot(true)
+    wait("lil brimstone", 250, function() return count("MC_POST_FAMILIAR_FIRE_BRIMSTONE") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local a = last("MC_POST_FAMILIAR_FIRE_BRIMSTONE")
+  check(a ~= nil and a.n == 1 and a[1].Type == 7, "MC_POST_FAMILIAR_FIRE_BRIMSTONE gets an EntityLaser: " .. tostring(a and a.text))
+  take("COLLECTIBLE_LIL_BRIMSTONE")
+end)
+step(function()
+  clear_all()
+  local a, b = give("COLLECTIBLE_ROBO_BABY_2"), true
+  if a and b then
+    local hits = 0
+    RegisterMod("rgon lab cb-e v53", 1):AddCallback(M.MC_POST_FAMILIAR_FIRE_TECH_LASER, function() hits = hits + 1 end, 53)
+    base.v53 = function() return hits end
+    pl():AddCacheFlags(CacheFlag.CACHE_FAMILIARS) pl():EvaluateItems()
+    shoot(true)
+    wait("robo-baby 2.0 tech laser", 400, function() return count("MC_POST_FAMILIAR_FIRE_TECH_LASER") > 0 end)
+  end
+end)
+step(function()
+  shoot(false)
+  local a = last("MC_POST_FAMILIAR_FIRE_TECH_LASER")
+  check(a ~= nil and a.n == 1 and a[1].Type == 7, "MC_POST_FAMILIAR_FIRE_TECH_LASER (Robo-Baby 2.0, variant 53) gets an EntityLaser: " .. tostring(a and a.text))
+  check(base.v53 and base.v53() > 0, "a filter on the familiar variant 53 (Robo-Baby 2.0) hears it: " .. tostring(base.v53 and base.v53()))
+  -- the straight laser path (Robo-Baby 2.0's laser takes it): a true answer on PRE stops the POST
+  clear_all()
+  beh.MC_PRE_LASER_COLLISION = function() return true end
+  shoot(true)
+  wait("frames", 300, function() return false end)
+end)
+step(function()
+  shoot(false)
+  check(count("MC_PRE_LASER_COLLISION") > 0 and count("MC_POST_LASER_COLLISION") == 0,
+    "Robo-Baby 2.0, answer true on PRE: " .. count("MC_PRE_LASER_COLLISION") .. " PRE, " .. count("MC_POST_LASER_COLLISION") .. " POST (none)")
+  beh.MC_PRE_LASER_COLLISION = nil
+  take("COLLECTIBLE_ROBO_BABY_2")
+end)
+
+-- 7. the bone club: The Forgotten's club
+step(function()
+  clear_all()
+  Isaac.ExecuteCommand("restart 16")
+  wait("restart", 120, function() return false end)
+end)
+step(function()
+  say("player type " .. tostring(pl():GetPlayerType()))
+  Isaac.ExecuteCommand("debug 3")
+  shoot(true)
+  wait("bone club", 200, function() return count("MC_POST_FIRE_BONE_CLUB") > 0 end)
+end)
+step(function()
+  shoot(false)
+  local a = last("MC_POST_FIRE_BONE_CLUB")
+  check(a ~= nil and a.n == 1 and a[1].Type == 8, "MC_POST_FIRE_BONE_CLUB gets an EntityKnife: " .. tostring(a and a.text))
+end)
+
+-- 5. the sneeze: Hemoptysis, then (Tainted) Azazel
+local function sneeze_check(label)
+  local a, b = last("MC_PRE_BRIMSTONE_SNEEZE"), last("MC_POST_BRIMSTONE_SNEEZE")
+  check(count("MC_PRE_BRIMSTONE_SNEEZE") > 0 and count("MC_PRE_BRIMSTONE_SNEEZE") == count("MC_POST_BRIMSTONE_SNEEZE"),
+    label .. ": PRE " .. count("MC_PRE_BRIMSTONE_SNEEZE") .. " = POST " .. count("MC_POST_BRIMSTONE_SNEEZE"))
+  check(a ~= nil and a.n == 3 and a[1].Type == 1 and a[2].X ~= nil and type(a[3]) == "number" and a[3] > 0,
+    label .. " PRE (source player, direction, damage scale): " .. tostring(a and a.text))
+  check(b ~= nil and a ~= nil and b.text == a.text, label .. " POST gets the same arguments")
+end
+for _, ty in ipairs({ 28 }) do
+  step(function()
+    clear_all()
+    Isaac.ExecuteCommand("restart " .. ty)
+    wait("restart", 120, function() return false end)
+  end)
+  step(function()
+    say("player type " .. tostring(pl():GetPlayerType()))
+    Isaac.ExecuteCommand("debug 3")
+    enemy()
+    shoot(true)
+    wait("the sneeze of type " .. ty, 500, function() return count("MC_POST_BRIMSTONE_SNEEZE") > 0 end)
+  end)
+  step(function()
+    shoot(false)
+    sneeze_check("player type " .. ty)
+  end)
+end
+
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if not base.shoot or not ent or ent.Type ~= 1 or action ~= ButtonAction.ACTION_SHOOTRIGHT then return end
+  if Isaac.GetFrameCount() % 120 >= 80 then return end   -- hold, then release: charged weapons fire on release
+  if hook == InputHook.IS_ACTION_PRESSED then return true end
+  if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+end)
+
+local frame, i = 0, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "frames" and wait_what ~= "restart" then check(false, "timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    if i == #steps + 1 then B.log(string.format("lab_cb_e: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
diff --git a/scripts/recomp/rgon/lab_cb_f.lua b/scripts/recomp/rgon/lab_cb_f.lua
new file mode 100644
index 0000000..4bfce3f
--- /dev/null
+++ b/scripts/recomp/rgon/lab_cb_f.lua
@@ -0,0 +1,383 @@
+-- lab_cb_f.lua (development only; ISAAC_RGON_LAB=lab_cb_f.lua, worker cb-f)
+-- Fires the level and room callbacks and checks the counts and arguments the game itself produces: 1137 (level generation, a
+-- replacement room shows up in the level), 1141 (backdrop change, an integer answer changes the room's backdrop), 1263, 1271
+-- (a room transition), 1472 (Isaac.ClearChallenge), 1488 / 1489 (Ambush waves, a Greed wave), 1190 ('M), 1224 (custom cache).
+-- Also the diff probe that measured the player's cache flags word (+0x1574).
+-- Prints "lab_cb_f: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE; a step that waits has a frame limit.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-f", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_f: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_f: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function reset(n) rec[n] = {} end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.GenerationIndex then return "lgr:" .. v:GenerationIndex() .. "/" .. v:Column() .. "," .. v:Row() .. "/" .. v:Shape() .. "/" .. v:DoorMask() end
+      if v.Type ~= nil and v.Variant ~= nil then return "cfg:" .. v.Type .. "." .. v.Variant end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = { "MC_PRE_LEVEL_PLACE_ROOM", "MC_PRE_BACKDROP_CHANGE", "MC_IS_PERSISTENT_ROOM_ENTITY", "MC_POST_ROOM_TRANSITION_UPDATE",
+  "MC_POST_CHALLENGE_DONE", "MC_POST_START_AMBUSH_WAVE", "MC_POST_START_GREED_WAVE", "MC_PRE_M_MORPH_ACTIVE", "MC_EVALUATE_CUSTOM_CACHE" }
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      local a1 = (...)
+      if type(a1) == "userdata" and a1.GenerationIndex then   -- the slot lives on the game's stack only during the call
+        r.snap = { idx = a1:GenerationIndex(), col = a1:Column(), row = a1:Row(), shape = a1:Shape(), doors = a1:DoorMask() }
+      end
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 3 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+
+local game = Game()
+local function pl() return Isaac.GetPlayer(0) end
+local base = {}
+local steps = {}
+local frame, i = 0, 0
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond) waiting, wait_left, wait_what, wait_cond = true, frames, what, cond end
+
+-- 0. what the level generation already did before the lab's first step (the run started with the callback armed)
+step(function()
+  check(count("MC_PRE_LEVEL_PLACE_ROOM") > 0, "MC_PRE_LEVEL_PLACE_ROOM fired during the first floor's generation: " .. count("MC_PRE_LEVEL_PLACE_ROOM"))
+  local l = last("MC_PRE_LEVEL_PLACE_ROOM")
+  check(l ~= nil and l.n == 3 and l.snap ~= nil and l[2].Type ~= nil and math.type(l[3]) == "integer", "its arguments are (LevelGeneratorRoom, RoomConfigRoom, seed): " .. tostring(l and l.text))
+  local sl = l and l.snap
+  check(sl ~= nil and sl.col >= 0 and sl.col < 13 and sl.row >= 0 and sl.row < 13 and sl.shape >= 1 and sl.shape <= 12 and sl.doors >= 0 and sl.doors < 256,
+    string.format("LevelGeneratorRoom column %s row %s shape %s doors %s are in range", tostring(sl and sl.col), tostring(sl and sl.row), tostring(sl and sl.shape), tostring(sl and sl.doors)))
+  local idx = {}
+  for _, r in ipairs(rec["MC_PRE_LEVEL_PLACE_ROOM"] or {}) do idx[#idx + 1] = r.snap.idx end
+  -- the generator numbers the rooms of a floor 0 .. n-1 (in no placement order): the indexes are all different and below n
+  local seen, distinct = {}, #idx > 3
+  for _, v in ipairs(idx) do if seen[v] or v < 0 or v >= #idx then distinct = false end seen[v] = true end
+  check(distinct, "GenerationIndex numbers the floor's rooms 0 to n-1, each once: " .. table.concat(idx, ",", 1, math.min(#idx, 12)))
+  -- the cache flags probe
+  local p = pl()
+  local pa = B.ptr(p)
+  p:EvaluateItems()
+  local A, Bs, C = {}, {}, {}
+  for o = 0, 0x2400, 4 do A[o] = B.r32(pa + o) end
+  p:AddCacheFlags(1)
+  for o = 0, 0x2400, 4 do Bs[o] = B.r32(pa + o) end
+  p:AddCacheFlags(2)
+  for o = 0, 0x2400, 4 do C[o] = B.r32(pa + o) end
+  local found
+  for o = 0, 0x2400, 4 do
+    if A[o] == 0 and Bs[o] == 1 and C[o] == 3 then found = found or o say(string.format("cache flags candidate +0x%x", o)) end
+  end
+  check(found == 0x1574, "the player's cache flags word is at +0x1574 (found " .. string.format("0x%x", found or -1) .. ")")
+  p:EvaluateItems()
+end)
+
+-- 1. a replacement room: every default 1x1 room (not the start room) becomes Basement variant 5; reseed regenerates the floor
+step(function()
+  reset("MC_PRE_LEVEL_PLACE_ROOM")
+  base.replaced = 0
+  beh.MC_PRE_LEVEL_PLACE_ROOM = function(slot, cfg, seed)
+    if cfg.Type == RoomType.ROOM_DEFAULT and cfg.Shape == RoomShape.ROOMSHAPE_1x1 then
+      local r = RoomConfigHolder.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 5)
+      if r and r.Shape == cfg.Shape then base.replaced = base.replaced + 1 return r end
+    end
+  end
+  Isaac.ExecuteCommand("reseed")
+  wait("reseeded floor", 200, function() return count("MC_PRE_LEVEL_PLACE_ROOM") > 3 end)
+end)
+step(function()
+  beh.MC_PRE_LEVEL_PLACE_ROOM = nil
+  wait("frames", 15, function() return false end)
+end)
+step(function()
+  local level = game:GetLevel()
+  local n5 = 0
+  for i = 0, 168 do
+    local d = level:GetRoomByIdx(i)
+    if d and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT and d.Data.Variant == 5 and d.Data.StageID == StbType.BASEMENT then n5 = n5 + 1 end
+  end
+  check(base.replaced > 0, "the callback replaced " .. base.replaced .. " rooms")
+  check(n5 >= base.replaced, "the new floor holds the replacement rooms (Basement variant 5): " .. n5 .. " (callback replaced " .. base.replaced .. ")")
+end)
+
+-- 2. a room transition: 1271, 1141, 1263
+local function neighbour()
+  local level = game:GetLevel()
+  local cur = level:GetCurrentRoomIndex()
+  for _, d in ipairs({ { 1, Direction.RIGHT }, { -1, Direction.LEFT }, { 13, Direction.DOWN }, { -13, Direction.UP } }) do
+    local d2 = level:GetRoomByIdx(cur + d[1])
+    if d2 and d2.Data and d2.GridIndex == cur + d[1] then return cur + d[1], d[2] end
+  end
+end
+step(function()
+  reset("MC_POST_ROOM_TRANSITION_UPDATE") reset("MC_PRE_BACKDROP_CHANGE") reset("MC_IS_PERSISTENT_ROOM_ENTITY")
+  local idx, dir = neighbour()
+  check(idx ~= nil, "the start room has a neighbour room")
+  if idx then
+    base.from = game:GetLevel():GetCurrentRoomIndex()
+    game:StartRoomTransition(idx, dir, RoomTransitionAnim.WALK)
+    wait("room transition", 200, function() return count("MC_POST_ROOM_TRANSITION_UPDATE") > 2 and game:GetLevel():GetCurrentRoomIndex() == idx end)
+  end
+end)
+step(function()
+  local t = last("MC_POST_ROOM_TRANSITION_UPDATE")
+  check(count("MC_POST_ROOM_TRANSITION_UPDATE") > 2 and t ~= nil and t.n == 0, "MC_POST_ROOM_TRANSITION_UPDATE fired during the transition, no arguments: " .. count("MC_POST_ROOM_TRANSITION_UPDATE"))
+  local b = last("MC_PRE_BACKDROP_CHANGE")
+  check(b ~= nil and b.n == 1 and math.type(b[1]) == "integer" and b[1] >= 0 and b[1] <= 62, "MC_PRE_BACKDROP_CHANGE (backdrop id): " .. tostring(b and b.text) .. " x" .. count("MC_PRE_BACKDROP_CHANGE"))
+end)
+-- an integer answer on the backdrop change changes the room's backdrop
+step(function()
+  beh.MC_PRE_BACKDROP_CHANGE = function(id) return 12 end
+  local back = base.from
+  base.target = back
+  game:StartRoomTransition(back, Direction.LEFT, RoomTransitionAnim.WALK)
+  wait("transition back", 200, function() return game:GetLevel():GetCurrentRoomIndex() == back end)
+end)
+step(function()
+  beh.MC_PRE_BACKDROP_CHANGE = nil
+  wait("frames", 10, function() return false end)
+end)
+step(function()
+  check(game:GetRoom():GetBackdropType() == 12, "an answer of 12 made the room's backdrop 12 (Room:GetBackdropType = " .. tostring(game:GetRoom():GetBackdropType()) .. ")")
+end)
+-- 1263: the game asks it for every entity of a room's layout when it fills a room that is already cleared (an entity answered
+-- true is spawned again, the others are not). The neighbour room is entered, cleared and left once; then it is entered
+-- answering false for every entity and again answering true: the true answer leaves more entities in the room.
+local function sig()
+  local n = 0
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e.Type ~= EntityType.ENTITY_PLAYER and e.Type ~= EntityType.ENTITY_EFFECT and e.Type ~= EntityType.ENTITY_TEAR then n = n + 1 end
+  end
+  return n
+end
+local function tp(idx) game:StartRoomTransition(idx, Direction.NO_DIRECTION, RoomTransitionAnim.TELEPORT) end
+local function strip()
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e.Type ~= EntityType.ENTITY_PLAYER and e.Type ~= EntityType.ENTITY_EFFECT and e.Type ~= EntityType.ENTITY_TEAR then e:Remove() end
+  end
+  game:GetRoom():SetClear(true)
+end
+-- find a default room whose layout spawns entities: visit the floor's default rooms until one holds some
+local scan_at
+step(function()
+  if not base.cands then
+    base.from = game:GetLevel():GetCurrentRoomIndex()
+    base.cands = {}
+    local level = game:GetLevel()
+    for r = 0, 168 do
+      local d = level:GetRoomByIdx(r)
+      if d and d.Data and d.GridIndex == r and r ~= base.from and d.Data.Type == RoomType.ROOM_DEFAULT and d.Data.Shape == RoomShape.ROOMSHAPE_1x1 then base.cands[#base.cands + 1] = r end
+    end
+  end
+  base.try = table.remove(base.cands, 1)
+  if not base.try then return end
+  tp(base.try)
+  wait("scan teleport", 200, function() return game:GetLevel():GetCurrentRoomIndex() == base.try end)
+end)
+scan_at = #steps
+step(function() wait("frames", 20, function() return false end) end)
+step(function()
+  if base.try and sig() > 0 then
+    base.T = base.try
+    say("1263 room " .. base.T .. " holds " .. sig() .. " entities")
+    strip()
+    tp(base.from)
+    wait("home", 200, function() return game:GetLevel():GetCurrentRoomIndex() == base.from end)
+  elseif base.try and #base.cands > 0 then
+    i = scan_at - 1   -- the next step run is the scan again
+  elseif base.try then
+    tp(base.from)
+    wait("home", 200, function() return game:GetLevel():GetCurrentRoomIndex() == base.from end)
+  end
+end)
+step(function()
+  wait("frames", 10, function() return false end)
+end)
+local function cycle(answer, key)
+  step(function()
+    if not base.T then return end
+    reset("MC_IS_PERSISTENT_ROOM_ENTITY")
+    beh.MC_IS_PERSISTENT_ROOM_ENTITY = answer ~= nil and function() return answer end or nil
+    tp(base.T)
+    wait("enter", 200, function() return game:GetLevel():GetCurrentRoomIndex() == base.T end)
+  end)
+  step(function() wait("frames", 20, function() return false end) end)
+  step(function()
+    if not base.T then return end
+    if key then
+      base[key] = sig()
+      base[key .. "_n"] = count("MC_IS_PERSISTENT_ROOM_ENTITY")
+      base[key .. "_pr"] = last("MC_IS_PERSISTENT_ROOM_ENTITY")
+      say(string.format("1263 answer %s: called x%d, %d entities in the cleared room", tostring(answer), base[key .. "_n"], base[key]))
+    end
+    strip()
+    tp(base.from)
+    wait("return", 200, function() return game:GetLevel():GetCurrentRoomIndex() == base.from end)
+  end)
+  step(function() wait("frames", 10, function() return false end) end)
+end
+cycle(nil, nil)
+cycle(false, "pf")
+cycle(true, "pt")
+step(function()
+  beh.MC_IS_PERSISTENT_ROOM_ENTITY = nil
+  check(base.T ~= nil, "a default room whose layout spawns entities was found: " .. tostring(base.T))
+  local pr = base.pf_pr or base.pt_pr
+  check(base.T and base.pf_n > 0 and pr ~= nil and pr.n == 2 and math.type(pr[1]) == "integer" and math.type(pr[2]) == "integer", "MC_IS_PERSISTENT_ROOM_ENTITY (type, variant) fires when a cleared room is filled: " .. tostring(pr and pr.text) .. " x" .. tostring(base.pf_n))
+  check(base.T and base.pt > base.pf, "a true answer spawns the room's entities again, a false one does not: false " .. tostring(base.pf) .. " entities, true " .. tostring(base.pt))
+end)
+
+-- 3. a challenge done
+step(function()
+  reset("MC_POST_CHALLENGE_DONE")
+  local was = Isaac.IsChallengeDone(3)
+  Isaac.ClearChallenge(3)
+  local c = last("MC_POST_CHALLENGE_DONE")
+  check(c ~= nil and c.n == 1 and c[1] == 3, "MC_POST_CHALLENGE_DONE (3): " .. tostring(c and c.text) .. " x" .. count("MC_POST_CHALLENGE_DONE"))
+  check(Isaac.IsChallengeDone(3) == true, "the challenge is done when the callback has run")
+  local hit = 0
+  local m2 = RegisterMod("rgon lab cb-f param", 1)
+  m2:AddCallback(M.MC_POST_CHALLENGE_DONE, function() hit = hit + 1 end, 7)
+  Isaac.ClearChallenge(3)
+  check(hit == 0, "a filter on challenge 7 does not hear challenge 3")
+  Isaac.ClearChallenge(7)
+  check(hit == 1, "a filter on challenge 7 hears challenge 7")
+  if not was then Isaac.UnClearChallenge(3) end
+  Isaac.UnClearChallenge(7)
+end)
+
+-- 4. ambush and greed waves
+step(function()
+  reset("MC_POST_START_AMBUSH_WAVE") reset("MC_POST_START_GREED_WAVE")
+  Ambush.StartChallenge()
+  Ambush.SpawnWave()
+  local a = last("MC_POST_START_AMBUSH_WAVE")
+  check(a ~= nil and a.n == 1 and a[1] == false, "MC_POST_START_AMBUSH_WAVE (false) after SpawnWave: " .. tostring(a and a.text))
+  Ambush.SpawnBossrushWave()
+  local b = last("MC_POST_START_AMBUSH_WAVE")
+  check(count("MC_POST_START_AMBUSH_WAVE") == 2 and b.n == 1 and b[1] == true, "MC_POST_START_AMBUSH_WAVE (true) after SpawnBossrushWave: " .. tostring(b and b.text))
+  wait("frames", 120, function() return count("MC_POST_START_AMBUSH_WAVE") > 2 end)
+end)
+step(function()
+  local n = count("MC_POST_START_AMBUSH_WAVE")
+  check(n >= 2, "the ambush callback ran " .. n .. " times (the game's own Ambush update may add waves)")
+  for _, e in ipairs(Isaac.GetRoomEntities()) do if e:IsActiveEnemy(false) then e:Remove() end end
+  -- MC_POST_START_GREED_WAVE is not proven here: the game calls Room::SpawnGreedModeWave only in Greed Mode.
+  for _, e in ipairs(Isaac.GetRoomEntities()) do if e:IsActiveEnemy(false) then e:Remove() end end
+end)
+
+-- 5. custom cache
+step(function()
+  reset("MC_EVALUATE_CUSTOM_CACHE")
+  beh.MC_EVALUATE_CUSTOM_CACHE = function(player, tag, value) if tag == "cbftag" then return value + 7.5 end end
+  local p = pl()
+  p:AddCustomCacheTag("cbftag", true)
+  local c = last("MC_EVALUATE_CUSTOM_CACHE")
+  check(c ~= nil and c.n == 3 and c[2] == "cbftag" and c[3] == 0.0, "MC_EVALUATE_CUSTOM_CACHE (player, tag, 0.0): " .. tostring(c and c.text))
+  check(p:GetCustomCacheValue("cbftag") == 7.5, "GetCustomCacheValue answers what the callback returned: " .. tostring(p:GetCustomCacheValue("cbftag")))
+  local n = count("MC_EVALUATE_CUSTOM_CACHE")
+  p:EvaluateItems()
+  check(count("MC_EVALUATE_CUSTOM_CACHE") == n, "a plain EvaluateItems does not evaluate tags that are not pending")
+  p:AddCustomCacheTag("cbftag")
+  p:EvaluateItems()
+  check(count("MC_EVALUATE_CUSTOM_CACHE") == n + 1, "AddCustomCacheTag without evaluate waits for the next EvaluateItems")
+  local m = count("MC_EVALUATE_CUSTOM_CACHE")
+  -- the known tags are the items.xml customcache tags (no mod is loaded in the lab): give the Layer one
+  local real_items = T.custom_cache_items
+  T.custom_cache_items = function() return { ["c:1"] = { cbfall = true } } end
+  say(string.format("CACHE_ALL = 0x%x", CacheFlag.CACHE_ALL))
+  p:AddCacheFlags(CacheFlag.CACHE_ALL)
+  say(string.format("flags word after AddCacheFlags(CACHE_ALL) = 0x%x", B.r32(B.ptr(p) + 0x1574)))
+  p:EvaluateItems()
+  local ca = last("MC_EVALUATE_CUSTOM_CACHE")
+  check(count("MC_EVALUATE_CUSTOM_CACHE") == m + 1 and ca.text:find("cbfall", 1, true) ~= nil, "CACHE_ALL evaluates every known tag: " .. (count("MC_EVALUATE_CUSTOM_CACHE") - m) .. " tags, last " .. tostring(ca and ca.text))
+  T.custom_cache_items = real_items
+  local m2 = RegisterMod("rgon lab cb-f cache param", 1)
+  local hit = 0
+  m2:AddCallback(M.MC_EVALUATE_CUSTOM_CACHE, function() hit = hit + 1 end, "othertag")
+  p:AddCustomCacheTag("cbftag", true)
+  check(hit == 0, "a filter on 'othertag' does not hear 'cbftag'")
+  beh.MC_EVALUATE_CUSTOM_CACHE = nil
+end)
+
+-- 6. 'M: the active item is rerolled on use unless the callback says no
+step(function()
+  reset("MC_PRE_M_MORPH_ACTIVE")
+  local p = pl()
+  p:AddTrinket(TrinketType.TRINKET_M)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL, 6, false)
+  base.active_before = p:GetActiveItem(0)
+  beh.MC_PRE_M_MORPH_ACTIVE = function(player, item) return false end
+  -- the game's own function that runs after an active item is used (the 'M branch is inside it), called as the game calls it
+  B.call(0x007abf80, { ecx = B.ptr(p) }, 0, 0, 0)
+  wait("frames", 20, function() return count("MC_PRE_M_MORPH_ACTIVE") > 0 end)
+end)
+step(function()
+  local c = last("MC_PRE_M_MORPH_ACTIVE")
+  local p = pl()
+  check(c ~= nil and c.n == 2 and math.type(c[2]) == "integer" and c[2] > 0, "MC_PRE_M_MORPH_ACTIVE (player, item): " .. tostring(c and c.text))
+  check(p:GetActiveItem(0) == CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL, "a false answer kept the active item (" .. p:GetActiveItem(0) .. ")")
+  reset("MC_PRE_M_MORPH_ACTIVE")
+  beh.MC_PRE_M_MORPH_ACTIVE = function(player, item) return CollectibleType.COLLECTIBLE_D6 end
+  p:SetActiveCharge(12, ActiveSlot.SLOT_PRIMARY)
+  B.call(0x007abf80, { ecx = B.ptr(p) }, 0, 0, 0)
+  wait("frames", 20, function() return p:GetActiveItem(0) == CollectibleType.COLLECTIBLE_D6 end)
+end)
+step(function()
+  local p = pl()
+  check(p:GetActiveItem(0) == CollectibleType.COLLECTIBLE_D6, "an integer answer made the new active the D6 (" .. p:GetActiveItem(0) .. ")")
+  beh.MC_PRE_M_MORPH_ACTIVE = nil
+end)
+
+frame = 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "frames" then check(false, "timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    if i == #steps + 1 then B.log(string.format("lab_cb_f: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
