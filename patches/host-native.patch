+  local left = #pickups(100)
+  check(left == 1, "answer false: the pedestal was not consumed (pedestals left " .. left .. ")")
+  beh.MC_PRE_PICKUP_VOIDED = nil
+  reset("MC_PRE_PICKUP_VOIDED")
+  pl():UseCard(Card.RUNE_BLACK, UseFlag.USE_NOANIM | UseFlag.USE_NOANNOUNCER)
+  wait("pedestal gone", 150, function() return #pickups(100) == 0 end)
+end)
+step(function()
+  check(#pickups(100) == 0, "no answer: the Black Rune consumed the pedestal (callback count " .. count("MC_PRE_PICKUP_VOIDED") .. ")")
+end)
+
+-- 5. Void
+step(function()
+  clear_pickups()
+  for _, n in ipairs(NAMES) do reset(n) end
+  local p = pl()
+  Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, Vector(p.Position.X + 60, p.Position.Y), Vector(0, 0), nil)
+  p:AddCollectible(CollectibleType.COLLECTIBLE_VOID, 12, false)
+  beh.MC_PRE_PICKUP_VOIDED = function(pk, black) return false end
+  p:UseActiveItem(CollectibleType.COLLECTIBLE_VOID, USE, ActiveSlot.SLOT_PRIMARY)
+  wait("void callback", 90, function() return count("MC_PRE_PICKUP_VOIDED") >= 1 end)
+end)
+step(function()
+  local r = last("MC_PRE_PICKUP_VOIDED")
+  check(r ~= nil, "MC_PRE_PICKUP_VOIDED fired for Void")
