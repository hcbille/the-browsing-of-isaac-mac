+-- lab_cb_g.lua (development only; ISAAC_RGON_LAB=lab_cb_g.lua, worker cb-g)
+-- Fires the engine-hook callbacks of api_throw_loot.lua with real game actions and checks counts and arguments read back:
+-- 1040/1041 (a held bomb thrown), 1191 (Meat Cleaver on a Gaper), 1223 (dark red champion regen), 1123 (slot machine,
+-- donation machine and restock machine blown up), 1334/1336 (a chest's loot list replaced / extended), 1015/1016 (Bag of
+-- Crafting swinging at hearts). Prints "lab_cb_g: DONE n PASS m FAIL".
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-g", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_g: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_g: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.Type ~= nil and v.Variant ~= nil then return "ent:" .. v.Type .. "." .. v.Variant end
+      if v.X ~= nil then return string.format("vec:%.2f,%.2f", v.X, v.Y) end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = { "MC_PRE_ENTITY_THROW", "MC_POST_ENTITY_THROW", "MC_PRE_NPC_SPLIT", "MC_POST_NPC_DARK_RED_CHAMPION_REGEN",
+  "MC_PRE_SLOT_CREATE_EXPLOSION_DROPS", "MC_PRE_PICKUP_GET_LOOT_LIST", "MC_POST_PICKUP_GET_LOOT_LIST",
+  "MC_TRY_ADD_TO_BAG_OF_CRAFTING", "MC_POST_ADD_TO_BAG_OF_CRAFTING" }
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 3 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+local function reset() for _, n in ipairs(NAMES) do rec[n] = {} beh[n] = nil end end
+
+local function pl() return Isaac.GetPlayer(0) end
+local base = {}
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond) waiting, wait_left, wait_what, wait_cond = true, frames, what, cond end
+local function clear_room()
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e.Type ~= 1 and e.Type ~= 1000 then e:Remove() end
+  end
+end
+local function count_type(ty) local n = 0 for _, e in ipairs(Isaac.GetRoomEntities()) do if e.Type == ty and not e:IsDead() then n = n + 1 end end return n end
+
+-- 1. throw
+step(function()
+  reset()
+  Isaac.ExecuteCommand("debug 3")
+  clear_room()
+  local p = pl()
+  base.bomb = Isaac.Spawn(EntityType.ENTITY_BOMB, BombVariant.BOMB_TROLL, 0, p.Position + Vector(0, 40), Vector(0, 0), nil)
+  p:TryHoldEntity(base.bomb)
+  beh.MC_PRE_ENTITY_THROW = function() return Vector(7, 0) end
+end)
+step(function()
+  local p = pl()
+  check(p:GetHeldEntity() ~= nil, "the player holds the bomb")
+  p:ThrowHeldEntity(Vector(0, 0))
+  local a, b = last("MC_PRE_ENTITY_THROW"), last("MC_POST_ENTITY_THROW")
+  check(count("MC_PRE_ENTITY_THROW") == 1 and a.n == 3 and a[1].Type == 1 and a[2].Type == 4 and a[3].X == 0, "1040 (player, held bomb, velocity): " .. tostring(a and a.text))
+  check(count("MC_POST_ENTITY_THROW") == 1 and b.n == 3 and b[2].Type == 4 and math.abs(b[3].X - 7) < 0.01, "1041 sees the thrown bomb and the velocity the PRE answered: " .. tostring(b and b.text))
+  if base.bomb then base.bomb:Remove() end
+end)
+
+-- 2. loot list on a chest
+step(function()
+  reset()
+  clear_room()
+  local p = pl()
+  base.chest = Isaac.Spawn(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_CHEST, 0, p.Position + Vector(120, 0), Vector(0, 0), nil):ToPickup()
+end)
+step(function()
+  local chest = base.chest
+  local plain = chest:GetLootList(false)
+  local n0 = #plain:GetEntries()
+  check(count("MC_PRE_PICKUP_GET_LOOT_LIST") == 1 and count("MC_POST_PICKUP_GET_LOOT_LIST") == 1, "1334 and 1336 fire once for a GetLootList call (" .. count("MC_PRE_PICKUP_GET_LOOT_LIST") .. "/" .. count("MC_POST_PICKUP_GET_LOOT_LIST") .. ")")
+  local a, b = last("MC_PRE_PICKUP_GET_LOOT_LIST"), last("MC_POST_PICKUP_GET_LOOT_LIST")
+  check(a ~= nil and a.n == 4 and a[1].Variant == PickupVariant.PICKUP_CHEST and a[2] == false and tos(a[3]) == "userdata", "1334 (pickup, shouldAdvance, rng, player): " .. tostring(a and a.text))
+  check(b ~= nil and b.n == 5 and type(b[2]) == "table" and #b[2]:GetEntries() == n0, "1336 (pickup, list with the game's " .. n0 .. " entries, shouldAdvance, rng): " .. tostring(b and b.text))
+  -- POST adds an entry
+  reset()
+  beh.MC_POST_PICKUP_GET_LOOT_LIST = function(pk, list) list:PushEntry(5, 20, 1) end
+  local l2 = chest:GetLootList(false)
+  local es = l2:GetEntries()
+  check(#es == n0 + 1 and es[#es]:GetType() == 5 and es[#es]:GetVariant() == 20 and es[#es]:GetSubType() == 1, "an entry pushed in 1336 is in the list the game's function answers (" .. #es .. " entries, was " .. n0 .. ")")
+  -- PRE replaces
+  reset()
+  beh.MC_PRE_PICKUP_GET_LOOT_LIST = function()
+    local l = LootList()
+    l:PushEntry(5, 10, 2)
+    l:PushEntry(5, 30, 1)
+    return l
+  end
+  local l3 = chest:GetLootList(false)
+  local e3 = l3:GetEntries()
+  check(#e3 == 2 and e3[1]:GetVariant() == 10 and e3[1]:GetSubType() == 2 and e3[2]:GetVariant() == 30, "the LootList 1334 answers replaces the game's (" .. #e3 .. " entries)")
+  reset()
+  local l4 = chest:GetLootList(false)
+  check(#l4:GetEntries() == n0, "without callbacks the game's list is back (" .. #l4:GetEntries() .. ")")
+  chest:Remove()
+end)
+
+-- 3. slots
+local function slot_state(s) return B.r32(B.ptr(s) + 0x410) end
+for _, v in ipairs({ 1, 10, 8 }) do
+  step(function()
+    reset()
+    clear_room()
+    local p = pl()
+    base.s1 = Isaac.Spawn(EntityType.ENTITY_SLOT, v, 0, p.Position + Vector(100, 0), Vector(0, 0), nil)
+    base.s2 = Isaac.Spawn(EntityType.ENTITY_SLOT, v, 0, p.Position + Vector(-100, 0), Vector(0, 0), nil)
+    beh.MC_PRE_SLOT_CREATE_EXPLOSION_DROPS = function(slot) if GetPtrHash(slot) == GetPtrHash(base.s1) then return false end end
+  end)
+  step(function()
+    local p = pl()
+    local st1, st2 = slot_state(base.s1), slot_state(base.s2)
+    base.s1:TakeDamage(10, DamageFlag.DAMAGE_EXPLOSION, EntityRef(p), 0)
+    base.s2:TakeDamage(10, DamageFlag.DAMAGE_EXPLOSION, EntityRef(p), 0)
+    check(count("MC_PRE_SLOT_CREATE_EXPLOSION_DROPS") == 2, "1123 fires once per exploded variant-" .. v .. " slot (" .. count("MC_PRE_SLOT_CREATE_EXPLOSION_DROPS") .. ")")
+    local a = last("MC_PRE_SLOT_CREATE_EXPLOSION_DROPS")
+    check(a ~= nil and a.n == 1 and a[1].Type == 6 and a[1].Variant == v, "1123 (slot): " .. tostring(a and a.text))
+    check(slot_state(base.s1) == st1, "variant " .. v .. ": a false answer keeps the slot's state (" .. st1 .. " -> " .. slot_state(base.s1) .. ")")
+    check(slot_state(base.s2) == 3, "variant " .. v .. ": no answer, the game destroys it (state " .. st2 .. " -> " .. slot_state(base.s2) .. ")")
+    if base.s1 then base.s1:Remove() end
+    if base.s2 then base.s2:Remove() end
+  end)
+end
+
+-- 4. Meat Cleaver on a Gaper
+step(function()
+  reset()
+  clear_room()
+  local p = pl()
+  base.n0 = 0
+  base.gaper = Isaac.Spawn(EntityType.ENTITY_GAPER, 0, 0, p.Position + Vector(120, 0), Vector(0, 0), nil)
+  base.gaper:AddEntityFlags(EntityFlag.FLAG_FREEZE)
+  base.gaper.HitPoints = 1000
+  base.gaper.MaxHitPoints = 1000
+  beh.MC_PRE_NPC_SPLIT = function(npc, black) return true end
+  p:UseActiveItem(CollectibleType.COLLECTIBLE_MEAT_CLEAVER, UseFlag.USE_NOANIM)
+  wait("1191", 120, function() return count("MC_PRE_NPC_SPLIT") > 0 end)
+end)
+step(function()
+  local a = last("MC_PRE_NPC_SPLIT")
+  check(a ~= nil and a.n == 2 and a[1].Type == EntityType.ENTITY_GAPER and type(a[2]) == "boolean", "1191 (npc, isBlacklisted): " .. tostring(a and a.text))
+  base.stayed = count_type(EntityType.ENTITY_GAPER)
+  check(base.stayed == 1, "answering true: the Gaper does not split (" .. base.stayed .. " Gaper)")
+  reset()
+  beh.MC_PRE_NPC_SPLIT = function(npc, black) return false end
+  pl():UseActiveItem(CollectibleType.COLLECTIBLE_MEAT_CLEAVER, UseFlag.USE_NOANIM)
+  wait("split", 150, function() return count_type(EntityType.ENTITY_GAPER) >= 2 end)
+end)
+step(function()
+  check(count_type(EntityType.ENTITY_GAPER) >= 2, "answering false: the Gaper splits (" .. count_type(EntityType.ENTITY_GAPER) .. " Gapers)")
+  clear_room()
+end)
+
+-- 5. dark red champion regen
+step(function()
+  reset()
+  clear_room()
+  local p = pl()
+  local g = Isaac.Spawn(EntityType.ENTITY_GAPER, 0, 0, p.Position + Vector(120, 0), Vector(0, 0), nil):ToNPC()
+  g:MakeChampion(1, ChampionColor.DARK_RED, true)
+  base.g = g
+  g:TakeDamage(g.MaxHitPoints * 10, 0, EntityRef(p), 0)
+  wait("regen", 400, function() return count("MC_POST_NPC_DARK_RED_CHAMPION_REGEN") > 0 end)
+end)
+step(function()
+  local a = last("MC_POST_NPC_DARK_RED_CHAMPION_REGEN")
+  check(a ~= nil and a.n == 1 and a[1].Type == EntityType.ENTITY_GAPER, "1223 (npc) after the goo regen: " .. tostring(a and a.text))
+  clear_room()
+end)
+
+-- 6. bag of crafting: the Bag's swing picks up hearts shot at
+step(function()
+  reset()
+  clear_room()
+  local p = pl()
+  p:AddCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+  local ok1, e1 = pcall(function() p:SetPocketActiveItem(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, ActiveSlot.SLOT_POCKET, false) end)
+  say("bag pocket set: " .. tostring(ok1) .. " " .. tostring(e1))
+  local ok2, e2 = pcall(function() return p:UseActiveItem(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, UseFlag.USE_OWNED, ActiveSlot.SLOT_POCKET) end)
+  say("bag use: " .. tostring(ok2) .. " " .. tostring(e2))
+  base.bag_n = 0
+  base.shoot = true
+  base.hearts = function()
+    for i = 1, 3 do Isaac.Spawn(EntityType.ENTITY_PICKUP, PickupVariant.PICKUP_HEART, 1, pl().Position + Vector(30 + 10 * i, 0), Vector(0, 0), nil) end
+  end
+  base.hearts()
+  wait("bag", 600, function()
+    if Isaac.GetFrameCount() % 40 == 0 then
+      base.hearts()
+      pcall(function() pl():UseActiveItem(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, UseFlag.USE_OWNED, ActiveSlot.SLOT_POCKET) end)
+      local knives, hp, tears = 0, 0, 0
+      for _, e in ipairs(Isaac.GetRoomEntities()) do
+        if e.Type == 8 then knives = knives + 1 end
+        if e.Type == 2 then tears = (tears or 0) + 1 end
+        if e.Type == 5 and e.Variant == 10 then hp = hp + 1 end
+      end
+      say("bag probe: knives " .. knives .. ", tears " .. tears .. ", hearts " .. hp .. ", inputs " .. tostring(base.inputs) .. ", has bag " .. tostring(pl():HasCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING)))
+    end
+    return count("MC_TRY_ADD_TO_BAG_OF_CRAFTING") > 0 and count("MC_POST_ADD_TO_BAG_OF_CRAFTING") > 0
+  end)
+end)
+step(function()
+  base.shoot = false
+  local a, b = last("MC_TRY_ADD_TO_BAG_OF_CRAFTING"), last("MC_POST_ADD_TO_BAG_OF_CRAFTING")
+  check(a ~= nil and a.n == 3 and a[1].Type == 1 and a[2].Type == 5 and type(a[3]) == "table", "1015 (player, pickup, kinds table): " .. tostring(a and a.text))
+  check(a ~= nil and #a[3] >= 1, "1015's table holds the game's chosen kind(s) (" .. tostring(a and a[3] and #a[3]) .. ")")
+  check(b ~= nil and b.n == 2 and b[2].Type == 5, "1016 (player, pickup): " .. tostring(b and b.text))
+  local before = count("MC_POST_ADD_TO_BAG_OF_CRAFTING")
+  reset()
+  beh.MC_TRY_ADD_TO_BAG_OF_CRAFTING = function() return false end
+  base.shoot = true
+  wait("bag refused", 400, function()
+    if Isaac.GetFrameCount() % 40 == 0 then
+      base.hearts()
+      pcall(function() pl():UseActiveItem(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, UseFlag.USE_OWNED, ActiveSlot.SLOT_POCKET) end)
+    end
+    return count("MC_TRY_ADD_TO_BAG_OF_CRAFTING") > 0
+  end)
+end)
+step(function()
+  base.shoot = false
+  check(count("MC_TRY_ADD_TO_BAG_OF_CRAFTING") > 0 and count("MC_POST_ADD_TO_BAG_OF_CRAFTING") == 0, "a false answer on 1015 stops the pickup being added: no 1016 (" .. count("MC_TRY_ADD_TO_BAG_OF_CRAFTING") .. " tries, " .. count("MC_POST_ADD_TO_BAG_OF_CRAFTING") .. " added)")
+  clear_room()
+end)
+
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if not base.shoot or not ent or ent.Type ~= 1 or action ~= ButtonAction.ACTION_SHOOTRIGHT then return end
+  base.inputs = (base.inputs or 0) + 1
+  if hook == InputHook.IS_ACTION_PRESSED then return true end
+  if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+end)
+
+local frame, i = 0, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    local ok, done = pcall(wait_cond)
