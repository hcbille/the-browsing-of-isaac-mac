+-- Level:HasMirrorDimension(): the floor has the mirror world (dimension 1 holding the mirrored floor): Downpour II
+-- and Dross II (Curse of the Labyrinth makes the first floor of each the one that has it), not in Greed Mode.
+-- The game's own rule as miniMAPI states it for itself (cache.lua); the game gives the layer no field for it.
+T.method("Level", "HasMirrorDimension", function(self)
+  if Game():IsGreedMode() then return false end
+  local alt = self:GetStageType()
+  if alt ~= StageType.STAGETYPE_REPENTANCE and alt ~= StageType.STAGETYPE_REPENTANCE_B then return false end
+  local stage = self:GetAbsoluteStage()
+  if stage == LevelStage.STAGE1_2 then return self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH == 0 end
+  return stage == LevelStage.STAGE1_1 and self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH ~= 0
+end)
+
+-- EntityPlayer:AddNullItemEffect(id, applyCostume = false, cooldown, additive = true) and the same for trinkets and
+-- collectibles (REPENTOGON's shortcuts of TemporaryEffects:Add*Effect with a cooldown). The effect is added through the
+-- game's own TemporaryEffects; the cooldown arguments are not applied (the game's own duration holds).
+do
+  local P = "EntityPlayer"
+  local function effect(name, fname)
+    T.method(P, name, function(self, id, costume)
+      if math.type(id) ~= "integer" then error("bad argument #1 to '" .. name .. "' (integer expected, got " .. type(id) .. ")", 2) end
+      -- a mod's <null> that has no id in its items.xml has only a reserved blank id here (api_lua.lua): no effect
+      if fname == "AddNullEffect" and (id < 0 or T.reserved_null(id)) then return end
+      self:GetEffects()[fname](self:GetEffects(), id, costume and true or false)
+    end)
+  end
+  effect("AddNullItemEffect", "AddNullEffect")
+  effect("AddTrinketEffect", "AddTrinketEffect")
+  effect("AddCollectibleEffect", "AddCollectibleEffect")
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["EntityPlayer:Add*Effect cooldown"] = "the cooldown and additive arguments are not applied"
+end
