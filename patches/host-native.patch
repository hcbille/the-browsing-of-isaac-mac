+-- Item pools from itempools.xml: Isaac.GetPoolIdByName(name), ItemPool:GetCollectiblesFromPool(pool),
+-- ItemPool:GetNumItemPools(). The game's own pools are ItemPoolType 0 and up in the file's order (checked
+-- against the enum's names); a pool a mod's itempools.xml names that the game has not is a custom pool and
+-- gets the numbers after them, in load order. The game itself has no such pool: an id of one is the layer's
+-- (accepted, not supported: nothing in the game draws from it). Weights are the file's own, as the pools start.
+do
+  local XML = rawget(_G, "XMLNode")
+  local function norm(s) return (tostring(s):gsub("^POOL_", ""):gsub("[_%s]", ""):lower()) end
+  local pools                       -- norm name -> { id, name, items = { {id, weight, decreaseby, removeon} } }
+  local order
+  local function build()
+    if pools then return pools end
+    pools, order = {}, {}
+    local enum = {}
+    for k, v in pairs(rawget(_G, "ItemPoolType") or {}) do if type(v) == "number" then enum[norm(k)] = v end end
+    local top = -1
+    for _, v in pairs(enum) do if v > top then top = v end end
+    local nodes = T.nodes_of and T.nodes_of("itempools.xml", { "Pool", "pool" }) or {}
+    local custom = top
+    for _, node in ipairs(nodes) do
+      local name = node.attr.name
+      if name then
+        local key = norm(name)
+        local p = pools[key]
+        if not p then
+          local id = enum[key]
+          if not id then custom = custom + 1 id = custom end
+          p = { id = id, name = name, items = {}, custom = enum[key] == nil }
+          pools[key] = p
+          order[#order + 1] = p
+        end
+        for _, it in ipairs(node) do
+          local a = it.attr
+          local id = math.tointeger(tonumber(a.id or a.collectible or ""))
+          if id then
+            p.items[#p.items + 1] = { id, tonumber(a.weight) or 1.0, tonumber(a.decreaseby) or 1.0, tonumber(a.removeon) or 0.1 }
+          end
+        end
+      end
+    end
+    return pools
+  end
+  T.static(Isaac, "Isaac", "GetPoolIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetPoolIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    local p = build()[norm(name)]
+    return p and p.id or -1
+  end)
+  T.method("ItemPool", "GetCollectiblesFromPool", function(self, pool)
+    if math.type(pool) ~= "integer" then error("bad argument #1 to 'GetCollectiblesFromPool' (integer expected, got " .. type(pool) .. ")", 2) end
+    build()
+    local out = {}
+    for _, p in ipairs(order) do
+      if p.id == pool then
+        for _, it in ipairs(p.items) do
+          out[#out + 1] = { itemID = it[1], initialWeight = it[2], weight = it[2], decreaseBy = it[3], removeOn = it[4], isUnlocked = true }
+        end
+      end
+    end
+    return out
+  end)
+  T.method("ItemPool", "GetNumItemPools", function() build() return #order end)
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["ItemPool custom pools"] = "a pool only a mod's itempools.xml names has an id here; the game does not draw from it"
+end
+
+-- Isaac.GetGiantBookIdByName(name): giantbook.xml's entries. The game's own carry their id; a mod's follow the
+-- highest, in load order. -1 when there is none. (ItemOverlay.Show, which draws the book, is in api_menus.lua.)
+do
+  local XN = rawget(_G, "XMLNode")
+  local ids
+  local function build()
+    if ids then return ids end
+    ids = {}
+    local set = XN and XN.GIANTBOOK and T.xml_entries and T.xml_entries(XN.GIANTBOOK)
+    if not set then return ids end
+    local top = 0
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if id and id > top then top = id end
+    end
+    for _, e in ipairs(set.list) do
+      local id = math.tointeger(tonumber(e.id))
+      if not id and e.sourceid then top = top + 1 id = top end
+      if id and e.name and ids[e.name:lower()] == nil then ids[e.name:lower()] = id end
+    end
+    return ids
+  end
+  T.static(Isaac, "Isaac", "GetGiantBookIdByName", function(name)
+    if type(name) ~= "string" then error("bad argument #1 to 'GetGiantBookIdByName' (string expected, got " .. type(name) .. ")", 2) end
+    return build()[name:lower()] or -1
+  end)
+end
+
+-- EntityPlayer custom cache (REPENTOGON): :AddCustomCacheTag(tag | {tags}, evaluate = false),
+-- :HasCustomCacheTag(tag), :RemoveCustomCacheTag(tag), :GetCustomCacheTags(), :GetCustomCacheValue(tag).
+-- A tag is "evaluated" by firing MC_EVALUATE_CUSTOM_CACHE (player, tag, value), param = tag, the value starting
+-- at 0.0 and each function's return replacing it; the result is what GetCustomCacheValue answers. Tags are the
+-- ones added to the player and those of the items the player holds (items.xml customcache). The game evaluates
+-- at EvaluateItems; here that is the first MC_EVALUATE_CACHE of a frame for the player, and at once when
+-- AddCustomCacheTag is asked to.
+do
+  local M = ModCallbacks
+  local added, values, stamp = {}, {}, {}      -- player hash -> { tag = true } / { tag = number } / frame
+  local function hash(p) return GetPtrHash(p) end
+  local function tag_list(v, what)
+    local out = {}
+    if type(v) == "string" then out[1] = v
+    elseif type(v) == "table" then for _, t in ipairs(v) do if type(t) == "string" then out[#out + 1] = t end end
+    else error("bad argument #1 to '" .. what .. "' (string or table expected, got " .. type(v) .. ")", 3) end
+    return out
+  end
+  local function tags_of(player)
+    local all = {}
+    for t in pairs(added[hash(player)] or {}) do all[t] = true end
+    local items = T.custom_cache_items and T.custom_cache_items() or {}
+    for k, set in pairs(items) do
+      local kind, id = k:sub(1, 1), math.tointeger(tonumber(k:sub(3)))
+      local held = false
+      if kind == "c" then held = player:HasCollectible(id, true)
+      elseif kind == "t" then held = player:HasTrinket(id, true)
+      elseif kind == "n" then held = player:GetEffects():HasNullEffect(id) end
+      if held then for t in pairs(set) do all[t] = true end end
+    end
+    return all
+  end
+  local function evaluate(player)
+    local vals = {}
+    for tag in pairs(tags_of(player)) do
+      local v = 0.0
+      if M.MC_EVALUATE_CUSTOM_CACHE then
+        local r = T.run(M.MC_EVALUATE_CUSTOM_CACHE, tag, player, tag, v)
+        if type(r) == "number" then v = r + 0.0 end
+      end
+      vals[tag] = v
+    end
+    values[hash(player)] = vals
+  end
+  local P = "EntityPlayer"
+  T.method(P, "AddCustomCacheTag", function(self, tags, now)
+    local a = added[hash(self)] or {}
+    added[hash(self)] = a
+    for _, t in ipairs(tag_list(tags, "AddCustomCacheTag")) do a[t] = true end
+    if now then evaluate(self) end
+  end)
+  T.method(P, "RemoveCustomCacheTag", function(self, tags)
+    local a = added[hash(self)]
+    if a then for _, t in ipairs(tag_list(tags, "RemoveCustomCacheTag")) do a[t] = nil end end
+  end)
+  T.method(P, "HasCustomCacheTag", function(self, tag)
+    if type(tag) ~= "string" then error("bad argument #1 to 'HasCustomCacheTag' (string expected, got " .. type(tag) .. ")", 2) end
+    return tags_of(self)[tag] == true
+  end)
+  T.method(P, "GetCustomCacheTags", function(self)
+    local out = {}
+    for t in pairs(tags_of(self)) do out[#out + 1] = t end
+    table.sort(out)
+    return out
+  end)
+  T.method(P, "GetCustomCacheValue", function(self, tag)
+    if type(tag) ~= "string" then error("bad argument #1 to 'GetCustomCacheValue' (string expected, got " .. type(tag) .. ")", 2) end
+    local v = values[hash(self)]
+    return v and v[tag] or 0.0
+  end)
+  if T.listen then
+    T.listen(M.MC_EVALUATE_CACHE, function(_, player)
+      local h, f = hash(player), Isaac.GetFrameCount()
+      if stamp[h] == f then return end
+      stamp[h] = f
+      evaluate(player)
+    end, -math.huge)
+  end
+end
+
+-- EntityPlayer stat modifiers (REPENTOGON: the fields Experimental Treatment and Void use) and the suplex
+-- and costume accessors. Their places in this build's player are not measured (api_player.lua leaves them
+-- out until they are), so they are the layer's own, per player:
+--   :Get/Set{Damage,FireDelay,Luck,ShotSpeed,Speed,TearRange}Modifier -- kept, and applied when the stats are
+--      evaluated (the last MC_EVALUATE_CACHE of the player's frame): Damage +m, Luck +m, ShotSpeed +0.2m,
+--      MoveSpeed +0.2m, TearRange +2.5m, tears per second +0.5m. Not the game's own field: Experimental
+--      Treatment's and Void's own changes to it are not seen here.
+--   :GetSuplexState and :SetSuplex{State,AimCountdown,LandPosition,TargetPosition} -- kept; the game's own
+--      Suplex! does not read them (accepted, not supported). :GetMarkedTarget answers nil.
+--   :IsItemCostumeVisible / :IsNullItemCostumeVisible -- false (the game's costume list is not read).
+do
+  local M = ModCallbacks
+  local P = "EntityPlayer"
+  local mods = {}                                  -- player hash -> { name = number }
+  local function slot(p) local h = GetPtrHash(p) local m = mods[h] if not m then m = {} mods[h] = m end return m end
+  local STATS = { Damage = true, FireDelay = true, Luck = true, ShotSpeed = true, Speed = true, TearRange = true }
+  for name in pairs(STATS) do
+    T.method(P, "Get" .. name .. "Modifier", function(self) return slot(self)[name] or 0.0 end)
+    T.method(P, "Set" .. name .. "Modifier", function(self, v)
+      if type(v) ~= "number" then error("bad argument #1 to 'Set" .. name .. "Modifier' (number expected, got " .. type(v) .. ")", 2) end
+      slot(self)[name] = v + 0.0
+      self:AddCacheFlags(CacheFlag.CACHE_ALL)
+      T.unsupported("EntityPlayer:Set" .. name .. "Modifier", "kept per player and applied at the stat evaluation; the game's own field is not set")
+    end)
+  end
+  if T.listen and M.MC_EVALUATE_CACHE then
+    T.listen(M.MC_EVALUATE_CACHE, function(_, player, flag)
+      local m = mods[GetPtrHash(player)]
+      if not m then return end
+      if flag == CacheFlag.CACHE_DAMAGE and m.Damage then player.Damage = player.Damage + m.Damage
+      elseif flag == CacheFlag.CACHE_LUCK and m.Luck then player.Luck = player.Luck + m.Luck
+      elseif flag == CacheFlag.CACHE_SHOTSPEED and m.ShotSpeed then player.ShotSpeed = player.ShotSpeed + 0.2 * m.ShotSpeed
+      elseif flag == CacheFlag.CACHE_SPEED and m.Speed then player.MoveSpeed = player.MoveSpeed + 0.2 * m.Speed
+      elseif flag == CacheFlag.CACHE_RANGE and m.TearRange then player.TearRange = player.TearRange + 2.5 * m.TearRange
+      elseif flag == CacheFlag.CACHE_FIREDELAY and m.FireDelay then
+        local tps = 30 / (player.MaxFireDelay + 1) + 0.5 * m.FireDelay
+        if tps > 0.05 then player.MaxFireDelay = 30 / tps - 1 end
+      end
+    end, math.huge)
+  end
+
+  local suplex = {}
+  local function sp(p) local h = GetPtrHash(p) local s = suplex[h] if not s then s = { state = 0, aim = 0 } suplex[h] = s end return s end
+  T.method(P, "GetSuplexState", function(self) return sp(self).state end)
+  T.method(P, "SetSuplexState", function(self, v) sp(self).state = v T.unsupported("EntityPlayer:SetSuplexState", "kept; the game's own Suplex! does not read it") end)
+  T.method(P, "SetSuplexAimCountdown", function(self, v) sp(self).aim = v end)
+  T.method(P, "SetSuplexLandPosition", function(self, v) sp(self).land = v end)
+  T.method(P, "SetSuplexTargetPosition", function(self, v) sp(self).target = v end)
+  T.method(P, "GetMarkedTarget", function() return nil end)
+  T.method(P, "IsItemCostumeVisible", function() return false end)
+  T.method(P, "IsNullItemCostumeVisible", function() return false end)
+  for _, n in ipairs({ "GetSuplexState", "SetSuplexState", "SetSuplexAimCountdown", "SetSuplexLandPosition", "SetSuplexTargetPosition",
+                       "GetMarkedTarget", "IsItemCostumeVisible", "IsNullItemCostumeVisible" }) do R.Implemented[P .. "." .. n] = nil end
+end
+
+-- Isaac.GetString(category, key): the game's string table (resources/stringtable.sta: a category holds keys,
+-- a key one <string> per language in the file's language order). English is always answered (the game's
+-- language option is not read); a key it has none of answers "StringTable::InvalidKey", as REPENTOGON's does.
+do
+  local text
+  local cats = {}
+  local function unesc(s)
+    return (s:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&apos;", "'"):gsub("&amp;", "&"))
+  end
+  T.static(Isaac, "Isaac", "GetString", function(category, key)
+    if type(category) ~= "string" then error("bad argument #1 to 'GetString' (string expected, got " .. type(category) .. ")", 2) end
+    if type(key) ~= "string" then error("bad argument #2 to 'GetString' (string expected, got " .. type(key) .. ")", 2) end
+    if text == nil then text = T.read_file and T.read_file("resources/stringtable.sta") or false end
+    if not text then return "StringTable::InvalidKey" end
+    local c = cats[category]
+    if c == nil then
+      local a, e = text:find('<category name="' .. category .. '">', 1, true)
+      if a then
+        local z = text:find("</category>", e, true)
+        c = { e, z or #text }
+      else
+        c = false
+      end
+      cats[category] = c
+    end
+    if not c then return "StringTable::InvalidKey" end
+    local a, e = text:find('<key name="' .. key .. '">', c[1], true)
+    if not a or a > c[2] then return "StringTable::InvalidKey" end
+    local s = text:match("<string>(.-)</string>", e)
+    if not s then return "StringTable::InvalidKey" end
+    return unesc(s)
+  end)
+end
+
+-- Level:HasMirrorDimension(): the floor has the mirror world (dimension 1 holding the mirrored floor): Downpour II
+-- and Dross II (Curse of the Labyrinth makes the first floor of each the one that has it), not in Greed Mode.
+-- The game's own rule as miniMAPI states it for itself (cache.lua); the game gives the layer no field for it.
+T.method("Level", "HasMirrorDimension", function(self)
+  if Game():IsGreedMode() then return false end
+  local alt = self:GetStageType()
+  if alt ~= StageType.STAGETYPE_REPENTANCE and alt ~= StageType.STAGETYPE_REPENTANCE_B then return false end
+  local stage = self:GetAbsoluteStage()
+  if stage == LevelStage.STAGE1_2 then return self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH == 0 end
+  return stage == LevelStage.STAGE1_1 and self:GetCurses() & LevelCurse.CURSE_OF_LABYRINTH ~= 0
+end)
+
+-- EntityPlayer:AddNullItemEffect(id, applyCostume = false, cooldown, additive = true) and the same for trinkets and
+-- collectibles (REPENTOGON's shortcuts of TemporaryEffects:Add*Effect with a cooldown). The effect is added through the
+-- game's own TemporaryEffects; the cooldown arguments are not applied (the game's own duration holds).
+do
+  local P = "EntityPlayer"
+  local function effect(name, fname)
+    T.method(P, name, function(self, id, costume)
+      if math.type(id) ~= "integer" then error("bad argument #1 to '" .. name .. "' (integer expected, got " .. type(id) .. ")", 2) end
+      -- a mod's <null> that has no id in its items.xml has only a reserved blank id here (api_lua.lua): no effect
+      if fname == "AddNullEffect" and (id < 0 or T.reserved_null(id)) then return end
+      self:GetEffects()[fname](self:GetEffects(), id, costume and true or false)
+    end)
+  end
+  effect("AddNullItemEffect", "AddNullEffect")
+  effect("AddTrinketEffect", "AddTrinketEffect")
+  effect("AddCollectibleEffect", "AddCollectibleEffect")
+  R.Unsupported = R.Unsupported or {}
+  R.Unsupported["EntityPlayer:Add*Effect cooldown"] = "the cooldown and additive arguments are not applied"
+end
