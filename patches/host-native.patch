diff --git a/scripts/recomp/rgon/lab_ambush_test.lua b/scripts/recomp/rgon/lab_ambush_test.lua
new file mode 100644
index 0000000..574f87a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_ambush_test.lua
@@ -0,0 +1,139 @@
+-- lab_ambush_test.lua (development only; ISAAC_RGON_LAB=lab_ambush_test.lua, worker "ambush").
+-- 1. the global Ambush exists with every function, answers 0 / defaults when no ambush runs, and the real fields read back
+--    (SetMaxBossrushWaves / SetNumBossesPerWave write the game's own fields).
+-- 2. RoomDescriptor.Data = RoomConfigRoom: written, read back (same address, Type, Variant), type-checked, and the game follows
+--    (entering the room gives the new room type).
+-- 3. RoomConfigHolder carries GetRandomRoom and gives the same room as RoomConfig for one seed.
+-- 4. a challenge room: StartChallenge sets the game's active byte (read at ambush+0x20), the wave counter moves while the
+--    waves are killed.
+-- Result lines "lab_ambush_test: PASS/FAIL ..." and "lab_ambush_test: DONE pass=N fail=M".
+local T = ...
+local B = T.B
+local r32, r8, ptr = B.r32, B.r8, B.ptr
+local mod = RegisterMod("rgon lab ambush test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_ambush_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail ~= nil and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail ~= nil and (" (" .. tostring(detail) .. ")") or "")) end
+end
+local AMB = r32(0x00c71678) -- re-read at use
+local function amb() return r32(0x00c71678) + 0x265c8 end
+
+local function names_checks()
+  for _, n in ipairs({ "GetCurrentWave", "GetMaxBossrushWaves", "SetMaxBossrushWaves", "GetNumBossesPerWave", "SetNumBossesPerWave",
+    "GetMaxChallengeWaves", "GetMaxBossChallengeWaves", "StartChallenge", "SpawnWave", "SpawnBossrushWave" }) do
+    check("Ambush." .. n .. " is a function", type(Ambush) == "table" and type(Ambush[n]) == "function")
+    check("REPENTOGON.Implemented lists Ambush." .. n, REPENTOGON == nil or REPENTOGON.Implemented == nil or REPENTOGON.Implemented["Ambush." .. n] == true)
+  end
+  check("GetCurrentWave is 0 with no ambush", Ambush.GetCurrentWave() == 0, Ambush.GetCurrentWave())
+  check("active byte is 0", r8(amb() + 0x20) == 0, r8(amb() + 0x20))
+  check("GetMaxBossrushWaves is 15", Ambush.GetMaxBossrushWaves() == 15, Ambush.GetMaxBossrushWaves())
+  check("GetMaxChallengeWaves 3, boss challenge 2", Ambush.GetMaxChallengeWaves() == 3 and Ambush.GetMaxBossChallengeWaves() == 2)
+  local nb = Ambush.GetNumBossesPerWave()
+  say("info: NumBossesPerWave " .. tostring(nb))
+  Ambush.SetNumBossesPerWave(7)
+  check("SetNumBossesPerWave reads back (real field +0x1c)", Ambush.GetNumBossesPerWave() == 7 and r32(amb() + 0x1c) == 7)
+  Ambush.SetNumBossesPerWave(nb)
+  Ambush.SetMaxBossrushWaves(40)
+  check("SetMaxBossrushWaves caps at 25", Ambush.GetMaxBossrushWaves() == 25 and r32(amb() + 0x18) == 25)
+  Ambush.SetMaxBossrushWaves(15)
+  check("SetMaxBossrushWaves restored", Ambush.GetMaxBossrushWaves() == 15)
+  check("a string argument is an error", not pcall(Ambush.SetMaxBossrushWaves, "x"))
+end
+
+local function holder_checks()
+  check("RoomConfigHolder.GetRandomRoom is a function", type(RoomConfigHolder.GetRandomRoom) == "function")
+  local a = RoomConfig.GetRandomRoom(12345, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1)
+  local b = RoomConfigHolder.GetRandomRoom(12345, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1)
+  check("same room from both tables for one seed", a ~= nil and b ~= nil and ptr(a) == ptr(b), a and b and (string.format("%x %x", ptr(a), ptr(b))))
+  for k, v in pairs(RoomConfig) do
+    if type(v) == "function" and type(k) == "string" and k:sub(1, 2) ~= "__" and type(RoomConfigHolder[k]) ~= "function" then check("RoomConfigHolder." .. k, false) end
+  end
+  for k, v in pairs(RoomConfigHolder) do
+    if type(v) == "function" and type(k) == "string" and k:sub(1, 2) ~= "__" and type(RoomConfig[k]) ~= "function" then check("RoomConfig." .. k, false) end
+  end
+end
+
+local function data_checks()
+  local level = Game():GetLevel()
+  local rooms = level:GetRooms()
+  local target, other
+  for i = 0, rooms.Size - 1 do
+    local d = rooms:Get(i)
+    if d.Data and d.Data.Type == RoomType.ROOM_DEFAULT and d.SafeGridIndex ~= level:GetCurrentRoomIndex() and d.VisitedCount == 0 then target = target or d end
+  end
+  say("info: rooms " .. rooms.Size .. " target " .. tostring(target) .. " shape " .. tostring(target and target.Data.Shape))
+
+  local shop = target and RoomConfig.GetRandomRoom(777, false, StbType.SPECIAL_ROOMS, RoomType.ROOM_SHOP, 1)
+  check("a default room and a shop config exist", target ~= nil and shop ~= nil)
+  if not (target and shop) then return end
+  local orig = target.Data
+  local origp = ptr(orig)
+  local ok, err = pcall(function() target.Data = shop end)
+  check("target.Data = shop does not error", ok, err)
+  check("read back is the same address", ptr(target.Data) == ptr(shop), string.format("%x vs %x", ptr(target.Data), ptr(shop)))
+  check("read back Type/Variant", target.Data.Type == RoomType.ROOM_SHOP and target.Data.Variant == shop.Variant, target.Data.Type .. "/" .. target.Data.Variant)
+  check("a number is an error", not pcall(function() target.Data = 5 end))
+  check("nil is an error", not pcall(function() target.Data = nil end))
+  check("a table is an error", not pcall(function() target.Data = {} end))
+  check("the Implemented name", REPENTOGON == nil or REPENTOGON.Implemented == nil or REPENTOGON.Implemented["RoomDescriptor.Data"] == true)
+  -- the const descriptor (current room)
+  local cur = level:GetCurrentRoomDesc()
+  local curdata = cur.Data
+  local ok2, err2 = pcall(function() cur.Data = curdata end)
+  check("writing the same Data to the current descriptor works", ok2 and ptr(cur.Data) == ptr(curdata), err2)
+  -- the game follows: go there
+  Game():StartRoomTransition(target.SafeGridIndex, Direction.NO_DIRECTION, RoomTransitionAnim.TELEPORT)
+  return target, origp, orig
+end
+
+local state = {}
+local step, wait = 0, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  if step == 2 then
+    local t = Game():GetRoom():GetType()
+    check("entering the rewritten room gives a shop room", t == RoomType.ROOM_SHOP, t)
+    step, wait = 3, 0
+  end
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  wait = wait + 1
+  if step == 0 and wait == 20 then
+    names_checks()
+    holder_checks()
+    local target, origp, orig = data_checks()
+    state.target, state.orig = target, orig
+    step, wait = 2, 0
+  elseif step == 2 and wait > 120 then
+    check("MC_POST_NEW_ROOM fired after the rewrite", false, "no room change")
+    step, wait = 3, 0
+  elseif step == 3 and wait == 5 then
+    if state.target and state.orig then pcall(function() state.target.Data = state.orig end) end
+    Isaac.ExecuteCommand("goto s.challenge.0")
+    step, wait = 4, 0
+  elseif step == 4 and wait == 40 then
+    local room = Game():GetRoom()
+    say("info: room type " .. room:GetType())
+    if room:GetType() ~= RoomType.ROOM_CHALLENGE then check("reached a challenge room", false, room:GetType()) step = 9 return end
+    Ambush.StartChallenge()
+    check("StartChallenge sets the active byte", r8(amb() + 0x20) == 1, r8(amb() + 0x20))
+    check("GetCurrentWave is 0 right after", Ambush.GetCurrentWave() == 0, Ambush.GetCurrentWave())
+    step, wait, state.maxwave = 5, 0, 0
+  elseif step == 5 then
+    local w = Ambush.GetCurrentWave()
+    if w > state.maxwave then state.maxwave = w say("info: wave " .. w .. " at frame " .. wait) end
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      if e:IsActiveEnemy(false) and e:IsVulnerableEnemy() then e:Kill() end
+    end
+    if wait > 900 or (state.maxwave >= 3 and wait > 100) then
+      check("the wave counter moved up to at least 2", state.maxwave >= 2, state.maxwave)
+      step = 9
+    end
+  end
+  if step == 9 then
+    step = 10
+    say(string.format("DONE pass=%d fail=%d", pass, fail))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_b2probe.lua b/scripts/recomp/rgon/lab_b2probe.lua
new file mode 100644
index 0000000..27dc99b
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b2probe.lua
@@ -0,0 +1,116 @@
+-- lab_b2probe.lua (development only; ISAAC_RGON_LAB=lab_b2probe.lua, census batch 2)
+-- Measures where Entity_Player's fields are in THIS build, by watching the structure while the game does
+-- something it should change: snapshot the player's words, act, snapshot again, log what changed
+-- ("lab_b2probe: <scenario> +OFFSET old -> new"). REPENTOGON's offset for each field is in the task text of
+-- layer-gaps.md section 9; the delta is what this lab finds.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32 = B.r32, B.ri32, B.rf32, B.w32
+local mod = RegisterMod("rgon lab b2probe", 1)
+local LO, HI = 0x1300, 0x2c00
+local function say(s) B.log("lab_b2probe: " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local function diff(name, a, before, skip)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not (skip and skip[o]) then
+      n = n + 1
+      if n <= 70 then say(string.format("%s +%04x %08x -> %08x (%d -> %d, f %g -> %g)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now, B.i2f and B.i2f(before[o]) or 0, B.i2f and B.i2f(now) or 0)) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local frame, shoot = 0, false
+local S
+local C = CollectibleType
+local function item(name) return C[name] or -1 end
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if shoot and ent and ent.Type == 1 and action == ButtonAction.ACTION_SHOOTRIGHT then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local pointers_done = false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if frame == 5 then
+    say(string.format("player at %08x type %d", a, p:GetPlayerType()))
+    -- weapon pointers: words in the player that point at an object whose +4 is the player
+    for o = 0x13a0, 0x1480, 4 do
+      local v = r32(a + o)
+      if v > 0x01000000 and v < 0x20000000 and (v & 3) == 0 then
+        local owner = r32(v + 4)
+        if owner == a then
+          say(string.format("pointer at +%04x -> %08x: vtable %08x, owner = the player, +c %g, +10 %g, +14 %g, +30 type %d, +34 mods %08x, +38 %d", o, v, r32(v), rf32(v + 0xc), rf32(v + 0x10), rf32(v + 0x14), ri32(v + 0x30), r32(v + 0x34), ri32(v + 0x38)))
+        end
+      end
+    end
+    say(string.format("MaxFireDelay %g, MoveSpeed %g, Damage %g, Luck %g, ShotSpeed %g, TearRange %g", p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange))
+    -- the six int modifiers (REPENTOGON 0x1518 + 8): write 5 into each, re-evaluate, see which stat moved
+    local base = { p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange }
+    for i = 0, 5 do
+      local at = a + 0x1520 + 4 * i
+      local old = r32(at)
+      w32(at, 5)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+      say(string.format("modifier word +%04x (was %d) = 5: MaxFireDelay %g, MoveSpeed %g, Damage %g, Luck %g, ShotSpeed %g, TearRange %g", 0x1520 + 4 * i, old, p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange))
+      w32(at, old)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+    end
+    S = snap(a)
+  elseif frame == 15 then
+    B.call(0x007d3480, a, 3)
+    diff("AddUrnSouls(3)", a, S)
+    S = snap(a)
+  elseif frame == 25 then
+    p:AddCollectible(item("COLLECTIBLE_KEEPERS_SACK"), 0, false)
+    p:AddCoins(40)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems()
+    diff("KeepersSack+40coins", a, S)
+    S = snap(a)
+  elseif frame == 40 then
+    p:AddCollectible(item("COLLECTIBLE_IMMACULATE_CONCEPTION"), 0, false)
+    p:AddSoulHearts(2) p:AddSoulHearts(2)
+    diff("ImmaculateConception", a, S)
+    S = snap(a)
+  elseif frame == 55 then
+    p:AddCollectible(item("COLLECTIBLE_MARKED"), 0, false)
+    S = snap(a)
+  elseif frame == 90 then
+    diff("Marked (35 frames later)", a, S)
+    for o = 0x13a0, 0x1480, 4 do
+      local v = r32(a + o)
+      if v > 0x01000000 and v < 0x20000000 and (v & 3) == 0 then
+        local ty, va = ri32(v + 0x28), ri32(v + 0x2c)
+        if ty >= 1 and ty <= 1000 or ty == 1000 then say(string.format("entity-like pointer at +%04x -> %08x type %d variant %d", o, v, ty, va)) end
+      end
+    end
+    local found = false
+    for _, e in ipairs(Isaac.FindByType(1000, 30)) do say(string.format("a TARGET effect at %08x", B.ptr(e))) found = true end
+    S = snap(a)
+    shoot = true
+  elseif frame == 100 or frame == 110 then
+    diff("shooting at f" .. frame, a, S, nil)
+    S = snap(a)
+  elseif frame == 112 then
+    shoot = false
+    say(string.format("tear displacement candidates: +1578 byte %d, +1574 %08x", B.r8(a + 0x1578), r32(a + 0x1574)))
+  elseif frame == 130 then
+    -- player forms: three Sad Onion-like? give Leviathan pieces: Spun? Use Guppy's items (3 = guppy form)
+    S = snap(a)
+    for _, n in ipairs({ "COLLECTIBLE_GUPPYS_PAW", "COLLECTIBLE_GUPPYS_TAIL", "COLLECTIBLE_GUPPYS_HEAD" }) do p:AddCollectible(item(n), 0, false) end
+    say("HasPlayerForm(GUPPY) " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)))
+    diff("Guppy form", a, S)
+  elseif frame == 150 then
+    say("DONE")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_b2probe2.lua b/scripts/recomp/rgon/lab_b2probe2.lua
new file mode 100644
index 0000000..55d9abd
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b2probe2.lua
@@ -0,0 +1,131 @@
+-- lab_b2probe2.lua (development only; ISAAC_RGON_LAB=lab_b2probe2.lua, census batch 2): second round of
+-- lab_b2probe.lua, one scenario at a time with its own diff (see that file's header).
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32, r8 = B.r32, B.ri32, B.rf32, B.w32, B.r8
+local mod = RegisterMod("rgon lab b2probe2", 1)
+local LO, HI = 0x1300, 0x2c00
+local function say(s) B.log("lab_b2probe2: " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local SKIP = {}
+local function diff(name, a, before)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not SKIP[o] then
+      n = n + 1
+      if n <= 40 then say(string.format("%s +%04x %08x -> %08x (%d -> %d, f %g -> %g)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now, B.i2f(before[o]), B.i2f(now))) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local frame, held = 0, {}
+local S
+local C = CollectibleType
+local function item(name)
+  local v = C[name]
+  if not v then say("no CollectibleType." .. name) return -1 end
+  return v
+end
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local function words(a, from, to)
+  local t = {}
+  for o = from, to - 4, 4 do t[#t + 1] = string.format("%08x", r32(a + o)) end
+  return table.concat(t, " ")
+end
+local knife
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if frame == 5 then
+    for _, pat in ipairs({ "SUPLEX", "SUMPTORIUM", "IMMACULATE", "CAMBION", "RED_STEW", "PONY", "KEEPER", "PLAN_C", "DEAD_EYE", "MARKED", "POOP", "URN", "MAGGY", "LILITH", "BLADDER", "URETHRA" }) do
+      local t = {}
+      for k, v in pairs(C) do if k:find(pat) then t[#t + 1] = k .. "=" .. v end end
+      say("items matching " .. pat .. ": " .. table.concat(t, " "))
+    end
+    say("weapon slots 0x13d4..0x13f4: " .. words(a, 0x13d4, 0x13f4))
+    say(string.format("weapon 1 direction words +20..+2c: %g %g (shooting right will set later), HeadFrameDelay %d", rf32(r32(a + 0x13e0) + 0x20), rf32(r32(a + 0x13e0) + 0x24), p.HeadFrameDelay))
+    -- head direction: set the direction and the lock by hand, see what the game does with it
+    S = snap(a)
+  elseif frame == 8 then
+    say(string.format("head direction now %d; words 0x1320..0x1340: %s; +1628 %d", p:GetHeadDirection(), words(a, 0x1320, 0x1340), ri32(a + 0x1628)))
+    w32(a + 0x1628, 1) w32(a + 0x1338, 40)
+  elseif frame == 12 then
+    say(string.format("head direction after the write %d (1 = left); 0x1338 %d; words 0x1320..0x1340: %s", p:GetHeadDirection(), ri32(a + 0x1338), words(a, 0x1320, 0x1340)))
+    S = snap(a)
+  elseif frame == 20 then
+    -- a bomb through the input hook
+    held[ButtonAction.ACTION_BOMB] = true
+    S = snap(a)
+  elseif frame == 22 then
+    held[ButtonAction.ACTION_BOMB] = nil
+    diff("bomb placed", a, S)
+    S = snap(a)
+  elseif frame == 30 then
+    p:AddCollectible(item("COLLECTIBLE_IMMACULATE_CONCEPTION"), 0, false)
+    p:AddSoulHearts(-6) p:AddSoulHearts(4)
+    S = snap(a)
+    for i = 1, 3 do Isaac.Spawn(5, 10, 3, p.Position, Vector(0, 0), nil) end
+  elseif frame == 50 then
+    diff("soul hearts picked up with Immaculate Conception", a, S)
+    S = snap(a)
+  elseif frame == 55 then
+    p:AddCollectible(item("COLLECTIBLE_SUMPTORIUM"), 0, false)
+    S = snap(a)
+  elseif frame == 60 then
+    p:TakeDamage(1, 0, EntityRef(nil), 0)
+    SKIP = {}
+    S = S
+  elseif frame == 90 then
+    diff("Sumptorium + damage taken", a, S)
+    S = snap(a)
+  elseif frame == 95 then
+    p:AddCollectible(item("COLLECTIBLE_RED_STEW"), 0, false)
+    p:SetActiveCharge(12, 0)
+    S = snap(a)
+    p:UseActiveItem(item("COLLECTIBLE_RED_STEW"), UseFlag.USE_NOANIM, 0)
+  elseif frame == 110 then
+    diff("Red Stew used", a, S)
+    S = snap(a)
+  elseif frame == 115 then
+    p:AddCollectible(item("COLLECTIBLE_KEEPERS_SACK"), 0, false)
+    S = snap(a)
+    p:UseActiveItem(item("COLLECTIBLE_PONY"), UseFlag.USE_NOANIM, 0)
+    p:AddCollectible(item("COLLECTIBLE_PONY"), 0, false)
+    p:UseActiveItem(item("COLLECTIBLE_PONY"), UseFlag.USE_NOANIM, 0)
+  elseif frame == 130 then
+    diff("Pony used", a, S)
+    S = snap(a)
+  elseif frame == 135 then
+    -- coins picked up with Keeper's Sack
+    for i = 1, 6 do Isaac.Spawn(5, 20, 1, p.Position, Vector(0, 0), nil) end
+  elseif frame == 160 then
+    diff("coins picked up with Keeper's Sack", a, S)
+    S = snap(a)
+  elseif frame == 165 then
+    -- knives
+    local p0 = p
+    knife = p0:FireKnife(p0, 0, false, 0, 1)   -- bone club
+    say("fired a knife: " .. tostring(knife))
+    if knife then
+      local k = B.ptr(knife)
+      say(string.format("knife %08x type %d variant %d: +444 %g +448 %g +465 %02x +466 %02x +4d8 %08x %08x %08x +4e5 %02x +4e6 %02x +4e7 %02x +4ea %02x +45c %g +460 %g", k, ri32(k + 0x28), ri32(k + 0x2c),
+        rf32(k + 0x444), rf32(k + 0x448), r8(k + 0x465), r8(k + 0x466), r32(k + 0x4d8), r32(k + 0x4dc), r32(k + 0x4e0), r8(k + 0x4e5), r8(k + 0x4e6), r8(k + 0x4e7), r8(k + 0x4ea), rf32(k + 0x45c), rf32(k + 0x460)))
+    end
+  elseif frame >= 166 and frame <= 200 and knife and frame % 5 == 0 then
+    local k = B.ptr(knife)
+    say(string.format("f%d knife: +444 %g +448 %g +465 %02x +466 %02x hitlist %08x..%08x +4e5 %02x +4e6 %02x +4ea %02x charge %g", frame, rf32(k + 0x444), rf32(k + 0x448), r8(k + 0x465), r8(k + 0x466), r32(k + 0x4d8), r32(k + 0x4dc), r8(k + 0x4e5), r8(k + 0x4e6), r8(k + 0x4ea), rf32(k + 0x460)))
+  elseif frame == 201 then
+    say("DONE")
+  end
+end)
