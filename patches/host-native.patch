diff --git a/scripts/recomp/rgon/lab_b3probe.lua b/scripts/recomp/rgon/lab_b3probe.lua
new file mode 100644
index 0000000..e2a9fb8
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b3probe.lua
@@ -0,0 +1,90 @@
+-- lab_b3probe.lua (development only; ISAAC_RGON_LAB=lab_b3probe.lua, census batch 3): measures the Weapon's
+-- virtual functions and its direction vector in this build. For the primary weapon of a player with tears, then
+-- Brimstone, Monstro's Lung and Chocolate Milk (a charge weapon each), logs the first bytes of the vtable
+-- functions 0..16, GetMaxCharge (slot 6, a float in st0) and GetMainEntity (slot 10), and the weapon's words
+-- 0x08..0x3c while the player shoots right and then up ("lab_b3probe: ..").
+local T = ...
+local B = T.B
+local r8, r32, ri32, rf32, call = B.r8, B.r32, B.ri32, B.rf32, B.call
+local mod = RegisterMod("rgon lab b3probe", 1)
+local function say(s) B.log("lab_b3probe: " .. s) end
+local function hex(a, n)
+  local t = {}
+  for i = 0, n - 1 do t[#t + 1] = string.format("%02x", r8(a + i)) end
+  return table.concat(t)
+end
+local dir = nil
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if dir and ent and ent.Type == 1 and action == dir then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local frame = 0
+local function weapon_of(p) return r32(p.Position and (B.ptr(p) + 0x13dc + 4)) end
+local function words(w, lo, hi)
+  local t = {}
+  for o = lo, hi, 4 do t[#t + 1] = string.format("%02x:%08x", o, r32(w + o)) end
+  return table.concat(t, " ")
+end
+local function describe(tag, p)
+  local w = weapon_of(p)
+  if w == 0 then say(tag .. ": no primary weapon") return end
+  local vt = r32(w)
+  say(string.format("%s: weapon %x type %d vtable %x", tag, w, ri32(w + 0x30), vt))
+  for i = 0, 16 do
+    local f = r32(vt + 4 * i)
+    say(string.format("  vt[%d] = %x  %s", i, f, hex(f, 12)))
+  end
+  local eax, st0 = call(r32(vt + 4 * 6), w)
+  say(string.format("  GetMaxCharge call: eax=%x st0=%g", eax, st0 or -1))
+  local m = call(r32(vt + 4 * 10), w)
+  say(string.format("  GetMainEntity call: %x (player %x)", m, B.ptr(p)))
+  say("  words " .. words(w, 0x08, 0x3c))
+end
+local steps = {}
+local function step(at, f) steps[at] = f end
+local function setup(tag, item, from)
+  step(from, function()
+    local p = Isaac.GetPlayer(0)
+    for _, c in ipairs({ CollectibleType.COLLECTIBLE_BRIMSTONE, CollectibleType.COLLECTIBLE_MONSTROS_LUNG, CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, CollectibleType.COLLECTIBLE_TECHNOLOGY, CollectibleType.COLLECTIBLE_MOMS_KNIFE }) do
+      if p:HasCollectible(c) then p:RemoveCollectible(c) end
+    end
+    if item then p:AddCollectible(item, 0, false) end
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    dir = nil
+  end)
+  step(from + 5, function() describe(tag .. " idle", Isaac.GetPlayer(0)) end)
+  step(from + 8, function() dir = ButtonAction.ACTION_SHOOTRIGHT end)
+  for i = 0, 12, 3 do
+    step(from + 10 + i, function()
+      local p = Isaac.GetPlayer(0)
+      local w = weapon_of(p)
+      if w ~= 0 then say(tag .. " shooting right +" .. i .. ": " .. words(w, 0x08, 0x3c)) end
+    end)
+  end
+  step(from + 30, function() dir = ButtonAction.ACTION_SHOOTUP end)
+  for i = 0, 12, 3 do
+    step(from + 32 + i, function()
+      local p = Isaac.GetPlayer(0)
+      local w = weapon_of(p)
+      if w ~= 0 then say(tag .. " shooting up +" .. i .. ": " .. words(w, 0x08, 0x3c)) end
+    end)
+  end
+  step(from + 50, function() dir = nil end)
+  step(from + 55, function() local p = Isaac.GetPlayer(0) local w = weapon_of(p) if w ~= 0 then say(tag .. " released: " .. words(w, 0x08, 0x3c)) end end)
+end
+setup("tears", nil, 5)
+setup("brimstone", CollectibleType.COLLECTIBLE_BRIMSTONE, 80)
+setup("monstros lung", CollectibleType.COLLECTIBLE_MONSTROS_LUNG, 155)
+setup("chocolate milk", CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, 230)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local f = steps[frame]
+  if f then
+    local ok, err = pcall(f)
+    if not ok then say("step " .. frame .. " failed: " .. tostring(err)) end
+  end
+  if frame == 320 then say("DONE") end
+end)
diff --git a/scripts/recomp/rgon/lab_b3probe2.lua b/scripts/recomp/rgon/lab_b3probe2.lua
new file mode 100644
index 0000000..f7219ba
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b3probe2.lua
@@ -0,0 +1,46 @@
+-- lab_b3probe2.lua (development only; ISAAC_RGON_LAB=lab_b3probe2.lua, census batch 3): the room descriptor's
+-- layout in this build. Compares the vanilla Lua fields with REPENTOGON's offsets, the stride of the level's
+-- descriptor list, and dumps the constructor (RoomDescriptor::constructor, 0x006ef590) so the store to the
+-- Group field (REPENTOGON: +0xb4) can be found ("lab_b3probe2: ..").
+local T = ...
+local B = T.B
+local r8, r32, ri32, ptr = B.r8, B.r32, B.ri32, B.ptr
+local mod = RegisterMod("rgon lab b3probe2", 1)
+local function say(s) B.log("lab_b3probe2: " .. s) end
+local frame = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame ~= 3 then return end
+  local level = Game():GetLevel()
+  local d = level:GetCurrentRoomDesc()
+  local p = ptr(d)
+  say(string.format("current descriptor at %x", p))
+  local fields = { { "GridIndex", 0x0 }, { "SafeGridIndex", 0x4 }, { "ListIndex", 0x8 }, { "Data", 0x10 }, { "OverrideData", 0x14 },
+    { "AllowedDoors", 0x18 }, { "DisplayFlags", 0x3c }, { "VisitedCount", 0x40 }, { "Flags", 0x44 }, { "DecorationSeed", 0x58 },
+    { "SpawnSeed", 0x5c }, { "AwardSeed", 0x60 }, { "DeliriumDistance", 0xb0 } }
+  for _, f in ipairs(fields) do
+    local v = d[f[1]]
+    local raw = r32(p + f[2])
+    local shown = type(v) == "userdata" and ptr(v) or v
+    say(string.format("%-16s lua %s  raw@%02x %d (0x%x)  %s", f[1], tostring(shown), f[2], ri32(p + f[2]), raw, (shown == ri32(p + f[2]) or shown == raw) and "same" or "DIFFERENT"))
+  end
+  say(string.format("Dimension raw@0c %d; Group raw@b4 %d; words 0xa8..0xbc: %08x %08x %08x %08x %08x %08x", ri32(p + 0xc), ri32(p + 0xb4),
+    r32(p + 0xa8), r32(p + 0xac), r32(p + 0xb0), r32(p + 0xb4), r32(p + 0xb8), r32(p + 0xbc)))
+  -- the stride between descriptors of the level's list, and the Group word of each
+  local list = level:GetRooms()
+  local prev
+  local strides, groups, dims = {}, {}, {}
+  for i = 0, list.Size - 1 do
+    local q = ptr(list:Get(i))
+    if prev then strides[#strides + 1] = q - prev end
+    prev = q
+    groups[#groups + 1] = ri32(q + 0xb4)
+    dims[#dims + 1] = ri32(q + 0xc)
+  end
+  say("GetRooms strides " .. table.concat(strides, ","))
+  say("Group word of each " .. table.concat(groups, ","))
+  say("Dimension word of each " .. table.concat(dims, ","))
+  local code = {}
+  for i = 0, 0x1ff do code[#code + 1] = string.format("%02x", r8(0x006ef590 + i)) end
+  say("CTOR " .. table.concat(code))
+end)
diff --git a/scripts/recomp/rgon/lab_b4_cb.lua b/scripts/recomp/rgon/lab_b4_cb.lua
new file mode 100644
index 0000000..cf05da1
--- /dev/null
+++ b/scripts/recomp/rgon/lab_b4_cb.lua
@@ -0,0 +1,111 @@
+-- lab_b4_cb.lua (development only; ISAAC_RGON_LAB=lab_b4_cb.lua, batch B4)
+-- MC_MENU_INPUT_ACTION and MC_PRE/POST_GLOWING_HOURGLASS_LOAD/SAVE, logged with their arguments, plus a real
+-- Glowing Hourglass use: collectible 422 is given in the start room, the player goes to another room, the item is
+-- used there and must restore the state of the previous room (the log says which room and the frame).
+-- Prints "DONE n PASS m FAIL" at the end of the run's checks.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab b4", 1)
+local pass, fail = 0, 0
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_b4: %s %s", ok and "PASS" or "FAIL", what))
+end
+local counts, first = {}, {}
+local function seen(name, ...)
+  counts[name] = (counts[name] or 0) + 1
+  local c = counts[name]
+  local a = {}
+  for i = 1, select("#", ...) do a[#a + 1] = tostring((select(i, ...))) end
+  first[name] = first[name] or table.concat(a, ",")
+  if c <= 4 then
+    B.log(string.format("lab_b4: %s #%d f%d (%s) ingame=%s", name, c, Isaac.GetFrameCount(), table.concat(a, ","), tostring(Isaac.IsInGame())))
+  end
+end
+for _, n in ipairs({ "MC_PRE_GLOWING_HOURGLASS_SAVE", "MC_POST_GLOWING_HOURGLASS_SAVE", "MC_PRE_GLOWING_HOURGLASS_LOAD",
+                     "MC_POST_GLOWING_HOURGLASS_LOAD" }) do
+  mod:AddCallback(M[n], function(_, ...) seen(n, ...) end)
+end
+-- Answer test: the callback answers true to IS_ACTION_TRIGGERED(MENUUP) and 0.75 to GET_ACTION_VALUE(MENUUP), and
+-- nothing for MENUDOWN. From MAIN_MENU_RENDER the lab then calls the game's own input accessors (0x009561e0
+-- IsActionTriggered, 0x009562d0 GetActionValue; stdcall action, controller, entity, flag) and reads their results:
+-- the answers must come back for MENUUP and the game's own (false, 0) for MENUDOWN, as REPENTOGON's override of the
+-- input. The title menu's own queries (MENULEFT/RIGHT, triggered) are counted too.
+local pairs_seen = {}
+local menu_frames = 0
+mod:AddCallback(M.MC_MENU_INPUT_ACTION, function(_, ent, hook, action)
+  seen("MC_MENU_INPUT_ACTION", ent, hook, action)
+  pairs_seen[hook .. "/" .. action] = (pairs_seen[hook .. "/" .. action] or 0) + 1
+  if Isaac.IsInGame() then B.log("lab_b4: FAIL MC_MENU_INPUT_ACTION fired inside a run") fail = fail + 1 end
+  if action == ButtonAction.ACTION_MENUUP then
+    if hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 0.75 end
+  end
+end)
+local menu_done = false
+mod:AddCallback(M.MC_MAIN_MENU_RENDER, function()
+  menu_frames = menu_frames + 1
+  if menu_frames == 300 and not menu_done then
+    menu_done = true
+    local up = B.call(0x009561e0, nil, ButtonAction.ACTION_MENUUP, 0, 0, 0) & 0xff
+    local down = B.call(0x009561e0, nil, ButtonAction.ACTION_MENUDOWN, 0, 0, 0) & 0xff
+    local _, upv = B.call(0x009562d0, nil, ButtonAction.ACTION_MENUUP, 0, 0, 0)
+    local _, downv = B.call(0x009562d0, nil, ButtonAction.ACTION_MENUDOWN, 0, 0, 0)
+    B.log(string.format("lab_b4: accessor results: triggered(UP)=%d triggered(DOWN)=%d value(UP)=%s value(DOWN)=%s", up, down, tostring(upv), tostring(downv)))
+    local ps = {}
+    for k, v in pairs(pairs_seen) do ps[#ps + 1] = k .. "x" .. v end
+    table.sort(ps)
+    B.log("lab_b4: queries seen by the callback (hook/action): " .. table.concat(ps, " "))
+    check(up == 1, "answer true replaced the triggered query of MENUUP")
+    check(down == 0, "no answer: the triggered query of MENUDOWN is the game's own (0)")
+    -- the float comes back in XMM0, which B.call does not return (only EAX, ST0, EDX): the callback is seen to run for
+    -- value queries (hook 2 in the list above) but its 0.75 reaching XMM0 is not observed here
+  end
+end)
+
+local state, wait, other, room_before = "wait", 0, nil, nil
+local function say(s) B.log("lab_b4: f" .. Isaac.GetFrameCount() .. " " .. s) end
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  local game = Game()
+  local level = game:GetLevel()
+  local p = Isaac.GetPlayer(0)
+  wait = wait + 1
+  if state == "wait" and wait == 40 then
+    B.log(string.format("lab_b4: in run: manager state=%d isingame=%s", B.r32(B.r32(0xc7169c) + 8), tostring(Isaac.IsInGame())))
+    p:AddCollectible(422, 0, false)
+    say("gave collectible 422, has=" .. tostring(p:HasCollectible(422)) .. " room " .. level:GetCurrentRoomIndex())
+    -- another room of the level to walk into
+    local rooms = level:GetRooms()
+    for i = 0, rooms.Size - 1 do
+      local d = rooms:Get(i)
+      if d.GridIndex ~= level:GetCurrentRoomIndex() and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then other = d.GridIndex break end
+    end
+    if not other then
+      for i = 0, rooms.Size - 1 do
+        local d = rooms:Get(i)
+        if d.GridIndex ~= level:GetCurrentRoomIndex() then other = d.GridIndex break end
+      end
+    end
+    room_before = level:GetCurrentRoomIndex()
+    say("going to room " .. tostring(other))
+    game:ChangeRoom(other)
+    state, wait = "moved", 0
+  elseif state == "moved" and wait == 60 then
+    say("now in room " .. level:GetCurrentRoomIndex() .. ", using 422")
+    check(level:GetCurrentRoomIndex() == other, "player is in the other room before the use")
+    local before = counts.MC_PRE_GLOWING_HOURGLASS_LOAD or 0
+    p:UseActiveItem(422, UseFlag.USE_NOANIM)
+    state, wait, T.b4_before = "used", 0, before
+  elseif state == "used" and wait == 90 then
+    say("after the use, room " .. level:GetCurrentRoomIndex())
+    check((counts.MC_PRE_GLOWING_HOURGLASS_SAVE or 0) >= 1, "PRE_GLOWING_HOURGLASS_SAVE fired (" .. tostring(counts.MC_PRE_GLOWING_HOURGLASS_SAVE) .. ")")
+    check((counts.MC_POST_GLOWING_HOURGLASS_SAVE or 0) >= 1, "POST_GLOWING_HOURGLASS_SAVE fired (" .. tostring(counts.MC_POST_GLOWING_HOURGLASS_SAVE) .. ")")
+    check((counts.MC_PRE_GLOWING_HOURGLASS_LOAD or 0) > T.b4_before, "PRE_GLOWING_HOURGLASS_LOAD fired by the use (" .. tostring(counts.MC_PRE_GLOWING_HOURGLASS_LOAD) .. ", args " .. tostring(first.MC_PRE_GLOWING_HOURGLASS_LOAD) .. ")")
+    check((counts.MC_POST_GLOWING_HOURGLASS_LOAD or 0) >= 1, "POST_GLOWING_HOURGLASS_LOAD fired (" .. tostring(counts.MC_POST_GLOWING_HOURGLASS_LOAD) .. ")")
+    check(level:GetCurrentRoomIndex() == room_before, "the use took the player back to room " .. tostring(room_before))
+    check((counts.MC_MENU_INPUT_ACTION or 0) >= 1, "MC_MENU_INPUT_ACTION fired outside a run (" .. tostring(counts.MC_MENU_INPUT_ACTION) .. ", first args " .. tostring(first.MC_MENU_INPUT_ACTION) .. ")")
+    B.log(string.format("lab_b4: DONE %d PASS %d FAIL", pass, fail))
+    state = "done"
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_batch2_test.lua b/scripts/recomp/rgon/lab_batch2_test.lua
new file mode 100644
index 0000000..6134db0
--- /dev/null
+++ b/scripts/recomp/rgon/lab_batch2_test.lua
@@ -0,0 +1,169 @@
+-- lab_batch2_test.lua (development only; ISAAC_RGON_LAB=lab_batch2_test.lua, census batch 2): runs the names of
+-- api_batch_two.lua in the first room, a step per frame, and logs "lab_batch2_test: PASS/FAIL ..". Readers are
+-- checked against values the game itself holds; writers by reading back (and by the game's own reaction where
+-- there is one: a stat that moves, a head that turns).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab batch2 test", 1)
+local function check(name, ok, detail)
+  B.log("lab_batch2_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+local function near(a, b) return math.abs(a - b) < 0.01 end
+local held = {}
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+
+local frame, knife, dummies = 0, nil, {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 5 then
+    try("exists", function()
+      for _, n in ipairs({ "EntityPlayer.GetSpeedModifier", "EntityPlayer.SetLuckModifier", "EntityPlayer.GetWeapon", "EntityPlayer.SetLaserColor",
+        "EntityPlayer.GetMarkedTarget", "EntityPlayer.SetHeadDirection", "EntityPlayer.GetUrnSouls", "Weapon.GetWeaponType", "EntityKnife.AddToHitList" }) do
+        check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+      end
+    end)
+    try("stat modifiers", function()
+      local fields = { "Speed", "FireDelay", "Damage", "TearRange", "ShotSpeed", "Luck" }
+      local stat = { Speed = "MoveSpeed", FireDelay = "MaxFireDelay", Damage = "Damage", TearRange = "TearRange", ShotSpeed = "ShotSpeed", Luck = "Luck" }
+      local base = {}
+      for _, f in ipairs(fields) do base[f] = p[stat[f]] check("Get" .. f .. "Modifier starts 0", p["Get" .. f .. "Modifier"](p) == 0) end
+      for _, f in ipairs(fields) do
+        p["Set" .. f .. "Modifier"](p, 5)
+        check("Get" .. f .. "Modifier reads back", p["Get" .. f .. "Modifier"](p) == 5)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+        local v = p[stat[f]]
+        check("Set" .. f .. "Modifier moves " .. stat[f], v ~= base[f], base[f] .. " -> " .. v)
+        p["Set" .. f .. "Modifier"](p, 0)
+        p:AddCacheFlags(CacheFlag.CACHE_ALL)
+        p:EvaluateItems()
+        check("Set" .. f .. "Modifier 0 restores " .. stat[f], near(p[stat[f]], base[f]), p[stat[f]])
+      end
+    end)
+    try("head and bomb delay", function()
+      p:SetBombPlaceDelay(7)
+      check("SetBombPlaceDelay", p:GetBombPlaceDelay() == 7, p:GetBombPlaceDelay())
+      p:SetBombPlaceDelay(0)
+      p:SetHeadDirectionLockTime(33)
+      check("SetHeadDirectionLockTime", p:GetHeadDirectionLockTime() == 33, p:GetHeadDirectionLockTime())
+      p:SetHeadDirection(1, 40, true)
+      check("SetHeadDirection(1) -> GetHeadDirection", p:GetHeadDirection() == 1, p:GetHeadDirection())
+      check("SetHeadDirection time", p:GetHeadDirectionLockTime() == 40, p:GetHeadDirectionLockTime())
+      local ok = pcall(p.SetHeadDirection, p, 9, 1)
+      check("SetHeadDirection(9) errors", not ok)
+    end)
+    try("tear displacement", function()
+      p:SetTearDisplacement(-1)
+      check("SetTearDisplacement(-1)", p:GetTearDisplacement() == -1, p:GetTearDisplacement())
+      p:SetTearDisplacement(1)
+      check("SetTearDisplacement(1)", p:GetTearDisplacement() == 1, p:GetTearDisplacement())
+      check("SetTearDisplacement(2) errors", not pcall(p.SetTearDisplacement, p, 2))
+    end)
+    try("urn", function()
+      local before = p:GetUrnSouls()
+      p:AddUrnSouls(3)
+      check("AddUrnSouls(3) -> GetUrnSouls", p:GetUrnSouls() == before + 3, before .. " -> " .. p:GetUrnSouls())
+    end)
+    try("laser colour", function()
+      p:SetLaserColor(Color(1, 0.25, 0.5, 1, 0, 0, 0))
+      local c = p.LaserColor
+      check("SetLaserColor reads back through LaserColor", near(c.R, 1) and near(c.G, 0.25) and near(c.B, 0.5), string.format("%g %g %g", c.R, c.G, c.B))
+    end)
+    try("weapon", function()
+      local w = p:GetWeapon(1)
+      check("GetWeapon(1) is a weapon", w ~= nil, tostring(w))
+      check("Weapon:GetOwner is the player", GetPtrHash(w:GetOwner()) == GetPtrHash(p))
+      check("Weapon:GetWeaponType == tears (1)", w:GetWeaponType() == WeaponType.WEAPON_TEARS, w:GetWeaponType())
+      check("Weapon:GetMaxFireDelay == player's", near(w:GetMaxFireDelay(), p.MaxFireDelay), w:GetMaxFireDelay() .. " vs " .. p.MaxFireDelay)
+      w:SetCharge(1.5)
+      check("Weapon:SetCharge reads back", near(w:GetCharge(), 1.5), w:GetCharge())
+      w:SetCharge(0)
+      w:SetFireDelay(3)
+      check("Weapon:SetFireDelay reads back", near(w:GetFireDelay(), 3), w:GetFireDelay())
+      local m0 = w:GetModifiers()
+      w:SetModifiers(0x4)
+      check("Weapon:SetModifiers ORs", w:GetModifiers() == (m0 | 0x4), w:GetModifiers())
+      w:SetModifiers(0)
+      check("Weapon:IsAxisAligned is a boolean", type(w:IsAxisAligned()) == "boolean", tostring(w:IsAxisAligned()))
+      check("GetWeapon(3) is nil", p:GetWeapon(3) == nil, tostring(p:GetWeapon(3)))
+      check("GetWeapon(5) errors", not pcall(p.GetWeapon, p, 5))
+    end)
+    try("costume visibility", function()
+      local cfg = Isaac.GetItemConfig()
+      local item = cfg:GetCollectible(CollectibleType.COLLECTIBLE_SAD_ONION)
+      p:AddCollectible(CollectibleType.COLLECTIBLE_SAD_ONION, 0, false)
+      local mine = p:IsItemCostumeVisible(item, 0)
+      check("IsItemCostumeVisible == IsCollectibleCostumeVisible", mine == p:IsCollectibleCostumeVisible(CollectibleType.COLLECTIBLE_SAD_ONION, 0), tostring(mine))
+      check("IsNullItemCostumeVisible is a boolean", type(p:IsNullItemCostumeVisible(NullItemID.ID_LOST_CURSE, 0)) == "boolean")
+    end)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_MARKED, 0, false)
+    check("GetMarkedTarget is nil before Marked fires", p:GetMarkedTarget() == nil, tostring(p:GetMarkedTarget()))
+  elseif frame == 12 then
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  elseif frame == 45 then
+    try("marked target", function()
+      local t = p:GetMarkedTarget()
+      check("GetMarkedTarget is the TARGET effect", t ~= nil and t.Type == 1000 and t.Variant == 30, t and (t.Type .. "." .. t.Variant) or "nil")
+    end)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+  elseif frame == 60 then
+    try("knife setup", function()
+      knife = p:FireKnife(p, 0, false, 0, 1)
+      check("FireKnife gave a knife", knife ~= nil, tostring(knife))
+      for i = 1, 12 do dummies[i] = Isaac.Spawn(10, 0, 0, p.Position + Vector(60 + 20 * i, 0), Vector(0, 0), nil) end
+    end)
+  elseif frame == 62 and knife then
+    try("knife", function()
+      local k = knife
+      k:SetIsSwinging(false) check("SetIsSwinging(false)", k:GetIsSwinging() == false)
+      k:SetIsSwinging(true) check("SetIsSwinging(true)", k:GetIsSwinging() == true)
+      k:SetIsSpinAttack(true) check("SetIsSpinAttack(true)", k:GetIsSpinAttack() == true)
+      k:SetIsSpinAttack(false) check("SetIsSpinAttack(false)", k:GetIsSpinAttack() == false)
+      k:SetPrismTouched(true) check("SetPrismTouched(true)", k:IsPrismTouched() == true)
+      k:SetPrismTouched(false) check("SetPrismTouched(false)", k:IsPrismTouched() == false)
+      k:SetMultidimensionalTouched(true) check("SetMultidimensionalTouched(true)", k:IsMultidimensionalTouched() == true)
+      k:SetMultidimensionalTouched(false) check("SetMultidimensionalTouched(false)", k:IsMultidimensionalTouched() == false)
+      k:SetKnifeDistance(77.5) check("SetKnifeDistance reads back through GetKnifeDistance", near(k:GetKnifeDistance(), 77.5), k:GetKnifeDistance())
+      k:SetKnifeVelocity(3.25) check("SetKnifeVelocity reads back through GetKnifeVelocity", near(k:GetKnifeVelocity(), 3.25), k:GetKnifeVelocity())
+      local n0 = #k:GetHitList()
+      check("GetHitList is a table", type(k:GetHitList()) == "table", n0)
+      k:AddToHitList(dummies[1])
+      check("AddToHitList -> InHitList", k:InHitList(dummies[1]) == true)
+      check("AddToHitList grows the list", #k:GetHitList() == n0 + 1, #k:GetHitList())
+      k:AddToHitList(dummies[1])
+      check("AddToHitList twice adds once", #k:GetHitList() == n0 + 1, #k:GetHitList())
+      for i = 2, 12 do k:AddToHitList(dummies[i]) end
+      local all = true
+      for i = 1, 12 do if not k:InHitList(dummies[i]) then all = false end end
+      check("12 entities in the hit list (past its first capacity)", all and #k:GetHitList() == n0 + 12, #k:GetHitList())
+      k:RemoveFromHitList(dummies[5])
+      check("RemoveFromHitList", not k:InHitList(dummies[5]) and k:InHitList(dummies[12]) and #k:GetHitList() == n0 + 11, #k:GetHitList())
+      check("GetHitList holds GetHitListIndex values", (function() for _, v in ipairs(k:GetHitList()) do if v == dummies[2]:GetHitListIndex() then return true end end end)() == true)
+      -- the block that was committed unrun: the hitbox parent knife is only what a mod set (not in Implemented)
+      check("GetHitboxParentKnife starts nil", k:GetHitboxParentKnife() == nil)
+      -- the first knife of this lab is already gone by now, and a gone parent answers nil: use a fresh one
+      local parent = p:FireKnife(p, 0, false, 0, 1)
+      k:SetHitboxParentKnife(parent)
+      check("SetHitboxParentKnife -> GetHitboxParentKnife", parent ~= nil and parent:Exists() and k:GetHitboxParentKnife() ~= nil
+        and GetPtrHash(k:GetHitboxParentKnife()) == GetPtrHash(parent), tostring(k:GetHitboxParentKnife()) .. " exists=" .. tostring(parent and parent:Exists()))
+      parent:Remove()
+      k:SetHitboxParentKnife(nil)
+      check("SetHitboxParentKnife(nil) clears it", k:GetHitboxParentKnife() == nil)
+      check("SetHitboxParentKnife(number) errors", not pcall(k.SetHitboxParentKnife, k, 5))
+      check("Get/SetHitboxParentKnife are not counted as implemented", REPENTOGON.Implemented["EntityKnife.GetHitboxParentKnife"] == nil)
+    end)
+  elseif frame == 90 then
+    check("the game survived the knife hit list", Isaac.GetPlayer(0) ~= nil)
+    B.log("lab_batch2_test: DONE")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_batch3_test.lua b/scripts/recomp/rgon/lab_batch3_test.lua
new file mode 100644
index 0000000..b312b2c
--- /dev/null
+++ b/scripts/recomp/rgon/lab_batch3_test.lua
@@ -0,0 +1,237 @@
+-- lab_batch3_test.lua (development only; ISAAC_RGON_LAB=lab_batch3_test.lua, census batch 3): runs the names of
+-- api_batch_three.lua in the first room, a step per frame, and logs "lab_batch3_test: PASS/FAIL ..". Readers are
+-- checked against values the game itself holds.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab batch3 test", 1)
+local function check(name, ok, detail)
+  B.log("lab_batch3_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function near(a, b) return math.abs(a - b) < 0.01 end
+local dir = nil
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if dir and ent and ent.Type == 1 and action == dir then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+
+local steps, frame = {}, 0
+local function at(f, fn) steps[f] = function() local ok, err = pcall(fn) if not ok then check("step " .. f, false, err) end end end
+local function reset(p)
+  for _, c in ipairs({ CollectibleType.COLLECTIBLE_BRIMSTONE, CollectibleType.COLLECTIBLE_MONSTROS_LUNG, CollectibleType.COLLECTIBLE_CHOCOLATE_MILK }) do
+    while p:HasCollectible(c) do p:RemoveCollectible(c) end
+  end
+  p:AddCacheFlags(CacheFlag.CACHE_ALL)
+  p:EvaluateItems()
+  dir = nil
+end
+
+at(3, function()
+  for _, n in ipairs({ "Weapon.GetDirection", "Weapon.GetMaxCharge", "Weapon.GetMainEntity" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  local p = Isaac.GetPlayer(0)
+  local w = p:GetWeapon(1)
+  check("tears: GetMaxCharge is 0", w:GetMaxCharge() == 0, w:GetMaxCharge())
+  check("tears: GetMainEntity is nil", w:GetMainEntity() == nil)
+  local d = w:GetDirection()
+  check("tears idle: GetDirection is a Vector of zeros", d.X == 0 and d.Y == 0, tostring(d))
+  check("GetDirection on a non-Weapon errors", not pcall(w.GetDirection, {}))
+  check("GetMaxCharge on a non-Weapon errors", not pcall(w.GetMaxCharge, 5))
+  check("GetMainEntity on a non-Weapon errors", not pcall(w.GetMainEntity, nil))
+  local f = p:GetWeapon(2)
+  check("an empty weapon slot is nil", f == nil)
+end)
+
+-- Brimstone: max charge equals what the charge field climbs to; the laser is the main entity once fired
+at(10, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_BRIMSTONE, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() end)
+at(14, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("brimstone: weapon type 2", w:GetWeaponType() == 2, w:GetWeaponType())
+  check("brimstone: GetMaxCharge is 32", near(w:GetMaxCharge(), 32), w:GetMaxCharge())
+  check("brimstone idle: GetMainEntity is nil", w:GetMainEntity() == nil)
+  dir = ButtonAction.ACTION_SHOOTRIGHT
+end)
+at(20, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  local d = w:GetDirection()
+  check("brimstone firing right: GetDirection is (1, 0)", near(d.X, 1) and near(d.Y, 0), tostring(d))
+  check("brimstone charging: GetCharge is below the max", w:GetCharge() > 0 and w:GetCharge() <= w:GetMaxCharge(), w:GetCharge())
+end)
+at(70, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("brimstone: charge stops at GetMaxCharge", near(w:GetCharge(), w:GetMaxCharge()), w:GetCharge() .. " / " .. w:GetMaxCharge())
+  dir = ButtonAction.ACTION_SHOOTUP
+end)
+at(74, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  local d = w:GetDirection()
+  check("brimstone firing up: GetDirection is (0, -1)", near(d.X, 0) and near(d.Y, -1), tostring(d))
+  dir = nil
+end)
+for f = 75, 95 do
+  at(f, function()
+    local p = Isaac.GetPlayer(0)
+    local w = p:GetWeapon(1)
+    local e = w:GetMainEntity()
+    if e ~= nil and not steps.laser_seen then
+      steps.laser_seen = true
+      check("brimstone firing: GetMainEntity is the laser (type 7)", e.Type == 7 and e.SpawnerEntity ~= nil and GetPtrHash(e.SpawnerEntity) == GetPtrHash(p), "type " .. e.Type .. " variant " .. e.Variant)
+    end
+  end)
+end
+at(96, function() if not steps.laser_seen then check("brimstone firing: GetMainEntity is the laser (type 7)", false, "never non-nil in frames 75..95") end end)
+
+-- Monstro's Lung and Chocolate Milk: a charge weapon each, with a max charge
+at(100, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_MONSTROS_LUNG, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() end)
+at(104, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("lung: weapon type 7", w:GetWeaponType() == 7, w:GetWeaponType())
+  check("lung: GetMaxCharge is positive", w:GetMaxCharge() > 30 and w:GetMaxCharge() < 60, w:GetMaxCharge())
+end)
+at(110, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() dir = ButtonAction.ACTION_SHOOTLEFT end)
+at(118, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("chocolate milk: GetMaxCharge is positive", w:GetMaxCharge() > 0, w:GetMaxCharge())
+  local d = w:GetDirection()
+  check("chocolate milk firing left: GetDirection is (-1, 0)", near(d.X, -1) and near(d.Y, 0), tostring(d))
+  dir = nil
+end)
+at(125, function() reset(Isaac.GetPlayer(0)) end)
+
+-- Room placement: queries against the level the game made (Basement I, start room at grid index 84)
+at(130, function()
+  local level = Game():GetLevel()
+  for _, n in ipairs({ "Level.GetNeighboringRooms", "Level.CanPlaceRoom", "Level.CanPlaceRoomAtDoor", "Level.FindValidRoomPlacementLocations",
+      "RoomDescriptor.GetNeighboringRooms", "RoomDescriptor.GetValidNeighborPlacementLocations" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  local start = level:GetCurrentRoomDesc()
+  check("start room is at 84", start.GridIndex == 84, start.GridIndex)
+  local near = level:GetNeighboringRooms(84, 1)
+  local expect = { [0] = 83, [1] = 71, [2] = 85, [3] = 97 }
+  local ok, count = true, 0
+  for slot, d in pairs(near) do
+    count = count + 1
+    if expect[slot] == nil or d.GridIndex ~= expect[slot] and d.SafeGridIndex ~= expect[slot] then ok = false end
+    local direct = level:GetRoomByIdx(expect[slot] or -1, -1)
+    if not (direct and GetPtrHash(direct) == GetPtrHash(d)) then ok = false end
+  end
+  local want = 0
+  for slot, idx in pairs(expect) do local r = level:GetRoomByIdx(idx, -1) if r and r.Data then want = want + 1 end end
+  check("GetNeighboringRooms(84, 1) finds each room next to the start room, in the right slot", ok and count == want and count > 0, count .. " of " .. want)
+  local own = start:GetNeighboringRooms()
+  local same = true
+  for slot, d in pairs(near) do if not own[slot] or GetPtrHash(own[slot]) ~= GetPtrHash(d) then same = false end end
+  check("RoomDescriptor:GetNeighboringRooms equals Level:GetNeighboringRooms", same)
+  check("an occupied cell cannot take a room", level:CanPlaceRoom(1, -1, 84) == false)
+  check("shape 0 cannot be placed", level:CanPlaceRoom(0, -1, 5) == false)
+  check("a grid index past 168 cannot be placed", level:CanPlaceRoom(1, -1, 169) == false)
+  check("an invalid dimension errors", not pcall(level.CanPlaceRoom, level, 1, -1, 5, 7))
+  -- a cell with no rooms around it
+  local lonely
+  for i = 0, 168 do
+    local c, l = i % 13, i // 13
+    if c < 12 and l < 12 then
+      local free = true
+      for dc = -1, 2 do for dl = -1, 2 do
+        local cc, ll = c + dc, l + dl
+        if cc >= 0 and cc < 13 and ll >= 0 and ll < 13 then local r = level:GetRoomByIdx(ll * 13 + cc, -1) if r and r.Data then free = false end end
+      end end
+      if free then lonely = i break end
+    end
+  end
+  check("a free cell far from every room exists in this level", lonely ~= nil)
+  if lonely then
+    check("no neighbours: not placeable by default", level:CanPlaceRoom(1, -1, lonely) == false)
+    check("no neighbours: placeable with allowNoNeighbors", level:CanPlaceRoom(1, -1, lonely, -1, true, false, true) == true)
+    check("a 2x2 with no neighbours and allowNoNeighbors fits when there is room", level:CanPlaceRoom(8, -1, lonely, -1, true, false, true) == true)
+  end
+  local rc = Isaac.GetItemConfig and RoomConfigHolder and RoomConfigHolder.GetRoomByStageTypeAndVariant and RoomConfigHolder.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0)
+  if rc then
+    check("RoomConfigRoom form: the shape and door mask come from the config", level:CanPlaceRoom(rc, 84) == false and level:CanPlaceRoom(rc, lonely or 0, -1, true, false, true) == (lonely ~= nil))
+  end
+  -- every location FindValidRoomPlacementLocations lists passes CanPlaceRoom, is empty and touches a room; they come sorted
+  for _, shape in ipairs({ 1, 4, 6, 8 }) do
+    local list = level:FindValidRoomPlacementLocations(shape, -1)
+    local good, sorted_ = true, true
+    for i, idx in ipairs(list) do
+      if not level:CanPlaceRoom(shape, -1, idx) then good = false end
+      if i > 1 and list[i - 1] >= idx then sorted_ = false end
+    end
+    -- (a freshly generated level may have none: its free cells next to a door are mostly boxed in by other rooms)
+    check("FindValidRoomPlacementLocations(shape " .. shape .. "): " .. #list .. " location(s), all pass CanPlaceRoom, sorted", good and sorted_)
+  end
+  -- a 1x1 location list is the cells next to a room where a door can lead: compare with CanPlaceRoomAtDoor
+  local list = level:FindValidRoomPlacementLocations(1, -1)
+  local set = {}
+  for _, i in ipairs(list) do set[i] = true end
+  local via_door, seen = {}, {}
+  for i = 0, 168 do
+    local r = level:GetRoomByIdx(i, -1)
+    if r and r.Data and not seen[GetPtrHash(r)] then
+      seen[GetPtrHash(r)] = true
+      for _, c in ipairs(r:GetValidNeighborPlacementLocations(1, -1)) do via_door[c] = true end
+    end
+  end
+  local equal = true
+  for i in pairs(set) do if not via_door[i] then equal = false end end
+  for i in pairs(via_door) do if not set[i] then equal = false end end
+  check("Level list equals the union of the rooms' GetValidNeighborPlacementLocations", equal)
+end)
+-- the game's own red room placement as an oracle: for every door of every 1x1 room whose neighbouring cell is
+-- empty, CanPlaceRoom(1x1 at that cell) must say what Level:MakeRedRoomDoor does (it places a red room there or not).
+-- Run on several floors (each floor is a new level; the placement changes the level, so the answer is asked first).
+local function oracle(tag)
+  local level = Game():GetLevel()
+  local rooms, seen = {}, {}
+  for i = 0, 168 do
+    local r = level:GetRoomByIdx(i, -1)
+    if r and r.Data and not seen[GetPtrHash(r)] then seen[GetPtrHash(r)] = true rooms[#rooms + 1] = r end
+  end
+  local step = { [0] = -1, [1] = -13, [2] = 1, [3] = 13 }
+  local agree, differ, tried, yes = 0, {}, 0, 0
+  for _, r in ipairs(rooms) do
+    if r.Data.Shape == 1 then
+      local idx = r.GridIndex
+      for slot = 0, 3 do
+        local cell = idx + step[slot]
+        local col_ok = not ((slot == 0 and idx % 13 == 0) or (slot == 2 and idx % 13 == 12))
+        local e = level:GetRoomByIdx(cell, -1)
+        if col_ok and cell >= 0 and cell <= 168 and (r.Data.Doors & (1 << slot)) ~= 0 and not (e and e.Data) then
+          tried = tried + 1
+          local mine = level:CanPlaceRoom(1, -1, cell, -1, true, true)
+          local at_door = level:CanPlaceRoomAtDoor(1, -1, r, slot, true, true)
+          if at_door ~= mine then differ[#differ + 1] = string.format("CanPlaceRoomAtDoor room %d slot %d: %s but CanPlaceRoom %s", idx, slot, tostring(at_door), tostring(mine)) end
+          local theirs = level:MakeRedRoomDoor(idx, slot) and true or false
+          if mine == theirs then agree = agree + 1 if theirs then yes = yes + 1 end
+          else differ[#differ + 1] = string.format("room %d type %d slot %d cell %d: mine %s game %s", idx, r.Data.Type, slot, cell, tostring(mine), tostring(theirs)) end
+        end
+      end
+    end
+  end
+  check(tag .. ": CanPlaceRoom agrees with the game's red room placement on " .. tried .. " door(s) (" .. yes .. " placed)", #differ == 0 and tried > 0,
+    #differ .. " differ " .. table.concat(differ, "; "):sub(1, 400))
+  -- a second look at the shapes, now that the level is bigger
+  for _, shape in ipairs({ 1, 4, 6, 8 }) do
+    local list = level:FindValidRoomPlacementLocations(shape, -1)
+    local good = true
+    for _, idx in ipairs(list) do if not level:CanPlaceRoom(shape, -1, idx) then good = false end end
+    check(tag .. ": FindValidRoomPlacementLocations(shape " .. shape .. ") " .. #list .. " location(s), all pass CanPlaceRoom", good)
+  end
+end
+at(135, function() oracle("Basement I") end)
+local floors = { "2", "4", "6", "8" }
+for i, f in ipairs(floors) do
+  local base = 140 + (i - 1) * 60
+  at(base, function() Isaac.ExecuteCommand("stage " .. f) end)
+  at(base + 40, function() oracle("stage " .. f .. " (level " .. Game():GetLevel():GetStage() .. ")") end)
+end
+at(140 + #floors * 60, function() B.log("lab_batch3_test: DONE") end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local f = steps[frame]
+  if f then f() end
+end)
diff --git a/scripts/recomp/rgon/lab_bossintro_test.lua b/scripts/recomp/rgon/lab_bossintro_test.lua
