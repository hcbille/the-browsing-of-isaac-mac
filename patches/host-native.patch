@@ -164,8 +164,41 @@ static inline int isaac_is_guest_va(uint32_t va) {
 /* Identity addressing makes these casts, not conversions. They exist so that
  * intent is greppable and so a future non-identity mode has one place to change. */
 
+#if !defined(__EMSCRIPTEN__)
+/* Mac Build: native stand-ins for the two Emscripten helpers the Host uses
+ * outside its ISAAC_WEB paths (a millisecond clock and the core count). */
+#include <time.h>
+#include <unistd.h>
+static inline double emscripten_get_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
+}
+static inline int emscripten_num_logical_cores(void) {
+    long n = sysconf(_SC_NPROCESSORS_ONLN);
+    return n > 0 ? (int)n : 1;
+}
+#endif
+
+#if defined(ISAAC_NATIVE) && ISAAC_NATIVE
+/* Mac Build (docs/adr/0001): the Guest's 4 GiB live in one reservation at
+ * recomp_mem_base, so a Guest address is an offset into it. A Host pointer
+ * handed to the Guest must point inside that reservation; anything else is a
+ * Host allocation that leaked across, and truncating it would be silent
+ * corruption, so it stops the process instead. NULL stays 0. */
+extern uint8_t *recomp_mem_base;
+__attribute__((noreturn)) void isaac_native_bad_va(const void *p);
+static inline void *isaac_g(uint32_t va) { return recomp_mem_base + va; }
+static inline uint32_t isaac_va(const void *p) {
+    if (!p) return 0;
+    uintptr_t d = (uintptr_t)p - (uintptr_t)recomp_mem_base;
+    if (d >> 32) isaac_native_bad_va(p);
+    return (uint32_t)d;
+}
+#else
 static inline void *isaac_g(uint32_t va) { return (void *)(uintptr_t)va; }
 static inline uint32_t isaac_va(const void *p) { return (uint32_t)(uintptr_t)p; }
+#endif
 
 static inline uint32_t isaac_r32(uint32_t va) { return *(const uint32_t *)isaac_g(va); }
 static inline void isaac_w32(uint32_t va, uint32_t v) { *(uint32_t *)isaac_g(va) = v; }
