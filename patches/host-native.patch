+-- 6. EntityKnife:GetHitboxParentKnife: a bone club swing (the Forgotten) with shooting faked through MC_INPUT_ACTION
+step(function()
+  clear_all() clear_things()
+  local p = pl()
+  p:ChangePlayerType(16)
+  p.Position = pos(5, 4)
+  base.shoot = true
+  say("player type now " .. tostring(p:GetPlayerType()))
+  wait("a bone club hitbox", 200, function()
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      if e.Type == 8 then
+        local k = e:ToKnife()
+        local par = k and k:GetHitboxParentKnife()
+        if par then base.knife_hit, base.knife_parent = k, par return true end
+      end
+    end
+    return false
+  end)
+end)
+step(function()
+  base.shoot = false
+  local k, par = base.knife_hit, base.knife_parent
+  check(k ~= nil, "a knife with a hitbox parent showed up")
+  if k then
+    say(string.format("hitbox knife subtype %d, parent knife subtype %d", k.SubType, par and par.SubType or -1))
+    check(par ~= nil and par.Type == 8 and par.Index ~= k.Index, "its parent is another EntityKnife")
+    check(par:GetHitboxParentKnife() == nil, "the weapon knife itself has no hitbox parent")
+  end
+end)
+mod:AddCallback(M.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if not base.shoot or not ent or ent.Type ~= 1 or action ~= ButtonAction.ACTION_SHOOTRIGHT then return end
+  if hook == InputHook.IS_ACTION_PRESSED then return true end
+  if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+end)
+
+local frame, i = 0, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "a few frames" and wait_what ~= "render frames" then check(false, "timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    if i == #steps + 1 then B.log(string.format("lab_cb_c: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
