+-- lab_liftgap.lua (development only; LAB=lab_liftgap.lua): the Remembrance familiar (3.905.50) of Epiphany's Bethany used to stop
+-- the game on "indirect call to 0x0060d0e0 ... not lifted" (a getter packed right after another function, no int3 between).
+-- Spawns the familiar in the first room, plays 600 frames and prints "lab_liftgap: PASS/FAIL" and DONE. The check that matters is
+-- the absence of a [isaac][TRAP] line in the log; the lab only proves the game reached the end.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab liftgap", 1)
+local function say(s) B.log("lab_liftgap: " .. s) end
+local started, frame, spawned, finished = false, 0, nil, false
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if not started or finished then return end
+  frame = frame + 1
+  if frame == 30 then
+    local p = Isaac.GetPlayer(0)
+    spawned = Isaac.Spawn(EntityType.ENTITY_FAMILIAR, 905, 50, p.Position + Vector(40, 0), Vector(0, 0), p)
+    say("spawned familiar 3.905.50: " .. tostring(spawned ~= nil))
+  end
+  if frame == 630 then
+    finished = true
+    say((spawned ~= nil and "PASS" or "FAIL") .. " reached frame " .. frame)
+    say("DONE")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_locate.lua b/scripts/recomp/rgon/lab_locate.lua
