+-- lab_cb_h.lua (development only; ISAAC_RGON_LAB=lab_cb_h.lua, worker cb-h)
+-- MC_POST_START_GREED_WAVE (1489) in a Greed Mode run: the game's own wave start, not a direct call.
+-- Prints "lab_cb_h: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-h", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_h: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_h: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local game = Game()
+local hits = {}
+check(M.MC_POST_START_GREED_WAVE == 1489, "MC_POST_START_GREED_WAVE has the number 1489")
+mod:AddCallback(M.MC_POST_START_GREED_WAVE, function(_, ...)
+  local lvl = game:GetLevel()
+  hits[#hits + 1] = { n = select("#", ...), wave = game:GetLevel().GreedModeWave, frame = Isaac.GetFrameCount(), room = game:GetRoom():GetType(),
+    enemies = game:GetRoom():GetAliveEnemiesCount() }
+  say(string.format("1489 #%d args %d wave %s room type %s alive %s", #hits, select("#", ...), tostring(hits[#hits].wave), tostring(hits[#hits].room), tostring(hits[#hits].enemies)))
+end)
+
+local steps = {}
+local frame, i = 0, 0
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond) waiting, wait_left, wait_what, wait_cond = true, frames, what, cond end
+local DIFF = 0x25f40
+
+step(function()
+  local ga = B.ptr(game)
+  say(string.format("Difficulty %s IsGreedMode %s, word at game+0x%x = %s", tostring(game.Difficulty), tostring(game:IsGreedMode()), DIFF, tostring(B.r32(ga + DIFF))))
+  check(B.r32(ga + DIFF) == game.Difficulty, "the difficulty word is at game+0x25f40 (read back equals Game.Difficulty)")
+  check(not game:IsGreedMode(), "the lab starts in a normal run")
+  -- Manager::StartNewGame (0x00958aa0, ret 0x68) stores its difficulty at Manager+0x4b198 and the Manager's update hands it to the
+  -- game's start (0x00959a4a). The console's "restart" (0x00958cb0) leaves that word alone, so setting it before "restart" starts Greed Mode.
+  local mgr = B.r32(0x00c7169c)
+  say(string.format("Manager %x, difficulty word %s", mgr, tostring(B.r32(mgr + 0x4b198))))
+  B.w32(mgr + 0x4b198, 2)
+  Isaac.ExecuteCommand("restart")
+  wait("restart", 90, function() return false end)
+end)
+step(function()
+  say(string.format("after restart: Difficulty %s IsGreedMode %s wave %s hits %d", tostring(game.Difficulty), tostring(game:IsGreedMode()), tostring(game:GetLevel().GreedModeWave), #hits))
+  local p = Isaac.GetPlayer(0)
+  say(string.format("player at %.0f,%.0f room type %s", p.Position.X, p.Position.Y, tostring(game:GetRoom():GetType())))
+  Isaac.ExecuteCommand("debug 3")
+  local room = game:GetRoom()
+  local ra = B.ptr(room)
+  say(string.format("room +0x723c %s, GreedModeWave %s, game state word %s", tostring(B.r32(ra + 0x723c)), tostring(game:GetLevel().GreedModeWave), tostring(B.r32(B.ptr(game)))))
+  -- the Greed start room holds one pressure plate (grid type 20, variant 2 at index 112): stand on it
+  local plate
+  for gi = 0, room:GetGridSize() - 1 do
+    local ge = room:GetGridEntity(gi)
+    if ge and ge:GetType() == GridEntityType.GRID_PRESSURE_PLATE then plate = ge say(string.format("plate at grid %d variant %s state %s", gi, tostring(ge:GetVariant()), tostring(ge.State))) end
+  end
+  check(plate ~= nil, "the Greed start room has a pressure plate")
+  if plate then p.Position = plate.Position end
+  wait("greed wave", 900, function() return #hits > 0 end)
+end)
+step(function()
+  say("hits " .. #hits .. " wave " .. tostring(game:GetLevel().GreedModeWave))
+  check(game:IsGreedMode(), "the run is a Greed Mode run")
+  check(#hits >= 1, "MC_POST_START_GREED_WAVE fired from the game's own wave start: " .. #hits)
+  check(#hits >= 1 and hits[1].n == 0 and hits[1].room ~= nil, "it has no arguments")
+  check(#hits >= 1 and (hits[1].wave or 0) >= 1, "the level's wave counter is at least 1 when it runs: " .. tostring(hits[1] and hits[1].wave))
+  check(#hits >= 1 and (hits[1].enemies or 0) > 0, "the wave's enemies are in the room when it runs: " .. tostring(hits[1] and hits[1].enemies))
+  for _, e in ipairs(Isaac.GetRoomEntities()) do if e:IsActiveEnemy(false) then e:Kill() end end
+  wait("second greed wave", 900, function() return #hits > 1 end)
+end)
+step(function()
+  check(#hits >= 2 and hits[2].wave == hits[1].wave + 1, "clearing the wave starts the next one through the game's own countdown: waves " .. tostring(hits[1] and hits[1].wave) .. " then " .. tostring(hits[2] and hits[2].wave))
+end)
+
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "restart" then check(false, "timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    if i == #steps + 1 then B.log(string.format("lab_cb_h: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
diff --git a/scripts/recomp/rgon/lab_census.lua b/scripts/recomp/rgon/lab_census.lua
new file mode 100644
index 0000000..a76e2e5
--- /dev/null
+++ b/scripts/recomp/rgon/lab_census.lua
@@ -0,0 +1,118 @@
+-- lab_census.lua (development only; ISAAC_RGON_LAB=lab_census.lua)
+-- What the running Layer can reach, name by name: one log line "lab_census: E <Class>.<name>" for every
+-- function and property found on a class or namespace table, plus the same "lab_names: I/C" lines
+-- lab_names.lua writes (so one run feeds scripts/mac/rgon_census.py). "E" is "exists": a name can exist
+-- and still not be in REPENTOGON.Implemented (a stand-in that holds the call and does nothing, or a
+-- name the game had before REPENTOGON). The census script tells them apart.
+local T = ...
+local B = T.B
+local R = T.R or REPENTOGON
+local type, pairs, rawget, getmetatable, tostring, pcall = type, pairs, rawget, getmetatable, tostring, pcall
+
+-- the same dump lab_names.lua makes
+do
+  local names, ids = {}, {}
+  for k in pairs(R.Implemented) do
+    if type(k) == "number" then ids[#ids + 1] = k else names[#names + 1] = tostring(k) end
+  end
+  table.sort(names)
+  table.sort(ids)
+  for _, n in ipairs(names) do B.log("lab_names: I " .. n) end
+  for _, id in ipairs(ids) do B.log("lab_names: C " .. id) end
+  B.log("lab_names: END " .. #names .. " names, " .. #ids .. " callbacks")
+end
+
+local seen, count = {}, 0
+local function emit(cls, name)
+  if type(name) ~= "string" or name:sub(1, 2) == "__" then return end
+  local key = cls .. "." .. name
+  if seen[key] then return end
+  seen[key] = true
+  count = count + 1
+  B.log("lab_census: E " .. key)
+end
+local function keys_of(t, cls)
+  if type(t) ~= "table" then return end
+  local ok = pcall(function() for k in pairs(t) do emit(cls, k) end end)
+  return ok
+end
+local function from_class_table(c, cls)
+  if type(c) ~= "table" then return end
+  keys_of(c, cls)
+  keys_of(rawget(c, "__propget"), cls)
+  keys_of(rawget(c, "__propset"), cls)
+end
+
+local skip = { _G = true, _VERSION = true, package = true, string = true, table = true, math = true, io = true, os = true, debug = true, coroutine = true, utf8 = true, jit = true }
+local classes = 0
+for cls, v in pairs(_G) do
+  if type(cls) == "string" and not skip[cls] and type(v) == "table" then
+    classes = classes + 1
+    keys_of(v, cls)
+    local mt = getmetatable(v)
+    if type(mt) == "table" and type(rawget(mt, "__call")) == "function" then emit(cls, cls) end   -- a constructor: Class.Class
+    if type(mt) == "table" then
+      from_class_table(rawget(mt, "__class"), cls)
+      from_class_table(rawget(mt, "__const"), cls)
+      keys_of(rawget(mt, "__propget"), cls)
+    end
+  end
+end
+
+-- a class the game gives no static table is reached through an object of it
+local samples = {
+  Game = function() return Game() end, Level = function() return Game():GetLevel() end,
+  Room = function() return Game():GetRoom() end, ItemPool = function() return Game():GetItemPool() end,
+  ItemConfig = function() return Isaac.GetItemConfig() end, SFXManager = function() return SFXManager() end,
+  MusicManager = function() return MusicManager() end, RNG = function() return RNG() end,
+  Sprite = function() return Sprite() end, Vector = function() return Vector(0, 0) end,
+  Color = function() return Color(1, 1, 1, 1, 0, 0, 0) end, Seeds = function() return Game():GetSeeds() end,
+  HUD = function() return Game():GetHUD() end, PlayerHUD = function() return Game():GetHUD():GetPlayerHUD(0) end,
+  EntityPlayer = function() return Isaac.GetPlayer(0) end, Camera = function() return Game():GetRoom():GetCamera() end,
+  Options = function() return Options end, ItemConfigItem = function() return Isaac.GetItemConfig():GetCollectible(1) end,
+  ItemConfig_Item = function() return Isaac.GetItemConfig():GetCollectible(1) end,
+  ItemConfig_Card = function() return Isaac.GetItemConfig():GetCard(1) end,
+  CostumeSpriteDesc = function() return Isaac.GetPlayer(0):GetCostumeSpriteDescs()[1] end,
+  ItemConfig_PillEffect = function() return Isaac.GetItemConfig():GetPillEffect(1) end,
+  EntityDesc = function() return Game():GetRoom():GetRoomConfigRoom() end,
+  RoomDescriptor = function() return Game():GetLevel():GetCurrentRoomDesc() end,
+  RoomConfigRoom = function() return Game():GetLevel():GetCurrentRoomDesc().Data end,
+}
+-- objects of the Layer's own stand-in classes (not global tables: only a constructor or a factory makes them)
+local made = {
+  Beam = function() return Beam(Sprite(), 0, false, false) end,
+  Point = function() return Point(Vector(0, 0), 0) end,
+  Font = function() return Font() end,
+  LayerState = function() local s = Sprite() s:Load("gfx/001.000_player.anm2", true) return s:GetLayer(0) end,
+  Image = function() return Renderer.CreateImage(1, 1, "census") end,
+  Shader = function() return Renderer.LoadShader("census") end,
+}
+for cls, make in pairs(made) do samples[cls] = make end
+for cls, make in pairs(samples) do
+  local ok, o = pcall(make)
+  if ok and o ~= nil then
+    local mt = type(o) == "table" and getmetatable(o) or nil
+    if type(o) ~= "table" then
+      local ok2, m2 = pcall(getmetatable, o)
+      mt = ok2 and m2 or nil
+    end
+    if type(mt) == "table" then
+      from_class_table(rawget(mt, "__class") or mt, cls)
+      from_class_table(rawget(mt, "__const"), cls)
+      -- a Layer class (LayerState) keeps its methods in the __index table of its metatable
+      if type(rawget(mt, "__index")) == "table" then keys_of(rawget(mt, "__index"), cls) end
+    end
+  end
+end
+-- Font's legacy functions are defined in the game's main.lua behind a function __index: probe the documented names
+do
+  local ok, f = pcall(Font)
+  if ok and f ~= nil then
+    for _, n in ipairs({ "DrawString", "DrawStringScaled", "DrawStringUTF8", "DrawStringScaledUTF8", "GetStringWidth", "GetStringWidthUTF8" }) do
+      local ok2, v = pcall(function() return f[n] end)
+      if ok2 and type(v) == "function" then emit("Font", n) end
+    end
+  end
+end
+
+B.log("lab_census: END " .. count .. " names on " .. classes .. " global tables")
