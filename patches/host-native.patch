+-- lab_pickup_more.lua (development only; LAB=lab_pickup_more.lua, chunk 4): every name of api_pickup_more.lua is called
+-- once in the start room and read back. Lines: "lab_pickup_more: PASS|FAIL <name> <detail>", and a last "DONE pass=N fail=M".
+local T = ...
+local B = T.B
+local r32, ri32, rf32, call = B.r32, B.ri32, B.rf32, B.call
+local mod = RegisterMod("rgon lab pickup more", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_pickup_more: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function note(s) B.log("lab_pickup_more: note " .. s) end
+local started, frame = false, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+
+local function spawn(variant, sub, dx)
+  local pos = Game():GetRoom():GetCenterPos() + Vector(dx or 0, 0)
+  return Isaac.Spawn(5, variant, sub, pos, Vector(0, 0), nil):ToPickup()
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, "error: " .. tostring(err)) end
+end
+
+local function run()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs({ "EntityPickup.AddCollectibleCycle", "EntityPickup.RemoveCollectibleCycle", "EntityPickup.GetLootList",
+    "EntityPickup.GetPickupGhost", "EntityPickup.GetPriceSprite", "EntityPickup.GetRandomPickupVelocity", "EntityPickup.HasFlipData",
+    "EntityPickup.MakeShopItem", "EntityPickup.SetDropDelay", "EntityPickup.SetNewOptionsPickupIndex", "EntityPickup.SetVarData",
+    "EntityPickup.SetupCollectibleGraphics", "EntityPickup.TriggerTheresOptionsPickup", "EntityPickup.TryInitOptionCycle",
