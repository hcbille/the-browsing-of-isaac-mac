+-- 3. grid collisions: a rock at (10, 4); things come at it from the right (the player sits at (5, 3), out of the way)
+local ROCK_C, ROCK_R = 10, 4
+local function setup_rock()
+  local g = grid(ROCK_C, ROCK_R)
+  if g and g:GetType() == GT.GRID_ROCK and g.State == 1 then return end
+  if g then room():RemoveGridEntity(idx(ROCK_C, ROCK_R), 0, false) end
+  local ok = Isaac.GridSpawn(GT.GRID_ROCK, 0, pos(ROCK_C, ROCK_R), true)
+  local n = grid(ROCK_C, ROCK_R)
+  say("setup_rock: spawn " .. tostring(ok) .. " grid now " .. tostring(n and n:GetType()) .. " state " .. tostring(n and n.State))
+end
+local function clear_things()
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e.Type ~= 1 and e.Type ~= 1000 then e:Remove() end
+  end
+end
+local function rock_x() return pos(ROCK_C, ROCK_R).X end
+-- name -> function(spawn position) making the thing and returning it
+local MAKERS = {
+  { "PICKUP", function(p) return Isaac.Spawn(5, 20, 1, p, Vector(-9, 0), nil) end, 5 },
+  { "TEAR", function(p) local e = Isaac.Spawn(2, 0, 0, p, Vector(-9, 0), pl()) e:ToTear().Height = -23 e:ToTear().FallingSpeed = 0 e:ToTear().FallingAcceleration = -0.05 return e end, 2 },
+  { "BOMB", function(p) return Isaac.Spawn(4, 0, 0, p, Vector(-9, 0), pl()) end, 4 },
+  { "PROJECTILE", function(p) local e = Isaac.Spawn(9, 0, 0, p, Vector(-9, 0), nil) e:ToProjectile().Height = -23 e:ToProjectile().FallingSpeed = 0 e:ToProjectile().FallingAccel = -0.05 return e end, 9 },
+  { "NPC", function(p) base.pushe = true return Isaac.Spawn(10, 0, 0, p, Vector(-6, 0), nil) end, 10 },
+  { "PLAYER", function(p) local pp = pl() pp.Position = p pp.Velocity = Vector(-9, 0) base.push = true return pp end, 1 },
+}
+local function push()
+  if base.push then pl().Velocity = Vector(-9, 0) end
+  if base.pushe and base.ent and base.ent:Exists() then base.ent.Velocity = Vector(-8, 0) end
+end
+local cur
+local function try(maker)
+  clear_all() clear_things() setup_rock()
+  cur = maker
+  base.ent = maker[2](Vector(rock_x() + 52, pos(ROCK_C, ROCK_R).Y))
+  base.ent:GetData().cbc = true
+  wait("collision " .. maker[1], 110, function() push() return count("MC_PRE_" .. maker[1] .. "_GRID_COLLISION") > 0 end)
+end
+local function verify(maker)
+  local name = maker[1]
+  local a, b = last("MC_PRE_" .. name .. "_GRID_COLLISION"), last("MC_" .. name .. "_GRID_COLLISION")
+  check(a and a.n == 3, "MC_PRE_" .. name .. "_GRID_COLLISION (entity, gridIndex, gridEntity): " .. tostring(a and a.text) .. " x" .. count("MC_PRE_" .. name .. "_GRID_COLLISION"))
+  check(a and a[2] == idx(ROCK_C, ROCK_R) and a[3] and a[3]:GetType() == GT.GRID_ROCK, "the grid index is the rock's (" .. idx(ROCK_C, ROCK_R) .. ")")
+  check(a and a[1] and a[1].Type == maker[3], "the entity is of type " .. maker[3])
+  check(b and b.n == 3, "MC_" .. name .. "_GRID_COLLISION fired too: " .. tostring(b and b.text))
+  -- an answer of true: no collision, the thing goes through
+  clear_all() clear_things() setup_rock()
+  beh["MC_PRE_" .. name .. "_GRID_COLLISION"] = function() return true end
+  reset("MC_" .. name .. "_GRID_COLLISION")
+  base.ent = maker[2](Vector(rock_x() + 52, pos(ROCK_C, ROCK_R).Y))
+  base.ent:GetData().cbc = true
+  base.ref = base.ent
+  wait("pass through " .. name, 110, function() push() return not base.ent:Exists() or base.ent.Position.X < rock_x() - 10 end)
+end
+local function verify2(maker)
+  local name = maker[1]
+  local e = base.ent
+  local through = (not e:Exists()) and "gone" or (e.Position.X < rock_x() - 10 and "passed" or "blocked")
+  say(name .. " with answer true: " .. through .. (e:Exists() and string.format(" x=%.0f rock x=%.0f", e.Position.X, rock_x()) or ""))
+  check(through ~= "blocked", name .. " ignores the rock when MC_PRE_" .. name .. "_GRID_COLLISION answers true (" .. through .. ")")
+  check(count("MC_" .. name .. "_GRID_COLLISION") == 0, "and the post callback stays quiet: " .. count("MC_" .. name .. "_GRID_COLLISION"))
+  beh["MC_PRE_" .. name .. "_GRID_COLLISION"] = nil
+  base.push = false
+  base.pushe = false
+end
+for _, mk in ipairs(MAKERS) do
+  step(function() try(mk) end)
+  step(function() verify(mk) end)
+  step(function() verify2(mk) end)
+end
