+-- The suplex accessors. Their places in this build's player are not measurable (api_batch_two.lua's header: the
+-- fields REPENTOGON names hold a -100000 sentinel and floats here), so they are the layer's own, per player:
+--   :GetSuplexState and :SetSuplex{State,AimCountdown,LandPosition,TargetPosition} -- kept; the game's own
+--      Suplex! does not read them (accepted, not supported). The stat modifiers, GetMarkedTarget and the
+--      costume visibility checks are the game's own fields and functions now (api_batch_two.lua).
+do
+  local M = ModCallbacks
+  local P = "EntityPlayer"
+  local suplex = {}
+  local function sp(p) local h = GetPtrHash(p) local s = suplex[h] if not s then s = { state = 0, aim = 0 } suplex[h] = s end return s end
+  T.method(P, "GetSuplexState", function(self) return sp(self).state end)
+  T.method(P, "SetSuplexState", function(self, v) sp(self).state = v T.unsupported("EntityPlayer:SetSuplexState", "kept; the game's own Suplex! does not read it") end)
+  T.method(P, "SetSuplexAimCountdown", function(self, v) sp(self).aim = v end)
+  T.method(P, "SetSuplexLandPosition", function(self, v) sp(self).land = v end)
+  T.method(P, "SetSuplexTargetPosition", function(self, v) sp(self).target = v end)
+  for _, n in ipairs({ "GetSuplexState", "SetSuplexState", "SetSuplexAimCountdown", "SetSuplexLandPosition", "SetSuplexTargetPosition" }) do R.Implemented[P .. "." .. n] = nil end
+end
+
+-- Isaac.GetString(category, key): the game's string table (resources/stringtable.sta: a category holds keys,
+-- a key one <string> per language in the file's language order). English is always answered (the game's
+-- language option is not read); a key it has none of answers "StringTable::InvalidKey", as REPENTOGON's does.
+do
+  local text
+  local cats = {}
+  local function unesc(s)
+    return (s:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&apos;", "'"):gsub("&amp;", "&"))
+  end
+  T.static(Isaac, "Isaac", "GetString", function(category, key)
+    if type(category) ~= "string" then error("bad argument #1 to 'GetString' (string expected, got " .. type(category) .. ")", 2) end
+    if type(key) ~= "string" then error("bad argument #2 to 'GetString' (string expected, got " .. type(key) .. ")", 2) end
+    if text == nil then text = T.read_file and T.read_file("resources/stringtable.sta") or false end
+    if not text then return "StringTable::InvalidKey" end
+    local c = cats[category]
+    if c == nil then
+      local a, e = text:find('<category name="' .. category .. '">', 1, true)
+      if a then
+        local z = text:find("</category>", e, true)
+        c = { e, z or #text }
+      else
+        c = false
+      end
+      cats[category] = c
+    end
+    if not c then return "StringTable::InvalidKey" end
+    local a, e = text:find('<key name="' .. key .. '">', c[1], true)
+    if not a or a > c[2] then return "StringTable::InvalidKey" end
+    local s = text:match("<string>(.-)</string>", e)
+    if not s then return "StringTable::InvalidKey" end
+    return unesc(s)
+  end)
+end
