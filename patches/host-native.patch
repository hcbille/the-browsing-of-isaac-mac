+-- Console.RegisterMacro(name, commands): REPENTOGON's console lists it for `macro <name>`.
+-- Kept; the game's console here has no `macro` to run it.
+do
+  local C = rawget(_G, "Console")
+  if type(C) == "table" and rawget(C, "RegisterMacro") == nil then
+    local macros = {}
+    function C.RegisterMacro(name, commands)
+      if type(name) ~= "string" then error("bad argument #1 to 'RegisterMacro' (string expected, got " .. type(name) .. ")", 2) end
+      if type(commands) ~= "table" then error("bad argument #2 to 'RegisterMacro' (table expected, got " .. type(commands) .. ")", 2) end
+      macros[name] = commands
+      T.unsupported("Console.RegisterMacro", "the macro is kept; the console cannot run it")
+    end
+  end
+end
