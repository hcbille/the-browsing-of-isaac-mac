+-- lab_b2probe2.lua (development only; ISAAC_RGON_LAB=lab_b2probe2.lua, census batch 2): second round of
+-- lab_b2probe.lua, one scenario at a time with its own diff (see that file's header).
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32, r8 = B.r32, B.ri32, B.rf32, B.w32, B.r8
+local mod = RegisterMod("rgon lab b2probe2", 1)
+local LO, HI = 0x1300, 0x2c00
+local function say(s) B.log("lab_b2probe2: " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local SKIP = {}
+local function diff(name, a, before)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not SKIP[o] then
+      n = n + 1
+      if n <= 40 then say(string.format("%s +%04x %08x -> %08x (%d -> %d, f %g -> %g)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now, B.i2f(before[o]), B.i2f(now))) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local frame, held = 0, {}
+local S
+local C = CollectibleType
+local function item(name)
+  local v = C[name]
+  if not v then say("no CollectibleType." .. name) return -1 end
+  return v
+end
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local function words(a, from, to)
+  local t = {}
+  for o = from, to - 4, 4 do t[#t + 1] = string.format("%08x", r32(a + o)) end
+  return table.concat(t, " ")
+end
+local knife
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if frame == 5 then
+    for _, pat in ipairs({ "SUPLEX", "SUMPTORIUM", "IMMACULATE", "CAMBION", "RED_STEW", "PONY", "KEEPER", "PLAN_C", "DEAD_EYE", "MARKED", "POOP", "URN", "MAGGY", "LILITH", "BLADDER", "URETHRA" }) do
+      local t = {}
+      for k, v in pairs(C) do if k:find(pat) then t[#t + 1] = k .. "=" .. v end end
+      say("items matching " .. pat .. ": " .. table.concat(t, " "))
+    end
+    say("weapon slots 0x13d4..0x13f4: " .. words(a, 0x13d4, 0x13f4))
+    say(string.format("weapon 1 direction words +20..+2c: %g %g (shooting right will set later), HeadFrameDelay %d", rf32(r32(a + 0x13e0) + 0x20), rf32(r32(a + 0x13e0) + 0x24), p.HeadFrameDelay))
+    -- head direction: set the direction and the lock by hand, see what the game does with it
+    S = snap(a)
+  elseif frame == 8 then
+    say(string.format("head direction now %d; words 0x1320..0x1340: %s; +1628 %d", p:GetHeadDirection(), words(a, 0x1320, 0x1340), ri32(a + 0x1628)))
+    w32(a + 0x1628, 1) w32(a + 0x1338, 40)
+  elseif frame == 12 then
+    say(string.format("head direction after the write %d (1 = left); 0x1338 %d; words 0x1320..0x1340: %s", p:GetHeadDirection(), ri32(a + 0x1338), words(a, 0x1320, 0x1340)))
+    S = snap(a)
+  elseif frame == 20 then
+    -- a bomb through the input hook
+    held[ButtonAction.ACTION_BOMB] = true
+    S = snap(a)
+  elseif frame == 22 then
+    held[ButtonAction.ACTION_BOMB] = nil
+    diff("bomb placed", a, S)
+    S = snap(a)
+  elseif frame == 30 then
+    p:AddCollectible(item("COLLECTIBLE_IMMACULATE_CONCEPTION"), 0, false)
+    p:AddSoulHearts(-6) p:AddSoulHearts(4)
+    S = snap(a)
+    for i = 1, 3 do Isaac.Spawn(5, 10, 3, p.Position, Vector(0, 0), nil) end
+  elseif frame == 50 then
+    diff("soul hearts picked up with Immaculate Conception", a, S)
+    S = snap(a)
+  elseif frame == 55 then
+    p:AddCollectible(item("COLLECTIBLE_SUMPTORIUM"), 0, false)
+    S = snap(a)
+  elseif frame == 60 then
+    p:TakeDamage(1, 0, EntityRef(nil), 0)
+    SKIP = {}
+    S = S
+  elseif frame == 90 then
+    diff("Sumptorium + damage taken", a, S)
+    S = snap(a)
+  elseif frame == 95 then
+    p:AddCollectible(item("COLLECTIBLE_RED_STEW"), 0, false)
+    p:SetActiveCharge(12, 0)
+    S = snap(a)
+    p:UseActiveItem(item("COLLECTIBLE_RED_STEW"), UseFlag.USE_NOANIM, 0)
+  elseif frame == 110 then
+    diff("Red Stew used", a, S)
+    S = snap(a)
+  elseif frame == 115 then
+    p:AddCollectible(item("COLLECTIBLE_KEEPERS_SACK"), 0, false)
+    S = snap(a)
+    p:UseActiveItem(item("COLLECTIBLE_PONY"), UseFlag.USE_NOANIM, 0)
+    p:AddCollectible(item("COLLECTIBLE_PONY"), 0, false)
+    p:UseActiveItem(item("COLLECTIBLE_PONY"), UseFlag.USE_NOANIM, 0)
+  elseif frame == 130 then
+    diff("Pony used", a, S)
+    S = snap(a)
+  elseif frame == 135 then
+    -- coins picked up with Keeper's Sack
+    for i = 1, 6 do Isaac.Spawn(5, 20, 1, p.Position, Vector(0, 0), nil) end
+  elseif frame == 160 then
+    diff("coins picked up with Keeper's Sack", a, S)
+    S = snap(a)
+  elseif frame == 165 then
+    -- knives
+    local p0 = p
+    knife = p0:FireKnife(p0, 0, false, 0, 1)   -- bone club
+    say("fired a knife: " .. tostring(knife))
+    if knife then
+      local k = B.ptr(knife)
+      say(string.format("knife %08x type %d variant %d: +444 %g +448 %g +465 %02x +466 %02x +4d8 %08x %08x %08x +4e5 %02x +4e6 %02x +4e7 %02x +4ea %02x +45c %g +460 %g", k, ri32(k + 0x28), ri32(k + 0x2c),
+        rf32(k + 0x444), rf32(k + 0x448), r8(k + 0x465), r8(k + 0x466), r32(k + 0x4d8), r32(k + 0x4dc), r32(k + 0x4e0), r8(k + 0x4e5), r8(k + 0x4e6), r8(k + 0x4e7), r8(k + 0x4ea), rf32(k + 0x45c), rf32(k + 0x460)))
+    end
+  elseif frame >= 166 and frame <= 200 and knife and frame % 5 == 0 then
+    local k = B.ptr(knife)
+    say(string.format("f%d knife: +444 %g +448 %g +465 %02x +466 %02x hitlist %08x..%08x +4e5 %02x +4e6 %02x +4ea %02x charge %g", frame, rf32(k + 0x444), rf32(k + 0x448), r8(k + 0x465), r8(k + 0x466), r32(k + 0x4d8), r32(k + 0x4dc), r8(k + 0x4e5), r8(k + 0x4e6), r8(k + 0x4ea), rf32(k + 0x460)))
+  elseif frame == 201 then
+    say("DONE")
+  end
+end)
