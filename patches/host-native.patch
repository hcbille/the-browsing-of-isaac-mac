@@ -0,0 +1,30 @@
+-- lab_stageapi_boss.lua (development only; ISAAC_RGON_LAB=lab_stageapi_boss.lua, StageAPI batch)
+-- MC_PRE_BOSS_SELECT: the game picks a boss for each floor's boss room at level generation through
+-- BossPool::GetBossId. This lab registers the callback, logs every call, and (ISAAC_LAB_BOSS=<id>) answers with
+-- that boss id for the first call of the run. When the floor exists it logs the boss room's room-config subtype
+-- (the boss id) so the answer can be matched against it.
+-- Log lines: "lab_stageapi_boss: CALL n: bossId=.. pool=.. levelType=.. levelVariant=.. -> answer ..." and
+-- "lab_stageapi_boss: boss room of this floor: subtype ..".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi boss", 1)
+local want = tonumber(B.env("ISAAC_LAB_BOSS") or "")
+local calls = 0
+local function say(s) B.log("lab_stageapi_boss: " .. s) end
+mod:AddCallback(ModCallbacks.MC_PRE_BOSS_SELECT, function(_, bossId, pool, levelType, levelVariant)
+  calls = calls + 1
+  local ans = nil
+  if want and calls == 1 then ans = want end
+  say(string.format("CALL %d: bossId=%s pool=%s levelType=%s levelVariant=%s -> answer %s", calls, tostring(bossId), tostring(pool),
+    tostring(levelType), tostring(levelVariant), tostring(ans)))
+  return ans
+end)
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function()
+  local level = Game():GetLevel()
+  for i = 0, level:GetRoomCount() - 1 do
+    local d = level:GetRooms():Get(i)
+    if d.Data and d.Data.Type == RoomType.ROOM_BOSS then
+      say(string.format("boss room of this floor: stage %d, grid %d, variant %d, subtype %d", level:GetStage(), d.GridIndex, d.Data.Variant, d.Data.Subtype))
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_probe.lua b/scripts/recomp/rgon/lab_stageapi_probe.lua
