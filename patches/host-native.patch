@@ -0,0 +1,116 @@
+-- lab_b2probe.lua (development only; ISAAC_RGON_LAB=lab_b2probe.lua, census batch 2)
+-- Measures where Entity_Player's fields are in THIS build, by watching the structure while the game does
+-- something it should change: snapshot the player's words, act, snapshot again, log what changed
+-- ("lab_b2probe: <scenario> +OFFSET old -> new"). REPENTOGON's offset for each field is in the task text of
+-- layer-gaps.md section 9; the delta is what this lab finds.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32 = B.r32, B.ri32, B.rf32, B.w32
+local mod = RegisterMod("rgon lab b2probe", 1)
+local LO, HI = 0x1300, 0x2c00
+local function say(s) B.log("lab_b2probe: " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local function diff(name, a, before, skip)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not (skip and skip[o]) then
+      n = n + 1
+      if n <= 70 then say(string.format("%s +%04x %08x -> %08x (%d -> %d, f %g -> %g)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now, B.i2f and B.i2f(before[o]) or 0, B.i2f and B.i2f(now) or 0)) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local frame, shoot = 0, false
+local S
+local C = CollectibleType
+local function item(name) return C[name] or -1 end
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if shoot and ent and ent.Type == 1 and action == ButtonAction.ACTION_SHOOTRIGHT then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local pointers_done = false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if frame == 5 then
+    say(string.format("player at %08x type %d", a, p:GetPlayerType()))
+    -- weapon pointers: words in the player that point at an object whose +4 is the player
+    for o = 0x13a0, 0x1480, 4 do
+      local v = r32(a + o)
+      if v > 0x01000000 and v < 0x20000000 and (v & 3) == 0 then
+        local owner = r32(v + 4)
+        if owner == a then
+          say(string.format("pointer at +%04x -> %08x: vtable %08x, owner = the player, +c %g, +10 %g, +14 %g, +30 type %d, +34 mods %08x, +38 %d", o, v, r32(v), rf32(v + 0xc), rf32(v + 0x10), rf32(v + 0x14), ri32(v + 0x30), r32(v + 0x34), ri32(v + 0x38)))
+        end
+      end
+    end
+    say(string.format("MaxFireDelay %g, MoveSpeed %g, Damage %g, Luck %g, ShotSpeed %g, TearRange %g", p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange))
+    -- the six int modifiers (REPENTOGON 0x1518 + 8): write 5 into each, re-evaluate, see which stat moved
+    local base = { p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange }
+    for i = 0, 5 do
+      local at = a + 0x1520 + 4 * i
+      local old = r32(at)
+      w32(at, 5)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+      say(string.format("modifier word +%04x (was %d) = 5: MaxFireDelay %g, MoveSpeed %g, Damage %g, Luck %g, ShotSpeed %g, TearRange %g", 0x1520 + 4 * i, old, p.MaxFireDelay, p.MoveSpeed, p.Damage, p.Luck, p.ShotSpeed, p.TearRange))
+      w32(at, old)
+      p:AddCacheFlags(CacheFlag.CACHE_ALL)
+      p:EvaluateItems()
+    end
+    S = snap(a)
+  elseif frame == 15 then
+    B.call(0x007d3480, a, 3)
+    diff("AddUrnSouls(3)", a, S)
+    S = snap(a)
+  elseif frame == 25 then
+    p:AddCollectible(item("COLLECTIBLE_KEEPERS_SACK"), 0, false)
+    p:AddCoins(40)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems()
+    diff("KeepersSack+40coins", a, S)
+    S = snap(a)
+  elseif frame == 40 then
+    p:AddCollectible(item("COLLECTIBLE_IMMACULATE_CONCEPTION"), 0, false)
+    p:AddSoulHearts(2) p:AddSoulHearts(2)
+    diff("ImmaculateConception", a, S)
+    S = snap(a)
+  elseif frame == 55 then
+    p:AddCollectible(item("COLLECTIBLE_MARKED"), 0, false)
+    S = snap(a)
+  elseif frame == 90 then
+    diff("Marked (35 frames later)", a, S)
+    for o = 0x13a0, 0x1480, 4 do
+      local v = r32(a + o)
+      if v > 0x01000000 and v < 0x20000000 and (v & 3) == 0 then
+        local ty, va = ri32(v + 0x28), ri32(v + 0x2c)
+        if ty >= 1 and ty <= 1000 or ty == 1000 then say(string.format("entity-like pointer at +%04x -> %08x type %d variant %d", o, v, ty, va)) end
+      end
+    end
+    local found = false
+    for _, e in ipairs(Isaac.FindByType(1000, 30)) do say(string.format("a TARGET effect at %08x", B.ptr(e))) found = true end
+    S = snap(a)
+    shoot = true
+  elseif frame == 100 or frame == 110 then
+    diff("shooting at f" .. frame, a, S, nil)
+    S = snap(a)
+  elseif frame == 112 then
+    shoot = false
+    say(string.format("tear displacement candidates: +1578 byte %d, +1574 %08x", B.r8(a + 0x1578), r32(a + 0x1574)))
+  elseif frame == 130 then
+    -- player forms: three Sad Onion-like? give Leviathan pieces: Spun? Use Guppy's items (3 = guppy form)
+    S = snap(a)
+    for _, n in ipairs({ "COLLECTIBLE_GUPPYS_PAW", "COLLECTIBLE_GUPPYS_TAIL", "COLLECTIBLE_GUPPYS_HEAD" }) do p:AddCollectible(item(n), 0, false) end
+    say("HasPlayerForm(GUPPY) " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)))
+    diff("Guppy form", a, S)
+  elseif frame == 150 then
+    say("DONE")
+  end
+end)
