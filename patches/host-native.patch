+    end
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BROTHER_BOBBY, 0, false)
+    fly = Isaac.Spawn(18, 0, 0, p.Position + Vector(80, 0), Vector(0, 0), nil)
+    if bell_id and bell_id > 0 then p:AddCollectible(bell_id, 0, false) end
+    if toad_var and toad_var >= 0 then Isaac.Spawn(570, toad_var, 0, p.Position + Vector(-120, 0), Vector(0, 0), nil) end
+  end
+  if frame == 15 then
+    try("GetMultiplier 1 without BFFS", function()
+      local n = 0
+      for _, e in ipairs(Isaac.FindByType(3, 1)) do
+        bobby = e:ToFamiliar()
+        local m = bobby:GetMultiplier()
+        n = n + 1
+        check("Bobby multiplier is 1 without BFFS", m == 1, m)
+      end
+      check("found a Brother Bobby", n > 0)
+    end)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BFFS, 0, false)
+  end
+  if frame == 25 then
+    try("GetMultiplier 2 with BFFS", function()
+      check("Bobby multiplier is 2 with BFFS", bobby:GetMultiplier() == 2, bobby:GetMultiplier())
+    end)
+    p:RemoveCollectible(CollectibleType.COLLECTIBLE_BFFS)
+  end
+  if frame == 35 then
+    try("GetMultiplier back to 1", function()
+      check("Bobby multiplier is 1 after BFFS is removed", bobby:GetMultiplier() == 1, bobby:GetMultiplier())
+    end)
+    local nbell, ntoad = 0, 0
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      if e.Type == 3 and e.Variant == bell_var then
+        nbell = nbell + 1
+        local m = e:ToFamiliar():GetMultiplier()
+        check("Baby Bell familiar GetMultiplier answers 1 or 2", m == 1 or m == 2, m)
+      end
+      if e.Type == 570 and e.Variant == toad_var then ntoad = ntoad + 1 end
+    end
+    B.log(string.format("lab_entity_more_test: Baby Bell item %s familiars %d; Toadsie variant %s count %d", tostring(bell_id), nbell, tostring(toad_var), ntoad))
+    try("pathfinders", function()
+      local mt
+      for _, e in ipairs(Isaac.GetRoomEntities()) do
+        local npc = e:ToNPC()
+        if npc then
+          local pf = npc:GetPathfinder()
+          check("NPC " .. e.Type .. " pathfinder at +0x414", pf ~= nil and B.ptr(pf) == B.ptr(npc) + 0x414)
+          local vanilla = npc.Pathfinder
+          mt = mt or getmetatable(vanilla)
+          check("NPC " .. e.Type .. " pathfinder is the game's PathFinder class", getmetatable(pf) == getmetatable(vanilla))
+          check("pathfinder owner word is the NPC", r32(B.ptr(pf)) == B.ptr(npc))
+          local ok, r = pcall(function() return pf:HasPathToPos(p.Position, false) end)
+          check("pathfinder:HasPathToPos answers a boolean", ok and type(r) == "boolean", r)
+        end
+      end
+      for _, e in ipairs(Isaac.FindByType(3)) do
+        local fam = e:ToFamiliar()
+        local pf, pf2 = fam:GetPathfinder(), fam:GetPathFinder()
+        check("familiar " .. e.Variant .. " pathfinder at +0x5fc", B.ptr(pf) == B.ptr(fam) + 0x5fc and B.ptr(pf2) == B.ptr(pf))
+        check("familiar pathfinder class", mt == nil or getmetatable(pf) == mt)
+        check("familiar pathfinder owner word is the familiar", r32(B.ptr(pf)) == B.ptr(fam))
+      end
+    end)
+    try("colour params", function()
+      local ref = EntityRef(p)
+      fly:AddBurn(ref, 100, 1) fly:AddPoison(ref, 100, 1) fly:AddFear(ref, 100) fly:AddFreeze(ref, 100)
+    end)
+    try("B.call returns", function()
+      -- existing users take (eax, st0, edx); the fourth value (xmm0) is only added after them
+      local out = B.alloc(8)
+      local a, st0, edx, x0 = B.call(0x006b6ed0, B.ptr(fly), out)
+      check("call: eax is the out pointer (GetWaterClipInfo returns it)", a == out, a)
+      check("call: st0 is a number", type(st0) == "number")
+      check("call: edx is an integer", math.type(edx) == "integer")
+      check("call: xmm0 is a number, 4 results", type(x0) == "number" and select("#", B.call(0x006b6ed0, B.ptr(fly), out)) == 4)
+      local only = B.call(0x006b6ed0, B.ptr(fly), out)
+      check("call: single-value use unchanged", only == out)
+      B.free(out)
+    end)
+    try("water clip flags", function()
+      local before = fly:GetWaterClipFlags()
+      check("GetWaterClipFlags answers an integer", math.type(before) == "integer", before)
+      fly:SetWaterClipFlags(0x25)
+      check("SetWaterClipFlags reads back", fly:GetWaterClipFlags() == 0x25, fly:GetWaterClipFlags())
+      local other = Isaac.Spawn(18, 0, 0, p.Position + Vector(0, 80), Vector(0, 0), nil)
+      check("another entity is unaffected", other:GetWaterClipFlags() == before, other:GetWaterClipFlags())
+      fly:ResetWaterClipFlags()
+      check("ResetWaterClipFlags restores the game's answer", fly:GetWaterClipFlags() == before, fly:GetWaterClipFlags())
+      fly:SetWaterClipFlags(0x3)
+      fly:SetWaterClipFlags(0x6)
+      check("a second Set replaces the first", fly:GetWaterClipFlags() == 6)
+      fly:ResetWaterClipFlags()
+      other:Remove()
+    end)
+  end
+  if frame == 45 then
+    try("GetColorParams", function()
+      local list = fly:GetColorParams()
+      local n = ncolors(fly)
+      check("colour list has the entries of the game's vector", #list == n and n > 0, #list .. " vs " .. n)
+      local first = list[1]
+      check("entry 1 priority 255", first:GetPriority() == 255, first:GetPriority())
+      check("entry 1 lifespan positive", first:GetLifespan() > 0, first:GetLifespan())
+      check("entry 1 colour is a Color", first:GetColor().R ~= nil or first:GetColor():GetTint() ~= nil)
+      local e = r32(B.ptr(fly) + 0x1ac)
+      check("entry 1 fields equal the memory", first:GetDuration() == B.ri32(e + 0x30) and first:GetLifespan() == B.ri32(e + 0x34)
+        and first:GetShared() == (B.r8(e + 0x39) ~= 0) and first:GetFadeout() == (B.r8(e + 0x38) ~= 0))
+      local t = first:GetColor():GetTint()
+      check("entry 1 tint equals the memory", math.abs(t.R - rf32(e + 4)) < 1e-6 and math.abs(t.A - rf32(e + 16)) < 1e-6)
+      -- the way Fiend Folio uses it: drop the priority-255 ones, write the list back
+      for i = #list, 1, -1 do if list[i]:GetPriority() == 255 then table.remove(list, i) end end
+      fly:SetColorParams(list)
+      check("SetColorParams with the 255s removed empties the vector", ncolors(fly) == 0, ncolors(fly))
+      local cp = ColorParams(Color(1, 0, 0, 1, 0, 0, 0), 77, 150, false, true)
+      check("ColorParams constructor", cp:GetPriority() == 77 and cp:GetDuration() == 150 and cp:GetLifespan() == 150 and cp:GetShared() == true and cp:GetFadeout() == false)
+      cp:SetPriority(80) cp:SetLifespan(60) cp:SetFadeout(true)
+      fly:SetColorParams({ cp, ColorParams(Color(0, 1, 0, 1), 10, 20, true, false) })
+      local back = fly:GetColorParams()
+      check("two entries written", #back == 2 and ncolors(fly) == 2, #back)
+      check("entry 1 round trip", back[1]:GetPriority() == 80 and back[1]:GetLifespan() == 60 and back[1]:GetDuration() == 150
+        and back[1]:GetFadeout() == true and back[1]:GetShared() == true)
+      check("entry 1 colour round trip", math.abs(back[1]:GetColor():GetTint().R - 1) < 1e-6)
+      check("entry 2 round trip", back[2]:GetPriority() == 10 and back[2]:GetDuration() == 20 and back[2]:GetFadeout() == true
+        and math.abs(back[2]:GetColor():GetTint().G - 1) < 1e-6)
+      local big = {}
+      for i = 1, 9 do big[i] = ColorParams(Color(1, 1, 1, 1), i, 5, false, false) end
+      fly:SetColorParams(big)
+      check("a longer list grows the vector", ncolors(fly) == 9 and fly:GetColorParams()[9]:GetPriority() == 9, ncolors(fly))
+      fly:SetColorParams({})
+      check("an empty list clears", ncolors(fly) == 0)
+      local ok = pcall(function() fly:SetColorParams(5) end)
+      check("SetColorParams(non-table) raises", not ok)
+    end)
+    -- the game's own reaction: the flies keep updating with the list set, and a tint set through the game's SetColor shows up
+    try("game reaction", function()
+      fly:SetColor(Color(1, 0, 0, 1), 30, 3, false, false)
+      local list = fly:GetColorParams()
+      local found
+      for _, c in ipairs(list) do if c:GetPriority() == 3 then found = c end end
+      check("Entity:SetColor lands in GetColorParams with its priority and lifespan", found ~= nil and found:GetLifespan() == 30, found and found:GetLifespan())
+    end)
+  end
+  if frame == 120 then
+    check("ran to the end", true)
+    B.log(string.format("lab_entity_more_test: DONE pass %d fail %d", npass, nfail))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_entity_probe.lua b/scripts/recomp/rgon/lab_entity_probe.lua
new file mode 100644
index 0000000..d086a33
--- /dev/null
+++ b/scripts/recomp/rgon/lab_entity_probe.lua
@@ -0,0 +1,45 @@
+-- lab_entity_probe.lua (development only; ISAAC_RGON_LAB=lab_entity_probe.lua): measures, in this build, where an
+-- EntityNPC and an EntityFamiliar keep their pathfinder (REPENTOGON: NPC 0x414, familiar 0x5fc for v1.9.7.12). A pathfinder
+-- is recognised by its first word being the owner entity itself (REPENTOGON NPCAI_Pathfinder._entity at 0x0).
+-- Also dumps what the game's own `npc.Pathfinder` userdata points at, and a colour-params vector entry.
+local T = ...
+local B = T.B
+local r32 = B.r32
+local mod = RegisterMod("rgon lab entity probe", 1)
+local function say(s) B.log("lab_entity_probe: " .. s) end
+local frame = 0
+local function scan(name, e, lo, hi)
+  local a = B.ptr(e)
+  say(string.format("%s entity %08x type %d.%d", name, a, e.Type, e.Variant))
+  for o = lo, hi, 4 do
+    if r32(a + o) == a then
+      say(string.format("%s +%04x holds the entity itself (pathfinder candidate); next words %08x %08x grid %d", name, o,
+        r32(a + o + 4), r32(a + o + 8), B.ri32(a + o + 0x20)))
+    end
+  end
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BROTHER_BOBBY, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_DEAD_BIRD, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_LITTLE_STEVEN, 0, false)
+    Isaac.Spawn(10, 0, 0, p.Position + Vector(100, 0), Vector(0, 0), nil)   -- gaper
+    Isaac.Spawn(18, 0, 0, p.Position + Vector(0, 100), Vector(0, 0), nil)   -- fly
+    Isaac.Spawn(26, 0, 0, p.Position + Vector(-100, 0), Vector(0, 0), nil)  -- maw / spider
+  end
+  if frame == 20 then
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      local npc = e:ToNPC()
+      if npc then
+        scan("NPC", npc, 0x300, 0x700)
+        local pf = npc.Pathfinder
+        say(string.format("NPC %d.%d vanilla .Pathfinder = %s ptr %08x (entity %08x)", e.Type, e.Variant, tostring(pf),
+          pf and B.ptr(pf) or 0, B.ptr(npc)))
+      end
+      local fam = e:ToFamiliar()
+      if fam then scan("FAM", fam, 0x400, 0xc00) end
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_familiar_probe.lua b/scripts/recomp/rgon/lab_familiar_probe.lua
new file mode 100644
index 0000000..8dc242a
--- /dev/null
+++ b/scripts/recomp/rgon/lab_familiar_probe.lua
@@ -0,0 +1,85 @@
+-- lab_familiar_probe.lua (development only; ISAAC_RGON_LAB=lab_familiar_probe.lua): measures where an
+-- EntityFamiliar keeps its Weapon pointer (REPENTOGON 0xdb0 for v1.9.7.12) and where an Entity keeps its
+-- colour-params vector (REPENTOGON 0x1ac). A Weapon is recognised by its owner word (+4) being the entity itself.
+local T = ...
+local B = T.B
+local r32 = B.r32
+local mod = RegisterMod("rgon lab familiar probe", 1)
+local function say(s) B.log("lab_familiar_probe: " .. s) end
+local frame = 0
+local held = {}
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local function dump(name, e)
+  local a = B.ptr(e)
+  say(string.format("%s dump +d90..: %08x %08x %08x %08x %08x %08x %08x %08x", name, r32(a + 0xda8), r32(a + 0xdac), r32(a + 0xdb0), r32(a + 0xdb4), r32(a + 0xdb8), r32(a + 0xdbc), r32(a + 0xdc0), r32(a + 0xdc4)))
+end
+local function scan(name, e)
+  local a = B.ptr(e)
+  for o = 0x600, 0x1400, 4 do
+    local v = r32(a + o)
+    if v > 0x10000 and v < 0xf0000000 then
+      local ok, owner = pcall(r32, v + 4)
+      if ok and owner == a then say(string.format("%s +%04x -> weapon candidate %08x (type %d, maxdelay %g)", name, o, v, B.ri32(v + 0x30), B.rf32(v + 0x10))) end
+    end
+  end
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BROTHER_BOBBY, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_DEAD_BIRD, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_CUBE_OF_MEAT, 0, false)
+    for _, n in ipairs({ "INCUBUS", "TWISTED_PAIR", "LIL_BRIMSTONE", "DEMON_BABY", "ROBO_BABY_2", "SPRINKLER", "LORD_OF_THE_PIT", "SUCCUBUS", "SPIDER_MOD", "BBF", "LIL_HAUNT", "HARLEQUIN_BABY", "RAINBOW_BABY", "SERAPHIM", "BOT_FLY", "GHOST_BABY", "DARK_BUM", "ABEL", "LIL_LOKI", "LITTLE_STEVEN", "SISTER_MAGGY", "ROBO_BABY", "CAINS_OTHER_EYE", "ACID_BABY", "ISAACS_HEART", "JUICY_SACK", "SACK_OF_PENNIES", "LEECH", "LIL_GURDY", "BLOODSHOT_EYE" }) do
+      local id = CollectibleType["COLLECTIBLE_" .. n]
+      if id then p:AddCollectible(id, 0, false) else say("no item " .. n) end
+    end
+  end
+  if frame == 40 then
+    for _, f in ipairs(Isaac.FindByType(3)) do
+      say(string.format("familiar variant %d sub %d addr %x +da8..dc4 order:", f.Variant, f.SubType, B.ptr(f)))
+      scan("var" .. f.Variant, f)
+      dump("var" .. f.Variant, f)
+    end
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+    -- colour vector: begin/end/cap of the player and of a fresh fly
+    local fly = Isaac.Spawn(18, 0, 0, p.Position + Vector(80, 0), Vector(0, 0), nil)
+    for _, e in ipairs({ p, fly }) do
+      local a = B.ptr(e)
+      say(string.format("ent type %d vec@1ac %08x %08x %08x ; flags %08x %08x", e.Type, r32(a + 0x1ac), r32(a + 0x1b0), r32(a + 0x1b4), r32(a + 0x168), r32(a + 0x16c)))
+    end
+    fly:AddBurn(EntityRef(p), 100, 1)
+    fly:AddPoison(EntityRef(p), 100, 1)
+    fly:AddSlowing(EntityRef(p), 100, 0.5, Color(1, 1, 1, 1, 0, 0, 0))
+    fly:AddFear(EntityRef(p), 100)
+    fly:AddFreeze(EntityRef(p), 100)
+    fly:AddCharmed(EntityRef(p), 100)
+    local a = B.ptr(fly)
+    say(string.format("fly after statuses vec@1ac %08x %08x %08x ; flags %08x %08x", r32(a + 0x1ac), r32(a + 0x1b0), r32(a + 0x1b4), r32(a + 0x168), r32(a + 0x16c)))
+    local b, e2 = r32(a + 0x1ac), r32(a + 0x1b0)
+    for q = b, e2 - 4, 4 do
+      say(string.format("  colorvec +%02x %08x (f %g)", q - b, r32(q), B.i2f(r32(q))))
+    end
+  end
+  if frame == 100 then
+    for _, f in ipairs(Isaac.FindByType(3)) do
+      say(string.format("after shooting: variant %d ShootDirection %d", f.Variant, f.ShootDirection or -1))
+      scan("late" .. f.Variant, f)
+      dump("late" .. f.Variant, f)
+    end
+  end
+  if frame == 60 then
+    local a
+    for _, e in ipairs(Isaac.GetRoomEntities()) do if e.Type == 18 then a = B.ptr(e) end end
+    if a then
+      local b, e2 = r32(a + 0x1ac), r32(a + 0x1b0)
+      say(string.format("fly later vec %08x %08x size %d", b, e2, e2 - b))
+      for q = b, e2 - 4, 4 do say(string.format("  colorvec +%02x %08x (f %g)", q - b, r32(q), B.i2f(r32(q)))) end
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_familiar_test.lua b/scripts/recomp/rgon/lab_familiar_test.lua
new file mode 100644
index 0000000..9f8de4d
--- /dev/null
+++ b/scripts/recomp/rgon/lab_familiar_test.lua
@@ -0,0 +1,158 @@
+-- lab_familiar_test.lua (development only; ISAAC_RGON_LAB=lab_familiar_test.lua): EntityFamiliar:GetWeapon and
+-- Entity:CopyStatusEffects (api_familiar.lua). Logs "lab_familiar_test: PASS/FAIL .." and a DONE line.
+-- CopyStatusEffects is compared with the game's own copy (0x006a8a20, parent to child chain) run on a second pair.
+local T = ...
+local B = T.B
+local r32, ri32 = B.r32, B.ri32
+local mod = RegisterMod("rgon lab familiar test", 1)
+local npass, nfail = 0, 0
+local function check(name, ok, detail)
+  if ok then npass = npass + 1 else nfail = nfail + 1 end
+  B.log("lab_familiar_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+local FIELDS = { 0x218, 0x21c, 0x220, 0x224, 0x228, 0x22c, 0x230, 0x234, 0x2e8, 0x23c, 0x320, 0x324, 0x2f0, 0x2f4, 0x2f8,
+  0x300, 0x2fc, 0x304, 0x308, 0x30c, 0x3b4, 0x3b8 }
+local function snap(e)
+  local a, t = B.ptr(e), {}
+  for _, o in ipairs(FIELDS) do t[o] = r32(a + o) end
+  t.flags = r32(a + 0x168) & 0x21001fe0
+  t.flags2 = r32(a + 0x16c) & 0x015d8000
+  return t
+end
+local function same(a, b)
+  for k, v in pairs(a) do if b[k] ~= v then return false, string.format("%s %x vs %x", tostring(k), v, b[k] or -1) end end
+  return true
+end
+local function statuses(e, p)
+  local ref = EntityRef(p)
+  e:AddBurn(ref, 100, 1) e:AddPoison(ref, 100, 1) e:AddSlowing(ref, 100, 0.5, Color(1, 1, 1, 1, 0, 0, 0))
+  e:AddFear(ref, 100) e:AddFreeze(ref, 100) e:AddCharmed(ref, 100) e:AddConfusion(ref, 100, false)
+end
+local function ncolors(e) local a = B.ptr(e) return (r32(a + 0x1b0) - r32(a + 0x1ac)) // 0x3c end
+
+local held = {}
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local frame = 0
+local fly = {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    check("Implemented EntityFamiliar.GetWeapon", REPENTOGON.Implemented["EntityFamiliar.GetWeapon"] == true)
+    check("Implemented Entity.CopyStatusEffects", REPENTOGON.Implemented["Entity.CopyStatusEffects"] == true)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BROTHER_BOBBY, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_INCUBUS, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_TWISTED_PAIR, 0, false)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_LITTLE_STEVEN, 0, false)
+    for i = 1, 8 do fly[i] = Isaac.Spawn(18, 0, 0, p.Position + Vector(60 + 20 * i, 0), Vector(0, 0), nil) end
+  end
+  if frame == 20 then
+    try("familiar weapons", function()
+      local seen = {}
+      for _, f in ipairs(Isaac.FindByType(3)) do
+        local fam = f:ToFamiliar()
+        local w = fam:GetWeapon()
+        seen[f.Variant] = true
+        if f.Variant == 80 or f.Variant == 235 then
+          check("variant " .. f.Variant .. " has a Weapon", w ~= nil)
+          if w then
+            check("variant " .. f.Variant .. " weapon type 1 (tears)", w:GetWeaponType() == 1, w:GetWeaponType())
+            check("variant " .. f.Variant .. " weapon owner is the familiar", w:GetOwner() ~= nil and w:GetOwner().Index == f.Index and w:GetOwner().InitSeed == f.InitSeed)
+            check("variant " .. f.Variant .. " max fire delay sensible", w:GetMaxFireDelay() > 0 and w:GetMaxFireDelay() < 100, w:GetMaxFireDelay())
+            check("variant " .. f.Variant .. " fire delay readable", type(w:GetFireDelay()) == "number")
+          end
+        elseif f.Variant == 1 or f.Variant == 44 then
+          check("variant " .. f.Variant .. " has no Weapon (nil)", w == nil, tostring(w))
+        end
+      end
+      check("saw Incubus, Twisted Pair, Bobby", seen[80] and seen[235] and seen[1])
+    end)
+    try("statuses", function()
+      local a, b, c = fly[1], fly[2], fly[3]
+      statuses(a, p)
+      check("source has shared colours", ncolors(a) > 0, ncolors(a))
+      b:SetFreezeCountdown(7)
+      a:CopyStatusEffects(b)
+      local sa, sb = snap(a), snap(b)
+      local ok, why = same(sa, sb)
+      check("explicit copy: every status field copied", ok, why)
+      check("explicit copy: target has the status flags", b:HasEntityFlags(EntityFlag.FLAG_BURN | EntityFlag.FLAG_POISON | EntityFlag.FLAG_FEAR))
+      check("explicit copy: shared colours added", ncolors(b) >= 1, ncolors(b))
+      -- overwrite false leaves a countdown the source does not have
+      c:SetFreezeCountdown(0) c:SetCharmedCountdown(9)
+      local z = fly[4]
+      z:AddBurn(EntityRef(p), 50, 1)
+      z:CopyStatusEffects(c)
+      check("non-overwrite: target keeps its own charm countdown", c:GetCharmedCountdown() == 9, c:GetCharmedCountdown())
+      check("non-overwrite: burn arrives", c:GetBurnCountdown() == z:GetBurnCountdown() and c:GetBurnCountdown() > 0, c:GetBurnCountdown())
+      -- overwrite true replaces
+      c:CopyStatusEffects(fly[5], false)
+      fly[5]:SetCharmedCountdown(3)
+      z:CopyStatusEffects(fly[5], true)
+      check("overwrite: target charm countdown replaced by 0", fly[5]:GetCharmedCountdown() == z:GetCharmedCountdown())
+      -- nil target with children, against the game's own function on a second pair
+      -- the game's own copy only acts on segmented bosses (its predicate at 0x006a8db0 switches on the type): Larry Jr. (19)
+      local function larry(x) local l = Isaac.Spawn(19, 0, 0, p.Position + Vector(x, 100), Vector(0, 0), nil) return l end
+      local d, e, g1, g2 = larry(-120), larry(-60), larry(0), larry(60)
+      statuses(d, p) statuses(g1, p)
+      d.Child = e g1.Child = g2
+      e:SetFreezeCountdown(0) g2:SetFreezeCountdown(0)
+      d:CopyStatusEffects(nil)
+      B.call(0x006a8a20, B.ptr(g1))
+      local ok2, why2 = same(snap(g2), snap(e))
+      check("nil target: the child gets what the game's own copy gives its child", ok2, why2)
+      check("game's own copy did copy something", g2:GetBurnCountdown() > 0 and e:GetBurnCountdown() > 0, g2:GetBurnCountdown() .. " / " .. e:GetBurnCountdown())
+      check("bad target errors", not pcall(function() a:CopyStatusEffects(5) end))
+      check("bad overwrite errors", not pcall(function() a:CopyStatusEffects(b, 5) end))
+    end)
+    try("boss cooldown", function()
+      local boss1 = Isaac.Spawn(20, 0, 0, p.Position + Vector(-100, 0), Vector(0, 0), nil)
+      local boss2 = Isaac.Spawn(20, 0, 0, p.Position + Vector(-100, 40), Vector(0, 0), nil)
+      boss1:SetBossStatusEffectCooldown(50)
+      boss1:CopyStatusEffects(boss2, true)
+      check("boss to boss: cooldown copied", boss2:GetBossStatusEffectCooldown() == 50, boss2:GetBossStatusEffectCooldown())
+      local plain = fly[8]
+      plain:SetBossStatusEffectCooldown(0)
+      boss1:CopyStatusEffects(plain, true)
+      check("boss to fly: cooldown not copied", plain:GetBossStatusEffectCooldown() == 0, plain:GetBossStatusEffectCooldown())
+    end)
+    try("TryAimAtMarkedTarget without a marked target", function()
+      local inc
+      for _, f in ipairs(Isaac.FindByType(3, 80)) do inc = f:ToFamiliar() end
+      local ok, t = inc:TryAimAtMarkedTarget()
+      check("no Marked: false and a table of three", ok == false and type(t) == "table" and t[1] ~= nil and type(t[2]) == "number" and t[3] ~= nil, tostring(ok))
+      check("no Marked: two arguments answer nil", inc:TryAimAtMarkedTarget(Vector(0, 0), -1) == nil)
+    end)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_MARKED, 0, false)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  end
+  if frame == 60 then
+    try("TryAimAtMarkedTarget with Marked", function()
+      local inc
+      for _, f in ipairs(Isaac.FindByType(3, 80)) do inc = f:ToFamiliar() end
+      local mt = p:GetMarkedTarget()
+      check("Marked target exists", mt ~= nil)
+      if mt then
+        local ok, t = inc:TryAimAtMarkedTarget()
+        check("Marked: true", ok == true, tostring(ok))
+        local want = (mt.Position - inc.Position):Normalized()
+        check("Marked: aim direction points at the target", (t[1] - want):Length() < 0.05, tostring(t[1]) .. " vs " .. tostring(want))
+        check("Marked: direction is 0..3", t[2] >= 0 and t[2] <= 3, t[2])
+        check("Marked: target position is a Vector", t[3] ~= nil, tostring(t[3]))
+        local pos = inc:TryAimAtMarkedTarget(Vector(0, 0), -1)
+        check("Marked: two arguments answer the target position", pos ~= nil, tostring(pos))
+      end
+    end)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+    B.log(string.format("lab_familiar_test: DONE pass=%d fail=%d", npass, nfail))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_ff_veil.lua b/scripts/recomp/rgon/lab_ff_veil.lua
new file mode 100644
index 0000000..7205632
--- /dev/null
+++ b/scripts/recomp/rgon/lab_ff_veil.lua
@@ -0,0 +1,70 @@
+-- lab_ff_veil.lua (development only; ISAAC_RGON_LAB=lab_ff_veil.lua, census batch 3, needs Fiend Folio in the mods): drives
+-- Fiend Folio's ffscripts/erfly/misc/curseveil.lua MC_POST_NEW_ROOM callback through both of its Minimap branches:
+--   1. the level gets Curse of the Veil, then a room change: the callback does `Minimap:GetIconsSprite()`,
+--      ReplaceSpritesheet(0, "gfx/ui/minimap_icons_veil.png") and LoadGraphics() (line 284 in the Workshop copy);
+--   2. the curse is removed, then another room change: the callback puts "gfx/ui/minimap_icons.png" back (line 301).
+-- It logs the sheet path of Minimap:GetIconsSprite() after each, and "lab_ff_veil: PASS/FAIL". The errors the callback
+-- would raise are in the game's log as `"MC_POST_NEW_ROOM" from "Fiend Folio" failed` lines (run with lua_debug).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab ff veil", 1)
+local function say(s) B.log("lab_ff_veil: " .. s) end
+local function path() return Minimap:GetIconsSprite():GetLayer(0):GetSpritesheetPath() end
+local started, step, veil = false, 0, nil
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+local function other_room()
+  local lvl = Game():GetLevel()
+  local cur = lvl:GetCurrentRoomIndex()
+  local rooms = lvl:GetRooms()
+  for i = 0, rooms.Size - 1 do
+    local d = rooms:Get(i)
+    if d and d.SafeGridIndex ~= cur and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then return d.SafeGridIndex end
+  end
+end
+local armed_at, waiting = nil, 0
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  local gf = Game():GetFrameCount()
+  if gf < 60 then return end
+  waiting = waiting + 1
+  local lvl = Game():GetLevel()
+  if step == 0 then
+    veil = Isaac.GetCurseIdByName("Curse of the Veil!")
+    if not veil or veil < 1 then
+      say("FAIL Fiend Folio's veil curse id not found: " .. tostring(veil))
+      step = 99
+      return
+    end
+    say("veil curse id " .. veil .. ", sheet now " .. tostring(path()))
+    lvl:AddCurse(1 << (veil - 1), false)
+    local r = other_room()
+    say("curse added, moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 1, 0
+  elseif step == 1 and waiting == 30 then
+    local p = path()
+    say("level curses now " .. tostring(lvl:GetCurses()) .. " (the veil bit is " .. (1 << (veil - 1)) .. "), FiendFolioMinimapIsVeiled = " .. tostring(FiendFolioMinimapIsVeiled))
+    say((p == "gfx/ui/minimap_icons_veil.png" and "PASS" or "FAIL") .. " after the veil room change the sheet is " .. tostring(p))
+    lvl:RemoveCurses(1 << (veil - 1))
+    local r = other_room()
+    say("curse removed, moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 2, 0
+  elseif step == 2 and waiting == 30 then
+    local p = path()
+    say((p == "gfx/ui/minimap_icons.png" and "PASS" or "FAIL") .. " after the curse is gone the sheet is " .. tostring(p))
+    -- branch 2 again, on purpose: the sheet is something else and the global flag says Fiend Folio veiled it
+    local s = Minimap:GetIconsSprite()
+    s:ReplaceSpritesheet(0, "gfx/ui/minimap_icons_veil.png")
+    s:LoadGraphics()
+    FiendFolioMinimapIsVeiled = true
+    local r = other_room()
+    say("sheet set to the veil one by hand, flag set; moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 3, 0
+  elseif step == 3 and waiting == 30 then
+    local p = path()
+    say((p == "gfx/ui/minimap_icons.png" and FiendFolioMinimapIsVeiled == false and "PASS" or "FAIL") .. " Fiend Folio put the sheet back: " .. tostring(p) .. ", flag " .. tostring(FiendFolioMinimapIsVeiled))
+    step = 4
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_ffkeys.lua b/scripts/recomp/rgon/lab_ffkeys.lua
new file mode 100644
index 0000000..a1fd942
--- /dev/null
+++ b/scripts/recomp/rgon/lab_ffkeys.lua
@@ -0,0 +1,124 @@
+-- lab_ffkeys.lua (development only; ISAAC_RGON_LAB=lab_ffkeys.lua with Fiend Folio + StageAPI installed):
+-- Fiend Folio puzzle keys (pickup 5.752) and the coloured key blocks (StageAPI custom grids FFKeyBlock*).
+-- Chain: key collision -> key ghost familiar -> ghost flies to the block -> UseKey event -> block opens.
+-- Logs "lab_ffkeys: PASS/FAIL .." and a DONE line. Run in a start room.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab ffkeys", 1)
+local npass, nfail = 0, 0
+local function check(name, ok, detail)
+  if ok then npass = npass + 1 else nfail = nfail + 1 end
+  B.log("lab_ffkeys: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function info(s) B.log("lab_ffkeys: info " .. s) end
+
+local frame = 0
+local state = {}
+local COLORS = { { "Blue", 0 }, { "Green", 1 }, { "Red", 2 } }
+local colorIdx = 1
+local keyEnt, blockIdx, cg
+
+local function ghosts(variant)
+  local n = 0
+  for _, e in ipairs(Isaac.FindByType(3, variant, -1, false, false)) do n = n + 1 end
+  return n
+end
+
+local function setup(c)
+  local p = Isaac.GetPlayer(0)
+  local room = Game():GetRoom()
+  local ff = FiendFolio
+  local base = room:GetGridIndex(p.Position)
+  blockIdx = base + 1
+  local bpos = room:GetGridPosition(blockIdx)
+  p.Position = bpos - Vector(30, 0) -- a player against the wall is about 30 from its centre; the mod needs <= Size + 26
+  p.Velocity = Vector.Zero
+  local name = "FFKeyBlock" .. c[1]
+  local gcfg = StageAPI.CustomGridTypes[name]
+  check(c[1] .. " custom grid type registered", gcfg ~= nil)
+  if not gcfg then return end
+  cg = gcfg:Spawn(blockIdx, true, false, {})
+  check(c[1] .. " custom grid spawned with a grid entity", cg ~= nil and cg.GridEntity ~= nil,
+    cg and tostring(cg.GridEntity))
+  info(string.format("%s block idx=%d pos=%s player=%s gridtype=%s", c[1], blockIdx, tostring(bpos), tostring(p.Position),
+    cg and cg.GridEntity and tostring(cg.GridEntity:GetType()) or "nil"))
+  -- key goes onto the player (collision picks it up)
+  keyEnt = Isaac.Spawn(5, ff.PICKUP.VARIANT.PUZZLE_KEY, c[2], p.Position, Vector.Zero, nil)
+  info("key spawned " .. tostring(keyEnt.Type) .. "." .. tostring(keyEnt.Variant) .. "." .. tostring(keyEnt.SubType))
+end
+
+mod:AddCallback(ModCallbacks.MC_EVALUATE_CACHE, function() state.evalFam = (state.evalFam or 0) + 1 end, CacheFlag.CACHE_FAMILIARS)
+local t0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame == 5 then
+    check("FiendFolio + StageAPI loaded", FiendFolio ~= nil and StageAPI ~= nil)
+    check("PlayerManager.GetPlayers", type(PlayerManager.GetPlayers) == "function" and #PlayerManager.GetPlayers() >= 1)
+    local p = Isaac.GetPlayer(0)
+    local d = FiendFolio and FiendFolio.GetEntityData and FiendFolio:GetEntityData(p)
+    check("player KeyGhostData initialised", d and type(d.KeyGhostData) == "table")
+    check("player:CheckFamiliar exists", type(p.CheckFamiliar) == "function")
+    check("familiar FollowParent exists", true)
+  end
+  if frame == 10 then
+    local c = COLORS[colorIdx]
+    t0 = frame
+    setup(c)
+  end
+  if t0 and frame > t0 then
+    local c = COLORS[colorIdx]
+    local k = frame - t0
+    local p = Isaac.GetPlayer(0)
+    local gv = FiendFolio.KeyToGhostMap[c[2]]
+    if k == 20 or k == 60 then
+      local touched = keyEnt and keyEnt:Exists() and keyEnt:ToPickup().Touched
+      local anim = keyEnt and keyEnt:Exists() and keyEnt:GetSprite():GetAnimation()
+      info(string.format("%s k=%d key exists=%s touched=%s anim=%s ghosts=%d data=%d", c[1], k, tostring(keyEnt and keyEnt:Exists()),
+        tostring(touched), tostring(anim), ghosts(gv), #FiendFolio:GetEntityData(p).KeyGhostData[gv]))
+    end
+    if k == 25 then
+      check(c[1] .. " key collected (Touched / collect anim)", keyEnt:ToPickup().Touched == true)
+      check(c[1] .. " key recorded in KeyGhostData", #FiendFolio:GetEntityData(p).KeyGhostData[gv] >= 1)
+      check(c[1] .. " key ghost familiar spawned", ghosts(gv) >= 1, ghosts(gv))
+      for _, e in ipairs(Isaac.FindByType(3, gv, -1, false, false)) do
+        local f = e:ToFamiliar()
+        check(c[1] .. " ghost familiar.Player is the player", f.Player ~= nil and GetPtrHash(f.Player) == GetPtrHash(p))
+        check(c[1] .. " ghost IsFollower", f.IsFollower == true)
+        state.ghost = f
+      end
+    end
+    if k == 32 then
+      local g = Isaac.FindByType(3, gv, -1, false, false)[1]
+      check(c[1] .. " ghost bound to key (KeyGhostUpdate ran)", g ~= nil and FiendFolio:GetEntityData(g).key ~= nil,
+        g and tostring(FiendFolio:GetEntityData(g).key) or "no ghost")
+    end
+    if k >= 30 and k % 30 == 0 and k < 400 then
+      local ghost = Isaac.FindByType(3, gv, -1, false, false)[1]
+      do
+        local e1 = FiendFolio:GetEntityData(p).KeyGhostData[gv][1]
+        info(string.format("  dbg key=%s entry.Ghost=%s exists=%s ghostdata.key=%s dist=%s size=%s vel=%s", tostring(e1 and e1.Key),
+          tostring(e1 and e1.Ghost), tostring(e1 and e1.Ghost and e1.Ghost:Exists()),
+          tostring(ghost and FiendFolio:GetEntityData(ghost).key), tostring((p.Position + p.Velocity):Distance(Game():GetRoom():GetGridPosition(blockIdx))),
+          tostring(p.Size), tostring(p.Velocity)))
+      end
+      local tgt = ghost and FiendFolio:GetEntityData(ghost).target
+      info(string.format("%s k=%d grid exists=%s breakStarted=%s friend=%s ghostTarget=%s ghostpos=%s unlock=%s anim=%s", c[1], k,
+        tostring(cg:Exists()), tostring(cg.PersistentData.BreakStarted), tostring(cg.PersistentData.friend ~= nil),
+        tostring(tgt ~= nil), ghost and tostring(ghost.Position) or "-", tostring(cg.PersistentData.Unlock) .. " fc=" .. tostring(cg.PersistentData.FrameCount) .. " bd=" .. tostring(cg.PersistentData.BreakDelay),
+        cg.GridEntity and cg.GridEntity:GetSprite():GetAnimation() or "-"))
+    end
+    if k == 400 or (k > 40 and not cg:Exists()) then
+      check(c[1] .. " key block opened", not cg:Exists(), "k=" .. k)
+      local now = Game():GetRoom():GetGridEntity(blockIdx)
+      check(c[1] .. " grid wall cleared", now == nil or now:GetType() ~= GridEntityType.GRID_WALL,
+        now and tostring(now:GetType()) or "nil")
+      colorIdx = colorIdx + 1
+      t0 = nil
+      if colorIdx <= #COLORS then t0 = frame + 5 - 10; frame = frame; setup(COLORS[colorIdx]); t0 = frame
+      else
+        B.log(string.format("lab_ffkeys: DONE %d pass, %d fail", npass, nfail))
+      end
+    end
+  end
+end)
+B.log("lab_ffkeys: listening")
diff --git a/scripts/recomp/rgon/lab_game_misc.lua b/scripts/recomp/rgon/lab_game_misc.lua
new file mode 100644
index 0000000..3b56ad9
--- /dev/null
+++ b/scripts/recomp/rgon/lab_game_misc.lua
@@ -0,0 +1,335 @@
+-- lab_game_misc.lua (development only; LAB=lab_game_misc.lua, chunk 7): every name of api_game_misc.lua (and the setters added to
+-- api_eid.lua) is called in the start room and read back. Lines: "lab_game_misc: PASS|FAIL <name> <detail>" and a last
+-- "DONE pass=N fail=M". The last steps change the floor (StartStageTransition) and the room (MoveToRandomRoom), so they come last.
+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32, call = B.r32, B.ri32, B.rf32, B.w32, B.call
+local mod = RegisterMod("rgon lab game misc", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_game_misc: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function note(s) B.log("lab_game_misc: note " .. s) end
+local function near(a, b, e) return type(a) == "number" and math.abs(a - b) <= (e or 0.001) end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, "error: " .. tostring(err)) end
+end
+local started, frame = false, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+
+local g = Game()
+local state = {}
+
+local function names()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs({ "REPENTOGON.MeetsVersion", "WeightedOutcomePicker.WeightedOutcomePicker", "RNG.RandomVector", "RNG.PhantomVector",
+    "Game.AddDebugFlags", "Game.IsRerun", "Game.GetDizzyAmount", "Game.SetDizzyAmount", "Game.IsErased", "Game.GetCurrentColorModifier",
+    "Game.GetTargetColorModifier", "Game.GetLerpColorModifier", "Game.SetColorModifier", "Game.DevolveEnemy", "Game.ChainLightning",
+    "Game.MoveToRandomRoom", "Isaac.GetCurrentStageConfigId", "Isaac.RenderToWorld",
+    "Isaac.AllTaintedCompletion", "Isaac.ClearChallenge", "Isaac.UnClearChallenge", "Isaac.IsChallengeDone", "Isaac.SetChallengeCompletion",
+    "ItemOverlay.Show", "ItemOverlay.GetOverlayID", "ItemOverlay.GetDelay", "ItemOverlay.GetSprite", "ItemOverlay.GetPlayer",
+    "ItemOverlay.GetMegaMushPlayerSprite", "MusicManager.PlayJingle", "MusicManager.StopJingle",
+    "BossPoolManager.GetPool", "BossPoolManager.GetRemovedBosses", "BossPool.GetEntries", "BossPool.GetName", "BossPool.GetWeight", "BossPool.GetRNG",
+    "EntitiesSaveState.GetF1", "EntitiesSaveState.SetPos", "EntitySaveState.GetF1", "EntitySaveState.GetF2", "EntitySaveState.GetPos", "EntitySaveState.GetSubType", "EntitySaveState.SetPos" }) do
+    check("Implemented " .. n, I[n] == true)
+  end
+end
+
+local function simple()
+  try("MeetsVersion", function()
+    check("MeetsVersion old", REPENTOGON.MeetsVersion("1.0.0") == true)
+    check("MeetsVersion future", REPENTOGON.MeetsVersion("9.0.0") == false)
+  end)
+  try("WeightedOutcomePicker", function()
+    local p = WeightedOutcomePicker()
+    p:AddOutcomeWeight(7, 1)
+    check("WeightedOutcomePicker ctor", p:GetNumOutcomes() == 1 and p:PickOutcome(RNG()) == 7)
+  end)
+  try("RandomVector", function()
+    local a, b = RNG(), RNG()
+    a:SetSeed(12345, 35) b:SetSeed(12345, 35)
+    local pv = a:PhantomVector()
+    check("PhantomVector keeps the seed", a:GetSeed() == 12345)
+    local v1 = a:RandomVector()
+    local v2 = b:RandomVector()
+    check("RandomVector unit length", near(v1:Length(), 1, 0.001), v1:Length())
+    check("RandomVector deterministic", near(v1.X, v2.X, 1e-6) and near(v1.Y, v2.Y, 1e-6) and near(pv.X, v1.X, 1e-6))
+    check("RandomVector moves the generator", a:GetSeed() ~= 12345)
+    local v3 = a:RandomVector()
+    check("RandomVector next differs", not (near(v1.X, v3.X, 1e-6) and near(v1.Y, v3.Y, 1e-6)))
+    -- spread: 200 draws cover every quadrant
+    local q = {}
+    for _ = 1, 200 do local v = a:RandomVector() q[(v.X >= 0 and 1 or 0) + (v.Y >= 0 and 2 or 0)] = true end
+    check("RandomVector covers the circle", q[0] and q[1] and q[2] and q[3])
+  end)
+  try("RandomInt", function()
+    local r = RNG()
+    r:SetSeed(777, 35)
+    local ok = true
+    for _ = 1, 50 do local v = r:RandomInt(10) if v < 0 or v >= 10 then ok = false end end
+    check("RNG:RandomInt in range", ok)
+  end)
+end
+
+local function game_fields()
+  try("DebugFlags", function()
+    local before = g:GetDebugFlags()
+    g:AddDebugFlags(DebugFlag and DebugFlag.INFINITE_HP or 2)
+    local after = g:GetDebugFlags()
+    check("AddDebugFlags sets the bit", after & 2 == 2 or after ~= before, after)
+    w32(B.ptr(g) + 0x26544, before)
+    check("debug flags restored", g:GetDebugFlags() == before)
+  end)
+  try("IsRerun", function() check("IsRerun false in a normal run", g:IsRerun() == false) end)
+  try("Dizzy", function()
+    g:SetDizzyAmount(0.5, 0.25)
+    check("SetDizzyAmount current", near(g:GetDizzyAmount(), 0.25), g:GetDizzyAmount())
+    check("SetDizzyAmount target field", near(rf32(B.ptr(g) + 0x6773c), 0.5))
+    state.dizzy = true
+  end)
+  try("Erased", function()
+    local gaper = Isaac.Spawn(10, 0, 0, g:GetRoom():GetCenterPos(), Vector(0, 0), nil)
+    check("IsErased before", g:IsErased(gaper) == false and g:IsErased(10, 0) == false)
+    call(0x00707840, nil, B.ptr(gaper))          -- the game's own AddErasedEnemy(Entity*), `ret 4`
+    check("IsErased(entity)", g:IsErased(gaper) == true)
+    check("IsErased(type, variant)", g:IsErased(10, 0) == true and g:IsErased(10) == true)
+    note("IsErased(10, 1) = " .. tostring(g:IsErased(10, 1)))
+    check("IsErased other type", g:IsErased(11, 0) == false)
+    local begin, e = r32(B.ptr(g) + 0x6774c), r32(B.ptr(g) + 0x67750)
+    check("erased vector holds one 12-byte record", e - begin == 12 and ri32(begin) == 10, e - begin)
+    w32(B.ptr(g) + 0x67750, begin)                -- empty the list again
+    check("IsErased after clearing", g:IsErased(gaper) == false)
+    gaper:Remove()
+  end)
+  try("DevolveEnemy", function()
+    local e = Isaac.Spawn(10, 0, 0, g:GetRoom():GetCenterPos() + Vector(60, 0), Vector(0, 0), nil)
+    g:DevolveEnemy(e)
+    check("DevolveEnemy ran", true)
+    local ok = pcall(function() g:DevolveEnemy(nil) end)
+    check("DevolveEnemy rejects nil", ok == false)
+    e:Remove()
+  end)
+  try("ChainLightning", function()
