+-- lab_render_probe.lua (development only; ISAAC_RGON_LAB=lab_render_probe.lua): probes SetOverlayFrame, IsFinished
+-- while stopped, and where Font's methods live. Notes in notes/render.md.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab render probe", 1)
+local function log(s) B.log("lab_render_probe: " .. s) end
+local function keys(t)
+  local out = {}
+  if type(t) == "table" then for k in pairs(t) do out[#out + 1] = tostring(k) end end
+  table.sort(out)
+  return table.concat(out, ",")
+end
+local done = false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if done then return end
+  done = true
+  local o = Sprite()
+  o:Load("gfx/001.000_player.anm2", true)
+  o:Play("WalkDown", true)
+  o:PlayOverlay("HeadDown", true)
+  local a = B.ptr(o)
+  local function st(tag)
+    log(tag .. ": overlay anim '" .. o:GetOverlayAnimation() .. "' frame " .. o:GetOverlayFrame() .. " playing " .. tostring(o:IsOverlayPlaying("HeadDown"))
+      .. " byte " .. B.r8(a + 0x64) .. " finishedQ " .. tostring(o:IsOverlayFinished("HeadDown")) .. " rec " .. string.format("%x", B.r32(a + 0x54)))
+  end
+  st("start")
+  o:SetOverlayFrame("HeadDown", 3) st("SetOverlayFrame(name,3)")
+  o:Update() st("update")
+  o:SetOverlayFrame(7) st("SetOverlayFrame(7)")
+  o:SetOverlayFrame("HeadDown", 7) st("SetOverlayFrame(name,7)")
+  o:SetOverlayFrame(5) st("SetOverlayFrame(5)")
+  B.w8(a + 0x64, 1) o:Update() st("byte 1, update")
+  local m = Sprite()
+  m:Load("gfx/001.000_player.anm2", true)
+  m:Play("WalkDown", true)
+  m:Update() m:Update()
+  log("IsFinished while playing mid-way " .. tostring(m:IsFinished("WalkDown")))
+  m:Stop()
+  log("IsFinished while stopped mid-way " .. tostring(m:IsFinished("WalkDown")) .. " length " .. m:GetCurrentAnimationData():GetLength() .. " loops " .. tostring(m:GetCurrentAnimationData():IsLoopingAnimation()))
+  -- Font
+  local f = Font()
+  local mt = getmetatable(f)
+  log("Font metatable keys " .. keys(mt))
+  log("Font __index type " .. type(mt and mt.__index) .. " keys " .. keys(type(mt and mt.__index) == "table" and mt.__index or nil))
+  log("Font global type " .. type(Font) .. " keys " .. keys(Font) .. " mt keys " .. keys(getmetatable(Font)))
+  local c = T.class_tables("Font")
+  log("class_tables Font " .. tostring(c) .. " keys " .. keys(c))
+  local cls = mt and rawget(mt, "__class")
+  log("__class keys " .. keys(cls))
+  log("Implemented Font names: " .. (function() local o = {} for k in pairs(REPENTOGON.Implemented) do if tostring(k):find("^Font%.") then o[#o + 1] = k end end table.sort(o) return table.concat(o, ",") end)())
+  -- ReplaceSpritesheet third argument
+  local r = Sprite()
+  r:Load("gfx/001.000_player.anm2", true)
+  r:ReplaceSpritesheet(0, "gfx/characters/costumes/character_002_magdalene.png", true)
+  log("ReplaceSpritesheet(…, true) path " .. r:GetLayer(0):GetSpritesheetPath())
+  -- the layer state's class
+  local l = r:GetLayer(0)
+  local lmt = getmetatable(l)
+  log("LayerState metatable keys " .. keys(lmt) .. " __index type " .. type(lmt and lmt.__index))
+end)
