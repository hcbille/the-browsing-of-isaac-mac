index 0000000..d638f6b
--- /dev/null
+++ b/scripts/recomp/rgon/lab_misc_b.lua
@@ -0,0 +1,101 @@
+-- lab_misc_b.lua (development only; LAB=lab_misc_b.lua): every name of api_misc_b.lua is called and read back.
+-- Lines: "lab_misc_b: PASS|FAIL <name> <detail>", and a last "lab_misc_b: DONE pass=N fail=M".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab misc b", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_misc_b: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, "error: " .. tostring(err)) end
+end
+local frame, stage = 0, "wait"
+local spike, gaper, hp0
+
+local function spawn_grid(kind, dx)
+  local room, p = Game():GetRoom(), Isaac.GetPlayer(0)
+  local pos = room:FindFreePickupSpawnPosition(p.Position + Vector(dx, 0), 0, true)
+  Isaac.GridSpawn(kind, 0, pos, true)
+  return room:GetGridEntity(room:GetGridIndex(pos)), pos
+end
+
+local function first_part()
+  local I = REPENTOGON.Implemented
+  for _, n in ipairs({ "RoomDescriptor.GetGroup", "RoomDescriptor.SetGroup", "GridEntity.HurtDamage" }) do
+    check("Implemented " .. n, I[n] == true)
+  end
+  -- names left out on purpose (no engine function located): they must not claim to be implemented
+  for _, n in ipairs({ "EntityPlayer.ShuffleCostumes", "EntityNPC.ThrowMaggot",
+    "FXLayers.AddPoopFx", "GridEntity.SetWaterClipFlags", "GridEntity.ResetWaterClipFlags" }) do
+    check("not Implemented (deferred) " .. n, I[n] ~= true)
+  end
+  local level = Game():GetLevel()
+  local desc = level:GetCurrentRoomDesc()
+  try("GetGroup", function()
+    check("GetGroup default is GROUP_NONE", desc:GetGroup() == -1, desc:GetGroup())
+  end)
+  try("SetGroup", function()
+    desc:SetGroup(77)
+    check("SetGroup read-back", desc:GetGroup() == 77, desc:GetGroup())
+    check("SetGroup wrote +0xb4", B.ri32(B.ptr(desc) + 0xb4) == 77)
+    desc:SetGroup(RoomGroup and RoomGroup.GROUP_NONE or -1)
+    check("SetGroup restore", desc:GetGroup() == -1)
+    local ok = pcall(desc.SetGroup, desc, "x")
+    check("SetGroup rejects a string", not ok)
+  end)
+  try("HurtDamage setup", function()
+    local p = Isaac.GetPlayer(0)
+    spike = spawn_grid(GridEntityType.GRID_SPIKES, 80)
+    check("spikes spawned", spike ~= nil)
+    gaper = Isaac.Spawn(EntityType.ENTITY_GAPER, 0, 0, p.Position + Vector(0, 80), Vector(0, 0), nil)
+    gaper:AddEntityFlags(EntityFlag.FLAG_FREEZE)
+    hp0 = gaper.HitPoints
+    check("HurtDamage has the method", spike.HurtDamage ~= nil)
+    spike:HurtDamage(gaper, 1, 0, 5.0, true)
+    local bad = pcall(spike.HurtDamage, spike, nil, 1, 0, 1.0, true)
+    check("HurtDamage rejects a nil entity", not bad)
+    bad = pcall(spike.HurtDamage, spike, gaper, 1, 0, 1.0, nil)
+    check("HurtDamage rejects a missing bool", not bad)
+  end)
+end
+
+local function second_part()
+  try("HurtDamage effect", function()
+    check("enemy lost hit points to the grid's damage", gaper.HitPoints < hp0, hp0 .. " -> " .. gaper.HitPoints)
+  end)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_NEW_LEVEL, function()
+  if stage ~= "level" then return end
+  try("Ultra secret group", function()
+    local rooms = Game():GetLevel():GetRooms()
+    local found
+    for i = 0, rooms.Size - 1 do
+      local d = rooms:Get(i)
+      if d.Data.Type == 29 then found = d end
+      if d.Data.Type ~= 29 and d:GetGroup() ~= -1 then check("group of room " .. i, false, d:GetGroup()) end
+    end
+    check("Ultra Secret Room has group 99 through GetGroup", found ~= nil and found:GetGroup() == 99, found and found:GetGroup())
+  end)
+  stage = "end"
+  frame = 0
+end)
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if stage == "wait" and frame == 40 then
+    local ok, err = pcall(first_part)
+    if not ok then check("first part", false, err) end
+    stage, frame = "hurt", 0
+  elseif stage == "hurt" and frame == 40 then
+    local ok, err = pcall(second_part)
+    if not ok then check("second part", false, err) end
+    stage, frame = "level", 0
+    Isaac.ExecuteCommand("stage 3")
+  elseif stage == "end" and frame == 20 then
+    B.log("lab_misc_b: DONE pass=" .. pass .. " fail=" .. fail)
+    stage = "over"
+  end
+end)
