+local T = ...
+local B = T.B
+local r32, ri32, rf32, w32, r8 = B.r32, B.ri32, B.rf32, B.w32, B.r8
+local mod = RegisterMod("rgon lab b2probe3", 1)
+local LO, HI = 0x1300, 0x2c00
+local function say(s) B.log("lab_b2probe3: " .. s) end
+local function snap(a)
+  local t = {}
+  for o = LO, HI - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local SKIP = { [0x1b38] = true, [0x1ea0] = true, [0x1f98] = true }
+local function diff(name, a, before)
+  local n = 0
+  for o = LO, HI - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not SKIP[o] then
+      n = n + 1
+      if n <= 40 then say(string.format("%s +%04x %08x -> %08x (%d -> %d, f %g -> %g)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now, B.i2f(before[o]), B.i2f(now))) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local frame, held = 0, {}
+local S
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if held[action] and ent and ent.Type == 1 then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+local function kn(e)
+  local k = B.ptr(e)
+  return string.format("%08x v%d +465 %02x%02x +4e5 %02x%02x%02x +4ea %02x +444 %g +448 %g", k, ri32(k + 0x2c), r8(k + 0x465), r8(k + 0x466), r8(k + 0x4e5), r8(k + 0x4e6), r8(k + 0x4e7), r8(k + 0x4ea), rf32(k + 0x444), rf32(k + 0x448))
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  local a = B.ptr(p)
+  if frame == 5 then
+    p:AddCollectible(CollectibleType.COLLECTIBLE_MARKED, 0, false)
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  elseif frame == 40 then
+    local m = r32(a + 0x140c)
+    say(string.format("+140c = %08x", m))
+    if m ~= 0 then say(string.format("  type %d variant %d subtype %d; the game's FindByType(1000,30) has %d", ri32(m + 0x28), ri32(m + 0x2c), ri32(m + 0x30), #Isaac.FindByType(1000, 30))) end
+    local w = r32(a + 0x13e0)
+    say(string.format("weapon direction %g %g, fireDelay %g maxFireDelay %g charge %g numFired %d", rf32(w + 0x20), rf32(w + 0x24), rf32(w + 0xc), rf32(w + 0x10), rf32(w + 0x14), ri32(w + 0x38)))
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+  elseif frame == 60 then
+    say(string.format("after shooting stopped: +140c = %08x, FindByType(1000,30) %d", r32(a + 0x140c), #Isaac.FindByType(1000, 30)))
+    -- Suplex!
+    p:AddCollectible(CollectibleType.COLLECTIBLE_SUPLEX, 0, false)
+    local g = Isaac.Spawn(10, 0, 0, p.Position + Vector(120, 0), Vector(0, 0), nil)
+    g:ToNPC().Mass = 10
+    say(string.format("Suplex active slot item %d charge %d", p:GetActiveItem(0), p:GetActiveCharge(0)))
+    S = snap(a)
+  elseif frame == 70 then
+    p:SetActiveCharge(12, 0)
+    p:UseActiveItem(CollectibleType.COLLECTIBLE_SUPLEX, 0, 0)
+    held[ButtonAction.ACTION_ITEM] = true
+  elseif frame >= 71 and frame <= 130 and frame % 6 == 1 then
+    diff("Suplex f" .. frame, a, S)
+    S = snap(a)
+    if frame == 79 then held[ButtonAction.ACTION_ITEM] = nil end
+  elseif frame == 140 then
+    -- the Forgotten and its bone club
+    p:ChangePlayerType(PlayerType.PLAYER_THEFORGOTTEN)
+  elseif frame == 150 then
+    local p2 = Isaac.GetPlayer(0)
+    say("player type now " .. p2:GetPlayerType())
+    held[ButtonAction.ACTION_SHOOTRIGHT] = true
+  elseif frame > 150 and frame <= 200 then
+    for _, e in ipairs(Isaac.FindByType(8)) do if frame % 3 == 0 then say("f" .. frame .. " knife " .. kn(e)) end end
+  elseif frame == 201 then
+    held[ButtonAction.ACTION_SHOOTRIGHT] = nil
+    say("DONE")
+  end
+end)
