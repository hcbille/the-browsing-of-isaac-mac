@@ -0,0 +1,90 @@
+-- lab_shape_test.lua (development only; ISAAC_RGON_LAB=lab_shape_test.lua, census batch B2): Capsule constructor and
+-- getters, Shape (DebugRenderer.Get), Isaac.FindInCapsule. Logs "lab_shape_test: PASS/FAIL ..", then a final count line.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab shape test", 1)
+local pass, fail = 0, 0
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log("lab_shape_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function near(a, b) return math.abs(a - b) < 1e-4 end
+local function is(v, x, y) return type(v) == "userdata" and near(v.X, x) and near(v.Y, y) end
+local function has(list, ent)
+  for _, e in ipairs(list) do if GetPtrHash(e) == GetPtrHash(ent) then return true end end
+  return false
+end
+local done = false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if done then return end
+  done = true
+  for _, n in ipairs({ "Capsule", "Capsule.Capsule", "Capsule.GetPosition", "Capsule.GetDirection", "Capsule.GetF1", "Capsule.GetF2",
+    "Capsule.GetVec2", "Capsule.GetVec3", "Isaac.FindInCapsule" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  for _, n in ipairs({ "Shape", "Shape.Capsule", "Shape.Circle", "Shape.GetTimeout", "Shape.SetTimeout", "DebugRenderer", "DebugRenderer.Get" }) do
+    check("stand-in not Implemented " .. n, REPENTOGON.Implemented[n] == nil)
+  end
+
+  -- three-argument form: start, end, radius
+  local c = Capsule(Vector(0, 0), Vector(100, 0), 10)
+  check("ctor3 position", is(c:GetPosition(), 50, 0))
+  check("ctor3 start GetVec2", is(c:GetVec2(), 0, 0))
+  check("ctor3 end GetVec3", is(c:GetVec3(), 100, 0))
+  check("ctor3 direction", is(c:GetDirection(), 1, 0))
+  check("ctor3 GetF1 radius", c:GetF1() == 10)
+  check("ctor3 GetF2 half length", c:GetF2() == 50)
+  check("ctor3 GetStartPoint/GetEndPoint/GetSize/GetSizeDifference", is(c:GetStartPoint(), 0, 0) and is(c:GetEndPoint(), 100, 0) and c:GetSize() == 10 and c:GetSizeDifference() == 50)
+  local d = Capsule(Vector(0, 30), Vector(40, 0), 5)
+  check("ctor3 diagonal", is(d:GetPosition(), 20, 15) and is(d:GetDirection(), 0.8, -0.6) and near(d:GetF2(), 25))
+  local p = Capsule(Vector(7, 7), Vector(7, 7), 12)
+  check("ctor3 point capsule", is(p:GetPosition(), 7, 7) and p:GetF2() == 0 and p:GetF1() == 12 and is(p:GetDirection(), 0, 0))
+  -- getters hand out copies
+  local v = c:GetPosition()
+  v.X = 999
+  check("getter is a copy", is(c:GetPosition(), 50, 0))
+  -- the capsule does not follow the vectors it was made from
+  local s = Vector(0, 0)
+  local c2 = Capsule(s, Vector(10, 0), 1)
+  s.X = 500
+  check("ctor copies its vectors", is(c2:GetVec2(), 0, 0))
+
+  -- four-argument form: position, multiplier, rotation, size
+  local h = Capsule(Vector(10, 10), Vector(2, 1), 0, 5)
+  check("ctor4 stretched in x", near(h:GetF1(), 5) and near(h:GetF2(), 5) and is(h:GetVec2(), 5, 10) and is(h:GetVec3(), 15, 10) and is(h:GetPosition(), 10, 10) and is(h:GetDirection(), 1, 0))
+  local r = Capsule(Vector(10, 10), Vector(2, 1), 90, 5)
+  check("ctor4 rotated 90", is(r:GetVec2(), 10, 5) and is(r:GetVec3(), 10, 15) and is(r:GetDirection(), 0, 1))
+  local round = Capsule(Vector(0, 0), Vector(1, 1), 0, 8)
+  check("ctor4 round", round:GetF1() == 8 and round:GetF2() == 0)
+
+  -- bad arguments
+  check("ctor with a number for a Vector errors", not pcall(Capsule, 1, Vector(0, 0), 1))
+  check("ctor without a radius errors", not pcall(Capsule, Vector(0, 0), Vector(1, 1)))
+  check("FindInCapsule with a non-Capsule errors", not pcall(Isaac.FindInCapsule, Vector(0, 0)))
+
+  -- Shape
+  local sh = DebugRenderer.Get(1234, true)
+  check("Shape timeout starts at 0", sh:GetTimeout() == 0)
+  sh:SetTimeout(45)
+  check("Shape SetTimeout/GetTimeout", sh:GetTimeout() == 45 and DebugRenderer.Get(1234, false):GetTimeout() == 45)
+  check("Shape:Capsule accepts a capsule", pcall(sh.Capsule, sh, c))
+  check("Shape:Circle accepts a position and size", pcall(sh.Circle, sh, Vector(1, 1), 4))
+  check("Shape:Capsule with a Vector errors", not pcall(sh.Capsule, sh, Vector(0, 0)))
+  check("Shape:Circle without a size errors", not pcall(sh.Circle, sh, Vector(1, 1)))
+
+  -- FindInCapsule against the player
+  local pl = Isaac.GetPlayer(0)
+  local pos = pl.Position
+  local over = Capsule(pos - Vector(50, 0), pos + Vector(50, 0), 10)
+  check("FindInCapsule finds the player under the capsule", has(Isaac.FindInCapsule(over), pl))
+  local clip = Capsule(pos + Vector(pl.Size + 5, 0), pos + Vector(pl.Size + 60, 0), 5)
+  check("FindInCapsule finds the player by its edge", has(Isaac.FindInCapsule(clip), pl), pl.Size)
+  local away = Capsule(pos + Vector(300, 0), pos + Vector(400, 0), 10)
+  check("FindInCapsule misses the player when the capsule is away", not has(Isaac.FindInCapsule(away), pl))
+  local off = Capsule(pos + Vector(pl.Size + 40, 0), pos + Vector(pl.Size + 140, 0), 10)
+  check("FindInCapsule misses a capsule that stops short", not has(Isaac.FindInCapsule(off), pl))
+  check("FindInCapsule with a partition that has no player", not has(Isaac.FindInCapsule(over, EntityPartition.ENEMY), pl))
+  check("FindInCapsule with the player partition", has(Isaac.FindInCapsule(over, EntityPartition.PLAYER), pl))
+
+  B.log(string.format("lab_shape_test: DONE %d PASS %d FAIL", pass, fail))
+end)
