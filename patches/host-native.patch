new file mode 100644
index 0000000..06b7d1c
--- /dev/null
+++ b/scripts/recomp/rgon/api_batch_three.lua
@@ -0,0 +1,348 @@
+-- api_batch_three.lua -- census batch 3 (M8). Written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp);
+-- everything below was measured in THIS executable (v1.9.7.17) in a running game (lab_b3probe.lua and later
+-- probes), and is checked by lab_batch3_test.lua.
+--
+--   Weapon      REPENTOGON         here
+--   GetDirection  Vector at +0x20  the same: (1,0) while firing right, (0,-1) up, for the weapons that keep one
+--                                  (Brimstone, Monstro's Lung, Chocolate Milk, charge weapons); the plain tear
+--                                  weapon never writes it (0,0)
+--   GetMaxCharge  vtable slot 6    the same slot; the float comes back in st0 (the bridge's second result):
+--                                  tears 0, Brimstone 32 (the charge field climbs to 32 and stops), Monstro's
+--                                  Lung 46.3, Chocolate Milk 26.5
+--   GetMainEntity vtable slot 10   the same slot: `mov eax, [ecx+0x48]; ret` for Brimstone's weapon (its laser),
+--                                  `xor eax, eax; ret` for the plain tear weapon
+
+local T = ...
+local B, R, wrap, method, this = T.B, T.R, T.wrap, T.method, T.this
+local r32, rf32, call = B.r32, B.rf32, B.call
+local type, getmetatable, pairs, ipairs = type, getmetatable, pairs, ipairs
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+------------------------------------------------------------------------------
+-- Room placement queries: Level CanPlaceRoom, CanPlaceRoomAtDoor, FindValidRoomPlacementLocations,
+-- GetNeighboringRooms; RoomDescriptor GetNeighboringRooms, GetValidNeighborPlacementLocations
+------------------------------------------------------------------------------
+-- REPENTOGON's RoomPlacement.cpp is plain code over the game's own level-generator helpers; the four it calls
+-- are called here by address (each prefix checked against REPENTOGON's signature, lab_b3probe2.lua; v1.9.7.17):
+--   0x009afdb0  get_room_placement_offsets(shape<ecx>) -> int**  the cells a shape covers, (x,y) pairs, -1 ends
+--   0x009af3f0  get_door_source_position(out<ecx>, pos<edx>, shape, slot)   the cell a door leaves from
+--   0x009af620  get_door_target_position(out<ecx>, pos<edx>, shape, slot, unk)   the cell it leads to
+--   0x009af370  has_shape_slot(shape<ecx>, slot<edx>, ignore_thin) -> bool
+-- The rest is the vanilla API: Level:GetRoomByIdx (a descriptor with Data nil for an empty cell), the
+-- descriptor's GridIndex, Data.Type/Shape/Doors, Level:GetStartingRoomIndex, HasPhotoDoor and GetStage.
+-- TryPlaceRoom and TryPlaceRoomAtDoor are not here: they need the game's own PlaceRoom, whose REPENTOGON
+-- signature matches nothing in this exe.
+do
+  local OFFSETS, SOURCE, TARGET, HAS_SLOT = 0x009afdb0, 0x009af3f0, 0x009af620, 0x009af370
+  local ri32, w32, floor = B.ri32, B.w32, math.floor
+  local buf_out, buf_pos
+  local function buffers()
+    if not buf_out then buf_out, buf_pos = B.alloc(16), B.alloc(16) end
+    return buf_out, buf_pos
+  end
+  local NORMAL = { [2] = 1, [3] = 1, [5] = 4, [7] = 6 }   -- thin shapes count as their wider kind when fitting
+
+  -- the door of a room of `shape` at grid index `idx`: source cell, target cell, or nil when it is not a valid link
+  local function door_link(idx, shape, slot, normalize)
+    if normalize then shape = NORMAL[shape] or shape end
+    local out, pos = buffers()
+    w32(pos, idx % 13) w32(pos + 4, idx // 13)
+    call(SOURCE, { ecx = out, edx = pos }, shape, slot)
+    local sx, sy = ri32(out), ri32(out + 4)
+    call(TARGET, { ecx = out, edx = pos }, shape, slot, 0)
+    local tx, ty = ri32(out), ri32(out + 4)
+    if sx > -1 and sx < 13 and sy > -1 and sy < 13 and tx > -1 and tx < 13 and ty > -1 and ty < 13
+        and (sx == tx or sy == ty) and (math.abs(sx - tx) == 1 or math.abs(sy - ty) == 1) then
+      return sx, sy, tx, ty
+    end
+    return nil
+  end
+  local function room_at(level, idx, dim)
+    local d = level:GetRoomByIdx(idx, dim)
+    if d ~= nil and d.Data ~= nil then return d end
+    return nil
+  end
+  local function neighbors(level, idx, shape, dim)
+    local out = {}
+    for slot = 0, 7 do
+      local sx, sy, tx, ty = door_link(idx, shape, slot, true)
+      if sx then
+        local n = room_at(level, ty * 13 + tx, dim)
+        if n then out[slot] = n end
+      end
+    end
+    return out
+  end
+  local function can_place(level, shape, door_mask, col, line, dim, multi, special, none)
+    if col < 0 or col > 12 or line < 0 or line > 12 or shape < 1 or shape > 12 then return false end
+    local arr = r32((call(OFFSETS, { ecx = shape })))
+    for i = 0, 3 do
+      local x, y = ri32(arr + 8 * i), ri32(arr + 8 * i + 4)
+      if x == -1 or y == -1 then break end
+      if x < 0 or y < 0 or x > 1 or y > 1 then return false end
+      local ncol, nline = col + x, line + y
+      if ncol > 12 or nline > 12 then return false end
+      if room_at(level, nline * 13 + ncol, dim) then return false end
+    end
+    local idx = line * 13 + col
+    local near = neighbors(level, idx, shape, dim)
+    local any = next(near) ~= nil
+    if not none and not any then return false end
+    if door_mask < 0 then
+      door_mask = 0
+      for slot = 0, 7 do
+        if (call(HAS_SLOT, { ecx = shape, edx = slot }, 0) & 0xff) ~= 0 then door_mask = door_mask | (1 << slot) end
+      end
+    end
+    local doors, secret, plain = 0, false, false
+    for slot = 0, 7 do
+      local n = near[slot]
+      if n then
+        if (door_mask & (1 << slot)) == 0 then return false end
+        local ntype = n.Data.Type
+        if ntype == 5 then return false end
+        if not special and ntype > 1 and ntype ~= 7 then return false end
+        local ssx, ssy, stx, sty = door_link(idx, shape, slot, true)
+        local connect = false
+        local base = (slot + 2) % 4
+        for _, back in ipairs({ base, base + 4 }) do
+          if (n.Data.Doors & (1 << back)) ~= 0 then
+            local rsx, rsy, rtx, rty = door_link(n.GridIndex, n.Data.Shape, back, true)
+            if rsx and ssx and (ssy * 13 + ssx) == (rty * 13 + rtx) and (sty * 13 + stx) == (rsy * 13 + rsx) then
+              local forbidden = back == 1 and n.GridIndex == level:GetStartingRoomIndex() and (level:HasPhotoDoor() or level:GetStage() == 11)
+              if not forbidden then connect = true end
+              break
+            end
+          end
+        end
+        if not connect then return false end
+        if ntype == 7 or ntype == 8 then secret = true else plain = true doors = doors + 1 end
+      end
+    end
+    if not multi and doors > 1 then return false end
+    if secret and not plain and not special then return false end
+    return true
+  end
+  -- the cells a room of `shape` could take to hang off door `slot` of `room`
+  local function placements_at_door(shape, room, slot)
+    local out = {}
+    if room.Data ~= nil and (room.Data.Doors & (1 << slot)) ~= 0 then
+      local _, _, tx, ty = door_link(room.GridIndex, room.Data.Shape, slot, false)
+      if tx then
+        local base = (slot + 2) % 4
+        for _, back in ipairs({ base, base + 4 }) do
+          local rsx, rsy = door_link(ty * 13 + tx, shape, back, false)
+          if rsx then out[#out + 1] = { tx + (tx - rsx), ty + (ty - rsy) } end
+        end
+      end
+    end
+    return out
+  end
+  local function neighbor_locations(level, room, shape, door_mask, dim, multi, special, into)
+    for slot = 0, 7 do
+      for _, c in ipairs(placements_at_door(shape, room, slot)) do
+        if can_place(level, shape, door_mask, c[1], c[2], dim, multi, special, false) then into[c[2] * 13 + c[1]] = true end
+      end
+    end
+  end
+  local function sorted(set)
+    local out = {}
+    for k in pairs(set) do out[#out + 1] = k end
+    table.sort(out)
+    return out
+  end
+
+  -- argument readers, as REPENTOGON's: a RoomConfigRoom, or a shape and an optional door mask (default -1)
+  local function bool_opt(v, n, what, default)
+    if v == nil then return default end
+    if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. what .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+    return v
+  end
+  local function int_opt(v, n, what, default)
+    if v == nil then return default end
+    return int_arg(v, n, what)
+  end
+  local function dim_arg(v, n, what)
+    local d = int_opt(v, n, what, -1)
+    if d < -1 or d > 2 then error("bad argument #" .. n .. " to '" .. what .. "' (Invalid Dimension)", 3) end
+    return d
+  end
+  local function current_dim(level)
+    return level:GetDimension()
+  end
+  local L = "Level"
+  method(L, "GetNeighboringRooms", function(self, grid_index, shape, dim)
+    this(self, "GetNeighboringRooms")
+    grid_index, shape = int_arg(grid_index, 1, "GetNeighboringRooms"), int_arg(shape, 2, "GetNeighboringRooms")
+    return neighbors(self, grid_index, shape, dim_arg(dim, 3, "GetNeighboringRooms"))
+  end)
+  method(L, "CanPlaceRoom", function(self, a, b, c, d, e, f, g, h)
+    this(self, "CanPlaceRoom")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d, e, f }
+    else shape = int_arg(a, 1, "CanPlaceRoom") mask = int_opt(b, 2, "CanPlaceRoom", -1) args = { c, d, e, f, g } end
+    local grid_index = int_arg(args[1], 3, "CanPlaceRoom")
+    if grid_index < 0 or grid_index > 168 then return false end
+    local dim = dim_arg(args[2], 4, "CanPlaceRoom")
+    return can_place(self, shape, mask, grid_index % 13, grid_index // 13, dim, bool_opt(args[3], 5, "CanPlaceRoom", true),
+      bool_opt(args[4], 6, "CanPlaceRoom", false), bool_opt(args[5], 7, "CanPlaceRoom", false))
+  end)
+  method(L, "CanPlaceRoomAtDoor", function(self, a, b, c, d, e, f)
+    this(self, "CanPlaceRoomAtDoor")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d, e }
+    else shape = int_arg(a, 1, "CanPlaceRoomAtDoor") mask = int_opt(b, 2, "CanPlaceRoomAtDoor", -1) args = { c, d, e, f } end
+    local room = args[1]
+    if type(room) ~= "userdata" then error("bad argument to 'CanPlaceRoomAtDoor' (RoomDescriptor expected, got " .. type(room) .. ")", 2) end
+    local slot = int_arg(args[2], 4, "CanPlaceRoomAtDoor")
+    local multi, special = bool_opt(args[3], 5, "CanPlaceRoomAtDoor", true), bool_opt(args[4], 6, "CanPlaceRoomAtDoor", false)
+    local dim = room:GetDimension()
+    for _, c2 in ipairs(placements_at_door(shape, room, slot)) do
+      if can_place(self, shape, mask, c2[1], c2[2], dim, multi, special, false) then return true end
+    end
+    return false
+  end)
+  method(L, "FindValidRoomPlacementLocations", function(self, a, b, c, d, e)
+    this(self, "FindValidRoomPlacementLocations")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d }
+    else shape = int_opt(a, 1, "FindValidRoomPlacementLocations", 1) mask = int_opt(b, 2, "FindValidRoomPlacementLocations", -1) args = { c, d, e } end
+    local dim = dim_arg(args[1], 3, "FindValidRoomPlacementLocations")
+    local multi = bool_opt(args[2], 4, "FindValidRoomPlacementLocations", true)
+    local special = bool_opt(args[3], 5, "FindValidRoomPlacementLocations", false)
+    if dim < 0 then dim = current_dim(self) end
+    local found, seen = {}, {}
+    for i = 0, 168 do
+      local room = room_at(self, i, dim)
+      if room then
+        local key = GetPtrHash(room)
+        if not seen[key] then
+          seen[key] = true
+          neighbor_locations(self, room, shape, mask, dim, multi, special, found)
+        end
+      end
+    end
+    return sorted(found)
+  end)
+  for _, k in ipairs({ "GetNeighboringRooms", "CanPlaceRoom", "CanPlaceRoomAtDoor", "FindValidRoomPlacementLocations" }) do
+    R.Implemented["Level." .. k] = true
+  end
+
+  ------------------------------------------------------------------------------------------------------------
+  -- RoomDescriptor: GetNeighboringRooms(), GetValidNeighborPlacementLocations(...). Like api_more.lua's
+  -- GetDimension, a method on the descriptor class has to go on the tables of a real descriptor, which exist
+  -- from the first player's init: they are installed then, before any mod's function for it.
+  ------------------------------------------------------------------------------------------------------------
+  local desc_methods = {
+    GetNeighboringRooms = B.cfn(function(self)
+      local data = self.Data
+      if data == nil then error("rgon: GetNeighboringRooms of a room descriptor with no room data", 2) end
+      return neighbors(Game():GetLevel(), self.GridIndex, data.Shape, self:GetDimension())
+    end),
+    GetValidNeighborPlacementLocations = B.cfn(function(self, a, b, c, d)
+      local shape, mask, args
+      if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c }
+      else shape = int_opt(a, 1, "GetValidNeighborPlacementLocations", 1) mask = int_opt(b, 2, "GetValidNeighborPlacementLocations", -1) args = { c, d } end
+      local multi = bool_opt(args[1], 3, "GetValidNeighborPlacementLocations", true)
+      local special = bool_opt(args[2], 4, "GetValidNeighborPlacementLocations", false)
+      local found = {}
+      if self.Data ~= nil then neighbor_locations(Game():GetLevel(), self, shape, mask, self:GetDimension(), multi, special, found) end
+      return sorted(found)
+    end),
+  }
+  T.descriptor_methods = desc_methods
+  local installed = false
+  local function put(obj)
+    local mt = obj ~= nil and getmetatable(obj)
+    if type(mt) ~= "table" then return false end
+    for _, t in pairs({ mt, rawget(mt, "__class"), rawget(mt, "__const") }) do
+      if type(t) == "table" then
+        for name, f in pairs(desc_methods) do
+          if rawget(t, name) == nil then rawset(t, name, f) end
+        end
+      end
+    end
+    return true
+  end
+  local function install()
+    if installed then return end
+    local level = Game():GetLevel()
+    local a = put(level:GetCurrentRoomDesc())
+    local b = put(level:GetRoomByIdx(level:GetCurrentRoomIndex(), -1))
+    installed = a and b
+    if installed then
+      for name in pairs(desc_methods) do R.Implemented["RoomDescriptor." .. name] = true end
+    end
+  end
+  if T.listen then
+    T.listen(ModCallbacks.MC_POST_PLAYER_INIT, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_LEVEL, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_ROOM, install, -math.huge)
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemPool:ResetCollectible(collectible)
+------------------------------------------------------------------------------
+-- The game's own function (REPENTOGON's signature matches once here: 0x007340b0, thiscall, `ret 4`; asm read with
+-- pequery.py body). It clears the collectible's bit in the two bitsets at pool+0x67c and pool+0x68c (the lists of
+-- collectibles taken out of the pools, as RemoveCollectible and a drawn item do) and, in each of the 31 pool lists
+-- at pool+0xc (stride 0x34, entries of 0x18 bytes), copies the entry's start weight [+4] back into its current
+-- weight [+8]. REPENTOGON's Lua wrapper adds two checks that are kept: an uninitialised pool does nothing, and an
+-- id below 0 or past the item config's collectibles is the argument error "Invalid Collectible".
+-- Checked by lab_pool_test.lua: RemoveCollectible sets the bit in the first bitset (+0x67c) and ResetCollectible clears
+-- it; the second bitset's bit and the weights were not seen to change in the test, only read from the asm.
+do
+  local RESET = 0x007340b0
+  method("ItemPool", "ResetCollectible", function(self, collectible)
+    local pool = this(self, "ResetCollectible")
+    collectible = int_arg(collectible, 1, "ResetCollectible")
+    local cfg = Isaac.GetItemConfig():GetCollectibles()
+    if collectible < 0 or collectible >= cfg.Size then error("bad argument #1 to 'ResetCollectible' (Invalid Collectible)", 2) end
+    call(RESET, pool, collectible & 0xffffffff)
+  end)
+  R.Implemented["ItemPool.ResetCollectible"] = true
+end
+
+------------------------------------------------------------------------------
+-- Weapon: GetDirection, GetMaxCharge, GetMainEntity
+------------------------------------------------------------------------------
+do
+  local WT = T.Weapon
+  if not (WT and WT.MT) then
+    B.log("api_batch_three: api_batch_two.lua's Weapon is missing; Weapon.GetDirection/GetMaxCharge/GetMainEntity are left out")
+  else
+    local MT, W = WT.MT, WT.MT.__index
+    local function at(self, what)
+      if getmetatable(self) ~= MT then error("bad argument #1 to '" .. what .. "' (Weapon expected, got " .. type(self) .. ")", 3) end
+      return self[1]
+    end
+    -- the weapon's virtual function number n (the vtable is the object's first word)
+    local function virtual(w, n)
+      local vt = r32(w)
+      local f = vt ~= 0 and r32(vt + 4 * n) or 0
+      if f == 0 then error("rgon: this weapon has no virtual function " .. n, 3) end
+      return f
+    end
+    function W:GetDirection()
+      local w = at(self, "GetDirection")
+      return Vector(rf32(w + 0x20), rf32(w + 0x24))
+    end
+    function W:GetMaxCharge()
+      local w = at(self, "GetMaxCharge")
+      local _, st0 = call(virtual(w, 6), w)
+      return st0
+    end
+    function W:GetMainEntity()
+      local w = at(self, "GetMainEntity")
+      return wrap("Entity", (call(virtual(w, 10), w)))
+    end
+    for _, k in ipairs({ "GetDirection", "GetMaxCharge", "GetMainEntity" }) do R.Implemented["Weapon." .. k] = true end
+  end
+end
diff --git a/scripts/recomp/rgon/api_batch_two.lua b/scripts/recomp/rgon/api_batch_two.lua
