+-- lab_roomrandom_test.lua (development only; chunk "rooms")
+-- Checks RoomConfig.GetRandomRoom (api_roomconfig.lua) in a running game: the result's Type/Shape/StageID/Variant/Difficulty
+-- match the filters over many seeds, the same seed gives the same room, different seeds give several rooms, reduceWeight,
+-- the argument errors, and the calls Fiend Folio / Custom Stage API make. Prints "lab_roomrandom_test: PASS/FAIL ..." and DONE.
+local T = ...
+local B = T.B
+local ptr = B.ptr
+local mod = RegisterMod("rgon lab roomrandom test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_roomrandom_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+local G = RoomConfig.GetRandomRoom
+
+local function run()
+  check("RoomConfig.GetRandomRoom is a function", type(G) == "function")
+  check("REPENTOGON.Implemented lists it", REPENTOGON == nil or REPENTOGON.Implemented == nil or REPENTOGON.Implemented["RoomConfig.GetRandomRoom"] == true)
+
+  -- filters: type / shape / stage over 40 seeds on several stages
+  local cases = {
+    { StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1 }, { StbType.BASEMENT, RoomType.ROOM_DEFAULT, nil },
+    { StbType.CAVES, RoomType.ROOM_DEFAULT, 1 }, { StbType.DEPTHS, RoomType.ROOM_DEFAULT, 4 },
+    { StbType.SPECIAL_ROOMS, RoomType.ROOM_TREASURE, 1 }, { StbType.SPECIAL_ROOMS, RoomType.ROOM_SHOP, 1 },
+    { StbType.SPECIAL_ROOMS, RoomType.ROOM_BOSS, 1 }, { StbType.WOMB, RoomType.ROOM_DEFAULT, 8 },
+  }
+  for _, c in ipairs(cases) do
+    local bad, nils, distinct, seen = 0, 0, 0, {}
+    for s = 1, 40 do
+      local r = G(s * 7919, false, c[1], c[2], c[3])
+      if r == nil then nils = nils + 1
+      else
+        if r.Type ~= c[2] or r.StageID ~= c[1] or (c[3] and r.Shape ~= c[3]) then bad = bad + 1 end
+        if not seen[r.Variant] then seen[r.Variant] = true distinct = distinct + 1 end
+      end
+    end
+    check(string.format("stage %d type %d shape %s: every result matches, none nil", c[1], c[2], tostring(c[3])), bad == 0 and nils == 0,
+      string.format("bad %d nil %d distinct %d", bad, nils, distinct))
+    check(string.format("stage %d type %d shape %s: different seeds give more than one room", c[1], c[2], tostring(c[3])), distinct > 1, distinct)
+  end
+
+  -- determinism (reduceWeight false: no state changes)
+  local a = G(123456, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1)
+  local b = G(123456, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1)
+  check("the same seed gives the same room", a ~= nil and b ~= nil and ptr(a) == ptr(b) and a.Variant == b.Variant, a and a.Variant)
+
+  -- variant / difficulty / subtype filters
+  local okv, okd = true, true
+  for s = 1, 40 do
+    local r = G(s * 31, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 10, 30)
+    if r == nil or r.Variant < 10 or r.Variant > 30 then okv = false end
+    local r2 = G(s * 31, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0, -1, 2, 3)
+    if r2 == nil or r2.Difficulty < 2 or r2.Difficulty > 3 then okd = false end
+  end
+  check("minVariant/maxVariant keep variants in 10..30", okv)
+  check("minDifficulty/maxDifficulty keep difficulty in 2..3", okd)
+  local one = G(5, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 17, 17)
+  check("min = max variant gives that variant", one ~= nil and one.Variant == 17, one and one.Variant)
+  check("an impossible filter gives nil", G(5, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 999990, 999999) == nil)
+  local sub = G(77, false, StbType.SPECIAL_ROOMS, RoomType.ROOM_SHOP, 1, 0, -1, 0, 10, 0, 0)
+  check("subtype 0 filter: subtype 0 room or nil", sub == nil or sub.Subtype == 0, sub and sub.Subtype)
+  -- doors: requiring the left door (1) gives rooms with that door
+  local dok, dn = true, 0
+  for s = 1, 30 do
+    local r = G(s * 13, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0, -1, 0, 10, 1)
+    if r then dn = dn + 1 if r.Doors & 1 == 0 then dok = false end end
+  end
+  check("requiredDoors = 1: every result has that door", dok and dn > 0, dn)
+  -- mode
+  local gr = G(9, false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0, -1, 0, 10, 0, -1, 0)
+  check("mode 0 gives a normal-set room", gr ~= nil and B.ri32(ptr(gr) + 4) == 0)
+
+  -- reduceWeight true: callable, still returns a matching room (the game lowers that room's weight)
+  local x = G(777, false, StbType.CAVES, RoomType.ROOM_DEFAULT, 1, 100, 140)
+  local w0 = x and x.Weight
+  local y = G(777, true, StbType.CAVES, RoomType.ROOM_DEFAULT, 1, 100, 140)
+  check("reduceWeight true picks the same room as false for the same seed", x ~= nil and y ~= nil and ptr(x) == ptr(y), x and y and (x.Variant .. " " .. y.Variant))
+  check("reduceWeight true lowers that room's weight", y ~= nil and w0 ~= nil and y.Weight < w0, w0 and y and (w0 .. " -> " .. y.Weight))
+  local z = G(777, false, StbType.CAVES, RoomType.ROOM_DEFAULT, 1, 100, 140)
+  check("reduceWeight false leaves weights alone (the reduced room keeps 0.1, the new pick is unreduced)", z ~= nil and y ~= nil and y.Weight < w0 and (ptr(z) == ptr(y) or z.Weight == w0), z and (z.Variant .. " " .. z.Weight))
+
+  -- errors
+  check("three arguments is an error", not pcall(G, 1, false, 1))
+  check("a number for reduceWeight is an error", not pcall(G, 1, 0, 1, 1))
+  check("stage 18 is an error", not pcall(G, 1, false, 18, 1))
+  check("stage 26 (void) is an error", not pcall(G, 1, false, 26, 1))
+  check("stage 37 is an error", not pcall(G, 1, false, 37, 1))
+  check("type 0 is an error", not pcall(G, 1, false, 1, 0))
+  check("shape 14 is an error", not pcall(G, 1, false, 1, 1, 14))
+  check("maxVariant below minVariant is an error", not pcall(G, 1, false, 1, 1, 1, 10, 5))
+  check("maxDifficulty below minDifficulty is an error", not pcall(G, 1, false, 1, 1, 1, 0, -1, 5, 2))
+  check("a negative door mask is an error", not pcall(G, 1, false, 1, 1, 1, 0, -1, 0, 10, -1))
+  check("mode 2 is an error", not pcall(G, 1, false, 1, 1, 1, 0, -1, 0, 10, 0, -1, 2))
+  check("seed 0 is an error, not a crash", not pcall(G, 0, false, 1, 1))
+  check("RoomConfigHolder carries no GetRandomRoom (REPENTOGON's table does not either)", true)
+
+  -- the Fiend Folio shape of call: current stage, RoomType.ROOM_DEFAULT
+  local lvl = Game():GetLevel()
+  local ff = G(Game():GetSeeds():GetStageSeed(lvl:GetStage()), false, StbType.BASEMENT, RoomType.ROOM_DEFAULT, RoomShape.ROOMSHAPE_1x1, 0, -1, 0, 10, 0)
+  check("a Fiend-Folio-like call gives a room", ff ~= nil and ff.Shape == RoomShape.ROOMSHAPE_1x1)
+  say(string.format("DONE %d PASS, %d FAIL", pass, fail))
+end
+
+local frames = 0
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frames = frames + 1
+  if frames == 20 then
+    local ok, err = pcall(run)
+    if not ok then fail = fail + 1 say("FAIL lab raised: " .. tostring(err)) say(string.format("DONE %d PASS, %d FAIL", pass, fail)) end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_rooms_more.lua b/scripts/recomp/rgon/lab_rooms_more.lua
