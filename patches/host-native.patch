+-- api_batch_three.lua -- census batch 3 (M8). Written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp);
+-- everything below was measured in THIS executable (v1.9.7.17) in a running game (lab_b3probe.lua and later
+-- probes), and is checked by lab_batch3_test.lua.
+--
+--   Weapon      REPENTOGON         here
+--   GetDirection  Vector at +0x20  the same: (1,0) while firing right, (0,-1) up, for the weapons that keep one
+--                                  (Brimstone, Monstro's Lung, Chocolate Milk, charge weapons); the plain tear
+--                                  weapon never writes it (0,0)
+--   GetMaxCharge  vtable slot 6    the same slot; the float comes back in st0 (the bridge's second result):
+--                                  tears 0, Brimstone 32 (the charge field climbs to 32 and stops), Monstro's
+--                                  Lung 46.3, Chocolate Milk 26.5
+--   GetMainEntity vtable slot 10   the same slot: `mov eax, [ecx+0x48]; ret` for Brimstone's weapon (its laser),
+--                                  `xor eax, eax; ret` for the plain tear weapon
+
+local T = ...
+local B, R, wrap, method, this = T.B, T.R, T.wrap, T.method, T.this
+local r32, rf32, call = B.r32, B.rf32, B.call
+local type, getmetatable, pairs, ipairs = type, getmetatable, pairs, ipairs
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+------------------------------------------------------------------------------
+-- Room placement queries: Level CanPlaceRoom, CanPlaceRoomAtDoor, FindValidRoomPlacementLocations,
+-- GetNeighboringRooms; RoomDescriptor GetNeighboringRooms, GetValidNeighborPlacementLocations
+------------------------------------------------------------------------------
+-- REPENTOGON's RoomPlacement.cpp is plain code over the game's own level-generator helpers; the four it calls
+-- are called here by address (each prefix checked against REPENTOGON's signature, lab_b3probe2.lua; v1.9.7.17):
+--   0x009afdb0  get_room_placement_offsets(shape<ecx>) -> int**  the cells a shape covers, (x,y) pairs, -1 ends
+--   0x009af3f0  get_door_source_position(out<ecx>, pos<edx>, shape, slot)   the cell a door leaves from
+--   0x009af620  get_door_target_position(out<ecx>, pos<edx>, shape, slot, unk)   the cell it leads to
+--   0x009af370  has_shape_slot(shape<ecx>, slot<edx>, ignore_thin) -> bool
+-- The rest is the vanilla API: Level:GetRoomByIdx (a descriptor with Data nil for an empty cell), the
+-- descriptor's GridIndex, Data.Type/Shape/Doors, Level:GetStartingRoomIndex, HasPhotoDoor and GetStage.
+-- TryPlaceRoom and TryPlaceRoomAtDoor are not here: they need the game's own PlaceRoom, whose REPENTOGON
+-- signature matches nothing in this exe.
+do
+  local OFFSETS, SOURCE, TARGET, HAS_SLOT = 0x009afdb0, 0x009af3f0, 0x009af620, 0x009af370
+  local ri32, w32, floor = B.ri32, B.w32, math.floor
+  local buf_out, buf_pos
+  local function buffers()
+    if not buf_out then buf_out, buf_pos = B.alloc(16), B.alloc(16) end
+    return buf_out, buf_pos
+  end
+  local NORMAL = { [2] = 1, [3] = 1, [5] = 4, [7] = 6 }   -- thin shapes count as their wider kind when fitting
+
+  -- the door of a room of `shape` at grid index `idx`: source cell, target cell, or nil when it is not a valid link
+  local function door_link(idx, shape, slot, normalize)
+    if normalize then shape = NORMAL[shape] or shape end
+    local out, pos = buffers()
+    w32(pos, idx % 13) w32(pos + 4, idx // 13)
+    call(SOURCE, { ecx = out, edx = pos }, shape, slot)
+    local sx, sy = ri32(out), ri32(out + 4)
+    call(TARGET, { ecx = out, edx = pos }, shape, slot, 0)
+    local tx, ty = ri32(out), ri32(out + 4)
+    if sx > -1 and sx < 13 and sy > -1 and sy < 13 and tx > -1 and tx < 13 and ty > -1 and ty < 13
+        and (sx == tx or sy == ty) and (math.abs(sx - tx) == 1 or math.abs(sy - ty) == 1) then
+      return sx, sy, tx, ty
+    end
+    return nil
+  end
+  local function room_at(level, idx, dim)
+    local d = level:GetRoomByIdx(idx, dim)
+    if d ~= nil and d.Data ~= nil then return d end
+    return nil
+  end
+  local function neighbors(level, idx, shape, dim)
+    local out = {}
+    for slot = 0, 7 do
+      local sx, sy, tx, ty = door_link(idx, shape, slot, true)
+      if sx then
+        local n = room_at(level, ty * 13 + tx, dim)
+        if n then out[slot] = n end
+      end
+    end
+    return out
+  end
+  local function can_place(level, shape, door_mask, col, line, dim, multi, special, none)
+    if col < 0 or col > 12 or line < 0 or line > 12 or shape < 1 or shape > 12 then return false end
+    local arr = r32((call(OFFSETS, { ecx = shape }))) -- eax is a pointer: read through it
+    for i = 0, 3 do
+      local x, y = ri32(arr + 8 * i), ri32(arr + 8 * i + 4)
+      if x == -1 or y == -1 then break end
+      if x < 0 or y < 0 or x > 1 or y > 1 then return false end
+      local ncol, nline = col + x, line + y
+      if ncol > 12 or nline > 12 then return false end
+      if room_at(level, nline * 13 + ncol, dim) then return false end
+    end
+    local idx = line * 13 + col
+    local near = neighbors(level, idx, shape, dim)
+    local any = next(near) ~= nil
+    if not none and not any then return false end
+    if door_mask < 0 then
+      door_mask = 0
+      for slot = 0, 7 do
+        if (call(HAS_SLOT, { ecx = shape, edx = slot }, 0) & 0xff) ~= 0 then door_mask = door_mask | (1 << slot) end
+      end
+    end
+    local doors, secret, plain = 0, false, false
+    for slot = 0, 7 do
+      local n = near[slot]
+      if n then
+        if (door_mask & (1 << slot)) == 0 then return false end
+        local ntype = n.Data.Type
+        if ntype == 5 then return false end
+        if not special and ntype > 1 and ntype ~= 7 then return false end
+        local ssx, ssy, stx, sty = door_link(idx, shape, slot, true)
+        local connect = false
+        local base = (slot + 2) % 4
+        for _, back in ipairs({ base, base + 4 }) do
+          if (n.Data.Doors & (1 << back)) ~= 0 then
+            local rsx, rsy, rtx, rty = door_link(n.GridIndex, n.Data.Shape, back, true)
+            if rsx and ssx and (ssy * 13 + ssx) == (rty * 13 + rtx) and (sty * 13 + stx) == (rsy * 13 + rsx) then
+              local forbidden = back == 1 and n.GridIndex == level:GetStartingRoomIndex() and (level:HasPhotoDoor() or level:GetStage() == 11)
+              if not forbidden then connect = true end
+              break
+            end
+          end
+        end
+        if not connect then return false end
+        if ntype == 7 or ntype == 8 then secret = true else plain = true doors = doors + 1 end
+      end
+    end
+    if not multi and doors > 1 then return false end
+    if secret and not plain and not special then return false end
+    return true
+  end
+  -- the cells a room of `shape` could take to hang off door `slot` of `room`
+  local function placements_at_door(shape, room, slot)
+    local out = {}
+    if room.Data ~= nil and (room.Data.Doors & (1 << slot)) ~= 0 then
+      local _, _, tx, ty = door_link(room.GridIndex, room.Data.Shape, slot, false)
+      if tx then
+        local base = (slot + 2) % 4
+        for _, back in ipairs({ base, base + 4 }) do
+          local rsx, rsy = door_link(ty * 13 + tx, shape, back, false)
+          if rsx then out[#out + 1] = { tx + (tx - rsx), ty + (ty - rsy) } end
+        end
+      end
+    end
+    return out
+  end
+  local function neighbor_locations(level, room, shape, door_mask, dim, multi, special, into)
+    for slot = 0, 7 do
+      for _, c in ipairs(placements_at_door(shape, room, slot)) do
+        if can_place(level, shape, door_mask, c[1], c[2], dim, multi, special, false) then into[c[2] * 13 + c[1]] = true end
+      end
+    end
+  end
+  local function sorted(set)
+    local out = {}
+    for k in pairs(set) do out[#out + 1] = k end
+    table.sort(out)
+    return out
+  end
+
+  -- argument readers, as REPENTOGON's: a RoomConfigRoom, or a shape and an optional door mask (default -1)
+  local function bool_opt(v, n, what, default)
+    if v == nil then return default end
+    if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. what .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+    return v
+  end
+  local function int_opt(v, n, what, default)
+    if v == nil then return default end
+    return int_arg(v, n, what)
+  end
+  local function dim_arg(v, n, what)
+    local d = int_opt(v, n, what, -1)
+    if d < -1 or d > 2 then error("bad argument #" .. n .. " to '" .. what .. "' (Invalid Dimension)", 3) end
+    return d
+  end
+  local function current_dim(level)
+    return level:GetDimension()
+  end
+  local L = "Level"
+  method(L, "GetNeighboringRooms", function(self, grid_index, shape, dim)
+    this(self, "GetNeighboringRooms")
+    grid_index, shape = int_arg(grid_index, 1, "GetNeighboringRooms"), int_arg(shape, 2, "GetNeighboringRooms")
+    return neighbors(self, grid_index, shape, dim_arg(dim, 3, "GetNeighboringRooms"))
+  end)
+  method(L, "CanPlaceRoom", function(self, a, b, c, d, e, f, g, h)
+    this(self, "CanPlaceRoom")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d, e, f }
+    else shape = int_arg(a, 1, "CanPlaceRoom") mask = int_opt(b, 2, "CanPlaceRoom", -1) args = { c, d, e, f, g } end
+    local grid_index = int_arg(args[1], 3, "CanPlaceRoom")
+    if grid_index < 0 or grid_index > 168 then return false end
+    local dim = dim_arg(args[2], 4, "CanPlaceRoom")
+    return can_place(self, shape, mask, grid_index % 13, grid_index // 13, dim, bool_opt(args[3], 5, "CanPlaceRoom", true),
+      bool_opt(args[4], 6, "CanPlaceRoom", false), bool_opt(args[5], 7, "CanPlaceRoom", false))
+  end)
+  method(L, "CanPlaceRoomAtDoor", function(self, a, b, c, d, e, f)
+    this(self, "CanPlaceRoomAtDoor")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d, e }
+    else shape = int_arg(a, 1, "CanPlaceRoomAtDoor") mask = int_opt(b, 2, "CanPlaceRoomAtDoor", -1) args = { c, d, e, f } end
+    local room = args[1]
+    if type(room) ~= "userdata" then error("bad argument to 'CanPlaceRoomAtDoor' (RoomDescriptor expected, got " .. type(room) .. ")", 2) end
+    local slot = int_arg(args[2], 4, "CanPlaceRoomAtDoor")
+    local multi, special = bool_opt(args[3], 5, "CanPlaceRoomAtDoor", true), bool_opt(args[4], 6, "CanPlaceRoomAtDoor", false)
+    local dim = room:GetDimension()
+    for _, c2 in ipairs(placements_at_door(shape, room, slot)) do
+      if can_place(self, shape, mask, c2[1], c2[2], dim, multi, special, false) then return true end
+    end
+    return false
+  end)
+  method(L, "FindValidRoomPlacementLocations", function(self, a, b, c, d, e)
+    this(self, "FindValidRoomPlacementLocations")
+    local shape, mask, args
+    if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c, d }
+    else shape = int_opt(a, 1, "FindValidRoomPlacementLocations", 1) mask = int_opt(b, 2, "FindValidRoomPlacementLocations", -1) args = { c, d, e } end
+    local dim = dim_arg(args[1], 3, "FindValidRoomPlacementLocations")
+    local multi = bool_opt(args[2], 4, "FindValidRoomPlacementLocations", true)
+    local special = bool_opt(args[3], 5, "FindValidRoomPlacementLocations", false)
+    if dim < 0 then dim = current_dim(self) end
+    local found, seen = {}, {}
+    for i = 0, 168 do
+      local room = room_at(self, i, dim)
+      if room then
+        local key = GetPtrHash(room)
+        if not seen[key] then
+          seen[key] = true
+          neighbor_locations(self, room, shape, mask, dim, multi, special, found)
+        end
+      end
+    end
+    return sorted(found)
+  end)
+  for _, k in ipairs({ "GetNeighboringRooms", "CanPlaceRoom", "CanPlaceRoomAtDoor", "FindValidRoomPlacementLocations" }) do
+    R.Implemented["Level." .. k] = true
+  end
+
+  ------------------------------------------------------------------------------------------------------------
+  -- RoomDescriptor: GetNeighboringRooms(), GetValidNeighborPlacementLocations(...). Like api_more.lua's
+  -- GetDimension, a method on the descriptor class has to go on the tables of a real descriptor, which exist
+  -- from the first player's init: they are installed then, before any mod's function for it.
+  ------------------------------------------------------------------------------------------------------------
+  local desc_methods = {
+    GetNeighboringRooms = B.cfn(function(self)
+      local data = self.Data
+      if data == nil then error("rgon: GetNeighboringRooms of a room descriptor with no room data", 2) end
+      return neighbors(Game():GetLevel(), self.GridIndex, data.Shape, self:GetDimension())
+    end),
+    GetValidNeighborPlacementLocations = B.cfn(function(self, a, b, c, d)
+      local shape, mask, args
+      if type(a) == "userdata" then shape, mask = a.Shape, a.Doors args = { b, c }
+      else shape = int_opt(a, 1, "GetValidNeighborPlacementLocations", 1) mask = int_opt(b, 2, "GetValidNeighborPlacementLocations", -1) args = { c, d } end
+      local multi = bool_opt(args[1], 3, "GetValidNeighborPlacementLocations", true)
+      local special = bool_opt(args[2], 4, "GetValidNeighborPlacementLocations", false)
+      local found = {}
+      if self.Data ~= nil then neighbor_locations(Game():GetLevel(), self, shape, mask, self:GetDimension(), multi, special, found) end
+      return sorted(found)
+    end),
+  }
+  T.descriptor_methods = desc_methods
+  T.room_place = { can_place = can_place, neighbors = neighbors, door_link = door_link, placements_at_door = placements_at_door, room_at = room_at }
+  local installed = false
+  local function put(obj)
+    local mt = obj ~= nil and getmetatable(obj)
+    if type(mt) ~= "table" then return false end
+    for _, t in pairs({ mt, rawget(mt, "__class"), rawget(mt, "__const") }) do
+      if type(t) == "table" then
+        for name, f in pairs(desc_methods) do
+          if rawget(t, name) == nil then rawset(t, name, f) end
+        end
+      end
+    end
+    return true
+  end
+  local function install()
+    if installed then return end
+    local level = Game():GetLevel()
+    local a = put(level:GetCurrentRoomDesc())
+    local b = put(level:GetRoomByIdx(level:GetCurrentRoomIndex(), -1))
+    installed = a and b
+    if installed then
+      for name in pairs(desc_methods) do R.Implemented["RoomDescriptor." .. name] = true end
+    end
+  end
+  if T.listen then
+    T.listen(ModCallbacks.MC_POST_PLAYER_INIT, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_LEVEL, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_ROOM, install, -math.huge)
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemPool:ResetCollectible(collectible)
+------------------------------------------------------------------------------
+-- The game's own function (REPENTOGON's signature matches once here: 0x007340b0, thiscall, `ret 4`; asm read with
+-- pequery.py body). It clears the collectible's bit in the two bitsets at pool+0x67c and pool+0x68c (the lists of
+-- collectibles taken out of the pools, as RemoveCollectible and a drawn item do) and, in each of the 31 pool lists
+-- at pool+0xc (stride 0x34, entries of 0x18 bytes), copies the entry's start weight [+4] back into its current
+-- weight [+8]. REPENTOGON's Lua wrapper adds two checks that are kept: an uninitialised pool does nothing, and an
+-- id below 0 or past the item config's collectibles is the argument error "Invalid Collectible".
+-- Checked by lab_pool_test.lua: RemoveCollectible sets the bit in the first bitset (+0x67c) and ResetCollectible clears
+-- it; the second bitset's bit and the weights were not seen to change in the test, only read from the asm.
+do
+  local RESET = 0x007340b0
+  method("ItemPool", "ResetCollectible", function(self, collectible)
+    local pool = this(self, "ResetCollectible")
+    collectible = int_arg(collectible, 1, "ResetCollectible")
+    local cfg = Isaac.GetItemConfig():GetCollectibles()
+    if collectible < 0 or collectible >= cfg.Size then error("bad argument #1 to 'ResetCollectible' (Invalid Collectible)", 2) end
+    call(RESET, pool, collectible & 0xffffffff)
+  end)
+  R.Implemented["ItemPool.ResetCollectible"] = true
+end
+
+------------------------------------------------------------------------------
+-- Weapon: GetDirection, GetMaxCharge, GetMainEntity
+------------------------------------------------------------------------------
+do
+  local WT = T.Weapon
+  if not (WT and WT.MT) then
+    B.log("api_batch_three: api_batch_two.lua's Weapon is missing; Weapon.GetDirection/GetMaxCharge/GetMainEntity are left out")
+  else
+    local MT, W = WT.MT, WT.MT.__index
+    local function at(self, what)
+      if getmetatable(self) ~= MT then error("bad argument #1 to '" .. what .. "' (Weapon expected, got " .. type(self) .. ")", 3) end
+      return self[1]
+    end
+    -- the weapon's virtual function number n (the vtable is the object's first word)
+    local function virtual(w, n)
+      local vt = r32(w)
+      local f = vt ~= 0 and r32(vt + 4 * n) or 0
+      if f == 0 then error("rgon: this weapon has no virtual function " .. n, 3) end
+      return f
+    end
+    function W:GetDirection()
+      local w = at(self, "GetDirection")
+      return Vector(rf32(w + 0x20), rf32(w + 0x24))
+    end
+    function W:GetMaxCharge()
+      local w = at(self, "GetMaxCharge")
+      local _, st0 = call(virtual(w, 6), w)
+      return st0
+    end
+    function W:GetMainEntity()
+      local w = at(self, "GetMainEntity")
+      return wrap("Entity", (call(virtual(w, 10), w)))
+    end
+    for _, k in ipairs({ "GetDirection", "GetMaxCharge", "GetMainEntity" }) do R.Implemented["Weapon." .. k] = true end
+  end
+end
diff --git a/scripts/recomp/rgon/api_batch_two.lua b/scripts/recomp/rgon/api_batch_two.lua
new file mode 100644
index 0000000..a0034bf
--- /dev/null
+++ b/scripts/recomp/rgon/api_batch_two.lua
@@ -0,0 +1,310 @@
+-- api_batch_two.lua -- census batch 2 (M8): the weapon and laser fields of EntityPlayer, the Weapon class and
+-- EntityKnife, written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp). Every offset below was
+-- measured in THIS executable (v1.9.7.17) in a running game (lab_b2probe*.lua: the structure snapshotted
+-- before and after the game itself changed the value, or the value read where the game's own getter or an
+-- initialiser puts it); REPENTOGON's number and the measured one are in the comment of each block.
+--
+--   EntityPlayer  REPENTOGON  here    how it was measured
+--   stat modifiers  0x1518..0x152c  0x1520..0x1534 (+8)  Entity_Player::EvaluateItems (0x00763570) reads the six
+--                                   ints and Init (0x00755ad7) clears them as a block; writing 5 into each and
+--                                   re-evaluating moved exactly one stat each (lab_b2probe)
+--   tear displacement 0x156c        0x1578 (+12)         int8, 1 / -1: flips with every tear fired (lab_b2probe)
+--   bomb place delay  0x1604        0x1610 (+12)         0 -> 28 when the game places a bomb (lab_b2probe2)
+--   head lock time    0x133c        0x1338 (-4)          the vanilla HeadFrameDelay: -1 idle, 10 after a shot,
+--                                   counts down, and the head direction (0x1628) returns when it reaches -1
+--   head direction    0x161c        0x1628 (+12)         read back through GetHeadDirection (lab_b2probe2)
+--   head animation    0x1320        0x1320 (+0)          the std::string "HeadDown" (SSO: size 0x1330, capacity 0x1334)
+--   urn souls         0x1dbc        0x1dd0 (+20)         0 -> 3 across the game's own AddUrnSouls(3) (lab_b2probe)
+--   weapons           0x13d8        0x13dc (+4)          slot 1 (the primary weapon) holds the Weapon whose +4 is the player
+--   marked target     0x1408        0x140c (+4)          the pointer to the TARGET effect (1000, 30) Marked spawns
+--   Weapon (0x40 bytes)             as REPENTOGON        +4 owner, +c fire delay, +10 max fire delay, +14 charge,
+--                                   +30 type, +34 modifiers, +38 shots fired: type 1 (tears), max fire delay
+--                                   equal to the player's MaxFireDelay, owner = the player (lab_b2probe)
+--   EntityKnife                     as REPENTOGON        Entity_Knife's initialiser (0x00960c10) clears 0x444, 0x448,
+--                                   0x465, 0x4e5/6 and 0x4ea together; the flag byte 0x465 reads 1 while a bone
+--                                   club swings and 0 after (lab_b2probe3); the hit list is the vector the game's
+--                                   own GetHitEntities (0x009612e0: `lea eax, [ecx+0x4d8]`) hands out
+--
+-- Left out because no value could be made to move (see layer-gaps.md): Suplex state (the fields REPENTOGON
+-- names at 0x1f08.. hold a -100000 sentinel and floats here), Keeper's Sack bonus, Pony charge, Immaculate and
+-- Cambion Conception states, the Eve's Sumptorium charge, Red Stew's duration, PlayerForm counters.
+
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.log, B.call
+local type, tostring, tonumber, pairs, ipairs, setmetatable, getmetatable, rawget = type, tostring, tonumber, pairs, ipairs, setmetatable, getmetatable, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function num_arg(v, n, what)
+  if type(v) ~= "number" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+local P = "EntityPlayer"
+
+------------------------------------------------------------------------------
+-- EntityPlayer: the six stat modifiers (ints the game's own EvaluateItems adds)
+------------------------------------------------------------------------------
+-- Speed +0.2, FireDelay (about +0.5 tears a second), Damage +1, TearRange +100 (2.5 tiles of range), ShotSpeed
+-- +0.2, Luck +1 per point, measured by writing 5 and re-evaluating. Like REPENTOGON's, a setter does not ask for
+-- a re-evaluation: the game does at the next cache flag.
+do
+  for name, off in pairs({ Speed = 0x1520, FireDelay = 0x1524, Damage = 0x1528, TearRange = 0x152c, ShotSpeed = 0x1530, Luck = 0x1534 }) do
+    method(P, "Get" .. name .. "Modifier", function(self) return ri32(this(self, "Get" .. name .. "Modifier") + off) end)
+    method(P, "Set" .. name .. "Modifier", function(self, v)
+      local p = this(self, "Set" .. name .. "Modifier")
+      w32(p + off, int_arg(v, 1, "Set" .. name .. "Modifier") & 0xffffffff)
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- EntityPlayer: tear displacement, bomb place delay, head, urn, marked target, laser colour
+------------------------------------------------------------------------------
+do
+  -- GetTearDisplacement() -> 1 or -1 (the side the next tear leaves from); SetTearDisplacement(-1..1)
+  method(P, "GetTearDisplacement", function(self)
+    local v = r8(this(self, "GetTearDisplacement") + 0x1578)
+    return v >= 0x80 and v - 0x100 or v
+  end)
+  method(P, "SetTearDisplacement", function(self, v)
+    v = int_arg(v, 1, "SetTearDisplacement")
+    if v < -1 or v > 1 then error("bad argument #1 to 'SetTearDisplacement' (TearDisplacement may only be set to -1 or 1)", 2) end
+    w8(this(self, "SetTearDisplacement") + 0x1578, v & 0xff)
+  end)
+  method(P, "GetBombPlaceDelay", function(self) return ri32(this(self, "GetBombPlaceDelay") + 0x1610) end)
+  method(P, "SetBombPlaceDelay", function(self, v) w32(this(self, "SetBombPlaceDelay") + 0x1610, int_arg(v, 1, "SetBombPlaceDelay") & 0xffffffff) end)
+  method(P, "GetHeadDirectionLockTime", function(self) return ri32(this(self, "GetHeadDirectionLockTime") + 0x1338) end)
+  method(P, "SetHeadDirectionLockTime", function(self, v) w32(this(self, "SetHeadDirectionLockTime") + 0x1338, int_arg(v, 1, "SetHeadDirectionLockTime") & 0xffffffff) end)
+
+  -- SetHeadDirection(direction, time, force = false): only while no direction is locked (the lock time below
+  -- zero) unless forced; a changed direction also changes the head animation's name, as REPENTOGON does
+  -- (the game only reads the name, it never derives it from the direction again until the next shot)
+  local HEAD_ANIM = { [0] = "HeadLeft", "HeadUp", "HeadRight", "HeadDown" }
+  local function set_string(at, s)
+    -- MSVC std::string: 16 bytes of inline text, or a pointer in the first word once the capacity is above 15
+    local cap = r32(at + 0x14)
+    local buf = at
+    if cap > 15 then buf = r32(at) end
+    if cap < #s or buf == 0 then return false end
+    for i = 1, #s do w8(buf + i - 1, s:byte(i)) end
+    w8(buf + #s, 0)
+    w32(at + 0x10, #s)
+    return true
+  end
+  method(P, "SetHeadDirection", function(self, direction, time, force)
+    local p = this(self, "SetHeadDirection")
+    direction = int_arg(direction, 1, "SetHeadDirection")
+    time = int_arg(time, 2, "SetHeadDirection")
+    if direction < 0 or direction > 3 then error("bad argument #1 to 'SetHeadDirection' (Invalid Direction)", 2) end
+    if force == true or ri32(p + 0x1338) < 0 then
+      if ri32(p + 0x1628) ~= direction then
+        w32(p + 0x1628, direction)
+        set_string(p + 0x1320, HEAD_ANIM[direction])
+      end
+      w32(p + 0x1338, time & 0xffffffff)
+    end
+  end)
+
+  -- GetUrnSouls() -> the souls Urn of Souls holds; AddUrnSouls(count) is the game's own (0x007d3480, ret 4)
+  method(P, "GetUrnSouls", function(self) return ri32(this(self, "GetUrnSouls") + 0x1dd0) end)
+
+  -- GetMarkedTarget() -> the TARGET effect Marked (and Telekinesis-like items) put on the floor, or nil
+  method(P, "GetMarkedTarget", function(self)
+    local e = wrap("Entity", r32(this(self, "GetMarkedTarget") + 0x140c))
+    return e and e:ToEffect()
+  end)
+
+  -- SetLaserColor(color): the colour of the player's lasers, which the game itself has as the LaserColor property
+  method(P, "SetLaserColor", function(self, color)
+    if type(color) ~= "userdata" then error("bad argument #1 to 'SetLaserColor' (Color expected, got " .. type(color) .. ")", 2) end
+    this(self, "SetLaserColor")
+    self.LaserColor = color
+  end)
+
+  -- IsItemCostumeVisible(item, layer) / IsNullItemCostumeVisible(nullItem, layer): the game's own checks (0x0075d900
+  -- and 0x0075d980, both `ret 8`; the second looks the null item up in the item config and jumps into the first)
+  local function layer_id(self, layer, what)
+    local sprite = self:GetSprite()
+    if type(layer) == "string" then
+      local l = sprite:GetLayer(layer)
+      if l == nil then error("Invalid layer name " .. layer, 3) end
+      return l:GetLayerID()
+    end
+    local id = int_arg(layer, 2, what)
+    if id < 0 or id >= sprite:GetLayerCount() then error("Invalid layer ID " .. id, 3) end
+    return id
+  end
+  method(P, "IsItemCostumeVisible", function(self, item, layer)
+    local p = this(self, "IsItemCostumeVisible")
+    local ip = type(item) == "userdata" and ptr(item) or 0
+    if ip == 0 then error("bad argument #1 to 'IsItemCostumeVisible' (ItemConfigItem expected, got " .. type(item) .. ")", 2) end
+    return (call(0x0075d900, p, ip, layer_id(self, layer, "IsItemCostumeVisible")) & 0xff) ~= 0
+  end)
+  method(P, "IsNullItemCostumeVisible", function(self, null_item, layer)
+    local p = this(self, "IsNullItemCostumeVisible")
+    null_item = int_arg(null_item, 1, "IsNullItemCostumeVisible")
+    return (call(0x0075d980, p, null_item & 0xffffffff, layer_id(self, layer, "IsNullItemCostumeVisible")) & 0xff) ~= 0
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Weapon
+------------------------------------------------------------------------------
+-- EntityPlayer:GetWeapon(slot 0..4) -> Weapon or nil. 0 backup weapon (Notched Axe, Urn of Souls), 1 primary, 2 and
+-- up for mods. A Weapon here is a Lua object holding the game's Weapon address; like REPENTOGON's it is only
+-- good while the game keeps the weapon (a weapon that is destroyed leaves a stale handle).
+do
+  local W = {}
+  local MT = { __index = W, __type = "Weapon", __name = "Weapon", __metatable = nil }
+  MT.__tostring = function(self) return string.format("Weapon(0x%x)", self[1]) end
+  MT.__eq = function(a, b) return getmetatable(b) == MT and a[1] == b[1] end
+  local function at(self, what)
+    if getmetatable(self) ~= MT then error("bad argument #1 to '" .. what .. "' (Weapon expected, got " .. type(self) .. ")", 3) end
+    return self[1]
+  end
+  function W:GetOwner()
+    return wrap("Entity", r32(at(self, "GetOwner") + 4))
+  end
+  function W:GetFireDelay() return rf32(at(self, "GetFireDelay") + 0xc) end
+  function W:SetFireDelay(v) wf32(at(self, "SetFireDelay") + 0xc, num_arg(v, 1, "SetFireDelay")) end
+  function W:GetMaxFireDelay() return rf32(at(self, "GetMaxFireDelay") + 0x10) end
+  function W:GetCharge() return rf32(at(self, "GetCharge") + 0x14) end
+  function W:SetCharge(v) wf32(at(self, "SetCharge") + 0x14, num_arg(v, 1, "SetCharge")) end
+  function W:GetWeaponType() return ri32(at(self, "GetWeaponType") + 0x30) end
+  function W:GetModifiers() return r32(at(self, "GetModifiers") + 0x34) end
+  -- like REPENTOGON's, SetModifiers adds bits (it never clears any)
+  function W:SetModifiers(v)
+    local p = at(self, "SetModifiers")
+    w32(p + 0x34, r32(p + 0x34) | (int_arg(v, 1, "SetModifiers") & 0xffffffff))
+  end
+  function W:GetNumFired() return ri32(at(self, "GetNumFired") + 0x38) end
+  -- IsAxisAligned(): 0x009f3360 (REPENTOGON's one signature match; no arguments)
+  function W:IsAxisAligned() return (call(0x009f3360, at(self, "IsAxisAligned")) & 0xff) ~= 0 end
+
+  for k in pairs(W) do R.Implemented["Weapon." .. k] = true end
+  T.Weapon = { new = function(address) if address == 0 then return nil end return setmetatable({ address }, MT) end, MT = MT }
+
+  method(P, "GetWeapon", function(self, slot)
+    local p = this(self, "GetWeapon")
+    slot = int_arg(slot, 1, "GetWeapon")
+    if slot < 0 or slot > 4 then error("bad argument #1 to 'GetWeapon' (Index must be between 0 and 4)", 2) end
+    local w = r32(p + 0x13dc + 4 * slot)
+    return T.Weapon.new(w)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityKnife
+------------------------------------------------------------------------------
+do
+  local K = "EntityKnife"
+  local function flag(get, set, off)
+    if get then method(K, get, function(self) return r8(this(self, get) + off) ~= 0 end) end
+    if set then
+      method(K, set, function(self, v)
+        local p = this(self, set)
+        if type(v) ~= "boolean" then error("bad argument #1 to '" .. set .. "' (boolean expected, got " .. type(v) .. ")", 2) end
+        w8(p + off, v and 1 or 0)
+      end)
+    end
+  end
+  flag("GetIsSwinging", "SetIsSwinging", 0x465)
+  flag("GetIsSpinAttack", "SetIsSpinAttack", 0x4ea)
+  flag("IsPrismTouched", "SetPrismTouched", 0x4e5)
+  flag("IsMultidimensionalTouched", "SetMultidimensionalTouched", 0x4e6)
+  method(K, "SetKnifeVelocity", function(self, v) wf32(this(self, "SetKnifeVelocity") + 0x448, num_arg(v, 1, "SetKnifeVelocity")) end)
+  method(K, "SetKnifeDistance", function(self, v) wf32(this(self, "SetKnifeDistance") + 0x444, num_arg(v, 1, "SetKnifeDistance")) end)
+
+  -- the entities the knife has hit: the game's std::vector<unsigned> of hit list indices; GetHitEntities (0x009612e0)
+  -- answers the vector of the knife itself, or of its parent knife while this one is a hitbox of another
+  local function hits(self, what)
+    local v = call(0x009612e0, this(self, what))
+    local first, last, cap = r32(v), r32(v + 4), r32(v + 8)
+    if v == 0 or last < first or last - first > 0x10000 or (last - first) % 4 ~= 0 then error("rgon: this knife's hit list is not laid out as expected", 3) end
+    return v, first, last, cap
+  end
+  local function index_of(entity, n, what)
+    if type(entity) ~= "userdata" or ptr(entity) == 0 then error("bad argument #" .. n .. " to '" .. what .. "' (Entity expected, got " .. type(entity) .. ")", 3) end
+    return entity:GetHitListIndex()
+  end
+  method(K, "GetHitList", function(self)
+    local _, first, last = hits(self, "GetHitList")
+    local out = {}
+    for a = first, last - 4, 4 do out[#out + 1] = r32(a) end
+    return out
+  end)
+  method(K, "InHitList", function(self, entity)
+    local idx = index_of(entity, 1, "InHitList")
+    local _, first, last = hits(self, "InHitList")
+    for a = first, last - 4, 4 do if r32(a) == idx then return true end end
+    return false
+  end)
+  method(K, "AddToHitList", function(self, entity)
+    local idx = index_of(entity, 1, "AddToHitList")
+    local v, first, last, cap = hits(self, "AddToHitList")
+    for a = first, last - 4, 4 do if r32(a) == idx then return end end
+    if last >= cap then
+      -- grow like the game's vector does: a new buffer from the game's allocator (B.alloc is the same one), the old one freed
+      local n = (last - first) // 4
+      local new = B.alloc(4 * (n * 2 + 4))
+      if new == 0 then error("rgon: out of memory growing a knife's hit list", 2) end
+      for i = 0, n - 1 do w32(new + 4 * i, r32(first + 4 * i)) end
+      if first ~= 0 then B.free(first) end
+      w32(v, new)
+      first, last, cap = new, new + 4 * n, new + 4 * (n * 2 + 4)
+      w32(v + 8, cap)
+    end
+    w32(last, idx)
+    w32(v + 4, last + 4)
+  end)
+  method(K, "RemoveFromHitList", function(self, entity)
+    local idx = index_of(entity, 1, "RemoveFromHitList")
+    local v, first, last = hits(self, "RemoveFromHitList")
+    for a = first, last - 4, 4 do
+      if r32(a) == idx then
+        w32(a, r32(last - 4))                 -- swap with the last entry and drop it, as REPENTOGON does
+        w32(v + 4, last - 4)
+        return
+      end
+    end
+  end)
+
+  -- Get/SetHitboxParentKnife: REPENTOGON keeps the "main" knife of a melee weapon's hitbox knife in a side field
+  -- its own hook fills when the game creates the bone club's or Spirit Sword's hitbox. Here only what a mod set
+  -- is answered, per hitbox knife (a Lua table, forgotten on a new room); the game's own hitboxes are not linked
+  -- to their knife (that needs a hook at the hitbox's creation), so a mod that asks gets nil, as REPENTOGON
+  -- answers for a hitbox spawned any other way. Not counted in REPENTOGON.Implemented. Fiend Folio asks on every
+  -- damage callback (critical_hit.lua:248, statuses/berserk.lua:570, martyr.lua:383) and errored without the name.
+  -- Round (cb-c): the game's own hitbox knives are linked now: api_hooks.lua's instruction hook in update_bone_swing
+  -- (slot 223, right after the hitbox knife is spawned: esi the weapon knife, edi the hitbox) calls T.set_knife_parent.
+  -- An entry is the two pointers and their InitSeeds (0x34): a pointer the game freed and reused answers nil.
+  local parent_of = {}
+  local function seed_at(p) return r32(p + 0x34) end
+  function T.set_knife_parent(hit, main)
+    parent_of[hit] = { main = main, hseed = seed_at(hit), mseed = seed_at(main) }
+  end
+  method(K, "GetHitboxParentKnife", function(self)
+    local p = this(self, "GetHitboxParentKnife")
+    local e = parent_of[p]
+    if not e or seed_at(p) ~= e.hseed or seed_at(e.main) ~= e.mseed then return nil end
+    local parent = wrap(K, e.main)
+    if parent and parent:Exists() then return parent end
+    return nil
+  end)
+  method(K, "SetHitboxParentKnife", function(self, knife)
+    local p = this(self, "SetHitboxParentKnife")
+    if knife == nil then parent_of[p] = nil return end
+    if type(knife) ~= "userdata" or knife:ToKnife() == nil then error("bad argument #1 to 'SetHitboxParentKnife' (EntityKnife expected, got " .. type(knife) .. ")", 2) end
+    T.set_knife_parent(p, this(knife, "SetHitboxParentKnife"))
+  end)
+  -- counted in REPENTOGON.Implemented once the hook is proven (api_hooks.lua sets it when slot 223 exists)
+  R.Implemented["EntityKnife.GetHitboxParentKnife"] = nil
+  R.Implemented["EntityKnife.SetHitboxParentKnife"] = nil
+  if T.listen and ModCallbacks.MC_POST_NEW_ROOM then T.listen(ModCallbacks.MC_POST_NEW_ROOM, function() parent_of = {} end) end
+end
diff --git a/scripts/recomp/rgon/api_cacheflags.lua b/scripts/recomp/rgon/api_cacheflags.lua
new file mode 100644
index 0000000..c0b62a7
--- /dev/null
+++ b/scripts/recomp/rgon/api_cacheflags.lua
@@ -0,0 +1,21 @@
+-- api_cacheflags.lua: EntityPlayer:AddCacheFlags(flags, evaluate = false)
+-- The game's own takes only the flags and leaves the work for the next EvaluateItems, which nothing runs
+-- by itself. REPENTOGON adds the second argument: when true, EvaluateItems runs at once. Mods written for it
+-- rely on that (Fiend Folio's puzzle keys call AddCacheFlags(CACHE_FAMILIARS, true) to get their key-ghost
+-- familiars from MC_EVALUATE_CACHE -> CheckFamiliar; without the immediate pass no ghost ever appeared).
+local T = ...
+local B, R = T.B, T.R
+local log = B.log
+local rawget, rawset, type = rawget, rawset, type
+
+local c = T.class_tables("EntityPlayer")
+local game_add = c and rawget(c, "AddCacheFlags")
+if type(game_add) == "function" then
+  rawset(c, "AddCacheFlags", B.cfn(function(self, flags, evaluate)
+    game_add(self, flags)
+    if evaluate == true then self:EvaluateItems() end
+  end))
+  R.Implemented["EntityPlayer.AddCacheFlags"] = true
+else
+  log("api_cacheflags: no EntityPlayer.AddCacheFlags to extend")
+end
diff --git a/scripts/recomp/rgon/api_callbacks.lua b/scripts/recomp/rgon/api_callbacks.lua
index 5391065..79b14e5 100644
--- a/scripts/recomp/rgon/api_callbacks.lua
+++ b/scripts/recomp/rgon/api_callbacks.lua
@@ -290,6 +290,18 @@ local function add_card_pill(id, it, player, what, ...)
   return what
 end
 rule("MC_PRE_PLAYER_ADD_CARD MC_PRE_PLAYER_ADD_PILL", add_card_pill)
+-- MC_PRE_TRIGGER_PLAYER_DEATH / MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES: the run stops (no answer) as soon as the
+-- player is alive again or gone, whoever did it; false ends it with false (api_hooks.lua revives the player on that);
+-- otherwise every function ran and the answer is true.
+local function trigger_death(id, it, player, ...)
+  for cb in it do
+    local ret = call(id, cb, player, ...)
+    if not player:IsDead() or not player:Exists() then return nil end
+    if ret == false then return false end
+  end
+  return true
+end
+rule("MC_PRE_TRIGGER_PLAYER_DEATH MC_TRIGGER_PLAYER_DEATH_POST_CHECK_REVIVES", trigger_death)
 -- false ends the run; tables are merged into one answer, and the values a table
 -- names are what the functions after it are handed (`keys`: name -> argument)
 local function merge_or_false(keys)
diff --git a/scripts/recomp/rgon/api_census.lua b/scripts/recomp/rgon/api_census.lua
new file mode 100644
index 0000000..943e131
--- /dev/null
+++ b/scripts/recomp/rgon/api_census.lua
@@ -0,0 +1,299 @@
+-- api_census.lua -- round 124 (M8 census, batch 1): names the census (scripts/mac/rgon_census.py) found
+-- missing and cheap, written against REPENTOGON's behaviour (its LuaInterfaces/*.cpp says what each does).
+--
+--   RNG                the shift index, the "phantom" reads (a copy: the RNG does not move), Previous
+--   EntityConfigPlayer starting hearts, coins, bombs, keys and CanShoot, from the config record
+--   ItemConfig         GetTaggedItems (the game's own tag lookup), GetItemsWithCustomTag (api_data.lua)
+--   Isaac              GetCutsceneIdByName
+--   calls into the game  methods that pass straight to one game function: each address is a REPENTOGON
+--                      signature that matches this executable exactly once (tools/zhl-resolve.mjs), and the
+--                      function's own `ret` pops what the signature's arguments take (read with a disassembler)
+--
+-- Nothing here is listed as implemented unless the behaviour is REPENTOGON's. Where it is close but not the
+-- same, the comment says so and R.Unsupported carries a line.
+
+local T = ...
+local B, R, method, wrap, this, static = T.B, T.R, T.method, T.wrap, T.this, T.static
+local ptr, r8, r32, ri32, rf32, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w32, B.wf32, B.log, B.call
+local type, tostring, tonumber, select, pairs, ipairs, rawget = type, tostring, tonumber, select, pairs, ipairs, rawget
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (integer expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+------------------------------------------------------------------------------
+-- RNG
+------------------------------------------------------------------------------
+-- An RNG is { seed +0, shift1 +4, shift2 +8, shift3 +12 } (api_lua.lua checks this against the game's own Next).
+-- A phantom read runs the game's own RandomInt/RandomFloat/Next on a copy of those four words.
+do
+  local ok = false
+  do
+    local a = RNG()
+    a:SetSeed(0x1234567, 35)
+    local p = ptr(a)
+    ok = p ~= 0 and r32(p) == 0x1234567
+  end
+  if not ok then
+    log("api_census: an RNG is not laid out as expected; the RNG additions are left out")
+  else
+    local function at(self, what)
+      local p = ptr(self)
+      if p == 0 then error("rgon: " .. what .. " called without its object (use ':')", 3) end
+      return p
+    end
+    local function copy_of(self, what)
+      local p = at(self, what)
+      local c = RNG()
+      local q = ptr(c)
+      for i = 0, 12, 4 do w32(q + i, r32(p + i)) end
+      return c
+    end
+    -- the game's 81 shift triples, read back from its own SetSeed(seed, index) the first time they are asked
+    local SHIFTS
+    local function shifts()
+      if SHIFTS then return SHIFTS end
+      SHIFTS = {}
+      local scratch = RNG()
+      local q = ptr(scratch)
+      for idx = 0, 80 do
+        scratch:SetSeed(1, idx)
+        SHIFTS[idx] = { r32(q + 4), r32(q + 8), r32(q + 12) }
+      end
+      return SHIFTS
+    end
+    method("RNG", "GetShiftIdx", function(self)
+      local p = at(self, "GetShiftIdx")
+      local a, b, c = r32(p + 4), r32(p + 8), r32(p + 12)
+      for idx, s in ipairs(shifts()) do end
+      local t = shifts()
+      for idx = 0, 80 do
+        local s = t[idx]
+        if s[1] == a and s[2] == b and s[3] == c then return idx end
+      end
+      return nil
+    end)
+    method("RNG", "PhantomNext", function(self) return copy_of(self, "PhantomNext"):Next() end)
+    method("RNG", "PhantomFloat", function(self) return copy_of(self, "PhantomFloat"):RandomFloat() end)
+    -- PhantomInt(max) -> 0 .. max-1 (as RandomInt); PhantomInt(min, max) -> min .. max, both included
+    method("RNG", "PhantomInt", function(self, a, b)
+      local c = copy_of(self, "PhantomInt")
+      a = int_arg(a, 1, "PhantomInt")
+      if b == nil then return c:RandomInt(a) end
+      b = int_arg(b, 2, "PhantomInt")
+      if a > b then error("bad argument #1 to 'PhantomInt' (interval is empty)", 2) end
+      return c:RandomInt(b - a + 1) + a
+    end)
+    -- the xorshift step undone: the seed that Next() would have come from
+    local function rev_shr(result, s)
+      local x = 0
+      for _ = 1, (32 + s - 1) // s do x = ((x >> s) ~ result) & 0xffffffff end
+      return x
+    end
+    local function rev_shl(result, s)
+      local x = 0
+      for _ = 1, (32 + s - 1) // s do x = (((x << s) & 0xffffffff) ~ result) & 0xffffffff end
+      return x
+    end
+    local function previous(p)
+      local s1, s2, s3 = r32(p + 4), r32(p + 8), r32(p + 12)
+      if s1 == 0 or s2 == 0 or s3 == 0 then return r32(p) end
+      local t = rev_shr(r32(p), s3)
+      t = rev_shl(t, s2)
+      return rev_shr(t, s1)
+    end
+    method("RNG", "Previous", function(self)
+      local p = at(self, "Previous")
+      w32(p, previous(p))
+      return r32(p)
+    end)
+    method("RNG", "PhantomPrevious", function(self) return previous(at(self, "PhantomPrevious")) end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- EntityConfigPlayer: the starting values the config record holds
+------------------------------------------------------------------------------
+-- The record is the one api_gaps.lua reads (T.player_config, 0x148 bytes each, the name at +4 checked); these
+-- fields follow REPENTOGON's layout between the two this build is known to share (+0xac .. +0xf4):
+-- +0xb0 hearts, +0xb4 soul hearts (armor), +0xb8 black hearts, +0xbc coins, +0xc0 bombs, +0xc4 keys, +0xd0 CanShoot.
+do
+  local pc = T.player_config
+  local sample = EntityConfig and EntityConfig.GetPlayer and EntityConfig.GetPlayer(0)
+  local PC = sample and getmetatable(sample) and getmetatable(sample).__index
+  if type(PC) == "table" and pc then
+    local stdstr = B.stdstr
+    local checked = {}
+    local function rec(self, what)
+      local at = pc(self._id)
+      if not at then return nil end
+      if checked[self._id] == nil then
+        checked[self._id] = (stdstr(at + 4) == (self._x.name or "")) or false
+        if not checked[self._id] then log("api_census: the config record of player " .. self._id .. " does not hold its name; " .. what .. " answers its default") end
+      end
+      return checked[self._id] and at or nil
+    end
+    local function int(name, off)
+      PC[name] = function(self) local at = rec(self, name) return at and ri32(at + off) or 0 end
+      R.Implemented["EntityConfigPlayer." .. name] = true
+    end
+    int("GetRedHearts", 0xb0)
+    int("GetSoulHearts", 0xb4)
+    int("GetBlackHearts", 0xb8)
+    int("GetCoins", 0xbc)
+    int("GetBombs", 0xc0)
+    int("GetKeys", 0xc4)
+    PC.CanShoot = function(self) local at = rec(self, "CanShoot") return at == nil or r8(at + 0xd0) ~= 0 end
+    R.Implemented["EntityConfigPlayer.CanShoot"] = true
+  else
+    log("api_census: EntityConfig.GetPlayer is not the layer's own; the config's starting values are left out")
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemConfig:GetTaggedItems(tags)
+------------------------------------------------------------------------------
+-- ItemConfig::GetTaggedItems(unsigned long long tags) (0x00730b80, ret 8) answers a reference to the game's
+-- own list of ItemConfig_Item pointers for those tag bits; REPENTOGON converts it to a table. The pointers are
+-- turned back into the item objects Lua already knows (matched by address over collectibles, trinkets and null
+-- items, built the first time).
+do
+  local config = Isaac.GetItemConfig()
+  local by_address
+  local function index()
+    if by_address then return by_address end
+    by_address = {}
+    for _, get in ipairs({ { "GetCollectibles", "GetCollectible" }, { "GetTrinkets", "GetTrinket" }, { "GetNullItems", "GetNullItem" } }) do
+      local list = config[get[1]](config)
+      for id = 1, list.Size - 1 do
+        local item = config[get[2]](config, id)
+        if item then by_address[ptr(item)] = item end
+      end
+    end
+    return by_address
+  end
+  method("ItemConfig", "GetTaggedItems", function(self, tags)
+    tags = int_arg(tags, 1, "GetTaggedItems") & 0xffffffff
+    local v = call(0x00730b80, this(self, "GetTaggedItems"), tags, 0)
+    local first, last = r32(v), r32(v + 4)
+    if last < first or last - first > 0x40000 then error("rgon: the game's tagged-item list is not laid out as expected", 2) end
+    local out, map = {}, index()
+    for a = first, last - 4, 4 do
+      local item = map[r32(a)]
+      if item then out[#out + 1] = item end
+    end
+    return out
+  end)
+end
+
+------------------------------------------------------------------------------
+-- Isaac
+------------------------------------------------------------------------------
+do
+  local XN = rawget(_G, "XMLNode")
+  -- Isaac.GetCutsceneIdByName(name) -> the id cutscenes.xml gives it, or -1. (A mod's cutscene has the id its own
+  -- node states, as REPENTOGON's lookup reads the node; the game gives a mod's no number of its own here.)
+  if XN and XN.CUTSCENE and T.xml_entries then
+    static(Isaac, "Isaac", "GetCutsceneIdByName", function(name)
+      if type(name) ~= "string" then error("bad argument #1 to 'GetCutsceneIdByName' (string expected, got " .. type(name) .. ")", 2) end
+      local set = T.xml_entries(XN.CUTSCENE)
+      local e = set and set.by_name[name]
+      local id = e and tonumber(e.id)
+      return id and math.tointeger(id) or -1
+    end)
+  end
+  -- Isaac.GetLoadedModules is not here: mods get no `package` table (measured), so REPENTOGON's registry _LOADED is out of reach.
+end
+
+------------------------------------------------------------------------------
+-- methods that are one call into the game
+------------------------------------------------------------------------------
+-- gcall(class, name, address, spec, result[, trailing words]): api_game.lua's helper (spec: i integer, b boolean,
+-- E entity, V vector, R entity ref; ";" between arguments, "=default" makes one optional).
+local gcall = T.gcall
+if gcall then
+  -- EntityPlayer
+  gcall("EntityPlayer", "AddLeprosy", 0x00759b90, "", "void")
+  gcall("EntityPlayer", "CanAddCollectibleToInventory", 0x007d4170, "i", "bool")
+  gcall("EntityPlayer", "CanUsePill", 0x007c40e0, "i", "bool")
+  gcall("EntityPlayer", "HasPoisonImmunity", 0x007c3320, "", "bool")
+  gcall("EntityPlayer", "IsHeadless", 0x0078b350, "", "bool")
+  gcall("EntityPlayer", "IsInvisible", 0x007c32c0, "", "bool")
+  gcall("EntityPlayer", "GetCambionPregnancyLevel", 0x007c90b0, "", "int")
+  gcall("EntityPlayer", "GetGlitchBabySubType", 0x007c2e90, "", "uint")
+  gcall("EntityPlayer", "MorphToCoopGhost", 0x007d96f0, "", "void")
+  gcall("EntityPlayer", "SetControllerIndex", 0x007a6450, "i;b", "void")
+  gcall("EntityPlayer", "TryPreventDeath", 0x007caad0, "", "bool")
+  gcall("EntityPlayer", "VoidHasCollectible", 0x007711a0, "i", "bool")
+  gcall("EntityPlayer", "IsEntityValidTarget", 0x00757a60, "E", "bool")
+  gcall("EntityPlayer", "SpawnClot", 0x007da810, "V;b=false", "void")
+  gcall("EntityPlayer", "GetFocusEntity", 0x00779320, "", "Entity")
+  -- RemoveCollectibleByHistoryIndex(index): REPENTOGON passes true for the second word
+  gcall("EntityPlayer", "RemoveCollectibleByHistoryIndex", 0x0078fec0, "i", "void", { 1 })
+  -- SetActiveVarData(varData, slot): the slot is checked as an active slot (0 to 3)
+  method("EntityPlayer", "SetActiveVarData", function(self, vardata, slot)
+    vardata = int_arg(vardata, 1, "SetActiveVarData")
+    slot = int_arg(slot, 2, "SetActiveVarData")
+    if slot < 0 or slot > 3 then error("bad argument #2 to 'SetActiveVarData' (Invalid active slot " .. slot .. ")", 2) end
+    call(0x00791510, this(self, "SetActiveVarData"), vardata & 0xffffffff, slot)
+  end)
+  -- AddBoneOrbital(position) -> the orbital, as an EntityFamiliar
+  method("EntityPlayer", "AddBoneOrbital", function(self, position)
+    local p = type(position) == "userdata" and ptr(position) or 0
+    if p == 0 then error("bad argument #1 to 'AddBoneOrbital' (Vector expected, got " .. type(position) .. ")", 2) end
+    local e = wrap("Entity", (call(0x00759bc0, this(self, "AddBoneOrbital"), p)))
+    return e and e:ToFamiliar()
+  end)
+  -- GetBodyMoveDirection() / GetEnterPosition() -> Vector (the game writes it through a buffer)
+  for name, va in pairs({ GetBodyMoveDirection = 0x00779900, GetEnterPosition = 0x007d1620 }) do
+    method("EntityPlayer", name, function(self)
+      local buf = B.alloc(8)
+      w32(buf, 0) w32(buf + 4, 0)
+      call(va, this(self, name), buf)
+      local v = Vector(rf32(buf), rf32(buf + 4))
+      B.free(buf)
+      return v
+    end)
+  end
+  -- DropCollectibleByHistoryIndex(historyIndex, existingPickup = nil): REPENTOGON ignores the game's answer and
+  -- hands back the pickup it was given (nil without one)
+  method("EntityPlayer", "DropCollectibleByHistoryIndex", function(self, index, pickup)
+    index = int_arg(index, 1, "DropCollectibleByHistoryIndex")
+    local p = type(pickup) == "userdata" and ptr(pickup) or 0
+    call(0x007906f0, this(self, "DropCollectibleByHistoryIndex"), index & 0xffffffff, p, 0)
+    return p ~= 0 and pickup or nil
+  end)
+  -- DropCollectible(collectible, existingPickup = nil, removeFromPlayerForm = false) -> the pickup dropped, or the one given
+  method("EntityPlayer", "DropCollectible", function(self, id, pickup, remove)
+    id = int_arg(id, 1, "DropCollectible")
+    local p = type(pickup) == "userdata" and ptr(pickup) or 0
+    local got = call(0x00790530, this(self, "DropCollectible"), id & 0xffffffff, p, remove and 1 or 0)
+    if got ~= 0 then return wrap("EntityPickup", got) end
+    return p ~= 0 and pickup or nil
+  end)
+
+  -- EntityPickup
+  gcall("EntityPickup", "GetAlternatePedestal", 0x006e1d70, "", "int")
+  gcall("EntityPickup", "SetAlternatePedestal", 0x006e1a80, "i", "void")
+  gcall("EntityPickup", "SetForceBlind", 0x006e1e60, "b", "void")
+
+  -- Entity: the minecart StageAPI's rail rooms put an enemy on
+  gcall("Entity", "GiveMinecart", 0x006b7be0, "V;V", "EntityNPC")
+
+  -- EntityFamiliar, GridEntityRock
+  gcall("EntityFamiliar", "CanBlockProjectiles", 0x0060d8e0, "", "bool")
+  gcall("EntityFamiliar", "GetFollowerPriority", 0x00612970, "", "int")
+  gcall("GridEntityRock", "TrySpawnLadder", 0x0071b1c0, "", "void")
+
+  -- Level, Room, Game
+  gcall("Level", "HasPhotoDoor", 0x0074f030, "", "bool")
+  gcall("Room", "CanPickupGridEntity", 0x00825730, "i", "bool")
+  gcall("Room", "CanSpawnObstacleAtPosition", 0x00822820, "i;b=false", "bool")
+  gcall("Room", "GetBossVictoryJingle", 0x00820720, "", "uint")
+  method("Game", "IsHardMode", function() return (call(0x006f8100, nil) & 0xff) ~= 0 end)
+else
+  log("api_census: api_game.lua's gcall is missing; the calls into the game are left out")
+end
