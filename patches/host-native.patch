+end)
+
+-- 7. Guppy's Eye ghosts
+local function ghost_of(variant)
+  local e = pickups(variant)[1]
+  if not e then return nil end
+  return B.r32(B.ptr(e) + 0x590)
+end
+-- no Guppy's Eye: the game gives no ghost; the callback's true makes one
+step(function()
+  clear_pickups()
+  for _, n in ipairs(NAMES) do reset(n) end
+  local p = pl()
+  Isaac.Spawn(5, 50, 0, Vector(p.Position.X + 80, p.Position.Y), Vector(0, 0), nil)
+  wait("quiet frames", 30, function() return false end)
+end)
+step(function()
+  base.g0 = ghost_of(50)
+  say("no Guppy's Eye, no answer: chest ghost " .. tostring(base.g0) .. ", callback calls " .. count("MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS"))
+  check(count("MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS") >= 1, "MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS fires")
+  local r = last("MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS")
+  if r then check(r.text:find("^pickup:50/%d+$") ~= nil, "args (chest): " .. r.text) end
+  check(base.g0 == 0, "the game alone gives the chest no ghost")
+  beh.MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS = function(pk) return true end
+  wait("ghost for the chest", 60, function() local g = ghost_of(50) return g and g ~= 0 end)
+end)
+step(function()
+  local g = ghost_of(50)
+  check(g ~= nil and g ~= 0, "answer true: the chest has a ghost without Guppy's Eye (" .. tostring(g) .. ")")
+  beh.MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS = function(pk) return false end
+  pl():AddCollectible(CollectibleType.COLLECTIBLE_GUPPYS_EYE, 0, false)
+  wait("ghost removed", 60, function() return ghost_of(50) == 0 end)
+end)
+step(function()
+  check(ghost_of(50) == 0, "answer false: the ghost is removed even with Guppy's Eye (" .. tostring(ghost_of(50)) .. ")")
+  beh.MC_PRE_PICKUP_UPDATE_GHOST_PICKUPS = nil
+end)
+
+local frame, idx = 0, 0
+mod:AddCallback(M.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame < 5 then return end
+  if waiting then
+    if wait_cond() then
+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        check(false, "timed out waiting for " .. wait_what)
+        waiting = false
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  idx = idx + 1
+  local f = steps[idx]
+  if not f then
+    if idx == #steps + 1 then B.log(string.format("lab_cb_b: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. idx .. " raised: " .. tostring(err)) end
+end)
diff --git a/scripts/recomp/rgon/lab_cb_c.lua b/scripts/recomp/rgon/lab_cb_c.lua
new file mode 100644
index 0000000..b04e2f0
--- /dev/null
+++ b/scripts/recomp/rgon/lab_cb_c.lua
@@ -0,0 +1,434 @@
+-- lab_cb_c.lua (development only; ISAAC_RGON_LAB=lab_cb_c.lua, worker cb-c)
+-- Fires the callbacks of the "grid entities" group and checks their arguments and what an answer does:
+-- grid update (door, pit, poop, rock, trapdoor), grid render (door, trapdoor, wall), MC_POST_GRID_ROCK_DESTROY,
+-- MC_GRID_HURT_DAMAGE / MC_POST_GRID_HURT_DAMAGE and the grid collision callbacks of tears, bombs, pickups, projectiles,
+-- NPCs, familiars and the player.
+-- Prints "lab_cb_c: DONE n PASS m FAIL". Steps run one after another on MC_POST_UPDATE; a step that waits has a frame limit.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mod = RegisterMod("rgon lab cb-c", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_cb_c: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_cb_c: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+local rec, beh = {}, {}
+local function count(n) return #(rec[n] or {}) end
+local function last(n) local l = rec[n] return l and l[#l] end
+local function reset(n) rec[n] = {} end
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.Type ~= nil and v.Variant ~= nil and v.GetData then return "ent:" .. v.Type .. "." .. v.Variant end
+      if v.GetGridIndex then return "grid:" .. v:GetType() .. "@" .. v:GetGridIndex() end
+      if v.X ~= nil then return string.format("vec:%.0f,%.0f", v.X, v.Y) end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local NAMES = {
+  "MC_PRE_GRID_ENTITY_DOOR_UPDATE", "MC_POST_GRID_ENTITY_DOOR_UPDATE", "MC_PRE_GRID_ENTITY_PIT_UPDATE", "MC_POST_GRID_ENTITY_PIT_UPDATE",
+  "MC_PRE_GRID_ENTITY_POOP_UPDATE", "MC_POST_GRID_ENTITY_POOP_UPDATE", "MC_PRE_GRID_ENTITY_ROCK_UPDATE", "MC_POST_GRID_ENTITY_ROCK_UPDATE",
+  "MC_PRE_GRID_ENTITY_TRAPDOOR_UPDATE", "MC_POST_GRID_ENTITY_TRAPDOOR_UPDATE",
+  "MC_PRE_GRID_ENTITY_DOOR_RENDER", "MC_POST_GRID_ENTITY_DOOR_RENDER", "MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER", "MC_POST_GRID_ENTITY_TRAPDOOR_RENDER",
+  "MC_PRE_GRID_ENTITY_WALL_RENDER", "MC_POST_GRID_ENTITY_WALL_RENDER",
+  "MC_POST_GRID_ROCK_DESTROY", "MC_GRID_HURT_DAMAGE", "MC_POST_GRID_HURT_DAMAGE",
+  "MC_PRE_PLAYER_GRID_COLLISION", "MC_PLAYER_GRID_COLLISION", "MC_PRE_TEAR_GRID_COLLISION", "MC_TEAR_GRID_COLLISION",
+  "MC_PRE_FAMILIAR_GRID_COLLISION", "MC_FAMILIAR_GRID_COLLISION", "MC_PRE_BOMB_GRID_COLLISION", "MC_BOMB_GRID_COLLISION",
+  "MC_PRE_PICKUP_GRID_COLLISION", "MC_PICKUP_GRID_COLLISION", "MC_PRE_PROJECTILE_GRID_COLLISION", "MC_PROJECTILE_GRID_COLLISION",
+  "MC_PRE_NPC_GRID_COLLISION", "MC_NPC_GRID_COLLISION",
+}
+for _, n in ipairs(NAMES) do
+  local id = M[n]
+  if not id then
+    check(false, n .. " has a ModCallbacks number")
+  else
+    mod:AddCallback(id, function(_, ...)
+      local a = {}
+      for i = 1, select("#", ...) do a[#a + 1] = tos((select(i, ...))) end
+      local l = rec[n] or {}
+      rec[n] = l
+      local r = { n = select("#", ...), ... }
+      r.text = table.concat(a, ",")
+      l[#l + 1] = r
+      if #l <= 3 then say(string.format("%s #%d (%s)", n, #l, r.text)) end
+      local f = beh[n]
+      if f then return f(...) end
+    end)
+  end
+end
+
+local game = Game()
+local GT = GridEntityType
+local function room() return game:GetRoom() end
+local function pl() return Isaac.GetPlayer(0) end
+local W
+local function idx(col, row) return row * W + col end
+local function pos(col, row) return room():GetGridPosition(idx(col, row)) end
+local function grid(col, row) return room():GetGridEntity(idx(col, row)) end
+
+local base = {}
+local steps = {}
+local function step(f) steps[#steps + 1] = f end
+local waiting, wait_left, wait_what, wait_cond
+local function wait(what, frames, cond)
+  waiting, wait_left, wait_what, wait_cond = true, frames, what, cond
+end
+local function clear_all()
+  for _, n in ipairs(NAMES) do reset(n) beh[n] = nil end
+end
+
+-- 0. setup: the room's size, the grid entities
+step(function()
+  W = room():GetGridWidth()
+  say("room " .. W .. "x" .. room():GetGridHeight() .. " type " .. room():GetType())
+  local seen = {}
+  for i = 0, room():GetGridSize() - 1 do
+    local g = room():GetGridEntity(i)
+    if g then seen[g:GetType()] = (seen[g:GetType()] or 0) + 1 end
+  end
+  local s = {}
+  for t, n in pairs(seen) do s[#s + 1] = t .. "x" .. n end
+  say("grid entity types here: " .. table.concat(s, " "))
+  clear_all()
+  Isaac.GridSpawn(GT.GRID_PIT, 0, pos(2, 2), true)
+  Isaac.GridSpawn(GT.GRID_POOP, 0, pos(12, 2), true)
+  Isaac.GridSpawn(GT.GRID_ROCK, 0, pos(2, 6), true)
+  Isaac.GridSpawn(GT.GRID_TRAPDOOR, 0, pos(12, 6), true)
+  Isaac.GridSpawn(GT.GRID_WALL, 0, pos(7, 1), true)
+end)
+
+-- 1. update and render callbacks
+step(function()
+  local pairs_ = {
+    { "MC_PRE_GRID_ENTITY_DOOR_UPDATE", "MC_POST_GRID_ENTITY_DOOR_UPDATE", GT.GRID_DOOR },
+    { "MC_PRE_GRID_ENTITY_PIT_UPDATE", "MC_POST_GRID_ENTITY_PIT_UPDATE", GT.GRID_PIT },
+    { "MC_PRE_GRID_ENTITY_POOP_UPDATE", "MC_POST_GRID_ENTITY_POOP_UPDATE", GT.GRID_POOP },
+    { "MC_PRE_GRID_ENTITY_ROCK_UPDATE", "MC_POST_GRID_ENTITY_ROCK_UPDATE", GT.GRID_ROCK },
+    { "MC_PRE_GRID_ENTITY_TRAPDOOR_UPDATE", "MC_POST_GRID_ENTITY_TRAPDOOR_UPDATE", GT.GRID_TRAPDOOR },
+  }
+  for _, p in ipairs(pairs_) do
+    local a, b = last(p[1]), last(p[2])
+    check(count(p[1]) > 0 and count(p[2]) > 0, p[1] .. " and the post fired: " .. count(p[1]) .. " / " .. count(p[2]))
+    local g = a and a[1]
+    check(g and g:GetType() == p[3] and a.n == 1, p[1] .. " gets (grid of type " .. p[3] .. "): " .. tostring(a and a.text))
+    check(b and b[1] and b[1]:GetType() == p[3], p[2] .. " gets the same: " .. tostring(b and b.text))
+  end
+  local toks = { { "MC_PRE_GRID_ENTITY_DOOR_RENDER", GT.GRID_DOOR }, { "MC_POST_GRID_ENTITY_DOOR_RENDER", GT.GRID_DOOR },
+                 { "MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER", GT.GRID_TRAPDOOR }, { "MC_POST_GRID_ENTITY_TRAPDOOR_RENDER", GT.GRID_TRAPDOOR },
+                 { "MC_PRE_GRID_ENTITY_WALL_RENDER", GT.GRID_WALL }, { "MC_POST_GRID_ENTITY_WALL_RENDER", GT.GRID_WALL } }
+  for _, p in ipairs(toks) do
+    local a = last(p[1])
+    check(a and a.n == 2 and a[1]:GetType() == p[2] and a[2].X ~= nil, p[1] .. " gets (grid " .. p[2] .. ", offset): " .. tostring(a and a.text) .. " x" .. count(p[1]))
+  end
+  -- the answers: a boolean on a PRE update skips the game's update (the post then stays quiet)
+  for _, p in ipairs(pairs_) do beh[p[1]] = function() return true end end
+  for _, p in ipairs(pairs_) do reset(p[2]) end
+  wait("a few frames", 10, function() return false end)
+end)
+step(function()
+  for _, n in ipairs({ "DOOR", "PIT", "POOP", "ROCK", "TRAPDOOR" }) do
+    check(count("MC_POST_GRID_ENTITY_" .. n .. "_UPDATE") == 0, "answer true on MC_PRE_GRID_ENTITY_" .. n .. "_UPDATE skips the update: post fired " .. count("MC_POST_GRID_ENTITY_" .. n .. "_UPDATE") .. " times")
+  end
+  for _, n in ipairs({ "DOOR", "PIT", "POOP", "ROCK", "TRAPDOOR" }) do beh["MC_PRE_GRID_ENTITY_" .. n .. "_UPDATE"] = nil end
+  -- render: true skips the drawing (post stays quiet)
+  beh.MC_PRE_GRID_ENTITY_DOOR_RENDER = function() return true end
+  beh.MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER = function() return true end
+  reset("MC_POST_GRID_ENTITY_DOOR_RENDER") reset("MC_POST_GRID_ENTITY_TRAPDOOR_RENDER")
+  wait("render frames", 10, function() return false end)
+end)
+step(function()
+  check(count("MC_POST_GRID_ENTITY_DOOR_RENDER") == 0, "answer true on MC_PRE_GRID_ENTITY_DOOR_RENDER: post fired " .. count("MC_POST_GRID_ENTITY_DOOR_RENDER"))
+  check(count("MC_POST_GRID_ENTITY_TRAPDOOR_RENDER") == 0, "answer true on MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER: post fired " .. count("MC_POST_GRID_ENTITY_TRAPDOOR_RENDER"))
+  beh.MC_PRE_GRID_ENTITY_DOOR_RENDER = nil
+  beh.MC_PRE_GRID_ENTITY_TRAPDOOR_RENDER = nil
+  beh.MC_PRE_GRID_ENTITY_WALL_RENDER = function() return nil end
+  reset("MC_POST_GRID_ENTITY_DOOR_RENDER")
+  -- a Vector answer moves the drawing: the post gets the new offset
+  beh.MC_PRE_GRID_ENTITY_DOOR_RENDER = function() return Vector(7, 9) end
+  wait("render frames", 6, function() return false end)
+end)
+step(function()
+  local a = last("MC_POST_GRID_ENTITY_DOOR_RENDER")
