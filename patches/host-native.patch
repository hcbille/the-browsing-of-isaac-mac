index 0000000..8ca40a1
--- /dev/null
+++ b/scripts/recomp/rgon/api_state_getters.lua
@@ -0,0 +1,189 @@
+-- api_state_getters.lua -- census batch B3 (M8): small state getters, each field measured in THIS executable (v1.9.7.17)
+-- (lab_state_probe.lua: the structure diffed while the game changed it, the sprites inside it, and the game's own code
+-- that reads it, found with pequery.py fieldrefs / callers). REPENTOGON's offsets are for v1.9.7.12; the shifts are:
+--
+--   what                    REPENTOGON  here            how it was measured
+--   Game: pause screen      +0x2363c    +0x23a74 (+0x438)  the only word that went 0 -> 1 while Escape held the pause menu
+--                                       open and back to 0 after it; its four sprites (mainsprite at +0x2c, mini sprite
+--                                       +0x140, stats +0x254, my stuff +0x368, each a self pointer at +0x30/+0x50) sit
+--                                       exactly there (0x23aa0, 0x23bb4, 0x23cc8, 0x23ddc). State: 0 closed, 1 open
+--                                       (2 options, not seen here). Game:IsPauseMenuOpen is `state > 0`, as REPENTOGON
+--   Game: generic prompt    +0x25cf0    +0x26778 (+0xa88)  the same shift the minimap and the frame counter have
+--                                       (api_minimap.lua, api_more.lua); the object starts with its ANM2, a sprite with
+--                                       self pointers there. GenericPrompt::IsActive is the game's own function 0x00838210
+--                                       (REPENTOGON's signature matches once; asm: `cmp [ecx+0x34],0 / je / cmp byte
+--                                       [ecx+0x44],0`, bool in AL, plain `ret`, no stack argument)
+--   MenuManager: daily run  +0xdd0      +0xdd4 (+4)        like the character menu (api_menus.lua, +4): the game's own
+--                                       manager render calls Menu_DailyChallenge::Render (0x008cfd40) with
+--                                       `lea ecx,[manager+0xdd4]`; that function reads the menu's pointer position at +0xc/+0x10
+--                                       and its sprite at +0x14 (self pointers at manager+0xde8); State is +0; its render
+--                                       prints the time left (+0x12c/+0x130/+0x134) when State is not 0, else 00:00:00
+--   Entity_NPC: Delirium    +0xbc8..    +0xbc8..           the same offsets: Delirium's AI function (0x004a6500) reads and writes
+--                                       boss type [+0xbc8] (compares with 0x111) and variant [+0xbcc] (compares with 0xa)
+--                                       as a pair, the 16-bit timer [+0xbd0] with word instructions, and [+0xbe0] with
+--                                       `and 0x1ffffff`; on a spawned Delirium the type reads 412 (its own), the variant 0,
+--                                       and the timer counts down by one a frame (270, 262 ... 2) and is reloaded at 0
+--
+-- Done here: Game.IsPauseMenuOpen / GetPauseMenuState / GetGenericPrompt, GenericPrompt.IsActive, PauseMenu.GetState/SetState,
+-- DailyChallengeMenu.GetState/SetState, EntityDelirium BossType, BossVariant, Cycle, TransformationTimer, and
+-- RoomDescriptor.GetDimension counted from load (api_more.lua installs the method itself at the first player init).
+-- Not done: GenericPrompt's constructor (the game's own constructor and the object's size 0x134 are not checked) and its other
+-- functions; the selected elements of the two menus; Delirium's other fields (their bit layout was not worked out).
+
+local T = ...
+local B, R, method, property = T.B, T.R, T.method, T.property
+local r8, r16, r32, ri32, w16, w32, call, log = B.r8, B.r16, B.r32, B.ri32, B.w16, B.w32, B.call, B.log
+local type, error, rawget, rawset, setmetatable, tostring, getmetatable = type, error, rawget, rawset, setmetatable, tostring, getmetatable
+local mathtype = math.type
+
+local GAME_PTR, MM_PTR = 0x00c71678, 0x00c72a20
+local PAUSE_SCREEN, GENERIC_PROMPT = 0x23a74, 0x26778
+local DAILY_MENU = 0xdd4
+local PROMPT_IS_ACTIVE = 0x00838210
+local DELIRIUM = 412
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. (v == nil and "no value" or type(v)) .. ")", 3) end
+  return v
+end
+local function game(what)
+  local g = r32(GAME_PTR)
+  if g == 0 then error(what .. ": there is no game yet", 3) end
+  return g
+end
+local function manager(what)
+  local mm = r32(MM_PTR)
+  if mm == 0 then error(what .. ": the main menu does not exist (it is only there outside a run's first frames)", 3) end
+  return mm
+end
+
+------------------------------------------------------------------------------
+-- RoomDescriptor.GetDimension: api_more.lua puts the method on the tables of a real descriptor at the first player's init;
+-- the global's own table gets it here, so it exists (and counts) from load, as it does for a mod that calls it later.
+------------------------------------------------------------------------------
+do
+  local function dimension_of(desc)
+    local level = Game():GetLevel()
+    local me, idx = GetPtrHash(desc), desc.SafeGridIndex
+    for dim = 0, 2 do
+      local d = level:GetRoomByIdx(idx, dim)
+      if d ~= nil and GetPtrHash(d) == me then return dim end
+    end
+    return 0
+  end
+  method("RoomDescriptor", "GetDimension", dimension_of)       -- (counts it, unless the global has no class table to hold it)
+end
+
+------------------------------------------------------------------------------
+-- Game: the pause screen and the generic prompt
+------------------------------------------------------------------------------
+local function pause_state() return ri32(game("PauseMenu") + PAUSE_SCREEN) end
+method("Game", "IsPauseMenuOpen", function() return pause_state() > 0 end)
+method("Game", "GetPauseMenuState", function() return pause_state() end)
+
+-- GenericPrompt: a Lua class around the game's object (its address); only IsActive. Game:GetGenericPrompt() is the game's own one.
+local GenericPrompt = rawget(_G, "GenericPrompt")
+if GenericPrompt == nil then
+  GenericPrompt = { __type = "GenericPrompt", __name = "GenericPrompt" }
+  GenericPrompt.__index = GenericPrompt
+  rawset(_G, "GenericPrompt", GenericPrompt)
+end
+local prompts = setmetatable({}, { __mode = "v" })
+local function prompt_at(address)
+  local p = prompts[address]
+  if not p then
+    p = setmetatable({ address = address }, GenericPrompt)
+    prompts[address] = p
+  end
+  return p
+end
+T.generic_prompt = prompt_at                -- (address) for a lab that wants a prompt of its own
+function GenericPrompt.IsActive(self)
+  if type(self) ~= "table" or getmetatable(self) ~= GenericPrompt then error("bad argument #1 to 'IsActive' (GenericPrompt expected, got " .. type(self) .. ")", 2) end
+  return (call(PROMPT_IS_ACTIVE, self.address) & 0xff) ~= 0
+end
+R.Implemented["GenericPrompt.IsActive"] = true
+method("Game", "GetGenericPrompt", function() return prompt_at(game("Game:GetGenericPrompt") + GENERIC_PROMPT) end)
+
+------------------------------------------------------------------------------
+-- PauseMenu, DailyChallengeMenu: tables of functions called with '.', as REPENTOGON's are
+------------------------------------------------------------------------------
+local function table_global(name)
+  local t = rawget(_G, name)
+  if type(t) ~= "table" then
+    t = {}
+    rawset(_G, name, t)
+  end
+  return t
+end
+do
+  local PM = table_global("PauseMenu")
+  if rawget(PM, "GetState") == nil then
+    function PM.GetState() return pause_state() end
+    function PM.SetState(state)
+      state = int_arg(state, 1, "SetState")
+      w32(game("PauseMenu.SetState") + PAUSE_SCREEN, state & 0xffffffff)
+    end
+    R.Implemented["PauseMenu.GetState"] = true
+    R.Implemented["PauseMenu.SetState"] = true
+  end
+  local DM = table_global("DailyChallengeMenu")
+  if rawget(DM, "GetState") == nil then
+    function DM.GetState() return ri32(manager("DailyChallengeMenu.GetState") + DAILY_MENU) end
+    function DM.SetState(state)
+      state = int_arg(state, 1, "SetState")
+      w32(manager("DailyChallengeMenu.SetState") + DAILY_MENU, state & 0xffffffff)
+    end
+    R.Implemented["DailyChallengeMenu.GetState"] = true
+    R.Implemented["DailyChallengeMenu.SetState"] = true
+  end
+end
+
+------------------------------------------------------------------------------
+-- EntityDelirium: the variables, on the NPC (Entity:ToDelirium answers with the NPC). A Delirium is the NPC of type 412 or
+-- one that has transformed into a boss: then its own type and variant are the boss type and variant it holds (REPENTOGON's
+-- rule for ToDelirium). Any other NPC answers nil.
+------------------------------------------------------------------------------
+do
+  local BOSS_TYPE, BOSS_VARIANT, TIMER, CYCLE = 0xbc8, 0xbcc, 0xbd0, 0xbe0
+  local function delirium_at(self)
+    local a = B.ptr(self)
+    if a == 0 then error("rgon: a Delirium variable was read without its object (use ':')", 3) end
+    if self.Type == DELIRIUM or (r32(a + BOSS_TYPE) == self.Type and r32(a + BOSS_VARIANT) == self.Variant and self.Type ~= 0) then return a end
+    return nil
+  end
+  property("EntityNPC", "BossType", function(self) local a = delirium_at(self) return a and ri32(a + BOSS_TYPE) or nil end)
+  property("EntityNPC", "BossVariant", function(self) local a = delirium_at(self) return a and ri32(a + BOSS_VARIANT) or nil end)
+  property("EntityNPC", "TransformationTimer",
+    function(self) local a = delirium_at(self) return a and r16(a + TIMER) or nil end,
+    function(self, v)
+      local a = delirium_at(self)
+      if not a then error("rgon: TransformationTimer is only for Delirium", 2) end
+      w16(a + TIMER, int_arg(v, 2, "TransformationTimer") & 0xffff)
+    end)
+  property("EntityNPC", "Cycle",
+    function(self) local a = delirium_at(self) return a and ri32(a + CYCLE) or nil end,
+    function(self, v)
+      local a = delirium_at(self)
+      if not a then error("rgon: Cycle is only for Delirium", 2) end
+      w32(a + CYCLE, int_arg(v, 2, "Cycle") & 0xffffffff)
+    end)
+
+  for _, n in ipairs({ "BossType", "BossVariant", "TransformationTimer", "Cycle" }) do
+    R.Implemented["EntityNPC." .. n] = nil                    -- property() names the class it is put on; the census name is EntityDelirium's
+    R.Implemented["EntityDelirium." .. n] = true
+  end
+
+  -- Entity:ToDelirium (api_more.lua answers for type 412 only): also a Delirium that has transformed into a boss
+  for _, c in pairs({ T.class_tables("Entity") }) do
+    if type(c) == "table" and rawget(c, "ToDelirium") ~= nil then
+      rawset(c, "ToDelirium", B.cfn(function(self)
+        local npc = self:ToNPC()
+        if npc == nil then return nil end
+        if delirium_at(npc) == nil then return nil end
+        return npc
+      end))
+    end
+  end
+end
diff --git a/scripts/recomp/rgon/api_tears_more.lua b/scripts/recomp/rgon/api_tears_more.lua
new file mode 100644
index 0000000..bd7c0ae
--- /dev/null
+++ b/scripts/recomp/rgon/api_tears_more.lua
@@ -0,0 +1,444 @@
+-- api_tears_more.lua -- the rest of REPENTOGON's EntityTear, EntityLaser, EntityKnife, EntityEffect and
+-- EntityProjectile names, and TearParams' four fields. Written against REPENTOGON's behaviour (LuaInterfaces/
+-- Entities/Lua*.cpp); every offset and address was measured in THIS executable (v1.9.7.17), by lab_tears_more.lua
+-- and the probes lab_tears_probe*.lua, and is named where it is used. Lua only: no engine hook (what REPENTOGON
+-- does with an ASM patch is done here by the layer's own callback listener or by the game's own field).
+--
+--   TearParams (0x64 bytes, as REPENTOGON): +0x54 mass multiplier, +0x58 knockback multiplier, +0x5c speed
+--     multiplier (floats), +0x60 tear displacement (int). Seen in a TearParams the game made (defaults 1, 1.7,
+--     1, 1 next to the damage 3.5 at +0x48, the scale at +0x4c and the height at +0x50 that the game's own
+--     properties answer).
+--   EntityTear: hit list = the vector at 0x444 (api_game.lua), tear index 0x450 (the backdrop of a variant 40 grid
+--     tear), scale animation number 0x45c (the tear's ResetSpriteScale 0x00677780 compares it with the one the
+--     scale needs and redraws only when they differ: writing -1 forces it, REPENTOGON's `Force`), the
+--     multidimensional-touched byte 0x468. Init sound: the tear's first Update (vtable slot 3, 0x006670f0) calls
+--     init_tear 0x00666d40 while the byte 0x46a is set; init_tear plays the fire sound unless the variant is
+--     9, 0x2e or 0x28 or the byte 0x7ea is set (`cmp byte [edi+0x7ea], 0; jne` at 0x00666d69).
+--   EntityLaser: timeout 0x458, shrink 0x45e, disable-follow-parent 0x4e4, scale 0x4e0, one-hit 0x515, hit list
+--     0x520 (REPENTOGON's layout, each read where the game's own property answers the same). ResetSpriteScale is
+--     0x0097fc10 (thiscall, plain ret; the game's own scale setter code at 0x00977668 calls it right after
+--     writing 0x4e0; REPENTOGON's signature for it matches nothing here). RotateToAngle is 0x0096f470 (angle in
+--     xmm1, speed in xmm2, plain ret). The samples (HomingLaser at 0x464) are four std::vectors: 0x480, 0x48c,
+--     0x498 and the bezier vector 0x4ac.
+--   EntityKnife: InitHomingPath 0x00961320 (ecx = knife, the direction's two floats and the source on the stack,
+--     the path offset in xmm3, `ret 0xc`). GetHitboxParentKnife stays deferred (api_batch_two.lua): measured on a
+--     bone club's hitbox knife (SubType 4), its Parent (0x3bc) is the player and the byte 0x4e7 is 0, so the game
+--     keeps no link to the main knife; REPENTOGON records it with an ASM patch in update_bone_swing.
+--   EntityProjectile: Reflect 0x00652fa0 (thiscall, (unused entity, Vector* velocity), `ret 8`).
+--   EntityEffect: the variant data (BitSet128, REPENTOGON's tear flags of the Aquarius creep, the brimstone ball,
+--     the tech dot and the chain lightning) at 0x420; CreateLight is variant 121 with state, timeout, lifespan,
+--     colour and the sprite scale set after the spawn.
+
+local T = ...
+local B, R, method, property, static, wrap, this, class_tables = T.B, T.R, T.method, T.property, T.static, T.wrap, T.this, T.class_tables
+local ptr, r8, r32, ri32, rf32, w8, w32, wf32, log, call = B.ptr, B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.log, B.call
+local type, pcall, rawget, rawset, ipairs, pairs, tostring = type, pcall, rawget, rawset, ipairs, pairs, tostring
+local mathtype = math.type
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function num_arg(v, n, what)
+  if type(v) ~= "number" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function bool_arg(v, n, what)
+  if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. what .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+local function userdata_arg(v, n, what, cls)
+  if type(v) ~= "userdata" or ptr(v) == 0 then error("bad argument #" .. n .. " to '" .. what .. "' (" .. cls .. " expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+-- a method of a class the game already has (its own C function is kept as `orig` and may be called)
+local function override(cls, name, f)
+  local c, const = class_tables(cls)
+  if not c then log("api_tears_more: no class " .. cls .. " for " .. name) return end
+  local wrapped = B.cfn(f)
+  rawset(c, name, wrapped)
+  if const and rawget(const, name) ~= nil then rawset(const, name, wrapped) end
+  R.Implemented[cls .. "." .. name] = true
+end
+
+------------------------------------------------------------------------------
+-- TearParams
+------------------------------------------------------------------------------
+do
+  local function f32(name, off, positive)
+    property("TearParams", name, function(self) return rf32(this(self, name) + off) end, function(self, v)
+      num_arg(v, 2, name)
+      if positive and v <= 0 then error("bad argument #2 to '" .. name .. "' (" .. name .. " must be positive!)", 2) end
+      wf32(this(self, name) + off, v)
+    end)
+  end
+  f32("MassMultiplier", 0x54, true)
+  f32("KnockbackMultiplier", 0x58, true)
+  f32("SpeedMultiplier", 0x5c, false)
+  property("TearParams", "TearDisplacement", function(self) return ri32(this(self, "TearDisplacement") + 0x60) end, function(self, v)
+    v = int_arg(v, 2, "TearDisplacement")
+    if v < -1 or v > 1 then error("bad argument #2 to 'TearDisplacement' (TearDisplacement may only be set to -1 or 1)", 2) end
+    w32(this(self, "TearDisplacement") + 0x60, v & 0xffffffff)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- hit lists (std::vector<unsigned> of Entity:GetHitListIndex values): EntityTear at 0x444, EntityLaser at 0x520
+------------------------------------------------------------------------------
+do
+  local function vec(self, what, off)
+    local v = this(self, what) + off
+    local first, last, cap = r32(v), r32(v + 4), r32(v + 8)
+    if last < first or last - first > 0x10000 or (last - first) % 4 ~= 0 then error("rgon: this entity's hit list is not laid out as expected", 3) end
+    return v, first, last, cap
+  end
+  local function index_of(entity, n, what)
+    userdata_arg(entity, n, what, "Entity")
+    return entity:GetHitListIndex()
+  end
+  local function define(cls, off)
+    method(cls, "InHitList", function(self, entity)
+      local idx = index_of(entity, 1, "InHitList")
+      local _, first, last = vec(self, "InHitList", off)
+      for a = first, last - 4, 4 do if r32(a) == idx then return true end end
+      return false
+    end)
+    method(cls, "AddToHitList", function(self, entity)
+      local idx = index_of(entity, 1, "AddToHitList")
+      local v, first, last, cap = vec(self, "AddToHitList", off)
+      for a = first, last - 4, 4 do if r32(a) == idx then return end end
+      if last >= cap then
+        -- grow as the game's vector does: a new buffer from the game's allocator, the old one freed
+        local n = (last - first) // 4
+        local new = B.alloc(4 * (n * 2 + 4))
+        if new == 0 then error("rgon: out of memory growing a hit list", 2) end
+        for i = 0, n - 1 do w32(new + 4 * i, r32(first + 4 * i)) end
+        if first ~= 0 then B.free(first) end
+        w32(v, new)
+        first, last = new, new + 4 * n
+        w32(v + 8, new + 4 * (n * 2 + 4))
+      end
+      w32(last, idx)
+      w32(v + 4, last + 4)
+    end)
+    method(cls, "RemoveFromHitList", function(self, entity)
+      local idx = index_of(entity, 1, "RemoveFromHitList")
+      local v, first, last = vec(self, "RemoveFromHitList", off)
+      for a = first, last - 4, 4 do
+        if r32(a) == idx then
+          w32(a, r32(last - 4))               -- swap with the last entry and drop it, as REPENTOGON does
+          w32(v + 4, last - 4)
+          return
+        end
+      end
+    end)
+  end
+  define("EntityTear", 0x444)
+  define("EntityLaser", 0x520)
+end
+
+------------------------------------------------------------------------------
+-- EntityTear
+------------------------------------------------------------------------------
+method("EntityTear", "SetMultidimensionalTouched", function(self, v)
+  bool_arg(v, 1, "SetMultidimensionalTouched")
+  w8(this(self, "SetMultidimensionalTouched") + 0x468, v and 1 or 0)
+end)
+
+-- the backdrop of a grid tear (variant 40) is its tear index
+method("EntityTear", "SetBackdropType", function(self, backdrop)
+  local a = this(self, "SetBackdropType")
+  backdrop = int_arg(backdrop, 1, "SetBackdropType")
+  if backdrop >= 0 and ri32(a + 0x2c) == 40 then w32(a + 0x450, backdrop & 0xffffffff) end
+end)
+method("EntityTear", "GetBackdropType", function(self)
+  local a = this(self, "GetBackdropType")
+  if ri32(a + 0x2c) == 40 then return ri32(a + 0x450) end
+  return 0
+end)
+
+-- ResetSpriteScale(force = false): the game's own, after forgetting which scale animation the tear shows
+do
+  local c = class_tables("EntityTear")
+  local orig = rawget(c, "ResetSpriteScale")
+  if orig then
+    override("EntityTear", "ResetSpriteScale", function(self, force)
+      if force ~= nil and type(force) ~= "boolean" then error("bad argument #2 to 'ResetSpriteScale' (boolean expected, got " .. type(force) .. ")", 2) end
+      if force then w32(this(self, "ResetSpriteScale") + 0x45c, 0xffffffff) end
+      return orig(self)
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- SetInitSound (EntityTear, EntityLaser): SOUND_NULL turns the game's sound off with the game's own byte; any
+-- other sound turns it off too and plays the chosen one at the entity's first update, where the game plays its
+-- own (REPENTOGON swaps the sound inside the game's call; no hook here)
+------------------------------------------------------------------------------
+do
+  local pending = { tear = {}, laser = {} }
+  local listening = {}
+  local LAYER_PLAY = function(id)
+    local ok, err = pcall(function() SFXManager():Play(id, 1.0, 2, false, 1.0, 0) end)
+    if not ok then log("api_tears_more: could not play sound " .. tostring(id) .. ": " .. tostring(err)) end
+  end
+  local function arm(kind, callback)
+    if listening[kind] or not T.listen or not callback then return end
+    listening[kind] = true
+    T.listen(callback, function(_, e)
+      local p = ptr(e)
+      local s = pending[kind][p]
+      if s then pending[kind][p] = nil LAYER_PLAY(s) end
+    end, -math.huge)
+  end
+  if T.listen and ModCallbacks.MC_POST_NEW_ROOM then
+    T.listen(ModCallbacks.MC_POST_NEW_ROOM, function() pending.tear, pending.laser = {}, {} end, -math.huge)
+  end
+  local function sound_arg(sound, what)
+    sound = int_arg(sound, 1, what)
+    if sound < 0 then error("bad argument #1 to '" .. what .. "' (Invalid SoundEffect)", 3) end
+    return sound
+  end
+  -- the byte that silences the game's own sound, and the byte that says the first update (which plays it) is still to come
+  T.init_sound_tear = function(a, sound)
+    if r8(a + 0x46a) == 0 then return end                     -- init_tear already ran: too late, as in REPENTOGON
+    w8(a + 0x7ea, 1)
+    if sound ~= 0 then pending.tear[a] = sound else pending.tear[a] = nil end
+    arm("tear", ModCallbacks.MC_POST_TEAR_UPDATE)
+  end
+  T.init_sound_laser = function(a, sound)
+    w8(a + 0x518, 1)
+    if sound ~= 0 then pending.laser[a] = sound else pending.laser[a] = nil end
+    arm("laser", ModCallbacks.MC_POST_LASER_UPDATE)
+  end
+  method("EntityTear", "SetInitSound", function(self, sound)
+    T.init_sound_tear(this(self, "SetInitSound"), sound_arg(sound, "SetInitSound"))
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityLaser
+------------------------------------------------------------------------------
+do
+  local L = "EntityLaser"
+  local function bool_at(get, set, off)
+    if get then method(L, get, function(self) return r8(this(self, get) + off) ~= 0 end) end
+    if set then
+      method(L, set, function(self, v)
+        bool_arg(v, 1, set)
+        w8(this(self, set) + off, v and 1 or 0)
+      end)
+    end
+  end
+  bool_at("GetShrink", "SetShrink", 0x45e)
+  bool_at("GetDisableFollowParent", "SetDisableFollowParent", 0x4e4)
+  bool_at("GetOneHit", nil, 0x515)
+  override(L, "SetMultidimensionalTouched", function(self, v)
+    bool_arg(v, 1, "SetMultidimensionalTouched")
+    w8(this(self, "SetMultidimensionalTouched") + 0x500, v and 1 or 0)
+  end)
+  method(L, "GetTimeout", function(self) return ri32(this(self, "GetTimeout") + 0x458) end)
+  override(L, "SetTimeout", function(self, v) w32(this(self, "SetTimeout") + 0x458, int_arg(v, 1, "SetTimeout") & 0xffffffff) end)
+
+  local RESET = 0x0097fc10
+  method(L, "ResetSpriteScale", function(self) call(RESET, this(self, "ResetSpriteScale")) end)
+  method(L, "SetScale", function(self, v)
+    local a = this(self, "SetScale")
+    wf32(a + 0x4e0, num_arg(v, 1, "SetScale"))
+    call(RESET, a)
+  end)
+  method(L, "RotateToAngle", function(self, angle, speed)
+    local a = this(self, "RotateToAngle")
+    if speed == nil then speed = 8.0 end
+    call(0x0096f470, { ecx = a, xmm1 = num_arg(angle, 1, "RotateToAngle"), xmm2 = num_arg(speed, 2, "RotateToAngle") })
+  end)
+
+  -- the game rebuilds a laser's samples when its sample lists are empty: empty them (REPENTOGON does it at the start of
+  -- the laser's next update, which is the same thing for a mod that changes the laser and expects new samples)
+  method(L, "RecalculateSamplesNextUpdate", function(self)
+    local a = this(self, "RecalculateSamplesNextUpdate")
+    for _, o in ipairs({ 0x480, 0x48c, 0x498, 0x4ac }) do
+      local first, last = r32(a + o), r32(a + o + 4)
+      if last >= first then w32(a + o + 4, first) end
+    end
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityKnife
+------------------------------------------------------------------------------
+do
+  -- InitHomingPath(direction, source = the knife's parent or itself)
+  method("EntityKnife", "InitHomingPath", function(self, dir, source)
+    local a = this(self, "InitHomingPath")
+    userdata_arg(dir, 1, "InitHomingPath", "Vector")
+    local src
+    if source ~= nil then
+      src = ptr(userdata_arg(source, 2, "InitHomingPath", "Entity"))
+    else
+      src = r32(a + 0x3bc)
+      if src == 0 then src = a end
+    end
+    local path = rf32(a + 0x4bc)                     -- the path offset the game keeps in the knife (PathOffset)
+    call(0x00961320, { ecx = a, xmm3 = path }, B.f2i(dir.X), B.f2i(dir.Y), src)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- EntityProjectile:Deflect(velocity)
+------------------------------------------------------------------------------
+method("EntityProjectile", "Deflect", function(self, vel)
+  local a = this(self, "Deflect")
+  userdata_arg(vel, 1, "Deflect", "Vector")
+  call(0x00652fa0, a, 0, ptr(vel))
+end)
+
+------------------------------------------------------------------------------
+-- EntityEffect: tear flags (only the variants that keep them there), CreateLight
+------------------------------------------------------------------------------
+do
+  local E = "EntityEffect"
+  local ALLOWED = { [54] = true, [113] = true, [126] = true, [167] = true }   -- Aquarius creep, brimstone ball, tech dot, chain lightning
+  local DATA = 0x420
+  local function allowed(a) return ALLOWED[ri32(a + 0x2c)] == true end
+  local function bits(f, n, what)
+    if type(f) ~= "userdata" then error("bad argument #" .. n .. " to '" .. what .. "' (BitSet128 expected, got " .. type(f) .. ")", 3) end
+    local ok, l, h = pcall(function() return f.l, f.h end)
+    if not ok or mathtype(l) ~= "integer" or mathtype(h) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (BitSet128 expected, got " .. type(f) .. ")", 3) end
+    return l, h
+  end
+  local function get64(a) return r32(a) | (r32(a + 4) << 32), r32(a + 8) | (r32(a + 12) << 32) end
+  local function put64(a, l, h)
+    w32(a, l & 0xffffffff) w32(a + 4, (l >> 32) & 0xffffffff)
+    w32(a + 8, h & 0xffffffff) w32(a + 12, (h >> 32) & 0xffffffff)
+  end
+  local function define(prefix)
+    method(E, "Get" .. prefix .. "TearFlags", function(self)
+      local a = this(self, "Get" .. prefix .. "TearFlags")
+      if not allowed(a) then return nil end
+      local l, h = get64(a + DATA)
+      return BitSet128(l, h)
+    end)
+    method(E, "Set" .. prefix .. "TearFlags", function(self, f)
+      local a = this(self, "Set" .. prefix .. "TearFlags")
+      local l, h = bits(f, 1, "Set" .. prefix .. "TearFlags")
+      if allowed(a) then put64(a + DATA, l, h) end
+    end)
+    method(E, "Add" .. prefix .. "TearFlags", function(self, f)
+      local a = this(self, "Add" .. prefix .. "TearFlags")
+      local l, h = bits(f, 1, "Add" .. prefix .. "TearFlags")
+      if allowed(a) then local cl, ch = get64(a + DATA) put64(a + DATA, cl | l, ch | h) end
+    end)
+    method(E, "Clear" .. prefix .. "TearFlags", function(self, f)
+      local a = this(self, "Clear" .. prefix .. "TearFlags")
+      local l, h = bits(f, 1, "Clear" .. prefix .. "TearFlags")
+      if allowed(a) then local cl, ch = get64(a + DATA) put64(a + DATA, cl & ~l, ch & ~h) end
+    end)
+    method(E, "Has" .. prefix .. "TearFlags", function(self, f)
+      local a = this(self, "Has" .. prefix .. "TearFlags")
+      local l, h = bits(f, 1, "Has" .. prefix .. "TearFlags")
+      if not allowed(a) then return false end
+      local cl, ch = get64(a + DATA)
+      return (cl & l) ~= 0 or (ch & h) ~= 0
+    end)
+  end
+  define("")
+  define("Aquarius")
+
+  -- EntityEffect.CreateLight(position, scale = random 0..1, lifespan = -1, state = 6, color = default) -> the effect
+  local EE = rawget(_G, "EntityEffect")
+  if type(EE) == "table" then
+    static(EE, "EntityEffect", "CreateLight", function(pos, scale, lifespan, state, color)
+      userdata_arg(pos, 1, "CreateLight", "Vector")
+      if scale == nil then scale = math.random() else num_arg(scale, 2, "CreateLight") end
+      lifespan = lifespan == nil and -1 or int_arg(lifespan, 3, "CreateLight")
+      state = state == nil and 6 or int_arg(state, 4, "CreateLight")
+      if color ~= nil and type(color) ~= "userdata" then error("bad argument #5 to 'CreateLight' (Color expected, got " .. type(color) .. ")", 2) end
+      if lifespan < 1 then lifespan = -1 end
+      if state < 1 then state = 6 end
+      local e = Isaac.Spawn(1000, 121, 0, pos, Vector(0, 0), nil)
+      if not e then return nil end
+      local fx = e:ToEffect()
+      fx.State = state
+      fx.Timeout = lifespan
+      fx.LifeSpan = lifespan
+      fx:SetColor(color or Color(1, 1, 1, 1, 0, 0, 0), -1, 255, false, false)
+      fx.SpriteScale = fx.SpriteScale * scale
+      return fx
+    end)
+  else
+    log("api_tears_more: no EntityEffect table; CreateLight left out")
+  end
+end
+
+------------------------------------------------------------------------------
+-- :FireSplitTear(position, velocity, damageMultiplier = 0.5, sizeMultiplier = 0.6, variant = 0, splitType = SPLIT_GENERIC)
+-- on EntityTear, EntityLaser and EntityKnife: a new tear that takes the source's flags, damage, size and colour
+------------------------------------------------------------------------------
+do
+  local SET_SCALE = 0x00676120                       -- Entity_Tear::SetScale(float), thiscall, ret 4
+  local function fire(self, pos, vel, dmul, smul, variant, split)
+    local src = self
+    userdata_arg(pos, 1, "FireSplitTear", "Vector")
+    userdata_arg(vel, 2, "FireSplitTear", "Vector")
+    dmul = dmul == nil and 0.5 or num_arg(dmul, 3, "FireSplitTear")
+    smul = smul == nil and 0.6 or num_arg(smul, 4, "FireSplitTear")
+    variant = variant == nil and 0 or int_arg(variant, 5, "FireSplitTear")
+    local kind = split == nil and (SplitTearType and SplitTearType.SPLIT_GENERIC or 0) or split
+    local damage, scale, flags, color = 3.5, 1.0, nil, nil
+    local t = src.Type
+    if t == 2 then
+      local s = src:ToTear()
+      damage, scale, flags, color = s.CollisionDamage, s.Scale, s.TearFlags, s:GetSprite().Color
+    elseif t == 7 then
+      local s = src:ToLaser()
+      damage, scale, flags, color = s.CollisionDamage, s:GetScale(), s.TearFlags, s:GetSprite().Color
+    elseif t == 8 then
+      local s = src:ToKnife()
+      damage, scale, flags, color = s.CollisionDamage, s.SpriteScale.Y, s.TearFlags, s:GetSprite().Color
+    end
+    damage = math.max(damage * dmul, 0.0)
+    scale = scale * smul
+    local l, h = flags.l, flags.h
+    h = h & ~(1 << 63)                              -- always drop the Ludovico flag
+    if variant ~= 50 then h = h & ~(1 << 50) end    -- and the fetus flag unless it is a fetus
+    local seed = Random() | 1
+    local new = Game():Spawn(2, variant, pos, vel, src.SpawnerEntity, 0, seed)
+    if not new then return nil end
+    new = new:ToTear()
+    local player
+    if t == 8 then
+      player = src.Parent and src.Parent:ToPlayer() or (src.SpawnerEntity and src.SpawnerEntity:ToPlayer())
+    else
+      local sp, par = src.SpawnerEntity, src.Parent
+      if sp and sp.Type == 1 then player = sp:ToPlayer() elseif par and par.Type == 1 then player = par:ToPlayer() end
+    end
+    local rng = RNG()
+    rng:SetSeed(new.InitSeed, 35)
+    local offset = 0.2 * rng:RandomFloat()
+    if player then
+      new.Height = player.TearHeight * 0.5
+      new.FallingAcceleration = player.TearFallingAcceleration
+      local speed = player.TearFallingSpeed
+      if speed > 0 then speed = speed * 0.3 end
+      new.FallingSpeed = offset - speed
+    else
+      new.Height = -11.875
+      new.FallingSpeed = offset + 0.185
+    end
+    new.CollisionDamage = damage
+    call(SET_SCALE, ptr(new), B.f2i(scale))
+    new.TearFlags = BitSet128(l, h)
+    if color then new:SetColor(color, -1, 255, true, false) end
+    if player then new.Parent = player end
+    new:Update()
+    if T.run and (T.listening or {})[1025] then T.run(1025, kind, new, src, kind) end
+    return new
+  end
+  for _, cls in ipairs({ "EntityTear", "EntityLaser", "EntityKnife" }) do
+    method(cls, "FireSplitTear", function(self, ...) return fire(self, ...) end)
+  end
+end
+
diff --git a/scripts/recomp/rgon/api_throw_loot.lua b/scripts/recomp/rgon/api_throw_loot.lua
new file mode 100644
index 0000000..1243728
--- /dev/null
+++ b/scripts/recomp/rgon/api_throw_loot.lua
@@ -0,0 +1,284 @@
+-- api_throw_loot.lua -- engine-hook callbacks of worker cb-g (tools/hook_table.py rows 282-291, hook_slots.lua).
+--   1040/1041 MC_PRE/POST_ENTITY_THROW       Entity_Player::ThrowHeldEntity(Vector* velocity), ret 4, held entity [player+0x1410]
+--   1015 MC_TRY_ADD_TO_BAG_OF_CRAFTING       insn hook 285 in Entity_Player::TryAddToBagOfCrafting (0x007d5170): the two chosen
+--                                            kinds are [ebp-0x50] / [ebp-0x4c], the pickup [ebp-0x48], the player edi
+--   1016 MC_POST_ADD_TO_BAG_OF_CRAFTING      the same function's answer (AL) after the call
+--   1191 MC_PRE_NPC_SPLIT                    insn hook 286 in Entity_NPC::TrySplit (0x006d97e0): AL = may not split, NPC edi
+--   1223 MC_POST_NPC_DARK_RED_CHAMPION_REGEN insn hooks 287/288 in Entity_NPC::Update, after NPCAI_Pathfinder::Reset
+--   1123 MC_PRE_SLOT_CREATE_EXPLOSION_DROPS  insn hooks 289-291 in Entity_Slot::TakeDamage (explosion branch), slot = ebx
+--   1334/1336 MC_PRE/POST_PICKUP_GET_LOOT_LIST  Entity_Pickup::GetLootList 0x006dae40 (deque*, shouldAdvance, player*), ret 0xc
+local T = ...
+local B, R, wrap, listening = T.B, T.R, T.wrap, T.listening
+local r32, w32, rf32, wf32, log = B.r32, B.w32, B.rf32, B.wf32, B.log
+local call = B.call
+local M = ModCallbacks
+local mathtype = math.type
+local function run(...) return T.run(...) end
+
+local SLOTS
+do
+  local chunk = B.load("hook_slots.lua")
+  if not chunk then return end
+  SLOTS = chunk()
+end
+if B.HOOKS < 292 then log("api_throw_loot: this engine has " .. B.HOOKS .. " hook slots; the callbacks here need a newer one") return end
+local VT = T.VTABLE
+if not VT or not T.define or not T.wants then log("api_throw_loot: api_hooks.lua's helpers are missing") return end
+
+local told = {}
+local function wrong(what, a)
+  if told[what] then return end
+  told[what] = true
+  log(string.format("api_throw_loot: %s was handed 0x%08x, which is not what it should be; the call goes on unwatched", what, a))
+end
+local function vt_of(a)
+  if mathtype(a) ~= "integer" or a < 0x1000 then return nil end
+  local ok, v = pcall(r32, a)
+  return ok and v or nil
+end
+local function as(cls, a, what)
+  if a == 0 then return nil end
+  if vt_of(a) == VT[cls] then return wrap(cls, a) end
+  wrong(what, a)
+  return false
+end
+local ANY = {}
+for _, v in pairs(VT) do ANY[v] = true end
+local function any_entity(a, what)
+  if a == 0 then return nil end
+  if ANY[vt_of(a)] then return wrap("Entity", a) end
+  wrong(what, a)
+  return false
+end
+local function slot_of(name)
+  local s = SLOTS[name]
+  if type(s) ~= "table" then log("api_throw_loot: no hook slot for " .. name) return nil end
+  return s[1], s[3]
+end
+local E_TYPE, E_VARIANT = 0x28, 0x2c
+
+-- an instruction hook: handler(esp, ebp) answers nil or one of the hook's jump targets
+local function at(name, ids, handler)
+  local slot, va = slot_of(name)
+  if not slot or not B.INSN or not B.reg then return end
+  T.define(slot, ids, function(at_va, esp, ebp)
+    if at_va ~= va then wrong(name .. " (its address)", at_va) return end
+    return handler(esp, ebp)
+  end, nil)
+end
+local reg = B.reg
+
+-- 1040 / 1041 --------------------------------------------------------------------------------------------------------
+do
+  local PRE, POST = M.MC_PRE_ENTITY_THROW, M.MC_POST_ENTITY_THROW
+  local slot = PRE and POST and slot_of("Entity_Player::ThrowHeldEntity")
+  if slot then
+    T.define(slot, { PRE, POST }, function(self, esp)
+      if not (listening[PRE] or listening[POST]) then return end
+      local held = r32(self + 0x1410)
+      local vp = r32(esp + 4)
+      if held == 0 or vp == 0 then return end
+      local player = as("EntityPlayer", self, "Entity_Player::ThrowHeldEntity")
+      local ent = any_entity(held, "Entity_Player::ThrowHeldEntity (the held entity)")
+      if not player or not ent then return end
+      if listening[PRE] then
+        local res = run(PRE, nil, player, ent, Vector(rf32(vp), rf32(vp + 4)))
+        if type(res) == "userdata" and res.X ~= nil and res.Y ~= nil then wf32(vp, res.X) wf32(vp + 4, res.Y) end
+      end
+      return { player, Vector(rf32(vp), rf32(vp + 4)) }
+    end, function(self, esp, eax, k)
+      if not k or eax == 0 or not listening[POST] then return end
+      local ent = any_entity(eax, "Entity_Player::ThrowHeldEntity (the thrown entity)")
+      if ent then run(POST, nil, k[1], ent, k[2]) end
+    end)
+  end
+end
+
+-- 1015 / 1016 --------------------------------------------------------------------------------------------------------
+do
+  local TRY, POST = M.MC_TRY_ADD_TO_BAG_OF_CRAFTING, M.MC_POST_ADD_TO_BAG_OF_CRAFTING
+  local slot = POST and slot_of("Entity_Player::TryAddToBagOfCrafting")
+  if slot then
+    T.define(slot, { POST }, function(self, esp)
+      if not listening[POST] then return end
+      local pk = r32(esp + 4)
+      if pk == 0 then return end
+      return { self, pk }
+    end, function(self, esp, eax, k)
+      if not k or (eax & 0xff) == 0 then return end
+      local v = r32(k[2] + E_VARIANT)
+      if not T.wants(POST, v) then return end
+      local player = as("EntityPlayer", k[1], "Entity_Player::TryAddToBagOfCrafting")
+      local pickup = as("EntityPickup", k[2], "Entity_Player::TryAddToBagOfCrafting (the pickup)")
+      if player and pickup then run(POST, v, player, pickup) end
+    end)
+  end
+  if TRY then
+    at("Entity_Player::TryAddToBagOfCrafting@Chosen", { TRY }, function(esp, ebp)
+      local pa = r32(ebp - 0x48)
+      if pa == 0 then return end
+      local v = r32(pa + E_VARIANT)
+      if not T.wants(TRY, v) then return end
+      local player = as("EntityPlayer", reg("edi"), "TryAddToBagOfCrafting@Chosen")
+      local pickup = as("EntityPickup", pa, "TryAddToBagOfCrafting@Chosen (the pickup)")
+      if not player or not pickup then return end
+      local tbl = {}
+      for i = 0, 1 do
+        local c = r32(ebp - 0x50 + 4 * i)
+        if c == 0 then break end
+        tbl[#tbl + 1] = c
+      end
+      local res = run(TRY, v, player, pickup, tbl)
+      if res == false then return 0x007d51c9 end
+      if type(res) == "table" then
+        for i = 0, 1 do
+          local c = res[i + 1]
+          if mathtype(c) ~= "integer" or c <= 0 or c >= 30 then c = 0 end
+          if i == 1 and (res[1] == nil or mathtype(res[1]) ~= "integer" or res[1] <= 0 or res[1] >= 30) then c = 0 end
+          w32(ebp - 0x50 + 4 * i, c)
+        end
+      end
+    end)
+  end
+end
+
+-- 1191 ---------------------------------------------------------------------------------------------------------------
+do
+  local id = M.MC_PRE_NPC_SPLIT
+  if id then
+    at("Entity_NPC::TrySplit@Blacklist", { id }, function()
+      local na = reg("edi")
+      local ty = r32(na + E_TYPE)
+      if not T.wants(id, ty) then return end
+      local npc = as("EntityNPC", na, "Entity_NPC::TrySplit")
+      if not npc then return end
+      local res = run(id, ty, npc, (reg("eax") & 0xff) ~= 0)
+      if res == true then reg("eax", 1) elseif res == false then reg("eax", 0) end
+    end)
+  end
+end
+
+-- 1223 ---------------------------------------------------------------------------------------------------------------
+do
+  local id = M.MC_POST_NPC_DARK_RED_CHAMPION_REGEN
+  if id then
+    local function regen(name)
+      at(name, { id }, function()
+        local na = reg("edi")
+        local ty = r32(na + E_TYPE)
+        if not T.wants(id, ty) then return end
+        local npc = as("EntityNPC", na, name)
+        if not npc then return end
+        call(r32(r32(na) + 0x60), na)   -- ResetColor, which the game calls right after; a mod's colour then stays
+        run(id, ty, npc)
+      end)
+    end
+    regen("Entity_NPC::Update@DarkRedRegenA")
+    regen("Entity_NPC::Update@DarkRedRegenB")
+  end
+end
+
+-- 1123 ---------------------------------------------------------------------------------------------------------------
+do
+  local id = M.MC_PRE_SLOT_CREATE_EXPLOSION_DROPS
+  if id and T.slot_obj then
+    local function explosion(name, want_variant, target, check_state)
+      at(name, { id }, function()
+        local sa = reg("ebx")
+        local v = r32(sa + E_VARIANT)
+        if (want_variant and v ~= want_variant) or not T.wants(id, v) then return end
+        if check_state and r32(sa + 0x410) == 3 then return end
+        if vt_of(sa) ~= VT.Slot then wrong(name, sa) return end
+        if run(id, v, T.slot_obj(sa)) == false then
+          reg("eax", 0)
+          return target
+        end
+      end)
+    end
+    explosion("Entity_Slot::TakeDamage@DonationExplosion", 8, 0x006645b9, false)
+    explosion("Entity_Slot::TakeDamage@RestockExplosion", 10, 0x0066489a, false)
+    explosion("Entity_Slot::TakeDamage@CommonExplosion", nil, 0x0066489a, true)
+  end
+end
+
+-- 1334 / 1336 --------------------------------------------------------------------------------------------------------
+-- The game's list is a std::deque (+4 map, +8 map size, +0xc first, +0x10 count) of 0x14-byte entries (type, variant,
+-- subtype, seed, RNG*). api_pickup_more.lua reads it into LootList objects; here the same, with each entry's RNG pointer
+-- kept, so a changed list is written back: the deque is emptied with the game's destructor 0x006da850 and filled with
+-- deque::emplace_back 0x006b84e0 (thiscall, ret 0x14).
+do
+  local PRE, POST = M.MC_PRE_PICKUP_GET_LOOT_LIST, M.MC_POST_PICKUP_GET_LOOT_LIST
+  local slot = PRE and POST and slot_of("Entity_Pickup::GetLootList")
+  local tmp = rawget(_G, "LootList") and LootList()
+  if slot and tmp then
+    tmp:PushEntry(1, 0, 0, 1)
+    local LL, LLE = getmetatable(tmp), getmetatable(tmp._e[1])
+    local push = LL.PushEntry
+    LL.PushEntry = function(self, ...) self._dirty = true return push(self, ...) end
+    local kept, nkept = {}, 0
+    local function keep(rng)
+      nkept = nkept % 64 + 1
+      kept[nkept] = rng
+      return B.ptr(rng)
+    end
+    local function copy_rng(rp)
+      local rng = RNG()
+      local d = B.ptr(rng)
+      for i = 0, 3 do w32(d + 4 * i, r32(rp + 4 * i)) end
+      return rng
+    end
+    local function read(deque)
+      local list = setmetatable({ _e = {} }, LL)
+      local map, mapsize, first, count = r32(deque + 4), r32(deque + 8), r32(deque + 0xc), r32(deque + 0x10)
+      if mapsize == 0 then return list end
+      for i = 0, count - 1 do
+        local e = r32(map + 4 * ((first + i) % mapsize))
+        local rp = r32(e + 0x10)
+        list._e[#list._e + 1] = setmetatable({ _t = B.ri32(e), _v = B.ri32(e + 4), _s = B.ri32(e + 8), _seed = r32(e + 0xc),
+          _rng = rp ~= 0 and copy_rng(rp) or nil, _rp = rp ~= 0 and rp or nil }, LLE)
+      end
+      return list
+    end
+    local function write(deque, list)
+      call(0x006da850, deque)
+      for _, e in ipairs(list._e) do
+        local rp = e._rp or (e._rng and keep(e._rng)) or 0
+        call(0x006b84e0, deque, e._t & 0xffffffff, e._v & 0xffffffff, e._s & 0xffffffff, e._seed & 0xffffffff, rp)
+      end
+    end
+    local busy = false
+    T.define(slot, { PRE, POST }, function(self, esp)
+      if busy or not (listening[PRE] or listening[POST]) then return end
+      return { self, r32(esp + 4), (r32(esp + 8) & 0xff) ~= 0, r32(esp + 12) }
+    end, function(self, esp, eax, k)
+      if not k then return end
+      local pa, deque, adv, pla = k[1], k[2], k[3], k[4]
+      local v = r32(pa + E_VARIANT)
+      if not (T.wants(PRE, v) or T.wants(POST, v)) then return end
+      local pickup = as("EntityPickup", pa, "Entity_Pickup::GetLootList")
+      local player = pla ~= 0 and as("EntityPlayer", pla, "Entity_Pickup::GetLootList (the player)") or nil
+      if not pickup or player == false then return end
+      busy = true
+      local ok, err = pcall(function()
+        local list = read(deque)
+        local rng = copy_rng(pa + 0x3dc)
+        local dirty = false
+        if T.wants(PRE, v) then
+          local res = run(PRE, v, pickup, adv, rng, player or nil)
+          if type(res) == "table" and type(res._e) == "table" then list, dirty = res, true end
+        end
+        if T.wants(POST, v) then
+          list._dirty = nil
+          run(POST, v, pickup, list, adv, rng, player or nil)
+          if list._dirty then dirty = true end
+        elseif list._dirty then
+          dirty = true
+        end
+        if adv then local d = B.ptr(rng) for i = 0, 3 do w32(pa + 0x3dc + 4 * i, r32(d + 4 * i)) end end
+        if dirty then write(deque, list) end
+      end)
+      busy = false
+      if not ok then log("api_throw_loot: GetLootList callbacks raised: " .. tostring(err)) end
+    end)
+  end
+end
diff --git a/scripts/recomp/rgon/api_weapons.lua b/scripts/recomp/rgon/api_weapons.lua
new file mode 100644
index 0000000..2f9a1a7
--- /dev/null
+++ b/scripts/recomp/rgon/api_weapons.lua
@@ -0,0 +1,202 @@
+-- api_weapons.lua -- the weapon, laser and knife callbacks (worker cb-e). Each is a hook on a game function
+-- (tools/hook_table.py rows 272-281, hook_slots.lua); a handler reads the call's arguments off the guest
+-- stack as api_hooks.lua does: [esp] is the return address, [esp+4] the first stack argument, `self` the object.
+--   1098 MC_POST_TRIGGER_WEAPON_FIRED   Weapon::TriggerTearFired(const Vector& pos, int amount), ret 8
+--   1105 MC_POST_WEAPON_FIRE            Weapon::Fire(const Vector& pos, bool shooting, bool interpolated), ret 0xc
+--   1248 MC_PRE_LASER_COLLISION         two instruction hooks in Entity_Laser::damage_entities
+--   1249 MC_POST_LASER_COLLISION        Entity_Laser::DoDamage(Entity*), ret 4
+--   1254 MC_POST_FIRE_BONE_CLUB         Entity_Player::FireBoneClub, ret 0x10: answers the knife
+--   1257 MC_POST_FIRE_KNIFE             Entity_Player::FireKnife (slot 68): answers the knife
+--   1258 MC_POST_FIRE_SWORD             Weapon::FireSword, ret 0x18: answers the knife
+--   1261/1262 MC_POST_FAMILIAR_FIRE_BRIMSTONE / _TECH_LASER: the familiar's functions answer the laser
+--   1036/1037 MC_PRE/POST_BRIMSTONE_SNEEZE  Weapon_Brimstone::do_baby_brimstone_burst(Vector*, Vector* dir, int), ret 0xc,
+--                                       damageScale in xmm3
+local T = ...
+local B, R, wrap, listening = T.B, T.R, T.wrap, T.listening
+local r32, ri32, rf32, log = B.r32, B.ri32, B.rf32, B.log
+local M = ModCallbacks
+local mathtype = math.type
+local function run(...) return T.run(...) end
+
+local SLOTS
+do
+  local chunk = B.load("hook_slots.lua")
+  if not chunk then return end
+  SLOTS = chunk()
+end
+if B.HOOKS < 282 then log("api_weapons: this engine has " .. B.HOOKS .. " hook slots; the callbacks here need a newer one") return end
+
+local VT = T.VTABLE
+if not VT then log("api_weapons: api_hooks.lua's class table is missing") return end
+local E_VARIANT = 0x2c
+local W_OWNER, W_TYPE = 4, 0x30
+
+local told = {}
+local function wrong(what, a)
+  if told[what] then return end
+  told[what] = true
+  log(string.format("api_weapons: %s was handed 0x%08x, which is not what it should be; the call goes on unwatched", what, a))
+end
+local function vt_of(a)
+  if mathtype(a) ~= "integer" or a < 0x1000 then return nil end
+  local ok, v = pcall(r32, a)
+  return ok and v or nil
+end
+-- a Lua object of class `cls` for the entity at `a` (nil for 0), or false when it is not one
+local function as(cls, a, what)
+  if a == 0 then return nil end
+  if vt_of(a) == VT[cls] then return wrap(cls, a) end
+  wrong(what, a)
+  return false
+end
+local ANY = {}
+for _, v in pairs(VT) do ANY[v] = true end
+local function any_entity(a, what)
+  if a == 0 then return nil end
+  if ANY[vt_of(a)] then return wrap("Entity", a) end
+  wrong(what, a)
+  return false
+end
+local function vec_at(a) return Vector(rf32(a), rf32(a + 4)) end
+local function bool_at(a) return (r32(a) & 0xff) ~= 0 end
+
+local function slot_of(name)
+  local s = SLOTS[name]
+  if type(s) ~= "table" then log("api_weapons: no hook slot for " .. name) return nil end
+  return s[1], s[3]
+end
+-- callbacks answering a laser or knife the function returned
+local function answers(name, id, cls, param_of)
+  if not id then return end
+  local slot = slot_of(name)
+  if not slot then return end
+  T.define(slot, { id }, nil, function(self, esp, eax)
+    if eax == 0 then return end
+    local param = param_of and param_of(self) or nil
+    if param_of and not T.wants(id, param) then return end
+    local e = as(cls, eax, name .. " (what it answered)")
+    if e then run(id, param, e) end
+  end)
+end
+
+answers("Entity_Player::FireBoneClub", M.MC_POST_FIRE_BONE_CLUB, "EntityKnife")
+answers("Entity_Player::FireKnife", M.MC_POST_FIRE_KNIFE, "EntityKnife")
+answers("Weapon::FireSword", M.MC_POST_FIRE_SWORD, "EntityKnife")
+local function fam_variant(self)
+  if vt_of(self) ~= VT.EntityFamiliar then return nil end
+  return r32(self + E_VARIANT)
+end
+local function fam_answers(name, id)
+  if not id then return end
+  local slot = slot_of(name)
+  if not slot then return end
+  T.define(slot, { id }, nil, function(self, esp, eax)
+    local v = fam_variant(self)
+    if eax == 0 or not v or not T.wants(id, v) then return end
+    local l = as("EntityLaser", eax, name .. " (what it answered)")
+    if l then run(id, v, l) end
+  end)
+end
+fam_answers("Entity_Familiar::FireBrimstone", M.MC_POST_FAMILIAR_FIRE_BRIMSTONE)
+fam_answers("Entity_Familiar::FireTechLaser", M.MC_POST_FAMILIAR_FIRE_TECH_LASER)
+
+-- the Weapon object a callback gets
+local function weapon_obj(a)
+  if T.Weapon and a ~= 0 then return T.Weapon.new(a) end
+end
+
+-- MC_POST_TRIGGER_WEAPON_FIRED (1098): (direction, fireAmount, owner, weapon), param = the weapon type
+do
+  local id = M.MC_POST_TRIGGER_WEAPON_FIRED
+  local slot = id and slot_of("Weapon::TriggerTearFired")
+  if slot then
+    T.define(slot, { id }, function(self, esp)
+      local wt = ri32(self + W_TYPE)
+      if not T.wants(id, wt) then return end
+      return { wt, vec_at(r32(esp + 4)), ri32(esp + 8) }
+    end, function(self, esp, eax, k)
+      if not k then return end
+      local owner = any_entity(r32(self + W_OWNER), "Weapon::TriggerTearFired (the owner)")
+      run(id, k[1], k[2], k[3], owner or nil, weapon_obj(self))
+    end)
+  end
+end
+
+-- MC_POST_WEAPON_FIRE (1105): (weapon, direction, isShooting, isInterpolated), param = the weapon type
+do
+  local id = M.MC_POST_WEAPON_FIRE
+  local slot = id and slot_of("Weapon::Fire")
+  if slot then
+    T.define(slot, { id }, function(self, esp)
+      local wt = ri32(self + W_TYPE)
+      if not T.wants(id, wt) then return end
+      return { wt, vec_at(r32(esp + 4)), bool_at(esp + 8), bool_at(esp + 12) }
+    end, function(self, esp, eax, k)
+      if not k then return end
+      run(id, k[1], weapon_obj(self), k[2], k[3], k[4])
+    end)
+  end
+end
+
+-- MC_PRE_BRIMSTONE_SNEEZE (1036) / MC_POST_BRIMSTONE_SNEEZE (1037): (source, direction, damageScale)
+do
+  local PRE, POST = M.MC_PRE_BRIMSTONE_SNEEZE, M.MC_POST_BRIMSTONE_SNEEZE
+  local slot = PRE and POST and slot_of("Weapon_Brimstone::do_baby_brimstone_burst")
+  if slot and B.xmm then
+    T.define(slot, { PRE, POST }, function(self, esp)
+      if not (listening[PRE] or listening[POST]) then return end
+      local owner = any_entity(r32(self + W_OWNER), "Weapon_Brimstone::do_baby_brimstone_burst (the owner)")
+      local at = r32(esp + 8)
+      if owner == false or at == 0 then return end
+      local k = { owner, vec_at(at), B.xmm(3) }
+      if listening[PRE] then run(PRE, nil, k[1], k[2], k[3]) end
+      return k
+    end, function(self, esp, eax, k)
+      if k and listening[POST] then run(POST, nil, k[1], k[2], k[3]) end
+    end)
+  end
+end
+
+-- MC_POST_LASER_COLLISION (1249): (laser, collider), param = the laser variant, after Entity_Laser::DoDamage
+do
+  local id = M.MC_POST_LASER_COLLISION
+  local slot = id and slot_of("Entity_Laser::DoDamage")
+  if slot then
+    T.define(slot, { id }, function(self, esp)
+      local v = r32(self + E_VARIANT)
+      if vt_of(self) ~= VT.EntityLaser or not T.wants(id, v) then return end
+      return { v, r32(esp + 4) }
+    end, function(self, esp, eax, k)
+      if not k then return end
+      local laser = as("EntityLaser", self, "Entity_Laser::DoDamage")
+      local ent = any_entity(k[2], "Entity_Laser::DoDamage (the entity)")
+      if laser and ent then run(id, k[1], laser, ent) end
+    end)
+  end
+end
+
+-- MC_PRE_LASER_COLLISION (1248): (laser, collider), param = the laser variant -> true: the laser ignores the entity.
+-- Entity_Laser::damage_entities 0x00971810: the sample lasers at 0x009720b5 (entity = eax, laser [ebp-0x7c]; ignoring
+-- goes to 0x0097207c, the next sample), the straight ones at 0x00973201 (laser edi, entity esi; ignoring goes to 0x00973651).
+if B.INSN and B.reg and M.MC_PRE_LASER_COLLISION then
+  local id, reg = M.MC_PRE_LASER_COLLISION, B.reg
+  local function point(name, laser_of, entity_of, skip_to)
+    local slot, va = slot_of(name)
+    if not slot then return end
+    T.define(slot, { id }, function(at_va, esp, ebp)
+      if at_va ~= va then wrong(name .. " (its address)", at_va) return end
+      local la = laser_of(ebp)
+      local v = vt_of(la) == VT.EntityLaser and r32(la + E_VARIANT) or nil
+      if not v or not T.wants(id, v) then return end
+      local laser = as("EntityLaser", la, name)
+      local ent = any_entity(entity_of(ebp), name .. " (the collider)")
+      if not laser or not ent then return end
+      if not told[name .. v] then told[name .. v] = true log("api_weapons: " .. name .. " ran its first callback, laser variant " .. v) end
+      if run(id, v, laser, ent) == true then return skip_to end
+    end, nil)
+  end
+  point("Entity_Laser::damage_entities@PreSampleCollision", function(ebp) return r32(ebp - 0x7c) end,
+    function() return reg("eax") end, 0x0097207c)
+  point("Entity_Laser::damage_entities@PreCollision", function() return reg("edi") end,
+    function() return reg("esi") end, 0x00973651)
+end
