+
+local function objects()
+  try("ItemOverlay", function()
+    ItemOverlay.Show(1, 3, Isaac.GetPlayer(0))
+    check("ItemOverlay.GetOverlayID", ItemOverlay.GetOverlayID() ~= nil)
+    check("ItemOverlay.GetDelay", ItemOverlay.GetDelay() == 3, ItemOverlay.GetDelay())
+    local p = ItemOverlay.GetPlayer()
