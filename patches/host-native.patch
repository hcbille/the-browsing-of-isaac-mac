diff --git a/scripts/recomp/rgon/lab_unlock_all.lua b/scripts/recomp/rgon/lab_unlock_all.lua
new file mode 100644
index 0000000..494b2fb
--- /dev/null
+++ b/scripts/recomp/rgon/lab_unlock_all.lua
@@ -0,0 +1,63 @@
+-- lab_unlock_all.lua (development only; ISAAC_RGON_LAB=lab_unlock_all.lua)
+-- Unlocks every game achievement (1..637, the game's own PersistentGameData::TryUnlock, so the game
+-- writes it into the chosen save slot itself) and every mod achievement (the layer's unlock_modded,
+-- as lab_unlock.lua), once, in the main menu once a save slot is chosen.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab unlock all", 1)
+local done = false
+local LAST = 637   -- Repentance+ has 637 achievements (ids 1..637); 638..0x281 are unused slots
+local function run()
+  local pgd = Isaac.GetPersistentGameData()
+  local slot = B.r32(B.r32(0x00c7169c) + 0x10)
+  local was, new, bad = 0, 0, 0
+  for id = 1, LAST do
+    local ok, u = pcall(pgd.Unlocked, pgd, id)
+    if ok and u then was = was + 1
+    else
+      local ok2, r = pcall(pgd.TryUnlock, pgd, id, true)
+      if ok2 and r then new = new + 1 else bad = bad + 1 end
+    end
+  end
+  local have = 0
+  for id = 1, LAST do if pgd:Unlocked(id) then have = have + 1 end end
+  local mods = 0
+  local set = T.xml_entries(XMLNode.ACHIEVEMENT)
+  for _, e in ipairs(set and set.list or {}) do
+    local id = math.tointeger(tonumber(e.id))
+    if e.sourceid and id and T.unlock_modded(id) then mods = mods + 1 end
+  end
+  B.log(string.format("lab_unlock_all: slot %d: game achievements 1..%d: %d already unlocked, %d newly unlocked, %d failed; %d unlocked in total now; %d mod achievement(s) newly unlocked",
+    slot, LAST, was, new, bad, have, mods))
+end
+-- Epiphany keeps its own unlocks (Tarnished characters, the Tarnished menu page, its items) in its mod save,
+-- not in game or XML achievements; its own console command `unlock-all` is Epiphany:UnlockAll(). Run that once,
+-- after its save manager has loaded the chosen slot's data.
+local epi_done = false
+local function epiphany()
+  if epi_done then return end
+  local E = rawget(_G, "Epiphany")
+  if type(E) ~= "table" or type(E.UnlockAll) ~= "function" then epi_done = true; return end
+  local sm = E.SaveManager
+  if not (sm and sm.Utility and sm.Utility.IsDataInitialized and sm.Utility.IsDataInitialized(true)) then return end
+  epi_done = true
+  local ok, err = pcall(E.UnlockAll, E)
+  local menu = ok and E.GetAchievement and E:GetAchievement("TARNISHED_MENU", true) or -1
+  B.log(string.format("lab_unlock_all: Epiphany UnlockAll %s; TARNISHED_MENU = %s",
+    ok and "ok" or ("failed: " .. tostring(err)), tostring(menu)))
+end
+local n = 0
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  n = n + 1
+  if done then epiphany() end
+  if not done and n % 120 == 1 then B.log(string.format("lab_unlock_all: menu frame %d, ready=%d, slot=%d", n, B.r32(0x00c72a20), B.r32(0x00c7169c) ~= 0 and B.r32(B.r32(0x00c7169c) + 0x10) or -1)) end
+  if done or B.r32(0x00c72a20) == 0 then return end
+  local slot = B.r32(B.r32(0x00c7169c) + 0x10)
+  if slot == 0 then return end
+  done = true
+  run()
+end)
+mod:AddCallback(ModCallbacks.MC_POST_GAME_STARTED, function()
+  if not done then done = true; run() end
+  epiphany()
+end)
