+  end
+end)
diff --git a/scripts/recomp/rgon/lab_batch3_test.lua b/scripts/recomp/rgon/lab_batch3_test.lua
new file mode 100644
index 0000000..b312b2c
--- /dev/null
+++ b/scripts/recomp/rgon/lab_batch3_test.lua
@@ -0,0 +1,237 @@
+-- lab_batch3_test.lua (development only; ISAAC_RGON_LAB=lab_batch3_test.lua, census batch 3): runs the names of
+-- api_batch_three.lua in the first room, a step per frame, and logs "lab_batch3_test: PASS/FAIL ..". Readers are
+-- checked against values the game itself holds.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab batch3 test", 1)
+local function check(name, ok, detail)
+  B.log("lab_batch3_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function near(a, b) return math.abs(a - b) < 0.01 end
+local dir = nil
+mod:AddCallback(ModCallbacks.MC_INPUT_ACTION, function(_, ent, hook, action)
+  if dir and ent and ent.Type == 1 and action == dir then
+    if hook == InputHook.IS_ACTION_PRESSED or hook == InputHook.IS_ACTION_TRIGGERED then return true end
+    if hook == InputHook.GET_ACTION_VALUE then return 1.0 end
+  end
+end)
+
+local steps, frame = {}, 0
+local function at(f, fn) steps[f] = function() local ok, err = pcall(fn) if not ok then check("step " .. f, false, err) end end end
+local function reset(p)
+  for _, c in ipairs({ CollectibleType.COLLECTIBLE_BRIMSTONE, CollectibleType.COLLECTIBLE_MONSTROS_LUNG, CollectibleType.COLLECTIBLE_CHOCOLATE_MILK }) do
+    while p:HasCollectible(c) do p:RemoveCollectible(c) end
+  end
+  p:AddCacheFlags(CacheFlag.CACHE_ALL)
+  p:EvaluateItems()
+  dir = nil
+end
+
+at(3, function()
+  for _, n in ipairs({ "Weapon.GetDirection", "Weapon.GetMaxCharge", "Weapon.GetMainEntity" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  local p = Isaac.GetPlayer(0)
+  local w = p:GetWeapon(1)
+  check("tears: GetMaxCharge is 0", w:GetMaxCharge() == 0, w:GetMaxCharge())
+  check("tears: GetMainEntity is nil", w:GetMainEntity() == nil)
+  local d = w:GetDirection()
+  check("tears idle: GetDirection is a Vector of zeros", d.X == 0 and d.Y == 0, tostring(d))
+  check("GetDirection on a non-Weapon errors", not pcall(w.GetDirection, {}))
+  check("GetMaxCharge on a non-Weapon errors", not pcall(w.GetMaxCharge, 5))
+  check("GetMainEntity on a non-Weapon errors", not pcall(w.GetMainEntity, nil))
+  local f = p:GetWeapon(2)
+  check("an empty weapon slot is nil", f == nil)
+end)
+
+-- Brimstone: max charge equals what the charge field climbs to; the laser is the main entity once fired
+at(10, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_BRIMSTONE, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() end)
+at(14, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("brimstone: weapon type 2", w:GetWeaponType() == 2, w:GetWeaponType())
+  check("brimstone: GetMaxCharge is 32", near(w:GetMaxCharge(), 32), w:GetMaxCharge())
+  check("brimstone idle: GetMainEntity is nil", w:GetMainEntity() == nil)
+  dir = ButtonAction.ACTION_SHOOTRIGHT
+end)
+at(20, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  local d = w:GetDirection()
+  check("brimstone firing right: GetDirection is (1, 0)", near(d.X, 1) and near(d.Y, 0), tostring(d))
+  check("brimstone charging: GetCharge is below the max", w:GetCharge() > 0 and w:GetCharge() <= w:GetMaxCharge(), w:GetCharge())
+end)
+at(70, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("brimstone: charge stops at GetMaxCharge", near(w:GetCharge(), w:GetMaxCharge()), w:GetCharge() .. " / " .. w:GetMaxCharge())
+  dir = ButtonAction.ACTION_SHOOTUP
+end)
+at(74, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  local d = w:GetDirection()
+  check("brimstone firing up: GetDirection is (0, -1)", near(d.X, 0) and near(d.Y, -1), tostring(d))
+  dir = nil
+end)
+for f = 75, 95 do
+  at(f, function()
+    local p = Isaac.GetPlayer(0)
+    local w = p:GetWeapon(1)
+    local e = w:GetMainEntity()
+    if e ~= nil and not steps.laser_seen then
+      steps.laser_seen = true
+      check("brimstone firing: GetMainEntity is the laser (type 7)", e.Type == 7 and e.SpawnerEntity ~= nil and GetPtrHash(e.SpawnerEntity) == GetPtrHash(p), "type " .. e.Type .. " variant " .. e.Variant)
+    end
+  end)
+end
+at(96, function() if not steps.laser_seen then check("brimstone firing: GetMainEntity is the laser (type 7)", false, "never non-nil in frames 75..95") end end)
+
+-- Monstro's Lung and Chocolate Milk: a charge weapon each, with a max charge
+at(100, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_MONSTROS_LUNG, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() end)
+at(104, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("lung: weapon type 7", w:GetWeaponType() == 7, w:GetWeaponType())
+  check("lung: GetMaxCharge is positive", w:GetMaxCharge() > 30 and w:GetMaxCharge() < 60, w:GetMaxCharge())
+end)
+at(110, function() local p = Isaac.GetPlayer(0) reset(p) p:AddCollectible(CollectibleType.COLLECTIBLE_CHOCOLATE_MILK, 0, false) p:AddCacheFlags(CacheFlag.CACHE_ALL) p:EvaluateItems() dir = ButtonAction.ACTION_SHOOTLEFT end)
+at(118, function()
+  local w = Isaac.GetPlayer(0):GetWeapon(1)
+  check("chocolate milk: GetMaxCharge is positive", w:GetMaxCharge() > 0, w:GetMaxCharge())
+  local d = w:GetDirection()
+  check("chocolate milk firing left: GetDirection is (-1, 0)", near(d.X, -1) and near(d.Y, 0), tostring(d))
+  dir = nil
+end)
+at(125, function() reset(Isaac.GetPlayer(0)) end)
+
+-- Room placement: queries against the level the game made (Basement I, start room at grid index 84)
+at(130, function()
+  local level = Game():GetLevel()
+  for _, n in ipairs({ "Level.GetNeighboringRooms", "Level.CanPlaceRoom", "Level.CanPlaceRoomAtDoor", "Level.FindValidRoomPlacementLocations",
+      "RoomDescriptor.GetNeighboringRooms", "RoomDescriptor.GetValidNeighborPlacementLocations" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  local start = level:GetCurrentRoomDesc()
+  check("start room is at 84", start.GridIndex == 84, start.GridIndex)
+  local near = level:GetNeighboringRooms(84, 1)
+  local expect = { [0] = 83, [1] = 71, [2] = 85, [3] = 97 }
+  local ok, count = true, 0
+  for slot, d in pairs(near) do
+    count = count + 1
+    if expect[slot] == nil or d.GridIndex ~= expect[slot] and d.SafeGridIndex ~= expect[slot] then ok = false end
+    local direct = level:GetRoomByIdx(expect[slot] or -1, -1)
+    if not (direct and GetPtrHash(direct) == GetPtrHash(d)) then ok = false end
+  end
+  local want = 0
+  for slot, idx in pairs(expect) do local r = level:GetRoomByIdx(idx, -1) if r and r.Data then want = want + 1 end end
+  check("GetNeighboringRooms(84, 1) finds each room next to the start room, in the right slot", ok and count == want and count > 0, count .. " of " .. want)
+  local own = start:GetNeighboringRooms()
+  local same = true
+  for slot, d in pairs(near) do if not own[slot] or GetPtrHash(own[slot]) ~= GetPtrHash(d) then same = false end end
+  check("RoomDescriptor:GetNeighboringRooms equals Level:GetNeighboringRooms", same)
+  check("an occupied cell cannot take a room", level:CanPlaceRoom(1, -1, 84) == false)
+  check("shape 0 cannot be placed", level:CanPlaceRoom(0, -1, 5) == false)
+  check("a grid index past 168 cannot be placed", level:CanPlaceRoom(1, -1, 169) == false)
+  check("an invalid dimension errors", not pcall(level.CanPlaceRoom, level, 1, -1, 5, 7))
+  -- a cell with no rooms around it
+  local lonely
+  for i = 0, 168 do
+    local c, l = i % 13, i // 13
+    if c < 12 and l < 12 then
+      local free = true
+      for dc = -1, 2 do for dl = -1, 2 do
+        local cc, ll = c + dc, l + dl
+        if cc >= 0 and cc < 13 and ll >= 0 and ll < 13 then local r = level:GetRoomByIdx(ll * 13 + cc, -1) if r and r.Data then free = false end end
+      end end
+      if free then lonely = i break end
+    end
+  end
+  check("a free cell far from every room exists in this level", lonely ~= nil)
+  if lonely then
+    check("no neighbours: not placeable by default", level:CanPlaceRoom(1, -1, lonely) == false)
+    check("no neighbours: placeable with allowNoNeighbors", level:CanPlaceRoom(1, -1, lonely, -1, true, false, true) == true)
+    check("a 2x2 with no neighbours and allowNoNeighbors fits when there is room", level:CanPlaceRoom(8, -1, lonely, -1, true, false, true) == true)
+  end
+  local rc = Isaac.GetItemConfig and RoomConfigHolder and RoomConfigHolder.GetRoomByStageTypeAndVariant and RoomConfigHolder.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0)
+  if rc then
+    check("RoomConfigRoom form: the shape and door mask come from the config", level:CanPlaceRoom(rc, 84) == false and level:CanPlaceRoom(rc, lonely or 0, -1, true, false, true) == (lonely ~= nil))
+  end
+  -- every location FindValidRoomPlacementLocations lists passes CanPlaceRoom, is empty and touches a room; they come sorted
+  for _, shape in ipairs({ 1, 4, 6, 8 }) do
+    local list = level:FindValidRoomPlacementLocations(shape, -1)
+    local good, sorted_ = true, true
+    for i, idx in ipairs(list) do
+      if not level:CanPlaceRoom(shape, -1, idx) then good = false end
+      if i > 1 and list[i - 1] >= idx then sorted_ = false end
+    end
+    -- (a freshly generated level may have none: its free cells next to a door are mostly boxed in by other rooms)
+    check("FindValidRoomPlacementLocations(shape " .. shape .. "): " .. #list .. " location(s), all pass CanPlaceRoom, sorted", good and sorted_)
+  end
+  -- a 1x1 location list is the cells next to a room where a door can lead: compare with CanPlaceRoomAtDoor
+  local list = level:FindValidRoomPlacementLocations(1, -1)
+  local set = {}
+  for _, i in ipairs(list) do set[i] = true end
+  local via_door, seen = {}, {}
+  for i = 0, 168 do
+    local r = level:GetRoomByIdx(i, -1)
+    if r and r.Data and not seen[GetPtrHash(r)] then
+      seen[GetPtrHash(r)] = true
+      for _, c in ipairs(r:GetValidNeighborPlacementLocations(1, -1)) do via_door[c] = true end
+    end
+  end
+  local equal = true
+  for i in pairs(set) do if not via_door[i] then equal = false end end
+  for i in pairs(via_door) do if not set[i] then equal = false end end
+  check("Level list equals the union of the rooms' GetValidNeighborPlacementLocations", equal)
+end)
+-- the game's own red room placement as an oracle: for every door of every 1x1 room whose neighbouring cell is
+-- empty, CanPlaceRoom(1x1 at that cell) must say what Level:MakeRedRoomDoor does (it places a red room there or not).
+-- Run on several floors (each floor is a new level; the placement changes the level, so the answer is asked first).
+local function oracle(tag)
+  local level = Game():GetLevel()
+  local rooms, seen = {}, {}
+  for i = 0, 168 do
+    local r = level:GetRoomByIdx(i, -1)
+    if r and r.Data and not seen[GetPtrHash(r)] then seen[GetPtrHash(r)] = true rooms[#rooms + 1] = r end
+  end
+  local step = { [0] = -1, [1] = -13, [2] = 1, [3] = 13 }
+  local agree, differ, tried, yes = 0, {}, 0, 0
+  for _, r in ipairs(rooms) do
+    if r.Data.Shape == 1 then
+      local idx = r.GridIndex
+      for slot = 0, 3 do
+        local cell = idx + step[slot]
+        local col_ok = not ((slot == 0 and idx % 13 == 0) or (slot == 2 and idx % 13 == 12))
+        local e = level:GetRoomByIdx(cell, -1)
+        if col_ok and cell >= 0 and cell <= 168 and (r.Data.Doors & (1 << slot)) ~= 0 and not (e and e.Data) then
+          tried = tried + 1
+          local mine = level:CanPlaceRoom(1, -1, cell, -1, true, true)
+          local at_door = level:CanPlaceRoomAtDoor(1, -1, r, slot, true, true)
+          if at_door ~= mine then differ[#differ + 1] = string.format("CanPlaceRoomAtDoor room %d slot %d: %s but CanPlaceRoom %s", idx, slot, tostring(at_door), tostring(mine)) end
+          local theirs = level:MakeRedRoomDoor(idx, slot) and true or false
+          if mine == theirs then agree = agree + 1 if theirs then yes = yes + 1 end
+          else differ[#differ + 1] = string.format("room %d type %d slot %d cell %d: mine %s game %s", idx, r.Data.Type, slot, cell, tostring(mine), tostring(theirs)) end
+        end
+      end
+    end
+  end
+  check(tag .. ": CanPlaceRoom agrees with the game's red room placement on " .. tried .. " door(s) (" .. yes .. " placed)", #differ == 0 and tried > 0,
+    #differ .. " differ " .. table.concat(differ, "; "):sub(1, 400))
+  -- a second look at the shapes, now that the level is bigger
+  for _, shape in ipairs({ 1, 4, 6, 8 }) do
+    local list = level:FindValidRoomPlacementLocations(shape, -1)
+    local good = true
+    for _, idx in ipairs(list) do if not level:CanPlaceRoom(shape, -1, idx) then good = false end end
+    check(tag .. ": FindValidRoomPlacementLocations(shape " .. shape .. ") " .. #list .. " location(s), all pass CanPlaceRoom", good)
+  end
+end
+at(135, function() oracle("Basement I") end)
+local floors = { "2", "4", "6", "8" }
+for i, f in ipairs(floors) do
+  local base = 140 + (i - 1) * 60
+  at(base, function() Isaac.ExecuteCommand("stage " .. f) end)
+  at(base + 40, function() oracle("stage " .. f .. " (level " .. Game():GetLevel():GetStage() .. ")") end)
+end
+at(140 + #floors * 60, function() B.log("lab_batch3_test: DONE") end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local f = steps[frame]
+  if f then f() end
+end)
