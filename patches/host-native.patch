+local B, R = T.B, T.R
+local r32, r8, w32, call, log = B.r32, B.r8, B.w32, B.call, B.log
+local type, error, rawget, rawset, getmetatable, pairs, pcall = type, error, rawget, rawset, getmetatable, pairs, pcall
+local mathtype = math.type
+
+local GAME_PTR = 0x00c71678
+local AMBUSH = 0x265c8
+local F_MAX_BOSSRUSH, F_BOSSES, F_ACTIVE, F_WAVE = 0x18, 0x1c, 0x20, 0x24
+local START_CHALLENGE, SPAWN_WAVE, SPAWN_BOSSRUSH = 0x00833420, 0x00833600, 0x00833c40
+
+local function ambush(what)
+  local game = r32(GAME_PTR)
+  if game == 0 then error("rgon: Ambush." .. what .. " used with no game", 3) end
+  return game + AMBUSH
+end
+
+local function int_arg(v, n, what)
+  if mathtype(v) == "float" and v == math.floor(v) then v = math.tointeger(v) end
+  if mathtype(v) ~= "integer" then error("bad argument #" .. n .. " to '" .. what .. "' (number expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+local Ambush = rawget(_G, "Ambush")
+if type(Ambush) ~= "table" then Ambush = {} rawset(_G, "Ambush", Ambush) end
+
+local function put(name, f)
+  if rawget(Ambush, name) ~= nil then log("Ambush." .. name .. " already exists; left alone") return end
+  T.static(Ambush, "Ambush", name, f)
+end
+
+-- the wave counter: 0 while no ambush runs (the game zeroes it at StartChallenge and leaves it after the last wave)
+put("GetCurrentWave", function() return B.ri32(ambush("GetCurrentWave") + F_WAVE) end)
+put("GetMaxBossrushWaves", function() return B.ri32(ambush("GetMaxBossrushWaves") + F_MAX_BOSSRUSH) end)
+put("SetMaxBossrushWaves", function(n)
+  n = int_arg(n, 1, "SetMaxBossrushWaves")
+  if n > 25 then n = 25 end
+  w32(ambush("SetMaxBossrushWaves") + F_MAX_BOSSRUSH, n & 0xffffffff)
+end)
+put("GetNumBossesPerWave", function() return B.ri32(ambush("GetNumBossesPerWave") + F_BOSSES) end)
+put("SetNumBossesPerWave", function(n)
+  n = int_arg(n, 1, "SetNumBossesPerWave")
+  w32(ambush("SetNumBossesPerWave") + F_BOSSES, n & 0xffffffff)
+end)
+put("GetMaxChallengeWaves", function() return 3 end)
+put("GetMaxBossChallengeWaves", function() return 2 end)
+put("StartChallenge", function() call(START_CHALLENGE, ambush("StartChallenge")) end)
+put("SpawnWave", function() call(SPAWN_WAVE, ambush("SpawnWave")) end)
+put("SpawnBossrushWave", function() call(SPAWN_BOSSRUSH, ambush("SpawnBossrushWave")) end)
+
+------------------------------------------------------------------------------
+-- RoomDescriptor.Data = RoomConfigRoom
+------------------------------------------------------------------------------
+-- The game's descriptor class has a getter for Data and no setter (luabridge answers "no member named 'Data'" on a write).
+-- A __propset entry goes on every class table of a real descriptor (plain and const, the way api_item_fields.lua does it); it
+-- takes the address of the RoomConfigRoom userdata and writes it at descriptor +0x10. nil is refused (a descriptor without
+-- its room data makes the game crash at the next use).
+do
+  local DESC_DATA = 0x10
+  local installed = false
+  local function room_class()
+    local ok, room = pcall(function() return RoomConfig.GetRoomByStageTypeAndVariant(StbType.BASEMENT, RoomType.ROOM_DEFAULT, 1, 0) end)
+    if ok and room ~= nil then return getmetatable(room) end
+  end
+  local function set_data(self, value)
+    local p = B.ptr(self)
+    if p == 0 then error("rgon: RoomDescriptor.Data written without its descriptor", 2) end
+    if type(value) ~= "userdata" then error("bad argument to 'Data' (RoomConfigRoom expected, got " .. type(value) .. ")", 2) end
+    local cls = room_class()
+    if cls == nil or getmetatable(value) ~= cls then error("bad argument to 'Data' (RoomConfigRoom expected)", 2) end
+    local a = B.ptr(value)
+    if a == 0 then error("rgon: RoomDescriptor.Data written with a RoomConfigRoom that has no address", 2) end
+    w32(p + DESC_DATA, a)
+  end
+  local setter = B.cfn(set_data)
+  local function install()
+    if installed then return end
+    local level = Game():GetLevel()
+    local objs = { level:GetCurrentRoomDesc(), level:GetRoomByIdx(level:GetCurrentRoomIndex(), -1) }
+    local any = false
+    for _, o in pairs(objs) do
+      local mt = o ~= nil and getmetatable(o)
+      if type(mt) == "table" then
+        for _, t in pairs({ mt, rawget(mt, "__class"), rawget(mt, "__const") }) do
+          if type(t) == "table" then
+            local ps = rawget(t, "__propset")
+            if type(ps) ~= "table" then ps = {} rawset(t, "__propset", ps) end
+            if rawget(ps, "Data") == nil then rawset(ps, "Data", setter) end
+            any = true
+          end
+        end
+      end
+    end
+    if any then
+      installed = true
+      R.Implemented["RoomDescriptor.Data"] = true
+      log("api_ambush: RoomDescriptor.Data is writable")
+    end
+  end
+  if T.listen then
+    T.listen(ModCallbacks.MC_POST_PLAYER_INIT, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_LEVEL, install, -math.huge)
+    T.listen(ModCallbacks.MC_POST_NEW_ROOM, install, -math.huge)
+  end
+end
