+      waiting = false
+    else
+      wait_left = wait_left - 1
+      if wait_left <= 0 then
+        waiting = false
+        if wait_what ~= "frames" and wait_what ~= "split" and wait_what ~= "regen" and wait_what ~= "bag" then check(false, "timed out waiting for " .. wait_what) end
+        if wait_what == "regen" or wait_what == "bag" then say("timed out waiting for " .. wait_what) end
+      else
+        return
+      end
+    end
+  end
+  if frame % 3 ~= 0 then return end
+  i = i + 1
+  local f = steps[i]
+  if not f then
+    if i == #steps + 1 then B.log(string.format("lab_cb_g: DONE %d PASS %d FAIL", pass, fail)) end
+    return
+  end
+  local ok, err = pcall(f)
+  if not ok then check(false, "step " .. i .. " raised: " .. tostring(err)) end
+end)
diff --git a/scripts/recomp/rgon/lab_cb_h.lua b/scripts/recomp/rgon/lab_cb_h.lua
