+-- lab_tarn2.lua (development only): which bytes of a sprite's AnimationState does Play / SetFrame / Stop-ish change?
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab tarn2", 1)
+local done = false
+local function dump(tag, s)
+  local p = B.ptr(s) + 0x30
+  local t = {}
+  for i = 0, 0x1f, 4 do t[#t + 1] = string.format("%08x", B.r32(p + i)) end
+  B.log(string.format("lab_tarn2: %-22s state %s | anim=%s fr=%s playing=%s fin=%s", tag, table.concat(t, " "),
+    tostring(s:GetAnimation()), tostring(s:GetFrame()), tostring(s:IsPlaying(s:GetAnimation())), tostring(s:IsFinished(s:GetAnimation()))))
+end
+mod:AddCallback(ModCallbacks.MC_MAIN_MENU_RENDER, function()
+  if done then return end
+  done = true
+  local s = Sprite()
+  s:Load("gfx/005.100_collectible.anm2", true)
+  local names = {}
+  for k in pairs(getmetatable(s).__index or {}) do names[#names + 1] = k end
+  table.sort(names)
+  B.log("lab_tarn2: sprite methods: " .. table.concat(names, " "))
+  dump("loaded", s)
+  s:Play("Idle", true); dump("Play Idle", s)
+  s:Update(); s:Update(); dump("2x Update", s)
+  s:SetFrame("Idle", 1); dump("SetFrame Idle 1", s)
+  s:Update(); dump("Update after SetFrame", s)
+  s:SetFrame("Idle", 0); dump("SetFrame Idle 0", s)
+  s:Play("Idle", false); dump("Play Idle false", s)
+  s:Update(); dump("Update after Play", s)
+  if s.Stop then s:Stop(); dump("Stop", s) end
+  if s.Continue then s:Continue(); dump("Continue", s) end
+  s:SetLastFrame(); dump("SetLastFrame", s)
+  s:Play("Idle", true); s:Update(); dump("Play again", s)
+end)
