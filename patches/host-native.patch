@@ -0,0 +1,92 @@
+-- lab_pocket_test.lua (development only; ISAAC_RGON_LAB=lab_pocket_test.lua, census batch 3): runs the names of
+-- api_pocket_item.lua in the first room, a step every few frames, and logs "lab_pocket_test: PASS/FAIL ..".
+-- Expected values are REPENTOGON's documented ones (PocketItem.md): GetSlot is 0 when empty, the Card for a card,
+-- the PillColor for a pill, ActiveSlot + 1 for a pocket active; GetType is PocketItemType (PILL 0, CARD 1,
+-- ACTIVE_ITEM 2), unreliable when the slot is empty.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab pocket test", 1)
+local function check(name, ok, detail)
+  B.log("lab_pocket_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function try(name, f)
+  local ok, err = pcall(f)
+  if not ok then check(name, false, err) end
+end
+local frame = 0
+local function slot_of(p, s)
+  local it = p:GetPocketItem(s)
+  return it:GetSlot(), it:GetType()
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  local p = Isaac.GetPlayer(0)
+  if frame == 3 then
+    try("exists", function()
+      for _, n in ipairs({ "EntityPlayer.GetPocketItem", "PocketItem.GetSlot", "PocketItem.GetType" }) do
+        check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+      end
+      check("PillCardSlot.PRIMARY is 0", PillCardSlot and PillCardSlot.PRIMARY == 0, PillCardSlot and PillCardSlot.PRIMARY)
+    end)
+    try("empty", function()
+      local pi = p:GetPocketItem(PillCardSlot.PRIMARY)
+      check("empty: userdata-free object", type(pi) ~= "nil")
+      check("empty: GetSlot is 0", pi:GetSlot() == 0, pi:GetSlot())
+      check("empty: GetType is a number", type(pi:GetType()) == "number", pi:GetType())
+      for s = 1, 3 do check("empty slot " .. s .. ": GetSlot is 0", p:GetPocketItem(s):GetSlot() == 0) end
+      check("out of range slot 9 clamps like the game (an empty slot)", p:GetPocketItem(9):GetSlot() == 0)
+      check("negative slot clamps to slot 0", p:GetPocketItem(-4):GetSlot() == 0)
+    end)
+    try("bad arguments", function()
+      check("non-number slot errors", not pcall(p.GetPocketItem, p, "x"))
+      check("missing slot errors", not pcall(p.GetPocketItem, p))
+      local pi = p:GetPocketItem(0)
+      check("GetSlot on a non-PocketItem errors", not pcall(pi.GetSlot, {}))
+    end)
+  elseif frame == 6 then
+    p:SetCard(0, Card.CARD_FOOL)
+    try("card", function()
+      local pi = p:GetPocketItem(PillCardSlot.PRIMARY)
+      check("card: GetSlot is the card id", pi:GetSlot() == Card.CARD_FOOL and pi:GetSlot() == p:GetCard(0), pi:GetSlot())
+      check("card: GetType is CARD (1)", pi:GetType() == 1, pi:GetType())
+      p:SetCard(0, Card.CARD_JUSTICE)
+      check("card: the handle reads live", pi:GetSlot() == Card.CARD_JUSTICE, pi:GetSlot())
+      check("card: two handles of one slot are equal", p:GetPocketItem(0) == pi)
+      check("card: other slot is not equal", p:GetPocketItem(1) ~= pi)
+    end)
+  elseif frame == 9 then
+    p:SetCard(0, 0)
+    p:SetPill(0, 3)
+    try("pill", function()
+      local pi = p:GetPocketItem(PillCardSlot.PRIMARY)
+      check("pill: GetSlot is the pill colour", pi:GetSlot() == 3 and pi:GetSlot() == p:GetPill(0), pi:GetSlot())
+      check("pill: GetType is PILL (0)", pi:GetType() == 0, pi:GetType())
+    end)
+  elseif frame == 12 then
+    p:SetPill(0, 0)
+    try("cleared pill", function() check("cleared pill: GetSlot is 0", slot_of(p, 0) == 0, (slot_of(p, 0))) end)
+    p:SetPocketActiveItem(CollectibleType.COLLECTIBLE_VOID, ActiveSlot.SLOT_POCKET, false)
+  elseif frame == 15 then
+    try("pocket active", function()
+      local pi = p:GetPocketItem(PillCardSlot.PRIMARY)
+      check("pocket active: GetType is ACTIVE_ITEM (2)", pi:GetType() == 2, pi:GetType())
+      check("pocket active: GetSlot is ActiveSlot.SLOT_POCKET + 1", pi:GetSlot() == ActiveSlot.SLOT_POCKET + 1, pi:GetSlot())
+      -- the documented example, and Epiphany's line (throwable_item_lib.lua:727)
+      local slot = pi:GetSlot() - 1
+      check("pocket active: docs example finds Void", p:GetActiveItem(slot) == CollectibleType.COLLECTIBLE_VOID, p:GetActiveItem(slot))
+    end)
+    p:AddCard(Card.CARD_JUSTICE)
+    p:SetPocketActiveItem(CollectibleType.COLLECTIBLE_D6, ActiveSlot.SLOT_POCKET2, false)
+  elseif frame == 18 then
+    try("pocket active and card and pocket2", function()
+      local a, b, c = p:GetPocketItem(0), p:GetPocketItem(1), p:GetPocketItem(2)
+      check("slot 0 is the pocket active", a:GetType() == 2 and a:GetSlot() == 3, a:GetType() .. "/" .. a:GetSlot())
+      check("slot 1 is the second pocket active", b:GetType() == 2 and b:GetSlot() == 4, b:GetType() .. "/" .. b:GetSlot())
+      check("slot 2 is the card", c:GetType() == 1 and c:GetSlot() == Card.CARD_JUSTICE, c:GetType() .. "/" .. c:GetSlot())
+      check("slot 3 is empty", p:GetPocketItem(3):GetSlot() == 0)
+      check("pocket2 docs example finds the D6", p:GetActiveItem(b:GetSlot() - 1) == CollectibleType.COLLECTIBLE_D6, p:GetActiveItem(b:GetSlot() - 1))
+    end)
+  elseif frame == 21 then
+    B.log("lab_pocket_test: done")
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_pool_test.lua b/scripts/recomp/rgon/lab_pool_test.lua
new file mode 100644
index 0000000..9f72e04
--- /dev/null
+++ b/scripts/recomp/rgon/lab_pool_test.lua
@@ -0,0 +1,43 @@
+-- lab_pool_test.lua (development only; ISAAC_RGON_LAB=lab_pool_test.lua, census batch 3): ItemPool:ResetCollectible.
+-- RemoveCollectible(id) must set a bit for id in one of the two bitsets at pool+0x67c / +0x68c, ResetCollectible(id) must
+-- clear it again, and an id past the item config must raise the argument error.
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab pool test", 1)
+local function check(name, ok, detail)
+  B.log("lab_pool_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local started, frame = false, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+local function bits(pool, id)
+  local word, bit = id >> 5, id & 31
+  local a = (B.r32(B.r32(pool + 0x67c) + 4 * word) >> bit) & 1
+  local b = (B.r32(B.r32(pool + 0x68c) + 4 * word) >> bit) & 1
+  return a, b
+end
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if frame ~= 20 then return end
+  local ok, err = pcall(function()
+    check("Implemented ItemPool.ResetCollectible", REPENTOGON and REPENTOGON.Implemented["ItemPool.ResetCollectible"])
+    local pool = Game():GetItemPool()
+    local p = T.this(pool, "lab")
+    for _, id in ipairs({ CollectibleType.COLLECTIBLE_SAD_ONION, CollectibleType.COLLECTIBLE_BRIMSTONE }) do
+      local a0, b0 = bits(p, id)
+      pool:RemoveCollectible(id)
+      local a1, b1 = bits(p, id)
+      check("RemoveCollectible(" .. id .. ") sets a bit", a1 + b1 > 0, a0 .. b0 .. " -> " .. a1 .. b1)
+      pool:ResetCollectible(id)
+      local a2, b2 = bits(p, id)
+      check("ResetCollectible(" .. id .. ") clears them", a2 + b2 == 0, a2 .. b2)
+    end
+    local e1 = pcall(pool.ResetCollectible, pool, 100000)
+    check("an id past the config raises", not e1)
+    local e2 = pcall(pool.ResetCollectible, pool, -1)
+    check("an id below 0 raises", not e2)
+    local e3 = pcall(pool.ResetCollectible, pool, 0)
+    check("0 (COLLECTIBLE_NULL) is accepted", e3)
+  end)
+  if not ok then check("lab", false, err) end
+end)
diff --git a/scripts/recomp/rgon/lab_scan.lua b/scripts/recomp/rgon/lab_scan.lua
