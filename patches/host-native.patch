+  -- DropCollectibleByHistoryIndex(historyIndex, existingPickup = nil): REPENTOGON ignores the game's answer and
+  -- hands back the pickup it was given (nil without one)
+  method("EntityPlayer", "DropCollectibleByHistoryIndex", function(self, index, pickup)
+    index = int_arg(index, 1, "DropCollectibleByHistoryIndex")
+    local p = type(pickup) == "userdata" and ptr(pickup) or 0
+    call(0x007906f0, this(self, "DropCollectibleByHistoryIndex"), index & 0xffffffff, p, 0)
+    return p ~= 0 and pickup or nil
+  end)
+  -- DropCollectible(collectible, existingPickup = nil, removeFromPlayerForm = false) -> the pickup dropped, or the one given
+  method("EntityPlayer", "DropCollectible", function(self, id, pickup, remove)
+    id = int_arg(id, 1, "DropCollectible")
+    local p = type(pickup) == "userdata" and ptr(pickup) or 0
+    local got = call(0x00790530, this(self, "DropCollectible"), id & 0xffffffff, p, remove and 1 or 0)
+    if got ~= 0 then return wrap("EntityPickup", got) end
+    return p ~= 0 and pickup or nil
+  end)
+
+  -- EntityPickup
+  gcall("EntityPickup", "GetAlternatePedestal", 0x006e1d70, "", "int")
+  gcall("EntityPickup", "SetAlternatePedestal", 0x006e1a80, "i", "void")
+  gcall("EntityPickup", "SetForceBlind", 0x006e1e60, "b", "void")
+
+  -- Entity: the minecart StageAPI's rail rooms put an enemy on
+  gcall("Entity", "GiveMinecart", 0x006b7be0, "V;V", "EntityNPC")
+
+  -- EntityFamiliar, GridEntityRock
+  gcall("EntityFamiliar", "CanBlockProjectiles", 0x0060d8e0, "", "bool")
+  gcall("EntityFamiliar", "GetFollowerPriority", 0x00612970, "", "int")
+  gcall("GridEntityRock", "TrySpawnLadder", 0x0071b1c0, "", "void")
+
+  -- Level, Room, Game
+  gcall("Level", "HasPhotoDoor", 0x0074f030, "", "bool")
+  gcall("Room", "CanPickupGridEntity", 0x00825730, "i", "bool")
+  gcall("Room", "CanSpawnObstacleAtPosition", 0x00822820, "i;b=false", "bool")
+  gcall("Room", "GetBossVictoryJingle", 0x00820720, "", "uint")
+  method("Game", "IsHardMode", function() return (call(0x006f8100, nil) & 0xff) ~= 0 end)
+else
+  log("api_census: api_game.lua's gcall is missing; the calls into the game are left out")
+end
