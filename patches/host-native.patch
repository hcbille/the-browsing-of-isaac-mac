+    EntityPickup.SetupCollectibleGraphics(spr, 1, CollectibleType.COLLECTIBLE_BRIMSTONE, false, 5, true)
+    local path = spr:GetLayer(1):GetSpritesheetPath()
+    check("SetupCollectibleGraphics sets the spritesheet", path:find("118", 1, true) ~= nil, path)
