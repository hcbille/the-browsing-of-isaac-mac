--- /dev/null
+++ b/scripts/recomp/rgon/api_isaac_misc.lua
@@ -0,0 +1,139 @@
+-- api_isaac_misc.lua -- wave 6, worker misc-a: the small REPENTOGON names that could be done with the game's own functions.
+-- Written against REPENTOGON's documented behaviour; every address and offset was found in THIS executable (v1.9.7.17) and is
+-- read back by lab_isaac_misc.lua. Loaded after api_gfx.lua.
+--
+--   Room::ComputeColorModifier  0x00823370 (thiscall, ecx = the room, one stack word = a 24-byte out buffer, `ret 4`): writes six
+--       floats R G B A brightness contrast from room +0x1b10 (4 floats), +0x1b24, +0x1b28 (the room's FXParams: its colour, brightness
+--       and contrast), then lightens them for the Womb-like backdrops (room +8 = 7, 8 or 0x1d) and applies the dirty-room and
+--       Hush adjustments. 0x00823540 is the game's own caller: it computes, then runs Game::SetColorModifier with lerp = true
+--       unless the game's two "no lerp" flags are set. REPENTOGON's Room:UpdateColorModifier(process, lerp, rate) does the same with
+--       the caller's lerp and rate, and with process = false it hands the FXParams' raw six floats over.
+--   RoomDescriptor::InitSeeds   0x00428940 (thiscall, ecx = the descriptor, one stack word = RNG*, `ret 4`): three steps of the
+--       RNG into DecorationSeed (+0x58), SpawnSeed (+0x5c), AwardSeed (+0x60), then BossDeathSeed (+0x64) = one fixed step
+--       (shifts 11, 7, 12) of the award seed. The game's own PlaceRoom runs it for every new room.
+--   ProceduralItemManager::CreateProceduralItem  0x009dcc70 (thiscall, ecx = the manager = game +0x67758, stack: seed, unk, `ret 8`):
+--       refuses at 0x400 items (answers an existing one's id), seed 1 is the game's G FUEL special; otherwise builds the item and
+--       answers its id. REPENTOGON's signature for it matches nothing in this exe; found by its shape (a vector-size test against
+--       0x400 at the top, a 0x2c0-byte frame) and read from the decompile.
+--   Isaac.LoadModDataFromFolder reads `data/<folder>/save<slot>.dat` through the game's file layer (the game's own log names it //data/...; `../data/` does not resolve here,
+--       `data/` does: 379 bytes, the size of the file on disk).
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local r8, r32, ri32, rf32, w8, w32, wf32, call, log, ptr = B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call, B.log, B.ptr
+local type, error, pcall, ipairs, pairs, getmetatable, rawget, rawset, tostring = type, error, pcall, ipairs, pairs, getmetatable, rawget, rawset, tostring
+local mathtype = math.type
+
+local GAME_PTR = 0x00c71678
+local MANAGER_PTR = 0x00c7169c
+
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (integer expected, got " .. type(v) .. ")", 3)
+end
+local function signed(v) return v >= 0x80000000 and v - 0x100000000 or v end
+
+------------------------------------------------------------------------------
+-- Room:UpdateColorModifier(process = true, lerp = true, rate = 0.015)
+------------------------------------------------------------------------------
+do
+  local COMPUTE = 0x00823370
+  local ROOM_COLOR = 0x1b10              -- R G B A at +0, brightness +0x14, contrast +0x18
+  method("Room", "UpdateColorModifier", function(self, process, lerp, rate)
+    local room = this(self, "UpdateColorModifier")
+    if process == nil then process = true end
+    if lerp == nil then lerp = true end
+    if rate == nil then rate = 0.015 elseif type(rate) ~= "number" then
+      error("bad argument #3 to 'UpdateColorModifier' (number expected, got " .. type(rate) .. ")", 2)
+    end
+    local buf = B.alloc(24)
+    local c
+    if process then
+      call(COMPUTE, { ecx = room }, buf)
+      c = ColorModifier(rf32(buf), rf32(buf + 4), rf32(buf + 8), rf32(buf + 12), rf32(buf + 16), rf32(buf + 20))
+    else
+      local a = room + ROOM_COLOR
+      c = ColorModifier(rf32(a), rf32(a + 4), rf32(a + 8), rf32(a + 12), rf32(a + 0x14), rf32(a + 0x18))
+    end
+    B.free(buf)
+    Game():SetColorModifier(c, lerp and true or false, rate)
+  end)
+end
+
+------------------------------------------------------------------------------
+-- RoomDescriptor:InitSeeds(rng)
+------------------------------------------------------------------------------
+do
+  local DM = T.descriptor_methods
+  if DM then
+    DM.InitSeeds = B.cfn(function(self, rng)
+      if type(rng) ~= "userdata" or rng.RandomFloat == nil then
+        error("bad argument #1 to 'InitSeeds' (RNG expected, got " .. type(rng) .. ")", 2)
+      end
+      call(0x00428940, { ecx = ptr(self) }, ptr(rng))
+    end)
+    R.Implemented["RoomDescriptor.InitSeeds"] = true
+  else
+    log("api_isaac_misc: no descriptor method table; RoomDescriptor:InitSeeds is left out")
+  end
+end
+
+------------------------------------------------------------------------------
+-- ProceduralItemManager.CreateProceduralItem(seed, unk)
+------------------------------------------------------------------------------
+do
+  local PROC = 0x67758
+  local M = rawget(_G, "ProceduralItemManager")
+  if type(M) == "table" and rawget(M, "CreateProceduralItem") == nil then
+    rawset(M, "CreateProceduralItem", function(seed, unk)
+      seed = int_arg(seed, 1, "CreateProceduralItem")
+      unk = int_arg(unk, 2, "CreateProceduralItem")
+      local eax = call(0x009dcc70, { ecx = r32(GAME_PTR) + PROC }, seed & 0xffffffff, unk & 0xffffffff)
+      return signed(eax)
+    end)
+    R.Implemented["ProceduralItemManager.CreateProceduralItem"] = true
+  end
+end
+
+------------------------------------------------------------------------------
+-- Isaac.LoadModDataFromFolder(folderName) -> string or nil
+------------------------------------------------------------------------------
+do
+  local function safe_folder(name)
+    return name ~= "" and not name:find("[/\\:%z]") and not name:find("..", 1, true)
+  end
+  local Isaac_ = Isaac
+  if rawget(Isaac_, "LoadModDataFromFolder") == nil and T.read_file then
+    T.static(Isaac_, "Isaac", "LoadModDataFromFolder", function(folder)
+      if type(folder) ~= "string" then
+        error("bad argument #1 to 'LoadModDataFromFolder' (string expected, got " .. type(folder) .. ")", 2)
+      end
+      local slot = r32(r32(MANAGER_PTR) + 0x10)
+      if slot > 3 or not safe_folder(folder) then return nil end
+      if slot == 0 then slot = 1 end
+      return T.read_file("data/" .. folder .. "/save" .. slot .. ".dat")
+    end)
+  end
+end
+
+------------------------------------------------------------------------------
+-- ItemConfigCard.ModdedCardFront (read only): the sprite a modded card is drawn with, at card +0x6c (the word after the ModEntry
+-- pointer at +0x68; both are 0 for vanilla cards, measured by lab_isaac_misc.lua). nil when the card has none.
+------------------------------------------------------------------------------
+do
+  local sample = Isaac.GetItemConfig():GetCard(1)
+  local mt = sample and getmetatable(sample)
+  if type(mt) == "table" then
+    local getter = B.cfn(function(self)
+      local p = ptr(self)
+      if p == 0 then error("rgon: ItemConfigCard.ModdedCardFront read without its card", 2) end
+      return wrap("Sprite", r32(p + 0x6c))
+    end)
+    local done = false
+    for _, t in ipairs({ mt, rawget(mt, "__class"), rawget(mt, "__const") }) do
+      local pg = type(t) == "table" and rawget(t, "__propget")
+      if type(pg) == "table" and rawget(pg, "ModdedCardFront") == nil then rawset(pg, "ModdedCardFront", getter) done = true end
+    end
+    if done then R.Implemented["ItemConfigCard.ModdedCardFront"] = true end
+  end
+end
diff --git a/scripts/recomp/rgon/api_item_fields.lua b/scripts/recomp/rgon/api_item_fields.lua
new file mode 100644
index 0000000..bfe5ed2
--- /dev/null
+++ b/scripts/recomp/rgon/api_item_fields.lua
@@ -0,0 +1,50 @@
+-- api_item_fields.lua -- writable ItemConfigItem fields (M8, 2026-11-19). Fiend Folio writes
+--   Isaac.GetItemConfig():GetCollectible(id).ChargeType = ItemConfig.CHARGE_SPECIAL
+-- (also .Name, .Description, .GfxFileName, .CacheFlags) and the game answers "no member named 'ChargeType'".
+--
+-- What the game has. ItemConfig:GetCollectible / GetTrinket / GetNullItem / GetCollectibles / ... hand out a
+-- `const Item` userdata. luabridge keeps two class tables for the class: the plain one ("Item") has a __propset
+-- table with a setter for each of the 29 fields (AchievementID, AddBlackHearts, AddBombs, AddCoins,
+-- AddCostumeOnPickup, AddHearts, AddKeys, AddMaxHearts, AddSoulHearts, CacheFlags, ChargeType, ClearEffectsOnRemove,
+-- CraftingQuality, Description, DevilPrice, GfxFileName, Hidden, ID, InitCharge, MaxCharges, MaxCooldown, Name,
+-- PassiveCache, PersistentEffect, Quality, ShopPrice, Special, Tags, Type), and the const one has __propget only,
+-- so a write through it ends in luabridge's "no member named". (Costume has a getter and no setter.) Items that
+-- REPENTOGON hands to its callbacks and to GetTaggedItems come with the plain metatable, which is why a write works
+-- there. lab_icfg_probe.lua prints all of this.
+--
+-- What this does. The const metatable gets a __propset of its own whose entries take the const userdata, make a
+-- plain-class userdata for the same address and call the game's own setter with it. So the record is written by
+-- the game's own code at the game's own offsets (nothing here knows an offset), strings included (the game's
+-- setter owns the std::string handling). lab_icfg_test.lua measures where each write lands (a diff of the record
+-- before and after) and reads each value back through the vanilla getter.
+
+local T = ...
+local B, R = T.B, T.R
+local type, pairs, rawget, rawset, getmetatable, pcall = type, pairs, rawget, rawset, getmetatable, pcall
+local ptr, obj = B.ptr, B.obj
+
+local config = Isaac.GetItemConfig()
+local sample = config and config:GetCollectible(1)
+local cmt = sample and getmetatable(sample)
+local class = type(cmt) == "table" and rawget(cmt, "__class")
+local setters = type(class) == "table" and rawget(class, "__propset")
+if type(setters) ~= "table" then
+  B.log("api_item_fields: no setter table on the game's Item class; ItemConfigItem fields stay read-only")
+elseif rawget(cmt, "__propset") ~= nil then
+  B.log("api_item_fields: the const Item class already has setters; left alone")
+else
+  local vt = T.vt_ptr()
+  local mine, count = {}, 0
+  for name, set in pairs(setters) do
+    if type(name) == "string" then
+      rawset(mine, name, B.cfn(function(self, value)
+        local p = ptr(self)
+        if p == 0 then error("rgon: ItemConfigItem." .. name .. " written without its item", 2) end
+        return set(obj(class, p, vt), value)
+      end))
+      count = count + 1
+    end
+  end
+  rawset(cmt, "__propset", mine)
+  B.log("api_item_fields: ItemConfigItem has " .. count .. " writable field(s) through the game's own setters")
+end
diff --git a/scripts/recomp/rgon/api_leftovers.lua b/scripts/recomp/rgon/api_leftovers.lua
new file mode 100644
index 0000000..a923fd4
--- /dev/null
+++ b/scripts/recomp/rgon/api_leftovers.lua
@@ -0,0 +1,274 @@
+-- api_leftovers.lua -- wave 5, worker misc: the small REPENTOGON names the Fiend Folio / Epiphany backlog still listed, by class.
+-- Written against REPENTOGON's documented behaviour; every address and offset was found in THIS executable (v1.9.7.17) and is
+-- read back by lab_leftovers.lua. Loaded after api_hooks_hud.lua (it adds methods to that file's HistoryHUD table).
+--
+--   Game lightning intensity float at game +0x67734: the game's own per-update decay reads it (0x006faf13: above the threshold it
+--       is multiplied by a constant, otherwise zeroed) and its own strike code writes it at 0x0080464d and then plays sound 0x1d8
+--       (472). Room:DoLightningStrike writes 1.3 + RandomFloat() * 0.6 from an RNG seeded with shift index 35, as documented.
+--   HUD +0x5c54 is the HistoryHUD (HUD::Render passes `lea ecx, [edi+0x5c54]` to HistoryHUD::Render 0x0083ac20, 0x009a4142).
+--       Two 0x14-byte per-player blocks: player pointer +0, vector of 0x28-byte items at +8/+0xc (the history item copy at item +0xc:
+--       time, trinket byte, id at +8 of it). Minimap::GetDisplayedSize 0x0098b570 (thiscall ecx = game +0x25ecc, one stack word =
+--       Vector* out, `ret 4`).
+--   Entity::GetNullCapsule 0x006b6c20 (thiscall, stack: Capsule* out (0x28 bytes), const char* layer; `ret 8`).
+--   RoomConfig_Room +4 is the Mode as a plain int.
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local r8, r32, ri32, rf32, w8, w32, wf32, call, log, ptr = B.r8, B.r32, B.ri32, B.rf32, B.w8, B.w32, B.wf32, B.call, B.log, B.ptr
+local type, error, pcall, ipairs, pairs, getmetatable, rawget, rawset, setmetatable, tostring = type, error, pcall, ipairs, pairs, getmetatable, rawget, rawset, setmetatable, tostring
+local mathtype, ceil, floor = math.type, math.ceil, math.floor
+
+local GAME_PTR = 0x00c71678
+local G_LIGHTNING = 0x67734
+
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (integer expected, got " .. type(v) .. ")", 3)
+end
+local function num_arg(v, n, fname)
+  if type(v) == "number" then return v end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (number expected, got " .. type(v) .. ")", 3)
+end
+
+------------------------------------------------------------------------------
+-- Room: lightning, boss hazards
+------------------------------------------------------------------------------
+method("Room", "GetLightningIntensity", function(self)
+  this(self, "GetLightningIntensity")
+  return rf32(r32(GAME_PTR) + G_LIGHTNING)
+end)
+method("Room", "SetLightningIntensity", function(self, v)
+  this(self, "SetLightningIntensity")
+  wf32(r32(GAME_PTR) + G_LIGHTNING, num_arg(v, 1, "SetLightningIntensity"))
+end)
+method("Room", "DoLightningStrike", function(self, seed)
+  this(self, "DoLightningStrike")
+  if seed == nil then seed = Random() else seed = int_arg(seed, 1, "DoLightningStrike") end
+  local rng = RNG()
+  rng:SetSeed(seed & 0xffffffff, 35)
+  wf32(r32(GAME_PTR) + G_LIGHTNING, 1.3 + rng:RandomFloat() * 0.6)
+  SFXManager():Play(472, 1.0, 2, false, 0.9 + rng:RandomFloat() * 0.2)
+end)
+
+-- Room:ClearBossHazards(ignoreNPCs = true, source = nil): kills every projectile; with ignoreNPCs false also the hostile NPCs that
+-- keep the doors shut. Done with the game's own Entity:Kill (the game's function of this name is not located).
+method("Room", "ClearBossHazards", function(self, ignore_npcs, source)
+  this(self, "ClearBossHazards")
+  if ignore_npcs == nil then ignore_npcs = true end
+  if source ~= nil and type(source) ~= "userdata" then
+    error("bad argument #2 to 'ClearBossHazards' (Entity expected, got " .. type(source) .. ")", 2)
+  end
+  for _, e in ipairs(Isaac.GetRoomEntities()) do
+    if e.Type == EntityType.ENTITY_PROJECTILE then
+      e:Kill()
+    elseif not ignore_npcs then
+      local npc = e:ToNPC()
+      if npc and not e:HasEntityFlags(EntityFlag.FLAG_FRIENDLY) and not e:IsDead() and npc.CanShutDoors then e:Kill() end
+    end
+  end
+end)
+
+------------------------------------------------------------------------------
+-- EntityPlayer:SpawnAquariusCreep(tearParams = the player's own)
+-- Aquarius's creep is effect variant 54, its tear flags the effect's variant data (api_tears_more.lua, offset 0x420, measured
+-- there). The player's params are what the game computes for it: GetTearHitParams(WEAPON_TEARS, poison * 0.666 / damage, +-1, nil).
+------------------------------------------------------------------------------
+method("EntityPlayer", "SpawnAquariusCreep", function(self, params)
+  local p = this(self, "SpawnAquariusCreep")
+  if params ~= nil and type(params) ~= "userdata" then error("bad argument #1 to 'SpawnAquariusCreep' (TearParams expected, got " .. type(params) .. ")", 2) end
+  if params == nil then
+    local dmg = self.Damage
+    local scale = dmg ~= 0 and (self:GetTearPoisonDamage() * 0.666) / dmg or 0
+    params = self:GetTearHitParams(WeaponType.WEAPON_TEARS, scale, (Random() % 2 ~= 0) and 1 or -1, nil)
+  end
+  local effect = Isaac.Spawn(EntityType.ENTITY_EFFECT, 54, 0, self.Position, Vector(0, 0), self)
+  if effect == nil then return nil end
+  effect:ToEffect()
+  effect.SpriteScale = effect.SpriteScale * (math.random() * 0.5 + 0.2)
+  effect.CollisionDamage = params.TearDamage
+  effect:SetColor(params.TearColor, 0, -1, true, false)
+  effect:ToEffect():SetAquariusTearFlags(params.TearFlags)
+  effect:Update()
+  return effect:ToEffect()
+end)
+
+------------------------------------------------------------------------------
+-- Entity:GetNullCapsule(layerName)
+------------------------------------------------------------------------------
+method("Entity", "GetNullCapsule", function(self, layer)
+  local p = this(self, "GetNullCapsule")
+  if type(layer) ~= "string" then error("bad argument #1 to 'GetNullCapsule' (string expected, got " .. type(layer) .. ")", 2) end
+  local buf, s = B.alloc(0x28), B.alloc(#layer + 1)
+  for i = 1, #layer do w8(s + i - 1, layer:byte(i)) end
+  w8(s + #layer, 0)
+  call(0x006b6c20, p, buf, s)
+  local c = T.capsule_from_struct(buf)
+  B.free(buf) B.free(s)
+  return c
+end)
+
+------------------------------------------------------------------------------
+-- RoomConfigRoom.Mode: a plain integer (the game's own answers a userdata)
+------------------------------------------------------------------------------
+local mode_done = false
+local function install_mode()
+  if mode_done then return end
+  local desc = Game():GetLevel():GetCurrentRoomDesc()
+  local data = desc and desc.Data
+  if data == nil then return end
+  local mt = getmetatable(data)
+  if type(mt) ~= "table" then return end
+  for _, t in ipairs({ mt, rawget(mt, "__class"), rawget(mt, "__const") }) do
+    local pg = type(t) == "table" and rawget(t, "__propget")
+    if type(pg) == "table" and rawget(pg, "Mode") ~= nil then pg.Mode = B.cfn(function(self) return ri32(ptr(self) + 4) end) end
+  end
+  mode_done = true
+end
+R.Implemented["RoomConfigRoom.Mode"] = true
+if T.listen then
+  T.listen(ModCallbacks.MC_POST_PLAYER_INIT, install_mode, -math.huge)
+  T.listen(ModCallbacks.MC_POST_NEW_LEVEL, install_mode, -math.huge)
+  T.listen(ModCallbacks.MC_POST_NEW_ROOM, install_mode, -math.huge)
+end
+
+------------------------------------------------------------------------------
+-- HistoryHUD
+------------------------------------------------------------------------------
+local H_OFFSET = 0x5c54
+local HH = rawget(_G, "HistoryHUD")
+local mk_hud = T.history_hud
+if type(HH) == "table" and mk_hud then
+  local TRINKET_MASK = 0x7fff
+  local function minimap_size()
+    local out = B.alloc(8)
+    wf32(out, 0) wf32(out + 4, 0)
+    call(0x0098b570, { ecx = r32(GAME_PTR) + 0x25ecc }, out)
+    local x, y = rf32(out), rf32(out + 4)
+    B.free(out)
+    return x, y
+  end
+  local function hud_offset() return 1 - Options.HUDOffset end
+  local function pos_xy()
+    local _, my = minimap_size()
+    local h = hud_offset()
+    return Isaac.GetScreenWidth() - 87 + h * 24, h * -14 + my + 32
+  end
+  local function is_mini() return Options.ExtraHUDStyle == 2 end
+  local function icon_size() return is_mini() and 16.0 or 32.0 end
+  local function base(self)
+    local a = type(self) == "table" and rawget(self, "address")
+    if not a then error("rgon: HistoryHUD method called without its object (use ':')", 3) end
+    return a
+  end
+  local function has_twin(a) return r32(a + 0x14) ~= 0 end
+  local function columns(a)
+    local c = has_twin(a) and 1 or 2
+    if is_mini() then c = c * 2 end
+    return c
+  end
+  local function visible_count(a)
+    local _, py = pos_xy()
+    local rows = ceil(((hud_offset() * 14 + (Isaac.GetScreenHeight() - 64)) - py) / icon_size())
+    return rows * columns(a)
+  end
+  local function render_offset(a, slot, index)
+    local cols = columns(a)
+    local x, y = (index % cols) * icon_size(), (index // cols) * icon_size()
+    if has_twin(a) then x = x - 2 + 33 * slot end
+    return Vector(x, y)
+  end
+
+  local ITEM_MT = { __type = "HistoryHUDItem", __name = "HistoryHUDItem" }
+  ITEM_MT.__index = ITEM_MT
+  ITEM_MT.__tostring = function(s) return "HistoryHUDItem(" .. tostring(s._id) .. ")" end
+  local function self_item(s)
+    if type(s) ~= "table" or getmetatable(s) ~= ITEM_MT then error("rgon: HistoryHUDItem method called without its object (use ':')", 3) end
+    return s
+  end
+  function ITEM_MT:GetItemID() return self_item(self)._id end
+  function ITEM_MT:GetTime() return self_item(self)._time end
+  function ITEM_MT:GetRenderOffset()
+    local s = self_item(self)
+    return render_offset(s._hud, s._slot, s._index)
+  end
+  function ITEM_MT:IsVisible()
+    local s = self_item(self)
+    return s._index < visible_count(s._hud)
+  end
+  for _, n in ipairs({ "GetItemID", "GetTime", "GetRenderOffset", "IsVisible" }) do R.Implemented["HistoryHUDItem." .. n] = true end
+
+  local function check_player(idx, fname)
+    idx = int_arg(idx, 1, fname)
+    if idx < 0 or idx > 1 then error("Invalid HistoryHUDPlayer index " .. idx .. ", must be 0 or 1", 3) end
+    return idx
+  end
+  -- filter: nil, a number, or a table of numbers -> set (or nil for "everything")
+  local function filter_set(v, trinkets)
+    if v == nil then return nil end
+    local set, n = {}, 0
+    local function add(x) if mathtype(x) == "integer" then set[trinkets and (x & TRINKET_MASK) or x] = true n = n + 1 end end
+    if type(v) == "table" then for _, x in ipairs(v) do add(x) end else add(int_arg(v, 2, "filter")) end
+    return n > 0 and set or nil
+  end
+  local function collect(a, idx, want_coll, want_trink, not_visible, offsets_only, ids)
+    local out, n = {}, 0
+    local base_a = a + 0x14 * idx
+    if r32(base_a) == 0 then return out end
+    local b, e = r32(base_a + 8), r32(base_a + 12)
+    if b == 0 then return out end
+    local count = (e - b) // 0x28
+    local vis = visible_count(a)
+    for i = 0, count - 1 do
+      if not not_visible and i >= vis then break end
+      local it = b + 0x28 * i
+      local trinket = r8(it + 0x10) ~= 0
+      local id = ri32(it + 0x14)
+      if trinket and want_trink or (not trinket) and want_coll then
+        local key = trinket and (id & TRINKET_MASK) or id
+        if ids == nil or ids[key] then
+          n = n + 1
+          if offsets_only then out[n] = render_offset(a, idx, i)
+          else out[n] = setmetatable({ _hud = a, _slot = idx, _index = i, _id = id, _trinket = trinket, _time = ri32(it + 0xc) }, ITEM_MT) end
+        end
+      end
+    end
+    return out
+  end
+
+  local function def(name, f)
+    HH[name] = f
+    R.Implemented["HistoryHUD." .. name] = true
+  end
+  def("GetPosition", function(self)
+    base(self)
+    return Vector(pos_xy())
+  end)
+  def("GetPlayer", function(self, idx)
+    local a = base(self)
+    idx = check_player(idx, "GetPlayer")
+    local p = r32(a + 0x14 * idx)
+    if p == 0 then return nil end
+    return wrap("EntityPlayer", p)
+  end)
+  def("GetItems", function(self, idx, not_visible)
+    local a = base(self)
+    idx = check_player(idx, "GetItems")
+    return collect(a, idx, true, true, not_visible == true, false, nil)
+  end)
+  def("GetCollectibles", function(self, idx, ids, not_visible)
+    local a = base(self)
+    idx = check_player(idx, "GetCollectibles")
+    return collect(a, idx, true, false, not_visible == true, false, filter_set(ids, false))
+  end)
+  def("GetCollectibleOffsets", function(self, idx, ids, not_visible)
+    local a = base(self)
+    idx = check_player(idx, "GetCollectibleOffsets")
+    return collect(a, idx, true, false, not_visible == true, true, filter_set(ids, false))
+  end)
+  -- inert: HistoryHUD:GetTrinkets, HistoryHUD:GetTrinketOffsets, HistoryHUDItem:IsTrinket: no trinket entry reached the history in the
+  -- lab (a picked-up Swallowed Penny left the vector at three collectibles), so the trinket byte/id layout is not measured.
+
+  method("HUD", "GetHistoryHUD", function(self)
+    return mk_hud(this(self, "GetHistoryHUD") + H_OFFSET)
+  end)
+end
diff --git a/scripts/recomp/rgon/api_locate.lua b/scripts/recomp/rgon/api_locate.lua
new file mode 100644
index 0000000..dff2879
--- /dev/null
+++ b/scripts/recomp/rgon/api_locate.lua
@@ -0,0 +1,100 @@
+-- api_locate.lua -- wave 7, worker locate: engine functions REPENTOGON's byte signatures could not find in v1.9.7.17,
+-- found here by their callers, their `ret N` and what their bodies do (never by a bare signature), then proven by
+-- lab_locate.lua. Written against REPENTOGON's behaviour (LuaEntityPlayer.cpp, LuaPlayerManager.cpp); no C++ copied.
+--
+--   EntityPlayer:Teleport(position, doEffects = true, teleportTwinPlayers = false)
+--       Entity_Player::Teleport, 0x007cd950: thiscall, ecx = the player, three stack words (Vector*, bool, bool), `ret 0xc`
+--       (epilogue 0x007cded3). Found by its body, not by REPENTOGON's signature (that one matches 0x008c99b0, a menu
+--       function): it plays the "TeleportUp" and "TeleportDown" animations (strings at 0x00b1dff0 / 0x00b1e010), writes
+--       the position (+0x33c, +0x340) and clears the velocity (+0x360, +0x364) from the constant vector 0x00c7b640, and
+--       calls itself for the twin (+0x1e68) when the third word is set. Its one caller, 0x0047c9ca, is a game function.
+--   EntityPlayer:InitTwin(playerType) -> EntityPlayer
+--       0x007d2000: thiscall, ecx = the player, one stack word (the type), `ret 4`, answers the new player. It calls
+--       PlayerManager::SpawnCoPlayer2 (0x009b9cd0, the function whose log line is "Spawning Co-Op Player (ePlayerType = %d)"),
+--       links the two players as each other's twin (+0x1e68 both ways, which 0x007d2000 is the only writer of besides the
+--       player constructor and the state restore), gives the new player the owner's controller (the word at +0x1618, through
+--       0x007a6450) and puts them 20 units either side of the owner's old position. The game's Jacob and Esau path calls it
+--       (caller 0x007be664).
+--   PlayerManager.RemoveCoPlayer(player)
+--       PlayerManager::RemoveCoPlayer, 0x009ba000: thiscall, ecx = the manager (game + 0x1baa8), two stack words (the player
+--       and the unused bool), `ret 8` (epilogue 0x009ba8d7). Found by its body: it logs "Clearing player color assignment
+--       for controllerId %d" (0x00b7e748), clears the twin links, runs the player's destructor and erases it from the
+--       player list (the vector at the manager's +0, whose end is game + 0x1baac). It leaves the other player's twin link dangling,
+--       which the Layer clears after the call. Its callers: 0x007061cb and others;
+--       0x009bc120 (the "player left" path) calls it for every player after the first.
+local T = ...
+local B, R, method, wrap, this = T.B, T.R, T.method, T.wrap, T.this
+local ptr, r32, ri32, call, log = B.ptr, B.r32, B.ri32, B.call, B.log
+local type, error, rawget, math = type, error, rawget, math
+local mathtype = math.type
+
+local GAME_PTR = 0x00c71678
+local PM_OFFSET = 0x1baa8   -- the PlayerManager inside the Game: its player list is the vector {begin, end} at +0, +4
+
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (number expected, got " .. type(v) .. ")", 3)
+end
+local function vec_ptr(v, n, fname)
+  local p = type(v) == "userdata" and ptr(v) or 0
+  if p == 0 then error("bad argument #" .. n .. " to '" .. fname .. "' (Vector expected, got " .. type(v) .. ")", 3) end
+  return p
+end
+local function opt_bool(v, n, fname, default)
+  if v == nil then return default end
+  if type(v) ~= "boolean" then error("bad argument #" .. n .. " to '" .. fname .. "' (boolean expected, got " .. type(v) .. ")", 3) end
+  return v
+end
+
+------------------------------------------------------------------------------
+-- EntityPlayer:Teleport / InitTwin
+------------------------------------------------------------------------------
+method("EntityPlayer", "Teleport", function(self, position, effects, twins)
+  local p = this(self, "Teleport")
+  local v = vec_ptr(position, 1, "Teleport")
+  effects = opt_bool(effects, 2, "Teleport", true)
+  twins = opt_bool(twins, 3, "Teleport", false)
+  call(0x007cd950, p, v, effects and 1 or 0, twins and 1 or 0)
+end)
+
+method("EntityPlayer", "InitTwin", function(self, playerType)
+  local p = this(self, "InitTwin")
+  playerType = int_arg(playerType, 1, "InitTwin")
+  local twin = call(0x007d2000, p, playerType & 0xffffffff)
+  return wrap("EntityPlayer", twin)
+end)
+
+------------------------------------------------------------------------------
+-- PlayerManager.RemoveCoPlayer(player)
+------------------------------------------------------------------------------
+-- The game does not check the player it is given: a pointer that is not in the list (or the main player, which the
+-- game's own callers never remove) would corrupt the list. REPENTOGON's documentation says "don't pass the main player";
+-- here the main player and anything outside the list are refused with an error instead.
+local PM = rawget(_G, "PlayerManager")
+if type(PM) == "table" then
+  T.static(PM, "PlayerManager", "RemoveCoPlayer", function(player)
+    if type(player) ~= "userdata" then
+      error("bad argument #1 to 'RemoveCoPlayer' (EntityPlayer expected, got " .. type(player) .. ")", 2)
+    end
+    local want = ptr(player)
+    local game = r32(GAME_PTR)
+    local first, last = r32(game + PM_OFFSET), r32(game + PM_OFFSET + 4)
+    local found, idx = false, nil
+    for i = 0, (last - first) // 4 - 1 do
+      if r32(first + 4 * i) == want then found, idx = true, i break end
+    end
+    if not found then error("rgon: RemoveCoPlayer: that player is not in the player list", 2) end
+    if idx == 0 then error("rgon: RemoveCoPlayer: the main player cannot be removed", 2) end
+    call(0x009ba000, game + PM_OFFSET, want, 0)
+    -- measured (lab_locate.lua): the game frees the player but leaves the twin link (+0x1e68) of the other player pointing at
+    -- it, so GetOtherTwin would answer freed memory and Teleport(..., true) would walk into it. Clear every such link.
+    first, last = r32(game + PM_OFFSET), r32(game + PM_OFFSET + 4)
+    for i = 0, (last - first) // 4 - 1 do
+      local other = r32(first + 4 * i)
+      if other ~= 0 and r32(other + 0x1e68) == want then B.w32(other + 0x1e68, 0) end
+    end
+  end)
+else
+  log("api_locate: no PlayerManager table; RemoveCoPlayer is left out")
+end
