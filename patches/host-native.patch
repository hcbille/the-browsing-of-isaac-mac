+------------------------------------------------------------------------------
+-- cb-c: EntityPickup:Get/Set/ClearCanRerollOverride and Room:Get/SetItemPool
+------------------------------------------------------------------------------
+-- Entity_Pickup::CanReroll 0x006ee200 (slot 221, thiscall, bool in AL, plain `ret`): the dead byte [ecx+0x173] answers false, an
+-- override a mod set answers that, otherwise the game's own test runs. The override is kept per InitSeed (0x34) so it outlives the
+-- room (REPENTOGON keeps it in the entity's save state).
+do
+  local reroll = {}
+  local E_INITSEED = 0x34
+  local function pickup_of(self, what)
+    local p = T.this(self, what)
+    return p
+  end
+  on("Entity_Pickup::CanReroll", { T.ALWAYS }, function(self)
+    local v = reroll[r32(self + E_INITSEED)]
+    if v == nil then return nil end
+    if r8(self + 0x173) ~= 0 then return true, 0 end
+    return true, v and 1 or 0
+  end, nil)
+  T.method("EntityPickup", "GetCanRerollOverride", function(self)
+    return reroll[r32(pickup_of(self, "GetCanRerollOverride") + E_INITSEED)]
+  end)
+  T.method("EntityPickup", "SetCanRerollOverride", function(self, v)
+    local p = pickup_of(self, "SetCanRerollOverride")
+    if type(v) ~= "boolean" then error("bad argument #1 to 'SetCanRerollOverride' (boolean expected, got " .. type(v) .. ")", 2) end
+    reroll[r32(p + E_INITSEED)] = v
+  end)
+  T.method("EntityPickup", "ClearCanRerollOverride", function(self)
+    reroll[r32(pickup_of(self, "ClearCanRerollOverride") + E_INITSEED)] = nil
+  end)
+end
+
+-- Room::GetItemPool 0x007ebe20 (slot 222, static: ecx = seed, edx = the RoomDescriptor, boss id at [esp+4], plain `ret`): the pool a
+-- mod set with Room:SetItemPool answers it (POOL_NULL, -1, lets the game choose); it is forgotten when the room is entered (Room::Init,
+-- slot 89, registered ahead of the PRE_NEW_ROOM handler, so a pool set from that callback stays). Room:GetItemPool(seed, raw) runs
+-- the game's own function with the seed and the current room's descriptor; raw answers the pool that was set.
+do
+  on("Room::GetItemPool", { T.ALWAYS }, function()
+    local p = T.room_pool()
+    if p ~= -1 then return true, p end
+  end, nil)
+  T.method("Room", "SetItemPool", function(self, v)
+    if type(v) ~= "number" or v ~= v // 1 then error("bad argument #1 to 'SetItemPool' (number expected, got " .. type(v) .. ")", 2) end
+    if v < -1 or v > 63 then error("bad argument #1 to 'SetItemPool' (Invalid ItemPoolType)", 2) end
+    T.room_pool(math.tointeger(v))
+  end)
+  T.method("Room", "GetItemPool", function(self, seed, raw)
+    if seed ~= nil and type(seed) ~= "number" then error("bad argument #1 to 'GetItemPool' (number expected, got " .. type(seed) .. ")", 2) end
+    if raw ~= nil and type(raw) ~= "boolean" then error("bad argument #2 to 'GetItemPool' (boolean expected, got " .. type(raw) .. ")", 2) end
+    if raw then return T.room_pool() end
+    seed = math.tointeger((seed or Random()) // 1) & 0xffffffff
+    if seed == 0 then seed = 1 end
+    local desc = ptr(Game():GetLevel():GetCurrentRoomDesc())
+    local res = B.call(0x007ebe20, { ecx = seed, edx = desc }, 0)
+    return res >= 0x80000000 and res - 0x100000000 or res
+  end)
+end
