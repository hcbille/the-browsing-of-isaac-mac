+      k:SetHitboxParentKnife(nil)
+      check("SetHitboxParentKnife(nil) clears it", k:GetHitboxParentKnife() == nil)
+      check("SetHitboxParentKnife(number) errors", not pcall(k.SetHitboxParentKnife, k, 5))
+      check("Get/SetHitboxParentKnife are not counted as implemented", REPENTOGON.Implemented["EntityKnife.GetHitboxParentKnife"] == nil)
+    end)
+  elseif frame == 90 then
+    check("the game survived the knife hit list", Isaac.GetPlayer(0) ~= nil)
