+-- Sprite(anm2Path [, load = true]): REPENTOGON's constructor. The game's own
+-- takes no argument and makes an empty sprite, so a mod that builds
+-- `Sprite("gfx/x.anm2", true)` and goes on to SetFrame / GetLayer got a sprite
+-- with no animations ("no animation named X") and a Color without members.
+-- The constructor in the static table's metatable is wrapped: make the sprite
+-- the game's way, then Load the path it was given.
+do
+  local smt = getmetatable(Sprite)
+  local orig = type(smt) == "table" and rawget(smt, "__call")
+  if orig then
+    rawset(smt, "__call", function(self, path, load)
+      local s = orig(self)
+      if path ~= nil then
+        if type(path) ~= "string" then error("bad argument #1 to 'Sprite' (string expected, got " .. type(path) .. ")", 2) end
+        s:Load(path, load ~= false)
+      end
+      return s
+    end)
+    R.Implemented["Sprite.Sprite"] = true
+  else
+    log("api_sprite: the Sprite constructor is not where it was expected; Sprite(path, load) is left out")
+  end
+end
