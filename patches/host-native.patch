+at(34, function(p)
+  say("suplex state after use " .. p:GetSuplexState() .. ", aim " .. p:GetSuplexAimCountdown() .. ", held " .. tostring(p:GetHeldEntity()))
+  check(p:GetSuplexState() ~= 0 or p:GetSuplexAimCountdown() ~= 0, "the game's own Suplex! moves the state or the aim countdown (" .. p:GetSuplexState() .. ", " .. p:GetSuplexAimCountdown() .. ")")
+  p:SetSuplexState(0)
+  p:SetSuplexAimCountdown(0)
+end)
+
+-- held entity
+at(40, function(p)
+  local bomb = Isaac.Spawn(EntityType.ENTITY_BOMB, BombVariant.BOMB_TROLL, 0, p.Position + Vector(0, 40), Vector(0, 0), nil)
