+
+local function save_states()
+  local lvl = g:GetLevel()
+  local found
+  local cur = lvl:GetCurrentRoomDesc()
+  local ok0, v0 = pcall(function() return cur:GetEntitiesSaveState() end)
+  if ok0 and v0 and #v0 > 0 then found = v0 end
+  for i = 0, 168 do if found then break end
+    local d = lvl:GetRoomByIdx(i)
+    if d and d.Data then
+      local ok, v = pcall(function() return d:GetEntitiesSaveState() end)
+      if ok and v and #v > 0 then found = v break end
+    end
+  end
+  if not found then check("EntitySaveState sample", false, "no room with saved entities") return end
+  local s = found:Get(0)
+  local pos0 = s:GetPos()
+  check("EntitySaveState:GetF1/GetF2", type(s:GetF1()) == "number" and type(s:GetF2()) == "number")
+  check("EntitySaveState:GetSubType", math.type(s:GetSubType()) == "integer")
+  local old = { s:GetType(), s:GetVariant(), s:GetSubType(), s:GetI2(), s:GetI3(), s:GetI4(), s:GetI5(), s:GetB1(), s:GetB2(), s:GetF1(), s:GetF2() }
+  s:SetPos(Vector(123, 45))
+  check("EntitySaveState:SetPos", near(s:GetPos().X, 123) and near(s:GetPos().Y, 45))
+  s:SetPos(pos0)
+  s:SetType(77) s:SetVariant(5) s:SetSubType(6) s:SetI2(2) s:SetI3(3) s:SetI4(-4) s:SetI5(5) s:SetB1(true) s:SetB2(true) s:SetF1(1.5) s:SetF2(2.5)
+  check("EntitySaveState setters read back", s:GetType() == 77 and s:GetVariant() == 5 and s:GetSubType() == 6 and s:GetI2() == 2 and s:GetI3() == 3
+    and s:GetI4() == -4 and s:GetI5() == 5 and s:GetB1() == true and s:GetB2() == true and near(s:GetF1(), 1.5) and near(s:GetF2(), 2.5))
+  s:SetType(old[1]) s:SetVariant(old[2]) s:SetSubType(old[3]) s:SetI2(old[4]) s:SetI3(old[5]) s:SetI4(old[6]) s:SetI5(old[7])
+  s:SetB1(old[8]) s:SetB2(old[9]) s:SetF1(old[10]) s:SetF2(old[11])
+  check("EntitySaveState restored", s:GetType() == old[1] and near(s:GetF1(), old[10]))
+  check("SetPos rejects a number", pcall(s.SetPos, s, 5) == false)
+end
+
+local function run()
+  names()
+  simple()
+  game_fields()
+  isaac_fns()
+  objects()
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if frame == 24 then
+    g:ShakeScreen(30)
+  elseif frame == 27 then
+    local gp = B.ptr(g)
+    local x, y = rf32(gp + 0x26508), rf32(gp + 0x2650c)
+    note(string.format("shake offset after ShakeScreen: %.3f, %.3f", x, y))
+    check("game+0x26508 is the screen shake offset", x ~= 0 or y ~= 0)
+  elseif frame == 20 then
+    local ok, err = pcall(run)
+    if not ok then check("run", false, err) end
+  elseif frame == 60 and state.dizzy then
+    local now = g:GetDizzyAmount()
+    note("dizzy after 40 frames: " .. now)
+    check("dizzy stays within its bounds", now >= 0 and now <= 0.5001, now)
+    g:SetDizzyAmount(0, 0)
+  elseif frame == 70 then
+    -- the room change: a seed of zero is an error, then a real seed
+    check("MoveToRandomRoom seed 0 errors", pcall(g.MoveToRandomRoom, g, false, 0, nil) == false)
+    state.room = g:GetLevel():GetCurrentRoomIndex()
+    local ok, err = pcall(g.MoveToRandomRoom, g, false, 4242, nil)
+    check("MoveToRandomRoom call", ok, err)
+  elseif frame == 200 then
+    local now = g:GetLevel():GetCurrentRoomIndex()
+    if now == state.room then
+      note("seed 4242 stayed in room " .. now .. "; trying seed 99")
+      pcall(g.MoveToRandomRoom, g, false, 99, nil)
+    else
+      state.moved = true
+    end
+  elseif frame == 330 then
+    local now = g:GetLevel():GetCurrentRoomIndex()
+    check("MoveToRandomRoom moved the player", state.moved or now ~= state.room, tostring(state.room) .. " -> " .. tostring(now))
+    try("save states", save_states)
+    try("RenderToWorld after the room change", function()
+      local pp = Isaac.GetPlayer(0).Position
+      local v = Isaac.RenderToWorld(Isaac.WorldToScreen(pp))
+      note(string.format("round trip at the player %.2f,%.2f -> %.2f,%.2f; room scroll %.3f,%.3f", pp.X, pp.Y, v.X, v.Y, rf32(B.ptr(g:GetRoom()) + 0x1204), rf32(B.ptr(g:GetRoom()) + 0x1208)))
+      check("RenderToWorld inverts WorldToScreen in the new room", near(v.X, pp.X, 0.05) and near(v.Y, pp.Y, 0.05))
+    end)
+    state.stage = g:GetLevel():GetStage()
+    local ok, err = pcall(g.StartStageTransition, g, false, 0)
+    check("StartStageTransition call", ok, err)
+  elseif frame > 330 and state.stage and not state.done then
+    local now = g:GetLevel():GetStage()
+    if now ~= state.stage or frame > 3000 then
+      state.done = true
+      check("StartStageTransition changed the floor", now == state.stage + 1, tostring(state.stage) .. " -> " .. tostring(now))
+      local id = Isaac.GetCurrentStageConfigId()
+      check("GetCurrentStageConfigId: Basement II shares Basement's config", id == state.stageid, tostring(state.stageid) .. " -> " .. tostring(id))
+      local caves = call(0x0082d030, { ecx = 3, edx = 0 }, 0xffffffff)
+      local ri = ri32
+      note("config id of stage 3 type 0 (direct call) = " .. tostring(caves) .. " (basement " .. tostring(id) .. ")")
+      check("stage 3's config differs from stage 1's", caves ~= id)
+      B.log("lab_game_misc: DONE pass=" .. pass .. " fail=" .. fail)
+    end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_gate_class_test.lua b/scripts/recomp/rgon/lab_gate_class_test.lua
