@@ -0,0 +1,37 @@
+-- lab_stageapi_shot.lua (development only; ISAAC_RGON_LAB=lab_stageapi_shot.lua, StageAPI batch)
+-- Visual proof for Room:SetBackdropType and Room:SetWaterAmount / SetWaterCurrent in a window. In the start room it
+-- changes one thing every 60 updates and logs the update count, so ISAAC_MAC_SHOT=@F:<png> frames (relative to
+-- the script anchor) can be matched to a state:
+--   update  30: baseline            (logs the backdrop id and water amount)
+--   update  90: SetBackdropType(ISAAC_LAB_BACKDROP, 1)   (default 12)
+--   update 150: SetBackdropType(original, 1) and SetWaterAmount(1)
+--   update 210: SetWaterAmount(0) again
+-- Each line reads "lab_stageapi_shot: update N: <state>".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab stageapi shot", 1)
+local n = 0
+local orig
+local function say(s) B.log("lab_stageapi_shot: update " .. n .. ": " .. s) end
+local function state(room) return string.format("backdrop %d water %.2f", room:GetBackdropType(), room:GetWaterAmount()) end
+local target = tonumber(B.env("ISAAC_LAB_BACKDROP") or "") or 12
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  n = n + 1
+  local room = Game():GetRoom()
+  if n == 30 then
+    orig = room:GetBackdropType()
+    say("baseline, " .. state(room))
+  elseif n == 90 then
+    room:SetBackdropType(target, 1)
+    say("SetBackdropType(" .. target .. ", 1), " .. state(room))
+  elseif n == 150 then
+    room:SetBackdropType(orig, 1)
+    room:SetWaterAmount(1)
+    say("backdrop restored and SetWaterAmount(1), " .. state(room))
+  elseif n == 210 then
+    room:SetWaterAmount(0)
+    say("SetWaterAmount(0), " .. state(room))
+  elseif n == 60 or n == 120 or n == 180 or n == 240 then
+    say(state(room))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_stageapi_test.lua b/scripts/recomp/rgon/lab_stageapi_test.lua
new file mode 100644
index 0000000..5ca375e
--- /dev/null
+++ b/scripts/recomp/rgon/lab_stageapi_test.lua
@@ -0,0 +1,212 @@
+-- lab_stageapi_test.lua (development only; ISAAC_RGON_LAB=lab_stageapi_test.lua, StageAPI batch)
+-- Checks the names of api_stageapi.lua in a running game: Room water amount and current, backdrop, rails;
+-- RoomDescriptor Tainted Keeper coin spawns and the three save-state vectors. Prints "lab_stageapi_test: PASS/FAIL ...".
+-- Env: ISAAC_LAB_SHOTS=1 holds each visual state for 90 frames so ISAAC_MAC_SHOT can capture it (water, backdrop).
+local T = ...
+local B = T.B
+local r8, ri32, rf32 = B.r8, B.ri32, B.rf32
+local mod = RegisterMod("rgon lab stageapi test", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_stageapi_test: " .. s) end
+local function check(name, ok, detail)
+  if ok then pass = pass + 1 say("PASS " .. name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
+  else fail = fail + 1 say("FAIL " .. name .. (detail and (" (" .. tostring(detail) .. ")") or "")) end
+end
+local function near(a, b) return math.abs(a - b) < 1e-4 end
+local shots = B.env("ISAAC_LAB_SHOTS") == "1"
+local step, wait, startIdx = 0, 0, nil
+local frame = 0
+
+local function room_checks()
+  local room = Game():GetRoom()
+  local rp = B.ptr(room)
+  -- implemented names
+  for _, n in ipairs({ "SetBackdropType", "GetWaterAmount", "SetWaterAmount", "GetWaterCurrent", "SetWaterCurrent", "SetRail", "GetRail" }) do
+    check("Room." .. n .. " exists", type(room[n]) == "function")
+  end
+  -- water amount
+  check("water amount starts at 0 in the Basement", near(room:GetWaterAmount(), 0), room:GetWaterAmount())
+  room:SetWaterAmount(0.75)
+  check("SetWaterAmount(0.75) reads back", near(room:GetWaterAmount(), 0.75), room:GetWaterAmount())
+  check("water amount word is the float at room+0x7240", near(rf32(rp + 0x7240), 0.75))
+  room:SetWaterAmount(1)
+  check("SetWaterAmount(1) reads back", near(room:GetWaterAmount(), 1), room:GetWaterAmount())
+  local ok = pcall(room.SetWaterAmount, room, "x")
+  check("SetWaterAmount('x') is an error", not ok)
+  -- water current
+  room:SetWaterCurrent(Vector(-1, 0.5))
+  local c = room:GetWaterCurrent()
+  check("SetWaterCurrent(Vector(-1, 0.5)) reads back", near(c.X, -1) and near(c.Y, 0.5), tostring(c))
+  ok = pcall(room.SetWaterCurrent, room, 5)
+  check("SetWaterCurrent(5) is an error", not ok)
+  -- backdrop
+  local before = room:GetBackdropType()
+  room:SetBackdropType(7, 1)
+  check("SetBackdropType(7, 1) changes GetBackdropType", room:GetBackdropType() == 7, before .. " -> " .. room:GetBackdropType())
+  room:SetBackdropType(before, true)
+  check("SetBackdropType back to the original (boolean flag)", room:GetBackdropType() == before, room:GetBackdropType())
+  ok = pcall(room.SetBackdropType, room, -1, 1)
+  check("SetBackdropType(-1) is an error", not ok)
+  -- rails
+  local w, h = room:GetGridWidth(), room:GetGridHeight()
+  local idx = 4 * w + 6
+  check("GetRail is nil where no rail is", room:GetRail(idx) == nil, tostring(room:GetRail(idx)))
+  room:SetRail(idx, 0)
+  check("SetRail(idx, RAIL_HORIZONTAL) reads back", room:GetRail(idx) == 0, tostring(room:GetRail(idx)))
+  check("the rail byte is at room+0x746c+idx", r8(rp + 0x746c + idx) == 0)
+  room:SetRail(idx + 1, 17)
+  check("SetRail(idx, 17) reads back", room:GetRail(idx + 1) == 17, tostring(room:GetRail(idx + 1)))
+  ok = pcall(room.SetRail, room, idx, 12)
+  check("SetRail with an invalid type is an error", not ok)
+  ok = pcall(room.SetRail, room, w * h, 0)
+  check("SetRail past the grid is an error", not ok)
+  -- undo the rails (the test's own cleanup writes the raw byte; the API cannot set RAIL_NONE)
+  B.w8(rp + 0x746c + idx, 255)
+  B.w8(rp + 0x746c + idx + 1, 255)
+  room:SetWaterAmount(0)
+  room:SetWaterCurrent(Vector(0, 0))
+end
+
+local function desc_checks()
+  local level = Game():GetLevel()
+  local d = level:GetCurrentRoomDesc()
+  for _, n in ipairs({ "GetTaintedKeeperCoinSpawns", "SetTaintedKeeperCoinSpawns", "GetEntitiesSaveState", "GetDecoSaveState", "GetGridEntitiesSaveState" }) do
+    check("RoomDescriptor." .. n .. " exists", type(d[n]) == "function")
+  end
+  local n0 = d:GetTaintedKeeperCoinSpawns()
+  check("coin spawns starts as a small number", n0 >= 0 and n0 <= 10, n0)
+  d:SetTaintedKeeperCoinSpawns(7)
+  check("SetTaintedKeeperCoinSpawns(7) reads back", d:GetTaintedKeeperCoinSpawns() == 7)
+  d:SetTaintedKeeperCoinSpawns(-1)
+  check("SetTaintedKeeperCoinSpawns(-1) reads back -1", d:GetTaintedKeeperCoinSpawns() == -1)
+  d:SetTaintedKeeperCoinSpawns(n0)
+  -- grid vector
+  local g = d:GetGridEntitiesSaveState()
+  check("grid save state has one entry per grid slot", #g == 512 or #g > 100, #g)
+  local e = g:Get(10)
+  local t0 = e.Type
+  e.Type = 1000
+  check("GridEntityDesc.Type round trips through Get(10)", g:Get(10).Type == 1000, tostring(g:Get(10).Type))
+  e.Type = t0
+  -- the fields StageAPI's extra-room code zeroes (extrarooms.lua): Initialized, SpawnCount, State, Variant, VarData
+  local e2 = g:Get(11)
+  local saved = { e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData }
+  e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData = true, 3, 5, 2, 9
+  local r = g:Get(11)
+  check("GridEntityDesc Initialized/SpawnCount/State/Variant/VarData round trip", r.Initialized == true and r.SpawnCount == 3 and r.State == 5 and r.Variant == 2 and r.VarData == 9,
+    tostring(r.Initialized) .. " " .. r.SpawnCount .. " " .. r.State .. " " .. r.Variant .. " " .. r.VarData)
+  e2.Initialized, e2.SpawnCount, e2.State, e2.Variant, e2.VarData = saved[1], saved[2], saved[3], saved[4], saved[5]
+  local found = g:GetByType(t0)
+  check("GetByType finds the entry again", #found >= 1)
+  local okErr = pcall(g.Get, g, #g)
+  check("Get(#g) is an error", not okErr)
+  -- entity vectors
+  local ev = d:GetEntitiesSaveState()
+  local dv = d:GetDecoSaveState()
+  check("entity vectors are readable", #ev >= 0 and #dv >= 0, #ev .. " / " .. #dv)
+  say("entities saved in the start room now: " .. #ev .. ", deco: " .. #dv)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function()
+  local level = Game():GetLevel()
+  if step == 2 then
+    step, wait = 3, 0
+  elseif step == 4 then
+    step, wait = 5, 0
+  end
+end)
+
+local pickups = {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  wait = wait + 1
+  local game, level, room = Game(), Game():GetLevel(), Game():GetRoom()
+  if step == 0 and wait == 20 then
+    startIdx = level:GetCurrentRoomIndex()
+    room_checks()
+    desc_checks()
+    -- put two coins and a key on the floor so the descriptor has something to save
+    local c = room:GetCenterPos()
+    pickups = {
+      Isaac.Spawn(5, 20, 1, c + Vector(-60, 0), Vector(0, 0), nil),
+      Isaac.Spawn(5, 20, 2, c + Vector(60, 0), Vector(0, 0), nil),
+      Isaac.Spawn(5, 30, 1, c + Vector(0, 60), Vector(0, 0), nil),
+    }
+    say(string.format("spawned pickups: seeds %d %d %d", pickups[1].InitSeed, pickups[2].InitSeed, pickups[3].InitSeed))
+    step, wait = 1, 0
+  elseif step == 1 and wait == 10 then
+    -- leave to another room so the game saves the start room's entities into its descriptor
+    local target
+    for i = 0, level:GetRoomCount() - 1 do
+      local d = level:GetRooms():Get(i)
+      if d.GridIndex ~= startIdx and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then target = d.GridIndex break end
+    end
+    say("going to room " .. tostring(target) .. " from " .. startIdx)
+    step, wait = 2, 0
+    game:ChangeRoom(target)
+  elseif step == 3 and wait == 15 then
+    local d = level:GetRoomByIdx(startIdx)
+    local ev = d:GetEntitiesSaveState()
+    say("start room's saved entities: " .. #ev)
+    local seen = { coin1 = false, coin2 = false, key = false }
+    for i = 0, #ev - 1 do
+      local s = ev:Get(i)
+      say(string.format("  [%d] type %d variant %d subtype %d initseed %d dropseed %d spawner %d.%d", i, s:GetType(), s:GetVariant(), s:GetSubType(), s:GetInitSeed(), s:GetDropSeed(), s:GetSpawnerType(), s:GetSpawnerVariant()))
+      if s:GetType() == 5 and s:GetVariant() == 20 and s:GetSubType() == 1 and s:GetInitSeed() == pickups[1].InitSeed then seen.coin1 = true end
+      if s:GetType() == 5 and s:GetVariant() == 20 and s:GetSubType() == 2 and s:GetInitSeed() == pickups[2].InitSeed then seen.coin2 = true end
+      if s:GetType() == 5 and s:GetVariant() == 30 and s:GetSubType() == 1 and s:GetInitSeed() == pickups[3].InitSeed then seen.key = true end
+    end
+    check("saved entity matches the spawned penny (type, variant, subtype, init seed)", seen.coin1)
+    check("saved entity matches the spawned nickel", seen.coin2)
+    check("saved entity matches the spawned key", seen.key)
+    check("GetByType(5, 20, 1) finds the penny", #ev:GetByType(5, 20, 1) >= 1)
+    check("GetByType(5, -1, -1) finds the pickups", #ev:GetByType(5, -1, -1) >= 3)
+    ev:Clear()
+    check("Clear empties the entity vector", #ev == 0, #ev)
+    local dv = d:GetDecoSaveState()
+    dv:Clear()
+    check("Clear empties the deco vector", #dv == 0, #dv)
+    local gv = d:GetGridEntitiesSaveState()
+    gv:Clear()
+    local nonzero = 0
+    for i = 0, #gv - 1 do if gv:Get(i).Type ~= 0 then nonzero = nonzero + 1 end end
+    check("Clear zeroes every grid entry's Type", nonzero == 0, nonzero)
+    step, wait = 4, 0
+    game:ChangeRoom(startIdx)
+  elseif step == 5 and wait == 30 then
+    -- the start room loads with its entity list cleared: none of our three pickups come back
+    local n = 0
+    for _, e in ipairs(Isaac.GetRoomEntities()) do
+      if e.Type == 5 and (e.Variant == 20 or e.Variant == 30) and e.FrameCount > 5 then n = n + 1 end
+    end
+    check("the cleared room comes back without its saved pickups", n == 0, n)
+    -- InitFlipState: a pedestal gets a flip record, and the game's own TryFlip then morphs into it
+    local ped = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, Game():GetRoom():GetCenterPos() + Vector(0, -40), Vector(0, 0), nil):ToPickup()
+    check("EntityPickup.InitFlipState exists", type(ped.InitFlipState) == "function")
+    local pp = B.ptr(ped)
+    check("a fresh pedestal has no flip record", B.r32(pp + 0x5c8) == 0, string.format("%08x", B.r32(pp + 0x5c8)))
+    ped:InitFlipState()
+    local rec = B.r32(pp + 0x5c8)
+    check("InitFlipState puts a record at pickup+0x5c8", rec ~= 0, string.format("%08x", rec))
+    if rec ~= 0 then
+      local other = B.ri32(rec + 8)
+      check("the record holds type 5 variant 100 and another collectible", B.ri32(rec) == 5 and B.ri32(rec + 4) == 100 and other > 0 and other ~= ped.SubType, string.format("subtype %d (pedestal %d)", other, ped.SubType))
+      local before = ped.SubType
+      -- the game's own Entity_Pickup::TryFlip, 0x006e1640 (no argument is read; the zhl declaration's two are unused)
+      local function try_flip() return B.call(0x006e1640, pp, 0, 0) end
+      local ok, flipped = pcall(try_flip)
+      check("TryFlip does not error", ok, tostring(flipped))
+      check("TryFlip morphs the pedestal into the record's collectible", ped.SubType == other, string.format("%d -> %d (record %d)", before, ped.SubType, other))
+      ok, flipped = pcall(try_flip)
+      check("a second TryFlip flips back", ok and ped.SubType == before, string.format("-> %d", ped.SubType))
+    end
+    local ped2 = Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_SAD_ONION, Game():GetRoom():GetCenterPos() + Vector(60, -40), Vector(0, 0), nil):ToPickup()
+    ped2:InitFlipState(CollectibleType.COLLECTIBLE_BREAKFAST)
+    check("InitFlipState(id) uses the given collectible", B.ri32(B.r32(B.ptr(ped2) + 0x5c8) + 8) == CollectibleType.COLLECTIBLE_BREAKFAST)
+    local coin = Isaac.Spawn(5, 20, 1, Game():GetRoom():GetCenterPos() + Vector(0, 80), Vector(0, 0), nil):ToPickup()
+    coin:InitFlipState()
+    check("InitFlipState leaves a coin alone", B.r32(B.ptr(coin) + 0x5c8) == 0)
+    say(string.format("done: %d PASS, %d FAIL", pass, fail))
+    step = 6
+  end
+end)
