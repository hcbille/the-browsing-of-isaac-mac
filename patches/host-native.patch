diff --git a/scripts/recomp/rgon/lab_charsel.lua b/scripts/recomp/rgon/lab_charsel.lua
new file mode 100644
index 0000000..b2f448f
--- /dev/null
+++ b/scripts/recomp/rgon/lab_charsel.lua
@@ -0,0 +1,139 @@
+-- lab_charsel.lua (development only; ISAAC_RGON_LAB=lab_charsel.lua, worker charsel)
+-- The character select's callbacks 1328-1332. Needs the title menu driven to the character select with scripted input.
+-- ISAAC_LAB_CS=rec    every callback answers nil; Enter at the character select starts the run (1328 fired, then the game started)
+-- ISAAC_LAB_CS=cancel 1328 false for Isaac (pt 0: the buzzer, no run), 1329 false for pt 0 (the page is not drawn: screenshot),
+--                     1331 false for pt 1 (Magdalene's portrait is not drawn) and a Vector for pt 2 (Cain moves up 40)
+-- Prints "lab_charsel: DONE n PASS m FAIL" once the menu has run 400 updates after the first page callback.
+local T = ...
+local B = T.B
+local M = ModCallbacks
+local mode = B.env("ISAAC_LAB_CS") or "rec"
+local mod = RegisterMod("rgon lab charsel", 1)
+local pass, fail = 0, 0
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_charsel: %s %s", ok and "PASS" or "FAIL", what))
+end
+local rec = {}
+local function tos(v)
+  if type(v) == "userdata" then
+    local ok, t = pcall(function()
+      if v.GetFilename then return "sprite:" .. tostring(v:GetFilename()) end
+      if v.X ~= nil and v.Y ~= nil then return string.format("vec:%.1f,%.1f", v.X, v.Y) end
+      if v.R ~= nil then return string.format("color:%.2f,%.2f,%.2f,%.2f", v.R, v.G, v.B, v.A) end
+      return "userdata"
+    end)
+    return ok and t or "userdata"
+  end
+  return tostring(v)
+end
+local names = { "MC_CAN_SELECT_CHARACTER", "MC_PRE_RENDER_CHARACTER_SELECT_PAGE", "MC_POST_RENDER_CHARACTER_SELECT_PAGE",
+  "MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT", "MC_POST_RENDER_CHARACTER_SELECT_PORTRAIT" }
+local function behave(n, pt)
+  if mode == "modcancel" then
+    if pt and pt >= 41 and (n == "MC_PRE_RENDER_CHARACTER_SELECT_PAGE" or n == "MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT") then return false end
+    return nil
+  end
+  if mode ~= "cancel" then return nil end
+  if n == "MC_CAN_SELECT_CHARACTER" and pt == 0 then return false end
+  if n == "MC_PRE_RENDER_CHARACTER_SELECT_PAGE" and pt == 0 then return false end
+  if n == "MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT" then
+    if pt == 1 then return false end
+    if pt == 2 then return Vector(0, -40) end
+  end
+  return nil
+end
+for _, n in ipairs(names) do
+  local id = M[n]
+  if not id then check(false, n .. " has a ModCallbacks number") else
+    mod:AddCallback(id, function(_, ...)
+      local a, cnt = {}, select("#", ...)
+      local args = { ... }
+      for i = 1, cnt do a[#a + 1] = tos(args[i]) end
+      local l = rec[n] or { count = 0, by = {} }
+      rec[n] = l
+      l.count = l.count + 1
+      local pt = args[1]
+      l.by[pt] = (l.by[pt] or 0) + 1
+      l.last = { n = cnt, args = args, t = a, a1 = args[1], a2 = args[2], a3 = args[3], a4 = args[4], a5 = args[5] }
+      if l.count <= 3 or (n == "MC_CAN_SELECT_CHARACTER") then B.log(string.format("lab_charsel: %s #%d (%s)", n, l.count, table.concat(a, ", "))) end
+      return behave(n, pt)
+    end)
+  end
+end
+local started = 0
+local finish
+mod:AddCallback(ModCallbacks.MC_POST_GAME_STARTED, function()
+  started = started + 1
+  if mode == "rec" and finish then finish() end
+end)
+
+local orig = T.menu_character_update
+local frames, first, done = 0, nil, false
+T.menu_character_update = function(menu)
+  if orig then orig(menu) end
+  if done then return end
+  frames = frames + 1
+  local p = rec.MC_PRE_RENDER_CHARACTER_SELECT_PAGE
+  if p and not first and MenuManager.GetActiveMenu() == MainMenuType.CHARACTER then first = frames B.log("lab_charsel: first page callback at menu update " .. frames) end
+  local sel = tonumber(B.env("ISAAC_LAB_SEL") or "")
+  if sel and first and frames - first == 100 then
+    if sel < 0 then
+      sel = nil
+      for id = 18, 120 do
+        local pt = CharacterMenu.GetPlayerTypeFromCharacterMenuID(id, false)
+        if pt and pt >= 41 then sel = id break end
+      end
+      if not sel then B.log("lab_charsel: no modded menu id found") sel = 0 end
+    end
+    CharacterMenu.SetSelectedCharacterID(sel)
+    B.log("lab_charsel: selected menu id " .. sel .. " -> player type " .. tostring(CharacterMenu.GetSelectedCharacterPlayerType()))
+  end
+  if first and mode ~= "rec" and frames - first >= (tonumber(B.env("ISAAC_LAB_LEN") or "") or 700) then finish() end
+end
+finish = function()
+  if done then return end
+  do
+    done = true
+    local P, Q = rec.MC_PRE_RENDER_CHARACTER_SELECT_PAGE, rec.MC_POST_RENDER_CHARACTER_SELECT_PAGE
+    local W, X = rec.MC_PRE_RENDER_CHARACTER_SELECT_PORTRAIT, rec.MC_POST_RENDER_CHARACTER_SELECT_PORTRAIT
+    local C = rec.MC_CAN_SELECT_CHARACTER
+    check(P and P.count > 10, "1329 fires every frame")
+    check(P and P.last.n == 5 and (mode:find("^mod") or P.last.a4 == nil and P.last.a5 == false) and type(P.last.a1) == "number" and P.last.t[2]:find("^vec:") and P.last.t[3]:find("^sprite:")
+      , "1329 arguments (pt, Vector, Sprite, custom sprite or nil, bool): " .. (P and P.last.t[1] or "-"))
+    if mode == "cancel" then check(P and P.last.a1 == CharacterMenu.GetSelectedCharacterPlayerType(), "1329 pt is the selected one (read back)") end
+    check(W and W.count > 10 and W.last.n == 5 and W.last.t[2]:find("^sprite:") and W.last.t[3]:find("^vec:")
+      and W.last.t[4]:find("^vec:") and W.last.t[5]:find("^color:"), "1331 arguments (pt, Sprite, Vector, Vector, Color)")
+    local seen = 0
+    if W then for _ in pairs(W.by) do seen = seen + 1 end end
+    check(seen >= 5, "1331 fires for several wheel entries (" .. seen .. ")")
+    local function modded(l) local c = 0 if l then for pt, k in pairs(l.by) do if type(pt) == "number" and pt >= 41 then c = c + k end end end return c end
+    if mode == "modrec" then
+      check(modded(P) > 10 and modded(Q) > 10, "1329 and 1330 fire for a modded character's page (" .. modded(P) .. ", " .. modded(Q) .. ")")
+      check(modded(W) == modded(X), "1331 and 1332 agree for modded wheel portraits (" .. modded(W) .. ", " .. modded(X) .. "; a character without a menu portrait sprite is not on the wheel's modded path)")
+    elseif mode == "modcancel" then
+      check(modded(P) > 10 and modded(Q) == 0, "1329 fired for the modded page and its cancel stopped 1330 (" .. modded(P) .. ", " .. modded(Q) .. ")")
+      check(modded(X) == 0, "no 1332 for a modded wheel portrait (" .. modded(W) .. " 1331 calls; the modded wheel path needs a menu portrait sprite)")
+      check(X and X.count > 10, "1332 still fires for the vanilla portraits")
+    elseif mode == "rec" then
+      check(Q and Q.count > 10, "1330 fires (" .. (Q and Q.count or 0) .. ")")
+      check(X and X.count > 10, "1332 fires (" .. (X and X.count or 0) .. ")")
+      check(C and C.count >= 1 and C.last.a2 == true or false, "1328 fired (pt, true) on Enter")
+      check(started >= 1, "the run started after an allowed 1328")
+    else
+      check((Q and (Q.by[0] or 0) or 0) == 0, "1330 never fires for the cancelled pt 0")
+      check(Q == nil, "1330 does not fire at all (the only page shown is the cancelled one)")
+      check((X and (X.by[1] or 0) or 0) == 0, "1332 never fires for the cancelled portrait (pt 1)")
+      check(X and (X.by[2] or 0) > 10, "1332 fires for pt 2 (moved)")
+      check(C and C.count >= 1 and C.last.a1 == 0 and C.last.a2 == true or false, "1328 fired (0, true)")
+      check(started == 0, "no run started after 1328 answered false")
+    end
+    for _, n in ipairs(names) do
+      local l, t = rec[n], {}
+      if l then for pt, c in pairs(l.by) do t[#t + 1] = tostring(pt) .. "x" .. c end table.sort(t) end
+      B.log("lab_charsel: seen " .. n .. ": " .. table.concat(t, " "))
+    end
+    B.log(string.format("lab_charsel: DONE %d PASS %d FAIL", pass, fail))
+  end
+end
+B.log("lab_charsel: listening, mode " .. mode)
diff --git a/scripts/recomp/rgon/lab_console.lua b/scripts/recomp/rgon/lab_console.lua
new file mode 100644
index 0000000..af281ee
--- /dev/null
+++ b/scripts/recomp/rgon/lab_console.lua
@@ -0,0 +1,80 @@
+-- lab_console.lua (development only; ISAAC_RGON_LAB=lab_console.lua, worker console, wave 7)
+-- MC_CONSOLE_AUTOCOMPLETE (1120) in the game's console. Registers a CUSTOM command "ztest". The script types
+-- grave, "ztest a", Tab, Tab (keys through ISAAC_MAC_SCRIPT); the lab reads the console's line and the box.
+-- Prints "lab_console: DONE n PASS m FAIL".
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab console", 1)
+local pass, fail = 0, 0
+local function say(s) B.log("lab_console: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local function check(ok, what)
+  if ok then pass = pass + 1 else fail = fail + 1 end
+  B.log(string.format("lab_console: %s %s", ok and "PASS" or "FAIL", what))
+end
+
+check(ModCallbacks.MC_CONSOLE_AUTOCOMPLETE == 1120, "MC_CONSOLE_AUTOCOMPLETE is 1120")
+check(T.R.Implemented[1120] == true, "1120 is registered")
+Console.RegisterCommand("ztest", "a lab command", "help", true, AutocompleteType.CUSTOM)
+Console.RegisterCommand("zplain", "no custom list", "help", true, AutocompleteType.NONE)
+
+local fired = {}
+mod:AddCallback(ModCallbacks.MC_CONSOLE_AUTOCOMPLETE, function(_, cmd, params)
+  fired[#fired + 1] = { cmd, params }
+  return { "alpha", { "beta", "second one" }, "apple pie with cream", { "gamma", "has a in it" }, "zeta" }
+end, "ztest")
+mod:AddCallback(ModCallbacks.MC_CONSOLE_AUTOCOMPLETE, function(_, cmd, params)
+  return { "other" }          -- never reached: another command's filter
+end, "somethingelse")
+
+-- Fiend Folio's shape (commands_stuff.lua, "blasphemous"): { numberId, name } pairs, and bare numbers (REPENTOGON reads them with lua_tostring)
+Console.RegisterCommand("zff", "ff shape", "help", true, AutocompleteType.CUSTOM)
+mod:AddCallback(ModCallbacks.MC_CONSOLE_AUTOCOMPLETE, function()
+  local t = {}
+  for id = 1, 12 do t[#t + 1] = { id, "Trinket " .. id } end
+  t[#t + 1] = 77
+  return t
+end, "zff")
+local S = T.console_suggestions
+local function texts(l) local o = {} for _, e in ipairs(S(l)) do o[#o + 1] = e.text end return table.concat(o, "|") end
+local ff = S("zff 1")
+check(#ff == 4 and ff[1].text == "zff 1" and ff[1].desc == "Trinket 1" and ff[2].text == "zff 10", "numbers as text, a name as description (Fiend Folio's shape): " .. #ff .. " shown")
+local t0 = texts("z")
+check(t0 == "zff|zplain|ztest", "typing a command name lists the registered commands: " .. t0)
+local t1 = texts("ztest ")
+check(t1 == "ztest alpha|ztest beta|ztest apple pie with cream|ztest gamma|ztest zeta", "all five after 'ztest ': " .. t1)
+check(fired[1] and fired[1][1] == "ztest" and fired[1][2] == "", "callback got (ztest, '')")
+local t2 = texts("ztest a")
+check(t2 == "ztest alpha|ztest apple pie with cream|ztest gamma", "'ztest a': prefix or description match: " .. t2)
+check(fired[2] and fired[2][2] == "a", "callback got params 'a'")
+check(texts("zplain x") == "", "a non-CUSTOM command fires nothing")
+check(texts("nothing x") == "", "an unknown command fires nothing")
+local n = #fired
+S("zplain x") S("nothing x")
+check(#fired == n, "no callback for those")
+
+local frame, last, tabs = 0, nil, 0
+local seen = {}
+local c_state = 0
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  frame = frame + 1
+  local g = B.r32(0x00c71678)
+  if g == 0 then return end
+  local st = B.r32(g + 0x68d78)
+  if st ~= c_state then c_state = st say("console state " .. st) end
+  if st == 2 then
+    local ok, l = pcall(B.stdstr, g + 0x68d94)
+    if ok and l ~= last then last = l seen[l] = true say("line '" .. l .. "'") end
+  end
+  if frame == 650 then
+    check(T.console_commands["epiphany"] ~= nil, "Epiphany registered its command with Console.RegisterCommand")
+    local e = S("epiphany ")
+    check(#e >= 3 and e[1].text:find("^epiphany ") ~= nil, "Epiphany's own MC_CONSOLE_AUTOCOMPLETE: " .. #e .. " shown, first '" .. tostring(e[1] and e[1].text) .. "'")
+  end
+  if frame == 700 then
+    check(last ~= nil and last:find("^ztest ") ~= nil, "the typed line was read from the console: " .. tostring(last))
+    check(seen["ztest alpha"], "Tab put the first suggestion in the console's line")
+    check(seen["ztest apple pie with cream"], "Tab again went to the next suggestion (longer than the line's capacity: the char callback grew it)")
+    check(#fired >= 4, "the callback fired for the typed lines (two here, two live): " .. #fired .. " times")
+    B.log(string.format("lab_console: DONE %d PASS %d FAIL", pass, fail))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_eid_probe.lua b/scripts/recomp/rgon/lab_eid_probe.lua
new file mode 100644
index 0000000..564b903
--- /dev/null
+++ b/scripts/recomp/rgon/lab_eid_probe.lua
@@ -0,0 +1,207 @@
+-- lab_eid_probe.lua (development only; ISAAC_RGON_LAB=lab_eid_probe.lua, External Item Descriptions batch): finds in this
+-- build the structures EID needs, by diffs and scans, and logs "lab_eid_probe: ..." lines. Reads only, apart from the game's own
+-- Lua calls that give items and spawn pickups. Steps run one after another, a few frames apart. ISAAC_LAB_PHASES (a
+-- substring list of "form", "bag", "tm", "room"; default all) picks the phases.
+--   form: guppy items one by one: the words of the player that change (player form counters)
+--   bag:  Bag of Crafting and pickups spawned on the player: the words that change (content and output)
+--   tm:   TM Trainer: the glitched items, and the ProceduralItemManager vector in the game object
+--   room: a room's saved entities after leaving it (RoomDescriptor +0x74)
+local T = ...
+local B = T.B
+local r32, ri32, rf32, r8 = B.r32, B.ri32, B.rf32, B.r8
+local mod = RegisterMod("rgon lab eid probe", 1)
+local function say(s) B.log("lab_eid_probe: " .. s) end
+local function snap(a, lo, hi)
+  local t = {}
+  for o = lo, hi - 4, 4 do t[o] = r32(a + o) end
+  return t
+end
+local SKIP = { [0x1b38] = true, [0x1dec] = true, [0x1df0] = true, [0x1df4] = true, [0x1ea0] = true, [0x1f98] = true }
+local function diff(name, a, before, lo, hi, limit)
+  local n = 0
+  for o = lo, hi - 4, 4 do
+    local now = r32(a + o)
+    if now ~= before[o] and not SKIP[o] then
+      n = n + 1
+      if n <= (limit or 40) then say(string.format("%s +%04x %08x -> %08x (%d -> %d)", name, o, before[o], now, before[o] >= 0x80000000 and before[o] - 2^32 or before[o], now >= 0x80000000 and now - 2^32 or now)) end
+    end
+  end
+  say(string.format("%s: %d word(s) changed", name, n))
+end
+local LO, HI = 0x1000, 0x2200
+local steps, cur, wait = {}, 1, 0
+local PH = B.env("ISAAC_LAB_PHASES") or "all"
+local function want(ph) return PH == "all" or PH:find(ph, 1, true) ~= nil end
+local function step(delay, f) steps[#steps + 1] = { delay, f } end
+local before, A
+local function player() return Isaac.GetPlayer(0) end
+local G
+local function pvec(tag)
+  G = r32(0x00c71678)
+  say(string.format("%s: procedural vector begin %08x end %08x cap %08x (%d)", tag, r32(G + 0x67758), r32(G + 0x6775c), r32(G + 0x67760), (r32(G + 0x6775c) - r32(G + 0x67758)) // 4))
+end
+
+-- 1. form counters
+if want("form") then
+  local CT = CollectibleType
+  for _, id in ipairs({ CT.COLLECTIBLE_DEAD_CAT, CT.COLLECTIBLE_GUPPYS_PAW, CT.COLLECTIBLE_GUPPYS_TAIL, CT.COLLECTIBLE_GUPPYS_HEAD, CT.COLLECTIBLE_GUPPYS_HAIRBALL, CT.COLLECTIBLE_GUPPYS_COLLAR }) do
+    step(10, function()
+      local p = player()
+      A = B.ptr(p)
+      before = snap(A, LO, HI)
+      p:AddCollectible(id, 0, false)
+      say(string.format("gave collectible %d (player %08x, game %08x, manager %08x)", id, A, r32(0x00c71678), r32(0x00c7169c)))
+    end)
+    step(8, function()
+      diff("guppy item " .. id, A, before, LO, HI)
+      local p = player()
+      say(string.format("HasCollectible %s, GetCollectibleNum %d, HasPlayerForm GUPPY %s", tostring(p:HasCollectible(id)), p:GetCollectibleNum(id), tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY))))
+      local w = {}
+      for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+      say("forms at +17dc: " .. table.concat(w, ","))
+    end)
+  end
+end
+
+if want("form") then
+  step(5, function()
+    local p = player()
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    local w = {}
+    for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+    say("after EvaluateItems, forms at +17dc: " .. table.concat(w, ",") .. " HasPlayerForm GUPPY " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)))
+    Isaac.ExecuteCommand("giveitem c81")
+    Isaac.ExecuteCommand("giveitem c133")
+    Isaac.ExecuteCommand("giveitem c134")
+  end)
+  step(20, function()
+    local p = player()
+    local w = {}
+    for k = 0, 15 do w[#w + 1] = ri32(A + 0x17dc + 4 * k) end
+    say("after console giveitem x3 (81,133,134), forms: " .. table.concat(w, ",") .. " HasPlayerForm GUPPY " .. tostring(p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY)) .. " num81 " .. p:GetCollectibleNum(81))
+  end)
+end
+
+-- 2. bag of crafting
+if want("bag") then
+  step(10, function()
+    local p = player()
+    A = B.ptr(p)
+    before = snap(A, LO, HI)
+    p:AddCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+    say("gave Bag of Crafting")
+  end)
+  step(10, function() diff("bag of crafting given", A, before, LO, HI) end)
+  local boc_pickups = { { 10, 1 }, { 20, 1 }, { 30, 1 }, { 40, 1 }, { 20, 2 }, { 10, 3 }, { 20, 3 }, { 30, 2 } }
+  for i, pk in ipairs(boc_pickups) do
+    step(14, function()
+      local p = player()
+      before = snap(A, LO, HI)
+      local e = Isaac.Spawn(5, pk[1], pk[2], p.Position + Vector(200, 0), Vector(0, 0), nil)
+      local r = B.call(0x007d5170, A, B.ptr(e))
+      say(string.format("spawned pickup 5.%d.%d and called TryAddToBagOfCrafting(0x7d5170): %d", pk[1], pk[2], r & 0xff))
+    end)
+    step(12, function()
+      diff("bag after pickup " .. i, A, before, LO, HI, 12)
+      local w = {}
+      for k = 0, 7 do w[#w + 1] = r8(A + 0x1f44 + k) end
+      say(string.format("content %s output %d pool %d", table.concat(w, ","), ri32(A + 0x1f4c), ri32(A + 0x1f50)))
+    end)
+  end
+end
+
+-- 3. TM Trainer
+if want("tm") then
+  step(10, function()
+    pvec("before")
+    Isaac.ExecuteCommand("giveitem c721")
+    say("console giveitem c721; HasCollectible TMTRAINER " .. tostring(player():HasCollectible(CollectibleType.COLLECTIBLE_TMTRAINER)))
+  end)
+  step(40, function() pvec("after giveitem") end)
+  step(5, function()
+    local p = player()
+    Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_TMTRAINER, p.Position, Vector(0, 0), nil)
+    say("spawned a TM Trainer pedestal on the player")
+  end)
+  step(90, function() pvec("after pedestal") end)
+  step(5, function()
+    local ic = Isaac.GetItemConfig()
+    for id = -1, -4, -1 do
+      local it = ic:GetCollectible(id)
+      say(string.format("itemconfig %d -> %s", id, it and string.format("%08x ID=%d name=%s", B.ptr(it), it.ID, tostring(it.Name)) or "nil"))
+    end
+    local item = ic:GetCollectible(-1)
+    if not item then say("no glitched item -1") return end
+    local ITEM = B.ptr(item)
+    G = r32(0x00c71678)
+    local b = r32(G + 0x67758)
+    local q = r32(b)
+    say(string.format("first record %08x holds item %08x (itemconfig -1 is %08x)", q, r32(q), ITEM))
+    for k = 0, 0x38 - 4, 4 do say(string.format("    record+%02x %08x  %g", k, r32(q + k), B.i2f(r32(q + k)))) end
+    local target = r32(q + 0x10)
+    if target ~= 0 then say(string.format("target %08x: +0 %d +4 %d", target, ri32(target), ri32(target + 4))) end
+    local ev, ee = r32(q + 0x2c), r32(q + 0x30)
+    say(string.format("effects begin %08x end %08x (%d)", ev, ee, (ee - ev) // 4))
+    for i = 0, (ee - ev) // 4 - 1 do
+      local e = r32(ev + 4 * i)
+      local line = {}
+      for k = 0, 0x68 - 4, 4 do line[#line + 1] = string.format("%02x:%08x", k, r32(e + k)) end
+      say(string.format("  effect %d at %08x: %s", i, e, table.concat(line, " ")))
+    end
+  end)
+end
+
+-- 4. a room's saved entities
+if want("room") then
+  local desc_idx
+  step(10, function()
+    local level, room = Game():GetLevel(), Game():GetRoom()
+    local p = player()
+    desc_idx = level:GetCurrentRoomIndex()
+    for i = 1, 3 do
+      Isaac.Spawn(5, 10, 1, room:FindFreePickupSpawnPosition(p.Position + Vector(60 * i, 0), 0, true), Vector(0, 0), nil)
+    end
+    Isaac.Spawn(5, 20, 1, room:FindFreePickupSpawnPosition(p.Position + Vector(0, 60), 0, true), Vector(0, 0), nil)
+    say("spawned 3 hearts and a coin in room " .. desc_idx)
+  end)
+  step(10, function()
+    local level = Game():GetLevel()
+    local target
+    for i = 0, 168 do
+      local d = level:GetRoomByIdx(i)
+      if d and d.GridIndex >= 0 and d.GridIndex ~= desc_idx and d.Data ~= nil and d.ListIndex >= 0 then
+        if (math.abs(d.GridIndex - desc_idx) == 1 or math.abs(d.GridIndex - desc_idx) == 13) then target = d.GridIndex break end
+      end
+    end
+    say("changing to room " .. tostring(target))
+    if target then Game():ChangeRoom(target) end
+  end)
+  step(30, function()
+    local level = Game():GetLevel()
+    local d = level:GetRoomByIdx(desc_idx)
+    local a = B.ptr(d)
+    local b, e = r32(a + 0x74), r32(a + 0x78)
+    local n = (e - b)
+    say(string.format("old room desc %08x: SavedEntities %d bytes = %g elements of 0x78", a, n, n / 0x78))
+    for i = 0, n // 0x78 - 1 do
+      local s = b + i * 0x78
+      if ri32(s) == 5 then
+        say(string.format("  #%d type %d variant %d sub %d i1 %08x i2 %08x i3 %08x", i, ri32(s), ri32(s + 4), ri32(s + 8), r32(s + 0xc), r32(s + 0x10), r32(s + 0x14)))
+      end
+    end
+  end)
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  local s = steps[cur]
+  if not s then return end
+  wait = wait + 1
+  if wait >= s[1] then
+    wait = 0
+    cur = cur + 1
+    local ok, err = pcall(s[2])
+    if not ok then say("step " .. (cur - 1) .. " failed: " .. tostring(err)) end
+    if cur > #steps then say("done") end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_eid_shot.lua b/scripts/recomp/rgon/lab_eid_shot.lua
