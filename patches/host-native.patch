@@ -0,0 +1,66 @@
+-- api_misc_b.lua -- wave 6, worker misc-b: RoomDescriptor:GetGroup / SetGroup and GridEntity:HurtDamage. Written against
+-- REPENTOGON's behaviour (LuaRoomDescriptor.cpp, LuaGridEntity.cpp); every address and offset was measured in THIS
+-- executable (v1.9.7.17) by lab_misc_b_probe.lua and checked by lab_misc_b.lua.
+--
+--   RoomDescriptor Group   an int at descriptor +0xb4 (descriptors are 0xb8 apart). -1 (RoomGroup.GROUP_NONE) in every room
+--       of five floors, 99 in the one Ultra Secret Room (type 29) of each (probe over `stage 3`..`stage 7`). The descriptor +0xac
+--       dword is -1 too but never changes, so it is not the group.
+--   GridEntity:HurtDamage(entity, playerDamage, damageFlags, damage, ignoreGridCollisionClass)   the game's own
+--       GridEntity::hurt_func, 0x00709fb0 (thiscall, ecx = the grid entity, xmm2 = damage; stack: source Entity*, player
+--       damage, flags lo, flags hi, ignore byte; `ret 0x14`, void). It hurts the ENTITY given as the first argument with this
+--       grid entity's damage (what spikes do to a player or an enemy), not the grid entity: lab_misc_b.lua hurts a frozen Gaper
+--       with a spikes entity (damage 5: 10 -> 5 hit points). An earlier probe called it dead because it watched a poop and a
+--       rock, which this function does not touch. The source entity's +0x28 type is read, so it must be a real entity.
+local T = ...
+local B, R, method, this = T.B, T.R, T.method, T.this
+local r32, w32, call, ptr = B.r32, B.w32, B.call, B.ptr
+local type, error, tostring = type, error, tostring
+local mathtype = math.type
+
+local function int_arg(v, n, fname)
+  if mathtype(v) == "integer" then return v end
+  if type(v) == "number" and v == v // 1 then return math.tointeger(v) end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (integer expected, got " .. type(v) .. ")", 3)
+end
+local function num_arg(v, n, fname)
+  if type(v) == "number" then return v end
+  error("bad argument #" .. n .. " to '" .. fname .. "' (number expected, got " .. type(v) .. ")", 3)
+end
+local function signed(v) return v >= 0x80000000 and v - 0x100000000 or v end
+
+------------------------------------------------------------------------------
+-- RoomDescriptor:GetGroup() / SetGroup(group)
+------------------------------------------------------------------------------
+local D_GROUP = 0xb4
+local DM = T.descriptor_methods
+if DM then
+  DM.GetGroup = B.cfn(function(self) return signed(r32(ptr(self) + D_GROUP)) end)
+  DM.SetGroup = B.cfn(function(self, group)
+    group = int_arg(group, 2, "SetGroup")
+    w32(ptr(self) + D_GROUP, group & 0xffffffff)
+  end)
+  -- api_batch_three.lua installs these on the real descriptor's metatable at the first room; the census reads
+  -- REPENTOGON.Implemented at load, so the flags are set here (as api_rooms_more.lua does)
+  R.Implemented["RoomDescriptor.GetGroup"] = true
+  R.Implemented["RoomDescriptor.SetGroup"] = true
+end
+
+------------------------------------------------------------------------------
+-- GridEntity:HurtDamage(entity, playerDamage, damageFlags, damage, ignoreGridCollisionClass)
+------------------------------------------------------------------------------
+method("GridEntity", "HurtDamage", function(self, entity, player_damage, flags, damage, ignore)
+  local p = this(self, "HurtDamage")
+  if type(entity) ~= "userdata" then
+    error("bad argument #2 to 'HurtDamage' (Entity expected, got " .. type(entity) .. ")", 2)
+  end
+  local src = ptr(entity)
+  if src == nil or src == 0 then error("bad argument #2 to 'HurtDamage' (Entity expected)", 2) end
+  player_damage = int_arg(player_damage, 3, "HurtDamage")
+  flags = int_arg(flags, 4, "HurtDamage")
+  damage = num_arg(damage, 5, "HurtDamage")
+  if type(ignore) ~= "boolean" then
+    error("bad argument #6 to 'HurtDamage' (boolean expected, got " .. type(ignore) .. ")", 2)
+  end
+  call(0x00709fb0, { ecx = p, xmm2 = damage }, src, player_damage & 0xffffffff, flags & 0xffffffff,
+    (flags >> 32) & 0xffffffff, ignore and 1 or 0)
+end)
