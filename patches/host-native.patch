+    check("ChainLightning returns the effect", fx ~= nil and fx.Type == 1000 and fx.Variant == 167, fx and (fx.Type .. "." .. fx.Variant))
+    check("ChainLightning no spawner", g:ChainLightning(g:GetRoom():GetCenterPos()) ~= nil)
