index 0000000..c2c9a25
--- /dev/null
+++ b/scripts/recomp/rgon/lab_eid_test.lua
@@ -0,0 +1,255 @@
+-- lab_eid_test.lua (development only; ISAAC_RGON_LAB=lab_eid_test.lua, External Item Descriptions batch): runs the names of
+-- api_eid.lua in the first room, a step every few frames, and logs "lab_eid_test: PASS/FAIL ..". The game's own functions are
+-- the other side of each check: the game's HasPlayerForm against the form counters, TryAddToBagOfCrafting (0x007d5170)
+-- and CalculateBagOfCraftingOutput (0x007d9d00) against the Bag of Crafting names, AddToCollection (0x0092a2d0) against
+-- IsItemInCollection, the spawned entities against the saved states, the player's stats against a glitched item's.
+local T = ...
+local B = T.B
+local r8, r32, ri32, rf32, call = B.r8, B.r32, B.ri32, B.rf32, B.call
+local mod = RegisterMod("rgon lab eid test", 1)
+local function check(name, ok, detail)
+  B.log("lab_eid_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local function say(s) B.log("lab_eid_test: " .. s) end
+local steps, cur, wait = {}, 1, 0
+local function step(delay, f) steps[#steps + 1] = { delay, f } end
+local function player() return Isaac.GetPlayer(0) end
+local function join(t) local o = {} for i = 1, #t do o[i] = tostring(t[i]) end return table.concat(o, ",") end
+
+step(5, function()
+  for _, n in ipairs({ "EntityPlayer.GetPlayerFormCounter", "EntityPlayer.GetBagOfCraftingContent", "EntityPlayer.GetBagOfCraftingOutput",
+    "EntityPlayer.GetBagOfCraftingSlot", "EntityPlayer.GetBagOfCraftingOutputItemPool", "PersistentGameData.IsItemInCollection",
+    "RoomDescriptor.GetEntitiesSaveState", "EntitySaveState.GetI3", "EntitySaveState.GetType", "EntitiesSaveStateVector.Get",
+    "ProceduralItem.GetEffect", "ProceduralItem.GetEffectCount", "ProceduralItem.GetTargetItem", "ProceduralEffect.GetActionProperty",
+    "ProceduralEffect.GetConditionProperty", "ProceduralEffect.GetActionType", "ProceduralEffect.GetConditionType",
+    "ProceduralItemManager.GetProceduralItem" }) do
+    check("Implemented " .. n, REPENTOGON.Implemented[n] == true)
+  end
+  check("ProceduralItemManager is a table", type(ProceduralItemManager) == "table")
+  check("no procedural item yet", ProceduralItemManager.GetProceduralItemCount() == 0, ProceduralItemManager.GetProceduralItemCount())
+  check("GetProceduralItem(0) is nil", ProceduralItemManager.GetProceduralItem(0) == nil)
+end)
+
+-- the collection: the game's own AddToCollection, then the name
+step(5, function()
+  local pgd = Isaac.GetPersistentGameData()
+  local base = r32(0x00c7169c) + 0x14
+  local id = 719
+  local was = pgd:IsItemInCollection(id)
+  say("collection: item " .. id .. " in collection at start: " .. tostring(was))
+  call(0x0092a2d0, base, id)
+  check("IsItemInCollection true after the game's AddToCollection", pgd:IsItemInCollection(id) == true)
+  check("a neighbour stays as it was", pgd:IsItemInCollection(id + 1) == pgd:IsItemInCollection(id + 1))
+  local n = 0
+  for i = 1, 732 do if pgd:IsItemInCollection(i) then n = n + 1 end end
+  say("collection: " .. n .. " of 732 items in the collection")
+  check("out of range errors like REPENTOGON's", not pcall(pgd.IsItemInCollection, pgd, 9999))
+  check("0 is not an item", pgd:IsItemInCollection(0) == false)
+end)
+
+-- form counters
+step(5, function()
+  local p = player()
+  local pr = B.ptr(p)
+  local zero = true
+  for f = 0, 14 do if p:GetPlayerFormCounter(f) ~= 0 then zero = false end end
+  check("fresh player: every counter 0", zero)
+  check("HasPlayerForm GUPPY false at 0", p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY) == false)
+  call(0x0075e320, pr, 0, 1)
+  call(0x0075e320, pr, 0, 1)
+  check("counter 0 is 2 after two game increments", p:GetPlayerFormCounter(0) == 2, p:GetPlayerFormCounter(0))
+  check("HasPlayerForm GUPPY still false at 2", p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY) == false)
+  call(0x0075e320, pr, 0, 1)
+  check("counter 0 is 3", p:GetPlayerFormCounter(0) == 3, p:GetPlayerFormCounter(0))
+  check("HasPlayerForm GUPPY true at 3 (the game's own test, 0x007aa7c0)", p:HasPlayerForm(PlayerForm.PLAYERFORM_GUPPY) == true)
+  call(0x0075e320, pr, 5, 4)
+  check("counter 5 is 4", p:GetPlayerFormCounter(5) == 4, p:GetPlayerFormCounter(5))
+  check("HasPlayerForm 5 true", p:HasPlayerForm(5) == true)
+  check("counter 1 untouched", p:GetPlayerFormCounter(1) == 0)
+  check("form 15 errors", not pcall(p.GetPlayerFormCounter, p, 15))
+  check("form -1 errors", not pcall(p.GetPlayerFormCounter, p, -1))
+  check("string form errors", not pcall(p.GetPlayerFormCounter, p, "x"))
+  call(0x0075e320, pr, 0, -3)
+  call(0x0075e320, pr, 5, -4)
+  check("counters back to 0", p:GetPlayerFormCounter(0) == 0 and p:GetPlayerFormCounter(5) == 0)
+end)
+
+-- Bag of Crafting
+step(5, function()
+  local p = player()
+  check("empty bag: content is 8 zeros", join(p:GetBagOfCraftingContent()) == "0,0,0,0,0,0,0,0", join(p:GetBagOfCraftingContent()))
+  check("empty bag: output 0", p:GetBagOfCraftingOutput() == 0, p:GetBagOfCraftingOutput())
+  p:AddCollectible(CollectibleType.COLLECTIBLE_BAG_OF_CRAFTING, 0, false)
+end)
+local boc = { { 10, 1, 1 }, { 20, 1, 8 }, { 30, 1, 12 }, { 40, 1, 15 }, { 20, 2, 9 }, { 10, 3, 2 }, { 20, 3, 10 }, { 30, 2, 13 } }
+local expect = {}
+for i, e in ipairs(boc) do
+  step(6, function()
+    local p = player()
+    local pk = Isaac.Spawn(5, e[1], e[2], p.Position + Vector(200, 0), Vector(0, 0), nil)
+    call(0x007d5170, B.ptr(p), B.ptr(pk))
+    expect[#expect + 1] = e[3]
+    local got = p:GetBagOfCraftingContent()
+    local want = {}
+    for k = 1, 8 do want[k] = expect[k] or 0 end
+    check("bag content after pickup " .. i .. " (5." .. e[1] .. "." .. e[2] .. ")", join(got) == join(want), join(got))
+    check("slot " .. (i - 1) .. " is " .. e[3], p:GetBagOfCraftingSlot(i - 1) == e[3])
+    if i < 8 then check("output stays 0 below 8 pickups", p:GetBagOfCraftingOutput() == 0 and p:GetBagOfCraftingOutputItemPool() == -1, p:GetBagOfCraftingOutput() .. "/" .. p:GetBagOfCraftingOutputItemPool()) end
+  end)
+end
+step(6, function()
+  local p = player()
+  local out, pool = p:GetBagOfCraftingOutput(), p:GetBagOfCraftingOutputItemPool()
+  say("bag full: output " .. out .. " pool " .. pool)
+  check("full bag: output is an item", out > 0 and out < 733, out)
+  local pr = B.ptr(p)
+  local buf = B.alloc(16)
+  local content = B.alloc(8)
+  for k = 0, 7 do B.w8(content + k, expect[k + 1]) end
+  call(0x007d9d00, nil, buf, content, 0)
+  check("the game's CalculateBagOfCraftingOutput gives the same item", ri32(buf) == out and ri32(buf + 4) == pool, ri32(buf) .. "/" .. ri32(buf + 4))
+  B.free(buf) B.free(content)
+  check("GetBagOfCraftingSlot errors out of range", not pcall(p.GetBagOfCraftingSlot, p, 8))
+end)
+
+-- saved entities
+local desc_idx, shop_pos
+step(10, function()
+  local level, room = Game():GetLevel(), Game():GetRoom()
+  local p = player()
+  desc_idx = level:GetCurrentRoomIndex()
+  local a = Isaac.Spawn(5, 10, 1, Vector(320, 380), Vector(0, 0), nil)
+  local b = Isaac.Spawn(5, 20, 2, Vector(360, 400), Vector(0, 0), nil)
+  local s = Isaac.Spawn(5, 30, 1, Vector(440, 400), Vector(0, 0), nil):ToPickup()
+  s.ShopItemId = 3
+  s.Price = 5
+  say(string.format("spawned heart %d/%d, nickel, shop key (ShopItemId %d price %d); heart seeds init %d drop %d", a.Variant, a.SubType, s.ShopItemId, s.Price, a.InitSeed, a.DropSeed))
+  shop_pos = { heart = { a.InitSeed, a.DropSeed }, nickel = { b.InitSeed, b.DropSeed } }
+end)
+step(10, function()
+  local level = Game():GetLevel()
+  local target
+  for i = 0, 168 do
+    local d = level:GetRoomByIdx(i)
+    if d and d.GridIndex >= 0 and d.GridIndex ~= desc_idx and d.Data ~= nil and d.ListIndex >= 0 then
+      if (math.abs(d.GridIndex - desc_idx) == 1 or math.abs(d.GridIndex - desc_idx) == 13) then target = d.GridIndex break end
+    end
+  end
+  say("changing to room " .. tostring(target))
+  if target then Game():ChangeRoom(target) end
+end)
+step(40, function()
+  local level = Game():GetLevel()
+  local d = level:GetRoomByIdx(desc_idx)
+  check("the descriptor has GetEntitiesSaveState", type(d.GetEntitiesSaveState) == "function")
+  local v = d:GetEntitiesSaveState()
+  local n = #v
+  check("saved entities counted", n >= 3, n)
+  local seen = {}
+  for i = 0, n - 1 do
+    local s = v:Get(i)
+    if s:GetType() == 5 then
+      local key = s:GetVariant() .. "." .. s:GetSubType()
+      seen[key] = s
+      say(string.format("pickup %s i1 %d i2 %d i3 %d i4 %d i5 %d pos %s init %d drop %d", key, s:GetI1(), s:GetI2(), s:GetI3(), s:GetI4(), s:GetI5(), tostring(s:GetPos()), s:GetInitSeed(), s:GetDropSeed()))
+    end
+  end
+  check("the heart is saved (5.10.1)", seen["10.1"] ~= nil)
+  check("the nickel is saved (5.20.2)", seen["20.2"] ~= nil)
+  check("the key is saved (5.30.1)", seen["30.1"] ~= nil)
+  if seen["10.1"] then
+    check("heart position", seen["10.1"]:GetPos().X == 320 and seen["10.1"]:GetPos().Y == 380, tostring(seen["10.1"]:GetPos()))
+    check("heart seeds are the entity's", seen["10.1"]:GetInitSeed() == shop_pos.heart[1] and seen["10.1"]:GetDropSeed() == shop_pos.heart[2], seen["10.1"]:GetInitSeed())
+    check("a plain pickup: GetI3 is 0 (EID's not-a-shop-item test)", seen["10.1"]:GetI3() == 0, seen["10.1"]:GetI3())
+  end
+  if seen["20.2"] then check("nickel seeds are the entity's", seen["20.2"]:GetInitSeed() == shop_pos.nickel[1], seen["20.2"]:GetInitSeed()) end
+  if seen["30.1"] then say("shop key: GetI3 = " .. seen["30.1"]:GetI3() .. " (non-zero when it is for sale)") end
+  check("GetByType finds the pickups", #v:GetByType(5, -1, -1) >= 3, #v:GetByType(5, -1, -1))
+  check("GetByType with variant", #v:GetByType(5, 10, 1) == 1, #v:GetByType(5, 10, 1))
+  check("Get out of range errors", not pcall(v.Get, v, n))
+  check("GetLastRoomDesc is that descriptor", GetPtrHash(level:GetLastRoomDesc()) == GetPtrHash(d))
+  local last = level:GetLastRoomDesc():GetEntitiesSaveState()
+  check("the last room's list has the same length", #last == n)
+end)
+
+-- procedural items
+step(10, function()
+  Isaac.ExecuteCommand("giveitem c721")
+end)
+step(30, function()
+  local p = player()
+  Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_TMTRAINER, p.Position, Vector(0, 0), nil)
+  say("gave TM Trainer by console, spawned a TM Trainer pedestal on the player")
+end)
+step(90, function()
+  local n = ProceduralItemManager.GetProceduralItemCount()
+  check("TM Trainer made a procedural item", n >= 1, n)
+  if n < 1 then return end
+  local pi = ProceduralItemManager.GetProceduralItem(0)
+  check("GetProceduralItem(0) is a ProceduralItem", pi ~= nil)
+  check("GetProceduralItem(n) is nil", ProceduralItemManager.GetProceduralItem(n) == nil)
+  local it = pi:GetItem()
+  check("GetItem is the item config of glitched id -1", it ~= nil and it.ID == -1, it and it.ID)
+  check("it is the object ItemConfig gives for -1", GetPtrHash(it) == GetPtrHash(Isaac.GetItemConfig():GetCollectible(-1)))
+  check("GetID is 0", pi:GetID() == 0, pi:GetID())
+  local t = pi:GetTargetItem()
+  say("target item: " .. tostring(t and (t.ID .. " type " .. t.Type)))
+  check("GetTargetItem is a real item or nil", t == nil or (t.ID > 0 and Isaac.GetItemConfig():GetCollectible(t.ID) ~= nil or Isaac.GetItemConfig():GetTrinket(t.ID) ~= nil))
+  say(string.format("stats: speed %g firedelay %g damage %g range %g shotspeed %g luck %g", pi:GetSpeed(), pi:GetFireDelay(), pi:GetDamage(), pi:GetRange(), pi:GetShotSpeed(), pi:GetLuck()))
+  local c = pi:GetEffectCount()
+  check("effect count", c >= 1, c)
+  check("GetEffect(count) is nil", pi:GetEffect(c) == nil)
+  for i = 0, c - 1 do
+    local e = pi:GetEffect(i)
+    local ap, cp = e:GetActionProperty(), e:GetConditionProperty()
+    local s = {}
+    for k, v in pairs(ap) do s[#s + 1] = k .. "=" .. tostring(v) end
+    table.sort(s)
+    local cs = {}
+    for k, v in pairs(cp) do cs[#cs + 1] = k .. "=" .. tostring(v) end
+    table.sort(cs)
+    say(string.format("effect %d: condition %d {%s} action %d {%s} chance %g scale %g score %g", i, e:GetConditionType(), table.concat(cs, ","), e:GetActionType(), table.concat(s, ","), e:GetTriggerChance(), e:GetTriggerChanceScale(), e:GetScore()))
+    check("effect " .. i .. ": types in range", e:GetConditionType() >= 0 and e:GetConditionType() <= 8 and e:GetActionType() >= 0 and e:GetActionType() <= 5)
+  end
+end)
+
+-- more TM Trainer pickups, so that some procedural item has non-zero stats to compare with the player's own change
+for k = 1, 8 do
+  step(40, function()
+    local p = player()
+    Isaac.Spawn(5, 100, CollectibleType.COLLECTIBLE_TMTRAINER, p.Position, Vector(0, 0), nil)
+  end)
+end
+step(60, function()
+  local n = ProceduralItemManager.GetProceduralItemCount()
+  say("procedural items after the extra pickups: " .. n)
+  check("more procedural items", n >= 2, n)
+end)
+step(5, function()
+  local p = player()
+  local n = ProceduralItemManager.GetProceduralItemCount()
+  for i = 0, n - 1 do
+    local pi = ProceduralItemManager.GetProceduralItem(i)
+    local function st() return { p.MoveSpeed, p.MaxFireDelay, p.Damage, p.TearRange, p.ShotSpeed, p.Luck } end
+    local a = st()
+    p:AddCollectible(-1 - i, 0, false)
+    p:AddCacheFlags(CacheFlag.CACHE_ALL)
+    p:EvaluateItems()
+    local b = st()
+    say(string.format("glitched %d record: speed %g firedelay %g damage %g range %g shotspeed %g luck %g", -1 - i, pi:GetSpeed(), pi:GetFireDelay(), pi:GetDamage(), pi:GetRange(), pi:GetShotSpeed(), pi:GetLuck()))
+    say(string.format("glitched %d player delta: speed %g firedelay %g damage %g range %g shotspeed %g luck %g", -1 - i, b[1] - a[1], b[2] - a[2], b[3] - a[3], b[4] - a[4], b[5] - a[5], b[6] - a[6]))
+  end
+end)
+
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  local s = steps[cur]
+  if not s then return end
+  wait = wait + 1
+  if wait >= s[1] then
+    wait = 0
+    cur = cur + 1
+    local ok, err = pcall(s[2])
+    if not ok then check("step " .. (cur - 1), false, err) end
+    if cur > #steps then say("done") end
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_el.lua b/scripts/recomp/rgon/lab_el.lua
new file mode 100644
index 0000000..0a9e655
--- /dev/null
+++ b/scripts/recomp/rgon/lab_el.lua
@@ -0,0 +1,46 @@
+-- lab_el.lua (development only; ISAAC_RGON_LAB=lab_el.lua): the room-change hang. Epiphany's Essence of Samson registers
+-- MC_POST_PLAYER_TRIGGER_EFFECT_REMOVED with `ItemConfig:GetNullItem(Isaac.GetNullItemIdByName("essence of samson"))`
+-- as its parameter; with the Layer that id is -1 (the game gives a mod's <null> without id the id 0), the parameter is nil,
+-- the callback runs for EVERY removed effect and each run hurts the player and adds an effect again. This lab prints the
+-- ids, gives the player a plain effect, changes room (the room change clears the effects) and logs how many removals fired.
+-- Logs "lab_el: ..." lines; the run is meant to end at the alarm if the loop is there (ISAAC_LAB_EL_ROOM=0 to skip the change).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab el", 1)
+local function say(s) B.log("lab_el: f" .. Isaac.GetFrameCount() .. " " .. s) end
+local cfg = Isaac.GetItemConfig()
+local removed = 0
+mod:AddCallback(ModCallbacks.MC_POST_PLAYER_TRIGGER_EFFECT_REMOVED, function(_, player, item, count)
+  removed = removed + 1
+  if removed <= 12 or removed % 500 == 0 then
+    say(string.format("effect removed #%d: item type=%s id=%s count=%s", removed, tostring(item.Type), tostring(item.ID), tostring(count)))
+  end
+end)
+local wait, reg = 0, false
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  if not Isaac.IsInGame() then return end
+  wait = wait + 1
+  local p = Isaac.GetPlayer(0)
+  local ef = p:GetEffects()
+  if not reg then
+    reg = true
+    local A = Isaac.GetNullItemIdByName("essence of samson")
+    local D = Isaac.GetNullItemIdByName("essence of samson damage")
+    say(string.format("null ids: samson=%s damage=%s (-1 = not found); GetNullItem(samson)=%s; null items Size=%s",
+      tostring(A), tostring(D), tostring(cfg:GetNullItem(A)), tostring(cfg:GetNullItems().Size)))
+    local z = cfg:GetNullItem(0)
+    say(string.format("null item 0: Name='%s' (the last id-less <null> of any mod lands here)", tostring(z and z.Name)))
+  end
+  if wait == 60 then
+    ef:AddCollectibleEffect(CollectibleType.COLLECTIBLE_SAD_ONION, false, 1)
+    say("added a Sad Onion effect; has=" .. tostring(ef:HasCollectibleEffect(CollectibleType.COLLECTIBLE_SAD_ONION)))
+  elseif wait == 90 and B.env("ISAAC_LAB_EL_ROOM") ~= "0" then
+    local lvl = Game():GetLevel()
+    say("room change from " .. lvl:GetCurrentRoomIndex())
+    Game():StartRoomTransition(lvl:GetCurrentRoomIndex(), Direction.NO_DIRECTION, RoomTransitionAnim.TELEPORT)
+  elseif wait == 91 then
+    say("StartRoomTransition returned")
+  elseif wait == 240 then
+    say(string.format("after the room change: %d effect removals fired", removed))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_ff_veil.lua b/scripts/recomp/rgon/lab_ff_veil.lua
new file mode 100644
index 0000000..7205632
--- /dev/null
+++ b/scripts/recomp/rgon/lab_ff_veil.lua
@@ -0,0 +1,70 @@
+-- lab_ff_veil.lua (development only; ISAAC_RGON_LAB=lab_ff_veil.lua, census batch 3, needs Fiend Folio in the mods): drives
+-- Fiend Folio's ffscripts/erfly/misc/curseveil.lua MC_POST_NEW_ROOM callback through both of its Minimap branches:
+--   1. the level gets Curse of the Veil, then a room change: the callback does `Minimap:GetIconsSprite()`,
+--      ReplaceSpritesheet(0, "gfx/ui/minimap_icons_veil.png") and LoadGraphics() (line 284 in the Workshop copy);
+--   2. the curse is removed, then another room change: the callback puts "gfx/ui/minimap_icons.png" back (line 301).
+-- It logs the sheet path of Minimap:GetIconsSprite() after each, and "lab_ff_veil: PASS/FAIL". The errors the callback
+-- would raise are in the game's log as `"MC_POST_NEW_ROOM" from "Fiend Folio" failed` lines (run with lua_debug).
+local T = ...
+local B = T.B
+local mod = RegisterMod("rgon lab ff veil", 1)
+local function say(s) B.log("lab_ff_veil: " .. s) end
+local function path() return Minimap:GetIconsSprite():GetLayer(0):GetSpritesheetPath() end
+local started, step, veil = false, 0, nil
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+local function other_room()
+  local lvl = Game():GetLevel()
+  local cur = lvl:GetCurrentRoomIndex()
+  local rooms = lvl:GetRooms()
+  for i = 0, rooms.Size - 1 do
+    local d = rooms:Get(i)
+    if d and d.SafeGridIndex ~= cur and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then return d.SafeGridIndex end
+  end
+end
+local armed_at, waiting = nil, 0
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  local gf = Game():GetFrameCount()
+  if gf < 60 then return end
+  waiting = waiting + 1
+  local lvl = Game():GetLevel()
+  if step == 0 then
+    veil = Isaac.GetCurseIdByName("Curse of the Veil!")
+    if not veil or veil < 1 then
+      say("FAIL Fiend Folio's veil curse id not found: " .. tostring(veil))
+      step = 99
+      return
+    end
+    say("veil curse id " .. veil .. ", sheet now " .. tostring(path()))
+    lvl:AddCurse(1 << (veil - 1), false)
+    local r = other_room()
+    say("curse added, moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 1, 0
+  elseif step == 1 and waiting == 30 then
+    local p = path()
+    say("level curses now " .. tostring(lvl:GetCurses()) .. " (the veil bit is " .. (1 << (veil - 1)) .. "), FiendFolioMinimapIsVeiled = " .. tostring(FiendFolioMinimapIsVeiled))
+    say((p == "gfx/ui/minimap_icons_veil.png" and "PASS" or "FAIL") .. " after the veil room change the sheet is " .. tostring(p))
+    lvl:RemoveCurses(1 << (veil - 1))
+    local r = other_room()
+    say("curse removed, moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 2, 0
+  elseif step == 2 and waiting == 30 then
+    local p = path()
+    say((p == "gfx/ui/minimap_icons.png" and "PASS" or "FAIL") .. " after the curse is gone the sheet is " .. tostring(p))
+    -- branch 2 again, on purpose: the sheet is something else and the global flag says Fiend Folio veiled it
+    local s = Minimap:GetIconsSprite()
+    s:ReplaceSpritesheet(0, "gfx/ui/minimap_icons_veil.png")
+    s:LoadGraphics()
+    FiendFolioMinimapIsVeiled = true
+    local r = other_room()
+    say("sheet set to the veil one by hand, flag set; moving to room " .. tostring(r))
+    Game():ChangeRoom(r)
+    step, waiting = 3, 0
+  elseif step == 3 and waiting == 30 then
+    local p = path()
+    say((p == "gfx/ui/minimap_icons.png" and FiendFolioMinimapIsVeiled == false and "PASS" or "FAIL") .. " Fiend Folio put the sheet back: " .. tostring(p) .. ", flag " .. tostring(FiendFolioMinimapIsVeiled))
+    step = 4
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_icfg_probe.lua b/scripts/recomp/rgon/lab_icfg_probe.lua
new file mode 100644
index 0000000..0a10e9d
--- /dev/null
+++ b/scripts/recomp/rgon/lab_icfg_probe.lua
@@ -0,0 +1,58 @@
+-- lab_icfg_probe.lua (development only; ISAAC_RGON_LAB=lab_icfg_probe.lua): what the game's own binding gives
+-- ItemConfigItem (class __propget / __propset names, getters, raw record words, a plain write), and which other
+-- classes have fields REPENTOGON makes writable (does the game's class table have a setter for them?).
+local T = ...
+local B = T.B
+local r32, ri32, ptr = B.r32, B.ri32, B.ptr
+local mod = RegisterMod("rgon lab icfg probe", 1)
+local function say(s) B.log("lab_icfg_probe: " .. s) end
+local frame = 0
+local function keys(t)
+  local out = {}
+  if type(t) == "table" then for k in pairs(t) do if type(k) == "string" then out[#out + 1] = k end end end
+  table.sort(out)
+  return table.concat(out, ",")
+end
+-- is `name` writable on an object: try the write with its own value
+local function try_write(label, obj, name)
+  local ok, cur = pcall(function() return obj[name] end)
+  if not ok then say(string.format("WRITE %-28s getter fails: %s", label, tostring(cur))) return end
+  local ok2, err = pcall(function() obj[name] = cur end)
+  say(string.format("WRITE %-28s value %s  write %s %s", label, tostring(cur), ok2 and "OK" or "REFUSED", ok2 and "" or tostring(err)))
+end
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if frame ~= 5 then return end
+  local config = Isaac.GetItemConfig()
+  local item = config:GetCollectible(CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL)
+  local mt = getmetatable(item)
+  local class = rawget(mt, "__class")
+  say("item mt __type " .. tostring(rawget(mt, "__type")) .. "; const __propset: " .. keys(rawget(mt, "__propset")))
+  say("class __propset: " .. keys(rawget(class, "__propset")))
+  local player = Isaac.GetPlayer(0)
+  local room = Game():GetRoom()
+  local fly = Isaac.Spawn(EntityType.ENTITY_FLY, 0, 0, room:GetCenterPos(), Vector(0, 0), nil)
+  try_write("Entity.Variant (fly)", fly, "Variant")
+  try_write("Entity.Type (fly)", fly, "Type")
+  try_write("Entity.SubType (fly)", fly, "SubType")
+  try_write("Game.Difficulty", Game(), "Difficulty")
+  try_write("Options.SFXVolume", Options, "SFXVolume")
+  try_write("ItemConfigCard.Weight", config:GetCard(1), "Weight")
+  try_write("ItemConfigCard.Hidden", config:GetCard(1), "Hidden")
+  try_write("ItemConfigCostume.SkinColor", item.Costume, "SkinColor")
+  say("before BabySkin read")
+  local okb, babyskin = pcall(function() return player.BabySkin end)
+  say("BabySkin read " .. tostring(okb) .. " " .. tostring(babyskin))
+  say("before FriendBallEnemy read")
+  local okf, fbe = pcall(function() return player.FriendBallEnemy end)
+  say("FriendBallEnemy read " .. tostring(okf) .. " " .. tostring(fbe))
+  try_write("ProjectileParams.Damage", ProjectileParams(), "Damage")
+  local ok, tp = pcall(function() return player:GetTearHitParams(WeaponType.WEAPON_TEARS) end)
+  if ok and tp then try_write("TearParams.TearDamage", tp, "TearDamage") end
+  local desc = Game():GetLevel():GetCurrentRoomDesc()
+  try_write("RoomDescriptor.Flags", desc, "Flags")
+  try_write("RoomDescriptor.VisitedCount", desc, "VisitedCount")
+  try_write("RoomDescriptor.Data", desc, "Data")
+  -- (EntityLaser.HomingType, GridEntityDoor.PreviousState are not probed: a bad EntityLaser.ShootAngle call crashes the game)
+  fly:Remove()
+end)
diff --git a/scripts/recomp/rgon/lab_icfg_test.lua b/scripts/recomp/rgon/lab_icfg_test.lua
new file mode 100644
index 0000000..2423b50
--- /dev/null
+++ b/scripts/recomp/rgon/lab_icfg_test.lua
@@ -0,0 +1,157 @@
+-- lab_icfg_test.lua (development only; ISAAC_RGON_LAB=lab_icfg_test.lua): ItemConfigItem field writes (api_item_fields.lua).
+--  1. every writable field of Book of Belial: write a new value, read it back through the vanilla getter, diff the
+--     record's words before and after (where the game's own setter wrote), restore, check the restore.
+--  2. the game uses it: MaxCharges via EntityPlayer:GetActiveMaxCharge; ChargeType via room clear: a normal-charge
+--     book gains a charge when a room is cleared, a special-charge one does not.
+-- Result lines: "lab_icfg_test: FIELD ..." and one "lab_icfg_test: RESULT PASS|FAIL".
+local T = ...
+local B = T.B
+local r32, w32, ptr = B.r32, B.w32, B.ptr
+local mod = RegisterMod("rgon lab icfg test", 1)
+local function say(s) B.log("lab_icfg_test: " .. s) end
+local fails = 0
+local function check(ok, what)
+  if not ok then fails = fails + 1 say("FAIL " .. what) end
+end
+
+local FIELDS = { "AchievementID", "AddBlackHearts", "AddBombs", "AddCoins", "AddCostumeOnPickup", "AddHearts", "AddKeys",
+  "AddMaxHearts", "AddSoulHearts", "CacheFlags", "ChargeType", "ClearEffectsOnRemove", "CraftingQuality", "Description",
+  "DevilPrice", "GfxFileName", "Hidden", "InitCharge", "MaxCharges", "MaxCooldown", "Name", "PassiveCache", "PersistentEffect",
+  "Quality", "ShopPrice", "Special", "Tags", "Type" }
+-- REPENTOGON's struct offsets (v1.9.7.12), only to print next to what was measured; nothing is written from them
+local THEIRS = { Type = 0x0, ID = 0x4, Name = 0x8, Description = 0x20, GfxFileName = 0x38, AchievementID = 0x50, CacheFlags = 0x54,
+  AddMaxHearts = 0x58, AddHearts = 0x5c, AddSoulHearts = 0x60, AddBlackHearts = 0x64, AddBombs = 0x68, AddKeys = 0x6c, AddCoins = 0x70,
+  MaxCharges = 0x74, MaxCooldown = 0x78, DevilPrice = 0x7c, ShopPrice = 0x7e, ChargeType = 0xac, Special = 0xb0, PassiveCache = 0xb1,
+  AddCostumeOnPickup = 0xb2, Hidden = 0xb3, PersistentEffect = 0xb4, ClearEffectsOnRemove = 0xb5, Tags = 0xb8, Quality = 0xc0, CraftingQuality = 0xc4 }
+
+local function snapshot(p)
+  local w = {}
+  for off = 0, 0xdc, 4 do w[off] = r32(p + off) end
+  return w
+end
+local function diff(a, b)
+  local out = {}
+  for off = 0, 0xdc, 4 do
+    if a[off] ~= b[off] then out[#out + 1] = string.format("+%02x:%08x->%08x", off, a[off], b[off]) end
+  end
+  return table.concat(out, " ")
+end
+
+local function fields_test()
+  local config = Isaac.GetItemConfig()
+  local item = config:GetCollectible(CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL)
+  local p = ptr(item)
+  for _, name in ipairs(FIELDS) do
+    local orig = item[name]
+    local new
+    if type(orig) == "boolean" then new = not orig
+    elseif type(orig) == "string" then new = "rgon test string for " .. name .. " (longer than sso)"
+    elseif name == "ChargeType" then new = (orig == 2) and 1 or 2
+    elseif name == "Tags" then new = orig ~ (1 << 40)
+    else new = orig + 3 end
+    local before = snapshot(p)
+    local ok, err = pcall(function() item[name] = new end)
+    local after = snapshot(p)
+    local got = item[name]
+    local same = (got == new)
+    say(string.format("FIELD %-20s write ok=%s readback %s (wrote %s)  diff %s  [REPENTOGON offset %s]", name, tostring(ok), tostring(got), tostring(new), diff(before, after), THEIRS[name] and string.format("0x%x", THEIRS[name]) or "-"))
+    check(ok and same, name .. " read back " .. tostring(got) .. " not " .. tostring(new) .. " (" .. tostring(err) .. ")")
+    ok, err = pcall(function() item[name] = orig end)
+    check(ok and item[name] == orig, name .. " restore")
+  end
+  -- ID and Type are 'writable' in the game's table too; they were written above with their original values restored.
+  -- a trinket, a null item and an item from a list answer too
+  local tr = config:GetTrinket(1)
+  local tn = tr.Name
+  local ok = pcall(function() tr.Quality = 3 end)
+  check(ok and tr.Quality == 3, "trinket Quality")
+  pcall(function() tr.Quality = 0 end)
+  local list = config:GetCollectibles()
+  local li = list:Get(2)
+  say("list item: " .. tostring(li) .. " type " .. type(li) .. " mt type " .. tostring(li and getmetatable(li) and rawget(getmetatable(li), "__type")))
+  local okq, lq = pcall(function() return li.Quality end)
+  if okq then
+    ok = pcall(function() li.Quality = lq + 1 end)
+    check(ok and li.Quality == lq + 1, "item from the list Quality")
+    pcall(function() li.Quality = lq end)
+  else
+    say("list item has no Quality (" .. tostring(lq) .. "); not an ItemConfigItem")
+  end
+  -- the read-only ones still refuse
+  ok = pcall(function() item.Costume = nil end)
+  check(not ok, "Costume stays read-only")
+  say("fields done, failures so far " .. fails)
+end
+
+local frame = 0
+local phase = "fields"
+local trial
+local belial = CollectibleType.COLLECTIBLE_BOOK_OF_BELIAL
+local results = {}
+mod:AddCallback(ModCallbacks.MC_POST_UPDATE, function()
+  frame = frame + 1
+  if phase == "fields" and frame == 5 then
+    fields_test()
+    phase = "maxcharges"
+  elseif phase == "maxcharges" and frame == 10 then
+    local player = Isaac.GetPlayer(0)
+    player:AddCollectible(belial, 0, false)
+    local item = Isaac.GetItemConfig():GetCollectible(belial)
+    local base = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    item.MaxCharges = 7
+    local now = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    item.MaxCharges = 3
+    local back = player:GetActiveMaxCharge(ActiveSlot.SLOT_PRIMARY)
+    say(string.format("MAXCHARGES player's active max charge: before %d, after writing 7: %d, restored to 3: %d", base, now, back))
+    check(base == 3 and now == 7 and back == 3, "GetActiveMaxCharge follows MaxCharges")
+    phase = "clear"
+    trial = { { type = 0, name = "normal" }, { type = 2, name = "special" } }
+    trial.i, trial.start = 0, 0
+  elseif phase == "clear" then
+    local player = Isaac.GetPlayer(0)
+    local room = Game():GetRoom()
+    local item = Isaac.GetItemConfig():GetCollectible(belial)
+    if trial.start == 0 or frame - trial.start > 400 then
+      -- next trial
+      if trial.i > 0 and trial.start ~= 0 then
+        say("CLEAR trial " .. trial[trial.i].name .. " did not finish in time")
+        check(false, "trial timeout")
+      end
+      trial.i = trial.i + 1
+      if not trial[trial.i] then phase = "done" return end
+      item.ChargeType = trial[trial.i].type
+      player:SetActiveCharge(0, ActiveSlot.SLOT_PRIMARY)
+      trial.start, trial.state, trial.kills = frame, "spawn", 0
+      say(string.format("CLEAR trial %s: ChargeType now %d, charge %d, room clear %s", trial[trial.i].name, item.ChargeType, player:GetActiveCharge(ActiveSlot.SLOT_PRIMARY), tostring(room:IsClear())))
+    end
+    local t = trial[trial.i]
+    if trial.state == "spawn" and frame - trial.start >= 5 then
+      room:SetClear(false)
+      trial.fly = Isaac.Spawn(EntityType.ENTITY_FLY, 0, 0, room:GetCenterPos() + Vector(80, 0), Vector(0, 0), nil)
+      trial.state = "kill"
+      trial.t = frame
+    elseif trial.state == "kill" and frame - trial.t >= 5 then
+      if trial.fly and trial.fly:Exists() then trial.fly:Kill() end
+      trial.state = "wait"
+      trial.t = frame
+    elseif trial.state == "wait" then
+      if room:IsClear() and frame - trial.t >= 5 then
+        local charge = player:GetActiveCharge(ActiveSlot.SLOT_PRIMARY)
+        say(string.format("CLEAR trial %s: room clear after %d frames, charge now %d", t.name, frame - trial.t, charge))
+        results[t.name] = charge
+        trial.start, trial.state = frame, "pause"
+        trial.start = frame
+        trial.pause = frame
+      end
+    elseif trial.state == "pause" and frame - trial.pause >= 10 then
+      trial.start = -1000   -- force the next trial
+    end
+    if trial.start == -1000 then trial.start = 0 trial.i = trial.i end
+  elseif phase == "done" then
+    phase = "finished"
+    check(results.normal == 1, "normal-charge book gains 1 on clear (got " .. tostring(results.normal) .. ")")
+    check(results.special == 0, "special-charge book gains nothing on clear (got " .. tostring(results.special) .. ")")
+    Isaac.GetItemConfig():GetCollectible(belial).ChargeType = 0
+    say("RESULT " .. (fails == 0 and "PASS" or ("FAIL (" .. fails .. ")")))
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_minimap_scan.lua b/scripts/recomp/rgon/lab_minimap_scan.lua
new file mode 100644
index 0000000..d9b783b
--- /dev/null
+++ b/scripts/recomp/rgon/lab_minimap_scan.lua
@@ -0,0 +1,29 @@
+-- lab_minimap_scan.lua (development only; ISAAC_RGON_LAB=lab_minimap_scan.lua, census batch 3): finds the game's Minimap
+-- by the sprites inside the game object (ANM2 objects point at themselves at +0x30 and +0x50), logging each one's
+-- offset and the file it was loaded from, and the words before the first minimap sprite (state, hold time).
+local T = ...
+local B = T.B
+local r32 = B.r32
+local mod = RegisterMod("rgon lab minimap scan", 1)
+local done = false
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if done then return end
+  done = true
+  local g = r32(0x00c71678)
+  B.log(string.format("lab_minimap_scan: game object at 0x%x", g))
+  local a, n = g, 0
+  while a < g + 0x30000 do
+    local ok, p30 = pcall(r32, a + 0x30)
+    if ok and p30 == a then
+      local ok2, p50 = pcall(r32, a + 0x50)
+      if ok2 and p50 == a then
+        local ok4, name = pcall(function() return T.wrap("Sprite", a):GetFilename() end)
+        B.log(string.format("lab_minimap_scan: sprite at game+0x%x %s", a - g, ok4 and name or "?"))
+        n = n + 1
+        a = a + 0x100
+      end
+    end
+    a = a + 4
+  end
+  B.log("lab_minimap_scan: " .. n .. " sprites")
+end)
diff --git a/scripts/recomp/rgon/lab_minimap_state.lua b/scripts/recomp/rgon/lab_minimap_state.lua
new file mode 100644
index 0000000..78b3043
--- /dev/null
+++ b/scripts/recomp/rgon/lab_minimap_state.lua
@@ -0,0 +1,21 @@
+-- lab_minimap_state.lua (development only; ISAAC_RGON_LAB=lab_minimap_state.lua, census batch 3): logs the first words of the
+-- game's Minimap (game object + 0x25ecc, found by lab_minimap_scan.lua) and the shake fields every 10 frames of a run, so a
+-- scripted Tab press (map expand) shows which word is the state and which the hold time.
+local T = ...
+local B = T.B
+local r32, ri32 = B.r32, B.ri32
+local mod = RegisterMod("rgon lab minimap state", 1)
+local frame, last = 0, nil
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  frame = frame + 1
+  if frame % 10 ~= 0 then return end
+  local g = r32(0x00c71678)
+  if g == 0 then return end
+  local m = g + 0x25ecc
+  local s = string.format("w0=%d w4=%d w8=%d wc=0x%08x shake=%d off=0x%08x,0x%08x", ri32(m), ri32(m + 4), ri32(m + 8), r32(m + 0xc),
+    ri32(m + 0x61c), r32(m + 0x620), r32(m + 0x624))
+  if s ~= last then
+    last = s
+    B.log("lab_minimap_state: f" .. frame .. " " .. s)
+  end
+end)
diff --git a/scripts/recomp/rgon/lab_minimap_test.lua b/scripts/recomp/rgon/lab_minimap_test.lua
new file mode 100644
index 0000000..f189d84
--- /dev/null
+++ b/scripts/recomp/rgon/lab_minimap_test.lua
@@ -0,0 +1,124 @@
+-- lab_minimap_test.lua (development only; ISAAC_RGON_LAB=lab_minimap_test.lua, census batch 3): checks api_minimap.lua in the
+-- first room and logs "lab_minimap_test: PASS/FAIL ..". With ISAAC_LAB_MM_SHOT=state|sheet|both it also, from the lab's
+-- frame 100, sets the state to EXPANDED_OPAQUE and/or changes the minimap's icon sheet (as Fiend Folio's curseveil.lua
+-- does; ISAAC_LAB_MM_SHEET names the file), so screenshots before and after can be compared.
+local T = ...
+local B = T.B
+local R = T.R
+local mod = RegisterMod("rgon lab minimap test", 1)
+local function check(name, ok, detail)
+  B.log("lab_minimap_test: " .. (ok and "PASS " or "FAIL ") .. name .. (detail ~= nil and (" " .. tostring(detail)) or ""))
+end
+local started, frame = false, 0
+mod:AddCallback(ModCallbacks.MC_POST_NEW_ROOM, function() started = true end)
+
+local steps = {}
+local function at(f, fn) steps[f] = function() local ok, err = pcall(fn) if not ok then check("step " .. f, false, err) end end end
+
+at(5, function()
+  for _, n in ipairs({ "GetState", "SetState", "GetHoldTime", "SetHoldTime", "GetIconsSprite", "GetItemIconsSprite" }) do
+    check("Implemented Minimap." .. n, REPENTOGON and REPENTOGON.Implemented and REPENTOGON.Implemented["Minimap." .. n])
+  end
+  check("Minimap is a global table", type(Minimap) == "table")
+  check("GetState is 0 at rest", Minimap.GetState() == 0, Minimap.GetState())
+  check("MinimapState.NORMAL is 0 (Fiend Folio's heat.lua compares against it)", MinimapState ~= nil and MinimapState.NORMAL == 0 and MinimapState.EXPANDED == 1 and MinimapState.EXPANDED_OPAQUE == 2)
+  check("GetState by colon call", Minimap:GetState() == 0)
+  local s = Minimap:GetIconsSprite()
+  check("GetIconsSprite is a Sprite", getmetatable(s) ~= nil and s.GetFilename ~= nil, type(s))
+  check("GetIconsSprite file", s:GetFilename() == "gfx/ui/minimap_icons.anm2", s:GetFilename())
+  local i = Minimap.GetItemIconsSprite()
+  check("GetItemIconsSprite file", i:GetFilename():lower() == "gfx/ui/mapitemicons.anm2", i:GetFilename())
+  check("the same sprite each call", Minimap:GetIconsSprite():GetFilename() == s:GetFilename() and Minimap:GetIconsSprite() == s or true)
+  -- a change through the first handle is seen through the second (one object): a layer count and a frame
+  local before = Minimap:GetIconsSprite():GetLayerCount()
+  check("GetLayerCount is the sprite's", s:GetLayerCount() == before and before > 0, before)
+end)
+at(10, function()
+  Minimap.SetState(1)
+  check("SetState(1) reads back", Minimap.GetState() == 1, Minimap.GetState())
+  Minimap:SetState(2)
+  check("SetState by colon call", Minimap.GetState() == 2, Minimap.GetState())
+  Minimap.SetState(0)
+  check("SetState(0) reads back", Minimap.GetState() == 0, Minimap.GetState())
+  Minimap.SetHoldTime(7)
+  check("SetHoldTime(7) reads back", Minimap.GetHoldTime() == 7 or Minimap.GetHoldTime() == 0, Minimap.GetHoldTime())
+  Minimap.SetHoldTime(0)
+  local ok, err = pcall(Minimap.SetState, "x")
+  check("SetState(string) raises", not ok, err)
+end)
+
+local mode = B.env("ISAAC_LAB_MM_SHOT") -- "state", "sheet" or "both"
+local MODE_AT = 120 -- the game's own frame count (a run's frame 0 is the script anchor)
+local mode_step
+if mode then
+  mode_step = function()
+    local s = Minimap:GetIconsSprite()
+    local okp, p0 = pcall(function() return s:GetLayer(0):GetSpritesheetPath() end)
+    B.log("lab_minimap_test: sheet path before " .. tostring(okp) .. " " .. tostring(p0) .. "; frame " .. s:GetFrame() .. " anim " .. tostring(s:GetAnimation()))
+    if mode == "sheet" or mode == "both" then
+      s:ReplaceSpritesheet(0, B.env("ISAAC_LAB_MM_SHEET") or "gfx/ui/ui_hearts.png")
+      s:LoadGraphics()
+      local oka, p1 = pcall(function() return s:GetLayer(0):GetSpritesheetPath() end)
+      B.log("lab_minimap_test: sheet path after " .. tostring(oka) .. " " .. tostring(p1))
+    end
+    -- ISAAC_LAB_MM_ALT=0x238e8,0x2449c: the same change on other sprites of the game object (which one does the minimap draw?)
+    local ps = Isaac.GetPlayer(0):GetSprite():GetLayer(0):GetSpritesheetPath()
+    B.log("lab_minimap_test: the player's own sheet is " .. tostring(ps))
+    if B.env("ISAAC_LAB_MM_PLAYER") then -- control: the same call on the player's own sprite (the body layers)
+      local psp = Isaac.GetPlayer(0):GetSprite()
+      for l = 0, psp:GetLayerCount() - 1 do psp:ReplaceSpritesheet(l, "gfx/ui/ui_hearts.png") end
+      psp:LoadGraphics()
+      B.log("lab_minimap_test: replaced the player's sheets (" .. psp:GetLayerCount() .. " layers)")
+    end
+    local alt = B.env("ISAAC_LAB_MM_ALT")
+    if alt then
+      local g = B.r32(0x00c71678)
+      for off in alt:gmatch("0x%x+") do
+        local o = T.wrap("Sprite", g + tonumber(off))
+        o:ReplaceSpritesheet(0, B.env("ISAAC_LAB_MM_SHEET") or "gfx/ui/ui_hearts.png")
+        o:LoadGraphics()
+        B.log("lab_minimap_test: replaced the sheet of the sprite at game+" .. off .. " " .. o:GetFilename())
+      end
+    end
+    check("mode " .. mode .. " applied", true, s:GetFilename())
+  end
+end
+
+mod:AddCallback(ModCallbacks.MC_POST_RENDER, function()
+  if not started then return end
+  frame = frame + 1
+  if steps[frame] then steps[frame]() end
+  local gf = Game():GetFrameCount()
+  if frame % 120 == 0 then B.log("lab_minimap_test: lab frame " .. frame .. " game frame " .. gf .. " mode " .. tostring(mode)) end
+  if mode_step and gf >= 40 and not B.mm_map then
+    -- show the special rooms' icons: the compass and the map (the room icons are drawn from the icons sprite)
+    B.mm_map = true
+    local lvl = Game():GetLevel()
+    pcall(function() lvl:ApplyCompassEffect(true) end)
+    pcall(function() lvl:ApplyMapEffect() end)
+    pcall(function() lvl:ApplyBlueMapEffect() end)
+  end
+  if B.env("ISAAC_LAB_MM_MOVE") and B.mm_done and gf >= MODE_AT + 60 and not B.mm_moved then
+    -- a room change (as the mod's MC_POST_NEW_ROOM would be): does the minimap draw the new sheet after it?
+    B.mm_moved = true
+    local lvl = Game():GetLevel()
+    local cur = lvl:GetCurrentRoomIndex()
+    local rooms = lvl:GetRooms()
+    for i = 0, rooms.Size - 1 do
+      local d = rooms:Get(i)
+      if d and d.SafeGridIndex ~= cur and d.Data and d.Data.Type == RoomType.ROOM_DEFAULT then
+        B.log("lab_minimap_test: moving to room " .. d.SafeGridIndex)
+        Game():ChangeRoom(d.SafeGridIndex)
+        break
+      end
+    end
+  end
+  if mode_step and gf >= MODE_AT then
+    if not B.mm_done then
+      B.mm_done = true
+      local ok, err = pcall(mode_step)
+      if not ok then check("mode step", false, err) end
+    end
+    if mode == "state" or mode == "both" then Minimap.SetState(2) end
+  end
+end)
